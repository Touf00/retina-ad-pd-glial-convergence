    ")\n",
    "\n",
    "print(\n",
    "    \"RIN SENSITIVITY PERFORMED: NO\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PMI SENSITIVITY PERFORMED: NO\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"AD REPLICATION PERFORMED: NO\"\n",
    ")\n",    "\n",
    "print(\n",
