   "source": [
    "## Part IV — AD secondary external replication\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 56\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 57\n",
    "# ============================================================\n",
    "# V2 GSE138852 PUBLIC ACQUISITION + PRE-DE AUDIT\n",
    "# ============================================================\n",
    "from pathlib import Path\n",
    "import requests, pandas as pd, json, gzip, hashlib, re\n",
    "SEC=ROOT/'GSE138852_AD_secondary'; SEC.mkdir(parents=True,exist_ok=True); DL=SEC/'downloads'; DL.mkdir(exist_ok=True)\n",
    "urls={\n",
    " 'counts':'https://ftp.ncbi.nlm.nih.gov/geo/series/GSE138nnn/GSE138852/suppl/GSE138852_counts.csv.gz',\n",
    " 'covariates':'https://ftp.ncbi.nlm.nih.gov/geo/series/GSE138nnn/GSE138852/suppl/GSE138852_covariates.csv.gz',\n",
    "}\n",
    "def get(url,p):\n",
    " if p.exists() and p.stat().st_size>0:return\n",
    " with requests.get(url,stream=True,timeout=180) as r:\n",
    "  r.raise_for_status();\n",
    "  with open(p,'wb') as f:\n",
    "   for ch in r.iter_content(4*1024*1024):\n",
    "    if ch:f.write(ch)\n",
    "for k,u in urls.items(): get(u,DL/u.split('/')[-1])\n",
    "# Zenodo author metadata; find adsn_metadata.txt dynamically.\n",
    "z=requests.get('https://zenodo.org/api/records/17302976',timeout=120); z.raise_for_status(); meta=z.json(); cand=[x for x in meta.get('files',[]) if x.get('key')=='adsn_metadata.txt']; assert len(cand)==1\n",
    "url=cand[0]['links']['self']; p=DL/'adsn_metadata.txt'; get(url,p)\n",
    "author=pd.read_csv(p,sep='\\t'); geo=pd.read_csv(DL/'GSE138852_covariates.csv.gz')\n",
    "assert len(author)==13214 and len(geo)==13214,(len(author),len(geo))\n",
    "# Verified linkage fields from the original audit.\n",
    "checks=[('batchCond','oupSample.batchCond'),('cellType','oupSample.cellType'),('subclustCond','oupSample.subclustCond')]\n",
    "for a,g in checks:\n",
    " assert (author[a].astype(str).str.strip().to_numpy()==geo[g].astype(str).str.strip().to_numpy()).all(),(a,g)\n",
    "# Exclude donor-unassigned nuclei; these are not biological donors.\n",
    "assigned=author[~author.patient.astype(str).isin(['AD-un','Ct-un'])].copy(); assert len(assigned)==12770; assert assigned.patient.nunique()==12\n",
    "mapct={'astro':'Astro','mg':'Micro','OPC':'OPC','oligo':'Oligo'}; assigned['target_cell_type']=assigned.cellType.astype(str).map(mapct)\n",
    "coverage=assigned.dropna(subset=['target_cell_type']).groupby(['patient','target_cell_type']).size().unstack(fill_value=0).reindex(columns=['Astro','Micro','OPC','Oligo'],fill_value=0)\n",
    "# Clinical metadata from the published supplementary table, frozen in the prior RETINA-ND audit.\n",
    "clinical=pd.DataFrame([\n",
    "['AD1','AD',91,'Male',8],['AD2','AD',83.8,'Male',10],['AD3','AD',67.8,'Female',21],['AD4','AD',83,'Female',34],['AD5','AD',73,'Male',9.5],['AD6','AD',74.6,'Male',30],\n",
    "['Ct1','Control',67.3,'Female',24],['Ct2','Control',82.7,'Female',28.5],['Ct3','Control',72.6,'Male',42.5],['Ct4','Control',75.6,'Male',46],['Ct5','Control',77.5,'Male',53.5],['Ct6','Control',82.7,'Male',27]],columns=['donor_id','diagnosis_binary','age','sex','PMI_hours'])\n",
    "assert set(clinical.donor_id)==set(coverage.index)\n",
    "elig=[]\n",
    "for ct in ['Astro','Micro','OPC','Oligo']:\n",
    " for thr in [10,20]:\n",
    "  ds=coverage.index[coverage[ct]>=thr].tolist(); c=clinical[clinical.donor_id.isin(ds)]; elig.append({'cell_type':ct,'threshold':thr,'donors':len(c),'AD':int((c.diagnosis_binary=='AD').sum()),'Control':int((c.diagnosis_binary=='Control').sum())})\n",
    "elig=pd.DataFrame(elig); display(elig)\n",
    "expected10={'Astro':(12,6,6),'Micro':(10,5,5),'OPC':(12,6,6),'Oligo':(12,6,6)}\n",
    "for ct,t in expected10.items():\n",
    " r=elig[(elig.cell_type==ct)&(elig.threshold==10)].iloc[0]; assert (r.donors,r.AD,r.Control)==t\n",
    "coverage.to_csv(SEC/'GSE138852_DONOR_TARGET_CELL_COVERAGE_v1.csv'); clinical.to_csv(SEC/'GSE138852_CLINICAL_METADATA_FROZEN_v1.csv',index=False); assigned[['cell','patient','sex','cellType','target_cell_type']].to_csv(SEC/'GSE138852_ASSIGNED_NUCLEUS_METADATA_v1.csv.gz',index=False,compression='gzip')\n",
    "lock={'status':'GSE138852_PRE_DE_AUDIT_FROZEN','primary_threshold':10,'primary_model':'~ age + sex + diagnosis_binary','PMI_sensitivity_model':'~ age + sex + PMI_hours + diagnosis_binary','batch_adjustment':False,'batch_reason':'pooled-library batch is nested/confounded with diagnosis','age_overlap_sensitivity':False,'disease_DE_performed':False,'eligibility':elig.to_dict('records')}\n",
    "with open(LOCKS/'GSE138852_RETINA_ND_PRE_DE_FREEZE_v1.json','w') as f: json.dump(lock,f,indent=2)\n",
    "print('GSE138852 PRE-DE AUDIT PASS — disease expression still untouched')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 58\n",
    "# ============================================================\n",
    "# V2 GSE138852 SECONDARY EXTERNAL REPLICATION DE — FIXED\n",
    "# COMPLETE DROP-IN REPLACEMENT\n",
    "#\n",
    "# FIXES\n",
    "# -----\n",
    "# 1. Correct count-column ↔ author-metadata linkage.\n",
    "# 2. Verifies linkage one-to-one before pseudobulk.\n",
    "# 3. Includes GEO-covariate bridge fallback.\n",
    "# 4. Runs PyDESeq2 in a fresh Python process to avoid the\n",
    "#    pandas/AnnData incompatibility encountered previously.\n",
    "#\n",
    "# SCIENTIFIC MODELS ARE UNCHANGED:\n",
    "#\n",
    "# Primary:\n",
    "#     ~ age + sex + diagnosis_binary\n",
    "#\n",
    "# PMI sensitivity:\n",
    "#     ~ age + sex + PMI_hours + diagnosis_binary\n",
    "#\n",
    "# Batch is NOT adjusted because pooled-library batch is\n",
    "# nested/confounded with diagnosis.\n",
    "# ============================================================\n",
    "\n",
    "import os\n",
    "import sys\n",
    "import json\n",
    "import subprocess\n",
    "import importlib.metadata\n",
    "\n",
    "from pathlib import Path\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = ROOT / \"locks\"\n",
    "\n",
    "SEC = (\n",
    "    ROOT /\n",
    "    \"GSE138852_AD_secondary\"\n",
    ")\n",
    "\n",
    "DL = (\n",
    "    SEC /\n",
    "    \"downloads\"\n",
    ")\n",
    "\n",
    "OUT = (\n",
    "    SEC /\n",
    "    \"DE\"\n",
    ")\n",
    "\n",
    "SCRIPTS = (\n",
    "    ROOT /\n",
    "    \"scripts\"\n",
    ")\n",
    "\n",
    "LOGS = (\n",
    "    ROOT /\n",
    "    \"logs\"\n",
    ")\n",
    "\n",
    "\n",
    "for directory in [\n",
    "    OUT,\n",
    "    SCRIPTS,\n",
    "    LOGS,\n",
    "]:\n",
    "\n",
    "    directory.mkdir(\n",
    "        parents=True,\n",
    "        exist_ok=True,\n",
    "    )\n",
    "\n",
    "\n",
    "assert ROOT.exists()\n",
    "\n",
    "assert LOCKS.exists()\n",
    "\n",
    "assert DL.exists()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. REQUIRED UPSTREAM LOCKS\n",
    "# ============================================================\n",
    "\n",
    "PRIMARY_LOCK = (\n",
    "    LOCKS /\n",
    "    \"AD_PRIMARY_REPLICATION_EVIDENCE_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "PRE138_LOCK = (\n",
    "    LOCKS /\n",
    "    \"GSE138852_RETINA_ND_PRE_DE_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "FINAL138_LOCK = (\n",
    "    LOCKS /\n",
    "    \"GSE138852_SECONDARY_AD_EFFECTS_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "assert PRIMARY_LOCK.exists(), (\n",
    "    \"STEP 30 output lock is missing:\\n\"\n",
    "    f\"{PRIMARY_LOCK}\"\n",
    ")\n",
    "\n",
    "\n",
    "assert PRE138_LOCK.exists(), (\n",
    "    \"GSE138852 pre-DE lock is missing:\\n\"\n",
    "    f\"{PRE138_LOCK}\"\n",
    ")\n",
    "\n",
    "\n",
    "with open(\n",
    "    PRE138_LOCK,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    pre138 = json.load(\n",
    "        f\n",
    "    )\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre138[\n",
    "        \"disease_DE_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. INPUT FILES\n",
    "# ============================================================\n",
    "\n",
    "COUNTS_PATH = (\n",
    "    DL /\n",
    "    \"GSE138852_counts.csv.gz\"\n",
    ")\n",
    "\n",
    "AUTHOR_PATH = (\n",
    "    DL /\n",
    "    \"adsn_metadata.txt\"\n",
    ")\n",
    "\n",
    "GEO_COVARIATES_PATH = (\n",
    "    DL /\n",
    "    \"GSE138852_covariates.csv.gz\"\n",
    ")\n",
    "\n",
    "CLINICAL_PATH = (\n",
    "    SEC /\n",
    "    \"GSE138852_CLINICAL_METADATA_FROZEN_v1.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "    COUNTS_PATH,\n",
    "    AUTHOR_PATH,\n",
    "    GEO_COVARIATES_PATH,\n",
    "    CLINICAL_PATH,\n",
    "]:\n",
    "\n",
    "    assert (\n",
    "        path.exists()\n",
    "        and\n",
    "        path.stat().st_size > 0\n",
    "    ), (\n",
    "        f\"Missing required file:\\n{path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. PACKAGE VERSIONS\n",
    "#\n",
    "# Run DESeq2 in a NEW Python process, just like fixed STEP 29.\n",
    "# ============================================================\n",
    "\n",
    "TARGET_PACKAGES = {\n",
    "\n",
    "    \"pandas\":\n",
    "        \"2.3.3\",\n",
    "\n",
    "    \"pydeseq2\":\n",
    "        \"0.5.4\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "for package, version in TARGET_PACKAGES.items():\n",
    "\n",
    "    try:\n",
    "\n",
    "        current = (\n",
    "            importlib.metadata.version(\n",
    "                package\n",
    "            )\n",
    "        )\n",
    "\n",
    "    except Exception:\n",
    "\n",
    "        current = None\n",
    "\n",
    "\n",
    "    if current != version:\n",
    "\n",
    "        print(\n",
    "            f\"Installing {package}=={version} \"\n",
    "            f\"(current={current})\"\n",
    "        )\n",
    "\n",
    "\n",
    "        subprocess.check_call(\n",
    "            [\n",
    "                sys.executable,\n",
    "                \"-m\",\n",
    "                \"pip\",\n",
    "                \"install\",\n",
    "                \"-q\",\n",
    "                \"--upgrade\",\n",
    "                f\"{package}=={version}\",\n",
    "            ]\n",
    "        )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. CHILD-PROCESS SCRIPT\n",
    "# ============================================================\n",
    "\n",
    "RUNNER_PATH = (\n",
    "    SCRIPTS /\n",
    "    \"GSE138852_SECONDARY_DE_FIXED.py\"\n",
    ")\n",
    "\n",
    "LOG_PATH = (\n",
    "    LOGS /\n",
    "    \"GSE138852_SECONDARY_DE_FIXED.log\"\n",
    ")\n",
    "\n",
    "\n",
    "RUNNER = r'''\n",
    "import os\n",
    "import re\n",
    "import json\n",
    "import importlib.metadata\n",
    "\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from pydeseq2.dds import DeseqDataSet\n",
    "from pydeseq2.ds import DeseqStats\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# A. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(\n",
    "    os.environ[\n",
    "        \"RETINA_ND_ROOT\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "LOCKS = (\n",
    "    ROOT /\n",
    "    \"locks\"\n",
    ")\n",
    "\n",
    "SEC = (\n",
    "    ROOT /\n",
    "    \"GSE138852_AD_secondary\"\n",
    ")\n",
    "\n",
    "DL = (\n",
    "    SEC /\n",
    "    \"downloads\"\n",
    ")\n",
    "\n",
    "OUT = (\n",
    "    SEC /\n",
    "    \"DE\"\n",
    ")\n",
    "\n",
    "OUT.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "\n",
    "COUNTS_PATH = (\n",
    "    DL /\n",
    "    \"GSE138852_counts.csv.gz\"\n",
    ")\n",
    "\n",
    "AUTHOR_PATH = (\n",
    "    DL /\n",
    "    \"adsn_metadata.txt\"\n",
    ")\n",
    "\n",
    "GEO_PATH = (\n",
    "    DL /\n",
    "    \"GSE138852_covariates.csv.gz\"\n",
    ")\n",
    "\n",
    "CLINICAL_PATH = (\n",
    "    SEC /\n",
    "    \"GSE138852_CLINICAL_METADATA_FROZEN_v1.csv\"\n",
    ")\n",
    "\n",
    "PRE_LOCK = (\n",
    "    LOCKS /\n",
    "    \"GSE138852_RETINA_ND_PRE_DE_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "FINAL_LOCK = (\n",
    "    LOCKS /\n",
    "    \"GSE138852_SECONDARY_AD_EFFECTS_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# B. ENVIRONMENT\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"GSE138852 SECONDARY EXTERNAL REPLICATION DE\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"pandas:\",\n",
    "    pd.__version__\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"pydeseq2:\",\n",
    "    importlib.metadata.version(\n",
    "        \"pydeseq2\"\n",
    "    )\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"anndata:\",\n",
    "    importlib.metadata.version(\n",
    "        \"anndata\"\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# Confirm the API required by current AnnData.\n",
    "pd.StringDtype(\n",
    "    na_value=np.nan\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# C. PRE-DE LOCK\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    PRE_LOCK,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    pre = json.load(\n",
    "        f\n",
    "    )\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre[\n",
    "        \"disease_DE_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre[\n",
    "        \"primary_threshold\"\n",
    "    ]\n",
    "    ==\n",
    "    10\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# D. LOAD AUTHOR + GEO METADATA\n",
    "# ============================================================\n",
    "\n",
    "author = pd.read_csv(\n",
    "    AUTHOR_PATH,\n",
    "    sep=\"\\t\",\n",
    "    low_memory=False,\n",
    ")\n",
    "\n",
    "\n",
    "geo = pd.read_csv(\n",
    "    GEO_PATH,\n",
    "    low_memory=False,\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    author\n",
    ") == 13214\n",
    "\n",
    "\n",
    "assert len(\n",
    "    geo\n",
    ") == 13214\n",
    "\n",
    "\n",
    "required_author = {\n",
    "\n",
    "    \"cell\",\n",
    "    \"batch\",\n",
    "    \"patient\",\n",
    "    \"sex\",\n",
    "    \"cellType\",\n",
    "    \"batchCond\",\n",
    "    \"subclustCond\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "missing = (\n",
    "    required_author\n",
    "    -\n",
    "    set(\n",
    "        author.columns\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert not missing, (\n",
    "    f\"Missing author metadata columns: {sorted(missing)}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# E. REVERIFY AUTHOR ↔ GEO ROW ALIGNMENT\n",
    "# ============================================================\n",
    "\n",
    "checks = [\n",
    "\n",
    "    (\n",
    "        \"batchCond\",\n",
    "        \"oupSample.batchCond\",\n",
    "    ),\n",
    "\n",
    "    (\n",
    "        \"cellType\",\n",
    "        \"oupSample.cellType\",\n",
    "    ),\n",
    "\n",
    "    (\n",
    "        \"subclustCond\",\n",
    "        \"oupSample.subclustCond\",\n",
    "    ),\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "for author_col, geo_col in checks:\n",
    "\n",
    "    assert geo_col in geo.columns\n",
    "\n",
    "\n",
    "    a = (\n",
    "        author[\n",
    "            author_col\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .str.strip()\n",
    "        .to_numpy()\n",
    "    )\n",
    "\n",
    "\n",
    "    g = (\n",
    "        geo[\n",
    "            geo_col\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .str.strip()\n",
    "        .to_numpy()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        a\n",
    "        ==\n",
    "        g\n",
    "    ).all(), (\n",
    "        f\"Author/GEO row mismatch: \"\n",
    "        f\"{author_col} ↔ {geo_col}\"\n",
    "    )\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nAuthor ↔ GEO row alignment: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# F. LOAD COUNTS\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\nLoading GSE138852 processed count matrix...\"\n",
    ")\n",
    "\n",
    "\n",
    "C = pd.read_csv(\n",
    "    COUNTS_PATH,\n",
    "    index_col=0,\n",
    "    low_memory=False,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Raw processed matrix shape:\",\n",
    "    C.shape\n",
    ")\n",
    "\n",
    "\n",
    "if C.shape[\n",
    "    1\n",
    "] == 13214:\n",
    "\n",
    "    genes_by_cells = C\n",
    "\n",
    "\n",
    "elif C.shape[\n",
    "    0\n",
    "] == 13214:\n",
    "\n",
    "    genes_by_cells = C.T\n",
    "\n",
    "\n",
    "else:\n",
    "\n",
    "    raise RuntimeError(\n",
    "        \"Neither count dimension equals 13,214 nuclei: \"\n",
    "        f\"{C.shape}\"\n",
    "    )\n",
    "\n",
    "\n",
    "count_cells = (\n",
    "\n",
    "    pd.Index(\n",
    "        genes_by_cells.columns\n",
    "    )\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    "    .tolist()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    count_cells\n",
    ") == 13214\n",
    "\n",
    "\n",
    "assert len(\n",
    "    set(\n",
    "        count_cells\n",
    "    )\n",
    ") == 13214\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Count-matrix nuclei:\",\n",
    "    len(\n",
    "        count_cells\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFirst count IDs:\"\n",
    ")\n",
    "\n",
    "\n",
    "for value in count_cells[\n",
    "    :5\n",
    "]:\n",
    "\n",
    "    print(\n",
    "        \" \",\n",
    "        value\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# G. CORRECT COUNT ↔ METADATA LINKAGE\n",
    "#\n",
    "# Count matrix example:\n",
    "#\n",
    "#     ACTATCTTCATTATCC_AD3_AD4\n",
    "#\n",
    "# Author metadata example:\n",
    "#\n",
    "#     AAACCTGGTAGAAAGG_AD_09241_09006\n",
    "#\n",
    "# Author metadata separately contains:\n",
    "#\n",
    "#     batch = AD5_AD6\n",
    "#\n",
    "# Therefore construct:\n",
    "#\n",
    "#     barcode + \"_\" + batch\n",
    "# ============================================================\n",
    "\n",
    "def barcode(\n",
    "    value\n",
    "):\n",
    "\n",
    "    value = str(\n",
    "        value\n",
    "    ).strip().upper()\n",
    "\n",
    "\n",
    "    match = re.match(\n",
    "        r\"^([ACGTN]{16})(?:_|-|$)\",\n",
    "        value,\n",
    "    )\n",
    "\n",
    "\n",
    "    if match is None:\n",
    "\n",
    "        return None\n",
    "\n",
    "\n",
    "    return match.group(\n",
    "        1\n",
    "    )\n",
    "\n",
    "\n",
    "author_barcode = (\n",
    "    author[\n",
    "        \"cell\"\n",
    "    ]\n",
    "    .map(\n",
    "        barcode\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert author_barcode.notna().all(), (\n",
    "    \"Could not extract a 16-base barcode from every \"\n",
    "    \"author metadata cell identifier.\"\n",
    ")\n",
    "\n",
    "\n",
    "author_batch = (\n",
    "\n",
    "    author[\n",
    "        \"batch\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "author_key = (\n",
    "\n",
    "    author_barcode\n",
    "    +\n",
    "    \"_\"\n",
    "    +\n",
    "    author_batch\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "meta = None\n",
    "\n",
    "linkage = None\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Primary linkage:\n",
    "# barcode + biological batch\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "if (\n",
    "    author_key.nunique()\n",
    "    ==\n",
    "    len(\n",
    "        author_key\n",
    "    )\n",
    "    and\n",
    "    set(\n",
    "        author_key\n",
    "    )\n",
    "    ==\n",
    "    set(\n",
    "        count_cells\n",
    "    )\n",
    "):\n",
    "\n",
    "\n",
    "    lookup = dict(\n",
    "        zip(\n",
    "            author_key,\n",
    "            range(\n",
    "                len(\n",
    "                    author\n",
    "                )\n",
    "            ),\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    order = [\n",
    "        lookup[\n",
    "            cell_id\n",
    "        ]\n",
    "        for cell_id\n",
    "        in count_cells\n",
    "    ]\n",
    "\n",
    "\n",
    "    meta = (\n",
    "\n",
    "        author\n",
    "        .iloc[\n",
    "            order\n",
    "        ]\n",
    "        .reset_index(\n",
    "            drop=True\n",
    "        )\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    reconstructed = (\n",
    "\n",
    "        meta[\n",
    "            \"cell\"\n",    "        ]\n",
    "        .map(\n",
    "            barcode\n",
    "        )\n",
    "\n",
    "        +\n",
    "\n",
    "        \"_\"\n",
    "\n",
    "        +\n",
    "\n",
    "        meta[\n",
    "            \"batch\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .str.strip()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        reconstructed.tolist()\n",
    "        ==\n",
    "        count_cells\n",
    "    )\n",
    "\n",
    "\n",
    "    linkage = (\n",
    "        \"author_barcode_plus_batch\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# H. FALLBACK:\n",
    "# SEARCH GEO COVARIATES FOR A UNIQUE COUNT-ID COLUMN\n",
    "#\n",
    "# Author and GEO rows were already independently verified\n",
    "# aligned above.\n",
    "# ============================================================\n",
    "\n",
    "if meta is None:\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nDirect barcode+batch linkage not exact.\"\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Searching verified GEO covariates for ID bridge...\"\n",
    "    )\n",
    "\n",
    "\n",
    "    bridge = None\n",
    "\n",
    "\n",
    "    for column in geo.columns:\n",
    "\n",
    "\n",
    "        values = (\n",
    "\n",
    "            geo[\n",
    "                column\n",
    "            ]\n",
    "            .astype(str)\n",
    "            .str.strip()\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        if (\n",
    "\n",
    "            values.nunique()\n",
    "            ==\n",
    "            len(\n",
    "                values\n",
    "            )\n",
    "\n",
    "            and\n",
    "\n",
    "            set(\n",
    "                values\n",
    "            )\n",
    "            ==\n",
    "            set(\n",
    "                count_cells\n",
    "            )\n",
    "\n",
    "        ):\n",
    "\n",
    "\n",
    "            bridge = column\n",
    "\n",
    "            break\n",
    "\n",
    "\n",
    "    if bridge is not None:\n",
    "\n",
    "\n",
    "        values = (\n",
    "\n",
    "            geo[\n",
    "                bridge\n",
    "            ]\n",
    "            .astype(str)\n",
    "            .str.strip()\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        lookup = dict(\n",
    "            zip(\n",
    "                values,\n",
    "                range(\n",
    "                    len(\n",
    "                        values\n",
    "                    )\n",
    "                ),\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "        order = [\n",
    "            lookup[\n",
    "                cell_id\n",
    "            ]\n",
    "            for cell_id\n",
    "            in count_cells\n",
    "        ]\n",
    "\n",
    "\n",
    "        # author and GEO have the same verified row order\n",
    "        meta = (\n",
    "\n",
    "            author\n",
    "            .iloc[\n",
    "                order\n",
    "            ]\n",
    "            .reset_index(\n",
    "                drop=True\n",
    "            )\n",
    "            .copy()\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        linkage = (\n",
    "            \"verified_GEO_bridge:\"\n",
    "            +\n",
    "            str(\n",
    "                bridge\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# I. HARD STOP WITH DIAGNOSTICS IF LINKAGE CANNOT BE PROVEN\n",
    "# ============================================================\n",
    "\n",
    "if meta is None:\n",
    "\n",
    "\n",
    "    missing_author = list(\n",
    "\n",
    "        set(\n",
    "            count_cells\n",
    "        )\n",
    "\n",
    "        -\n",
    "\n",
    "        set(\n",
    "            author_key\n",
    "        )\n",
    "\n",
    "    )[\n",
    "        :20\n",
    "    ]\n",
    "\n",
    "\n",
    "    missing_counts = list(\n",
    "\n",
    "        set(\n",
    "            author_key\n",
    "        )\n",
    "\n",
    "        -\n",
    "\n",
    "        set(\n",
    "            count_cells\n",
    "        )\n",
    "\n",
    "    )[\n",
    "        :20\n",
    "    ]\n",
    "\n",
    "\n",
    "    raise RuntimeError(\n",
    "\n",
    "        \"Could not prove count-column ↔ author-metadata \"\n",
    "        \"linkage.\\n\\n\"\n",
    "\n",
    "        f\"First count IDs:\\n{count_cells[:10]}\\n\\n\"\n",
    "\n",
    "        f\"First reconstructed metadata keys:\\n\"\n",
    "        f\"{author_key.head(10).tolist()}\\n\\n\"\n",
    "\n",
    "        f\"Count IDs missing from reconstructed metadata \"\n",
    "        f\"(first 20):\\n{missing_author}\\n\\n\"\n",
    "\n",
    "        f\"Metadata keys missing from counts \"\n",
    "        f\"(first 20):\\n{missing_counts}\"\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "assert len(\n",
    "    meta\n",
    ") == 13214\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nCount/metadata linkage:\",\n",
    "    linkage\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Count ↔ metadata linkage: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# J. ASSIGNED DONORS + TARGET CELL TYPES\n",
    "# ============================================================\n",
    "\n",
    "assigned_mask = (\n",
    "\n",
    "    ~meta[\n",
    "        \"patient\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .isin(\n",
    "        [\n",
    "            \"AD-un\",\n",
    "            \"Ct-un\",\n",
    "        ]\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "celltype = (\n",
    "\n",
    "    meta[\n",
    "        \"cellType\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    "    .str.lower()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "cell_map = {\n",
    "\n",
    "    \"astro\":\n",
    "        \"Astro\",\n",
    "\n",
    "    \"mg\":\n",
    "        \"Micro\",\n",
    "\n",
    "    \"opc\":\n",
    "        \"OPC\",\n",
    "\n",
    "    \"oligo\":\n",
    "        \"Oligo\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "meta = meta.copy()\n",
    "\n",
    "\n",
    "meta[\n",
    "    \"target_cell_type\"\n",
    "] = celltype.map(\n",
    "    cell_map\n",
    ")\n",
    "\n",
    "\n",
    "clinical = pd.read_csv(\n",
    "    CLINICAL_PATH\n",
    ")\n",
    "\n",
    "\n",
    "required_clinical = {\n",
    "\n",
    "    \"donor_id\",\n",
    "    \"diagnosis_binary\",\n",
    "    \"age\",\n",
    "    \"sex\",\n",
    "    \"PMI_hours\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "assert required_clinical.issubset(\n",
    "    clinical.columns\n",
    ")\n",
    "\n",
    "\n",
    "assert clinical[\n",
    "    \"donor_id\"\n",
    "].is_unique\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# K. DESEQ2 HELPER\n",
    "# ============================================================\n",
    "\n",
    "def fit(\n",
    "    counts,\n",
    "    metadata,\n",
    "    formula,\n",
    "):\n",
    "\n",
    "\n",
    "    assert (\n",
    "        counts.index.tolist()\n",
    "        ==\n",
    "        metadata.index.tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        counts.columns.is_unique\n",
    "    )\n",
    "\n",
    "\n",
    "    dds = DeseqDataSet(\n",
    "\n",
    "        counts=counts,\n",
    "\n",
    "        metadata=metadata,\n",
    "\n",
    "        design=formula,\n",
    "\n",
    "        refit_cooks=True,\n",
    "\n",
    "        n_cpus=2,\n",
    "\n",
    "        quiet=False,\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    dds.deseq2()\n",
    "\n",
    "\n",
    "    stats = DeseqStats(\n",
    "\n",
    "        dds,\n",
    "\n",
    "        contrast=[\n",
    "            \"diagnosis_binary\",\n",
    "            \"AD\",\n",
    "            \"Control\",\n",
    "        ],\n",
    "\n",
    "        alpha=0.05,\n",
    "\n",
    "        cooks_filter=True,\n",
    "\n",
    "        independent_filter=True,\n",
    "\n",
    "        n_cpus=2,\n",
    "\n",
    "        quiet=False,\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    stats.summary()\n",
    "\n",
    "\n",
    "    result = (\n",
    "        stats\n",
    "        .results_df\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    result.index = (\n",
    "        result.index\n",
    "        .astype(str)\n",
    "    )\n",
    "\n",
    "\n",
    "    result.index.name = (\n",
    "        \"gene_id\"\n",
    "    )\n",
    "\n",
    "\n",
    "    return result.reset_index()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# L. PSEUDOBULK + DE\n",
    "# ============================================================\n",
    "\n",
    "classes = [\n",
    "\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "primary_results = []\n",
    "\n",
    "pmi_results = []\n",
    "\n",
    "summary_rows = []\n",
    "\n",
    "\n",
    "for ct in classes:\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\n\"\n",
    "        +\n",
    "        \"=\" * 90\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        ct\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"=\" * 90\n",
    "    )\n",
    "\n",
    "\n",
    "    target = (\n",
    "\n",
    "        assigned_mask\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            meta[\n",
    "                \"target_cell_type\"\n",
    "            ]\n",
    "            ==\n",
    "            ct\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    idx = np.flatnonzero(\n",
    "        target.to_numpy()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        idx\n",
    "    ) > 0\n",
    "\n",
    "\n",
    "    cell_meta = (\n",
    "\n",
    "        meta\n",
    "        .iloc[\n",
    "            idx\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    donors = (\n",
    "\n",
    "        cell_meta[\n",
    "            \"patient\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    coverage = (\n",
    "        donors\n",
    "        .value_counts()\n",
    "    )\n",
    "\n",
    "\n",
    "    eligible = (\n",
    "\n",
    "        coverage[\n",
    "            coverage\n",
    "            >=\n",
    "            10\n",
    "        ]\n",
    "        .index\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    eligible = sorted(\n",
    "        eligible\n",
    "    )\n",
    "\n",
    "\n",
    "    cell_keep = (\n",
    "\n",
    "        donors\n",
    "        .isin(\n",
    "            eligible\n",
    "        )\n",
    "        .to_numpy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    idx = idx[\n",
    "        cell_keep\n",
    "    ]\n",
    "\n",
    "\n",
    "    cell_meta = (\n",
    "\n",
    "        cell_meta\n",
    "        .iloc[\n",
    "            np.flatnonzero(\n",
    "                cell_keep\n",
    "            )\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    cmeta = (\n",
    "\n",
    "        clinical.loc[\n",
    "            clinical[\n",
    "                \"donor_id\"\n",
    "            ]\n",
    "            .astype(str)\n",
    "            .isin(\n",
    "                eligible\n",
    "            )\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    nAD = int(\n",
    "        (\n",
    "            cmeta[\n",
    "                \"diagnosis_binary\"\n",
    "            ]\n",
    "            ==\n",
    "            \"AD\"\n",
    "        )\n",
    "        .sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    nControl = int(\n",
    "        (\n",
    "            cmeta[\n",
    "                \"diagnosis_binary\"\n",
    "            ]\n",
    "            ==\n",
    "            \"Control\"\n",
    "        )\n",
    "        .sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert min(\n",
    "        nAD,\n",
    "        nControl,\n",
    "    ) >= 5, (\n",
    "        f\"{ct}: insufficient donor support \"\n",
    "        f\"(AD={nAD}, Control={nControl})\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Pseudobulk\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    sub = genes_by_cells.iloc[\n",
    "        :,\n",
    "        idx,\n",
    "    ]\n",
    "\n",
    "\n",
    "    patient_vector = (\n",
    "\n",
    "        cell_meta[\n",
    "            \"patient\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .to_numpy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    pb = pd.DataFrame(\n",
    "        {\n",
    "\n",
    "            donor:\n",
    "                sub.loc[\n",
    "                    :,\n",
    "                    patient_vector\n",
    "                    ==\n",
    "                    donor\n",
    "                ]\n",
    "                .sum(\n",
    "                    axis=1\n",
    "                )\n",
    "\n",
    "            for donor\n",
    "            in eligible\n",
    "\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    pb = pb.apply(\n",
    "        pd.to_numeric,\n",
    "        errors=\"raise\",\n",
    "    )\n",
    "\n",
    "\n",
    "    arr = pb.to_numpy(\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "\n",
    "    assert np.isfinite(\n",
    "        arr\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    assert (\n",
    "        arr\n",
    "        >=\n",
    "        0\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    assert np.allclose(\n",
    "        arr,\n",
    "        np.rint(\n",
    "            arr\n",
    "        ),\n",
    "    )\n",
    "\n",
    "\n",
    "    pb = pd.DataFrame(\n",
    "\n",
    "        np.rint(\n",
    "            arr\n",
    "        ).astype(\n",
    "            np.int64\n",
    "        ),\n",
    "\n",
    "        index=pd.Index(\n",
    "            pb.index.astype(str),\n",
    "            dtype=object,\n",
    "        ),\n",
    "\n",
    "        columns=pb.columns,\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # CPM gene filter\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    library_size = (\n",
    "\n",
    "        pb\n",
    "        .sum(\n",
    "            axis=0\n",
    "        )\n",
    "        .to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        library_size\n",
    "        >\n",
    "        0\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    cpm = (\n",
    "\n",
    "        pb.to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "\n",
    "        /\n",
    "\n",
    "        library_size[\n",
    "            None,\n",
    "            :\n",
    "        ]\n",
    "\n",
    "        *\n",
    "\n",
    "        1e6\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    keep = (\n",
    "\n",
    "        (\n",
    "            cpm\n",
    "            >=\n",
    "            1\n",
    "        )\n",
    "        .sum(\n",
    "            axis=1\n",
    "        )\n",
    "\n",
    "        >=\n",
    "\n",
    "        min(\n",
    "            nAD,\n",
    "            nControl,\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    symbols = (\n",
    "        pb.index\n",
    "        .astype(str)\n",
    "    )\n",
    "\n",
    "\n",
    "    mitochondrial = np.asarray(\n",
    "\n",
    "        pd.Index(\n",
    "            symbols\n",
    "        )\n",
    "        .str.upper()\n",
    "        .str.startswith(\n",
    "            \"MT-\"\n",
    "        ),\n",
    "\n",
    "        dtype=bool,\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    keep = (\n",
    "        keep\n",
    "        &\n",
    "        ~mitochondrial\n",
    "    )\n",
    "\n",
    "\n",
    "    pb = (\n",
    "        pb.loc[\n",
    "            keep\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert pb.shape[\n",
    "        0\n",
    "    ] > 3000\n",
    "\n",
    "\n",
    "    assert pb.index.is_unique, (\n",
    "        f\"{ct}: gene identifiers are not unique.\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # DESeq2 donor × gene count matrix\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    counts = (\n",
    "        pb\n",
    "        .T\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    counts.index = pd.Index(\n",
    "        eligible,\n",
    "        dtype=object,\n",
    "    )\n",
    "\n",
    "\n",
    "    counts.columns = pd.Index(\n",
    "        pb.index.astype(str),\n",
    "        dtype=object,\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Donor metadata\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    md = (\n",
    "\n",
    "        cmeta\n",
    "        .assign(\n",
    "            donor_id=lambda x:\n",
    "                x[\n",
    "                    \"donor_id\"\n",
    "                ]\n",
    "                .astype(str)\n",
    "        )\n",
    "        .set_index(\n",
    "            \"donor_id\"\n",
    "        )\n",
    "        .loc[\n",
    "            eligible,\n",
    "            [\n",
    "                \"age\",\n",
    "                \"sex\",\n",
    "                \"PMI_hours\",\n",
    "                \"diagnosis_binary\",\n",
    "            ],\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    md[\n",
    "        \"age\"\n",
    "    ] = pd.to_numeric(\n",
    "        md[\n",
    "            \"age\"\n",
    "        ],\n",
    "        errors=\"raise\",\n",
    "    )\n",
    "\n",
    "\n",
    "    md[\n",
    "        \"PMI_hours\"\n",
    "    ] = pd.to_numeric(\n",
    "        md[\n",
    "            \"PMI_hours\"\n",
    "        ],\n",
    "        errors=\"raise\",\n",
    "    )\n",
    "\n",
    "\n",
    "    sex_map = {\n",
    "\n",
    "        \"F\":\n",
    "            \"Female\",\n",
    "\n",
    "        \"M\":\n",
    "            \"Male\",\n",
    "\n",
    "        \"Female\":\n",
    "            \"Female\",\n",
    "\n",
    "        \"Male\":\n",
    "            \"Male\",\n",
    "\n",
    "        \"female\":\n",
    "            \"Female\",\n",
    "\n",
    "        \"male\":\n",
    "            \"Male\",\n",
    "\n",
    "    }\n",
    "\n",
    "\n",
    "    sex_raw = (\n",
    "\n",
    "        md[\n",
    "            \"sex\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .str.strip()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    md[\n",
    "        \"sex\"\n",
    "    ] = sex_raw.map(\n",
    "        sex_map\n",
    "    )\n",
    "\n",
    "\n",
    "    assert md[\n",
    "        \"sex\"\n",
    "    ].notna().all()\n",
    "\n",
    "\n",
    "    md[\n",
    "        \"sex\"\n",
    "    ] = pd.Categorical(\n",
    "\n",
    "        md[\n",
    "            \"sex\"\n",
    "        ],\n",
    "\n",
    "        categories=[\n",
    "            \"Female\",\n",
    "            \"Male\",\n",
    "        ],\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    md[\n",
    "        \"diagnosis_binary\"\n",
    "    ] = pd.Categorical(\n",
    "\n",
    "        md[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .str.strip(),\n",
    "\n",
    "        categories=[\n",
    "            \"Control\",\n",
    "            \"AD\",\n",
    "        ],\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert md[\n",
    "        \"diagnosis_binary\"\n",
    "    ].notna().all()\n",
    "\n",
    "\n",
    "    assert (\n",
    "        counts.index.tolist()\n",
    "        ==\n",
    "        md.index.tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Eligible nuclei:\",\n",
    "        len(\n",
    "            idx\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Eligible donors:\",\n",
    "        len(\n",
    "            eligible\n",
    "        ),\n",
    "        f\"(AD={nAD}, Control={nControl})\"\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Genes after filter:\",\n",
    "        counts.shape[\n",
    "            1\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # PRIMARY MODEL\n",
    "    # ========================================================\n",
    "\n",
    "    primary = fit(\n",
    "\n",
    "        counts,\n",
    "\n",
    "        md[\n",    "            [\n",
    "                \"age\",\n",
    "                \"sex\",\n",
    "                \"diagnosis_binary\",\n",
    "            ]\n",
    "        ],\n",
    "\n",
    "        \"~ age + sex + diagnosis_binary\",\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # PMI SENSITIVITY MODEL\n",
    "    # ========================================================\n",
    "\n",
    "    pmi = fit(\n",
    "\n",
    "        counts,\n",
    "\n",
    "        md[\n",
    "            [\n",
    "                \"age\",\n",
    "                \"sex\",\n",
    "                \"PMI_hours\",\n",
    "                \"diagnosis_binary\",\n",
    "            ]\n",
    "        ],\n",
    "\n",
    "        \"~ age + sex + PMI_hours + diagnosis_binary\",\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # ANNOTATE RESULTS\n",
    "    # ========================================================\n",
    "\n",
    "    for table, label, store in [\n",
    "\n",
    "        (\n",
    "            primary,\n",
    "            \"PRIMARY\",\n",
    "            primary_results,\n",
    "        ),\n",
    "\n",
    "        (\n",
    "            pmi,\n",
    "            \"PMI\",\n",
    "            pmi_results,\n",
    "        ),\n",
    "\n",
    "    ]:\n",
    "\n",
    "\n",
    "        table.insert(\n",
    "\n",
    "            1,\n",
    "\n",
    "            \"gene_symbol\",\n",
    "\n",
    "            table[\n",
    "                \"gene_id\"\n",
    "            ]\n",
    "            .astype(str),\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        table[\n",
    "            \"cell_type\"\n",
    "        ] = ct\n",
    "\n",
    "\n",
    "        table[\n",
    "            \"analysis_model\"\n",
    "        ] = label\n",
    "\n",
    "\n",
    "        store.append(\n",
    "            table\n",
    "        )\n",
    "\n",
    "\n",
    "    summary_rows.append(\n",
    "        {\n",
    "\n",
    "            \"cell_type\":\n",
    "                ct,\n",
    "\n",
    "            \"donors\":\n",
    "                len(\n",
    "                    eligible\n",
    "                ),\n",
    "\n",
    "            \"AD\":\n",
    "                nAD,\n",
    "\n",
    "            \"Control\":\n",
    "                nControl,\n",
    "\n",
    "            \"eligible_nuclei\":\n",
    "                int(\n",
    "                    len(\n",
    "                        idx\n",
    "                    )\n",
    "                ),\n",
    "\n",
    "            \"tested_genes\":\n",
    "                int(\n",
    "                    len(\n",
    "                        primary\n",
    "                    )\n",
    "                ),\n",
    "\n",
    "            \"primary_FDR\":\n",
    "                int(\n",
    "                    (\n",
    "                        primary[\n",
    "                            \"padj\"\n",
    "                        ]\n",
    "                        <\n",
    "                        0.05\n",
    "                    )\n",
    "                    .fillna(\n",
    "                        False\n",
    "                    )\n",
    "                    .sum()\n",
    "                ),\n",
    "\n",
    "            \"PMI_FDR\":\n",
    "                int(\n",
    "                    (\n",
    "                        pmi[\n",
    "                            \"padj\"\n",
    "                        ]\n",
    "                        <\n",
    "                        0.05\n",
    "                    )\n",
    "                    .fillna(\n",
    "                        False\n",
    "                    )\n",
    "                    .sum()\n",
    "                ),\n",
    "\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# M. COMBINE RESULTS\n",
    "# ============================================================\n",
    "\n",
    "P138 = pd.concat(\n",
    "    primary_results,\n",
    "    ignore_index=True,\n",
    ")\n",
    "\n",
    "\n",
    "Q138 = pd.concat(\n",
    "    pmi_results,\n",
    "    ignore_index=True,\n",
    ")\n",
    "\n",
    "\n",
    "summary = pd.DataFrame(\n",
    "    summary_rows\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# N. SAVE\n",
    "# ============================================================\n",
    "\n",
    "PRIMARY_EFFECTS = (\n",
    "    OUT /\n",
    "    \"GSE138852_AD_SECONDARY_PRIMARY_ALL_EFFECTS_LONG_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "PMI_EFFECTS = (\n",
    "    OUT /\n",
    "    \"GSE138852_AD_SECONDARY_PMI_ALL_EFFECTS_LONG_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "SUMMARY_PATH = (\n",
    "    OUT /\n",
    "    \"GSE138852_AD_SECONDARY_DE_SUMMARY_v1.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "P138.to_csv(\n",
    "    PRIMARY_EFFECTS,\n",
    "    index=False,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "Q138.to_csv(\n",
    "    PMI_EFFECTS,\n",
    "    index=False,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "summary.to_csv(\n",
    "    SUMMARY_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "    PRIMARY_EFFECTS,\n",
    "    PMI_EFFECTS,\n",
    "    SUMMARY_PATH,\n",
    "]:\n",
    "\n",
    "    assert (\n",
    "        path.exists()\n",
    "        and\n",
    "        path.stat().st_size > 0\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# O. FINAL LOCK\n",
    "# ============================================================\n",
    "\n",
    "lock = {\n",
    "\n",
    "    \"status\":\n",
    "        \"GSE138852_SECONDARY_AD_EFFECTS_FROZEN\",\n",
    "\n",
    "    \"count_metadata_linkage\":\n",
    "        linkage,\n",
    "\n",
    "    \"primary_threshold\":\n",
    "        10,\n",
    "\n",
    "    \"primary_model\":\n",
    "        \"~ age + sex + diagnosis_binary\",\n",
    "\n",
    "    \"PMI_model\":\n",
    "        \"~ age + sex + PMI_hours + diagnosis_binary\",\n",
    "\n",
    "    \"batch_adjustment\":\n",
    "        False,\n",
    "\n",
    "    \"batch_reason\":\n",
    "        (\n",
    "            \"pooled-library batch is nested/confounded \"\n",
    "            \"with diagnosis\"\n",
    "        ),\n",
    "\n",
    "    \"primary_effects\":\n",
    "        str(\n",
    "            PRIMARY_EFFECTS\n",
    "        ),\n",
    "\n",
    "    \"PMI_effects\":\n",
    "        str(\n",
    "            PMI_EFFECTS\n",
    "        ),\n",
    "\n",
    "    \"summary\":\n",
    "        summary.to_dict(\n",
    "            \"records\"\n",
    "        ),\n",
    "\n",
    "    \"AD_PD_convergence_performed\":\n",
    "        False,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    FINAL_LOCK,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        lock,\n",
    "        f,\n",
    "        indent=2,\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# P. REPORT\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"GSE138852 SECONDARY AD EFFECTS FROZEN\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Verified count/metadata linkage:\",\n",
    "    linkage\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nDE summary:\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    summary.to_string(\n",
    "        index=False\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPrimary effects:\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    PRIMARY_EFFECTS\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPMI effects:\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    PMI_EFFECTS\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFinal lock:\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    FINAL_LOCK\n",
    ")\n",
    "'''\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. VERIFY CHILD SCRIPT SYNTAX\n",
    "# ============================================================\n",
    "\n",
    "compile(\n",
    "    RUNNER,\n",
    "    \"<GSE138852_SECONDARY_DE_FIXED>\",\n",
    "    \"exec\",\n",
    ")\n",
    "\n",
    "\n",
    "RUNNER_PATH.write_text(\n",
    "    RUNNER,\n",
    "    encoding=\"utf-8\",\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"GSE138852 SECONDARY DE — FIXED REPLACEMENT\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Runner syntax check: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nLaunching fresh Python process...\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. RUN CHILD PROCESS\n",
    "# ============================================================\n",
    "\n",
    "env = os.environ.copy()\n",
    "\n",
    "\n",
    "env[\n",
    "    \"RETINA_ND_ROOT\"\n",
    "] = str(\n",
    "    ROOT\n",
    ")\n",
    "\n",
    "\n",
    "env[\n",
    "    \"PYTHONUNBUFFERED\"\n",
    "] = \"1\"\n",
    "\n",
    "\n",
    "with open(\n",
    "    LOG_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as log_file:\n",
    "\n",
    "\n",
    "    proc = subprocess.Popen(\n",
    "\n",
    "        [\n",
    "            sys.executable,\n",
    "            \"-u\",\n",
    "            str(\n",
    "                RUNNER_PATH\n",
    "            ),\n",
    "        ],\n",
    "\n",
    "        stdout=subprocess.PIPE,\n",
    "\n",
    "        stderr=subprocess.STDOUT,\n",
    "\n",
    "        text=True,\n",
    "\n",
    "        env=env,\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    for line in proc.stdout:\n",
    "\n",
    "\n",
    "        print(\n",
    "            line,\n",
    "            end=\"\",\n",
    "        )\n",
    "\n",
    "\n",
    "        log_file.write(\n",
    "            line\n",
    "        )\n",
    "\n",
    "\n",
    "    return_code = proc.wait()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. FAILURE REPORT\n",
    "# ============================================================\n",
    "\n",
    "if return_code != 0:\n",
    "\n",
    "\n",
    "    raise RuntimeError(\n",
    "\n",
    "        \"GSE138852 secondary DE failed inside the fresh \"\n",
    "        f\"process (exit code {return_code}).\\n\\n\"\n",
    "\n",
    "        \"The complete underlying traceback is printed above \"\n",
    "        \"and saved here:\\n\"\n",
    "\n",
    "        f\"{LOG_PATH}\"\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. VERIFY FINAL LOCK\n",
    "# ============================================================\n",
    "\n",
    "assert FINAL138_LOCK.exists(), (\n",
    "    \"Fresh process completed but final GSE138852 lock \"\n",
    "    f\"is missing:\\n{FINAL138_LOCK}\"\n",
    ")\n",
    "\n",
    "\n",
    "with open(\n",
    "    FINAL138_LOCK,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    result = json.load(\n",
    "        f\n",
    "    )\n",
    "\n",
    "\n",
    "assert (\n",
    "    result[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"GSE138852_SECONDARY_AD_EFFECTS_FROZEN\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. FINAL NOTEBOOK REPORT\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"GSE138852 SECONDARY REPLICATION COMPLETED SUCCESSFULLY\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Count/metadata linkage:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    result[\n",
    "        \"count_metadata_linkage\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nNEXT: FINAL AD EVIDENCE FREEZE\"\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 59\n",
    "# ============================================================\n",
    "# V2 FINAL AD EVIDENCE FREEZE — PRIMARY + SECONDARY REPLICATION\n",
    "# COMPLETE FIXED REPLACEMENT\n",
    "#\n",
    "# PURPOSE\n",
    "# -------\n",
    "# Combine:\n",
    "#\n",
    "#   Discovery:\n",
    "#       GSE174367\n",
    "#\n",
    "#   Primary replication:\n",
    "#       GSE157827\n",
    "#\n",
    "#   Secondary external replication:\n",
    "#       GSE138852\n",
    "#\n",
    "# IMPORTANT FIX\n",
    "# -------------\n",
    "# GSE174367 discovery uses frozen column names:\n",
    "#\n",
    "#   AD_vs_Control_log2FC\n",
    "#   AD_vs_Control_Wald\n",
    "#   AD_vs_Control_pvalue\n",
    "#   AD_vs_Control_padj\n",
    "#\n",
    "# whereas GSE138852 secondary replication uses:\n",
    "#\n",
    "#   log2FoldChange\n",
    "#   stat\n",
    "#   pvalue\n",
    "#   padj\n",
    "#\n",
    "# The old cell relied on merge suffixes before harmonizing\n",
    "# these schemas, so log2FoldChange_disc never existed.\n",
    "# ============================================================\n",
    "\n",
    "import json\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from scipy.stats import spearmanr\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = (\n",
    "    ROOT /\n",
    "    \"locks\"\n",
    ")\n",
    "\n",
    "RESULTS = (\n",
    "    ROOT /\n",
    "    \"results\"\n",
    ")\n",
    "\n",
    "\n",
    "assert ROOT.exists(), (\n",
    "    f\"Missing project root:\\n{ROOT}\"\n",
    ")\n",
    "\n",
    "assert LOCKS.exists(), (\n",
    "    f\"Missing locks directory:\\n{LOCKS}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. REQUIRED UPSTREAM LOCKS\n",
    "# ============================================================\n",
    "\n",
    "PRIMARY_REPLICATION_LOCK = (\n",
    "    LOCKS /\n",
    "    \"AD_PRIMARY_REPLICATION_EVIDENCE_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "SECONDARY_EFFECT_LOCK = (\n",
    "    LOCKS /\n",
    "    \"GSE138852_SECONDARY_AD_EFFECTS_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "FINAL_AD_LOCK = (\n",
    "    LOCKS /\n",
    "    \"AD_REPLICATION_EVIDENCE_FINAL_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "assert PRIMARY_REPLICATION_LOCK.exists(), (\n",
    "    \"Missing STEP 30 primary-replication lock:\\n\"\n",
    "    f\"{PRIMARY_REPLICATION_LOCK}\"\n",
    ")\n",
    "\n",
    "\n",
    "assert SECONDARY_EFFECT_LOCK.exists(), (\n",
    "    \"Missing GSE138852 secondary-effects lock:\\n\"\n",
    "    f\"{SECONDARY_EFFECT_LOCK}\"\n",
    ")\n",
    "\n",
    "\n",
    "with open(\n",
    "    PRIMARY_REPLICATION_LOCK,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    primary_lock = json.load(\n",
    "        f\n",
    "    )\n",
    "\n",
    "\n",
    "with open(\n",
    "    SECONDARY_EFFECT_LOCK,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    secondary_lock = json.load(\n",
    "        f\n",
    "    )\n",
    "\n",
    "\n",
    "assert (\n",
    "    primary_lock.get(\n",
    "        \"status\"\n",
    "    )\n",
    "    ==\n",
    "    \"AD_PRIMARY_REPLICATION_EVIDENCE_FROZEN\"\n",
    "), (\n",
    "    \"STEP 30 primary replication lock has unexpected status:\\n\"\n",
    "    f\"{primary_lock.get('status')}\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    secondary_lock.get(\n",
    "        \"status\"\n",
    "    )\n",
    "    ==\n",
    "    \"GSE138852_SECONDARY_AD_EFFECTS_FROZEN\"\n",
    "), (\n",
    "    \"GSE138852 secondary-effect lock has unexpected status:\\n\"\n",
    "    f\"{secondary_lock.get('status')}\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"V2 FINAL AD EVIDENCE FREEZE\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PRIMARY + SECONDARY REPLICATION\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Primary replication evidence: PASS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Secondary replication effects: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. FIND THE EXACT DISCOVERY EFFECT TABLE\n",
    "# ============================================================\n",
    "\n",
    "def one_exact(\n",
    "    filename\n",
    "):\n",
    "\n",
    "    hits = list(\n",
    "        ROOT.rglob(\n",
    "            filename\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        hits\n",
    "    ) == 1, (\n",
    "        f\"Expected exactly one file named:\\n\"\n",
    "        f\"{filename}\\n\\n\"\n",
    "        f\"Found {len(hits)}:\\n\"\n",
    "        f\"{hits}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    return hits[\n",
    "        0\n",
    "    ]\n",
    "\n",
    "\n",
    "DISCOVERY_PATH = one_exact(\n",
    "    \"GSE174367_AD_DISCOVERY_ALL_EFFECTS_LONG_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. SECONDARY EFFECT TABLE\n",
    "#\n",
    "# Prefer the exact path recorded by the successful GSE138852\n",
    "# lock rather than guessing.\n",
    "# ============================================================\n",
    "\n",
    "SECONDARY_PATH = Path(\n",
    "    secondary_lock[\n",
    "        \"primary_effects\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "assert SECONDARY_PATH.exists(), (\n",
    "    \"Secondary GSE138852 primary-effect table is missing:\\n\"\n",
    "    f\"{SECONDARY_PATH}\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nDiscovery:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    DISCOVERY_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSecondary external replication:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    SECONDARY_PATH\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. LOAD TABLES\n",
    "# ============================================================\n",
    "\n",
    "D_raw = pd.read_csv(\n",
    "    DISCOVERY_PATH,\n",
    "    compression=\"gzip\",\n",
    "    low_memory=False,\n",
    ")\n",
    "\n",
    "\n",
    "S_raw = pd.read_csv(\n",
    "    SECONDARY_PATH,\n",
    "    compression=\"gzip\",\n",
    "    low_memory=False,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nDiscovery shape:\",\n",
    "    D_raw.shape\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Secondary shape:\",\n",
    "    S_raw.shape\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nOriginal discovery columns:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    D_raw.columns.tolist()\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nOriginal secondary columns:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    S_raw.columns.tolist()\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. HARMONIZE DISCOVERY SCHEMA\n",
    "#\n",
    "# This is the exact bug in the old cell.\n",
    "# ============================================================\n",
    "\n",
    "DISCOVERY_RENAME = {\n",
    "\n",
    "    \"AD_vs_Control_log2FC\":\n",
    "        \"log2FoldChange\",\n",
    "\n",
    "    \"AD_vs_Control_lfcSE\":\n",
    "        \"lfcSE\",\n",
    "\n",
    "    \"AD_vs_Control_Wald\":\n",
    "        \"stat\",\n",
    "\n",
    "    \"AD_vs_Control_pvalue\":\n",
    "        \"pvalue\",\n",
    "\n",
    "    \"AD_vs_Control_padj\":\n",
    "        \"padj\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "D = (\n",
    "    D_raw\n",
    "    .rename(\n",
    "        columns=DISCOVERY_RENAME\n",
    "    )\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "\n",
    "S = S_raw.copy()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. VERIFY REQUIRED COLUMNS\n",
    "# ============================================================\n",
    "\n",
    "REQUIRED = {\n",
    "\n",
    "    \"cell_type\",\n",
    "    \"gene_symbol\",\n",
    "    \"log2FoldChange\",\n",
    "    \"stat\",\n",
    "    \"pvalue\",\n",
    "    \"padj\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "missing_D = (\n",
    "    REQUIRED\n",
    "    -\n",
    "    set(\n",
    "        D.columns\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "missing_S = (\n",
    "    REQUIRED\n",
    "    -\n",
    "    set(\n",
    "        S.columns\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert not missing_D, (\n",
    "    \"Discovery table missing required columns after \"\n",
    "    \"harmonization:\\n\"\n",
    "    f\"{sorted(missing_D)}\"\n",
    ")\n",
    "\n",
    "\n",
    "assert not missing_S, (\n",
    "    \"Secondary table missing required columns:\\n\"\n",
    "    f\"{sorted(missing_S)}\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nDiscovery schema harmonization: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. TARGET CELL CLASSES\n",
    "# ============================================================\n",
    "\n",
    "CLASSES = [\n",
    "\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "for ct in CLASSES:\n",
    "\n",
    "    assert (\n",
    "        D[\n",
    "            \"cell_type\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .eq(\n",
    "            ct\n",
    "        )\n",
    "        .any()\n",
    "    ), (\n",
    "        f\"Discovery missing cell type: {ct}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        S[\n",
    "            \"cell_type\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .eq(\n",
    "            ct\n",
    "        )\n",
    "        .any()\n",
    "    ), (\n",
    "        f\"Secondary replication missing cell type: {ct}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. UNIQUE-SYMBOL HELPER\n",
    "#\n",
    "# Cross-dataset matching is performed on gene symbol.\n",
    "#\n",
    "# Symbols duplicated inside either dataset are excluded because\n",
    "# they cannot provide an unambiguous one-to-one cross-dataset\n",
    "# match.\n",
    "# ============================================================\n",
    "\n",
    "def unique_symbol(\n",
    "    table\n",
    "):\n",
    "\n",
    "    x = table.copy()\n",    "\n",
    "\n",
    "    x[\n",
    "        \"gene_symbol\"\n",
    "    ] = (\n",
    "        x[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .str.strip()\n",
    "        .str.upper()\n",
    "    )\n",
    "\n",
    "\n",
    "    # Remove missing/empty pseudo-symbols.\n",
    "    x = x.loc[\n",
    "        x[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .notna()\n",
    "    ].copy()\n",
    "\n",
    "\n",
    "    x = x.loc[\n",
    "        ~x[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .isin(\n",
    "            [\n",
    "                \"\",\n",
    "                \"NAN\",\n",
    "                \"NONE\",\n",
    "            ]\n",
    "        )\n",
    "    ].copy()\n",
    "\n",
    "\n",
    "    duplicated = (\n",
    "        x[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .duplicated(\n",
    "            keep=False\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    x = x.loc[\n",
    "        ~duplicated\n",
    "    ].copy()\n",
    "\n",
    "\n",
    "    assert (\n",
    "        x[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .is_unique\n",
    "    )\n",
    "\n",
    "\n",
    "    return x\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. SAFE SPEARMAN\n",
    "# ============================================================\n",
    "\n",
    "def safe_spearman(\n",
    "    x,\n",
    "    y,\n",
    "):\n",
    "\n",
    "    x = np.asarray(\n",
    "        x,\n",
    "        dtype=float,\n",
    "    )\n",
    "\n",
    "\n",
    "    y = np.asarray(\n",
    "        y,\n",
    "        dtype=float,\n",
    "    )\n",
    "\n",
    "\n",
    "    finite = (\n",
    "\n",
    "        np.isfinite(\n",
    "            x\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        np.isfinite(\n",
    "            y\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    x = x[\n",
    "        finite\n",
    "    ]\n",
    "\n",
    "\n",
    "    y = y[\n",
    "        finite\n",
    "    ]\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        x\n",
    "    ) >= 3, (\n",
    "        \"Fewer than three finite matched observations.\"\n",
    "    )\n",
    "\n",
    "\n",
    "    result = spearmanr(\n",
    "        x,\n",
    "        y,\n",
    "    )\n",
    "\n",
    "\n",
    "    return {\n",
    "\n",
    "        \"rho\":\n",
    "            float(\n",
    "                result.statistic\n",
    "            ),\n",
    "\n",
    "        \"pvalue\":\n",
    "            float(\n",
    "                result.pvalue\n",
    "            ),\n",
    "\n",
    "        \"n\":\n",
    "            int(\n",
    "                len(\n",
    "                    x\n",
    "                )\n",
    "            ),\n",
    "\n",
    "    }\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. DISCOVERY ↔ SECONDARY EXTERNAL REPLICATION\n",
    "# ============================================================\n",
    "\n",
    "rows = []\n",
    "\n",
    "hit_tables = []\n",
    "\n",
    "\n",
    "for ct in CLASSES:\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\n\"\n",
    "        +\n",
    "        \"=\" * 90\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        ct\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"=\" * 90\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Discovery\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    d = unique_symbol(\n",
    "\n",
    "        D.loc[\n",
    "            D[\n",
    "                \"cell_type\"\n",
    "            ]\n",
    "            .astype(str)\n",
    "            ==\n",
    "            ct\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Secondary replication\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    s = unique_symbol(\n",
    "\n",
    "        S.loc[\n",
    "            S[\n",
    "                \"cell_type\"\n",
    "            ]\n",
    "            .astype(str)\n",
    "            ==\n",
    "            ct\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        d\n",
    "    ) > 0\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        s\n",
    "    ) > 0\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # EXPLICITLY NAME DISCOVERY COLUMNS\n",
    "    #\n",
    "    # Do not rely on pandas merge suffixes.\n",
    "    # ========================================================\n",
    "\n",
    "    d_compare = (\n",
    "\n",
    "        d[\n",
    "            [\n",
    "                \"gene_symbol\",\n",
    "                \"log2FoldChange\",\n",
    "                \"stat\",\n",
    "                \"pvalue\",\n",
    "                \"padj\",\n",
    "            ]\n",
    "        ]\n",
    "\n",
    "        .rename(\n",
    "            columns={\n",
    "\n",
    "                \"log2FoldChange\":\n",
    "                    \"log2FoldChange_disc\",\n",
    "\n",
    "                \"stat\":\n",
    "                    \"stat_disc\",\n",
    "\n",
    "                \"pvalue\":\n",
    "                    \"pvalue_disc\",\n",
    "\n",
    "                \"padj\":\n",
    "                    \"padj_disc\",\n",
    "\n",
    "            }\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # EXPLICITLY NAME SECONDARY COLUMNS\n",
    "    # ========================================================\n",
    "\n",
    "    s_compare = (\n",
    "\n",
    "        s[\n",
    "            [\n",
    "                \"gene_symbol\",\n",
    "                \"log2FoldChange\",\n",
    "                \"stat\",\n",
    "                \"pvalue\",\n",
    "                \"padj\",\n",
    "            ]\n",
    "        ]\n",
    "\n",
    "        .rename(\n",
    "            columns={\n",
    "\n",
    "                \"log2FoldChange\":\n",
    "                    \"log2FoldChange_sec\",\n",
    "\n",
    "                \"stat\":\n",
    "                    \"stat_sec\",\n",
    "\n",
    "                \"pvalue\":\n",
    "                    \"pvalue_sec\",\n",
    "\n",
    "                \"padj\":\n",
    "                    \"padj_sec\",\n",
    "\n",
    "            }\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # ONE-TO-ONE SYMBOL MATCH\n",
    "    # ========================================================\n",
    "\n",
    "    m = d_compare.merge(\n",
    "\n",
    "        s_compare,\n",
    "\n",
    "        on=\"gene_symbol\",\n",
    "\n",
    "        how=\"inner\",\n",
    "\n",
    "        validate=\"one_to_one\",\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        m\n",
    "    ) >= 3, (\n",
    "        f\"{ct}: too few matched unique genes: {len(m)}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # GLOBAL EFFECT CONCORDANCE\n",
    "    # ========================================================\n",
    "\n",
    "    lfc = safe_spearman(\n",
    "\n",
    "        m[\n",
    "            \"log2FoldChange_disc\"\n",
    "        ],\n",
    "\n",
    "        m[\n",
    "            \"log2FoldChange_sec\"\n",
    "        ],\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    wald = safe_spearman(\n",
    "\n",
    "        m[\n",
    "            \"stat_disc\"\n",
    "        ],\n",
    "\n",
    "        m[\n",
    "            \"stat_sec\"\n",
    "        ],\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # ALL-GENE DIRECTION CONCORDANCE\n",
    "    # ========================================================\n",
    "\n",
    "    finite_direction = (\n",
    "\n",
    "        np.isfinite(\n",
    "            m[\n",
    "                \"log2FoldChange_disc\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        np.isfinite(\n",
    "            m[\n",
    "                \"log2FoldChange_sec\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    direction_m = m.loc[\n",
    "        finite_direction\n",
    "    ].copy()\n",
    "\n",
    "\n",
    "    same_direction_all = (\n",
    "\n",
    "        np.sign(\n",
    "            direction_m[\n",
    "                \"log2FoldChange_disc\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        ==\n",
    "\n",
    "        np.sign(\n",
    "            direction_m[\n",
    "                \"log2FoldChange_sec\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    all_gene_direction_concordance = float(\n",
    "        same_direction_all.mean()\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # DISCOVERY FDR HITS THAT CAN BE MEASURED IN SECONDARY\n",
    "    # ========================================================\n",
    "\n",
    "    discovery_hit_mask = (\n",
    "\n",
    "        np.isfinite(\n",
    "            m[\n",
    "                \"padj_disc\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            m[\n",
    "                \"padj_disc\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    hits = m.loc[\n",
    "        discovery_hit_mask\n",
    "    ].copy()\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # HIT-LEVEL SECONDARY SUPPORT\n",
    "    # ========================================================\n",
    "\n",
    "    if len(\n",
    "        hits\n",
    "    ) > 0:\n",
    "\n",
    "\n",
    "        hits[\n",
    "            \"same_direction\"\n",
    "        ] = (\n",
    "\n",
    "            np.sign(\n",
    "                hits[\n",
    "                    \"log2FoldChange_disc\"\n",
    "                ]\n",
    "            )\n",
    "\n",
    "            ==\n",
    "\n",
    "            np.sign(\n",
    "                hits[\n",
    "                    \"log2FoldChange_sec\"\n",
    "                ]\n",
    "            )\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        hits[\n",
    "            \"secondary_nominal_p_lt_0_05\"\n",
    "        ] = (\n",
    "\n",
    "            np.isfinite(\n",
    "                hits[\n",
    "                    \"pvalue_sec\"\n",
    "                ]\n",
    "            )\n",
    "\n",
    "            &\n",
    "\n",
    "            (\n",
    "                hits[\n",
    "                    \"pvalue_sec\"\n",
    "                ]\n",
    "                <\n",
    "                0.05\n",
    "            )\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        hits[\n",
    "            \"secondary_gene_level_success\"\n",
    "        ] = (\n",
    "\n",
    "            hits[\n",
    "                \"same_direction\"\n",
    "            ]\n",
    "\n",
    "            &\n",
    "\n",
    "            hits[\n",
    "                \"secondary_nominal_p_lt_0_05\"\n",
    "            ]\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        hits[\n",
    "            \"secondary_FDR_success\"\n",
    "        ] = (\n",
    "\n",
    "            np.isfinite(\n",
    "                hits[\n",
    "                    \"padj_sec\"\n",
    "                ]\n",
    "            )\n",
    "\n",
    "            &\n",
    "\n",
    "            (\n",
    "                hits[\n",
    "                    \"padj_sec\"\n",
    "                ]\n",
    "                <\n",
    "                0.05\n",
    "            )\n",
    "\n",
    "            &\n",
    "\n",
    "            hits[\n",
    "                \"same_direction\"\n",
    "            ]\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        same_direction_hits = int(\n",
    "\n",
    "            hits[\n",
    "                \"same_direction\"\n",
    "            ]\n",
    "            .sum()\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        nominal_success = int(\n",
    "\n",
    "            hits[\n",
    "                \"secondary_gene_level_success\"\n",
    "            ]\n",
    "            .sum()\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        FDR_success = int(\n",
    "\n",
    "            hits[\n",
    "                \"secondary_FDR_success\"\n",
    "            ]\n",
    "            .sum()\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        hits.insert(\n",
    "            0,\n",
    "            \"cell_type\",\n",
    "            ct,\n",
    "        )\n",
    "\n",
    "\n",
    "        hit_tables.append(\n",
    "            hits\n",
    "        )\n",
    "\n",
    "\n",
    "    else:\n",
    "\n",
    "\n",
    "        same_direction_hits = 0\n",
    "\n",
    "        nominal_success = 0\n",
    "\n",
    "        FDR_success = 0\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # SUMMARY ROW\n",
    "    # ========================================================\n",
    "\n",
    "    row = {\n",
    "\n",
    "        \"cell_type\":\n",
    "            ct,\n",
    "\n",
    "        \"matched_unique_genes\":\n",
    "            int(\n",
    "                len(\n",
    "                    m\n",
    "                )\n",
    "            ),\n",
    "\n",
    "        \"secondary_LFC_pairs\":\n",
    "            lfc[\n",
    "                \"n\"\n",
    "            ],\n",
    "\n",
    "        \"secondary_LFC_spearman\":\n",
    "            lfc[\n",
    "                \"rho\"\n",
    "            ],\n",
    "\n",
    "        \"secondary_LFC_spearman_p\":\n",
    "            lfc[\n",
    "                \"pvalue\"\n",
    "            ],\n",
    "\n",
    "        \"secondary_Wald_pairs\":\n",
    "            wald[\n",
    "                \"n\"\n",
    "            ],\n",
    "\n",
    "        \"secondary_Wald_spearman\":\n",
    "            wald[\n",
    "                \"rho\"\n",
    "            ],\n",
    "\n",
    "        \"secondary_Wald_spearman_p\":\n",
    "            wald[\n",
    "                \"pvalue\"\n",
    "            ],\n",
    "\n",
    "        \"all_gene_direction_concordance\":\n",
    "            all_gene_direction_concordance,\n",
    "\n",
    "        \"discovery_FDR_measurable\":\n",
    "            int(\n",
    "                len(\n",
    "                    hits\n",
    "                )\n",
    "            ),\n",
    "\n",
    "        \"discovery_FDR_same_direction\":\n",
    "            same_direction_hits,\n",
    "\n",
    "        \"discovery_FDR_same_direction_and_secondary_nominal\":\n",
    "            nominal_success,\n",
    "\n",
    "        \"discovery_FDR_same_direction_and_secondary_FDR\":\n",
    "            FDR_success,\n",
    "\n",
    "    }\n",
    "\n",
    "\n",
    "    rows.append(\n",
    "        row\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # PRINT\n",
    "    # ========================================================\n",
    "\n",
    "    print(\n",
    "        \"Discovery unique-symbol genes:\",\n",
    "        f\"{len(d):,}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Secondary unique-symbol genes:\",\n",
    "        f\"{len(s):,}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Matched unique genes:\",\n",
    "        f\"{len(m):,}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Secondary LFC Spearman:\",\n",
    "        lfc[\n",
    "            \"rho\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Secondary Wald Spearman:\",\n",
    "        wald[\n",
    "            \"rho\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"All-gene direction concordance:\",\n",
    "        all_gene_direction_concordance\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Discovery FDR measurable:\",\n",
    "        len(\n",
    "            hits\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Discovery FDR same direction:\",\n",
    "        same_direction_hits\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Same direction + secondary nominal P<0.05:\",\n",
    "        nominal_success\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Same direction + secondary FDR<0.05:\",\n",
    "        FDR_success\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. FINAL SECONDARY SUMMARY\n",
    "# ============================================================\n",
    "\n",
    "sec_summary = pd.DataFrame(\n",
    "    rows\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    sec_summary[\n",
    "        \"cell_type\"\n",
    "    ]\n",
    "    .tolist()\n",
    "    ==\n",
    "    CLASSES\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 12. COMBINED HIT TABLE\n",
    "# ============================================================\n",
    "\n",
    "if hit_tables:\n",
    "\n",
    "\n",
    "    secondary_hits = pd.concat(\n",
    "        hit_tables,\n",
    "        axis=0,\n",
    "        ignore_index=True,\n",
    "    )\n",
    "\n",
    "\n",
    "else:\n",
    "\n",
    "\n",
    "    secondary_hits = pd.DataFrame(\n",
    "        columns=[\n",
    "            \"cell_type\",\n",
    "            \"gene_symbol\",\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 13. SAVE SECONDARY EVIDENCE\n",
    "# ============================================================\n",
    "\n",
    "OUT = (\n",
    "    RESULTS /\n",
    "    \"AD_secondary_replication\"\n",
    ")\n",
    "\n",
    "\n",
    "OUT.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "\n",
    "SECONDARY_SUMMARY_PATH = (\n",
    "    OUT /\n",
    "    \"GSE174367_vs_GSE138852_SECONDARY_EVIDENCE_v1.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "SECONDARY_HITS_PATH = (\n",
    "    OUT /\n",
    "    \"GSE174367_DISCOVERY_FDR_GSE138852_SUPPORT_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "sec_summary.to_csv(\n",
    "    SECONDARY_SUMMARY_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "secondary_hits.to_csv(\n",
    "    SECONDARY_HITS_PATH,\n",
    "    index=False,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    SECONDARY_SUMMARY_PATH.exists()\n",
    "    and\n",
    "    SECONDARY_SUMMARY_PATH.stat().st_size > 0\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    SECONDARY_HITS_PATH.exists()\n",
    "    and\n",
    "    SECONDARY_HITS_PATH.stat().st_size > 0\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 14. VERIFY PRIMARY SUMMARY STILL EXISTS\n",
    "# ============================================================\n",
    "\n",
    "primary_summary_path = Path(\n",
    "    primary_lock[\n",
    "        \"summary_file\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "assert primary_summary_path.exists(), (\n",
    "    \"STEP 30 primary-replication summary is missing:\\n\"\n",
    "    f\"{primary_summary_path}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 15. FINAL AD REPLICATION-EVIDENCE LOCK\n",
    "# ============================================================\n",
    "\n",
    "final = {\n",
    "\n",
    "    \"status\":\n",
    "        \"AD_REPLICATION_EVIDENCE_FINAL_FROZEN\",\n",
    "\n",
    "    \"discovery\":\n",
    "        \"GSE174367\",\n",
    "\n",
    "    \"primary_replication\":\n",
    "        \"GSE157827\",\n",
    "\n",
    "    \"secondary_external_replication\":\n",
    "        \"GSE138852\",\n",
    "\n",
    "    \"discovery_effect_file\":\n",
    "        str(\n",
    "            DISCOVERY_PATH\n",
    "        ),\n",
    "\n",
    "    \"primary_replication_lock\":\n",
    "        str(\n",
    "            PRIMARY_REPLICATION_LOCK\n",
    "        ),\n",
    "\n",
    "    \"primary_replication_summary\":\n",
    "        str(\n",
    "            primary_summary_path\n",
    "        ),\n",
    "\n",
    "    \"secondary_effect_lock\":\n",
    "        str(\n",
    "            SECONDARY_EFFECT_LOCK\n",
    "        ),\n",
    "\n",
    "    \"secondary_effect_file\":\n",
    "        str(\n",
    "            SECONDARY_PATH\n",
    "        ),\n",
    "\n",
    "    \"secondary_summary\":\n",
    "        str(\n",
    "            SECONDARY_SUMMARY_PATH\n",
    "        ),\n",
    "\n",
    "    \"secondary_discovery_hit_support\":\n",
    "        str(\n",
    "            SECONDARY_HITS_PATH\n",
    "        ),\n",
    "\n",
    "    \"secondary_comparison_level\":\n",
    "        \"unique normalized gene symbol\",\n",
    "\n",
    "    \"secondary_gene_level_support_rule\":\n",
    "        (\n",
    "            \"discovery FDR < 0.05 AND same effect direction \"\n",
    "            \"AND GSE138852 nominal p < 0.05\"\n",
    "        ),\n",
    "\n",
    "    \"schema_harmonization\": {\n",
    "\n",
    "        \"GSE174367_log2FC\":\n",
    "            \"AD_vs_Control_log2FC -> log2FoldChange\",\n",
    "\n",
    "        \"GSE174367_Wald\":\n",
    "            \"AD_vs_Control_Wald -> stat\",\n",
    "\n",
    "        \"GSE174367_pvalue\":\n",
    "            \"AD_vs_Control_pvalue -> pvalue\",\n",
    "\n",
    "        \"GSE174367_padj\":\n",
    "            \"AD_vs_Control_padj -> padj\",\n",
    "\n",
    "        \"GSE138852\":\n",
    "            \"standard PyDESeq2 effect names\",\n",
    "\n",
    "    },\n",
    "\n",
    "    \"AD_PD_convergence_performed\":\n",
    "        False,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    FINAL_AD_LOCK,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        final,\n",
    "        f,\n",
    "        indent=2,\n",
    "    )\n",
    "\n",
    "\n",
    "assert FINAL_AD_LOCK.exists()\n",
    "\n",
    "\n",
    "assert (\n",
    "    FINAL_AD_LOCK.stat().st_size\n",
    "    >\n",
    "    0\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 16. READ BACK FINAL LOCK\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    FINAL_AD_LOCK,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    final_check = json.load(\n",
    "        f\n",
    "    )\n",
    "\n",
    "\n",
    "assert (\n",
    "    final_check[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"AD_REPLICATION_EVIDENCE_FINAL_FROZEN\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    final_check[\n",
    "        \"AD_PD_convergence_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 17. FINAL REPORT\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"FINAL AD REPLICATION EVIDENCE FROZEN\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",    "\n",
    "\n",
    "print(\n",
    "    \"\\nSecondary replication evidence:\"\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    sec_summary\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSecondary evidence summary:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    SECONDARY_SUMMARY_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSecondary discovery-hit support:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    SECONDARY_HITS_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPrimary replication summary retained:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    primary_summary_path\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFINAL AD EVIDENCE LOCK:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    FINAL_AD_LOCK\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nAD ↔ PD convergence has NOT yet been performed.\"\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Part V — Cross-disease convergence\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 63\n",
    "# ============================================================\n",
    "# V2 CROSS-DISEASE CONVERGENCE — PRIMARY GENE-EFFECT METRICS\n",
    "# COMPLETE FIXED REPLACEMENT\n",
    "# ============================================================\n",
    "\n",
    "from pathlib import Path\n",
    "import json\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from scipy.stats import spearmanr, binomtest, norm\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 0. Paths\n",
    "# ------------------------------------------------------------\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "LOCKS = ROOT / \"locks\"\n",
    "OUT = ROOT / \"results\" / \"cross_disease_convergence\"\n",
    "OUT.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "assert ROOT.exists(), f\"Missing project root: {ROOT}\"\n",
    "assert LOCKS.exists(), f\"Missing locks directory: {LOCKS}\"\n",
    "\n",
    "AD_FINAL_LOCK = LOCKS / \"AD_REPLICATION_EVIDENCE_FINAL_FREEZE_v1.json\"\n",
    "PD_DISCOVERY_LOCK = LOCKS / \"GSE243639_PD_DISCOVERY_EFFECT_FREEZE_v1.json\"\n",
    "\n",
    "assert AD_FINAL_LOCK.exists(), (\n",
    "    \"Complete/freeze AD replication evidence before AD↔PD convergence.\"\n",
    ")\n",
    "\n",
    "assert PD_DISCOVERY_LOCK.exists(), (\n",
    "    f\"Missing PD discovery lock: {PD_DISCOVERY_LOCK}\"\n",
    ")\n",
    "\n",
    "with open(AD_FINAL_LOCK, \"r\", encoding=\"utf-8\") as f:\n",
    "    ad_final = json.load(f)\n",
    "\n",
    "assert ad_final.get(\"status\") == \"AD_REPLICATION_EVIDENCE_FINAL_FROZEN\", (\n",
    "    f\"Unexpected AD final-evidence status: {ad_final.get('status')}\"\n",
    ")\n",
    "\n",
    "print(\"=\" * 90)\n",
    "print(\"V2 CROSS-DISEASE CONVERGENCE — PRIMARY GENE-EFFECT METRICS\")\n",
    "print(\"=\" * 90)\n",
    "\n",
    "print(\"AD final replication evidence: VERIFIED\")\n",
    "print(\"PD discovery effects: VERIFIED\")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 1. Locate exact frozen effect tables\n",
    "# ------------------------------------------------------------\n",
    "def one_exact(filename):\n",
    "\n",
    "    hits = list(\n",
    "        ROOT.rglob(filename)\n",
    "    )\n",
    "\n",
    "    assert len(hits) == 1, (\n",
    "        f\"Expected exactly one {filename}; \"\n",
    "        f\"found {len(hits)}:\\n{hits}\"\n",
    "    )\n",
    "\n",
    "    return hits[0]\n",
    "\n",
    "\n",
    "AD_PATH = one_exact(\n",
    "    \"GSE174367_AD_DISCOVERY_ALL_EFFECTS_LONG_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "PD_PATH = one_exact(\n",
    "    \"GSE243639_PD_DISCOVERY_ALL_EFFECTS_LONG_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "AD_raw = pd.read_csv(\n",
    "    AD_PATH,\n",
    "    compression=\"gzip\",\n",
    "    low_memory=False,\n",
    ")\n",
    "\n",
    "PD_raw = pd.read_csv(\n",
    "    PD_PATH,\n",
    "    compression=\"gzip\",\n",
    "    low_memory=False,\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\nAD effect table:\")\n",
    "print(AD_PATH)\n",
    "print(\"AD shape:\", AD_raw.shape)\n",
    "\n",
    "print(\"\\nPD effect table:\")\n",
    "print(PD_PATH)\n",
    "print(\"PD shape:\", PD_raw.shape)\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 2. Harmonize BOTH frozen schemas\n",
    "# ------------------------------------------------------------\n",
    "AD = AD_raw.rename(\n",
    "    columns={\n",
    "        \"AD_vs_Control_log2FC\":\n",
    "            \"log2FoldChange\",\n",
    "\n",
    "        \"AD_vs_Control_lfcSE\":\n",
    "            \"lfcSE\",\n",
    "\n",
    "        \"AD_vs_Control_Wald\":\n",
    "            \"stat\",\n",
    "\n",
    "        \"AD_vs_Control_pvalue\":\n",
    "            \"pvalue\",\n",
    "\n",
    "        \"AD_vs_Control_padj\":\n",
    "            \"padj\",\n",
    "    }\n",
    ").copy()\n",
    "\n",
    "\n",
    "PD = PD_raw.rename(\n",
    "    columns={\n",
    "        \"PD_vs_Control_log2FC\":\n",
    "            \"log2FoldChange\",\n",
    "\n",
    "        \"PD_vs_Control_lfcSE\":\n",
    "            \"lfcSE\",\n",
    "\n",
    "        \"PD_vs_Control_Wald\":\n",
    "            \"stat\",\n",
    "\n",
    "        \"PD_vs_Control_pvalue\":\n",
    "            \"pvalue\",\n",
    "\n",
    "        \"PD_vs_Control_padj\":\n",
    "            \"padj\",\n",
    "    }\n",
    ").copy()\n",
    "\n",
    "\n",
    "REQUIRED = {\n",
    "    \"cell_type\",\n",
    "    \"gene_symbol\",\n",
    "    \"log2FoldChange\",\n",
    "    \"lfcSE\",\n",
    "    \"stat\",\n",
    "    \"pvalue\",\n",
    "    \"padj\",\n",
    "}\n",
    "\n",
    "\n",
    "missing_ad = (\n",
    "    REQUIRED\n",
    "    -\n",
    "    set(AD.columns)\n",
    ")\n",
    "\n",
    "missing_pd = (\n",
    "    REQUIRED\n",
    "    -\n",
    "    set(PD.columns)\n",
    ")\n",
    "\n",
    "\n",
    "assert not missing_ad, (\n",
    "    \"AD missing after harmonization: \"\n",
    "    f\"{sorted(missing_ad)}\"\n",
    ")\n",
    "\n",
    "assert not missing_pd, (\n",
    "    \"PD missing after harmonization: \"\n",
    "    f\"{sorted(missing_pd)}\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\nAD schema harmonization: PASS\")\n",
    "print(\"PD schema harmonization: PASS\")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 3. Helpers\n",
    "# ------------------------------------------------------------\n",
    "CLASSES = [\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "]\n",
    "\n",
    "\n",
    "RNG = np.random.default_rng(\n",
    "    20260914\n",
    ")\n",
    "\n",
    "\n",
    "def unique_symbol(tab):\n",
    "\n",
    "    x = tab.loc[\n",
    "        tab[\"gene_symbol\"].notna()\n",
    "    ].copy()\n",
    "\n",
    "    x[\"gene_symbol\"] = (\n",
    "        x[\"gene_symbol\"]\n",
    "        .astype(str)\n",
    "        .str.upper()\n",
    "        .str.strip()\n",
    "    )\n",
    "\n",
    "    x = x.loc[\n",
    "        ~x[\"gene_symbol\"].isin(\n",
    "            [\n",
    "                \"\",\n",
    "                \"NAN\",\n",
    "                \"NONE\",\n",
    "            ]\n",
    "        )\n",
    "    ].copy()\n",
    "\n",
    "    x = x.loc[\n",
    "        ~x[\"gene_symbol\"].duplicated(\n",
    "            keep=False\n",
    "        )\n",
    "    ].copy()\n",
    "\n",
    "    assert x[\"gene_symbol\"].is_unique\n",
    "\n",
    "    return x\n",
    "\n",
    "\n",
    "def bh(p_values):\n",
    "\n",
    "    p = np.asarray(\n",
    "        p_values,\n",
    "        dtype=float,\n",
    "    )\n",
    "\n",
    "    out = np.full(\n",
    "        len(p),\n",
    "        np.nan,\n",
    "        dtype=float,\n",
    "    )\n",
    "\n",
    "    ok = np.isfinite(p)\n",
    "\n",
    "    idx = np.flatnonzero(\n",
    "        ok\n",
    "    )\n",
    "\n",
    "    if len(idx) == 0:\n",
    "        return out\n",
    "\n",
    "    finite_p = p[ok]\n",
    "\n",
    "    order = np.argsort(\n",
    "        finite_p\n",
    "    )\n",
    "\n",
    "    ranked = finite_p[\n",
    "        order\n",
    "    ]\n",
    "\n",
    "    q = (\n",
    "        ranked\n",
    "        *\n",
    "        len(idx)\n",
    "        /\n",
    "        np.arange(\n",
    "            1,\n",
    "            len(idx) + 1,\n",
    "        )\n",
    "    )\n",
    "\n",
    "    q = np.minimum.accumulate(\n",
    "        q[::-1]\n",
    "    )[::-1]\n",
    "\n",
    "    q = np.clip(\n",
    "        q,\n",
    "        0,\n",
    "        1,\n",
    "    )\n",
    "\n",
    "    out[\n",
    "        idx[order]\n",
    "    ] = q\n",
    "\n",
    "    return out\n",
    "\n",
    "\n",
    "def permutation_spearman(\n",
    "    x,\n",
    "    y,\n",
    "    n_permutations=10000,\n",
    "):\n",
    "\n",
    "    x = np.asarray(\n",
    "        x,\n",
    "        dtype=float,\n",
    "    )\n",
    "\n",
    "    y = np.asarray(\n",
    "        y,\n",
    "        dtype=float,\n",
    "    )\n",
    "\n",
    "    ok = (\n",
    "        np.isfinite(x)\n",
    "        &\n",
    "        np.isfinite(y)\n",
    "    )\n",
    "\n",
    "    x = x[ok]\n",
    "    y = y[ok]\n",
    "\n",
    "    assert len(x) >= 3, (\n",
    "        \"Fewer than 3 finite matched values.\"\n",
    "    )\n",
    "\n",
    "    observed = float(\n",
    "        spearmanr(\n",
    "            x,\n",
    "            y,\n",
    "        ).statistic\n",
    "    )\n",
    "\n",
    "    assert np.isfinite(observed), (\n",
    "        \"Observed Spearman rho is non-finite.\"\n",
    "    )\n",
    "\n",
    "    ge = 0\n",
    "\n",
    "    for _ in range(\n",
    "        n_permutations\n",
    "    ):\n",
    "\n",
    "        rho = float(\n",
    "            spearmanr(\n",
    "                x,\n",
    "                RNG.permutation(y),\n",
    "            ).statistic\n",
    "        )\n",
    "\n",
    "        if (\n",
    "            np.isfinite(rho)\n",
    "            and\n",
    "            rho >= observed\n",
    "        ):\n",
    "            ge += 1\n",
    "\n",
    "    return {\n",
    "        \"rho\":\n",
    "            observed,\n",
    "\n",
    "        \"pvalue\":\n",
    "            float(\n",
    "                (ge + 1)\n",
    "                /\n",
    "                (n_permutations + 1)\n",
    "            ),\n",
    "\n",
    "        \"n\":\n",
    "            int(len(x)),\n",
    "    }\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 4. Cross-disease analysis\n",
    "# ------------------------------------------------------------\n",
    "summaries = []\n",
    "\n",
    "all_gene_tables = []\n",
    "\n",
    "\n",
    "for ct in CLASSES:\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 90)\n",
    "    print(ct)\n",
    "    print(\"=\" * 90)\n",
    "\n",
    "    ad = unique_symbol(\n",
    "        AD.loc[\n",
    "            AD[\"cell_type\"]\n",
    "            .astype(str)\n",
    "            ==\n",
    "            ct\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    pd_ = unique_symbol(\n",
    "        PD.loc[\n",
    "            PD[\"cell_type\"]\n",
    "            .astype(str)\n",
    "            ==\n",
    "            ct\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    assert len(ad) > 0, (\n",
    "        f\"No AD genes for {ct}\"\n",
    "    )\n",
    "\n",
    "    assert len(pd_) > 0, (\n",
    "        f\"No PD genes for {ct}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # Explicit AD column names\n",
    "    # ========================================================\n",
    "\n",
    "    ad_cols = [\n",
    "        \"gene_symbol\",\n",
    "        \"log2FoldChange\",\n",
    "        \"lfcSE\",\n",
    "        \"stat\",\n",
    "        \"pvalue\",\n",
    "        \"padj\",\n",
    "    ]\n",
    "\n",
    "    if \"gene_id\" in ad.columns:\n",
    "        ad_cols.insert(\n",
    "            1,\n",
    "            \"gene_id\",\n",
    "        )\n",
    "\n",
    "\n",
    "    a = (\n",
    "        ad[\n",
    "            ad_cols\n",
    "        ]\n",
    "        .rename(\n",
    "            columns={\n",
    "                \"gene_id\":\n",
    "                    \"gene_id_AD\",\n",
    "\n",
    "                \"log2FoldChange\":\n",
    "                    \"log2FoldChange_AD\",\n",
    "\n",
    "                \"lfcSE\":\n",
    "                    \"lfcSE_AD\",\n",
    "\n",
    "                \"stat\":\n",
    "                    \"stat_AD\",\n",
    "\n",
    "                \"pvalue\":\n",
    "                    \"pvalue_AD\",\n",
    "\n",
    "                \"padj\":\n",
    "                    \"padj_AD\",\n",
    "            }\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # Explicit PD column names\n",
    "    # ========================================================\n",
    "\n",
    "    pd_cols = [\n",
    "        \"gene_symbol\",\n",
    "        \"log2FoldChange\",\n",
    "        \"lfcSE\",\n",
    "        \"stat\",\n",
    "        \"pvalue\",\n",
    "        \"padj\",\n",
    "    ]\n",
    "\n",
    "    if \"gene_id\" in pd_.columns:\n",
    "        pd_cols.insert(\n",
    "            1,\n",
    "            \"gene_id\",\n",
    "        )\n",
    "\n",
    "\n",
    "    p = (\n",
    "        pd_[\n",
    "            pd_cols\n",
    "        ]\n",
    "        .rename(\n",
    "            columns={\n",
    "                \"gene_id\":\n",
    "                    \"gene_id_PD\",\n",
    "\n",
    "                \"log2FoldChange\":\n",
    "                    \"log2FoldChange_PD\",\n",
    "\n",
    "                \"lfcSE\":\n",
    "                    \"lfcSE_PD\",\n",
    "\n",
    "                \"stat\":\n",
    "                    \"stat_PD\",\n",
    "\n",
    "                \"pvalue\":\n",
    "                    \"pvalue_PD\",\n",
    "\n",
    "                \"padj\":\n",
    "                    \"padj_PD\",\n",
    "            }\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # One-to-one AD ↔ PD symbol match\n",
    "    # ========================================================\n",
    "\n",
    "    m = a.merge(\n",
    "        p,\n",
    "        on=\"gene_symbol\",\n",
    "        how=\"inner\",\n",
    "        validate=\"one_to_one\",\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(m) >= 3, (\n",
    "        f\"{ct}: only {len(m)} matched unique genes.\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # Genome-wide LFC concordance\n",
    "    # ========================================================\n",
    "\n",
    "    lfc = permutation_spearman(\n",
    "        m[\n",
    "            \"log2FoldChange_AD\"\n",
    "        ].to_numpy(),\n",
    "\n",
    "        m[\n",
    "            \"log2FoldChange_PD\"\n",
    "        ].to_numpy(),\n",
    "\n",
    "        n_permutations=10000,\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # Genome-wide Wald concordance\n",
    "    # ========================================================\n",
    "\n",
    "    wald = permutation_spearman(\n",
    "        m[\n",
    "            \"stat_AD\"\n",
    "        ].to_numpy(),\n",
    "\n",
    "        m[\n",
    "            \"stat_PD\"\n",
    "        ].to_numpy(),\n",
    "\n",
    "        n_permutations=10000,\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # Direction concordance\n",
    "    # ========================================================\n",
    "\n",
    "    finite_direction = (\n",
    "        np.isfinite(\n",
    "            m[\n",
    "                \"log2FoldChange_AD\"\n",
    "            ]\n",
    "        )\n",
    "        &\n",
    "        np.isfinite(\n",
    "            m[\n",
    "                \"log2FoldChange_PD\"\n",
    "            ]\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    m[\n",
    "        \"same_direction\"\n",
    "    ] = False\n",
    "\n",
    "\n",
    "    m.loc[\n",
    "        finite_direction,\n",
    "        \"same_direction\"\n",
    "    ] = (\n",
    "        np.sign(\n",
    "            m.loc[\n",
    "                finite_direction,\n",
    "                \"log2FoldChange_AD\",\n",
    "            ].to_numpy(\n",
    "                dtype=float\n",
    "            )\n",
    "        )\n",
    "        ==\n",
    "        np.sign(\n",
    "            m.loc[\n",
    "                finite_direction,\n",
    "                \"log2FoldChange_PD\",\n",
    "            ].to_numpy(\n",
    "                dtype=float\n",
    "            )\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    all_gene_direction_concordance = float(\n",
    "        m.loc[\n",
    "            finite_direction,\n",
    "            \"same_direction\",\n",
    "        ].mean()\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # Concordant-tail enrichment\n",
    "    # ========================================================\n",
    "\n",
    "    valid_tail = (\n",
    "        np.isfinite(\n",
    "            m[\n",
    "                \"stat_AD\"\n",
    "            ]\n",
    "        )\n",
    "        &\n",
    "        np.isfinite(\n",
    "            m[\n",
    "                \"stat_PD\"\n",
    "            ]\n",
    "        )\n",
    "        &\n",
    "        finite_direction\n",
    "    )\n",
    "\n",
    "\n",
    "    tail_base = m.loc[\n",
    "        valid_tail\n",
    "    ].copy()\n",
    "\n",
    "\n",
    "    assert len(tail_base) >= 10, (\n",
    "        f\"{ct}: insufficient finite genes for tail analysis.\"\n",
    "    )\n",
    "\n",
    "\n",
    "    tails = {}\n",
    "\n",
    "\n",
    "    for frac in [\n",
    "        0.01,\n",
    "        0.05,\n",
    "        0.10,\n",
    "    ]:\n",
    "\n",
    "        qa = float(\n",
    "            np.quantile(\n",
    "                np.abs(\n",
    "                    tail_base[\n",
    "                        \"stat_AD\"\n",
    "                    ].to_numpy(\n",
    "                        dtype=float\n",
    "                    )\n",
    "                ),\n",
    "                1 - frac,\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "        qp = float(\n",
    "            np.quantile(\n",
    "                np.abs(\n",
    "                    tail_base[\n",
    "                        \"stat_PD\"\n",
    "                    ].to_numpy(\n",
    "                        dtype=float\n",
    "                    )\n",
    "                ),\n",
    "                1 - frac,\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "        tail_mask = (\n",
    "            (\n",
    "                np.abs(\n",
    "                    tail_base[\n",
    "                        \"stat_AD\"\n",
    "                    ]\n",
    "                )\n",
    "                >=\n",
    "                qa\n",
    "            )\n",
    "            |\n",
    "            (\n",
    "                np.abs(\n",
    "                    tail_base[\n",
    "                        \"stat_PD\"\n",
    "                    ]\n",
    "                )\n",
    "                >=\n",
    "                qp\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "        t = tail_base.loc[\n",
    "            tail_mask\n",
    "        ]\n",
    "\n",
    "\n",
    "        n_tail = int(\n",
    "            len(t)\n",
    "        )\n",
    "\n",
    "        k_same = int(\n",
    "            t[\n",
    "                \"same_direction\"\n",
    "            ].sum()\n",
    "        )\n",
    "\n",
    "        label = int(\n",
    "            frac * 100\n",
    "        )\n",
    "\n",
    "\n",
    "        tails[\n",
    "            f\"tail_{label}pct_n\"\n",
    "        ] = n_tail\n",
    "\n",
    "\n",
    "        tails[\n",
    "            f\"tail_{label}pct_same_fraction\"\n",
    "        ] = (\n",
    "            float(\n",
    "                k_same\n",
    "                /\n",
    "                n_tail\n",
    "            )\n",
    "            if n_tail\n",
    "            else np.nan\n",
    "        )\n",
    "\n",
    "\n",
    "        tails[\n",
    "            f\"tail_{label}pct_binom_p\"\n",
    "        ] = (\n",
    "            float(\n",
    "                binomtest(\n",
    "                    k_same,\n",
    "                    n_tail,\n",
    "                    p=0.5,\n",
    "                    alternative=\"greater\",\n",
    "                ).pvalue\n",
    "            )\n",
    "            if n_tail\n",
    "            else np.nan\n",
    "        )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # Conservative conjunction test\n",
    "    #\n",
    "    # Both diseases must independently support the same\n",
    "    # direction.\n",
    "    # ========================================================\n",
    "\n",
    "    conjunction_p = np.ones(\n",
    "        len(m),\n",
    "        dtype=float,\n",
    "    )\n",
    "\n",
    "\n",
    "    valid_conjunction = (\n",
    "        m[\n",
    "            \"same_direction\"\n",
    "        ]\n",
    "        &\n",
    "        np.isfinite(\n",
    "            m[\n",
    "                \"stat_AD\"\n",
    "            ]\n",
    "        )\n",
    "        &\n",
    "        np.isfinite(\n",
    "            m[\n",
    "                \"stat_PD\"\n",
    "            ]\n",
    "        )\n",
    "        &\n",
    "        finite_direction\n",
    "    )\n",
    "\n",
    "\n",
    "    if valid_conjunction.any():\n",
    "\n",
    "        idx = np.flatnonzero(\n",
    "            valid_conjunction.to_numpy()\n",
    "        )\n",
    "\n",
    "\n",
    "        direction = np.sign(\n",
    "            m.loc[\n",
    "                valid_conjunction,\n",
    "                \"log2FoldChange_AD\",\n",
    "            ].to_numpy(\n",
    "                dtype=float\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "        z_ad = (\n",
    "            m.loc[\n",
    "                valid_conjunction,\n",
    "                \"stat_AD\",\n",
    "            ]\n",
    "            .to_numpy(\n",
    "                dtype=float\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "        z_pd = (\n",
    "            m.loc[\n",
    "                valid_conjunction,\n",
    "                \"stat_PD\",\n",
    "            ]\n",
    "            .to_numpy(\n",
    "                dtype=float\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "        p_ad = norm.sf(\n",
    "            direction * z_ad\n",
    "        )\n",
    "\n",
    "\n",
    "        p_pd = norm.sf(\n",
    "            direction * z_pd\n",
    "        )\n",
    "\n",
    "\n",
    "        conjunction_p[\n",
    "            idx\n",
    "        ] = np.maximum(\n",
    "            p_ad,\n",
    "            p_pd,\n",
    "        )\n",
    "\n",
    "\n",
    "    m[\n",
    "        \"conjunction_p\"\n",
    "    ] = conjunction_p\n",
    "\n",
    "\n",
    "    m[\n",
    "        \"conjunction_FDR\"\n",
    "    ] = bh(\n",
    "        conjunction_p\n",
    "    )\n",
    "\n",
    "\n",
    "    m.insert(\n",
    "        0,\n",
    "        \"cell_type\",\n",
    "        ct,\n",
    "    )\n",
    "\n",
    "\n",
    "    all_gene_tables.append(\n",
    "        m\n",
    "    )\n",
    "\n",
    "\n",
    "    summaries.append(\n",
    "        {\n",
    "            \"cell_type\":\n",
    "                ct,\n",
    "\n",
    "            \"matched_unique_genes\":\n",
    "                int(len(m)),\n",
    "\n",
    "            \"finite_LFC_pairs\":\n",
    "                lfc[\"n\"],\n",
    "\n",
    "            \"LFC_spearman\":\n",
    "                lfc[\"rho\"],\n",
    "\n",
    "            \"LFC_perm_p\":\n",
    "                lfc[\"pvalue\"],\n",
    "\n",
    "            \"finite_Wald_pairs\":\n",
    "                wald[\"n\"],\n",
    "\n",
    "            \"Wald_spearman\":\n",
    "                wald[\"rho\"],\n",
    "\n",
    "            \"Wald_perm_p\":\n",
    "                wald[\"pvalue\"],\n",
    "\n",
    "            \"all_gene_direction_concordance\":\n",
    "                all_gene_direction_concordance,\n",
    "\n",
    "            \"conjunction_FDR05_genes\":\n",
    "                int(\n",
    "                    (\n",
    "                        m[\n",
    "                            \"conjunction_FDR\"\n",
    "                        ]\n",
    "                        <\n",
    "                        0.05\n",
    "                    )\n",
    "                    .fillna(\n",
    "                        False\n",
    "                    )\n",
    "                    .sum()\n",
    "                ),\n",
    "\n",
    "            **tails,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"AD unique-symbol genes:\",\n",
    "        f\"{len(ad):,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"PD unique-symbol genes:\",\n",
    "        f\"{len(pd_):,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Matched unique genes:\",\n",
    "        f\"{len(m):,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",    "        \"LFC Spearman:\",\n",
    "        lfc[\"rho\"]\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"LFC permutation P:\",\n",
    "        lfc[\"pvalue\"]\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Wald Spearman:\",\n",
    "        wald[\"rho\"]\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Wald permutation P:\",\n",
    "        wald[\"pvalue\"]\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"All-gene direction concordance:\",\n",
    "        all_gene_direction_concordance\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Conjunction FDR<0.05 genes:\",\n",
    "        int(\n",
    "            (\n",
    "                m[\n",
    "                    \"conjunction_FDR\"\n",
    "                ]\n",
    "                <\n",
    "                0.05\n",
    "            )\n",
    "            .fillna(\n",
    "                False\n",
    "            )\n",
    "            .sum()\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 5. Combine classes\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "summary = pd.DataFrame(\n",
    "    summaries\n",
    ")\n",
    "\n",
    "\n",
    "conv = pd.concat(\n",
    "    all_gene_tables,\n",
    "    ignore_index=True,\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    summary[\n",
    "        \"cell_type\"\n",
    "    ].tolist()\n",
    "    ==\n",
    "    CLASSES\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 6. BH correction across four prespecified cell-class tests\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "summary[\n",
    "    \"LFC_perm_q_BH\"\n",
    "] = bh(\n",
    "    summary[\n",
    "        \"LFC_perm_p\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "summary[\n",
    "    \"Wald_perm_q_BH\"\n",
    "] = bh(\n",
    "    summary[\n",
    "        \"Wald_perm_p\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "summary[\n",
    "    \"vector_convergence_supported\"\n",
    "] = (\n",
    "    (\n",
    "        summary[\n",
    "            \"LFC_spearman\"\n",
    "        ]\n",
    "        >\n",
    "        0\n",
    "    )\n",
    "    &\n",
    "    (\n",
    "        summary[\n",
    "            \"Wald_spearman\"\n",
    "        ]\n",
    "        >\n",
    "        0\n",
    "    )\n",
    "    &\n",
    "    (\n",
    "        summary[\n",
    "            \"LFC_perm_q_BH\"\n",
    "        ]\n",
    "        <\n",
    "        0.05\n",
    "    )\n",
    "    &\n",
    "    (\n",
    "        summary[\n",
    "            \"Wald_perm_q_BH\"\n",
    "        ]\n",
    "        <\n",
    "        0.05\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 7. Save exact filenames expected by later cells\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "CONVERGENCE_PATH = (\n",
    "    OUT /\n",
    "    \"AD_PD_ALL_GENE_CONVERGENCE_v2.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "SUMMARY_PATH = (\n",
    "    OUT /\n",
    "    \"AD_PD_CONVERGENCE_SUMMARY_v2.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "conv.to_csv(\n",
    "    CONVERGENCE_PATH,\n",
    "    index=False,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "summary.to_csv(\n",
    "    SUMMARY_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    CONVERGENCE_PATH.exists()\n",
    "    and\n",
    "    CONVERGENCE_PATH.stat().st_size > 0\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    SUMMARY_PATH.exists()\n",
    "    and\n",
    "    SUMMARY_PATH.stat().st_size > 0\n",
    ")\n",
    "\n",
    "\n",
    "# Later notebook cells explicitly require these names.\n",
    "REQUIRED_DOWNSTREAM = {\n",
    "\n",
    "    \"cell_type\",\n",
    "    \"gene_symbol\",\n",
    "\n",
    "    \"log2FoldChange_AD\",\n",
    "    \"lfcSE_AD\",\n",
    "    \"stat_AD\",\n",
    "    \"pvalue_AD\",\n",
    "    \"padj_AD\",\n",
    "\n",
    "    \"log2FoldChange_PD\",\n",
    "    \"lfcSE_PD\",\n",
    "    \"stat_PD\",\n",
    "    \"pvalue_PD\",\n",
    "    \"padj_PD\",\n",
    "\n",
    "    \"same_direction\",\n",
    "    \"conjunction_p\",\n",
    "    \"conjunction_FDR\",\n",
    "}\n",
    "\n",
    "\n",
    "missing_downstream = (\n",
    "    REQUIRED_DOWNSTREAM\n",
    "    -\n",
    "    set(\n",
    "        conv.columns\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert not missing_downstream, (\n",
    "    \"Cross-disease output lacks columns required downstream: \"\n",
    "    f\"{sorted(missing_downstream)}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 8. Freeze convergence results\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "LOCK_PATH = (\n",
    "    LOCKS /\n",
    "    \"AD_PD_GENE_EFFECT_CONVERGENCE_FREEZE_v2.json\"\n",
    ")\n",
    "\n",
    "\n",
    "lock = {\n",
    "\n",
    "    \"status\":\n",
    "        \"AD_PD_GENE_EFFECT_CONVERGENCE_FROZEN\",\n",
    "\n",
    "    \"AD_discovery\":\n",
    "        \"GSE174367\",\n",
    "\n",
    "    \"PD_discovery\":\n",
    "        \"GSE243639\",\n",
    "\n",
    "    \"AD_effect_file\":\n",
    "        str(\n",
    "            AD_PATH\n",
    "        ),\n",
    "\n",
    "    \"PD_effect_file\":\n",
    "        str(\n",
    "            PD_PATH\n",
    "        ),\n",
    "\n",
    "    \"all_gene_convergence_file\":\n",
    "        str(\n",
    "            CONVERGENCE_PATH\n",
    "        ),\n",
    "\n",
    "    \"summary_file\":\n",
    "        str(\n",
    "            SUMMARY_PATH\n",
    "        ),\n",
    "\n",
    "    \"comparison_level\":\n",
    "        \"unique normalized gene symbol\",\n",
    "\n",
    "    \"schema_harmonization\": {\n",
    "\n",
    "        \"AD\":\n",
    "            \"AD_vs_Control_* -> canonical DE columns\",\n",
    "\n",
    "        \"PD\":\n",
    "            \"PD_vs_Control_* -> canonical DE columns\",\n",
    "    },\n",
    "\n",
    "    \"primary_metrics\": [\n",
    "        \"LFC_rank_correlation\",\n",
    "        \"Wald_rank_correlation\",\n",
    "        \"concordant_tail_enrichment\",\n",
    "    ],\n",
    "\n",
    "    \"permutation_seed\":\n",
    "        20260914,\n",
    "\n",
    "    \"permutations_per_vector_test\":\n",
    "        10000,\n",
    "\n",
    "    \"permutation_alternative\":\n",
    "        \"positive concordance\",\n",
    "\n",
    "    \"conjunction_gene_test\":\n",
    "        \"secondary_conservative_max_one_sided_p\",\n",
    "\n",
    "    \"FDR_list_intersection_used\":\n",
    "        False,\n",
    "\n",
    "    \"pathway_convergence_pending\":\n",
    "        True,\n",
    "\n",
    "    \"retina_mapping_performed\":\n",
    "        False,\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    LOCK_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        lock,\n",
    "        f,\n",
    "        indent=2,\n",
    "    )\n",
    "\n",
    "\n",
    "assert LOCK_PATH.exists()\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 9. Final report\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "print(\"\\n\" + \"=\" * 90)\n",
    "\n",
    "print(\n",
    "    \"AD↔PD GENE-EFFECT CONVERGENCE FROZEN\"\n",
    ")\n",
    "\n",
    "print(\"=\" * 90)\n",
    "\n",
    "\n",
    "display(\n",
    "    summary\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nAll-gene convergence table:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    CONVERGENCE_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nConvergence summary:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    SUMMARY_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nConvergence lock:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    LOCK_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nNEXT: pathway convergence module.\"\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 64\n",
    "# ============================================================\n",
    "# V2 PATHWAY CONVERGENCE — REACTOME V97\n",
    "# COMPLETE REPLACEMENT\n",
    "#\n",
    "# Uses a locally frozen copy of the Reactome V97 human\n",
    "# pathway GMT so future reruns cannot silently change\n",
    "# pathway definitions.\n",
    "# ============================================================\n",
    "\n",
    "from pathlib import Path\n",
    "import requests\n",
    "import zipfile\n",
    "import hashlib\n",
    "import json\n",
    "import subprocess\n",
    "import sys\n",
    "import importlib.util\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = ROOT / \"locks\"\n",
    "\n",
    "RESOURCES = (\n",
    "    ROOT /\n",
    "    \"resources\" /\n",
    "    \"pathways\"\n",
    ")\n",
    "\n",
    "OUT = (\n",
    "    ROOT /\n",
    "    \"results\" /\n",
    "    \"cross_disease_convergence\"\n",
    ")\n",
    "\n",
    "\n",
    "RESOURCES.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "OUT.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "\n",
    "CONV_PATH = (\n",
    "    OUT /\n",
    "    \"AD_PD_ALL_GENE_CONVERGENCE_v2.csv.gz\"\n",
    ")\n",
    "\n",
    "assert CONV_PATH.exists(), (\n",
    "    f\"Missing cross-disease convergence file:\\n{CONV_PATH}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. FROZEN REACTOME RESOURCE\n",
    "# ============================================================\n",
    "\n",
    "REACTOME_VERSION = 97\n",
    "ZIP_PATH = RESOURCES / \"ReactomePathways_V97.gmt.zip\"\n",
    "GMT_PATH = RESOURCES / \"ReactomePathways_V97.gmt\"\n",
    "\n",
    "if not GMT_PATH.exists():\n",
    "    raise FileNotFoundError(\n",
    "        \"The frozen Reactome V97 GMT file is required for an exact rerun.\\n\"\n",
    "        \"Place ReactomePathways_V97.gmt at:\\n\"\n",
    "        f\"{GMT_PATH}\\n\\n\"\n",
    "        \"Do not replace it with Reactome's current release because that \"\n",
    "        \"would change the pathway universe.\"\n",
    "    )\n",
    "\n",
    "# ============================================================\n",
    "# 3. HASH / FREEZE RESOURCE\n",
    "# ============================================================\n",
    "\n",
    "def sha256_file(\n",
    "    path\n",
    "):\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\"\n",
    "    ) as f:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            block = f.read(\n",
    "                1024 * 1024\n",
    "            )\n",
    "\n",
    "            if not block:\n",
    "                break\n",
    "\n",
    "            h.update(\n",
    "                block\n",
    "            )\n",
    "\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "GMT_SHA256 = sha256_file(\n",
    "    GMT_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPinned GMT:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    GMT_PATH\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"SHA256:\",\n",
    "    GMT_SHA256\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. INSTALL GSEAPY IF NEEDED\n",
    "# ============================================================\n",
    "\n",
    "if importlib.util.find_spec(\n",
    "    \"gseapy\"\n",
    ") is None:\n",
    "\n",
    "    subprocess.check_call(\n",
    "        [\n",
    "            sys.executable,\n",
    "            \"-m\",\n",
    "            \"pip\",\n",
    "            \"install\",\n",
    "            \"-q\",\n",
    "            \"gseapy\",\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "import gseapy as gp\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. LOAD FROZEN AD↔PD GENE EFFECTS\n",
    "# ============================================================\n",
    "\n",
    "conv = pd.read_csv(\n",
    "    CONV_PATH,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "required = {\n",
    "\n",
    "    \"cell_type\",\n",
    "    \"gene_symbol\",\n",
    "    \"stat_AD\",\n",
    "    \"stat_PD\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "missing = (\n",
    "    required\n",
    "    -\n",
    "    set(\n",
    "        conv.columns\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert not missing, (\n",
    "    f\"Missing convergence columns: {sorted(missing)}\"\n",
    ")\n",
    "\n",
    "\n",
    "CLASSES = [\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "]\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. PRERANK EACH DISEASE / CELL CLASS\n",
    "# ============================================================\n",
    "\n",
    "all_results = []\n",
    "\n",
    "\n",
    "for ct in CLASSES:\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\n\"\n",
    "        +\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        ct\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "\n",
    "    m = conv.loc[\n",
    "        conv[\n",
    "            \"cell_type\"\n",
    "        ]\n",
    "        ==\n",
    "        ct\n",
    "    ].copy()\n",
    "\n",
    "\n",
    "    for disease, column in [\n",
    "\n",
    "        (\n",
    "            \"AD\",\n",
    "            \"stat_AD\",\n",
    "        ),\n",
    "\n",
    "        (\n",
    "            \"PD\",\n",
    "            \"stat_PD\",\n",
    "        ),\n",
    "\n",
    "    ]:\n",
    "\n",
    "\n",
    "        rank = (\n",
    "            m[\n",
    "                [\n",
    "                    \"gene_symbol\",\n",
    "                    column,\n",
    "                ]\n",
    "            ]\n",
    "            .dropna()\n",
    "            .copy()\n",
    "        )\n",
    "\n",
    "\n",
    "        rank[\n",
    "            \"gene_symbol\"\n",
    "        ] = (\n",
    "            rank[\n",
    "                \"gene_symbol\"\n",
    "            ]\n",
    "            .astype(str)\n",
    "            .str.upper()\n",
    "            .str.strip()\n",
    "        )\n",
    "\n",
    "\n",
    "        rank = (\n",
    "            rank\n",
    "            .groupby(\n",
    "                \"gene_symbol\",\n",
    "                as_index=False,\n",
    "            )[column]\n",
    "            .mean()\n",
    "        )\n",
    "\n",
    "\n",
    "        rank = rank.sort_values(\n",
    "            column,\n",
    "            ascending=False,\n",
    "        )\n",
    "\n",
    "\n",
    "        assert len(\n",
    "            rank\n",
    "        ) > 1000\n",
    "\n",
    "\n",
    "        print(\n",
    "            disease,\n",
    "            \"ranked genes:\",\n",
    "            len(\n",
    "                rank\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "        pre = gp.prerank(\n",
    "\n",
    "            rnk=rank,\n",
    "\n",
    "            gene_sets=str(\n",
    "                GMT_PATH\n",
    "            ),\n",
    "\n",
    "            permutation_num=1000,\n",
    "\n",
    "            seed=20260914,\n",
    "\n",
    "            min_size=10,\n",
    "\n",
    "            max_size=500,\n",
    "\n",
    "            outdir=None,\n",
    "\n",
    "            verbose=False,\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        z = (\n",
    "            pre\n",
    "            .res2d\n",
    "            .reset_index()\n",
    "            .copy()\n",
    "        )\n",
    "\n",
    "\n",
    "        z[\n",
    "            \"cell_type\"\n",
    "        ] = ct\n",
    "\n",
    "\n",
    "        z[\n",
    "            \"disease\"\n",
    "        ] = disease\n",
    "\n",
    "\n",
    "        all_results.append(\n",
    "            z\n",
    "        )\n",
    "\n",
    "\n",
    "pathways = pd.concat(\n",
    "    all_results,\n",
    "    ignore_index=True,\n",
    ")\n",
    "\n",
    "\n",
    "RAW_PATH = (\n",
    "    OUT /\n",
    "    \"AD_PD_REACTOME_V97_PRERANK_ALL_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "pathways.to_csv(\n",
    "    RAW_PATH,\n",
    "    index=False,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. NORMALIZE GSEAPY OUTPUT COLUMN NAMES\n",
    "# ============================================================\n",
    "\n",
    "term_col = (\n",
    "    \"Term\"\n",
    "    if \"Term\" in pathways.columns\n",
    "    else\n",
    "    pathways.columns[0]\n",
    ")\n",
    "\n",
    "\n",
    "nes_col = next(\n",
    "    c\n",
    "    for c\n",
    "    in pathways.columns\n",
    "    if c.lower()\n",
    "    ==\n",
    "    \"nes\"\n",
    ")\n",
    "\n",
    "\n",
    "fdr_col = next(\n",
    "    c\n",
    "    for c\n",
    "    in pathways.columns\n",
    "    if c.lower()\n",
    "    in {\n",
    "        \"fdr q-val\",\n",
    "        \"fdr\",\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. AD ↔ PD PATHWAY CONVERGENCE\n",
    "# ============================================================\n",
    "\n",
    "comparison_rows = []\n",
    "\n",
    "\n",
    "for ct in CLASSES:\n",
    "\n",
    "\n",
    "    a = (\n",
    "        pathways.loc[\n",
    "            (\n",
    "                pathways[\n",
    "                    \"cell_type\"\n",
    "                ]\n",
    "                ==\n",
    "                ct\n",
    "            )\n",
    "            &\n",
    "            (\n",
    "                pathways[\n",
    "                    \"disease\"\n",
    "                ]\n",
    "                ==\n",
    "                \"AD\"\n",
    "            )\n",
    "        ]\n",
    "        [\n",
    "            [\n",
    "                term_col,\n",
    "                nes_col,\n",
    "                fdr_col,\n",
    "            ]\n",
    "        ]\n",
    "        .rename(\n",
    "            columns={\n",
    "                term_col:\n",
    "                    \"pathway\",\n",
    "\n",
    "                nes_col:\n",
    "                    \"NES_AD\",\n",
    "\n",
    "                fdr_col:\n",
    "                    \"FDR_AD\",\n",
    "            }\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    p = (\n",
    "        pathways.loc[\n",
    "            (\n",
    "                pathways[\n",
    "                    \"cell_type\"\n",
    "                ]\n",
    "                ==\n",
    "                ct\n",
    "            )\n",
    "            &\n",
    "            (\n",
    "                pathways[\n",
    "                    \"disease\"\n",
    "                ]\n",
    "                ==\n",
    "                \"PD\"\n",
    "            )\n",
    "        ]\n",
    "        [\n",
    "            [\n",
    "                term_col,\n",
    "                nes_col,\n",
    "                fdr_col,\n",
    "            ]\n",
    "        ]\n",
    "        .rename(\n",
    "            columns={\n",
    "                term_col:\n",
    "                    \"pathway\",\n",
    "\n",
    "                nes_col:\n",
    "                    \"NES_PD\",\n",
    "\n",
    "                fdr_col:\n",
    "                    \"FDR_PD\",\n",
    "            }\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    x = a.merge(\n",
    "        p,\n",
    "        on=\"pathway\",\n",
    "        how=\"inner\",\n",
    "        validate=\"one_to_one\",\n",
    "    )\n",
    "\n",
    "\n",
    "    x.insert(\n",
    "        0,\n",
    "        \"cell_type\",\n",
    "        ct,\n",
    "    )\n",
    "\n",
    "\n",
    "    for col in [\n",
    "        \"NES_AD\",\n",
    "        \"NES_PD\",\n",
    "        \"FDR_AD\",\n",
    "        \"FDR_PD\",\n",
    "    ]:\n",
    "\n",
    "        x[\n",
    "            col\n",
    "        ] = pd.to_numeric(\n",
    "            x[\n",
    "                col\n",
    "            ],\n",
    "            errors=\"coerce\",\n",
    "        )\n",
    "\n",
    "\n",
    "    x[\n",
    "        \"same_direction\"\n",
    "    ] = (\n",
    "\n",
    "        np.sign(\n",
    "            x[\n",
    "                \"NES_AD\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        ==\n",
    "\n",
    "        np.sign(\n",
    "            x[\n",
    "                \"NES_PD\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    x[\n",
    "        \"both_FDR05\"\n",
    "    ] = (\n",
    "\n",
    "        (\n",
    "            x[\n",
    "                \"FDR_AD\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            x[\n",
    "                \"FDR_PD\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    x[\n",
    "        \"convergent_pathway\"\n",
    "    ] = (\n",
    "\n",
    "        x[\n",
    "            \"same_direction\"\n",
    "        ]\n",
    "\n",
    "        &\n",
    "\n",
    "        x[\n",
    "            \"both_FDR05\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    x[\n",
    "        \"conservative_abs_NES\"\n",
    "    ] = np.minimum(\n",
    "\n",
    "        np.abs(\n",
    "            x[\n",
    "                \"NES_AD\"\n",
    "            ]\n",
    "        ),\n",
    "\n",
    "        np.abs(\n",
    "            x[\n",
    "                \"NES_PD\"\n",
    "            ]\n",
    "        ),\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    comparison_rows.append(\n",
    "        x\n",
    "    )\n",
    "\n",
    "\n",
    "pathway_conv = pd.concat(\n",
    "    comparison_rows,\n",
    "    ignore_index=True,\n",
    ")\n",
    "\n",
    "\n",
    "PATHWAY_CONV_PATH = (\n",
    "    OUT /\n",
    "    \"AD_PD_REACTOME_V97_PATHWAY_CONVERGENCE_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "pathway_conv.to_csv(\n",
    "    PATHWAY_CONV_PATH,\n",
    "    index=False,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. SUMMARY\n",
    "# ============================================================\n",
    "\n",
    "summary = (\n",
    "\n",
    "    pathway_conv\n",
    "    .groupby(\n",
    "        \"cell_type\",\n",
    "        as_index=False,\n",
    "    )\n",
    "    .agg(\n",    "\n",
    "        matched_pathways=(\n",
    "            \"pathway\",\n",
    "            \"size\",\n",
    "        ),\n",
    "\n",
    "        concordant_pathways=(\n",
    "            \"same_direction\",\n",
    "            \"sum\",\n",
    "        ),\n",
    "\n",
    "        convergent_FDR05_pathways=(\n",
    "            \"convergent_pathway\",\n",
    "            \"sum\",\n",
    "        ),\n",
    "\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "SUMMARY_PATH = (\n",
    "    OUT /\n",
    "    \"AD_PD_REACTOME_V97_PATHWAY_SUMMARY_v1.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "summary.to_csv(\n",
    "    SUMMARY_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. FREEZE\n",
    "# ============================================================\n",
    "\n",
    "LOCK_PATH = (\n",
    "    LOCKS /\n",
    "    \"AD_PD_REACTOME_V97_PATHWAY_CONVERGENCE_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "record = {\n",
    "\n",
    "    \"status\":\n",
    "        \"AD_PD_REACTOME_V97_PATHWAY_CONVERGENCE_FROZEN\",\n",
    "\n",
    "    \"reactome_release\":\n",
    "        97,\n",
    "\n",
    "    \"GMT_file\":\n",
    "        str(\n",
    "            GMT_PATH\n",
    "        ),\n",
    "\n",
    "    \"GMT_SHA256\":\n",
    "        GMT_SHA256,\n",
    "\n",
    "    \"permutation_num\":\n",
    "        1000,\n",
    "\n",
    "    \"seed\":\n",
    "        20260914,\n",
    "\n",
    "    \"raw_prerank_results\":\n",
    "        str(\n",
    "            RAW_PATH\n",
    "        ),\n",
    "\n",
    "    \"pathway_convergence\":\n",
    "        str(\n",
    "            PATHWAY_CONV_PATH\n",
    "        ),\n",
    "\n",
    "    \"summary\":\n",
    "        str(\n",
    "            SUMMARY_PATH\n",
    "        ),\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    LOCK_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        record,\n",
    "        f,\n",
    "        indent=2,\n",
    "    )\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PATHWAY CONVERGENCE COMPLETE — REACTOME V97\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    summary\n",
    ")\n",
    "\n",
    "\n",
    "top = (\n",
    "\n",
    "    pathway_conv.loc[\n",
    "        pathway_conv[\n",
    "            \"convergent_pathway\"\n",
    "        ]\n",
    "    ]\n",
    "    .sort_values(\n",
    "        [\n",
    "            \"cell_type\",\n",
    "            \"conservative_abs_NES\",\n",
    "        ],\n",
    "        ascending=[\n",
    "            True,\n",
    "            False,\n",
    "        ],\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nTop convergent pathways:\"\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    top.head(\n",
    "        50\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nNEXT: retinal-expression gate.\"\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Part VI — Retinal and ocular support\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 66\n",
    "# ============================================================\n",
    "# V2 RETINAL EXPRESSION GATE — GSE148077\n",
    "# COMPLETE REPLACEMENT\n",
    "#\n",
    "# Purpose:\n",
    "#   Verify whether AD↔PD brain-convergent genes are actually\n",
    "#   expressed in independent healthy adult human retina.\n",
    "#\n",
    "# Important:\n",
    "#   GSE148077 is used here as an EXPRESSION gate.\n",
    "#   It is NOT yet used to claim exact retinal cell-type\n",
    "#   localization because the GEO donor count matrices do not\n",
    "#   themselves contain the full atlas annotation.\n",
    "# ============================================================\n",
    "\n",
    "from pathlib import Path\n",
    "import requests\n",
    "import hashlib\n",
    "import json\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = ROOT / \"locks\"\n",
    "\n",
    "REF = (\n",
    "    ROOT /\n",
    "    \"retina_reference\" /\n",
    "    \"GSE148077\"\n",
    ")\n",
    "\n",
    "REF.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "\n",
    "CONV_PATH = (\n",
    "    ROOT /\n",
    "    \"results\" /\n",
    "    \"cross_disease_convergence\" /\n",
    "    \"AD_PD_ALL_GENE_CONVERGENCE_v2.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "assert CONV_PATH.exists()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. TARGET GENES\n",
    "# ============================================================\n",
    "\n",
    "conv = pd.read_csv(\n",
    "    CONV_PATH,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "target_genes = sorted(\n",
    "    set(\n",
    "        conv[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .dropna()\n",
    "        .astype(str)\n",
    "        .str.upper()\n",
    "        .str.strip()\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "target_set = set(\n",
    "    target_genes\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Brain-convergence genes:\",\n",
    "    len(\n",
    "        target_genes\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. OFFICIAL GEO PROCESSED MATRICES\n",
    "# ============================================================\n",
    "\n",
    "BASE = (\n",
    "    \"https://ftp.ncbi.nlm.nih.gov/geo/\"\n",
    "    \"series/GSE148nnn/GSE148077/suppl/\"\n",
    ")\n",
    "\n",
    "\n",
    "FILES = [\n",
    "\n",
    "    \"GSE148077_count_mat_donor_H1.csv.gz\",\n",
    "\n",
    "    \"GSE148077_count_mat_donor_H11.csv.gz\",\n",
    "\n",
    "    \"GSE148077_count_mat_donor_H2.csv.gz\",\n",
    "\n",
    "    \"GSE148077_count_mat_donor_H3.csv.gz\",\n",
    "\n",
    "    \"GSE148077_count_mat_donor_H4.csv.gz\",\n",
    "\n",
    "    \"GSE148077_count_mat_donor_H5.csv.gz\",\n",
    "\n",
    "    \"GSE148077_count_mat_donor_H9.csv.gz\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "def download(\n",
    "    url,\n",
    "    destination,\n",
    "):\n",
    "\n",
    "    if (\n",
    "        destination.exists()\n",
    "        and\n",
    "        destination.stat().st_size > 1000\n",
    "    ):\n",
    "\n",
    "        print(\n",
    "            \"Existing:\",\n",
    "            destination.name\n",
    "        )\n",
    "\n",
    "        return\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Downloading:\",\n",
    "        destination.name\n",
    "    )\n",
    "\n",
    "\n",
    "    temp = destination.with_suffix(\n",
    "        destination.suffix + \".part\"\n",
    "    )\n",
    "\n",
    "\n",
    "    with requests.get(\n",
    "        url,\n",
    "        stream=True,\n",
    "        timeout=180,\n",
    "    ) as r:\n",
    "\n",
    "        r.raise_for_status()\n",
    "\n",
    "\n",
    "        with open(\n",
    "            temp,\n",
    "            \"wb\"\n",
    "        ) as f:\n",
    "\n",
    "            for block in r.iter_content(\n",
    "                chunk_size=8 * 1024 * 1024\n",
    "            ):\n",
    "\n",
    "                if block:\n",
    "\n",
    "                    f.write(\n",
    "                        block\n",
    "                    )\n",
    "\n",
    "\n",
    "    temp.replace(\n",
    "        destination\n",
    "    )\n",
    "\n",
    "\n",
    "    assert destination.stat().st_size > 1000\n",
    "\n",
    "\n",
    "for filename in FILES:\n",
    "\n",
    "    download(\n",
    "        BASE + filename,\n",
    "        REF / filename,\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. STREAM MATRICES — TARGET GENES ONLY\n",
    "# ============================================================\n",
    "\n",
    "rows = []\n",
    "\n",
    "\n",
    "for filename in FILES:\n",
    "\n",
    "\n",
    "    path = REF / filename\n",
    "\n",
    "\n",
    "    donor = (\n",
    "        filename\n",
    "        .replace(\n",
    "            \"GSE148077_count_mat_donor_\",\n",
    "            \"\"\n",
    "        )\n",
    "        .replace(\n",
    "            \".csv.gz\",\n",
    "            \"\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nScanning:\",\n",
    "        donor\n",
    "    )\n",
    "\n",
    "\n",
    "    donor_hits = []\n",
    "\n",
    "\n",
    "    for chunk in pd.read_csv(\n",
    "        path,\n",
    "        compression=\"gzip\",\n",
    "        chunksize=1000,\n",
    "        low_memory=False,\n",
    "    ):\n",
    "\n",
    "\n",
    "        gene_col = chunk.columns[\n",
    "            0\n",
    "        ]\n",
    "\n",
    "\n",
    "        gene = (\n",
    "            chunk[\n",
    "                gene_col\n",
    "            ]\n",
    "            .astype(str)\n",
    "            .str.upper()\n",
    "            .str.strip()\n",
    "        )\n",
    "\n",
    "\n",
    "        mask = gene.isin(\n",
    "            target_set\n",
    "        )\n",
    "\n",
    "\n",
    "        if not mask.any():\n",
    "\n",
    "            continue\n",
    "\n",
    "\n",
    "        z = chunk.loc[\n",
    "            mask\n",
    "        ].copy()\n",
    "\n",
    "\n",
    "        z[\n",
    "            \"_gene\"\n",
    "        ] = gene.loc[\n",
    "            mask\n",
    "        ].to_numpy()\n",
    "\n",
    "\n",
    "        value_cols = [\n",
    "\n",
    "            c\n",
    "\n",
    "            for c\n",
    "            in z.columns\n",
    "\n",
    "            if c\n",
    "            not in {\n",
    "                gene_col,\n",
    "                \"_gene\",\n",
    "            }\n",
    "\n",
    "        ]\n",
    "\n",
    "\n",
    "        values = (\n",
    "            z[\n",
    "                value_cols\n",
    "            ]\n",
    "            .apply(\n",
    "                pd.to_numeric,\n",
    "                errors=\"coerce\",\n",
    "            )\n",
    "            .fillna(\n",
    "                0\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "        for i, g in enumerate(\n",
    "            z[\n",
    "                \"_gene\"\n",
    "            ]\n",
    "        ):\n",
    "\n",
    "\n",
    "            arr = values.iloc[\n",
    "                i\n",
    "            ].to_numpy(\n",
    "                dtype=float\n",
    "            )\n",
    "\n",
    "\n",
    "            donor_hits.append(\n",
    "                {\n",
    "\n",
    "                    \"gene_symbol\":\n",
    "                        g,\n",
    "\n",
    "                    \"donor\":\n",
    "                        donor,\n",
    "\n",
    "                    \"retinal_cells\":\n",
    "                        int(\n",
    "                            len(\n",
    "                                arr\n",
    "                            )\n",
    "                        ),\n",
    "\n",
    "                    \"positive_cells\":\n",
    "                        int(\n",
    "                            (\n",
    "                                arr\n",
    "                                >\n",
    "                                0\n",
    "                            ).sum()\n",
    "                        ),\n",
    "\n",
    "                    \"total_counts\":\n",
    "                        float(\n",
    "                            arr.sum()\n",
    "                        ),\n",
    "\n",
    "                }\n",
    "            )\n",
    "\n",
    "\n",
    "    donor_df = pd.DataFrame(\n",
    "        donor_hits\n",
    "    )\n",
    "\n",
    "\n",
    "    if len(\n",
    "        donor_df\n",
    "    ) > 0:\n",
    "\n",
    "\n",
    "        donor_df = (\n",
    "\n",
    "            donor_df\n",
    "            .groupby(\n",
    "                [\n",
    "                    \"gene_symbol\",\n",
    "                    \"donor\",\n",
    "                ],\n",
    "                as_index=False,\n",
    "            )\n",
    "            .agg(\n",
    "\n",
    "                retinal_cells=(\n",
    "                    \"retinal_cells\",\n",
    "                    \"max\",\n",
    "                ),\n",
    "\n",
    "                positive_cells=(\n",
    "                    \"positive_cells\",\n",
    "                    \"sum\",\n",
    "                ),\n",
    "\n",
    "                total_counts=(\n",
    "                    \"total_counts\",\n",
    "                    \"sum\",\n",
    "                ),\n",
    "\n",
    "            )\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        rows.append(\n",
    "            donor_df\n",
    "        )\n",
    "\n",
    "\n",
    "retina = pd.concat(\n",
    "    rows,\n",
    "    ignore_index=True,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. BUILD COMPLETE GENE × DONOR GRID\n",
    "# ============================================================\n",
    "\n",
    "donors = [\n",
    "\n",
    "    f\n",
    "    .replace(\n",
    "        \"GSE148077_count_mat_donor_\",\n",
    "        \"\"\n",
    "    )\n",
    "    .replace(\n",
    "        \".csv.gz\",\n",
    "        \"\"\n",
    "    )\n",
    "\n",
    "    for f\n",
    "    in FILES\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "grid = pd.MultiIndex.from_product(\n",
    "    [\n",
    "        target_genes,\n",
    "        donors,\n",
    "    ],\n",
    "    names=[\n",
    "        \"gene_symbol\",\n",
    "        \"donor\",\n",
    "    ],\n",
    ").to_frame(\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "retina = grid.merge(\n",
    "\n",
    "    retina,\n",
    "\n",
    "    on=[\n",
    "        \"gene_symbol\",\n",
    "        \"donor\",\n",
    "    ],\n",
    "\n",
    "    how=\"left\",\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "for c in [\n",
    "    \"positive_cells\",\n",
    "    \"total_counts\",\n",
    "]:\n",
    "\n",
    "    retina[\n",
    "        c\n",
    "    ] = (\n",
    "        retina[\n",
    "            c\n",
    "        ]\n",
    "        .fillna(\n",
    "            0\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "retina[\n",
    "    \"detected\"\n",
    "] = (\n",
    "    retina[\n",
    "        \"positive_cells\"\n",
    "    ]\n",
    "    >\n",
    "    0\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. GENE-LEVEL RETINAL EXPRESSION SUPPORT\n",
    "# ============================================================\n",
    "\n",
    "summary = (\n",
    "\n",
    "    retina\n",
    "    .groupby(\n",
    "        \"gene_symbol\",\n",
    "        as_index=False,\n",
    "    )\n",
    "    .agg(\n",
    "\n",
    "        retinal_donors_detected=(\n",
    "            \"detected\",\n",
    "            \"sum\",\n",
    "        ),\n",
    "\n",
    "        retinal_positive_cells=(\n",
    "            \"positive_cells\",\n",
    "            \"sum\",\n",
    "        ),\n",
    "\n",
    "        retinal_total_counts=(\n",
    "            \"total_counts\",\n",
    "            \"sum\",\n",
    "        ),\n",
    "\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "summary[\n",
    "    \"retina_expression\"\n",
    "] = (\n",
    "\n",
    "    summary[\n",
    "        \"retinal_donors_detected\"\n",
    "    ]\n",
    "    >=\n",
    "    2\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. SAVE\n",
    "# ============================================================\n",
    "\n",
    "DONOR_PATH = (\n",
    "    REF /\n",
    "    \"GSE148077_BRAIN_CONVERGENCE_RETINAL_EXPRESSION_BY_DONOR_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "SUMMARY_PATH = (\n",
    "    REF /\n",
    "    \"GSE148077_BRAIN_CONVERGENCE_RETINAL_EXPRESSION_SUMMARY_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "retina.to_csv(\n",
    "    DONOR_PATH,\n",
    "    index=False,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "summary.to_csv(\n",
    "    SUMMARY_PATH,\n",
    "    index=False,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "LOCK_PATH = (\n",
    "    LOCKS /\n",
    "    \"GSE148077_RETINAL_EXPRESSION_GATE_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "with open(\n",
    "    LOCK_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "\n",
    "        {\n",
    "\n",
    "            \"status\":\n",
    "                \"GSE148077_RETINAL_EXPRESSION_GATE_FROZEN\",\n",
    "\n",
    "            \"dataset\":\n",
    "                \"GSE148077\",\n",
    "\n",
    "            \"healthy_donors\":\n",
    "                7,\n",
    "\n",
    "            \"expression_rule\":\n",
    "                \"detected in >=2 independent donors\",\n",
    "\n",
    "            \"cell_type_localization_claimed\":\n",
    "                False,\n",
    "\n",
    "            \"donor_table\":\n",
    "                str(\n",
    "                    DONOR_PATH\n",
    "                ),\n",
    "\n",
    "            \"summary\":\n",
    "                str(\n",
    "                    SUMMARY_PATH\n",
    "                ),\n",
    "\n",
    "        },\n",
    "\n",
    "        f,\n",
    "        indent=2,\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"GSE148077 RETINAL EXPRESSION GATE COMPLETE\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Genes detected in >=2 retinal donors:\",\n",
    "    int(\n",
    "        summary[\n",
    "            \"retina_expression\"\n",
    "        ].sum()\n",
    "    ),\n",
    "    \"/\",\n",
    "    len(\n",
    "        summary\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    summary.sort_values(\n",
    "        [\n",
    "            \"retinal_donors_detected\",\n",
    "            \"retinal_positive_cells\",\n",
    "        ],\n",
    "        ascending=False,\n",
    "    ).head(\n",
    "        50\n",
    "    )\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 67\n",
    "# ============================================================\n",
    "# AD RETINA SUPPORT — PXD073336 PROCESSED WORKBOOK\n",
    "# ============================================================\n",
    "import requests\n",
    "\n",
    "def stream(url, destination):\n",
    "    destination = Path(destination)\n",
    "    if destination.exists() and destination.stat().st_size > 0:\n",
    "        return destination\n",
    "    with requests.get(url, stream=True, timeout=180) as r:\n",
    "        r.raise_for_status()\n",
    "        with open(destination, \"wb\") as f:\n",
    "            for chunk in r.iter_content(chunk_size=1024 * 1024):\n",
    "                if chunk:\n",
    "                    f.write(chunk)\n",
    "    return destination\n",
    "\n",
    "od=ROOT/'ocular_validation'/'PXD073336'; od.mkdir(parents=True,exist_ok=True)\n",
    "url='https://ftp.pride.ebi.ac.uk/pride/data/archive/2026/07/PXD073336/Retinaxhippocampus_Proteomics.xlsx'\n",
    "p=od/'Retinaxhippocampus_Proteomics.xlsx'\n",
    "try:\n",
    "    stream(url,p)\n",
    "    xls=pd.ExcelFile(p); print('PXD073336 downloaded:',p); print('Sheets:',xls.sheet_names)\n",
    "except Exception as e:\n",
    "    print('PXD073336 automatic acquisition failed:',repr(e)); print('Use ProteomeXchange accession PXD073336 and place Retinaxhippocampus_Proteomics.xlsx at',p)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
