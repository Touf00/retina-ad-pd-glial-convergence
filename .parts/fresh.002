   "source": [
    "# Source analysis cell: 52\n",
    "# ============================================================\n",
    "# V2 STEP 29 — FINAL ROBUST COLAB REPLACEMENT\n",
    "# OPC >=20 SENSITIVITY + FINAL GSE157827 ROBUSTNESS\n",
    "# ============================================================\n",
    "\n",
    "import os\n",
    "import sys\n",
    "import json\n",
    "import subprocess\n",
    "import importlib.metadata\n",
    "\n",
    "from pathlib import Path\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. ENSURE GOOGLE DRIVE IS ACTUALLY MOUNTED\n",
    "# ============================================================\n",
    "\n",
    "MYDRIVE = Path(\n",
    "    \"/content/drive/MyDrive\"\n",
    ")\n",
    "\n",
    "\n",
    "if not MYDRIVE.exists():\n",
    "\n",
    "    try:\n",
    "\n",
    "        from google.colab import drive\n",
    "\n",
    "        drive.mount(\n",
    "            \"/content/drive\",\n",
    "            force_remount=False,\n",
    "        )\n",
    "\n",
    "    except Exception as e:\n",
    "\n",
    "        raise RuntimeError(\n",
    "            \"Google Drive is not mounted and could not be \"\n",
    "            \"mounted automatically.\"\n",
    "        ) from e\n",
    "\n",
    "\n",
    "assert MYDRIVE.exists(), (\n",
    "    f\"Google Drive is not visible at: {MYDRIVE}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. EXACT LOCK NAMES FROM YOUR STEP 27 / STEP 28\n",
    "# ============================================================\n",
    "\n",
    "PRE_NAME = (\n",
    "    \"GSE157827_AD_REPLICATION_PRE_DE_\"\n",
    "    \"PSEUDOBULK_AND_GENE_UNIVERSE_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "S28_NAME = (\n",
    "    \"GSE157827_AD_REPLICATION_STEP28_EFFECTS_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "FINAL_NAME = (\n",
    "    \"GSE157827_AD_REPLICATION_FINAL_ROBUSTNESS_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "EXPECTED_ROOT = (\n",
    "    MYDRIVE\n",
    "    /\n",
    "    \"RETINA_ND_V2\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. LOCATE THE REAL PROJECT ROOT\n",
    "#\n",
    "# Do not blindly assume the folder path.\n",
    "# Locate a root containing BOTH successful upstream locks.\n",
    "# ============================================================\n",
    "\n",
    "def locate_root():\n",
    "\n",
    "    expected_pre = (\n",
    "        EXPECTED_ROOT\n",
    "        /\n",
    "        \"locks\"\n",
    "        /\n",
    "        PRE_NAME\n",
    "    )\n",
    "\n",
    "\n",
    "    expected_s28 = (\n",
    "        EXPECTED_ROOT\n",
    "        /\n",
    "        \"locks\"\n",
    "        /\n",
    "        S28_NAME\n",
    "    )\n",
    "\n",
    "\n",
    "    if (\n",
    "        expected_pre.exists()\n",
    "        and\n",
    "        expected_s28.exists()\n",
    "    ):\n",
    "\n",
    "        return EXPECTED_ROOT\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nExpected project path does not currently expose \"\n",
    "        \"both locks.\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Searching Google Drive for the actual project...\"\n",
    "    )\n",
    "\n",
    "\n",
    "    pre_hits = list(\n",
    "        MYDRIVE.rglob(\n",
    "            PRE_NAME\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    paired_roots = []\n",
    "\n",
    "\n",
    "    for pre_path in pre_hits:\n",
    "\n",
    "        candidate_root = (\n",
    "            pre_path\n",
    "            .parent\n",
    "            .parent\n",
    "        )\n",
    "\n",
    "\n",
    "        candidate_s28 = (\n",
    "            candidate_root\n",
    "            /\n",
    "            \"locks\"\n",
    "            /\n",
    "            S28_NAME\n",
    "        )\n",
    "\n",
    "\n",
    "        if candidate_s28.exists():\n",
    "\n",
    "            paired_roots.append(\n",
    "                candidate_root\n",
    "            )\n",
    "\n",
    "\n",
    "    # Deduplicate paths.\n",
    "    unique_roots = []\n",
    "\n",
    "    seen = set()\n",
    "\n",
    "\n",
    "    for root in paired_roots:\n",
    "\n",
    "        key = str(\n",
    "            root.resolve()\n",
    "        )\n",
    "\n",
    "\n",
    "        if key not in seen:\n",
    "\n",
    "            seen.add(\n",
    "                key\n",
    "            )\n",
    "\n",
    "            unique_roots.append(\n",
    "                root\n",
    "            )\n",
    "\n",
    "\n",
    "    if len(\n",
    "        unique_roots\n",
    "    ) == 1:\n",
    "\n",
    "        return unique_roots[\n",
    "            0\n",
    "        ]\n",
    "\n",
    "\n",
    "    if len(\n",
    "        unique_roots\n",
    "    ) > 1:\n",
    "\n",
    "        raise RuntimeError(\n",
    "\n",
    "            \"More than one project contains BOTH the \"\n",
    "            \"STEP27 and STEP28 locks:\\n\\n\"\n",
    "\n",
    "            +\n",
    "\n",
    "            \"\\n\".join(\n",
    "                str(\n",
    "                    x\n",
    "                )\n",
    "                for x\n",
    "                in unique_roots\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "    # Diagnostic fallback.\n",
    "    s28_hits = list(\n",
    "        MYDRIVE.rglob(\n",
    "            S28_NAME\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    raise FileNotFoundError(\n",
    "\n",
    "        \"Could not locate a Google Drive project containing \"\n",
    "        \"BOTH the STEP27 and STEP28 locks.\\n\\n\"\n",
    "\n",
    "        f\"STEP27 hits:\\n\"\n",
    "        f\"{[str(x) for x in pre_hits]}\\n\\n\"\n",
    "\n",
    "        f\"STEP28 hits:\\n\"\n",
    "        f\"{[str(x) for x in s28_hits]}\"\n",
    "    )\n",
    "\n",
    "\n",
    "ROOT = locate_root()\n",
    "\n",
    "\n",
    "LOCKS = (\n",
    "    ROOT\n",
    "    /\n",
    "    \"locks\"\n",
    ")\n",
    "\n",
    "\n",
    "PRE_PATH = (\n",
    "    LOCKS\n",
    "    /\n",
    "    PRE_NAME\n",
    ")\n",
    "\n",
    "\n",
    "S28_PATH = (\n",
    "    LOCKS\n",
    "    /\n",
    "    S28_NAME\n",
    ")\n",
    "\n",
    "\n",
    "FINAL_LOCK = (\n",
    "    LOCKS\n",
    "    /\n",
    "    FINAL_NAME\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"STEP 29 — ROBUST COLAB REPLACEMENT\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Detected project root:\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    ROOT\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSTEP27 lock:\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    PRE_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSTEP28 lock:\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    S28_PATH\n",
    ")\n",
    "\n",
    "\n",
    "assert PRE_PATH.exists(), (\n",
    "    f\"STEP27 lock missing: {PRE_PATH}\"\n",
    ")\n",
    "\n",
    "\n",
    "assert S28_PATH.exists(), (\n",
    "    f\"STEP28 lock missing: {S28_PATH}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. VERIFY LOCK CONTENTS BEFORE DOING ANYTHING\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    PRE_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    pre_check = json.load(\n",
    "        f\n",
    "    )\n",
    "\n",
    "\n",
    "with open(\n",
    "    S28_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    s28_check = json.load(\n",
    "        f\n",
    "    )\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre_check[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"AD_REPLICATION_PRE_DE_PSEUDOBULK_AND_GENE_UNIVERSE_FROZEN\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    s28_check[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"AD_REPLICATION_PRIMARY_AND_PMD_EFFECTS_FROZEN\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSTEP27 lock content: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"STEP28 lock content: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. RELEASE RERUN POLICY\n",
    "# ============================================================\n",
    "\n",
    "print('Release mode: STEP 29 will be recomputed even if an older final lock exists.')\n",
    "\n",
    "# ============================================================\n",
    "# 5. ENSURE FRESH-PROCESS PACKAGE VERSIONS\n",
    "# ============================================================\n",
    "\n",
    "TARGET = {\n",
    "\n",
    "    \"pandas\":\n",
    "        \"2.3.3\",\n",
    "\n",
    "    \"pydeseq2\":\n",
    "        \"0.5.4\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "for package, version in TARGET.items():\n",
    "\n",
    "    try:\n",
    "\n",
    "        current = importlib.metadata.version(\n",
    "            package\n",
    "        )\n",
    "\n",
    "    except importlib.metadata.PackageNotFoundError:\n",
    "\n",
    "        current = None\n",
    "\n",
    "\n",
    "    if current != version:\n",
    "\n",
    "        print(\n",
    "            f\"\\nInstalling {package}=={version} \"\n",
    "            f\"(current={current})\"\n",
    "        )\n",
    "\n",
    "\n",
    "        subprocess.check_call(\n",
    "            [\n",
    "                sys.executable,\n",
    "                \"-m\",\n",
    "                \"pip\",\n",
    "                \"install\",\n",
    "                \"-q\",\n",
    "                \"--upgrade\",\n",
    "                f\"{package}=={version}\",\n",
    "            ]\n",
    "        )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. RUNNER + LOG PATHS\n",
    "# ============================================================\n",
    "\n",
    "SCRIPT_DIR = (\n",
    "    ROOT\n",
    "    /\n",
    "    \"scripts\"\n",
    ")\n",
    "\n",
    "\n",
    "LOG_DIR = (\n",
    "    ROOT\n",    "    /\n",
    "    \"logs\"\n",
    ")\n",
    "\n",
    "\n",
    "SCRIPT_DIR.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "\n",
    "LOG_DIR.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "\n",
    "runner = (\n",
    "    SCRIPT_DIR\n",
    "    /\n",
    "    \"STEP29_GSE157827_FIXED.py\"\n",
    ")\n",
    "\n",
    "\n",
    "log = (\n",
    "    LOG_DIR\n",
    "    /\n",
    "    \"STEP29_GSE157827_FIXED.log\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. FRESH-PROCESS STEP29 ANALYSIS\n",
    "# ============================================================\n",
    "\n",
    "RUNNER = r\"\"\"\n",
    "import os\n",
    "import json\n",
    "import importlib.metadata\n",
    "\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from scipy.stats import (\n",
    "    spearmanr,\n",
    "    pearsonr,\n",
    ")\n",
    "\n",
    "from pydeseq2.dds import DeseqDataSet\n",
    "from pydeseq2.ds import DeseqStats\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# A. ROOT PASSED FROM THE PARENT NOTEBOOK\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(\n",
    "    os.environ[\n",
    "        \"RETINA_ND_ROOT\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "LOCKS = (\n",
    "    ROOT\n",
    "    /\n",
    "    \"locks\"\n",
    ")\n",
    "\n",
    "\n",
    "PRE_NAME = (\n",
    "    \"GSE157827_AD_REPLICATION_PRE_DE_\"\n",
    "    \"PSEUDOBULK_AND_GENE_UNIVERSE_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "S28_NAME = (\n",
    "    \"GSE157827_AD_REPLICATION_STEP28_EFFECTS_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "FINAL_NAME = (\n",
    "    \"GSE157827_AD_REPLICATION_FINAL_ROBUSTNESS_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "PRE_PATH = (\n",
    "    LOCKS\n",
    "    /\n",
    "    PRE_NAME\n",
    ")\n",
    "\n",
    "\n",
    "S28_PATH = (\n",
    "    LOCKS\n",
    "    /\n",
    "    S28_NAME\n",
    ")\n",
    "\n",
    "\n",
    "FINAL_LOCK = (\n",
    "    LOCKS\n",
    "    /\n",
    "    FINAL_NAME\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# B. ENVIRONMENT CHECK\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"STEP 29 CHILD PROCESS\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"ROOT:\",\n",
    "    ROOT\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"pandas:\",\n",
    "    pd.__version__\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"pydeseq2:\",\n",
    "    importlib.metadata.version(\n",
    "        \"pydeseq2\"\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"anndata:\",\n",
    "    importlib.metadata.version(\n",
    "        \"anndata\"\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"numpy:\",\n",
    "    np.__version__\n",
    ")\n",
    "\n",
    "\n",
    "# Directly test the API that caused the original failure.\n",
    "_test_dtype = pd.StringDtype(\n",
    "    na_value=np.nan\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"pd.StringDtype(na_value=...): PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# C. VERIFY STEP27 + STEP28 AGAIN INSIDE CHILD PROCESS\n",
    "# ============================================================\n",
    "\n",
    "assert PRE_PATH.exists(), (\n",
    "    f\"STEP27 lock disappeared: {PRE_PATH}\"\n",
    ")\n",
    "\n",
    "\n",
    "assert S28_PATH.exists(), (\n",
    "    f\"STEP28 lock disappeared: {S28_PATH}\"\n",
    ")\n",
    "\n",
    "\n",
    "with open(\n",
    "    PRE_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    pre = json.load(\n",
    "        f\n",
    "    )\n",
    "\n",
    "\n",
    "with open(\n",
    "    S28_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    s28 = json.load(\n",
    "        f\n",
    "    )\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"AD_REPLICATION_PRE_DE_PSEUDOBULK_AND_GENE_UNIVERSE_FROZEN\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre[\n",
    "        \"pseudobulk_built\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre[\n",
    "        \"gene_filter_frozen\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    s28[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"AD_REPLICATION_PRIMARY_AND_PMD_EFFECTS_FROZEN\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    s28[\n",
    "        \"primary_effects_frozen\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    s28[\n",
    "        \"PMD_effects_frozen\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nUpstream STEP27 + STEP28 locks: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# D. LOAD STEP28 EFFECT TABLES\n",
    "# ============================================================\n",
    "\n",
    "P = pd.read_csv(\n",
    "    s28[\n",
    "        \"primary_all_effects\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "S = pd.read_csv(\n",
    "    s28[\n",
    "        \"PMD_all_effects\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "required_effect_cols = {\n",
    "\n",
    "    \"cell_type\",\n",
    "    \"gene_id\",\n",
    "    \"gene_symbol\",\n",
    "    \"log2FoldChange\",\n",
    "    \"stat\",\n",
    "    \"pvalue\",\n",
    "    \"padj\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "assert required_effect_cols.issubset(\n",
    "    P.columns\n",
    ")\n",
    "\n",
    "\n",
    "assert required_effect_cols.issubset(\n",
    "    S.columns\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPrimary effects:\",\n",
    "    P.shape\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"PMD effects:\",\n",
    "    S.shape\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# E. OPC >=20 NUCLEI/DONOR SENSITIVITY\n",
    "# ============================================================\n",
    "\n",
    "rec = (\n",
    "    pre[\n",
    "        \"cell_type_gene_universes\"\n",
    "    ][\n",
    "        \"OPC\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "raw_path = Path(\n",
    "    rec[\n",
    "        \"filtered_pseudobulk_file\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "meta_path = Path(\n",
    "    rec[\n",
    "        \"eligible_donor_metadata_file\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "assert raw_path.exists(), (\n",
    "    raw_path\n",
    ")\n",
    "\n",
    "\n",
    "assert meta_path.exists(), (\n",
    "    meta_path\n",
    ")\n",
    "\n",
    "\n",
    "raw = pd.read_csv(\n",
    "    raw_path\n",
    ")\n",
    "\n",
    "\n",
    "meta = pd.read_csv(\n",
    "    meta_path\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    \"sensitivity20_eligible\"\n",
    "    in meta.columns\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# F. ROBUSTLY PARSE THE >=20 ELIGIBILITY FLAG\n",
    "# ============================================================\n",
    "\n",
    "flag = meta[\n",
    "    \"sensitivity20_eligible\"\n",
    "]\n",
    "\n",
    "\n",
    "if pd.api.types.is_bool_dtype(\n",
    "    flag\n",
    "):\n",
    "\n",
    "    eligible20 = (\n",
    "        flag\n",
    "        .fillna(\n",
    "            False\n",
    "        )\n",
    "        .astype(\n",
    "            bool\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "else:\n",
    "\n",
    "    cleaned = (\n",
    "        flag\n",
    "        .astype(str)\n",
    "        .str.strip()\n",
    "        .str.lower()\n",
    "    )\n",
    "\n",
    "\n",
    "    eligible20 = cleaned.map(\n",
    "        {\n",
    "\n",
    "            \"true\":\n",
    "                True,\n",
    "\n",
    "            \"false\":\n",
    "                False,\n",
    "\n",
    "            \"1\":\n",
    "                True,\n",
    "\n",
    "            \"0\":\n",
    "                False,\n",
    "\n",
    "            \"yes\":\n",
    "                True,\n",
    "\n",
    "            \"no\":\n",
    "                False,\n",
    "\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    if eligible20.isna().any():\n",
    "\n",
    "        bad = sorted(\n",
    "            cleaned[\n",
    "                eligible20.isna()\n",
    "            ]\n",
    "            .unique()\n",
    "            .tolist()\n",
    "        )\n",
    "\n",
    "\n",
    "        raise AssertionError(\n",
    "            \"Unexpected sensitivity20_eligible values: \"\n",
    "            f\"{bad}\"\n",
    "        )\n",
    "\n",
    "\n",
    "    eligible20 = eligible20.astype(\n",
    "        bool\n",
    "    )\n",
    "\n",
    "\n",
    "m20 = meta.loc[\n",
    "    eligible20\n",
    "].copy()\n",
    "\n",
    "\n",
    "observed = (\n",
    "\n",
    "    len(\n",
    "        m20\n",
    "    ),\n",
    "\n",
    "    int(\n",
    "        (\n",
    "            m20[\n",
    "                \"diagnosis_binary\"\n",
    "            ]\n",
    "            ==\n",
    "            \"AD\"\n",
    "        ).sum()\n",
    "    ),\n",
    "\n",
    "    int(\n",
    "        (\n",
    "            m20[\n",
    "                \"diagnosis_binary\"\n",
    "            ]\n",
    "            ==\n",
    "            \"Control\"\n",
    "        ).sum()\n",
    "    ),\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert observed == (\n",
    "    12,\n",
    "    7,\n",
    "    5,\n",
    "), observed\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nOPC >=20 cohort:\",\n",
    "    observed\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# G. CONSTRUCT COUNT MATRIX\n",
    "# ============================================================\n",
    "\n",
    "ids = (\n",
    "    raw[\n",
    "        \"gene_id\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .tolist()\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    len(\n",
    "        ids\n",
    "    )\n",
    "    ==\n",
    "    len(\n",
    "        set(\n",
    "            ids\n",
    "        )\n",
    "    )\n",
    "), (\n",
    "    \"gene_id is not unique in OPC pseudobulk.\"\n",
    ")\n",
    "\n",
    "\n",
    "groups = (\n",
    "    m20[\n",
    "        \"group_id\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .tolist()\n",
    ")\n",
    "\n",
    "\n",
    "missing_groups = sorted(\n",
    "    set(\n",
    "        groups\n",
    "    )\n",
    "    -\n",
    "    set(\n",
    "        raw.columns\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert not missing_groups, (\n",
    "    f\"Missing donor columns: {missing_groups}\"\n",
    ")\n",
    "\n",
    "\n",
    "counts = (\n",
    "    raw[\n",
    "        groups\n",
    "    ]\n",
    "    .T\n",
    ")\n",
    "\n",
    "\n",
    "counts = counts.apply(\n",
    "    pd.to_numeric,\n",
    "    errors=\"raise\",\n",
    ")\n",
    "\n",
    "\n",
    "arr = counts.to_numpy(\n",
    "    dtype=float\n",
    ")\n",
    "\n",
    "\n",
    "assert np.isfinite(\n",
    "    arr\n",
    ").all()\n",
    "\n",
    "\n",
    "assert (\n",
    "    arr\n",
    "    >=\n",
    "    0\n",
    ").all()\n",
    "\n",
    "\n",
    "assert np.allclose(\n",
    "    arr,\n",
    "    np.rint(\n",
    "        arr\n",
    "    ),\n",
    ")\n",
    "\n",
    "\n",
    "counts = pd.DataFrame(\n",
    "\n",
    "    np.rint(\n",
    "        arr\n",
    "    ).astype(\n",
    "        np.int64\n",
    "    ),\n",
    "\n",
    "    index=pd.Index(\n",
    "        groups,\n",
    "        dtype=object,\n",
    "    ),\n",
    "\n",
    "    columns=pd.Index(\n",
    "        ids,\n",
    "        dtype=object,\n",
    "    ),\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# H. DESIGN METADATA\n",
    "# ============================================================\n",
    "\n",
    "dm = m20[\n",
    "    [\n",
    "        \"group_id\",\n",
    "        \"age\",\n",
    "        \"sex\",\n",
    "        \"diagnosis_binary\",\n",
    "    ]\n",
    "].copy()\n",
    "\n",
    "\n",
    "dm[\n",
    "    \"group_id\"\n",
    "] = (\n",
    "    dm[\n",
    "        \"group_id\"\n",
    "    ]\n",
    "    .astype(str)\n",
    ")\n",
    "\n",
    "\n",
    "dm.index = pd.Index(\n",
    "    dm[\n",
    "        \"group_id\"\n",
    "    ]\n",
    "    .tolist(),\n",
    "    dtype=object,\n",
    ")\n",
    "\n",
    "\n",
    "dm = dm.drop(\n",
    "    columns=\"group_id\"\n",
    ")\n",
    "\n",
    "\n",
    "dm[\n",
    "    \"age\"\n",
    "] = pd.to_numeric(\n",
    "    dm[\n",
    "        \"age\"\n",
    "    ],\n",
    "    errors=\"raise\",\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# I. SEX NORMALIZATION\n",
    "# ============================================================\n",
    "\n",
    "sex_raw = (\n",
    "    dm[\n",
    "        \"sex\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "\n",
    "sex_map = {\n",
    "\n",
    "    \"F\":\n",
    "        \"Female\",\n",
    "\n",
    "    \"M\":\n",
    "        \"Male\",\n",
    "\n",
    "    \"Female\":\n",
    "        \"Female\",\n",
    "\n",
    "    \"Male\":\n",
    "        \"Male\",\n",
    "\n",
    "    \"female\":\n",
    "        \"Female\",\n",
    "\n",
    "    \"male\":\n",
    "        \"Male\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "dm[\n",
    "    \"sex\"\n",
    "] = sex_raw.map(\n",
    "    sex_map\n",
    ")\n",
    "\n",
    "\n",
    "if dm[\n",
    "    \"sex\"\n",
    "].isna().any():\n",
    "\n",
    "    bad = sorted(\n",
    "        sex_raw[\n",
    "            dm[\n",
    "                \"sex\"\n",
    "            ].isna()\n",
    "        ]\n",
    "        .unique()\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    raise AssertionError(\n",
    "        f\"Unexpected sex values: {bad}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# J. DIAGNOSIS NORMALIZATION\n",
    "# ============================================================\n",
    "\n",
    "diag_raw = (\n",
    "    dm[\n",
    "        \"diagnosis_binary\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "\n",
    "diag_map = {\n",
    "\n",
    "    \"Control\":\n",
    "        \"Control\",\n",
    "\n",
    "    \"control\":\n",
    "        \"Control\",\n",
    "\n",
    "    \"CTRL\":\n",
    "        \"Control\",\n",
    "\n",
    "    \"AD\":\n",
    "        \"AD\",\n",
    "\n",
    "    \"Alzheimer's disease\":\n",
    "        \"AD\",\n",
    "\n",
    "    \"Alzheimer disease\":\n",
    "        \"AD\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "dm[\n",
    "    \"diagnosis_binary\"\n",
    "] = diag_raw.map(\n",
    "    diag_map\n",
    ")\n",
    "\n",
    "\n",
    "if dm[\n",
    "    \"diagnosis_binary\"\n",
    "].isna().any():\n",
    "\n",
    "    bad = sorted(\n",
    "        diag_raw[\n",
    "            dm[\n",
    "                \"diagnosis_binary\"\n",
    "            ].isna()\n",
    "        ]\n",
    "        .unique()\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    raise AssertionError(\n",
    "        f\"Unexpected diagnosis values: {bad}\"\n",
    "    )\n",
    "\n",
    "\n",
    "dm[\n",
    "    \"sex\"\n",
    "] = pd.Categorical(\n",
    "    dm[\n",
    "        \"sex\"\n",
    "    ],\n",
    "    categories=[\n",
    "        \"Female\",\n",
    "        \"Male\",\n",
    "    ],\n",
    ")\n",
    "\n",
    "\n",
    "dm[\n",
    "    \"diagnosis_binary\"\n",
    "] = pd.Categorical(\n",
    "    dm[\n",
    "        \"diagnosis_binary\"\n",
    "    ],\n",
    "    categories=[\n",
    "        \"Control\",\n",
    "        \"AD\",\n",
    "    ],\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    counts.index.tolist()\n",
    "    ==\n",
    "    dm.index.tolist()\n",
    ")\n",
    "\n",
    "\n",
    "assert not (\n",
    "    dm[\n",
    "        \"sex\"\n",
    "    ]\n",
    "    .isna()\n",
    "    .any()\n",
    ")\n",
    "\n",
    "\n",
    "assert not (\n",
    "    dm[\n",
    "        \"diagnosis_binary\"\n",
    "    ]\n",
    "    .isna()\n",
    "    .any()\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nOPC sensitivity counts:\",\n",
    "    counts.shape\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"OPC sensitivity metadata:\",\n",
    "    dm.shape\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Sex:\",\n",
    "    dm[\n",
    "        \"sex\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Diagnosis:\",\n",
    "    dm[\n",
    "        \"diagnosis_binary\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# K. DESEQ2\n",
    "# ============================================================\n",
    "\n",
    "dds = DeseqDataSet(\n",
    "\n",
    "    counts=counts,\n",
    "\n",
    "    metadata=dm,\n",
    "\n",
    "    design=(\n",
    "        \"~ age + sex + diagnosis_binary\"\n",
    "    ),\n",
    "\n",
    "    refit_cooks=True,\n",
    "\n",
    "    n_cpus=2,\n",
    "\n",
    "    quiet=False,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nDeseqDataSet initialization: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "dds.deseq2()\n",
    "\n",
    "\n",
    "print(\n",
    "    \"DESeq2 fit: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "st = DeseqStats(\n",
    "\n",
    "    dds,\n",
    "\n",
    "    contrast=[\n",
    "        \"diagnosis_binary\",\n",
    "        \"AD\",\n",
    "        \"Control\",\n",
    "    ],\n",
    "\n",
    "    alpha=0.05,\n",
    "\n",
    "    cooks_filter=True,\n",
    "\n",
    "    independent_filter=True,\n",
    "\n",
    "    n_cpus=2,\n",
    "\n",
    "    quiet=False,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "st.summary()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# L. EXTRACT DE RESULTS\n",
    "# ============================================================\n",
    "\n",
    "r = (\n",
    "    st\n",
    "    .results_df\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "\n",
    "r.index = (\n",
    "    r.index\n",
    "    .astype(str)\n",
    ")\n",
    "\n",
    "\n",
    "r.index.name = (\n",
    "    \"gene_id\"\n",
    ")\n",
    "\n",
    "\n",
    "r = r.reset_index()\n",
    "\n",
    "\n",
    "symbol_map = dict(\n",
    "    zip(\n",
    "        raw[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .astype(str),\n",
    "\n",
    "        raw[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str),\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "r.insert(\n",
    "\n",
    "    1,\n",
    "\n",
    "    \"gene_symbol\",\n",
    "\n",
    "    r[\n",
    "        \"gene_id\"\n",
    "    ].map(\n",
    "        symbol_map\n",
    "    ),\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    r[\n",
    "        \"gene_symbol\"\n",
    "    ]\n",
    "    .notna()\n",
    "    .all()\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# M. SAVE OPC >=20 RESULTS\n",
    "# ============================================================\n",
    "\n",
    "out = (\n",
    "\n",    "    ROOT\n",
    "    /\n",
    "    \"GSE157827_AD_replication\"\n",
    "    /\n",
    "    \"DE\"\n",
    "    /\n",
    "    \"cellcount20_sensitivity\"\n",
    "    /\n",
    "    \"OPC\"\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "out.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "\n",
    "rp = (\n",
    "    out\n",
    "    /\n",
    "    \"GSE157827_OPC_CELLCOUNT20_ALL_EFFECTS_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "r.to_csv(\n",
    "    rp,\n",
    "    index=False,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    rp.exists()\n",
    "    and\n",
    "    rp.stat().st_size > 0\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# N. PRIMARY OPC vs >=20 OPC\n",
    "# ============================================================\n",
    "\n",
    "op = (\n",
    "\n",
    "    P.loc[\n",
    "        P[\n",
    "            \"cell_type\"\n",
    "        ]\n",
    "        ==\n",
    "        \"OPC\",\n",
    "\n",
    "        [\n",
    "            \"gene_id\",\n",
    "            \"log2FoldChange\",\n",
    "            \"stat\",\n",
    "            \"padj\",\n",
    "        ],\n",
    "    ]\n",
    "\n",
    "    .rename(\n",
    "        columns={\n",
    "\n",
    "            \"log2FoldChange\":\n",
    "                \"primary_LFC\",\n",
    "\n",
    "            \"stat\":\n",
    "                \"primary_Wald\",\n",
    "\n",
    "            \"padj\":\n",
    "                \"primary_padj\",\n",
    "\n",
    "        }\n",
    "    )\n",
    "\n",
    "    .merge(\n",
    "\n",
    "        r[\n",
    "            [\n",
    "                \"gene_id\",\n",
    "                \"log2FoldChange\",\n",
    "                \"stat\",\n",
    "                \"padj\",\n",
    "            ]\n",
    "        ]\n",
    "\n",
    "        .rename(\n",
    "            columns={\n",
    "\n",
    "                \"log2FoldChange\":\n",
    "                    \"sens20_LFC\",\n",
    "\n",
    "                \"stat\":\n",
    "                    \"sens20_Wald\",\n",
    "\n",
    "                \"padj\":\n",
    "                    \"sens20_padj\",\n",
    "\n",
    "            }\n",
    "        ),\n",
    "\n",
    "        on=\"gene_id\",\n",
    "\n",
    "        how=\"inner\",\n",
    "\n",
    "        validate=\"one_to_one\",\n",
    "\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "lfc_mask = (\n",
    "\n",
    "    np.isfinite(\n",
    "        op[\n",
    "            \"primary_LFC\"\n",
    "        ]\n",
    "        .to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "    )\n",
    "\n",
    "    &\n",
    "\n",
    "    np.isfinite(\n",
    "        op[\n",
    "            \"sens20_LFC\"\n",
    "        ]\n",
    "        .to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "wald_mask = (\n",
    "\n",
    "    np.isfinite(\n",
    "        op[\n",
    "            \"primary_Wald\"\n",
    "        ]\n",
    "        .to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "    )\n",
    "\n",
    "    &\n",
    "\n",
    "    np.isfinite(\n",
    "        op[\n",
    "            \"sens20_Wald\"\n",
    "        ]\n",
    "        .to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert int(\n",
    "    lfc_mask.sum()\n",
    ") > 2\n",
    "\n",
    "\n",
    "assert int(\n",
    "    wald_mask.sum()\n",
    ") > 2\n",
    "\n",
    "\n",
    "summary = {\n",
    "\n",
    "    \"OPC_sensitivity_donors\":\n",
    "        12,\n",
    "\n",
    "    \"AD\":\n",
    "        7,\n",
    "\n",
    "    \"Control\":\n",
    "        5,\n",
    "\n",
    "    \"tested_genes\":\n",
    "        int(\n",
    "            len(\n",
    "                r\n",
    "            )\n",
    "        ),\n",
    "\n",
    "    \"FDR\":\n",
    "        int(\n",
    "            (\n",
    "                r[\n",
    "                    \"padj\"\n",
    "                ]\n",
    "                <\n",
    "                0.05\n",
    "            )\n",
    "            .fillna(\n",
    "                False\n",
    "            )\n",
    "            .sum()\n",
    "        ),\n",
    "\n",
    "    \"LFC_pearson\":\n",
    "        float(\n",
    "            pearsonr(\n",
    "\n",
    "                op.loc[\n",
    "                    lfc_mask,\n",
    "                    \"primary_LFC\",\n",
    "                ],\n",
    "\n",
    "                op.loc[\n",
    "                    lfc_mask,\n",
    "                    \"sens20_LFC\",\n",
    "                ],\n",
    "\n",
    "            ).statistic\n",
    "        ),\n",
    "\n",
    "    \"LFC_spearman\":\n",
    "        float(\n",
    "            spearmanr(\n",
    "\n",
    "                op.loc[\n",
    "                    lfc_mask,\n",
    "                    \"primary_LFC\",\n",
    "                ],\n",
    "\n",
    "                op.loc[\n",
    "                    lfc_mask,\n",
    "                    \"sens20_LFC\",\n",
    "                ],\n",
    "\n",
    "            ).statistic\n",
    "        ),\n",
    "\n",
    "    \"Wald_spearman\":\n",
    "        float(\n",
    "            spearmanr(\n",
    "\n",
    "                op.loc[\n",
    "                    wald_mask,\n",
    "                    \"primary_Wald\",\n",
    "                ],\n",
    "\n",
    "                op.loc[\n",
    "                    wald_mask,\n",
    "                    \"sens20_Wald\",\n",
    "                ],\n",
    "\n",
    "            ).statistic\n",
    "        ),\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "assert (\n",
    "    summary[\n",
    "        \"FDR\"\n",
    "    ]\n",
    "    ==\n",
    "    0\n",
    "), summary\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# O. AUDIT 4 PRIMARY OLIGO HITS AGAINST PMD MODEL\n",
    "# ============================================================\n",
    "\n",
    "ol = (\n",
    "\n",
    "    P.loc[\n",
    "        (\n",
    "            P[\n",
    "                \"cell_type\"\n",
    "            ]\n",
    "            ==\n",
    "            \"Oligo\"\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            P[\n",
    "                \"padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "    ]\n",
    "\n",
    "    .merge(\n",
    "\n",
    "        S.loc[\n",
    "            S[\n",
    "                \"cell_type\"\n",
    "            ]\n",
    "            ==\n",
    "            \"Oligo\",\n",
    "\n",
    "            [\n",
    "                \"gene_id\",\n",
    "                \"log2FoldChange\",\n",
    "                \"pvalue\",\n",
    "                \"padj\",\n",
    "            ],\n",
    "        ],\n",
    "\n",
    "        on=\"gene_id\",\n",
    "\n",
    "        suffixes=(\n",
    "            \"_primary\",\n",
    "            \"_PMD\",\n",
    "        ),\n",
    "\n",
    "        validate=\"one_to_one\",\n",
    "\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    len(\n",
    "        ol\n",
    "    )\n",
    "    ==\n",
    "    4\n",
    "), (\n",
    "    \"Expected 4 primary Oligo FDR hits; \"\n",
    "    f\"found {len(ol)}\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "\n",
    "    np.sign(\n",
    "        ol[\n",
    "            \"log2FoldChange_primary\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    ==\n",
    "\n",
    "    np.sign(\n",
    "        ol[\n",
    "            \"log2FoldChange_PMD\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    ").all()\n",
    "\n",
    "\n",
    "assert (\n",
    "    ol[\n",
    "        \"pvalue_PMD\"\n",
    "    ]\n",
    "    <\n",
    "    0.05\n",
    ").all()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# P. FDR COUNTS\n",
    "# ============================================================\n",
    "\n",
    "primary_fdr = {\n",
    "\n",
    "    str(\n",
    "        ct\n",
    "    ):\n",
    "        int(\n",
    "            (\n",
    "                group[\n",
    "                    \"padj\"\n",
    "                ]\n",
    "                <\n",
    "                0.05\n",
    "            )\n",
    "            .fillna(\n",
    "                False\n",
    "            )\n",
    "            .sum()\n",
    "        )\n",
    "\n",
    "    for ct, group\n",
    "    in P.groupby(\n",
    "        \"cell_type\",\n",
    "        observed=False,\n",
    "    )\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "pmd_fdr = {\n",
    "\n",
    "    str(\n",
    "        ct\n",
    "    ):\n",
    "        int(\n",
    "            (\n",
    "                group[\n",
    "                    \"padj\"\n",
    "                ]\n",
    "                <\n",
    "                0.05\n",
    "            )\n",
    "            .fillna(\n",
    "                False\n",
    "            )\n",
    "            .sum()\n",
    "        )\n",
    "\n",
    "    for ct, group\n",
    "    in S.groupby(\n",
    "        \"cell_type\",\n",
    "        observed=False,\n",
    "    )\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# Q. FINAL LOCK\n",
    "# ============================================================\n",
    "\n",
    "oligo_columns = [\n",
    "\n",
    "    \"gene_id\",\n",
    "\n",
    "    \"gene_symbol\",\n",
    "\n",
    "    \"log2FoldChange_primary\",\n",
    "\n",
    "    \"padj_primary\",\n",
    "\n",
    "    \"log2FoldChange_PMD\",\n",
    "\n",
    "    \"pvalue_PMD\",\n",
    "\n",
    "    \"padj_PMD\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "for column in oligo_columns:\n",
    "\n",
    "    assert column in ol.columns, (\n",
    "        column\n",
    "    )\n",
    "\n",
    "\n",
    "lock = {\n",
    "\n",
    "    \"dataset\":\n",
    "        \"GSE157827\",\n",
    "\n",
    "    \"status\":\n",
    "        \"AD_REPLICATION_FINAL_ROBUSTNESS_FROZEN\",\n",
    "\n",
    "    \"GSE157827_replication_robustness_complete\":\n",
    "        True,\n",
    "\n",
    "    \"OPC_cellcount20\":\n",
    "        summary,\n",
    "\n",
    "    \"OPC_cellcount20_all_effects\":\n",
    "        str(\n",
    "            rp\n",
    "        ),\n",
    "\n",
    "    \"primary_FDR_counts\":\n",
    "        primary_fdr,\n",
    "\n",
    "    \"PMD_FDR_counts\":\n",
    "        pmd_fdr,\n",
    "\n",
    "    \"Oligo_primary_FDR_hits\":\n",
    "        ol[\n",
    "            oligo_columns\n",
    "        ]\n",
    "        .to_dict(\n",
    "            \"records\"\n",
    "        ),\n",
    "\n",
    "    \"discovery_vs_replication_compared\":\n",
    "        False,\n",
    "\n",
    "    \"AD_PD_convergence_performed\":\n",
    "        False,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    FINAL_LOCK,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        lock,\n",
    "        f,\n",
    "        indent=2,\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# R. FINAL REPORT\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"STEP 29 PASS — GSE157827 FINAL ROBUSTNESS FROZEN\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    json.dumps(\n",
    "        summary,\n",
    "        indent=2,\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPrimary FDR counts:\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    json.dumps(\n",
    "        primary_fdr,\n",
    "        indent=2,\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPMD FDR counts:\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    json.dumps(\n",
    "        pmd_fdr,\n",
    "        indent=2,\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nOligo primary FDR hits with PMD support:\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    ol[\n",
    "        oligo_columns\n",
    "    ].to_string(\n",
    "        index=False\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFinal lock:\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    FINAL_LOCK\n",
    ")\n",
    "\"\"\"\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. WRITE RUNNER\n",
