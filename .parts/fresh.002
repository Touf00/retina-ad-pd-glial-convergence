    "import harmonypy\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# A. REPRODUCIBILITY\n",
    "# ============================================================\n",
    "\n",
    "SEED = 20260914\n",
    "\n",
    "np.random.seed(\n",
    "    SEED\n",
    ")\n",
    "\n",
    "\n",
    "def package_version(\n",
    "    name\n",
    "):\n",
    "\n",
    "    try:\n",
    "\n",
    "        return importlib.metadata.version(\n",
    "            name\n",
    "        )\n",
    "\n",
    "    except Exception:\n",
    "\n",
    "        return None\n",
    "\n",
    "\n",
    "ENVIRONMENT = {\n",
    "    \"python\":\n",
    "        platform.python_version(),\n",
    "\n",
    "    \"numpy\":\n",
    "        np.__version__,\n",
    "\n",
    "    \"pandas\":\n",
    "        pd.__version__,\n",
    "\n",
    "    \"scipy\":\n",
    "        scipy.__version__,\n",
    "\n",
    "    \"anndata\":\n",
    "        package_version(\n",
    "            \"anndata\"\n",
    "        ),\n",
    "\n",
    "    \"scanpy\":\n",
    "        package_version(\n",
    "            \"scanpy\"\n",
    "        ),\n",
    "\n",
    "    \"harmonypy\":\n",
    "        package_version(\n",
    "            \"harmonypy\"\n",
    "        ),\n",
    "\n",
    "    \"leidenalg\":\n",
    "        package_version(\n",
    "            \"leidenalg\"\n",
    "        ),\n",
    "\n",
    "    \"igraph\":\n",
    "        package_version(\n",
    "            \"igraph\"\n",
    "        ),\n",
    "\n",
    "    \"scikit-misc\":\n",
    "        package_version(\n",
    "            \"scikit-misc\"\n",
    "        ),\n",
    "}\n",
    "\n",
    "\n",
    "print(\"=\" * 90)\n",
    "print(\"RETINA-ND STEP 26A1 — DISEASE-BLIND EMBEDDING + CLUSTERING\")\n",
    "print(\"=\" * 90)\n",
    "\n",
    "\n",
    "for key, value in ENVIRONMENT.items():\n",
    "\n",
    "    print(\n",
    "        f\"{key}: {value}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# B. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = ROOT / \"locks\"\n",
    "MANIFESTS = ROOT / \"manifests\"\n",
    "\n",
    "REP_DIR = (\n",
    "    ROOT\n",
    "    /\n",
    "    \"GSE157827_AD_replication\"\n",
    ")\n",
    "\n",
    "ANNO_DIR = (\n",
    "    REP_DIR\n",
    "    /\n",
    "    \"annotation_provisional\"\n",
    ")\n",
    "\n",
    "ANNO_DIR.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "\n",
    "STEP25_LOCK_PATH = (\n",
    "    LOCKS\n",
    "    /\n",
    "    \"GSE157827_AD_REPLICATION_DONOR_METADATA_AND_QC_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "RAW_AUDIT_LOCK_PATH = (\n",
    "    LOCKS\n",
    "    /\n",
    "    \"GSE157827_AD_REPLICATION_RAW_DATA_AUDIT_v1.json\"\n",
    ")\n",
    "\n",
    "ROLE_LOCK_PATH = (\n",
    "    LOCKS\n",
    "    /\n",
    "    \"AD_BRAIN_DATASET_ROLES_v1.json\"\n",
    ")\n",
    "\n",
    "SAMPLE_MANIFEST_PATH = (\n",
    "    MANIFESTS\n",
    "    /\n",
    "    \"GSE157827_OFFICIAL_RAW_SAMPLE_MANIFEST_v1.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "GENE_DETECTION_AUDIT_PATH = (\n",
    "    ANNO_DIR\n",
    "    /\n",
    "    \"GSE157827_CLUSTERING_GENE_DETECTION_AUDIT_v1.csv\"\n",
    ")\n",
    "\n",
    "HVG_PATH = (\n",
    "    ANNO_DIR\n",
    "    /\n",
    "    \"GSE157827_DISEASE_BLIND_HVG1000_v1.csv\"\n",
    ")\n",
    "\n",
    "OBS_CLUSTER_PATH = (\n",
    "    ANNO_DIR\n",
    "    /\n",
    "    \"GSE157827_STEP26A1_OBS_CLUSTER_ASSIGNMENTS_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "MARKER_EXPRESSION_PATH = (\n",
    "    ANNO_DIR\n",
    "    /\n",
    "    \"GSE157827_STEP26A1_MARKER_EXPRESSION_LOGCP10K_v1.npy\"\n",
    ")\n",
    "\n",
    "MARKER_NAMES_PATH = (\n",
    "    ANNO_DIR\n",
    "    /\n",
    "    \"GSE157827_STEP26A1_MARKER_NAMES_v1.json\"\n",
    ")\n",
    "\n",
    "HARMONY20_PATH = (\n",
    "    ANNO_DIR\n",
    "    /\n",
    "    \"GSE157827_STEP26A1_HARMONY20_v1.npy\"\n",
    ")\n",
    "\n",
    "CLUSTER_SUMMARY_PATH = (\n",
    "    ANNO_DIR\n",
    "    /\n",
    "    \"GSE157827_STEP26A1_CLUSTER_SUMMARY_v1.csv\"\n",
    ")\n",
    "\n",
    "STEP26A1_LOCK_PATH = (\n",
    "    LOCKS\n",
    "    /\n",
    "    \"GSE157827_AD_REPLICATION_STEP26A1_DISEASE_BLIND_CLUSTERING_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "    STEP25_LOCK_PATH,\n",
    "    RAW_AUDIT_LOCK_PATH,\n",
    "    ROLE_LOCK_PATH,\n",
    "    SAMPLE_MANIFEST_PATH,\n",
    "]:\n",
    "\n",
    "    assert path.exists(), (\n",
    "        f\"Missing required input: {path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "if STEP26A1_LOCK_PATH.exists():\n",
    "\n",
    "    raise RuntimeError(\n",
    "        \"STEP26A1 lock already exists. \"\n",
    "        \"Stopping rather than overwriting a completed checkpoint.\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# C. HELPERS\n",
    "# ============================================================\n",
    "\n",
    "def sha256_file(\n",
    "    path,\n",
    "    block_size=4 * 1024 * 1024,\n",
    "):\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\",\n",
    "    ) as handle:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            block = handle.read(\n",
    "                block_size\n",
    "            )\n",
    "\n",
    "            if not block:\n",
    "                break\n",
    "\n",
    "            h.update(\n",
    "                block\n",
    "            )\n",
    "\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "def parse_bool(\n",
    "    series\n",
    "):\n",
    "\n",
    "    if pd.api.types.is_bool_dtype(\n",
    "        series\n",
    "    ):\n",
    "\n",
    "        return series.astype(\n",
    "            bool\n",
    "        )\n",
    "\n",
    "\n",
    "    mapped = (\n",
    "        series\n",
    "        .astype(str)\n",
    "        .str.strip()\n",
    "        .str.lower()\n",
    "        .map(\n",
    "            {\n",
    "                \"true\":\n",
    "                    True,\n",
    "\n",
    "                \"false\":\n",
    "                    False,\n",
    "\n",
    "                \"1\":\n",
    "                    True,\n",
    "\n",
    "                \"0\":\n",
    "                    False,\n",
    "            }\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert mapped.notna().all()\n",
    "\n",
    "    return mapped.astype(\n",
    "        bool\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# D. VERIFY FROZEN UPSTREAM STATE\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    STEP25_LOCK_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as handle:\n",
    "\n",
    "    step25 = json.load(\n",
    "        handle\n",
    "    )\n",
    "\n",
    "\n",
    "with open(\n",
    "    RAW_AUDIT_LOCK_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as handle:\n",
    "\n",
    "    raw_lock = json.load(\n",
    "        handle\n",
    "    )\n",
    "\n",
    "\n",    "with open(\n",
    "    ROLE_LOCK_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as handle:\n",
    "\n",
    "    role_lock = json.load(\n",
    "        handle\n",
    "    )\n",
    "\n",
    "\n",
    "assert (\n",
    "    step25[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"AD_REPLICATION_DONOR_METADATA_AND_QC_FROZEN\"\n",
    ")\n",
    "\n",
    "\n",
    "assert int(\n",
    "    step25[\n",
    "        \"reproduced_post_QC_nuclei\"\n",
    "    ]\n",
    ") == 169506\n",
    "\n",
    "\n",
    "assert (\n",
    "    raw_lock[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"AD_REPLICATION_RAW_DATA_AUDIT_COMPLETE\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    role_lock[\n",
    "        \"primary_replication\"\n",
    "    ][\n",
    "        \"dataset\"\n",
    "    ]\n",
    "    ==\n",
    "    \"GSE157827\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    step25[\n",
    "        \"replication_DE_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    step25[\n",
    "        \"discovery_vs_replication_compared\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    step25[\n",
    "        \"AD_PD_convergence_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "QC_MANIFEST_PATH = Path(\n",
    "    step25[\n",
    "        \"nucleus_QC_manifest\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "FEATURE_METADATA_PATH = Path(\n",
    "    step25[\n",
    "        \"feature_table\"\n",
    "    ][\n",
    "        \"feature_metadata\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "DONOR_METADATA_PATH = Path(\n",
    "    step25[\n",
    "        \"donor_metadata_file\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "    QC_MANIFEST_PATH,\n",
    "    FEATURE_METADATA_PATH,\n",
    "    DONOR_METADATA_PATH,\n",
    "]:\n",
    "\n",
    "    assert path.exists(), path\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFrozen STEP-25 state: PASS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Diagnosis used in reconstruction so far: NO\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# E. INPUT TABLES\n",
    "# ============================================================\n",
    "\n",
    "sample_manifest = pd.read_csv(\n",
    "    SAMPLE_MANIFEST_PATH\n",
    ")\n",
    "\n",
    "\n",
    "feature_meta = pd.read_csv(\n",
    "    FEATURE_METADATA_PATH,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "qc = pd.read_csv(\n",
    "    QC_MANIFEST_PATH,\n",
    "    compression=\"gzip\",\n",
    "    usecols=[\n",
    "        \"donor_id\",\n",
    "        \"barcode\",\n",
    "        \"cell_uid\",\n",
    "        \"n_UMI\",\n",
    "        \"QC_pass\",\n",
    "    ],\n",
    ")\n",
    "\n",
    "\n",
    "qc[\n",
    "    \"QC_pass\"\n",
    "] = parse_bool(\n",
    "    qc[\n",
    "        \"QC_pass\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "qc_pass = (\n",
    "    qc[\n",
    "        qc[\n",
    "            \"QC_pass\"\n",
    "        ]\n",
    "    ]\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    sample_manifest\n",
    ") == 21\n",
    "\n",
    "\n",
    "assert len(\n",
    "    feature_meta\n",
    ") == 33538\n",
    "\n",
    "\n",
    "assert len(\n",
    "    qc_pass\n",
    ") == 169506\n",
    "\n",
    "\n",
    "assert (\n",
    "    feature_meta[\n",
    "        \"gene_id\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .is_unique\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    \"diagnosis_binary\"\n",
    "    not in\n",
    "    qc_pass.columns\n",
    ")\n",
    "\n",
    "\n",
    "N_RAW_FEATURES = int(\n",
    "    len(\n",
    "        feature_meta\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "gene_symbols = (\n",
    "    feature_meta[\n",
    "        \"gene_symbol\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .to_numpy()\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nQC-pass nuclei:\",\n",
    "    f\"{len(qc_pass):,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Raw features:\",\n",
    "    f\"{N_RAW_FEATURES:,}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# F. PREDECLARED SETTINGS\n",
    "# ============================================================\n",
    "\n",
    "MIN_CELLS_PER_CLUSTERING_GENE = 3\n",
    "\n",
    "N_HVG = 1000\n",
    "\n",
    "N_PCA = 50\n",
    "\n",
    "N_INTEGRATION_DIMS = 20\n",
    "\n",
    "N_NEIGHBORS = 20\n",
    "\n",
    "LEIDEN_RESOLUTION = 1.0\n",
    "\n",
    "\n",
    "HVG_SPAN_CANDIDATES = [\n",
    "    0.3,\n",
    "    0.5,\n",
    "    0.7,\n",
    "    1.0,\n",
    "]\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# G. PREDECLARED MARKERS\n",
    "#\n",
    "# Used only AFTER clustering in STEP26A2, but raw normalized\n",
    "# marker expression is calculated here so the large raw matrix\n",
    "# does not need to be rebuilt.\n",
    "# ============================================================\n",
    "\n",
    "BROAD_MARKERS = {\n",
    "    \"Astro\": [\n",
    "        \"SLC1A2\",\n",
    "        \"AQP4\",\n",
    "        \"GFAP\",\n",
    "        \"ADGRV1\",\n",
    "        \"GPC5\",\n",
    "        \"RYR3\",\n",
    "    ],\n",
    "\n",
    "    \"Endo\": [\n",
    "        \"CLDN5\",\n",
    "        \"FLT1\",\n",
    "        \"ABCB1\",\n",
    "        \"EBF1\",\n",
    "        \"VWF\",\n",
    "        \"PECAM1\",\n",
    "    ],\n",
    "\n",
    "    \"Excit\": [\n",
    "        \"SLC17A7\",\n",
    "        \"CAMK2A\",\n",
    "        \"NRGN\",\n",
    "        \"CBLN2\",\n",
    "        \"LDB2\",\n",
    "        \"KCNQ5\",\n",
    "    ],\n",
    "\n",
    "    \"Inhibit\": [\n",
    "        \"GAD1\",\n",
    "        \"GAD2\",\n",
    "        \"NXPH1\",\n",
    "        \"LHFPL3\",\n",
    "        \"GRIK1\",\n",
    "        \"ADARB2\",\n",
    "    ],\n",
    "\n",
    "    \"Micro\": [\n",
    "        \"CSF1R\",\n",
    "        \"CD74\",\n",
    "        \"C3\",\n",
    "        \"LRMDA\",\n",
    "        \"DOCK8\",\n",
    "        \"ARHGAP15\",\n",
    "        \"PLXDC2\",\n",
    "    ],\n",
    "\n",
    "    \"Oligo\": [\n",
    "        \"MBP\",\n",
    "        \"MOBP\",\n",
    "        \"PLP1\",\n",
    "        \"MOG\",\n",
    "        \"MAG\",\n",
    "        \"ST18\",\n",
    "        \"CTNNA3\",\n",
    "        \"PIP4K2A\",\n",
    "    ],\n",
    "}\n",
    "\n",
    "\n",
    "OPC_MARKERS = [\n",
    "    \"PDGFRA\",\n",
    "    \"VCAN\",\n",
    "    \"CSPG4\",\n",
    "    \"PTPRZ1\",\n",
    "    \"BCAN\",\n",
    "    \"TNR\",\n",
    "    \"OLIG1\",\n",
    "    \"OLIG2\",\n",
    "]\n",
    "\n",
    "\n",
    "OPC_CORE_MARKERS = [\n",
    "    \"PDGFRA\",\n",
    "    \"VCAN\",\n",
    "    \"CSPG4\",\n",
    "    \"PTPRZ1\",\n",
    "]\n",
    "\n",
    "\n",
    "MATURE_OLIGO_MARKERS = [\n",
    "    \"MBP\",\n",
    "    \"MOBP\",\n",
    "    \"PLP1\",\n",
    "    \"MOG\",\n",
    "    \"MAG\",\n",
    "    \"OPALIN\",\n",
    "    \"CLDN11\",\n",
    "    \"CNP\",\n",
    "    \"MAL\",\n",
    "]\n",
    "\n",
    "\n",
    "ALL_MARKERS = []\n",
    "\n",
    "\n",
    "for marker_list in BROAD_MARKERS.values():\n",
    "\n",
    "    ALL_MARKERS.extend(\n",
    "        marker_list\n",
    "    )\n",
    "\n",
    "\n",
    "ALL_MARKERS.extend(\n",
    "    OPC_MARKERS\n",
    ")\n",
    "\n",
    "ALL_MARKERS.extend(\n",
    "    MATURE_OLIGO_MARKERS\n",
    ")\n",
    "\n",
    "\n",
    "ALL_MARKERS = list(\n",
    "    dict.fromkeys(\n",
    "        ALL_MARKERS\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "symbol_to_rows = {}\n",
    "\n",
    "\n",
    "for feature_index, symbol in enumerate(\n",
    "    gene_symbols\n",
    "):\n",
    "\n",
    "    symbol_to_rows.setdefault(\n",
    "        symbol,\n",
    "        []\n",
    "    ).append(\n",
    "        feature_index\n",
    "    )\n",
    "\n",
    "\n",
    "marker_rows = {\n",
    "    marker:\n",
    "        symbol_to_rows.get(\n",
    "            marker,\n",
    "            []\n",
    "        )\n",
    "\n",
    "    for marker\n",
    "    in ALL_MARKERS\n",
    "}\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nMarker availability:\"\n",
    ")\n",
    "\n",
    "\n",
    "for cell_type, markers in BROAD_MARKERS.items():\n",
    "\n",
    "    present = [\n",
    "        marker\n",
    "\n",
    "        for marker\n",
    "        in markers\n",
    "\n",
    "        if len(\n",
    "            marker_rows[\n",
    "                marker\n",
    "            ]\n",
    "        ) > 0\n",
    "    ]\n",
    "\n",
    "\n",
    "    print(\n",
    "        cell_type,\n",
    "        len(\n",
    "            present\n",
    "        ),\n",
    "        \"/\",\n",
    "        len(\n",
    "            markers\n",
    "        ),\n",
    "        present,\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        present\n",
    "    ) >= 4\n",
    "\n",
    "\n",
    "present_OPC = [\n",
    "    marker\n",
    "\n",
    "    for marker\n",
    "    in OPC_MARKERS\n",
    "\n",
    "    if len(\n",
    "        marker_rows[\n",
    "            marker\n",
    "        ]\n",
    "    ) > 0\n",
    "]\n",
    "\n",
    "\n",
    "present_mature = [\n",
    "    marker\n",
    "\n",
    "    for marker\n",
    "    in MATURE_OLIGO_MARKERS\n",
    "\n",
    "    if len(\n",
    "        marker_rows[\n",
    "            marker\n",
    "        ]\n",
    "    ) > 0\n",
    "]\n",
    "\n",
    "\n",
    "assert len(\n",
    "    present_OPC\n",
    ") >= 5\n",
    "\n",
    "\n",
    "assert len(\n",
    "    present_mature\n",
    ") >= 6\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# H. QC-PASS COLUMN INDEX HELPER\n",
    "# ============================================================\n",
    "\n",
    "def sample_keep_indices(\n",
    "    donor_id,\n",
    "    barcode_path,\n",
    "):\n",
    "\n",
    "    raw_barcodes = (\n",
    "        pd.read_csv(\n",
    "            barcode_path,\n",
    "            sep=\"\\t\",\n",
    "            header=None,\n",
    "            compression=\"gzip\",\n",
    "            dtype=str,\n",
    "        )[\n",
    "            0\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    sample_qc = (\n",
    "        qc_pass[\n",
    "            qc_pass[\n",
    "                \"donor_id\"\n",
    "            ]\n",
    "            .astype(str)\n",
    "            ==\n",
    "            str(\n",
    "                donor_id\n",
    "            )\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    keep_barcodes = (\n",
    "        sample_qc[\n",
    "            \"barcode\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    lookup = {\n",
    "        barcode:\n",
    "            index\n",
    "\n",
    "        for index, barcode\n",
    "        in enumerate(\n",
    "            raw_barcodes\n",
    "        )\n",
    "    }\n",
    "\n",
    "\n",
    "    assert all(\n",
    "        barcode in lookup\n",
    "        for barcode\n",
    "        in keep_barcodes\n",
    "    )\n",
    "\n",
    "\n",
    "    keep_indices = np.asarray(\n",
    "        [\n",
    "            lookup[\n",
    "                barcode\n",
    "            ]\n",
    "\n",
    "            for barcode\n",
    "            in keep_barcodes\n",
    "        ],\n",
    "        dtype=np.int64,\n",
    "    )\n",
    "\n",
    "\n",
    "    assert np.all(\n",
    "        np.diff(\n",
    "            keep_indices\n",
    "        ) > 0\n",
    "    )\n",
    "\n",
    "\n",
    "    return (\n",
    "        raw_barcodes,\n",
    "        sample_qc,\n",
    "        keep_indices,\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# I. PASS 1 — DISEASE-BLIND GENE DETECTION\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PASS 1 — DISEASE-BLIND GENE DETECTION\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "gene_ncells = np.zeros(\n",
    "    N_RAW_FEATURES,\n",
    "    dtype=np.int64,\n",
    ")\n",
    "\n",
    "\n",
    "total_cells = 0\n",
    "\n",
    "\n",
    "for sample_index, row in sample_manifest.iterrows():\n",
    "\n",
    "    donor_id = str(\n",
    "        row[\n",
    "            \"sample_id\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    matrix_path = Path(\n",
    "        row[\n",
    "            \"matrix_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    barcode_path = Path(\n",
    "        row[\n",
    "            \"barcode_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    (\n",
    "        raw_barcodes,\n",
    "        sample_qc,\n",
    "        keep_indices,\n",
    "    ) = sample_keep_indices(\n",
    "        donor_id,\n",
    "        barcode_path,\n",
    "    )\n",
    "\n",
    "\n",
    "    with gzip.open(\n",
    "        matrix_path,\n",
    "        \"rb\",\n",
    "    ) as handle:\n",
    "\n",
    "        matrix = mmread(\n",
    "            handle\n",
    "        ).tocsc()\n",
    "\n",
    "\n",
    "    sample_matrix = (\n",
    "        matrix[\n",
    "            :,\n",
    "            keep_indices\n",
    "        ]\n",
    "        .T\n",
    "        .tocsr()\n",
    "    )\n",
    "\n",
    "\n",
    "    # CSR column indices are genes.\n",
    "    # Each cell/gene appears at most once in the 10x matrix,\n",
    "    # so bincount gives number of cells detecting each gene.\n",
    "    gene_ncells += np.bincount(\n",
    "        sample_matrix.indices,\n",
    "        minlength=\n",
    "            N_RAW_FEATURES,\n",
    "    )\n",
    "\n",
    "\n",
    "    total_cells += int(\n",
    "        sample_matrix.shape[\n",
    "            0\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        f\"[{sample_index + 1:02d}/21]\",\n",
    "        donor_id,\n",
    "        f\"{sample_matrix.shape[0]:,}\",\n",
    "    )\n",
    "\n",
    "\n",
    "    del matrix\n",
    "    del sample_matrix\n",
    "    del raw_barcodes\n",
    "    del sample_qc\n",
    "    del keep_indices\n",
    "\n",
    "    gc.collect()\n",
    "\n",
    "\n",
    "assert total_cells == 169506\n",
    "\n",
    "\n",
    "threshold_rows = []\n",
    "\n",
    "\n",
    "for threshold in [\n",
    "    1,\n",
    "    2,\n",
    "    3,\n",
    "    5,\n",
    "    10,\n",
    "    20,\n",
    "]:\n",
    "\n",
    "    retained = int(\n",
    "        (\n",
    "            gene_ncells\n",
    "            >=\n",
    "            threshold\n",
    "        ).sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    threshold_rows.append(\n",
    "        {\n",
    "            \"minimum_QC_pass_nuclei\":\n",
    "                threshold,\n",
    "\n",
    "            \"retained_genes\":\n",
    "                retained,\n",
    "\n",
    "            \"difference_from_author_reported_29171\":\n",
    "                retained\n",
    "                -\n",
    "                29171,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "gene_detection_audit = pd.DataFrame(\n",
    "    threshold_rows\n",
    ")\n",
    "\n",
    "\n",
    "gene_detection_audit.to_csv(\n",
    "    GENE_DETECTION_AUDIT_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "gene_keep = (\n",
    "    gene_ncells\n",
    "    >=\n",
    "    MIN_CELLS_PER_CLUSTERING_GENE\n",
    ")\n",
    "\n",
    "\n",
    "N_CLUSTERING_GENES = int(\n",
    "    gene_keep.sum()\n",
    ")\n",
    "\n",
    "\n",
    "assert N_CLUSTERING_GENES == 29583\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nGene-detection audit:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    gene_detection_audit.to_string(\n",
    "        index=False\n",
    "    )\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"\\nClustering genes:\",\n",
    "    N_CLUSTERING_GENES,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# J. MARKER FEATURE ROWS\n",
    "# ============================================================\n",
    "\n",
    "marker_feature_rows = sorted(\n",
    "    {\n",
    "        feature_index\n",
    "\n",
    "        for marker in ALL_MARKERS\n",
    "\n",
    "        for feature_index\n",
    "        in marker_rows[\n",
    "            marker\n",
    "        ]\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "marker_feature_local = {\n",
    "    feature_index:\n",
    "        local_index\n",
    "\n",
    "    for local_index, feature_index\n",
    "    in enumerate(\n",
    "        marker_feature_rows\n",
    "    )\n",
    "}\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# K. PASS 2 — BUILD QC-PASS RAW COUNT MATRIX\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PASS 2 — BUILD QC-PASS RAW COUNT MATRIX\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "X_parts = []\n",
    "\n",
    "obs_parts = []\n",
    "\n",
    "marker_parts = []\n",
    "\n",
    "\n",
    "for sample_index, row in sample_manifest.iterrows():\n",
    "\n",
    "    donor_id = str(\n",
    "        row[\n",
    "            \"sample_id\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    matrix_path = Path(\n",
    "        row[\n",
    "            \"matrix_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    barcode_path = Path(\n",
    "        row[\n",
    "            \"barcode_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    (\n",
    "        raw_barcodes,\n",
    "        sample_qc,\n",
    "        keep_indices,\n",
    "    ) = sample_keep_indices(\n",
    "        donor_id,\n",
    "        barcode_path,\n",
    "    )\n",
    "\n",
    "\n",
    "    with gzip.open(\n",
    "        matrix_path,\n",
    "        \"rb\",\n",
    "    ) as handle:\n",
    "\n",
    "        matrix = mmread(\n",
    "            handle\n",
    "        ).tocsc()\n",
    "\n",
    "\n",
    "    X_sample = (\n",
    "        matrix[\n",
    "            gene_keep,\n",
    "            :\n",
    "        ][\n",
    "            :,\n",
    "            keep_indices\n",
    "        ]\n",
    "        .T\n",
    "        .tocsr()\n",
    "        .astype(\n",
    "            np.float32\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    X_parts.append(\n",
    "        X_sample\n",
    "    )\n",
    "\n",
    "\n",
    "    sample_obs = (\n",
    "        sample_qc[\n",
    "            [\n",
    "                \"donor_id\",\n",
    "                \"barcode\",\n",
    "                \"cell_uid\",\n",
    "                \"n_UMI\",\n",
    "            ]\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    sample_obs[\n",
    "        \"sample_order\"\n",
    "    ] = sample_index\n",
    "\n",
    "\n",
    "    obs_parts.append(\n",
    "        sample_obs\n",
    "    )\n",
    "\n",
    "\n",
    "    # Raw marker counts from all 33,538 original rows.\n",
    "    marker_block = (\n",
    "        matrix[\n",
    "            marker_feature_rows,\n",
    "            :\n",
    "        ][\n",
    "            :,\n",
    "            keep_indices\n",
    "        ]\n",
    "        .tocsr()\n",
    "    )\n",
    "\n",
    "\n",
    "    total_UMI = (\n",
    "        sample_obs[\n",
    "            \"n_UMI\"\n",
    "        ]\n",
    "        .to_numpy(\n",
    "            dtype=np.float64\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    marker_array = np.zeros(\n",
    "        (\n",
    "            len(\n",
    "                sample_obs\n",
    "            ),\n",
    "            len(\n",
    "                ALL_MARKERS\n",
    "            ),\n",
    "        ),\n",
    "        dtype=np.float32,\n",
    "    )\n",
    "\n",
    "\n",
    "    for marker_index, marker in enumerate(\n",
    "        ALL_MARKERS\n",
    "    ):\n",
    "\n",
    "        original_rows = marker_rows[\n",
    "            marker\n",
    "        ]\n",
    "\n",
    "\n",
    "        if len(\n",
    "            original_rows\n",
    "        ) == 0:\n",
    "\n",
    "            continue\n",
    "\n",
    "\n",
    "        local_rows = [\n",
    "            marker_feature_local[\n",
    "                row_index\n",
    "            ]\n",
    "\n",
    "            for row_index\n",
    "            in original_rows\n",
    "        ]\n",
    "\n",
    "\n",
    "        raw_counts = np.asarray(\n",
    "            marker_block[\n",
    "                local_rows,\n",
    "                :\n",
    "            ]\n",
    "            .sum(\n",
    "                axis=0\n",
    "            )\n",
    "        ).ravel()\n",
    "\n",
    "\n",
    "        normalized = (\n",
    "            raw_counts\n",
    "            /\n",
    "            total_UMI\n",
    "            *\n",
    "            10000.0\n",
    "        )\n",
    "\n",
    "\n",
    "        marker_array[\n",
    "            :,\n",
    "            marker_index\n",
    "        ] = np.log1p(\n",
    "            normalized\n",
    "        ).astype(\n",
    "            np.float32\n",
    "        )\n",
    "\n",
    "\n",
    "    marker_parts.append(\n",
    "        marker_array\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        f\"[{sample_index + 1:02d}/21]\",\n",
    "        donor_id,\n",
    "        \"cells=\",\n",
    "        f\"{X_sample.shape[0]:,}\",\n",    "    )\n",
    "\n",
    "\n",
    "    del matrix\n",
    "    del marker_block\n",
    "    del marker_array\n",
    "    del raw_barcodes\n",
    "    del sample_qc\n",
    "    del keep_indices\n",
    "\n",
    "    gc.collect()\n",
    "\n",
    "\n",
    "X = sp.vstack(\n",
    "    X_parts,\n",
    "    format=\"csr\",\n",
    ")\n",
    "\n",
    "\n",
    "obs = pd.concat(\n",
    "    obs_parts,\n",
    "    axis=0,\n",
    "    ignore_index=True,\n",
    ")\n",
    "\n",
    "\n",
    "marker_expression = np.vstack(\n",
    "    marker_parts\n",
    ")\n",
    "\n",
    "\n",
    "del X_parts\n",
    "del obs_parts\n",
    "del marker_parts\n",
    "\n",
    "gc.collect()\n",
    "\n",
    "\n",
    "assert X.shape == (\n",
    "    169506,\n",
    "    29583,\n",
    ")\n",
    "\n",
    "\n",
    "assert marker_expression.shape == (\n",
    "    169506,\n",
    "    len(\n",
    "        ALL_MARKERS\n",
    "    ),\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    \"diagnosis_binary\"\n",
    "    not in\n",
    "    obs.columns\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nCombined raw matrix:\",\n",
    "    X.shape,\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Nonzero entries:\",\n",
    "    f\"{X.nnz:,}\",\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Diagnosis present in clustering metadata: NO\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# L. ANNDATA\n",
    "# ============================================================\n",
    "\n",
    "var = (\n",
    "    feature_meta.loc[\n",
    "        gene_keep,\n",
    "        [\n",
    "            \"gene_id\",\n",
    "            \"gene_symbol\",\n",
    "            \"feature_type\",\n",
    "        ]\n",
    "    ]\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "\n",
    "var[\n",
    "    \"gene_id\"\n",
    "] = (\n",
    "    var[\n",
    "        \"gene_id\"\n",
    "    ]\n",
    "    .astype(str)\n",
    ")\n",
    "\n",
    "\n",
    "assert var[\n",
    "    \"gene_id\"\n",
    "].is_unique\n",
    "\n",
    "\n",
    "obs_adata = (\n",
    "    obs\n",
    "    .set_index(\n",
    "        \"cell_uid\",\n",
    "        drop=False,\n",
    "    )\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "\n",
    "adata = ad.AnnData(\n",
    "    X=X,\n",
    "\n",
    "    obs=obs_adata,\n",
    "\n",
    "    var=var.set_index(\n",
    "        \"gene_id\",\n",
    "        drop=False,\n",
    "    ),\n",
    ")\n",
    "\n",
    "\n",
    "del X\n",
    "\n",
    "gc.collect()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# M. SEURAT-v3 HVG WITH PREDECLARED NUMERICAL FALLBACK\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"DISEASE-BLIND SEURAT-v3 HVG\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "HVG_RESULT = None\n",
    "\n",
    "HVG_SPAN_USED = None\n",
    "\n",
    "HVG_ATTEMPTS = []\n",
    "\n",
    "\n",
    "for span in HVG_SPAN_CANDIDATES:\n",
    "\n",
    "    print(\n",
    "        f\"\\nTrying LOESS span={span}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    try:\n",
    "\n",
    "        candidate = sc.pp.highly_variable_genes(\n",
    "            adata,\n",
    "\n",
    "            n_top_genes=\n",
    "                N_HVG,\n",
    "\n",
    "            flavor=\n",
    "                \"seurat_v3\",\n",
    "\n",
    "            batch_key=\n",
    "                \"donor_id\",\n",
    "\n",
    "            span=\n",
    "                span,\n",
    "\n",
    "            subset=\n",
    "                False,\n",
    "\n",
    "            check_values=\n",
    "                True,\n",
    "\n",
    "            inplace=\n",
    "                False,\n",
    "        )\n",
    "\n",
    "\n",
    "        assert int(\n",
    "            candidate[\n",
    "                \"highly_variable\"\n",
    "            ].sum()\n",
    "        ) == N_HVG\n",
    "\n",
    "\n",
    "        HVG_RESULT = candidate.copy()\n",
    "\n",
    "        HVG_SPAN_USED = float(\n",
    "            span\n",
    "        )\n",
    "\n",
    "\n",
    "        HVG_ATTEMPTS.append(\n",
    "            {\n",
    "                \"span\":\n",
    "                    float(\n",
    "                        span\n",
    "                    ),\n",
    "\n",
    "                \"status\":\n",
    "                    \"PASS\",\n",
    "\n",
    "                \"exception\":\n",
    "                    None,\n",
    "            }\n",
    "        )\n",
    "\n",
    "\n",
    "        print(\n",
    "            \"PASS\"\n",
    "        )\n",
    "\n",
    "        break\n",
    "\n",
    "\n",
    "    except ValueError as exc:\n",
    "\n",
    "        text = str(\n",
    "            exc\n",
    "        )\n",
    "\n",
    "        lower = text.lower()\n",
    "\n",
    "\n",
    "        numerical = (\n",
    "            \"singular\"\n",
    "            in lower\n",
    "\n",
    "            or\n",
    "\n",
    "            \"reciprocal condition number\"\n",
    "            in lower\n",
    "        )\n",
    "\n",
    "\n",
    "        HVG_ATTEMPTS.append(\n",
    "            {\n",
    "                \"span\":\n",
    "                    float(\n",
    "                        span\n",
    "                    ),\n",
    "\n",
    "                \"status\":\n",
    "                    (\n",
    "                        \"LOESS_NUMERICAL_FAILURE\"\n",
    "                        if numerical\n",
    "                        else\n",
    "                        \"UNEXPECTED_VALUE_ERROR\"\n",
    "                    ),\n",
    "\n",
    "                \"exception\":\n",
    "                    text,\n",
    "            }\n",
    "        )\n",
    "\n",
    "\n",
    "        print(\n",
    "            repr(\n",
    "                exc\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "        if not numerical:\n",
    "\n",
    "            raise\n",
    "\n",
    "\n",
    "assert HVG_RESULT is not None\n",
    "\n",
    "assert HVG_SPAN_USED is not None\n",
    "\n",
    "\n",
    "for column in HVG_RESULT.columns:\n",
    "\n",
    "    adata.var[\n",
    "        column\n",
    "    ] = (\n",
    "        HVG_RESULT[\n",
    "            column\n",
    "        ]\n",
    "        .to_numpy()\n",
    "    )\n",
    "\n",
    "\n",
    "assert int(\n",
    "    adata.var[\n",
    "        \"highly_variable\"\n",
    "    ].sum()\n",
    ") == 1000\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nHVG SELECTION: PASS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"LOESS span used:\",\n",
    "    HVG_SPAN_USED,\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Attempts:\",\n",
    "    HVG_ATTEMPTS,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# N. HVG EXPORT — R2 INDEX FIX INCLUDED\n",
    "# ============================================================\n",
    "\n",
    "hvg_table = (\n",
    "    adata.var.loc[\n",
    "        adata.var[\n",
    "            \"highly_variable\"\n",
    "        ],\n",
    "        [\n",
    "            \"gene_id\",\n",
    "            \"gene_symbol\",\n",
    "            \"highly_variable_rank\",\n",
    "            \"highly_variable_nbatches\",\n",
    "        ]\n",
    "    ]\n",
    "    .copy()\n",
    "\n",
    "    # Critical R2 bookkeeping fix.\n",
    "    .reset_index(\n",
    "        drop=True\n",
    "    )\n",
    "\n",
    "    .sort_values(\n",
    "        [\n",
    "            \"highly_variable_rank\",\n",
    "            \"gene_id\",\n",
    "        ],\n",
    "        ascending=[\n",
    "            True,\n",
    "            True,\n",
    "        ],\n",
    "        kind=\"mergesort\",\n",
    "    )\n",
    "    .reset_index(\n",
    "        drop=True\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    hvg_table\n",
    ") == 1000\n",
    "\n",
    "\n",
    "assert hvg_table[\n",
    "    \"gene_id\"\n",
    "].is_unique\n",
    "\n",
    "\n",
    "hvg_table.to_csv(\n",
    "    HVG_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"HVG export: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# O. NORMALIZE / LOG1P / HVG SUBSET\n",
    "#\n",
    "# Annotation only.\n",
    "# Raw integer counts are NOT replaced for later pseudobulk.\n",
    "# ============================================================\n",
    "\n",
    "sc.pp.normalize_total(\n",
    "    adata,\n",
    "    target_sum=1e4,\n",
    ")\n",
    "\n",
    "\n",
    "sc.pp.log1p(\n",
    "    adata\n",
    ")\n",
    "\n",
    "\n",
    "hvg_mask = (\n",
    "    adata.var[\n",
    "        \"highly_variable\"\n",
    "    ]\n",
    "    .to_numpy(\n",
    "        dtype=bool\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "adata_hvg = (\n",
    "    adata[\n",
    "        :,\n",
    "        hvg_mask\n",
    "    ]\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "\n",
    "del adata\n",
    "\n",
    "gc.collect()\n",
    "\n",
    "\n",
    "assert adata_hvg.shape == (\n",
    "    169506,\n",
    "    1000,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# P. SCALE + PCA50\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PCA50\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "sc.pp.scale(\n",
    "    adata_hvg,\n",
    "    zero_center=True,\n",
    "    max_value=10,\n",
    ")\n",
    "\n",
    "\n",
    "adata_hvg.X = np.asarray(\n",
    "    adata_hvg.X,\n",
    "    dtype=np.float32,\n",
    ")\n",
    "\n",
    "\n",
    "sc.tl.pca(\n",
    "    adata_hvg,\n",
    "\n",
    "    n_comps=\n",
    "        N_PCA,\n",
    "\n",
    "    svd_solver=\n",
    "        \"randomized\",\n",
    "\n",
    "    random_state=\n",
    "        SEED,\n",
    ")\n",
    "\n",
    "\n",
    "assert adata_hvg.obsm[\n",
    "    \"X_pca\"\n",
    "].shape == (\n",
    "    169506,\n",
    "    50,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"PCA: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# Q. DONOR-ONLY HARMONY\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"DONOR-ONLY HARMONY\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    \"diagnosis_binary\"\n",
    "    not in\n",
    "    adata_hvg.obs.columns\n",
    ")\n",
    "\n",
    "\n",
    "# harmonypy 2.0 returns corrected PCs in an orientation that changed\n",
    "# relative to the legacy Scanpy external wrapper. Call harmonypy\n",
    "# directly and verify orientation instead of silently transposing.\n",
    "pca_input = np.asarray(adata_hvg.obsm[\"X_pca\"], dtype=np.float64)\n",
    "assert pca_input.shape == (169506, 50)\n",
    "harmony_out = harmonypy.run_harmony(\n",
    "    pca_input,\n",
    "    adata_hvg.obs,\n",
    "    \"donor_id\",\n",
    "    max_iter_harmony=30,\n",
    "    random_state=0,\n",
    ")\n",
    "Z = np.asarray(harmony_out.Z_corr, dtype=np.float64)\n",
    "if Z.shape == (169506, 50):\n",
    "    harmony_corrected = Z\n",
    "    harmony_orientation = \"cells_by_pcs_direct\"\n",
    "elif Z.shape == (50, 169506):\n",
    "    harmony_corrected = Z.T\n",
    "    harmony_orientation = \"pcs_by_cells_transposed_after_shape_check\"\n",
    "else:\n",
    "    raise RuntimeError(f\"Unexpected Harmony Z_corr shape: {Z.shape}\")\n",
    "adata_hvg.obsm[\"X_pca_harmony\"] = harmony_corrected\n",
    "adata_hvg.obsm[\"X_harmony20\"] = harmony_corrected[:, :N_INTEGRATION_DIMS].astype(np.float32)\n",
    "print(\"Harmony Z_corr orientation:\", harmony_orientation)\n",
    "\n",
    "\n",
    "assert adata_hvg.obsm[\n",
    "    \"X_harmony20\"\n",
    "].shape == (\n",
    "    169506,\n",
    "    20,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Harmony: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# R. NEIGHBORS + LEIDEN\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"DISEASE-BLIND LEIDEN CLUSTERING\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "sc.pp.neighbors(\n",
    "    adata_hvg,\n",
    "\n",
    "    n_neighbors=\n",
    "        N_NEIGHBORS,\n",
    "\n",
    "    use_rep=\n",
    "        \"X_harmony20\",\n",
    "\n",
    "    metric=\n",
    "        \"euclidean\",\n",
    "\n",
    "    random_state=\n",
    "        SEED,\n",
    ")\n",
    "\n",
    "\n",
    "sc.tl.leiden(\n",
    "    adata_hvg,\n",
    "\n",
    "    resolution=\n",
    "        LEIDEN_RESOLUTION,\n",
    "\n",
    "    random_state=\n",
    "        SEED,\n",
    "\n",
    "    key_added=\n",
    "        \"cluster\",\n",
    "\n",
    "    flavor=\n",
    "        \"igraph\",\n",
    "\n",
    "    n_iterations=\n",
    "        2,\n",
    "\n",
    "    directed=\n",
    "        False,\n",
    ")\n",
    "\n",
    "\n",
    "clusters = (\n",
    "    adata_hvg.obs[\n",
    "        \"cluster\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .to_numpy()\n",
    ")\n",
    "\n",
    "\n",
    "n_clusters = int(\n",
    "    len(\n",
    "        np.unique(\n",
    "            clusters\n",
    "        )\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Clusters:\",\n",
    "    n_clusters,\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Original Lau initial clustering reference: 43\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# S. SAVE COMPUTATIONAL CHECKPOINT\n",
    "# ============================================================\n",
    "\n",
    "obs_checkpoint = (\n",
    "    obs[\n",
    "        [\n",
    "            \"donor_id\",\n",
    "            \"barcode\",\n",
    "            \"cell_uid\",\n",
    "            \"n_UMI\",\n",
    "            \"sample_order\",\n",
    "        ]\n",
    "    ]\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "\n",
    "obs_checkpoint[\n",
    "    \"cluster\"\n",
    "] = clusters\n",
    "\n",
    "\n",
    "assert len(\n",
    "    obs_checkpoint\n",
    ") == 169506\n",
    "\n",
    "\n",
    "assert obs_checkpoint[\n",
    "    \"cell_uid\"\n",
    "].is_unique\n",
    "\n",
    "\n",
    "assert (\n",
    "    \"diagnosis_binary\"\n",
    "    not in\n",
    "    obs_checkpoint.columns\n",
    ")\n",
    "\n",
    "\n",
    "obs_checkpoint.to_csv(\n",
    "    OBS_CLUSTER_PATH,\n",
    "\n",
    "    index=False,\n",
    "\n",
    "    compression={\n",
    "        \"method\":\n",
    "            \"gzip\",\n",
    "\n",
    "        \"compresslevel\":\n",
    "            6,\n",
    "    },\n",
    ")\n",
    "\n",
    "\n",
    "np.save(\n",
    "    MARKER_EXPRESSION_PATH,\n",
    "    marker_expression,\n",
    "    allow_pickle=False,\n",
    ")\n",
    "\n",
    "\n",
    "with open(\n",
    "    MARKER_NAMES_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as handle:\n",
    "\n",
    "    json.dump(\n",
    "        {\n",
    "            \"markers\":\n",
    "                ALL_MARKERS,\n",
    "\n",
    "            \"broad_markers\":\n",
    "                BROAD_MARKERS,\n",
    "\n",
    "            \"OPC_markers\":\n",
    "                OPC_MARKERS,\n",
    "\n",
    "            \"OPC_core_markers\":\n",
    "                OPC_CORE_MARKERS,\n",
    "\n",
    "            \"mature_oligo_markers\":\n",
    "                MATURE_OLIGO_MARKERS,\n",
    "        },\n",
    "        handle,\n",
    "        indent=2,\n",
    "    )\n",
    "\n",
    "\n",
    "np.save(\n",
    "    HARMONY20_PATH,\n",
    "    adata_hvg.obsm[\n",
    "        \"X_harmony20\"\n",
    "    ].astype(\n",
    "        np.float32\n",
    "    ),\n",
    "    allow_pickle=False,\n",
    ")\n",
    "\n",
    "\n",
    "cluster_summary = (\n",
    "    obs_checkpoint[\n",
    "        \"cluster\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .rename_axis(\n",
    "        \"cluster\"\n",
    "    )\n",
    "    .rename(\n",
    "        \"n_nuclei\"\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "\n",
    "cluster_summary.to_csv(\n",
    "    CLUSTER_SUMMARY_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# T. HASH OUTPUTS\n",
    "# ============================================================\n",
    "\n",
    "OUTPUT_HASHES = {\n",
    "    \"gene_detection_audit\":\n",
    "        sha256_file(\n",
    "            GENE_DETECTION_AUDIT_PATH\n",
    "        ),\n",
    "\n",
    "    \"HVG\":\n",
    "        sha256_file(\n",
    "            HVG_PATH\n",
    "        ),\n",
    "\n",
    "    \"obs_cluster_assignments\":\n",
    "        sha256_file(\n",
    "            OBS_CLUSTER_PATH\n",
    "        ),\n",
    "\n",
    "    \"marker_expression\":\n",
    "        sha256_file(\n",
    "            MARKER_EXPRESSION_PATH\n",
    "        ),\n",
    "\n",
    "    \"marker_names\":\n",
    "        sha256_file(\n",
    "            MARKER_NAMES_PATH\n",
    "        ),\n",
    "\n",
    "    \"harmony20\":\n",
    "        sha256_file(\n",
    "            HARMONY20_PATH\n",
    "        ),\n",
    "\n",
    "    \"cluster_summary\":\n",
    "        sha256_file(\n",
    "            CLUSTER_SUMMARY_PATH\n",
    "        ),\n",
    "}\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# U. COMPUTE CHECKPOINT LOCK\n",
    "# ============================================================\n",
    "\n",
    "LOCK = {\n",
    "    \"dataset\":\n",
    "        \"GSE157827\",\n",
    "\n",
    "    \"created_utc\":\n",
    "        datetime.now(\n",
    "            timezone.utc\n",
    "        ).isoformat(),\n",
    "\n",
    "    \"status\":\n",
    "        \"AD_REPLICATION_STEP26A1_DISEASE_BLIND_CLUSTERING_COMPLETE\",\n",
    "\n",
    "    \"role\":\n",
    "        \"primary_AD_brain_replication\",\n",
    "\n",
    "    \"random_seed\":\n",
    "        SEED,\n",
    "\n",
    "    \"environment\":\n",
    "        ENVIRONMENT,\n",
    "\n",
    "    \"input_QC_pass_nuclei\":\n",
    "        169506,\n",
    "\n",
    "    \"diagnosis_used_in_gene_filter\":\n",
    "        False,\n",
    "\n",
    "    \"diagnosis_used_in_HVG_selection\":\n",
    "        False,\n",
    "\n",
    "    \"diagnosis_used_in_PCA\":\n",
    "        False,\n",
    "\n",
    "    \"diagnosis_used_in_integration\":\n",
    "        False,\n",
    "\n",
    "    \"diagnosis_used_in_clustering\":\n",
    "        False,\n",
    "\n",
    "    \"author_celltype_proportions_inspected\":\n",
    "        False,\n",
    "\n",
    "    \"celltype_annotation_performed\":\n",
    "        False,\n",
    "\n",
    "    \"OPC_Oligo_split_performed\":\n",
    "        False,\n",
    "\n",
    "    \"clustering_feature_rule\": {\n",
    "        \"minimum_QC_pass_nuclei\":\n",
    "            MIN_CELLS_PER_CLUSTERING_GENE,\n",
    "\n",
    "        \"n_retained_features\":\n",
    "            N_CLUSTERING_GENES,\n",
    "\n",
    "        \"used_for_DE_gene_universe\":\n",
    "            False,\n",
    "    },\n",
    "\n",
    "    \"embedding\": {\n",
    "        \"HVG_method\":\n",
    "            \"scanpy_seurat_v3_batch_key_donor\",\n",
    "\n",
    "        \"n_HVG\":\n",
    "            N_HVG,\n",
    "\n",
    "        \"HVG_LOESS_span_candidates\":\n",
    "            HVG_SPAN_CANDIDATES,\n",
    "\n",
    "        \"HVG_LOESS_span_used\":\n",
    "            HVG_SPAN_USED,\n",
    "\n",
    "        \"HVG_LOESS_attempt_records\":\n",
    "            HVG_ATTEMPTS,\n",
    "\n",
    "        \"HVG_method_changed_after_failure\":\n",
    "            False,\n",
    "\n",
    "        \"HVG_batch_key_changed_after_failure\":\n",
    "            False,\n",
    "\n",
    "        \"HVG_output_table_index_reset_recovery\":\n",
    "            True,\n",
    "\n",
    "        \"HVG_output_table_index_reset_changes_HVG_selection\":\n",
    "            False,\n",
    "\n",
    "        \"normalization\":\n",
    "            \"library_size_10000_then_log1p\",\n",
    "\n",
    "        \"n_PCA\":\n",
    "            N_PCA,\n",
    "\n",
    "        \"integration\":\n",
    "            \"Harmony\",\n",
    "\n",
    "        \"integration_key\":\n",
    "            \"donor_id\",\n",
    "\n",
    "        \"n_integration_dimensions\":\n",
    "            N_INTEGRATION_DIMS,\n",
    "\n",
    "        \"n_neighbors\":\n",
    "            N_NEIGHBORS,\n",
    "\n",
    "        \"Leiden_resolution\":\n",
    "            LEIDEN_RESOLUTION,\n",
    "\n",
    "        \"n_clusters\":\n",
    "            n_clusters,\n",
    "    },\n",
    "\n",
    "    \"outputs\": {\n",
    "        \"gene_detection_audit\":\n",
    "            str(\n",
    "                GENE_DETECTION_AUDIT_PATH\n",
    "            ),\n",
    "\n",
    "        \"HVG\":\n",
    "            str(\n",
    "                HVG_PATH\n",
    "            ),\n",
    "\n",
    "        \"obs_cluster_assignments\":\n",
    "            str(\n",
    "                OBS_CLUSTER_PATH\n",
    "            ),\n",
    "\n",
    "        \"marker_expression\":\n",
    "            str(\n",
    "                MARKER_EXPRESSION_PATH\n",
    "            ),\n",
    "\n",
    "        \"marker_names\":\n",
    "            str(\n",
    "                MARKER_NAMES_PATH\n",
    "            ),\n",
    "\n",
    "        \"harmony20\":\n",
    "            str(\n",
    "                HARMONY20_PATH\n",
    "            ),\n",
    "\n",
    "        \"cluster_summary\":\n",
    "            str(\n",
    "                CLUSTER_SUMMARY_PATH\n",
    "            ),\n",
    "    },\n",
    "\n",
    "    \"output_sha256\":\n",
    "        OUTPUT_HASHES,\n",
    "\n",
    "    \"pseudobulk_built\":\n",
    "        False,\n",
    "\n",
    "    \"replication_DE_performed\":\n",
    "        False,\n",
    "\n",
    "    \"discovery_vs_replication_compared\":\n",
    "        False,\n",
    "\n",
    "    \"AD_PD_convergence_performed\":\n",
    "        False,\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    STEP26A1_LOCK_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as handle:\n",
    "\n",
    "    json.dump(\n",
    "        LOCK,\n",
    "        handle,\n",
    "        indent=2,\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# V. FINAL VERIFY\n",
    "# ============================================================\n",
    "\n",
    "saved_obs = pd.read_csv(\n",
    "    OBS_CLUSTER_PATH,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",    "saved_marker = np.load(\n",
    "    MARKER_EXPRESSION_PATH,\n",
    "    mmap_mode=\"r\",\n",
    "    allow_pickle=False,\n",
    ")\n",
    "\n",
    "\n",
    "saved_harmony = np.load(\n",
    "    HARMONY20_PATH,\n",
    "    mmap_mode=\"r\",\n",
    "    allow_pickle=False,\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    saved_obs\n",
    ") == 169506\n",
    "\n",
    "\n",
    "assert saved_marker.shape == (\n",
    "    169506,\n",
    "    len(\n",
    "        ALL_MARKERS\n",
    "    ),\n",
    ")\n",
    "\n",
    "\n",
    "assert saved_harmony.shape == (\n",
    "    169506,\n",
    "    20,\n",
    ")\n",
    "\n",
    "\n",
    "assert int(\n",
    "    saved_obs[\n",
    "        \"cluster\"\n",
    "    ].nunique()\n",
    ") == n_clusters\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 26A1 PASS — DISEASE-BLIND CLUSTERING CHECKPOINT FROZEN\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nQC-pass nuclei:\",\n",
    "    f\"{169506:,}\",\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Clustering genes:\",\n",
    "    f\"{N_CLUSTERING_GENES:,}\",\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"HVGs:\",\n",
    "    N_HVG,\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"LOESS span used:\",\n",
    "    HVG_SPAN_USED,\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PCA dimensions:\",\n",
    "    N_PCA,\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Harmony dimensions used:\",\n",
    "    N_INTEGRATION_DIMS,\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Neighbors:\",\n",
    "    N_NEIGHBORS,\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Leiden resolution:\",\n",
    "    LEIDEN_RESOLUTION,\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Clusters:\",\n",
    "    n_clusters,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nCluster sizes:\"\n",
    ")\n",
    "\n",
    "print(\n",
