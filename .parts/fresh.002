  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 40\n",
    "# ============================================================\n",
    "# STEP 21A — GSE174367 PRIMARY AD DISCOVERY DE AUDIT\n",
    "#\n",
    "# NO NEW DIFFERENTIAL EXPRESSION.\n",
    "# NO RIN SENSITIVITY.\n",
    "# NO PMI SENSITIVITY.\n",
    "# NO AD REPLICATION.\n",
    "# NO AD↔PD CONVERGENCE.\n",
    "#\n",
    "# PURPOSE\n",
    "# -------\n",
    "# 1. Verify STEP-21 DE + effect-freeze locks.\n",
    "# 2. Verify every all-gene result hash.\n",
    "# 3. Verify every frozen effect-vector hash.\n",
    "# 4. Verify exact STEP-20 gene universes.\n",
    "# 5. Recalculate:\n",
    "#       finite LFC\n",
    "#       finite Wald\n",
    "#       finite p\n",
    "#       finite padj\n",
    "#       FDR < 0.05\n",
    "#       up/down counts\n",
    "# 6. Confirm STEP-21 summary exactly.\n",
    "# 7. Confirm frozen effect vectors equal source DE.\n",
    "# 8. Reveal strongest PRIMARY AD results only AFTER freeze.\n",
    "# 9. Save an immutable primary-AD audit lock.\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import hashlib\n",
    "import json\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = ROOT / \"locks\"\n",
    "\n",
    "DE_ROOT = (\n",
    "    ROOT /\n",
    "    \"AD_discovery_DE\"\n",
    ")\n",
    "\n",
    "FREEZE_ROOT = (\n",
    "    ROOT /\n",
    "    \"AD_discovery_frozen\"\n",
    ")\n",
    "\n",
    "\n",
    "PRE_DE_LOCK_PATH = (\n",
    "    LOCKS /\n",
    "    \"GSE174367_AD_DISCOVERY_PRE_DE_LOCK_v1.json\"\n",
    ")\n",
    "\n",
    "DE_RUN_LOCK_PATH = (\n",
    "    LOCKS /\n",
    "    \"GSE174367_PRIMARY_AD_DISCOVERY_DE_RUN_v1.json\"\n",
    ")\n",
    "\n",
    "EFFECT_FREEZE_LOCK_PATH = (\n",
    "    LOCKS /\n",
    "    \"GSE174367_AD_DISCOVERY_EFFECT_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "SUMMARY_PATH = (\n",
    "    DE_ROOT /\n",
    "    \"GSE174367_PRIMARY_AD_DISCOVERY_DE_SUMMARY_v1.csv\"\n",
    ")\n",
    "\n",
    "AUDIT_OUTPUT_PATH = (\n",
    "    DE_ROOT /\n",
    "    \"GSE174367_PRIMARY_AD_DISCOVERY_DE_AUDIT_v1.csv\"\n",
    ")\n",
    "\n",
    "AUDIT_LOCK_PATH = (\n",
    "    LOCKS /\n",
    "    \"GSE174367_PRIMARY_AD_DISCOVERY_DE_AUDIT_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "\n",
    "    PRE_DE_LOCK_PATH,\n",
    "    DE_RUN_LOCK_PATH,\n",
    "    EFFECT_FREEZE_LOCK_PATH,\n",
    "    SUMMARY_PATH,\n",
    "\n",
    "]:\n",
    "\n",
    "    assert path.exists(), (\n",
    "        f\"Missing required file: {path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. LOAD LOCKS\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    PRE_DE_LOCK_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    pre_de_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    DE_RUN_LOCK_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    de_run_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    EFFECT_FREEZE_LOCK_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    effect_freeze = json.load(f)\n",
    "\n",
    "\n",
    "summary = pd.read_csv(\n",
    "    SUMMARY_PATH\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. LOCK INTEGRITY\n",
    "# ============================================================\n",
    "\n",
    "assert (\n",
    "    pre_de_lock[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"AD_DISCOVERY_PRE_DE_LOCK\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    de_run_lock[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"PRIMARY_AD_DISCOVERY_DE_COMPLETE\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    effect_freeze[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"AD_DISCOVERY_EFFECTS_FROZEN\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    de_run_lock[\n",
    "        \"gene_universes_refiltered\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    de_run_lock[\n",
    "        \"donors_changed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    de_run_lock[\n",
    "        \"RIN_sensitivity_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    de_run_lock[\n",
    "        \"PMI_sensitivity_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    de_run_lock[\n",
    "        \"AD_replication_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    de_run_lock[\n",
    "        \"AD_PD_convergence_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    effect_freeze[\n",
    "        \"effects_frozen_before_RIN_sensitivity\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    effect_freeze[\n",
    "        \"effects_frozen_before_PMI_sensitivity\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    effect_freeze[\n",
    "        \"effects_frozen_before_AD_replication\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    effect_freeze[\n",
    "        \"effects_frozen_before_AD_PD_convergence\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 21 LOCK INTEGRITY: PASS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. EXPECTED CLASSES + STEP-21 COUNTS\n",
    "# ============================================================\n",
    "\n",
    "PRIMARY_CLASSES = [\n",
    "\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "EXPECTED_UNIVERSES = {\n",
    "\n",
    "    \"Astro\":\n",
    "        17289,\n",
    "\n",
    "    \"Micro\":\n",
    "        17222,\n",
    "\n",
    "    \"OPC\":\n",
    "        16641,\n",
    "\n",
    "    \"Oligo\":\n",
    "        15769,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "EXPECTED_FDR = {\n",
    "\n",
    "    \"Astro\":\n",
    "        1,\n",
    "\n",
    "    \"Micro\":\n",
    "        3,\n",
    "\n",
    "    \"OPC\":\n",
    "        0,\n",
    "\n",
    "    \"Oligo\":\n",
    "        30,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "EXPECTED_UP = {\n",
    "\n",
    "    \"Astro\":\n",
    "        0,\n",
    "\n",
    "    \"Micro\":\n",
    "        3,\n",
    "\n",
    "    \"OPC\":\n",
    "        0,\n",
    "\n",
    "    \"Oligo\":\n",
    "        24,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "EXPECTED_DOWN = {\n",
    "\n",
    "    \"Astro\":\n",
    "        1,\n",
    "\n",
    "    \"Micro\":\n",
    "        0,\n",
    "\n",
    "    \"OPC\":\n",
    "        0,\n",
    "\n",
    "    \"Oligo\":\n",
    "        6,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "assert (\n",
    "    summary[\n",
    "        \"cell_type\"\n",
    "    ].tolist()\n",
    "    ==\n",
    "    PRIMARY_CLASSES\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. HELPERS\n",
    "# ============================================================\n",
    "\n",
    "def sha256_file(\n",
    "    path,\n",
    "    block_size=1024 * 1024\n",
    "):\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\"\n",
    "    ) as f:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            block = f.read(\n",
    "                block_size\n",
    "            )\n",
    "\n",
    "\n",
    "            if not block:\n",
    "\n",
    "                break\n",
    "\n",
    "\n",
    "            h.update(\n",
    "                block\n",
    "            )\n",
    "\n",
    "\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "def ordered_gene_hash(\n",
    "    genes\n",
    "):\n",
    "\n",
    "    payload = (\n",
    "\n",
    "        \"\\n\".join(\n",
    "            map(\n",
    "                str,\n",
    "                genes\n",
    "            )\n",
    "        )\n",
    "\n",
    "        +\n",
    "\n",
    "        \"\\n\"\n",
    "\n",
    "    ).encode(\n",
    "        \"utf-8\"\n",
    "    )\n",
    "\n",
    "\n",
    "    return hashlib.sha256(\n",
    "        payload\n",
    "    ).hexdigest()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. STORAGE\n",
    "# ============================================================\n",
    "\n",
    "audit_rows = []\n",
    "\n",
    "top_tables = {}\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. AUDIT EACH CELL CLASS\n",
    "# ============================================================\n",
    "\n",
    "for cell_type in PRIMARY_CLASSES:\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\n\"\n",
    "        +\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        cell_type\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.1 LOCK RECORDS\n",
    "    # ========================================================\n",
    "\n",
    "    de_record = (\n",
    "\n",
    "        de_run_lock[\n",
    "            \"cell_class_results\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    freeze_record = (\n",
    "\n",
    "        effect_freeze[\n",
    "            \"cell_class_effect_vectors\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    universe_record = (\n",
    "\n",
    "        pre_de_lock[\n",
    "            \"cell_class_gene_universes\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.2 PATHS\n",
    "    # ========================================================\n",
    "\n",
    "    result_path = Path(\n",
    "        de_record[\n",
    "            \"all_gene_results\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    effect_path = Path(\n",
    "        freeze_record[\n",
    "            \"effect_vector_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    universe_path = Path(\n",
    "        universe_record[\n",
    "            \"gene_universe_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    for path in [\n",
    "\n",
    "        result_path,\n",
    "        effect_path,\n",
    "        universe_path,\n",
    "\n",
    "    ]:\n",
    "\n",
    "        assert path.exists(), (\n",
    "            f\"Missing file: {path}\"\n",
    "        )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.3 HASH VERIFICATION\n",
    "    # ========================================================\n",
    "\n",
    "    observed_result_hash = (\n",
    "        sha256_file(\n",
    "            result_path\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        observed_result_hash\n",
    "        ==\n",
    "        de_record[\n",
    "            \"all_gene_results_sha256\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    observed_effect_hash = (\n",
    "        sha256_file(\n",
    "            effect_path\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        observed_effect_hash\n",
    "        ==\n",
    "        freeze_record[\n",
    "            \"effect_vector_file_sha256\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Result file SHA256: PASS\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Frozen effect SHA256: PASS\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.4 LOAD TABLES\n",
    "    # ========================================================\n",
    "\n",
    "    result = pd.read_csv(\n",
    "        result_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    universe = pd.read_csv(\n",
    "        universe_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    frozen_effect = pd.read_csv(\n",
    "        effect_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    expected_n = (\n",
    "        EXPECTED_UNIVERSES[\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        result\n",
    "    ) == expected_n\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        universe\n",
    "    ) == expected_n\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        frozen_effect\n",
    "    ) == expected_n\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.5 EXACT GENE-UNIVERSE IDENTITY\n",
    "    # ========================================================\n",
    "\n",
    "    result_gene_ids = (\n",
    "\n",
    "        result[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    universe_gene_ids = (\n",
    "\n",
    "        universe[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    effect_gene_ids = (\n",
    "\n",
    "        frozen_effect[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        result_gene_ids\n",
    "        ==\n",
    "        universe_gene_ids\n",
    "        ==\n",
    "        effect_gene_ids\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        result_gene_ids\n",
    "    ) == len(\n",
    "        set(\n",
    "            result_gene_ids\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    observed_universe_hash = (\n",
    "        ordered_gene_hash(\n",
    "            result_gene_ids\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        observed_universe_hash\n",
    "        ==\n",
    "        universe_record[\n",
    "            \"ordered_gene_id_sha256\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Exact frozen gene universe: PASS\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.6 FROZEN EFFECT-VECTOR IDENTITY\n",
    "    # ========================================================\n",
    "\n",
    "    assert np.allclose(\n",
    "\n",
    "        result[\n",
    "            \"log2FoldChange\"\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        ),\n",
    "\n",
    "        frozen_effect[\n",
    "            \"AD_vs_Control_log2FC\"\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        ),\n",
    "\n",
    "        equal_nan=True\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert np.allclose(\n",
    "\n",
    "        result[\n",
    "            \"stat\"\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        ),\n",
    "\n",
    "        frozen_effect[\n",
    "            \"AD_vs_Control_Wald\"\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        ),\n",
    "\n",
    "        equal_nan=True\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert np.allclose(\n",
    "\n",
    "        result[\n",
    "            \"pvalue\"\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        ),\n",
    "\n",
    "        frozen_effect[\n",
    "            \"AD_vs_Control_pvalue\"\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        ),\n",
    "\n",
    "        equal_nan=True\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert np.allclose(\n",
    "\n",
    "        result[\n",
    "            \"padj\"\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        ),\n",
    "\n",
    "        frozen_effect[\n",
    "            \"AD_vs_Control_padj\"\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        ),\n",
    "\n",
    "        equal_nan=True\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Frozen effect-vector identity: PASS\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.7 FINITE-VALUE AUDIT\n",
    "    # ========================================================\n",
    "\n",
    "    finite_lfc = np.isfinite(\n",
    "        result[\n",
    "            \"log2FoldChange\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    finite_stat = np.isfinite(\n",
    "        result[\n",
    "            \"stat\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    finite_p = np.isfinite(\n",
    "        result[\n",
    "            \"pvalue\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    finite_padj = np.isfinite(\n",
    "        result[\n",
    "            \"padj\"\n",
    "        ]\n",
    "    )\n",    "\n",
    "\n",
    "    n_finite_lfc = int(\n",
    "        finite_lfc.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_finite_stat = int(\n",
    "        finite_stat.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_finite_p = int(\n",
    "        finite_p.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_finite_padj = int(\n",
    "        finite_padj.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert n_finite_lfc == expected_n\n",
    "    assert n_finite_stat == expected_n\n",
    "    assert n_finite_p == expected_n\n",
    "    assert n_finite_padj == expected_n\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.8 FDR RECALCULATION\n",
    "    # ========================================================\n",
    "\n",
    "    sig_mask = (\n",
    "\n",
    "        finite_padj\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            result[\n",
    "                \"padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    sig = (\n",
    "        result.loc[\n",
    "            sig_mask\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_sig = int(\n",
    "        sig_mask.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_up = int(\n",
    "\n",
    "        (\n",
    "            sig[\n",
    "                \"log2FoldChange\"\n",
    "            ]\n",
    "            >\n",
    "            0\n",
    "        ).sum()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_down = int(\n",
    "\n",
    "        (\n",
    "            sig[\n",
    "                \"log2FoldChange\"\n",
    "            ]\n",
    "            <\n",
    "            0\n",
    "        ).sum()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_zero = int(\n",
    "\n",
    "        (\n",
    "            sig[\n",
    "                \"log2FoldChange\"\n",
    "            ]\n",
    "            ==\n",
    "            0\n",
    "        ).sum()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.9 VERIFY STEP-21 LOCK COUNTS\n",
    "    # ========================================================\n",
    "\n",
    "    assert (\n",
    "        n_finite_lfc\n",
    "        ==\n",
    "        de_record[\n",
    "            \"n_finite_log2FoldChange\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_finite_stat\n",
    "        ==\n",
    "        de_record[\n",
    "            \"n_finite_Wald\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_finite_p\n",
    "        ==\n",
    "        de_record[\n",
    "            \"n_finite_pvalue\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_finite_padj\n",
    "        ==\n",
    "        de_record[\n",
    "            \"n_finite_padj\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_sig\n",
    "        ==\n",
    "        de_record[\n",
    "            \"n_FDR_lt_0_05\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_up\n",
    "        ==\n",
    "        de_record[\n",
    "            \"n_FDR_lt_0_05_up_in_AD\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_down\n",
    "        ==\n",
    "        de_record[\n",
    "            \"n_FDR_lt_0_05_down_in_AD\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.10 VERIFY NOTEBOOK SUMMARY\n",
    "    # ========================================================\n",
    "\n",
    "    summary_row = (\n",
    "\n",
    "        summary[\n",
    "            summary[\n",
    "                \"cell_type\"\n",
    "            ]\n",
    "            ==\n",
    "            cell_type\n",
    "        ]\n",
    "        .iloc[\n",
    "            0\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        summary_row[\n",
    "            \"tested_genes\"\n",
    "        ]\n",
    "    ) == expected_n\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        summary_row[\n",
    "            \"finite_pvalue\"\n",
    "        ]\n",
    "    ) == n_finite_p\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        summary_row[\n",
    "            \"finite_padj\"\n",
    "        ]\n",
    "    ) == n_finite_padj\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        summary_row[\n",
    "            \"FDR_lt_0.05\"\n",
    "        ]\n",
    "    ) == n_sig\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        summary_row[\n",
    "            \"up_in_AD\"\n",
    "        ]\n",
    "    ) == n_up\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        summary_row[\n",
    "            \"down_in_AD\"\n",
    "        ]\n",
    "    ) == n_down\n",
    "\n",
    "\n",
    "    # Hard verification of pasted STEP-21 result.\n",
    "    assert n_sig == EXPECTED_FDR[\n",
    "        cell_type\n",
    "    ]\n",
    "\n",
    "\n",
    "    assert n_up == EXPECTED_UP[\n",
    "        cell_type\n",
    "    ]\n",
    "\n",
    "\n",
    "    assert n_down == EXPECTED_DOWN[\n",
    "        cell_type\n",
    "    ]\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"STEP-21 aggregate counts: PASS\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.11 MINIMUM P / PADJ\n",
    "    # ========================================================\n",
    "\n",
    "    min_p = float(\n",
    "        result[\n",
    "            \"pvalue\"\n",
    "        ].min()\n",
    "    )\n",
    "\n",
    "\n",
    "    min_padj = float(\n",
    "        result[\n",
    "            \"padj\"\n",
    "        ].min()\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.12 PRIMARY AD RESULT REVEAL\n",
    "    #\n",
    "    # Effects were already frozen before this inspection.\n",
    "    #\n",
    "    # If FDR hits exist:\n",
    "    #     show up to 15 strongest FDR hits.\n",
    "    #\n",
    "    # If zero FDR hits:\n",
    "    #     show 15 smallest raw p-values,\n",
    "    #     clearly marked NON-FDR-SIGNIFICANT.\n",
    "    # ========================================================\n",
    "\n",
    "    if n_sig > 0:\n",
    "\n",
    "        reveal = (\n",
    "\n",
    "            result.loc[\n",
    "                sig_mask,\n",
    "                [\n",
    "                    \"gene_id\",\n",
    "                    \"gene_symbol\",\n",
    "                    \"gene_symbol_unique_in_GSE174367\",\n",
    "                    \"baseMean\",\n",
    "                    \"log2FoldChange\",\n",
    "                    \"stat\",\n",
    "                    \"pvalue\",\n",
    "                    \"padj\",\n",
    "                ]\n",
    "            ]\n",
    "            .sort_values(\n",
    "                [\n",
    "                    \"padj\",\n",
    "                    \"pvalue\",\n",
    "                ],\n",
    "                ascending=[\n",
    "                    True,\n",
    "                    True,\n",
    "                ]\n",
    "            )\n",
    "            .head(\n",
    "                15\n",
    "            )\n",
    "            .copy()\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        reveal[\n",
    "            \"status\"\n",
    "        ] = \"FDR<0.05\"\n",
    "\n",
    "\n",
    "    else:\n",
    "\n",
    "        reveal = (\n",
    "\n",
    "            result[\n",
    "                [\n",
    "                    \"gene_id\",\n",
    "                    \"gene_symbol\",\n",
    "                    \"gene_symbol_unique_in_GSE174367\",\n",
    "                    \"baseMean\",\n",
    "                    \"log2FoldChange\",\n",
    "                    \"stat\",\n",
    "                    \"pvalue\",\n",
    "                    \"padj\",\n",
    "                ]\n",
    "            ]\n",
    "            .sort_values(\n",
    "                \"pvalue\"\n",
    "            )\n",
    "            .head(\n",
    "                15\n",
    "            )\n",
    "            .copy()\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        reveal[\n",
    "            \"status\"\n",
    "        ] = \"NOT_FDR_SIGNIFICANT\"\n",
    "\n",
    "\n",
    "    top_tables[\n",
    "        cell_type\n",
    "    ] = reveal\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.13 AUDIT ROW\n",
    "    # ========================================================\n",
    "\n",
    "    audit_rows.append({\n",
    "\n",
    "        \"cell_type\":\n",
    "            cell_type,\n",
    "\n",
    "        \"tested_genes\":\n",
    "            expected_n,\n",
    "\n",
