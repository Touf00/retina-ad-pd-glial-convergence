    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nDIAGNOSIS USED IN CLUSTERING: NO\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"CELL-TYPE ANNOTATION PERFORMED: NO\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"AUTHOR PROPORTIONS INSPECTED: NO\"\n",
    ")\n",
    "\n",
