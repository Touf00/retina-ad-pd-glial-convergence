  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 54\n",
    "# ============================================================\n",
    "# V2 STEP 30 — AD DISCOVERY ↔ PRIMARY REPLICATION\n",
    "# COMPLETE FIXED REPLACEMENT\n",
    "# ============================================================\n",
    "\n",
    "import json\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from scipy.stats import (\n",
    "    spearmanr,\n",
    "    binomtest,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PROJECT ROOT\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = (\n",
    "    ROOT /\n",
    "    \"locks\"\n",
    ")\n",
    "\n",
    "assert ROOT.exists(), (\n",
    "    f\"Project root missing: {ROOT}\"\n",
    ")\n",
    "\n",
    "assert LOCKS.exists(), (\n",
    "    f\"Locks directory missing: {LOCKS}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. VERIFY REQUIRED UPSTREAM ANALYSES\n",
    "# ============================================================\n",
    "\n",
    "DISCOVERY_LOCK = (\n",
    "    LOCKS /\n",
    "    \"GSE174367_AD_DISCOVERY_EFFECT_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "REPLICATION_LOCK = (\n",
    "    LOCKS /\n",
    "    \"GSE157827_AD_REPLICATION_FINAL_ROBUSTNESS_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "assert DISCOVERY_LOCK.exists(), (\n",
    "    \"Missing GSE174367 discovery effect lock:\\n\"\n",
    "    f\"{DISCOVERY_LOCK}\"\n",
    ")\n",
    "\n",
    "\n",
    "assert REPLICATION_LOCK.exists(), (\n",
    "    \"Missing GSE157827 final replication lock:\\n\"\n",
    "    f\"{REPLICATION_LOCK}\"\n",
    ")\n",
    "\n",
    "\n",
    "with open(\n",
    "    REPLICATION_LOCK,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    replication_lock = json.load(\n",
    "        f\n",
    "    )\n",
    "\n",
    "\n",
    "assert (\n",
    "    replication_lock.get(\n",
    "        \"GSE157827_replication_robustness_complete\"\n",
    "    )\n",
    "    is True\n",
    "), (\n",
    "    \"GSE157827 STEP 29 is not marked complete.\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 30 — AD DISCOVERY ↔ PRIMARY REPLICATION\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"GSE174367 discovery effects: VERIFIED\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"GSE157827 replication robustness: VERIFIED\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. LOCATE EXACT FROZEN EFFECT TABLES\n",
    "# ============================================================\n",
    "\n",
    "def one_exact(\n",
    "    filename\n",
    "):\n",
    "\n",
    "    hits = list(\n",
    "        ROOT.rglob(\n",
    "            filename\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        hits\n",
    "    ) == 1, (\n",
    "        f\"Expected exactly one file named {filename}; \"\n",
    "        f\"found {len(hits)}:\\n{hits}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    return hits[\n",
    "        0\n",
    "    ]\n",
    "\n",
    "\n",
    "AD_DISC_PATH = one_exact(\n",
    "    \"GSE174367_AD_DISCOVERY_ALL_EFFECTS_LONG_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "AD_REP_PATH = one_exact(\n",
    "    \"GSE157827_AD_REPLICATION_PRIMARY_ALL_EFFECTS_LONG_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nDiscovery effects:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    AD_DISC_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPrimary replication effects:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    AD_REP_PATH\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. LOAD EFFECT TABLES\n",
    "# ============================================================\n",
    "\n",
    "D_raw = pd.read_csv(\n",
    "    AD_DISC_PATH,\n",
    "    compression=\"gzip\",\n",
    "    low_memory=False,\n",
    ")\n",
    "\n",
    "\n",
    "R_raw = pd.read_csv(\n",
    "    AD_REP_PATH,\n",
    "    compression=\"gzip\",\n",
    "    low_memory=False,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nDiscovery table shape:\",\n",
    "    D_raw.shape\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Replication table shape:\",\n",
    "    R_raw.shape\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nDiscovery columns:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    D_raw.columns.tolist()\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nReplication columns:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    R_raw.columns.tolist()\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. FIX THE STEP-30 SCHEMA MISMATCH\n",
    "#\n",
    "# GSE174367 STEP 21 deliberately froze its effects as:\n",
    "#\n",
    "#   AD_vs_Control_log2FC\n",
    "#   AD_vs_Control_lfcSE\n",
    "#   AD_vs_Control_Wald\n",
    "#   AD_vs_Control_pvalue\n",
    "#   AD_vs_Control_padj\n",
    "#\n",
    "# GSE157827 STEP 28 kept ordinary PyDESeq2 names:\n",
    "#\n",
    "#   log2FoldChange\n",
    "#   lfcSE\n",
    "#   stat\n",
    "#   pvalue\n",
    "#   padj\n",
    "#\n",
    "# The old STEP 30 incorrectly assumed they already matched.\n",    "# ============================================================\n",
    "\n",
    "DISCOVERY_RENAME = {\n",
    "\n",
    "    \"AD_vs_Control_log2FC\":\n",
    "        \"log2FoldChange\",\n",
    "\n",
    "    \"AD_vs_Control_lfcSE\":\n",
    "        \"lfcSE\",\n",
    "\n",
    "    \"AD_vs_Control_Wald\":\n",
    "        \"stat\",\n",
    "\n",
    "    \"AD_vs_Control_pvalue\":\n",
    "        \"pvalue\",\n",
    "\n",
    "    \"AD_vs_Control_padj\":\n",
    "        \"padj\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "D = D_raw.rename(\n",
    "    columns=DISCOVERY_RENAME\n",
    ").copy()\n",
    "\n",
    "\n",
    "R = R_raw.copy()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. VERIFY HARMONIZED SCHEMAS\n",
    "# ============================================================\n",
    "\n",
    "REQUIRED_COLUMNS = {\n",
    "\n",
    "    \"cell_type\",\n",
    "    \"gene_id\",\n",
    "    \"gene_symbol\",\n",
    "    \"log2FoldChange\",\n",
    "    \"stat\",\n",
    "    \"pvalue\",\n",
    "    \"padj\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "missing_D = (\n",
    "    REQUIRED_COLUMNS\n",
    "    -\n",
    "    set(\n",
    "        D.columns\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "missing_R = (\n",
    "    REQUIRED_COLUMNS\n",
    "    -\n",
    "    set(\n",
    "        R.columns\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert not missing_D, (\n",
    "    \"GSE174367 discovery table still lacks columns \"\n",
    "    f\"after schema harmonization: {sorted(missing_D)}\"\n",
    ")\n",
    "\n",
    "\n",
    "assert not missing_R, (\n",
    "    \"GSE157827 replication table lacks columns: \"\n",
    "    f\"{sorted(missing_R)}\"\n",
    ")\n",
    "\n",
    "\n",
    "CLASSES = [\n",
    "\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "assert set(\n",
    "    CLASSES\n",
    ").issubset(\n",
    "    set(\n",
    "        D[\n",
    "            \"cell_type\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .unique()\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert set(\n",
    "    CLASSES\n",
    ").issubset(\n",
    "    set(\n",
    "        R[\n",
    "            \"cell_type\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .unique()\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nDiscovery/replication schema harmonization: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. UNIQUE GENE-SYMBOL HELPER\n",
    "#\n",
    "# A gene symbol duplicated within either dataset cannot be\n",
    "# mapped one-to-one across datasets.\n",
    "#\n",
    "# Those duplicated symbols are therefore excluded from this\n",
    "# cross-dataset symbol-level comparison.\n",
    "# ============================================================\n",
    "\n",
    "def unique_symbol_table(\n",
    "    table\n",
    "):\n",
    "\n",
    "    x = table.copy()\n",
    "\n",
    "\n",
    "    x[\n",
    "        \"gene_symbol\"\n",
    "    ] = (\n",
    "        x[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .str.upper()\n",
    "        .str.strip()\n",
    "    )\n",
    "\n",
    "\n",
    "    duplicated = (\n",
    "        x[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .duplicated(\n",
    "            keep=False\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    x = x.loc[\n",
    "        ~duplicated\n",
    "    ].copy()\n",
    "\n",
    "\n",
    "    assert (\n",
    "        x[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .is_unique\n",
    "    )\n",
    "\n",
    "\n",
    "    return x\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. PERMUTATION SPEARMAN TEST\n",
    "#\n",
    "# Same hypothesis as original STEP 30:\n",
    "#\n",
    "# H1 = positive discovery ↔ replication concordance\n",
    "#\n",
    "# Deterministic seed preserved.\n",
    "# ============================================================\n",
    "\n",
    "RNG = np.random.default_rng(\n",
    "    20260914\n",
    ")\n",
    "\n",
    "\n",
    "def permutation_spearman(\n",
    "    x,\n",
    "    y,\n",
    "    n_permutations=10000,\n",
    "):\n",
    "\n",
    "    x = np.asarray(\n",
    "        x,\n",
    "        dtype=float,\n",
    "    )\n",
    "\n",
    "\n",
    "    y = np.asarray(\n",
    "        y,\n",
    "        dtype=float,\n",
    "    )\n",
    "\n",
    "\n",
    "    finite = (\n",
    "        np.isfinite(\n",
    "            x\n",
    "        )\n",
    "        &\n",
    "        np.isfinite(\n",
    "            y\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    x = x[\n",
    "        finite\n",
    "    ]\n",
    "\n",
    "\n",
    "    y = y[\n",
    "        finite\n",
    "    ]\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        x\n",
    "    ) >= 3, (\n",
    "        \"Fewer than three finite matched values.\"\n",
    "    )\n",
    "\n",
    "\n",
    "    observed = float(\n",
    "        spearmanr(\n",
    "            x,\n",
    "            y,\n",
    "        ).statistic\n",
    "    )\n",
    "\n",
    "\n",
    "    assert np.isfinite(\n",
    "        observed\n",
    "    ), (\n",
    "        \"Observed Spearman correlation is non-finite.\"\n",
    "    )\n",
    "\n",
    "\n",
    "    greater_or_equal = 0\n",
    "\n",
    "\n",
    "    for _ in range(\n",
    "        n_permutations\n",
    "    ):\n",
    "\n",
    "        permuted = RNG.permutation(\n",
    "            y\n",
    "        )\n",
    "\n",
    "\n",
    "        perm_rho = float(\n",
    "            spearmanr(\n",
    "                x,\n",
    "                permuted,\n",
    "            ).statistic\n",
    "        )\n",
    "\n",
    "\n",
    "        if (\n",
    "            np.isfinite(\n",
    "                perm_rho\n",
    "            )\n",
    "            and\n",
    "            perm_rho >= observed\n",
    "        ):\n",
    "\n",
    "            greater_or_equal += 1\n",
    "\n",
    "\n",
    "    p_value = float(\n",
    "        (\n",
    "            greater_or_equal\n",
    "            +\n",
    "            1\n",
    "        )\n",
    "        /\n",
    "        (\n",
    "            n_permutations\n",
    "            +\n",
    "            1\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    return (\n",
    "        p_value,\n",
    "        observed,\n",
    "        int(\n",
    "            len(\n",
    "                x\n",
    "            )\n",
    "        ),\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. DISCOVERY ↔ PRIMARY REPLICATION\n",
    "# ============================================================\n",
    "\n",
    "summary_rows = []\n",
    "\n",
    "hit_tables = []\n",
    "\n",
    "\n",
    "for cell_type in CLASSES:\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\n\"\n",
    "        +\n",
    "        \"=\" * 90\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        cell_type\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"=\" * 90\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Discovery\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    discovery = unique_symbol_table(\n",
    "\n",
    "        D.loc[\n",
    "            D[\n",
    "                \"cell_type\"\n",
    "            ]\n",
    "            .astype(str)\n",
    "            ==\n",
    "            cell_type\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Replication\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    replication = unique_symbol_table(\n",
    "\n",
    "        R.loc[\n",
    "            R[\n",
    "                \"cell_type\"\n",
    "            ]\n",
    "            .astype(str)\n",
    "            ==\n",
    "            cell_type\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        discovery\n",
    "    ) > 0\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        replication\n",
    "    ) > 0\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # EXPLICIT COLUMN NAMING\n",
    "    #\n",
    "    # Do NOT rely on pandas merge suffixes to infer which\n",
    "    # columns should receive _disc or _rep.\n",
    "    # ========================================================\n",
    "\n",
    "    discovery_compare = (\n",
    "\n",
    "        discovery[\n",
    "            [\n",
    "                \"gene_id\",\n",
    "                \"gene_symbol\",\n",
    "                \"log2FoldChange\",\n",
    "                \"stat\",\n",
    "                \"pvalue\",\n",
    "                \"padj\",\n",
    "            ]\n",
    "        ]\n",
    "\n",
    "        .rename(\n",
    "            columns={\n",
    "\n",
    "                \"gene_id\":\n",
    "                    \"gene_id_disc\",\n",
    "\n",
    "                \"log2FoldChange\":\n",
    "                    \"log2FoldChange_disc\",\n",
    "\n",
    "                \"stat\":\n",
    "                    \"stat_disc\",\n",
    "\n",
    "                \"pvalue\":\n",
    "                    \"pvalue_disc\",\n",
    "\n",
    "                \"padj\":\n",
    "                    \"padj_disc\",\n",
    "\n",
    "            }\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    replication_compare = (\n",
    "\n",
    "        replication[\n",
    "            [\n",
    "                \"gene_id\",\n",
    "                \"gene_symbol\",\n",
    "                \"log2FoldChange\",\n",
    "                \"stat\",\n",
    "                \"pvalue\",\n",
    "                \"padj\",\n",
    "            ]\n",
    "        ]\n",
    "\n",
    "        .rename(\n",
    "            columns={\n",
    "\n",
    "                \"gene_id\":\n",
    "                    \"gene_id_rep\",\n",
    "\n",
    "                \"log2FoldChange\":\n",
    "                    \"log2FoldChange_rep\",\n",
    "\n",
    "                \"stat\":\n",
    "                    \"stat_rep\",\n",
    "\n",
    "                \"pvalue\":\n",
    "                    \"pvalue_rep\",\n",
    "\n",
    "                \"padj\":\n",
    "                    \"padj_rep\",\n",
    "\n",
    "            }\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # MATCH BY UNIQUE GENE SYMBOL\n",
    "    # ========================================================\n",
    "\n",
    "    matched = discovery_compare.merge(\n",
    "\n",
    "        replication_compare,\n",
    "\n",
    "        on=\"gene_symbol\",\n",
    "\n",
    "        how=\"inner\",\n",
    "\n",
    "        validate=\"one_to_one\",\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        matched\n",
    "    ) >= 3, (\n",
    "        f\"{cell_type}: only {len(matched)} matched genes.\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # LFC CONCORDANCE\n",
    "    # ========================================================\n",
    "\n",
    "    (\n",
    "        lfc_perm_p,\n",
    "        lfc_spearman,\n",
    "        finite_lfc_pairs,\n",
    "\n",
    "    ) = permutation_spearman(\n",
    "\n",
    "        matched[\n",
    "            \"log2FoldChange_disc\"\n",
    "        ]\n",
    "        .to_numpy(),\n",
    "\n",
    "        matched[\n",
    "            \"log2FoldChange_rep\"\n",
    "        ]\n",
    "        .to_numpy(),\n",
    "\n",
    "        n_permutations=10000,\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # WALD CONCORDANCE\n",
    "    # ========================================================\n",
    "\n",
    "    (\n",
    "        wald_perm_p,\n",
    "        wald_spearman,\n",
    "        finite_wald_pairs,\n",
    "\n",
    "    ) = permutation_spearman(\n",
    "\n",
    "        matched[\n",
    "            \"stat_disc\"\n",
    "        ]\n",
    "        .to_numpy(),\n",
    "\n",
    "        matched[\n",
    "            \"stat_rep\"\n",
    "        ]\n",
    "        .to_numpy(),\n",
    "\n",
    "        n_permutations=10000,\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # ALL-GENE DIRECTION CONCORDANCE\n",
    "    # ========================================================\n",
    "\n",
    "    finite_direction = (\n",
    "\n",
    "        np.isfinite(\n",
    "            matched[\n",
    "                \"log2FoldChange_disc\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        np.isfinite(\n",
    "            matched[\n",
    "                \"log2FoldChange_rep\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    direction_table = matched.loc[\n",
    "        finite_direction\n",
    "    ]\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        direction_table\n",
    "    ) > 0\n",
    "\n",
    "\n",
    "    same_direction_all = (\n",
    "\n",
    "        np.sign(\n",
    "            direction_table[\n",
    "                \"log2FoldChange_disc\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        ==\n",
    "\n",
    "        np.sign(\n",
    "            direction_table[\n",
    "                \"log2FoldChange_rep\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    all_gene_direction_concordance = float(\n",
    "        same_direction_all.mean()\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # DISCOVERY FDR HITS\n",
    "    # ========================================================\n",
    "\n",
    "    discovery_FDR_mask = (\n",
    "\n",
    "        np.isfinite(\n",
    "            matched[\n",
    "                \"padj_disc\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            matched[\n",
    "                \"padj_disc\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    discovery_hits = matched.loc[\n",
    "        discovery_FDR_mask\n",
    "    ].copy()\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # GENE-LEVEL REPLICATION\n",
    "    #\n",
    "    # Success =\n",
    "    #   same effect direction\n",
    "    #   AND replication nominal p < 0.05\n",
    "    # ========================================================\n",
    "\n",
    "    if len(\n",
    "        discovery_hits\n",
    "    ) > 0:\n",
    "\n",
    "\n",
    "        discovery_hits[\n",
    "            \"same_direction\"\n",
    "        ] = (\n",
    "\n",
    "            np.sign(\n",
    "                discovery_hits[\n",
    "                    \"log2FoldChange_disc\"\n",
    "                ]\n",
    "            )\n",
    "\n",
    "            ==\n",
    "\n",
    "            np.sign(\n",
    "                discovery_hits[\n",
    "                    \"log2FoldChange_rep\"\n",
    "                ]\n",
    "            )\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        discovery_hits[\n",
    "            \"nominal_replication\"\n",
    "        ] = (\n",
    "\n",
    "            np.isfinite(\n",
    "                discovery_hits[\n",
    "                    \"pvalue_rep\"\n",
    "                ]\n",
    "            )\n",
    "\n",
    "            &\n",
    "\n",
    "            (\n",
    "                discovery_hits[\n",
    "                    \"pvalue_rep\"\n",
    "                ]\n",
    "                <\n",
    "                0.05\n",
    "            )\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        discovery_hits[\n",
    "            \"gene_level_success\"\n",
    "        ] = (\n",
    "\n",
    "            discovery_hits[\n",
    "                \"same_direction\"\n",
    "            ]\n",
    "\n",
    "            &\n",
    "\n",
    "            discovery_hits[\n",
    "                \"nominal_replication\"\n",
    "            ]\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        same_direction_hits = int(\n",
    "\n",
    "            discovery_hits[\n",
    "                \"same_direction\"\n",
    "            ]\n",
    "            .sum()\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        gene_level_success = int(\n",
    "\n",
    "            discovery_hits[\n",
    "                \"gene_level_success\"\n",
    "            ]\n",
    "            .sum()\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        direction_binomial_p = float(\n",
    "\n",
    "            binomtest(\n",
    "\n",
    "                same_direction_hits,\n",
    "\n",
    "                len(\n",
    "                    discovery_hits\n",
    "                ),\n",
    "\n",
    "                p=0.5,\n",
    "\n",
    "                alternative=\"greater\",\n",
    "\n",
    "            ).pvalue\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "    else:\n",
    "\n",
    "\n",
    "        same_direction_hits = 0\n",
    "\n",
    "        gene_level_success = 0\n",
    "\n",
    "        direction_binomial_p = np.nan\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # RECORD SUMMARY\n",
    "    # ========================================================\n",
    "\n",
    "    summary_rows.append(\n",
    "        {\n",
    "\n",
    "            \"cell_type\":\n",
    "                cell_type,\n",
    "\n",
    "            \"matched_unique_genes\":\n",
    "                int(\n",
    "                    len(\n",
    "                        matched\n",
    "                    )\n",
    "                ),\n",
    "\n",
    "            \"finite_LFC_pairs\":\n",
    "                finite_lfc_pairs,\n",
    "\n",
    "            \"LFC_spearman\":\n",
    "                lfc_spearman,\n",
    "\n",
    "            \"LFC_perm_p\":\n",
    "                lfc_perm_p,\n",
    "\n",
    "            \"finite_Wald_pairs\":\n",
    "                finite_wald_pairs,\n",
    "\n",
    "            \"Wald_spearman\":\n",
    "                wald_spearman,\n",
    "\n",
    "            \"Wald_perm_p\":\n",
    "                wald_perm_p,\n",
    "\n",
    "            \"all_gene_direction_concordance\":\n",
    "                all_gene_direction_concordance,\n",
    "\n",
    "            \"discovery_FDR_measurable\":\n",
    "                int(\n",
    "                    len(\n",
    "                        discovery_hits\n",
    "                    )\n",
    "                ),\n",
    "\n",
    "            \"same_direction_hits\":\n",
    "                same_direction_hits,\n",
    "\n",
    "            \"gene_level_replication_success\":\n",
    "                gene_level_success,\n",
    "\n",
    "            \"direction_binomial_p\":\n",
    "                direction_binomial_p,\n",
    "\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # STORE DISCOVERY HIT TABLE\n",
    "    # ========================================================\n",
    "\n",
    "    if len(\n",
    "        discovery_hits\n",
    "    ) > 0:\n",
    "\n",
    "\n",
    "        discovery_hits.insert(\n",
    "            0,\n",
    "            \"cell_type\",\n",
    "            cell_type,\n",
    "        )\n",
    "\n",
    "\n",
    "        hit_tables.append(\n",
    "            discovery_hits\n",
    "        )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # PRINT CELL-TYPE RESULT\n",
    "    # ========================================================\n",
    "\n",
    "    print(\n",
    "        \"Discovery unique-symbol genes:\",\n",
    "        f\"{len(discovery):,}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Replication unique-symbol genes:\",\n",
    "        f\"{len(replication):,}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Matched unique genes:\",\n",
    "        f\"{len(matched):,}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"LFC Spearman:\",\n",
    "        lfc_spearman\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"LFC permutation P:\",\n",
    "        lfc_perm_p\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Wald Spearman:\",\n",
    "        wald_spearman\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Wald permutation P:\",\n",
    "        wald_perm_p\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"All-gene direction concordance:\",\n",
    "        all_gene_direction_concordance\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Discovery FDR hits measurable:\",\n",
    "        len(\n",
    "            discovery_hits\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Same-direction discovery hits:\",\n",
    "        same_direction_hits\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Same-direction + nominal replication:\",\n",
    "        gene_level_success\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. FINAL SUMMARY TABLE\n",
    "# ============================================================\n",
    "\n",
    "summary = pd.DataFrame(\n",
    "    summary_rows\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    summary[\n",
    "        \"cell_type\"\n",
    "    ]\n",
    "    .tolist()\n",
    "    ==\n",
    "    CLASSES\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. COMBINED DISCOVERY-HIT SUPPORT TABLE\n",
    "# ============================================================\n",
    "\n",
    "if hit_tables:\n",
    "\n",
    "    hits = pd.concat(\n",
    "        hit_tables,\n",
    "        axis=0,\n",
    "        ignore_index=True,\n",
    "    )\n",
    "\n",
    "else:\n",
    "\n",
    "    hits = pd.DataFrame(\n",
    "        columns=[\n",
    "            \"cell_type\",\n",
    "            \"gene_symbol\",\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. SAVE STEP-30 RESULTS\n",
    "# ============================================================\n",
    "\n",
    "OUT = (\n",
    "\n",
    "    ROOT /\n",
    "    \"results\" /\n",
    "    \"AD_primary_replication\"\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "OUT.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "\n",
    "SUMMARY_PATH = (\n",
    "\n",
    "    OUT /\n",
    "    \"GSE174367_vs_GSE157827_AD_REPLICATION_EVIDENCE_v1.csv\"\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "HIT_PATH = (\n",
    "\n",
    "    OUT /\n",
    "    \"GSE174367_DISCOVERY_FDR_GSE157827_SUPPORT_v1.csv.gz\"\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "summary.to_csv(\n",
    "    SUMMARY_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "hits.to_csv(\n",
    "    HIT_PATH,\n",
    "    index=False,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "assert SUMMARY_PATH.exists()\n",
    "\n",
    "\n",
    "assert HIT_PATH.exists()\n",
    "\n",
    "\n",
    "assert (\n",
    "    SUMMARY_PATH.stat().st_size\n",
    "    >\n",
    "    0\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",    "    HIT_PATH.stat().st_size\n",
    "    >\n",
    "    0\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 12. STEP-30 LOCK\n",
    "# ============================================================\n",
    "\n",
    "STEP30_LOCK = (\n",
    "\n",
    "    LOCKS /\n",
    "    \"AD_PRIMARY_REPLICATION_EVIDENCE_FREEZE_v1.json\"\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "step30_record = {\n",
    "\n",
    "    \"status\":\n",
    "        \"AD_PRIMARY_REPLICATION_EVIDENCE_FROZEN\",\n",
    "\n",
    "    \"discovery\":\n",
    "        \"GSE174367\",\n",
    "\n",
    "    \"replication\":\n",
    "        \"GSE157827\",\n",
    "\n",
    "    \"comparison_level\":\n",
    "        \"unique normalized gene symbol\",\n",
    "\n",
    "    \"discovery_effect_file\":\n",
    "        str(\n",
    "            AD_DISC_PATH\n",
    "        ),\n",
    "\n",
    "    \"replication_effect_file\":\n",
    "        str(\n",
    "            AD_REP_PATH\n",
    "        ),\n",
    "\n",
    "    \"schema_harmonization\": {\n",
    "\n",
    "        \"GSE174367_log2FC\":\n",
    "            \"AD_vs_Control_log2FC -> log2FoldChange\",\n",
    "\n",
    "        \"GSE174367_Wald\":\n",
    "            \"AD_vs_Control_Wald -> stat\",\n",
    "\n",
    "        \"GSE174367_pvalue\":\n",
    "            \"AD_vs_Control_pvalue -> pvalue\",\n",
    "\n",
    "        \"GSE174367_padj\":\n",
    "            \"AD_vs_Control_padj -> padj\",\n",
    "\n",
    "    },\n",
    "\n",
    "    \"permutation_seed\":\n",
    "        20260914,\n",
    "\n",
    "    \"permutations_per_test\":\n",
    "        10000,\n",
    "\n",
    "    \"permutation_hypothesis\":\n",
    "        \"one-sided positive Spearman concordance\",\n",
    "\n",
    "    \"gene_level_replication_rule\":\n",
    "        (\n",
    "            \"discovery FDR < 0.05 AND same direction \"\n",
    "            \"AND replication nominal p < 0.05\"\n",
    "        ),\n",
    "\n",
    "    \"summary_file\":\n",
    "        str(\n",
    "            SUMMARY_PATH\n",
    "        ),\n",
    "\n",
    "    \"hit_file\":\n",
    "        str(\n",
    "            HIT_PATH\n",
    "        ),\n",
    "\n",
    "    \"secondary_external_GSE138852_performed\":\n",
    "        False,\n",
    "\n",
    "    \"AD_PD_convergence_performed\":\n",
    "        False,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    STEP30_LOCK,\n",
