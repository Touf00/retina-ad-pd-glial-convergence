    "runner.write_text(\n",
    "    RUNNER,\n",
    "    encoding=\"utf-8\",\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    runner.exists()\n",
    "    and\n",
    "    runner.stat().st_size > 0\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. PASS THE DETECTED ROOT TO THE CHILD PROCESS\n",
    "# ============================================================\n",
    "\n",
    "env = os.environ.copy()\n",
    "\n",
    "\n",
    "env[\n",
