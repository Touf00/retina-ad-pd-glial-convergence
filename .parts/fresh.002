    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"LAUNCHING PRIMARY GSE174367 AD DISCOVERY DE\"\n",
    ")\n",
    "\n",
