    "    \"locks\" /\n",
    "    \"GSE174367_AD_DISCOVERY_EFFECT_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "assert summary_path.exists()\n",
    "assert run_lock_path.exists()\n",
    "assert freeze_lock_path.exists()\n",
    "\n",
    "\n",
    "import pandas as pd\n",
    "\n",
