    "\n",
    "\n",
    "with open(\n",
    "    PRIMARY_FREEZE_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    primary_freeze = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    SENSITIVITY_LOCK_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
