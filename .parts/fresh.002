    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. EXECUTE IN FRESH CHILD PROCESS\n",
    "# ============================================================\n",
    "\n",
    "import os\n",
    "\n",
    "\n",
    "env = os.environ.copy()\n",
    "\n",
    "env[\n",
    "    \"PYTHONUNBUFFERED\"\n",
    "] = \"1\"\n",
    "\n",
    "env[\n",
    "    \"PYTHONFAULTHANDLER\"\n",
    "] = \"1\"\n",
    "\n",
    "\n",
    "captured_lines = []\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"LAUNCHING STEP 26A1\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "with open(\n",
    "    LOG_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    "    buffering=1,\n",
    ") as log_handle:\n",
    "\n",
    "    process = subprocess.Popen(\n",
    "        [\n",
    "            sys.executable,\n",
    "            \"-u\",\n",
    "            str(\n",
    "                RUNNER_PATH\n",
    "            ),\n",
    "        ],\n",
    "\n",
    "        stdout=\n",
    "            subprocess.PIPE,\n",
    "\n",
    "        stderr=\n",
    "            subprocess.STDOUT,\n",
    "\n",
    "        text=\n",
    "            True,\n",
    "\n",
    "        bufsize=\n",
    "            1,\n",
    "\n",
    "        env=\n",
    "            env,\n",
    "    )\n",
    "\n",
    "\n",
    "    assert process.stdout is not None\n",
    "\n",
    "\n",
    "    for line in process.stdout:\n",
    "\n",
    "        print(\n",
    "            line,\n",
    "            end=\"\",\n",
    "        )\n",
    "\n",
    "        log_handle.write(\n",
    "            line\n",
    "        )\n",
