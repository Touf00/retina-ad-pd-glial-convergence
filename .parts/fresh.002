   "source": [
    "# Source analysis cell: 48\n",
    "# ============================================================\n",
    "# RETINA-ND — STEP 26A2\n",
    "# GSE157827 DISEASE-BLIND PROVISIONAL ANNOTATION\n",
    "# + PROVISIONAL OPC/OLIGO SPLIT\n",
    "# + AUTHOR SIX-CLASS BENCHMARK\n",
    "# + TARGET DONOR COVERAGE\n",
    "#\n",
    "# INPUT:\n",
    "#   Frozen STEP26A1 clustering checkpoint.\n",
    "#\n",
    "# IMPORTANT\n",
    "# ---------\n",
    "# Diagnosis is NOT used for:\n",
    "#   - broad cell-type annotation\n",
    "#   - marker scoring\n",
    "#   - OPC/Oligo candidate split\n",
    "#\n",
    "# Diagnosis is attached ONLY AFTER labels are complete,\n",
    "# solely to summarize donor coverage.\n",
    "#\n",
    "# THIS STEP IS STILL PROVISIONAL.\n",
    "# Final mapping is frozen only in STEP 26B.\n",
    "#\n",
    "# NO PSEUDOBULK\n",
    "# NO DE\n",
    "# NO DISCOVERY/REPLICATION COMPARISON\n",
    "# NO PD DATA\n",
    "# NO AD<->PD CONVERGENCE\n",
    "# ============================================================\n",
    "\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "import hashlib\n",
    "import json\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from scipy.stats import pearsonr\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = ROOT / \"locks\"\n",
    "\n",
    "REP_DIR = (\n",
    "    ROOT\n",
    "    /\n",
    "    \"GSE157827_AD_replication\"\n",
    ")\n",
    "\n",
    "ANNO_DIR = (\n",
    "    REP_DIR\n",
    "    /\n",
    "    \"annotation_provisional\"\n",
    ")\n",
    "\n",
    "SUPP_DIR = (\n",
    "    REP_DIR\n",
    "    /\n",
    "    \"Lau2020_supplementary\"\n",
    ")\n",
    "\n",
    "\n",
    "STEP26A1_LOCK_PATH = (\n",
    "    LOCKS\n",
    "    /\n",
    "    \"GSE157827_AD_REPLICATION_STEP26A1_DISEASE_BLIND_CLUSTERING_v1.json\"\n",
    ")\n",
    "\n",
    "STEP25_LOCK_PATH = (\n",
    "    LOCKS\n",
    "    /\n",
    "    \"GSE157827_AD_REPLICATION_DONOR_METADATA_AND_QC_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "OBS_CLUSTER_PATH = (\n",
    "    ANNO_DIR\n",
    "    /\n",
    "    \"GSE157827_STEP26A1_OBS_CLUSTER_ASSIGNMENTS_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "MARKER_EXPRESSION_PATH = (\n",
    "    ANNO_DIR\n",
    "    /\n",
    "    \"GSE157827_STEP26A1_MARKER_EXPRESSION_LOGCP10K_v1.npy\"\n",
    ")\n",
    "\n",
    "MARKER_NAMES_PATH = (\n",
    "    ANNO_DIR\n",
    "    /\n",
    "    \"GSE157827_STEP26A1_MARKER_NAMES_v1.json\"\n",
    ")\n",
    "\n",
    "GENE_DETECTION_AUDIT_PATH = (\n",
    "    ANNO_DIR\n",
    "    /\n",
    "    \"GSE157827_CLUSTERING_GENE_DETECTION_AUDIT_v1.csv\"\n",
    ")\n",
    "\n",
    "HVG_PATH = (\n",
    "    ANNO_DIR\n",
    "    /\n",
    "    \"GSE157827_DISEASE_BLIND_HVG1000_v1.csv\"\n",
    ")\n",
    "\n",
    "SD01_PATH = (\n",
    "    SUPP_DIR\n",
    "    /\n",
    "    \"pnas.2008762117.sd01.xlsx\"\n",
    ")\n",
    "\n",
    "\n",
    "CLUSTER_MARKER_MEAN_PATH = (\n",
    "    ANNO_DIR\n",
    "    /\n",
    "    \"GSE157827_DISEASE_BLIND_CLUSTER_MARKER_MEANS_PROVISIONAL_v1.csv\"\n",
    ")\n",
    "\n",
    "CLUSTER_MARKER_Z_PATH = (\n",
    "    ANNO_DIR\n",
    "    /\n",
    "    \"GSE157827_DISEASE_BLIND_CLUSTER_MARKER_Z_PROVISIONAL_v1.csv\"\n",
    ")\n",
    "\n",
    "CLUSTER_SCORE_PATH = (\n",
    "    ANNO_DIR\n",
    "    /\n",
    "    \"GSE157827_DISEASE_BLIND_CLUSTER_MARKER_SCORES_PROVISIONAL_v1.csv\"\n",
    ")\n",
    "\n",
    "CELL_LABEL_PATH = (\n",
    "    ANNO_DIR\n",
    "    /\n",
    "    \"GSE157827_DISEASE_BLIND_CELL_LABELS_PROVISIONAL_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "AUTHOR_BENCHMARK_PATH = (\n",
    "    ANNO_DIR\n",
    "    /\n",
    "    \"GSE157827_AUTHOR_PROPORTION_BENCHMARK_PROVISIONAL_v1.csv\"\n",
    ")\n",
    "\n",
    "AUTHOR_BENCHMARK_DONOR_PATH = (\n",
    "    ANNO_DIR\n",
    "    /\n",
    "    \"GSE157827_AUTHOR_PROPORTION_BENCHMARK_BY_DONOR_PROVISIONAL_v1.csv\"\n",
    ")\n",
    "\n",
    "TARGET_COVERAGE_PATH = (\n",
    "    ANNO_DIR\n",
    "    /\n",
    "    \"GSE157827_TARGET_CELLTYPE_DONOR_COVERAGE_PROVISIONAL_v1.csv\"\n",
    ")\n",
    "\n",
    "COVERAGE_SUMMARY_PATH = (\n",
    "    ANNO_DIR\n",
    "    /\n",
    "    \"GSE157827_TARGET_CELLTYPE_DONOR_COVERAGE_SUMMARY_PROVISIONAL_v1.csv\"\n",
    ")\n",
    "\n",
    "STEP26A_LOCK_PATH = (\n",
    "    LOCKS\n",
    "    /\n",
    "    \"GSE157827_AD_REPLICATION_DISEASE_BLIND_ANNOTATION_PROVISIONAL_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "    STEP26A1_LOCK_PATH,\n",
    "    STEP25_LOCK_PATH,\n",
    "    OBS_CLUSTER_PATH,\n",
    "    MARKER_EXPRESSION_PATH,\n",
    "    MARKER_NAMES_PATH,\n",
    "    GENE_DETECTION_AUDIT_PATH,\n",
    "    HVG_PATH,\n",
    "    SD01_PATH,\n",
    "]:\n",
    "\n",
    "    assert path.exists(), (\n",
    "        f\"Missing required input: {path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "if STEP26A_LOCK_PATH.exists():\n",
    "\n",
    "    raise RuntimeError(\n",
    "        \"STEP26A provisional annotation lock already exists.\\n\"\n",
    "        \"Stopping rather than overwriting a frozen result.\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. HELPERS\n",
    "# ============================================================\n",
    "\n",
    "def sha256_file(\n",
    "    path,\n",
    "    block_size=4 * 1024 * 1024,\n",
    "):\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\",\n",
    "    ) as handle:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            block = handle.read(\n",
    "                block_size\n",
    "            )\n",
    "\n",
    "            if not block:\n",
    "                break\n",
    "\n",
    "            h.update(\n",
    "                block\n",
    "            )\n",
    "\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "def safe_pearson(\n",
    "    x,\n",
    "    y,\n",
    "):\n",
    "\n",
    "    x = np.asarray(\n",
    "        x,\n",
    "        dtype=float,\n",
    "    )\n",
    "\n",
    "    y = np.asarray(\n",
    "        y,\n",
    "        dtype=float,\n",
    "    )\n",
    "\n",
    "\n",
    "    mask = (\n",
    "        np.isfinite(\n",
    "            x\n",
    "        )\n",
    "        &\n",
    "        np.isfinite(\n",
    "            y\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    if int(\n",
    "        mask.sum()\n",
    "    ) < 3:\n",
    "\n",
    "        return np.nan\n",
    "\n",
    "\n",
    "    x2 = x[\n",
    "        mask\n",
    "    ]\n",
    "\n",
    "    y2 = y[\n",
    "        mask\n",
    "    ]\n",
    "\n",
    "\n",
    "    if (\n",
    "        np.std(\n",
    "            x2\n",
    "        ) == 0\n",
    "        or\n",
    "        np.std(\n",
    "            y2\n",
    "        ) == 0\n",
    "    ):\n",
    "\n",
    "        return np.nan\n",
    "\n",
    "\n",
    "    return float(\n",
    "        pearsonr(\n",
    "            x2,\n",
    "            y2,\n",
    "        ).statistic\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. VERIFY STEP26A1 + STEP25\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    STEP26A1_LOCK_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as handle:\n",
    "\n",
    "    step26a1 = json.load(\n",
    "        handle\n",
    "    )\n",
    "\n",
    "\n",
    "with open(\n",
    "    STEP25_LOCK_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as handle:\n",
    "\n",
    "    step25 = json.load(\n",
    "        handle\n",
    "    )\n",
    "\n",
    "\n",
    "assert (\n",
    "    step26a1[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"AD_REPLICATION_STEP26A1_DISEASE_BLIND_CLUSTERING_COMPLETE\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    step26a1[\n",
    "        \"input_QC_pass_nuclei\"\n",
    "    ]\n",
    "    ==\n",
    "    169506\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    step26a1[\n",
    "        \"diagnosis_used_in_gene_filter\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    step26a1[\n",
    "        \"diagnosis_used_in_HVG_selection\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    step26a1[\n",
    "        \"diagnosis_used_in_PCA\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    step26a1[\n",
    "        \"diagnosis_used_in_integration\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    step26a1[\n",
    "        \"diagnosis_used_in_clustering\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    step26a1[\n",
    "        \"celltype_annotation_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    step25[\n",
    "        \"replication_DE_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    step25[\n",
    "        \"discovery_vs_replication_compared\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    step25[\n",
    "        \"AD_PD_convergence_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "DONOR_METADATA_PATH = Path(\n",
    "    step25[\n",
    "        \"donor_metadata_file\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "assert DONOR_METADATA_PATH.exists()\n",
    "\n",
    "\n",
    "print(\"=\" * 90)\n",
    "print(\"RETINA-ND STEP 26A2 — PROVISIONAL DISEASE-BLIND ANNOTATION\")\n",
    "print(\"=\" * 90)\n",
    "\n",
    "print(\n",
    "    \"\\nSTEP26A1 clustering checkpoint: PASS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"QC-pass nuclei:\",\n",
    "    step26a1[\n",
    "        \"input_QC_pass_nuclei\"\n",
    "    ],\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Clusters:\",\n",
    "    step26a1[\n",
    "        \"embedding\"\n",
    "    ][\n",
    "        \"n_clusters\"\n",
    "    ],\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Diagnosis used for annotation so far: NO\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. LOAD FROZEN CLUSTERS + MARKER CHECKPOINT\n",
    "# ============================================================\n",
    "\n",
    "obs = pd.read_csv(\n",
    "    OBS_CLUSTER_PATH,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "obs[\n",
    "    \"cluster\"\n",
    "] = (\n",
    "    obs[\n",
    "        \"cluster\"\n",
    "    ]\n",
    "    .astype(str)\n",
    ")\n",
    "\n",
    "\n",
    "marker_expression = np.load(\n",
    "    MARKER_EXPRESSION_PATH,\n",
    "    mmap_mode=\"r\",\n",
    "    allow_pickle=False,\n",
    ")\n",
    "\n",
    "\n",
    "with open(\n",
    "    MARKER_NAMES_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as handle:\n",
    "\n",
    "    marker_info = json.load(\n",
    "        handle\n",
    "    )\n",
    "\n",
    "\n",
    "ALL_MARKERS = marker_info[\n",
    "    \"markers\"\n",
    "]\n",
    "\n",    "BROAD_MARKERS = marker_info[\n",
    "    \"broad_markers\"\n",
    "]\n",
    "\n",
    "OPC_MARKERS = marker_info[\n",
    "    \"OPC_markers\"\n",
    "]\n",
    "\n",
    "OPC_CORE_MARKERS = marker_info[\n",
    "    \"OPC_core_markers\"\n",
    "]\n",
    "\n",
    "MATURE_OLIGO_MARKERS = marker_info[\n",
    "    \"mature_oligo_markers\"\n",
    "]\n",
    "\n",
    "\n",
    "assert len(\n",
    "    obs\n",
    ") == 169506\n",
    "\n",
    "\n",
    "assert obs[\n",
    "    \"cell_uid\"\n",
    "].is_unique\n",
    "\n",
    "\n",
    "assert (\n",
    "    \"diagnosis_binary\"\n",
    "    not in\n",
    "    obs.columns\n",
    ")\n",
    "\n",
    "\n",
    "assert marker_expression.shape == (\n",
    "    169506,\n",
    "    len(\n",
    "        ALL_MARKERS\n",
    "    ),\n",
    ")\n",
    "\n",
    "\n",
    "n_clusters = int(\n",
    "    obs[\n",
    "        \"cluster\"\n",
    "    ].nunique()\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    n_clusters\n",
    "    ==\n",
    "    step26a1[\n",
    "        \"embedding\"\n",
    "    ][\n",
    "        \"n_clusters\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nLoaded nuclei:\",\n",
    "    f\"{len(obs):,}\",\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Loaded marker matrix:\",\n",
    "    marker_expression.shape,\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Diagnosis column present:\",\n",
    "    \"NO\",\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. CLUSTER-LEVEL MARKER MEANS\n",
    "# ============================================================\n",
    "\n",
    "marker_df = pd.DataFrame(\n",
    "    np.asarray(\n",
    "        marker_expression\n",
    "    ),\n",
    "    columns=\n",
    "        ALL_MARKERS,\n",
    ")\n",
    "\n",
    "\n",
    "marker_df[\n",
    "    \"cluster\"\n",
    "] = (\n",
    "    obs[\n",
    "        \"cluster\"\n",
    "    ]\n",
    "    .to_numpy()\n",
    ")\n",
    "\n",
    "\n",
    "cluster_marker_mean = (\n",
    "    marker_df\n",
    "    .groupby(\n",
    "        \"cluster\",\n",
    "        observed=True,\n",
    "    )\n",
    "    .mean()\n",
    ")\n",
    "\n",
    "\n",
    "cluster_sizes = (\n",
    "    obs[\n",
    "        \"cluster\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .rename(\n",
    "        \"n_nuclei\"\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    cluster_marker_mean\n",
    ") == n_clusters\n",
    "\n",
    "\n",
    "assert int(\n",
    "    cluster_sizes.sum()\n",
    ") == 169506\n",
    "\n",
    "\n",
    "cluster_marker_mean_export = (\n",
    "    cluster_marker_mean\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "cluster_marker_mean_export.insert(\n",
    "    0,\n",
    "    \"cluster\",\n",
    "    cluster_marker_mean_export.index.astype(\n",
    "        str\n",
    "    ),\n",
    ")\n",
    "\n",
    "\n",
    "cluster_marker_mean_export.to_csv(\n",
    "    CLUSTER_MARKER_MEAN_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. STANDARDIZE EACH MARKER ACROSS CLUSTERS\n",
    "# ============================================================\n",
    "\n",
    "cluster_marker_z = (\n",
    "    cluster_marker_mean\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "\n",
    "for marker in ALL_MARKERS:\n",
    "\n",
    "    values = (\n",
    "        cluster_marker_mean[\n",
    "            marker\n",
    "        ]\n",
    "        .to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    sd = float(\n",
    "        np.std(\n",
    "            values,\n",
    "            ddof=0,\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    if (\n",
    "        not np.isfinite(\n",
    "            sd\n",
    "        )\n",
    "        or\n",
    "        sd == 0\n",
    "    ):\n",
    "\n",
    "        cluster_marker_z[\n",
    "            marker\n",
    "        ] = 0.0\n",
    "\n",
    "\n",
    "    else:\n",
    "\n",
    "        cluster_marker_z[\n",
    "            marker\n",
    "        ] = (\n",
    "            values\n",
    "            -\n",
    "            float(\n",
    "                np.mean(\n",
    "                    values\n",
    "                )\n",
    "            )\n",
    "        ) / sd\n",
    "\n",
    "\n",
    "cluster_marker_z_export = (\n",
    "    cluster_marker_z\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "cluster_marker_z_export.insert(\n",
    "    0,\n",
    "    \"cluster\",\n",
    "    cluster_marker_z_export.index.astype(\n",
    "        str\n",
    "    ),\n",
    ")\n",
    "\n",
    "\n",
    "cluster_marker_z_export.to_csv(\n",
    "    CLUSTER_MARKER_Z_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. SIX BROAD CELL-CLASS SCORES\n",
    "#\n",
    "# Candidate label = broad marker module with largest mean\n",
    "# standardized cluster-level marker score.\n",
    "#\n",
    "# Still completely disease blind.\n",
    "# ============================================================\n",
    "\n",
    "BROAD_ORDER = [\n",
    "    \"Astro\",\n",
    "    \"Endo\",\n",
    "    \"Excit\",\n",
    "    \"Inhibit\",\n",
    "    \"Micro\",\n",
    "    \"Oligo\",\n",
    "]\n",
    "\n",
    "\n",
    "assert (\n",
    "    list(\n",
    "        BROAD_MARKERS.keys()\n",
    "    )\n",
    "    ==\n",
    "    BROAD_ORDER\n",
    ")\n",
    "\n",
    "\n",
    "broad_scores = pd.DataFrame(\n",
    "    index=\n",
    "        cluster_marker_z.index\n",
    ")\n",
    "\n",
    "\n",
    "for cell_type, markers in BROAD_MARKERS.items():\n",
    "\n",
    "    present = [\n",
    "        marker\n",
    "\n",
    "        for marker\n",
    "        in markers\n",
    "\n",
    "        if marker\n",
    "        in\n",
    "        cluster_marker_z.columns\n",
    "    ]\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        present\n",
    "    ) >= 4\n",
    "\n",
    "\n",
    "    broad_scores[\n",
    "        cell_type\n",
    "    ] = (\n",
    "        cluster_marker_z[\n",
    "            present\n",
    "        ]\n",
    "        .mean(\n",
    "            axis=1\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "score_matrix = broad_scores.to_numpy(\n",
    "    dtype=float\n",
    ")\n",
    "\n",
    "\n",
    "order = np.argsort(\n",
    "    score_matrix,\n",
    "    axis=1,\n",
    ")\n",
    "\n",
    "\n",
    "top_index = order[\n",
    "    :,\n",
    "    -1\n",
    "]\n",
    "\n",
    "\n",
    "second_index = order[\n",
    "    :,\n",
    "    -2\n",
    "]\n",
    "\n",
    "\n",
    "broad_labels = np.asarray(\n",
    "    broad_scores.columns\n",
    ")[\n",
    "    top_index\n",
    "]\n",
    "\n",
    "\n",
    "top_scores = score_matrix[\n",
    "    np.arange(\n",
    "        len(\n",
    "            score_matrix\n",
    "        )\n",
    "    ),\n",
    "    top_index,\n",
    "]\n",
    "\n",
    "\n",
    "second_scores = score_matrix[\n",
    "    np.arange(\n",
    "        len(\n",
    "            score_matrix\n",
    "        )\n",
    "    ),\n",
    "    second_index,\n",
    "]\n",
    "\n",
    "\n",
    "score_margin = (\n",
    "    top_scores\n",
    "    -\n",
    "    second_scores\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. PROVISIONAL OPC-vs-MATURE-OLIGO SPLIT\n",
    "#\n",
    "# ONLY clusters broadly classified as Oligo are considered.\n",
    "#\n",
    "# OPC candidate requires:\n",
    "#   OPC module > mature-Oligo module\n",
    "#   AND >=2 OPC core markers positive after lineage-specific\n",
    "#       standardization.\n",
    "#\n",
    "# Still disease blind.\n",
    "# Still provisional.\n",
    "# ============================================================\n",
    "\n",
    "oligo_cluster_ids = (\n",
    "    broad_scores.index[\n",
    "        broad_labels\n",
    "        ==\n",
    "        \"Oligo\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .tolist()\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    oligo_cluster_ids\n",
    ") >= 1\n",
    "\n",
    "\n",
    "present_OPC = [\n",
    "    marker\n",
    "\n",
    "    for marker\n",
    "    in OPC_MARKERS\n",
    "\n",
    "    if marker\n",
    "    in\n",
    "    cluster_marker_mean.columns\n",
    "]\n",
    "\n",
    "\n",
    "present_mature = [\n",
    "    marker\n",
    "\n",
    "    for marker\n",
    "    in MATURE_OLIGO_MARKERS\n",
    "\n",
    "    if marker\n",
    "    in\n",
    "    cluster_marker_mean.columns\n",
    "]\n",
    "\n",
    "\n",
    "assert len(\n",
    "    present_OPC\n",
    ") >= 5\n",
    "\n",
    "\n",
    "assert len(\n",
    "    present_mature\n",
    ") >= 6\n",
    "\n",
    "\n",
    "lineage_markers = list(\n",
    "    dict.fromkeys(\n",
    "        present_OPC\n",
    "        +\n",
    "        present_mature\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "oligo_z = (\n",
    "    cluster_marker_mean.loc[\n",
    "        oligo_cluster_ids,\n",
    "        lineage_markers,\n",
    "    ]\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "\n",
    "for marker in lineage_markers:\n",
    "\n",
    "    values = (\n",
    "        oligo_z[\n",
    "            marker\n",
    "        ]\n",
    "        .to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    sd = float(\n",
    "        np.std(\n",
    "            values,\n",
    "            ddof=0,\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    if (\n",
    "        not np.isfinite(\n",
    "            sd\n",
    "        )\n",
    "        or\n",
    "        sd == 0\n",
    "    ):\n",
    "\n",
    "        oligo_z[\n",
    "            marker\n",
    "        ] = 0.0\n",
    "\n",
    "\n",
    "    else:\n",
    "\n",
    "        oligo_z[\n",
    "            marker\n",
    "        ] = (\n",
    "            values\n",
    "            -\n",
    "            float(\n",
    "                np.mean(\n",
    "                    values\n",
    "                )\n",
    "            )\n",
    "        ) / sd\n",
    "\n",
    "\n",
    "lineage = pd.DataFrame(\n",
    "    index=\n",
    "        oligo_z.index\n",
    ")\n",
    "\n",
    "\n",
    "lineage[\n",
    "    \"OPC_module_z\"\n",
    "] = (\n",
    "    oligo_z[\n",
    "        present_OPC\n",
    "    ]\n",
    "    .mean(\n",
    "        axis=1\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "lineage[\n",
    "    \"MatureOligo_module_z\"\n",
    "] = (\n",
    "    oligo_z[\n",
    "        present_mature\n",
    "    ]\n",
    "    .mean(\n",
    "        axis=1\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "core_available = [\n",
    "    marker\n",
    "\n",
    "    for marker\n",
    "    in OPC_CORE_MARKERS\n",
    "\n",
    "    if marker\n",
    "    in\n",
    "    oligo_z.columns\n",
    "]\n",
    "\n",
    "\n",
    "assert len(\n",
    "    core_available\n",
    ") >= 2\n",
    "\n",
    "\n",
    "lineage[\n",
    "    \"OPC_core_markers_positive_z\"\n",
    "] = (\n",
    "    (\n",
    "        oligo_z[\n",
    "            core_available\n",
    "        ]\n",
    "        >\n",
    "        0\n",
    "    )\n",
    "    .sum(\n",
    "        axis=1\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "lineage[\n",
    "    \"oligo_lineage_candidate\"\n",
    "] = np.where(\n",
    "    (\n",
    "        lineage[\n",
    "            \"OPC_module_z\"\n",
    "        ]\n",
    "        >\n",
    "        lineage[\n",
    "            \"MatureOligo_module_z\"\n",
    "        ]\n",
    "    )\n",
    "    &\n",
    "    (\n",
    "        lineage[\n",
    "            \"OPC_core_markers_positive_z\"\n",
    "        ]\n",
    "        >=\n",
    "        2\n",
    "    ),\n",
    "\n",
    "    \"OPC_candidate\",\n",
    "\n",
    "    \"Oligo_candidate\",\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. CLUSTER SCORE TABLE\n",
    "# ============================================================\n",
    "\n",
    "cluster_table = (\n",
    "    broad_scores\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "\n",
    "cluster_table.insert(\n",
    "    0,\n",
    "    \"cluster\",\n",
    "    cluster_table.index.astype(\n",
    "        str\n",
    "    ),\n",
    ")\n",
    "\n",
    "\n",
    "cluster_table[\n",
    "    \"n_nuclei\"\n",
    "] = (\n",
    "    cluster_table[\n",
    "        \"cluster\"\n",
    "    ]\n",
    "    .map(\n",
    "        cluster_sizes.to_dict()\n",
    "    )\n",
    "    .astype(\n",
    "        int\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "cluster_table[\n",
    "    \"broad_label_candidate\"\n",
    "] = broad_labels\n",
    "\n",
    "\n",
    "cluster_table[\n",
    "    \"broad_top_score\"\n",
    "] = top_scores\n",
    "\n",
    "\n",
    "cluster_table[\n",
    "    \"broad_second_score\"\n",
    "] = second_scores\n",
    "\n",
    "\n",
    "cluster_table[\n",
    "    \"broad_score_margin\"\n",
    "] = score_margin\n",
    "\n",
    "\n",
    "cluster_table[\n",
    "    \"low_margin_lt_0.5\"\n",
    "] = (\n",
    "    cluster_table[\n",
    "        \"broad_score_margin\"\n",
    "    ]\n",
    "    <\n",
    "    0.5\n",
    ")\n",
    "\n",
    "\n",
    "cluster_table[\n",
    "    \"OPC_module_z\"\n",
    "] = np.nan\n",
    "\n",
    "\n",
    "cluster_table[\n",
    "    \"MatureOligo_module_z\"\n",
    "] = np.nan\n",
    "\n",
    "\n",
    "cluster_table[\n",
    "    \"OPC_core_markers_positive_z\"\n",
    "] = np.nan\n",
    "\n",
    "\n",
    "cluster_table[\n",
    "    \"oligo_lineage_candidate\"\n",
    "] = None\n",
    "\n",
    "\n",
    "for cluster_id in lineage.index:\n",
    "\n",
    "    mask = (\n",
    "        cluster_table[\n",
    "            \"cluster\"\n",
    "        ]\n",
    "        ==\n",
    "        str(\n",
    "            cluster_id\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    cluster_table.loc[\n",
    "        mask,\n",
    "        \"OPC_module_z\"\n",
    "    ] = float(\n",
    "        lineage.loc[\n",
    "            cluster_id,\n",
    "            \"OPC_module_z\",\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    cluster_table.loc[\n",
    "        mask,\n",
    "        \"MatureOligo_module_z\"\n",
    "    ] = float(\n",
    "        lineage.loc[\n",
    "            cluster_id,\n",
    "            \"MatureOligo_module_z\",\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    cluster_table.loc[\n",
    "        mask,\n",
    "        \"OPC_core_markers_positive_z\"\n",
    "    ] = int(\n",
    "        lineage.loc[\n",
    "            cluster_id,\n",
    "            \"OPC_core_markers_positive_z\",\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    cluster_table.loc[\n",
    "        mask,\n",
    "        \"oligo_lineage_candidate\"\n",
    "    ] = str(\n",
    "        lineage.loc[\n",
    "            cluster_id,\n",
    "            \"oligo_lineage_candidate\",\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "cluster_table.to_csv(\n",
    "    CLUSTER_SCORE_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PROVISIONAL CLUSTER ANNOTATION\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    cluster_table.to_string(\n",
    "        index=False\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. NUCLEUS-LEVEL PROVISIONAL LABELS\n",
    "#\n",
    "# Still no diagnosis attached.\n",
    "# ============================================================\n",
    "\n",
    "cluster_map = (\n",
    "    cluster_table[\n",
    "        [\n",
    "            \"cluster\",\n",
    "            \"broad_label_candidate\",\n",
    "            \"broad_score_margin\",\n",
    "            \"low_margin_lt_0.5\",\n",
    "            \"oligo_lineage_candidate\",\n",
    "        ]\n",
    "    ]\n",
    "    .set_index(\n",
    "        \"cluster\"\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "cell_labels = (\n",
    "    obs[\n",
    "        [\n",
    "            \"donor_id\",\n",
    "            \"barcode\",\n",
    "            \"cell_uid\",\n",
    "            \"n_UMI\",\n",
    "            \"cluster\",\n",
    "        ]\n",
    "    ]\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "\n",
    "for column in [\n",
    "    \"broad_label_candidate\",\n",
    "    \"broad_score_margin\",\n",
    "    \"low_margin_lt_0.5\",\n",
    "    \"oligo_lineage_candidate\",\n",
    "]:\n",
    "\n",
    "    cell_labels[\n",
    "        column\n",
    "    ] = (\n",
    "        cell_labels[\n",
    "            \"cluster\"\n",
    "        ]\n",
    "        .map(\n",
    "            cluster_map[\n",
    "                column\n",
    "            ]\n",
    "            .to_dict()\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "assert cell_labels[\n",
    "    \"broad_label_candidate\"\n",
    "].notna().all()\n",
    "\n",
    "\n",
    "cell_labels[\n",
    "    \"target_celltype_candidate\"\n",
    "] = \"Other\"\n",
    "\n",
    "\n",
    "cell_labels.loc[\n",
    "    cell_labels[\n",
    "        \"broad_label_candidate\"\n",
    "    ]\n",
    "    ==\n",
    "    \"Astro\",\n",
    "\n",
    "    \"target_celltype_candidate\",\n",
    "\n",
    "] = \"Astro\"\n",
    "\n",
    "\n",
    "cell_labels.loc[\n",
    "    cell_labels[\n",
    "        \"broad_label_candidate\"\n",
    "    ]\n",
    "    ==\n",
    "    \"Micro\",\n",
    "\n",
    "    \"target_celltype_candidate\",\n",
    "\n",
    "] = \"Micro\"\n",
    "\n",
    "\n",
    "cell_labels.loc[\n",
    "    (\n",
    "        cell_labels[\n",
    "            \"broad_label_candidate\"\n",
    "        ]\n",
    "        ==\n",
    "        \"Oligo\"\n",
    "    )\n",
    "    &\n",
    "    (\n",
    "        cell_labels[\n",
    "            \"oligo_lineage_candidate\"\n",
    "        ]\n",
    "        ==\n",
    "        \"OPC_candidate\"\n",
    "    ),\n",
    "\n",
    "    \"target_celltype_candidate\",\n",
    "\n",
    "] = \"OPC\"\n",
    "\n",
    "\n",
    "cell_labels.loc[\n",
    "    (\n",
    "        cell_labels[\n",
    "            \"broad_label_candidate\"\n",
    "        ]\n",
    "        ==\n",
    "        \"Oligo\"\n",
    "    )\n",
    "    &\n",
    "    (\n",
    "        cell_labels[\n",
    "            \"oligo_lineage_candidate\"\n",
    "        ]\n",
    "        ==\n",
    "        \"Oligo_candidate\"\n",
    "    ),\n",
    "\n",
    "    \"target_celltype_candidate\",\n",
    "\n",
    "] = \"Oligo\"\n",
    "\n",
    "\n",
    "assert (\n",
    "    \"diagnosis_binary\"\n",
    "    not in\n",
    "    cell_labels.columns\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    cell_labels\n",
    ") == 169506\n",
    "\n",
    "\n",
    "assert cell_labels[\n",
    "    \"cell_uid\"\n",
    "].is_unique\n",
    "\n",
    "\n",
    "cell_labels.to_csv(\n",
    "    CELL_LABEL_PATH,\n",
    "\n",
    "    index=False,\n",
    "\n",
    "    compression={\n",
    "        \"method\":\n",
    "            \"gzip\",\n",
    "\n",
    "        \"compresslevel\":\n",
    "            6,\n",
    "    },\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. BROAD SIX-CLASS COUNTS\n",
    "# ============================================================\n",
    "\n",
    "broad_counts = (\n",
    "    cell_labels[\n",
    "        \"broad_label_candidate\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .reindex(\n",
    "        BROAD_ORDER,\n",
    "        fill_value=0,\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert int(\n",
    "    broad_counts.sum()\n",
    ") == 169506\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PROVISIONAL BROAD COUNTS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    broad_counts.to_string()\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. AUTHOR SIX-CLASS BENCHMARK\n",
    "#\n",
    "# IMPORTANT:\n",
    "# Lau author proportions are read ONLY NOW,\n",
    "# after disease-blind labels have already been generated.\n",
    "# ============================================================\n",
    "\n",
    "author_qc = pd.read_excel(\n",
    "    SD01_PATH,\n",
    "    sheet_name=\n",
    "        \"snRNAseq_QC\",\n",
    ")\n",
    "\n",
    "\n",
    "author_qc[\n",
    "    \"ID\"\n",
    "] = (\n",
    "    author_qc[\n",
    "        \"ID\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "\n",
    "sample_ids = set(\n",
    "    cell_labels[\n",
    "        \"donor_id\"\n",
    "    ]\n",
    "    .astype(str)\n",
    ")\n",
    "\n",
    "\n",
    "author_qc = (\n",
    "    author_qc[\n",
    "        author_qc[\n",
    "            \"ID\"\n",
    "        ]\n",
    "        .isin(\n",
    "            sample_ids\n",
    "        )\n",
    "    ]\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    author_qc\n",
    ") == 21\n",
    "\n",    "\n",
    "AUTHOR_COLUMNS = {\n",
    "    \"Astro\":\n",
    "        \"Proportion of Astro (%)\",\n",
    "\n",
    "    \"Endo\":\n",
    "        \"Proportion of Endo (%)\",\n",
    "\n",
    "    \"Excit\":\n",
    "        \"Proportion of Excit (%)\",\n",
    "\n",
    "    \"Inhibit\":\n",
    "        \"Proportion of Inhibit (%)\",\n",
    "\n",
    "    \"Micro\":\n",
    "        \"Proportion of Mic (%)\",\n",
    "\n",
    "    \"Oligo\":\n",
    "        \"Proportion of Oligo (%)\",\n",
    "}\n",
    "\n",
    "\n",
    "reconstructed_counts = (\n",
    "    pd.crosstab(\n",
    "        cell_labels[\n",
    "            \"donor_id\"\n",
    "        ],\n",
    "\n",
    "        cell_labels[\n",
    "            \"broad_label_candidate\"\n",
    "        ],\n",
    "    )\n",
    "    .reindex(\n",
    "        columns=\n",
    "            BROAD_ORDER,\n",
    "\n",
    "        fill_value=0,\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "reconstructed_pct = (\n",
    "    reconstructed_counts\n",
    "    .div(\n",
    "        reconstructed_counts.sum(\n",
    "            axis=1\n",
    "        ),\n",
    "\n",
    "        axis=0,\n",
    "    )\n",
    "    *\n",
    "    100.0\n",
    ")\n",
    "\n",
    "\n",
    "benchmark_by_donor = pd.DataFrame(\n",
    "    {\n",
    "        \"donor_id\":\n",
    "            reconstructed_pct.index.astype(\n",
    "                str\n",
    "            )\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "for cell_type in BROAD_ORDER:\n",
    "\n",
    "    benchmark_by_donor[\n",
    "        f\"reconstructed_{cell_type}_pct\"\n",
    "    ] = (\n",
    "        reconstructed_pct[\n",
    "            cell_type\n",
    "        ]\n",
    "        .to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "author_table = pd.DataFrame(\n",
    "    {\n",
    "        \"donor_id\":\n",
    "            author_qc[\n",
    "                \"ID\"\n",
    "            ]\n",
    "            .astype(str)\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "for cell_type, source_column in AUTHOR_COLUMNS.items():\n",
    "\n",
    "    author_table[\n",
    "        f\"author_{cell_type}_pct\"\n",
    "    ] = pd.to_numeric(\n",
    "        author_qc[\n",
    "            source_column\n",
    "        ],\n",
    "\n",
    "        errors=\"raise\",\n",
    "    )\n",
    "\n",
    "\n",
    "benchmark_by_donor = benchmark_by_donor.merge(\n",
    "    author_table,\n",
    "\n",
    "    on=\n",
    "        \"donor_id\",\n",
    "\n",
    "    how=\n",
    "        \"left\",\n",
    "\n",
    "    validate=\n",
    "        \"one_to_one\",\n",
    ")\n",
    "\n",
    "\n",
    "benchmark_rows = []\n",
    "\n",
    "\n",
    "for cell_type in BROAD_ORDER:\n",
    "\n",
    "    reconstructed = (\n",
    "        benchmark_by_donor[\n",
    "            f\"reconstructed_{cell_type}_pct\"\n",
    "        ]\n",
    "        .to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    author = (\n",
    "        benchmark_by_donor[\n",
    "            f\"author_{cell_type}_pct\"\n",
    "        ]\n",
    "        .to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    benchmark_rows.append(\n",
    "        {\n",
    "            \"cell_type\":\n",
    "                cell_type,\n",
    "\n",
    "            \"pearson_across_21_donors\":\n",
    "                safe_pearson(\n",
    "                    reconstructed,\n",
    "                    author,\n",
    "                ),\n",
    "\n",
    "            \"MAE_percentage_points\":\n",
    "                float(\n",
    "                    np.mean(\n",
    "                        np.abs(\n",
    "                            reconstructed\n",
    "                            -\n",
    "                            author\n",
    "                        )\n",
    "                    )\n",
    "                ),\n",
    "\n",
    "            \"mean_reconstructed_pct\":\n",
    "                float(\n",
    "                    np.mean(\n",
    "                        reconstructed\n",
    "                    )\n",
    "                ),\n",
    "\n",
    "            \"mean_author_pct\":\n",
    "                float(\n",
    "                    np.mean(\n",
    "                        author\n",
    "                    )\n",
    "                ),\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "author_benchmark = pd.DataFrame(\n",
    "    benchmark_rows\n",
    ")\n",
    "\n",
    "\n",
    "author_benchmark.to_csv(\n",
    "    AUTHOR_BENCHMARK_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "benchmark_by_donor.to_csv(\n",
    "    AUTHOR_BENCHMARK_DONOR_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"AUTHOR SIX-CLASS PROPORTION BENCHMARK\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    author_benchmark.to_string(\n",
    "        index=False\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 12. PROVISIONAL TARGET COUNTS\n",
    "# ============================================================\n",
    "\n",
    "TARGET_ORDER = [\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "    \"Other\",\n",
    "]\n",
    "\n",
    "\n",
    "target_counts = (\n",
    "    cell_labels[\n",
    "        \"target_celltype_candidate\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .reindex(\n",
    "        TARGET_ORDER,\n",
    "        fill_value=0,\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert int(\n",
    "    target_counts.sum()\n",
    ") == 169506\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PROVISIONAL TARGET COUNTS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    target_counts.to_string()\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 13. ONLY NOW ATTACH DIAGNOSIS FOR DONOR COVERAGE\n",
    "# ============================================================\n",
    "\n",
    "donor_metadata = pd.read_csv(\n",
    "    DONOR_METADATA_PATH\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    donor_metadata\n",
    ") == 21\n",
    "\n",
    "\n",
    "coverage = (\n",
    "    pd.crosstab(\n",
    "        cell_labels[\n",
    "            \"donor_id\"\n",
    "        ],\n",
    "\n",
    "        cell_labels[\n",
    "            \"target_celltype_candidate\"\n",
    "        ],\n",
    "    )\n",
    "    .reindex(\n",
    "        columns=\n",
    "            TARGET_ORDER,\n",
    "\n",
    "        fill_value=0,\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "\n",
    "coverage = coverage.merge(\n",
    "    donor_metadata[\n",
    "        [\n",
    "            \"donor_id\",\n",
    "            \"diagnosis_binary\",\n",
    "        ]\n",
    "    ],\n",
    "\n",
    "    on=\n",
    "        \"donor_id\",\n",
    "\n",
    "    how=\n",
    "        \"left\",\n",
    "\n",
    "    validate=\n",
    "        \"one_to_one\",\n",
    ")\n",
    "\n",
    "\n",
    "assert coverage[\n",
    "    \"diagnosis_binary\"\n",
    "].notna().all()\n",
    "\n",
    "\n",
    "coverage = coverage[\n",
    "    [\n",
    "        \"donor_id\",\n",
    "        \"diagnosis_binary\",\n",
    "        \"Astro\",\n",
    "        \"Micro\",\n",
    "        \"OPC\",\n",
    "        \"Oligo\",\n",
    "        \"Other\",\n",
    "    ]\n",
    "]\n",
    "\n",
    "\n",
    "coverage.to_csv(\n",
    "    TARGET_COVERAGE_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "coverage_summary_rows = []\n",
    "\n",
    "\n",
    "for cell_type in [\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "]:\n",
    "\n",
    "    for threshold in [\n",
    "        20,\n",
    "        50,\n",
    "        100,\n",
    "    ]:\n",
    "\n",
    "        eligible = (\n",
    "            coverage[\n",
    "                cell_type\n",
    "            ]\n",
    "            >=\n",
    "            threshold\n",
    "        )\n",
    "\n",
    "\n",
    "        subset = coverage.loc[\n",
    "            eligible\n",
    "        ]\n",
    "\n",
    "\n",
    "        coverage_summary_rows.append(\n",
    "            {\n",
    "                \"cell_type\":\n",
    "                    cell_type,\n",
    "\n",
    "                \"minimum_nuclei\":\n",
    "                    threshold,\n",
    "\n",
    "                \"eligible_donors\":\n",
    "                    int(\n",
    "                        eligible.sum()\n",
    "                    ),\n",
    "\n",
    "                \"eligible_AD\":\n",
    "                    int(\n",
    "                        (\n",
    "                            subset[\n",
    "                                \"diagnosis_binary\"\n",
    "                            ]\n",
    "                            ==\n",
    "                            \"AD\"\n",
    "                        ).sum()\n",
    "                    ),\n",
    "\n",
    "                \"eligible_Control\":\n",
    "                    int(\n",
    "                        (\n",
    "                            subset[\n",
    "                                \"diagnosis_binary\"\n",
    "                            ]\n",
    "                            ==\n",
    "                            \"Control\"\n",
    "                        ).sum()\n",
    "                    ),\n",
    "\n",
    "                \"minimum_observed_nuclei\":\n",
    "                    int(\n",
    "                        coverage[\n",
    "                            cell_type\n",
    "                        ].min()\n",
    "                    ),\n",
    "\n",
    "                \"median_observed_nuclei\":\n",
    "                    float(\n",
    "                        coverage[\n",
    "                            cell_type\n",
    "                        ].median()\n",
    "                    ),\n",
    "\n",
    "                \"maximum_observed_nuclei\":\n",
    "                    int(\n",
    "                        coverage[\n",
    "                            cell_type\n",
    "                        ].max()\n",
    "                    ),\n",
    "            }\n",
    "        )\n",
    "\n",
    "\n",
    "coverage_summary = pd.DataFrame(\n",
    "    coverage_summary_rows\n",
    ")\n",
    "\n",
    "\n",
    "coverage_summary.to_csv(\n",
    "    COVERAGE_SUMMARY_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PROVISIONAL TARGET DONOR COVERAGE\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    coverage.to_string(\n",
    "        index=False\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nCoverage threshold summary:\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    coverage_summary.to_string(\n",
    "        index=False\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 14. ANNOTATION CONFIDENCE\n",
    "# ============================================================\n",
    "\n",
    "n_low_margin_clusters = int(\n",
    "    cluster_table[\n",
    "        \"low_margin_lt_0.5\"\n",
    "    ].sum()\n",
    ")\n",
    "\n",
    "\n",
    "n_low_margin_cells = int(\n",
    "    cluster_table.loc[\n",
    "        cluster_table[\n",
    "            \"low_margin_lt_0.5\"\n",
    "        ],\n",
    "\n",
    "        \"n_nuclei\",\n",
    "    ].sum()\n",
    ")\n",
    "\n",
    "\n",
    "low_margin_fraction = float(\n",
    "    n_low_margin_cells\n",
    "    /\n",
    "    169506\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"ANNOTATION CONFIDENCE\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Clusters:\",\n",
    "    n_clusters,\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Low-margin clusters:\",\n",
