    "        30,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "EXPECTED_RIN_FDR = {\n",
    "\n",
    "    \"Astro\":\n",
    "        1,\n",
    "\n",
    "    \"Micro\":\n",
    "        13,\n",
    "\n",
