    "        REQUIRED_PYDESEQ2,\n",
    "\n",
    "    \"cooks_filter\":\n",
    "        True,\n",
    "\n",
    "    \"independent_filter\":\n",
    "        True,\n",
    "\n",
    "    \"FDR\":\n",
    "        0.05,\n",
    "\n",
    "    \"multiple_testing\":\n",
    "        (\n",
    "            \"Benjamini-Hochberg \"\n",
    "            \"within each cell class\"\n",
    "        ),\n",
    "\n",
    "    \"gene_universes_refiltered\":\n",
    "        False,\n",
    "\n",
    "    \"donors_changed\":\n",
    "        False,\n",
    "\n",
    "    \"RIN_sensitivity_performed\":\n",
    "        False,\n",
    "\n",
    "    \"PMI_sensitivity_performed\":\n",
    "        False,\n",
    "\n",
    "    \"AD_replication_performed\":\n",
    "        False,\n",
    "\n",
    "    \"AD_PD_convergence_performed\":\n",
    "        False,\n",
    "\n",
    "    \"cell_class_results\":\n",
    "        run_records,\n",
    "\n",
    "    \"combined_summary\":\n",
    "        str(\n",
    "            combined_summary_path\n",
    "        ),\n",
    "\n",
    "    \"environment\":\n",
    "        environment_record,\n",
    "\n",
    "    \"all_tested_gene_results_saved\":\n",
    "        True,\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    de_run_lock_path,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        DE_RUN_LOCK,\n",
    "        f,\n",
    "        indent=2\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# M. PRIMARY AD DISCOVERY EFFECT FREEZE\n",
    "#\n",
    "# This occurs BEFORE:\n",
