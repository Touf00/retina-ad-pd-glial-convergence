   "source": [
    "# Source analysis cell: 49\n",
    "# ============================================================\n",
    "# RETINA-ND — STEP 26B\n",
    "# GSE157827 FINAL DISEASE-BLIND TARGET-CELL MAPPING FREEZE\n",
    "#\n",
    "# PURPOSE\n",
    "# -------\n",
    "# Freeze the final target mapping BEFORE pseudobulk and BEFORE\n",
    "# any AD-vs-Control expression analysis.\n",
    "#\n",
    "# FINAL TARGET RULE\n",
    "# -----------------\n",
    "#\n",
    "# Astro:\n",
    "#   broad Astro AND broad margin >= 0.5\n",
    "#\n",
    "# Micro:\n",
    "#   broad Micro AND broad margin >= 0.5\n",
    "#\n",
    "# OPC:\n",
    "#   broad Oligo AND provisional lineage == OPC_candidate\n",
    "#\n",
    "#   NOTE:\n",
    "#   The OPC lineage rule is independent of the broad six-class\n",
    "#   margin. Cluster 10 therefore remains OPC because it passed\n",
    "#   the prespecified OPC-specific marker rule.\n",
    "#\n",
    "# Oligo:\n",
    "#   broad Oligo AND lineage == Oligo_candidate\n",
    "#   AND broad margin >= 0.5\n",
    "#\n",
    "# Everything else:\n",
    "#   Other\n",
    "#\n",
    "# IMPORTANT\n",
    "# ---------\n",
    "# NO diagnosis is used to define this mapping.\n",
    "# NO donor is excluded in this step.\n",
    "# NO donor-cell threshold is frozen in this step.\n",
    "# NO pseudobulk.\n",
    "# NO DE.\n",
    "# ============================================================\n",
    "\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "import hashlib\n",
    "import json\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from scipy.stats import pearsonr\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = ROOT / \"locks\"\n",
    "\n",
    "REP_DIR = (\n",
    "    ROOT\n",
    "    /\n",
    "    \"GSE157827_AD_replication\"\n",
    ")\n",
    "\n",
    "ANNO_DIR = (\n",
    "    REP_DIR\n",
    "    /\n",
    "    \"annotation_provisional\"\n",
    ")\n",
    "\n",
    "FINAL_DIR = (\n",
    "    REP_DIR\n",
    "    /\n",
    "    \"annotation_final\"\n",
    ")\n",
    "\n",
    "FINAL_DIR.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "\n",
    "STEP26A_LOCK = (\n",
    "    LOCKS\n",
    "    /\n",
    "    \"GSE157827_AD_REPLICATION_DISEASE_BLIND_ANNOTATION_PROVISIONAL_v1.json\"\n",
    ")\n",
    "\n",
    "STEP25_LOCK = (\n",
    "    LOCKS\n",
    "    /\n",
    "    \"GSE157827_AD_REPLICATION_DONOR_METADATA_AND_QC_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "CLUSTER_SCORE_PATH = (\n",
    "    ANNO_DIR\n",
    "    /\n",
    "    \"GSE157827_DISEASE_BLIND_CLUSTER_MARKER_SCORES_PROVISIONAL_v1.csv\"\n",
    ")\n",
    "\n",
    "CELL_LABEL_PROVISIONAL_PATH = (\n",
    "    ANNO_DIR\n",
    "    /\n",
    "    \"GSE157827_DISEASE_BLIND_CELL_LABELS_PROVISIONAL_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "AUTHOR_BENCHMARK_DONOR_PATH = (\n",
    "    ANNO_DIR\n",
    "    /\n",
    "    \"GSE157827_AUTHOR_PROPORTION_BENCHMARK_BY_DONOR_PROVISIONAL_v1.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "FINAL_CLUSTER_MAPPING_PATH = (\n",
    "    FINAL_DIR\n",
    "    /\n",
    "    \"GSE157827_FINAL_TARGET_CELLTYPE_CLUSTER_MAPPING_v1.csv\"\n",
    ")\n",
    "\n",
    "FINAL_CELL_LABEL_PATH = (\n",
    "    FINAL_DIR\n",
    "    /\n",
    "    \"GSE157827_FINAL_TARGET_CELL_LABELS_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "FINAL_TARGET_COUNTS_PATH = (\n",
    "    FINAL_DIR\n",
    "    /\n",
    "    \"GSE157827_FINAL_TARGET_CELL_COUNTS_v1.csv\"\n",
    ")\n",
    "\n",
    "FINAL_DONOR_COVERAGE_PATH = (\n",
    "    FINAL_DIR\n",
    "    /\n",
    "    \"GSE157827_FINAL_TARGET_DONOR_COVERAGE_v1.csv\"\n",
    ")\n",
    "\n",
    "FINAL_COVERAGE_DIAGNOSTIC_PATH = (\n",
    "    FINAL_DIR\n",
    "    /\n",
    "    \"GSE157827_FINAL_TARGET_COVERAGE_THRESHOLD_DIAGNOSTIC_v1.csv\"\n",
    ")\n",
    "\n",
    "FINAL_AUTHOR_BENCHMARK_PATH = (\n",
    "    FINAL_DIR\n",
    "    /\n",
    "    \"GSE157827_FINAL_TARGET_AUTHOR_BENCHMARK_v1.csv\"\n",
    ")\n",
    "\n",
    "STEP26B_LOCK = (\n",
    "    LOCKS\n",
    "    /\n",
    "    \"GSE157827_AD_REPLICATION_FINAL_CELLTYPE_MAPPING_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "    STEP26A_LOCK,\n",
    "    STEP25_LOCK,\n",
    "    CLUSTER_SCORE_PATH,\n",
    "    CELL_LABEL_PROVISIONAL_PATH,\n",
    "    AUTHOR_BENCHMARK_DONOR_PATH,\n",
    "]:\n",
    "\n",
    "    assert path.exists(), (\n",
    "        f\"Missing required input: {path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "if STEP26B_LOCK.exists():\n",
    "\n",
    "    raise RuntimeError(\n",
    "        \"STEP 26B final mapping lock already exists.\\n\"\n",
    "        \"Stopping rather than overwriting a frozen mapping.\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. HELPERS\n",
    "# ============================================================\n",
    "\n",
    "def sha256_file(\n",
    "    path,\n",
    "    block_size=4 * 1024 * 1024,\n",
    "):\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\",\n",
    "    ) as handle:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            block = handle.read(\n",
    "                block_size\n",
    "            )\n",
    "\n",
    "            if not block:\n",
    "                break\n",
    "\n",
    "            h.update(\n",
    "                block\n",
    "            )\n",
    "\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "def parse_bool(\n",
    "    series\n",
    "):\n",
    "\n",
    "    if pd.api.types.is_bool_dtype(\n",
    "        series\n",
    "    ):\n",
    "\n",
    "        return series.astype(\n",
    "            bool\n",
    "        )\n",
    "\n",
    "\n",
    "    mapped = (\n",
    "        series\n",
    "        .astype(str)\n",
    "        .str.strip()\n",
    "        .str.lower()\n",
    "        .map(\n",
    "            {\n",
    "                \"true\": True,\n",
    "                \"false\": False,\n",
    "                \"1\": True,\n",
    "                \"0\": False,\n",
    "            }\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert mapped.notna().all()\n",
    "\n",
    "    return mapped.astype(\n",
    "        bool\n",
    "    )\n",
    "\n",
    "\n",
    "def safe_pearson(\n",
    "    x,\n",
    "    y,\n",
    "):\n",
    "\n",
    "    x = np.asarray(\n",
    "        x,\n",
    "        dtype=float,\n",
    "    )\n",
    "\n",
    "    y = np.asarray(\n",
    "        y,\n",
    "        dtype=float,\n",
    "    )\n",
    "\n",
    "\n",
    "    mask = (\n",
    "        np.isfinite(\n",
    "            x\n",
    "        )\n",
    "        &\n",
    "        np.isfinite(\n",
    "            y\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    if int(\n",
    "        mask.sum()\n",
    "    ) < 3:\n",
    "\n",
    "        return np.nan\n",
    "\n",
    "\n",
    "    x = x[\n",
    "        mask\n",
    "    ]\n",
    "\n",
    "    y = y[\n",
    "        mask\n",
    "    ]\n",
    "\n",
    "\n",
    "    if (\n",
    "        np.std(\n",
    "            x\n",
    "        ) == 0\n",
    "        or\n",
    "        np.std(\n",
    "            y\n",
    "        ) == 0\n",
    "    ):\n",
    "\n",
    "        return np.nan\n",
    "\n",
    "\n",
    "    return float(\n",
    "        pearsonr(\n",
    "            x,\n",
    "            y,\n",
    "        ).statistic\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. VERIFY UPSTREAM FREEZES\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    STEP26A_LOCK,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as handle:\n",
    "\n",
    "    step26a = json.load(\n",
    "        handle\n",
    "    )\n",
    "\n",
    "\n",
    "with open(\n",
    "    STEP25_LOCK,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as handle:\n",
    "\n",
    "    step25 = json.load(\n",
    "        handle\n",
    "    )\n",
    "\n",
    "\n",
    "assert (\n",
    "    step26a[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"AD_REPLICATION_DISEASE_BLIND_ANNOTATION_PROVISIONAL_COMPLETE\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    step26a[\n",
    "        \"final_cell_type_mapping_frozen\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    step26a[\n",
    "        \"diagnosis_used_in_broad_annotation\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    step26a[\n",
    "        \"diagnosis_used_in_OPC_Oligo_split\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    step26a[\n",
    "        \"replication_DE_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    step26a[\n",
    "        \"AD_PD_convergence_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    step25[\n",
    "        \"replication_DE_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "DONOR_METADATA_PATH = Path(\n",
    "    step25[\n",
    "        \"donor_metadata_file\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "assert DONOR_METADATA_PATH.exists()\n",
    "\n",
    "\n",
    "print(\"=\" * 90)\n",
    "print(\"RETINA-ND STEP 26B — FINAL TARGET-CELL MAPPING FREEZE\")\n",
    "print(\"=\" * 90)\n",
    "\n",
    "print(\n",
    "    \"\\nUpstream provisional annotation: PASS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Diagnosis used in mapping: NO\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. LOAD CLUSTER-LEVEL DISEASE-BLIND EVIDENCE\n",
    "# ============================================================\n",
    "\n",
    "cluster_table = pd.read_csv(\n",
    "    CLUSTER_SCORE_PATH\n",
    ")\n",
    "\n",
    "\n",
    "cluster_table[\n",
    "    \"cluster\"\n",
    "] = (\n",
    "    cluster_table[\n",
    "        \"cluster\"\n",
    "    ]\n",
    "    .astype(str)\n",
    ")\n",
    "\n",
    "\n",
    "cluster_table[\n",
    "    \"low_margin_lt_0.5\"\n",
    "] = parse_bool(\n",
    "    cluster_table[\n",
    "        \"low_margin_lt_0.5\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    cluster_table\n",
    ") == 28\n",
    "\n",
    "\n",
    "assert cluster_table[\n",
    "    \"cluster\"\n",
    "].is_unique\n",
    "\n",
    "\n",
    "# Hard verification of the exact STEP26A2 state.\n",
    "assert int(\n",
    "    cluster_table[\n",
    "        \"n_nuclei\"\n",
    "    ].sum()\n",
    ") == 169506\n",
    "\n",
    "\n",
    "assert int(\n",
    "    cluster_table[\n",
    "        \"low_margin_lt_0.5\"\n",
    "    ].sum()\n",
    ") == 6\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. DEFINE FINAL RULE — DISEASE BLIND\n",
    "#\n",
    "# Diagnosis has NOT been loaded.\n",
    "# Author donor proportions have NOT been used here.\n",
    "# ============================================================\n",
    "\n",
    "cluster_table[\n",
    "    \"final_target_celltype\"\n",
    "] = \"Other\"\n",
    "\n",
    "\n",
    "cluster_table[\n",
    "    \"final_mapping_reason\"\n",
    "] = (\n",
    "    \"non_target_broad_class_or_ambiguous_target_cluster\"\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Astro:\n",
    "# only high-confidence broad Astro.\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "astro_mask = (\n",
    "    (\n",
    "        cluster_table[\n",
    "            \"broad_label_candidate\"\n",
    "        ]\n",
    "        ==\n",
    "        \"Astro\"\n",
    "    )\n",
    "    &\n",
    "    (\n",
    "        ~cluster_table[\n",
    "            \"low_margin_lt_0.5\"\n",
    "        ]\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "cluster_table.loc[\n",
    "    astro_mask,\n",
    "    \"final_target_celltype\",\n",
    "] = \"Astro\"\n",
    "\n",
    "\n",
    "cluster_table.loc[\n",
    "    astro_mask,\n",
    "    \"final_mapping_reason\",\n",
    "] = (\n",
    "    \"broad_Astro_and_margin_ge_0.5\"\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Micro:\n",
    "# only high-confidence broad Micro.\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "micro_mask = (\n",
    "    (\n",
    "        cluster_table[\n",
    "            \"broad_label_candidate\"\n",
    "        ]\n",
    "        ==\n",
    "        \"Micro\"\n",
    "    )\n",
    "    &\n",
    "    (\n",
    "        ~cluster_table[\n",
    "            \"low_margin_lt_0.5\"\n",
    "        ]\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "cluster_table.loc[\n",
    "    micro_mask,\n",
    "    \"final_target_celltype\",\n",
    "] = \"Micro\"\n",
    "\n",
    "\n",
    "cluster_table.loc[\n",
    "    micro_mask,\n",
    "    \"final_mapping_reason\",\n",
    "] = (\n",
    "    \"broad_Micro_and_margin_ge_0.5\"\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# OPC:\n",
    "#\n",
    "# lineage-specific rule overrides the broad-margin flag.\n",
    "#\n",
    "# This was already defined disease-blind in STEP26A:\n",
    "#\n",
    "#   OPC module > mature-Oligo module\n",
    "#   AND >=2 OPC core markers positive.\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "opc_mask = (\n",
    "    (\n",
    "        cluster_table[\n",
    "            \"broad_label_candidate\"\n",
    "        ]\n",
    "        ==\n",
    "        \"Oligo\"\n",
    "    )\n",
    "    &\n",
    "    (\n",
    "        cluster_table[\n",
    "            \"oligo_lineage_candidate\"\n",
    "        ]\n",
    "        ==\n",
    "        \"OPC_candidate\"\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "cluster_table.loc[\n",
    "    opc_mask,\n",
    "    \"final_target_celltype\",\n",
    "] = \"OPC\"\n",
    "\n",
    "\n",
    "cluster_table.loc[\n",
    "    opc_mask,\n",
    "    \"final_mapping_reason\",\n",
    "] = (\n",
    "    \"disease_blind_OPC_lineage_rule_pass\"\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Mature Oligo:\n",
    "# mature-lineage candidate + confident broad Oligo.\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "oligo_mask = (\n",
    "    (\n",
    "        cluster_table[\n",
    "            \"broad_label_candidate\"\n",
    "        ]\n",
    "        ==\n",
    "        \"Oligo\"\n",
    "    )\n",
    "    &\n",
    "    (\n",
    "        cluster_table[\n",
    "            \"oligo_lineage_candidate\"\n",
    "        ]\n",
    "        ==\n",
    "        \"Oligo_candidate\"\n",
    "    )\n",
    "    &\n",
    "    (\n",
    "        ~cluster_table[\n",
    "            \"low_margin_lt_0.5\"\n",
    "        ]\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "cluster_table.loc[\n",
    "    oligo_mask,\n",
    "    \"final_target_celltype\",\n",
    "] = \"Oligo\"\n",
    "\n",
    "\n",
    "cluster_table.loc[\n",
    "    oligo_mask,\n",
    "    \"final_mapping_reason\",\n",
    "] = (\n",
    "    \"mature_Oligo_candidate_and_margin_ge_0.5\"\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Explicit ambiguity reason for broad target clusters excluded\n",
    "# because of low broad-class margin.\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "ambiguous_astro = (\n",
    "    (\n",
    "        cluster_table[\n",
    "            \"broad_label_candidate\"\n",
    "        ]\n",
    "        ==\n",
    "        \"Astro\"\n",
    "    )\n",
    "    &\n",
    "    (\n",
    "        cluster_table[\n",
    "            \"low_margin_lt_0.5\"\n",
    "        ]\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "cluster_table.loc[\n",
    "    ambiguous_astro,\n",
    "    \"final_mapping_reason\",\n",
    "] = (\n",
    "    \"excluded_low_margin_Astro\"\n",
    ")\n",
    "\n",
    "\n",
    "ambiguous_oligo_nonopc = (\n",
    "    (\n",
    "        cluster_table[\n",
    "            \"broad_label_candidate\"\n",
    "        ]\n",
    "        ==\n",
    "        \"Oligo\"\n",
    "    )\n",
    "    &\n",
    "    (\n",
    "        cluster_table[\n",
    "            \"low_margin_lt_0.5\"\n",
    "        ]\n",
    "    )\n",
    "    &\n",
    "    (\n",
    "        cluster_table[\n",
    "            \"oligo_lineage_candidate\"\n",
    "        ]\n",
    "        !=\n",
    "        \"OPC_candidate\"\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "cluster_table.loc[\n",
    "    ambiguous_oligo_nonopc,\n",
    "    \"final_mapping_reason\",\n",
    "] = (\n",
    "    \"excluded_low_margin_Oligo_without_OPC_rule\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. HARD-CHECK THE RESULTING CLUSTER MAP\n",
    "#\n",
    "# These are determined entirely from the disease-blind\n",
    "# STEP26A2 marker evidence.\n",
    "# ============================================================\n",
    "\n",
    "EXPECTED_CLUSTER_MAP = {\n",
    "    \"Astro\":\n",
    "        {\n",
    "            \"17\",\n",
    "            \"19\",\n",
    "            \"20\",\n",
    "        },\n",
    "\n",
    "    \"Micro\":\n",
    "        {\n",
    "            \"6\",\n",
    "        },\n",
    "\n",
    "    \"OPC\":\n",
    "        {\n",
    "            \"10\",\n",
    "        },\n",
    "\n",
    "    \"Oligo\":\n",
    "        {\n",
    "            \"7\",\n",
    "            \"8\",\n",
    "            \"9\",\n",
    "        },\n",
    "}\n",
    "\n",
    "\n",
    "for cell_type, expected_clusters in EXPECTED_CLUSTER_MAP.items():\n",
    "\n",
    "    observed = set(\n",
    "        cluster_table.loc[\n",
    "            cluster_table[\n",
    "                \"final_target_celltype\"\n",
    "            ]\n",
    "            ==\n",
    "            cell_type,\n",
    "\n",
    "            \"cluster\",\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert observed == expected_clusters, (\n",
    "        f\"{cell_type} cluster mapping changed unexpectedly.\\n\"\n",
    "        f\"Expected: {sorted(expected_clusters)}\\n\"\n",
    "        f\"Observed: {sorted(observed)}\"\n",
    "    )\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFinal disease-blind cluster map:\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    cluster_table[\n",
    "        [\n",
    "            \"cluster\",\n",
    "            \"n_nuclei\",\n",
    "            \"broad_label_candidate\",\n",
    "            \"broad_score_margin\",\n",
    "            \"low_margin_lt_0.5\",\n",
    "            \"OPC_module_z\",\n",
    "            \"MatureOligo_module_z\",\n",
    "            \"OPC_core_markers_positive_z\",\n",
    "            \"oligo_lineage_candidate\",\n",
    "            \"final_target_celltype\",\n",
    "            \"final_mapping_reason\",\n",
    "        ]\n",
    "    ]\n",
    "    .sort_values(\n",
    "        \"cluster\",\n",
    "        key=lambda x:\n",
    "            x.astype(\n",
    "                int\n",
    "            ),\n",
    "    )\n",
    "    .to_string(\n",
    "        index=False\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. FREEZE CLUSTER MAPPING TABLE\n",
    "# ============================================================\n",
    "\n",
    "cluster_table.to_csv(\n",
    "    FINAL_CLUSTER_MAPPING_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. APPLY FINAL MAP TO ALL 169,506 NUCLEI\n",
    "#\n",
    "# STILL NO DIAGNOSIS.\n",
    "# ============================================================\n",
    "\n",
    "cells = pd.read_csv(\n",
    "    CELL_LABEL_PROVISIONAL_PATH,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    cells\n",
    ") == 169506\n",
    "\n",
    "\n",
    "assert cells[\n",
    "    \"cell_uid\"\n",
    "].is_unique\n",
    "\n",
    "\n",
    "assert (\n",
    "    \"diagnosis_binary\"\n",
    "    not in\n",
    "    cells.columns\n",
    ")\n",
    "\n",
    "\n",
    "cells[\n",
    "    \"cluster\"\n",
    "] = (\n",
    "    cells[\n",
    "        \"cluster\"\n",
    "    ]\n",
    "    .astype(str)\n",
    ")\n",
    "\n",
    "\n",
    "cluster_to_final = (\n",
    "    cluster_table[\n",
    "        [\n",
    "            \"cluster\",\n",
    "            \"final_target_celltype\",\n",
    "        ]\n",
    "    ]\n",
    "    .set_index(\n",
    "        \"cluster\"\n",
    "    )[\n",
    "        \"final_target_celltype\"\n",
    "    ]\n",
    "    .to_dict()\n",
    ")\n",
    "\n",
    "\n",
    "cells[\n",
    "    \"final_target_celltype\"\n",
    "] = (\n",
    "    cells[\n",
    "        \"cluster\"\n",
    "    ]\n",
    "    .map(\n",
    "        cluster_to_final\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert cells[\n",
    "    \"final_target_celltype\"\n",
    "].notna().all()\n",
    "\n",
    "\n",
    "TARGET_ORDER = [\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "    \"Other\",\n",
    "]\n",
    "\n",
    "\n",
    "final_counts = (\n",
    "    cells[\n",
    "        \"final_target_celltype\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .reindex(\n",
    "        TARGET_ORDER,\n",
    "        fill_value=0,\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert int(\n",
    "    final_counts.sum()\n",
    ") == 169506\n",    "\n",
    "\n",
    "EXPECTED_COUNTS = {\n",
    "    \"Astro\":\n",
    "        18688,\n",
    "\n",
    "    \"Micro\":\n",
    "        7909,\n",
    "\n",
    "    \"OPC\":\n",
    "        1303,\n",
    "\n",
    "    \"Oligo\":\n",
    "        41105,\n",
    "\n",
    "    \"Other\":\n",
    "        100501,\n",
    "}\n",
    "\n",
    "\n",
    "assert (\n",
    "    final_counts.to_dict()\n",
    "    ==\n",
    "    EXPECTED_COUNTS\n",
    ")\n",
    "\n",
    "\n",
    "# Save final cell labels BEFORE attaching diagnosis.\n",
    "FINAL_CELL_COLUMNS = [\n",
    "    \"donor_id\",\n",
    "    \"barcode\",\n",
    "    \"cell_uid\",\n",
    "    \"n_UMI\",\n",
    "    \"cluster\",\n",
    "    \"final_target_celltype\",\n",
    "]\n",
    "\n",
    "\n",
    "cells[\n",
    "    FINAL_CELL_COLUMNS\n",
    "].to_csv(\n",
    "    FINAL_CELL_LABEL_PATH,\n",
    "\n",
    "    index=False,\n",
    "\n",
    "    compression={\n",
    "        \"method\":\n",
    "            \"gzip\",\n",
    "\n",
    "        \"compresslevel\":\n",
    "            6,\n",
    "    },\n",
    ")\n",
    "\n",
    "\n",
    "counts_table = (\n",
    "    final_counts\n",
    "    .rename(\n",
    "        \"n_nuclei\"\n",
    "    )\n",
    "    .rename_axis(\n",
    "        \"cell_type\"\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "\n",
    "counts_table[\n",
    "    \"fraction\"\n",
    "] = (\n",
    "    counts_table[\n",
    "        \"n_nuclei\"\n",
    "    ]\n",
    "    /\n",
    "    169506\n",
    ")\n",
    "\n",
    "\n",
    "counts_table.to_csv(\n",
    "    FINAL_TARGET_COUNTS_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"FINAL TARGET COUNTS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    counts_table.to_string(\n",
    "        index=False\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. ANNOTATION QUALITY AUDIT AGAINST AUTHOR LABELS\n",
    "#\n",
    "# Mapping is already defined and cell labels already saved.\n",
    "#\n",
    "# Author proportions do NOT alter the mapping.\n",
    "# ============================================================\n",
    "\n",
    "author_by_donor = pd.read_csv(\n",
    "    AUTHOR_BENCHMARK_DONOR_PATH\n",
    ")\n",
    "\n",
    "\n",
    "final_counts_donor = (\n",
    "    pd.crosstab(\n",
    "        cells[\n",
    "            \"donor_id\"\n",
    "        ],\n",
    "\n",
    "        cells[\n",
    "            \"final_target_celltype\"\n",
    "        ],\n",
    "    )\n",
    "    .reindex(\n",
    "        columns=\n",
    "            TARGET_ORDER,\n",
    "\n",
    "        fill_value=0,\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "donor_total = (\n",
    "    final_counts_donor.sum(\n",
    "        axis=1\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "final_pct = (\n",
    "    final_counts_donor\n",
    "    .div(\n",
    "        donor_total,\n",
    "        axis=0,\n",
    "    )\n",
    "    *\n",
    "    100.0\n",
    ")\n",
    "\n",
    "\n",
    "audit = pd.DataFrame(\n",
    "    {\n",
    "        \"donor_id\":\n",
    "            final_pct.index.astype(\n",
    "                str\n",
    "            )\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "audit[\n",
    "    \"final_Astro_pct\"\n",
    "] = (\n",
    "    final_pct[\n",
    "        \"Astro\"\n",
    "    ]\n",
    "    .to_numpy(\n",
    "        dtype=float\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "audit[\n",
    "    \"final_Micro_pct\"\n",
    "] = (\n",
    "    final_pct[\n",
    "        \"Micro\"\n",
    "    ]\n",
    "    .to_numpy(\n",
    "        dtype=float\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "audit[\n",
    "    \"final_Oligo_lineage_pct\"\n",
    "] = (\n",
    "    (\n",
    "        final_pct[\n",
    "            \"OPC\"\n",
    "        ]\n",
    "        +\n",
    "        final_pct[\n",
    "            \"Oligo\"\n",
    "        ]\n",
    "    )\n",
    "    .to_numpy(\n",
    "        dtype=float\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "audit = audit.merge(\n",
    "    author_by_donor[\n",
    "        [\n",
    "            \"donor_id\",\n",
    "            \"author_Astro_pct\",\n",
    "            \"author_Micro_pct\",\n",
    "            \"author_Oligo_pct\",\n",
    "        ]\n",
    "    ],\n",
    "\n",
    "    on=\n",
    "        \"donor_id\",\n",
    "\n",
    "    how=\n",
    "        \"left\",\n",
    "\n",
    "    validate=\n",
    "        \"one_to_one\",\n",
    ")\n",
    "\n",
    "\n",
    "benchmark_rows = []\n",
    "\n",
    "\n",
    "for label, reconstructed_col, author_col in [\n",
    "    (\n",
    "        \"Astro_final_high_confidence\",\n",
    "        \"final_Astro_pct\",\n",
    "        \"author_Astro_pct\",\n",
    "    ),\n",
    "\n",
    "    (\n",
    "        \"Micro_final\",\n",
    "        \"final_Micro_pct\",\n",
    "        \"author_Micro_pct\",\n",
    "    ),\n",
    "\n",
    "    (\n",
    "        \"Oligo_lineage_OPC_plus_Oligo\",\n",
    "        \"final_Oligo_lineage_pct\",\n",
    "        \"author_Oligo_pct\",\n",
    "    ),\n",
    "]:\n",
    "\n",
    "    reconstructed = audit[\n",
    "        reconstructed_col\n",
    "    ].to_numpy(\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "    author = audit[\n",
    "        author_col\n",
    "    ].to_numpy(\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "\n",
    "    benchmark_rows.append(\n",
    "        {\n",
    "            \"comparison\":\n",
    "                label,\n",
    "\n",
    "            \"pearson_across_21_donors\":\n",
    "                safe_pearson(\n",
    "                    reconstructed,\n",
    "                    author,\n",
    "                ),\n",
    "\n",
    "            \"MAE_percentage_points\":\n",
    "                float(\n",
    "                    np.mean(\n",
    "                        np.abs(\n",
    "                            reconstructed\n",
    "                            -\n",
    "                            author\n",
    "                        )\n",
    "                    )\n",
    "                ),\n",
    "\n",
    "            \"mean_reconstructed_pct\":\n",
    "                float(\n",
    "                    np.mean(\n",
    "                        reconstructed\n",
    "                    )\n",
    "                ),\n",
    "\n",
    "            \"mean_author_pct\":\n",
    "                float(\n",
    "                    np.mean(\n",
    "                        author\n",
    "                    )\n",
    "                ),\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "final_author_benchmark = pd.DataFrame(\n",
    "    benchmark_rows\n",
    ")\n",
    "\n",
    "\n",
    "final_author_benchmark.to_csv(\n",
    "    FINAL_AUTHOR_BENCHMARK_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"POST-MAPPING AUTHOR BENCHMARK\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    final_author_benchmark.to_string(\n",
    "        index=False\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. ONLY NOW ATTACH DIAGNOSIS FOR COVERAGE REPORTING\n",
    "# ============================================================\n",
    "\n",
    "donor_meta = pd.read_csv(\n",
    "    DONOR_METADATA_PATH\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    donor_meta\n",
    ") == 21\n",
    "\n",
    "\n",
    "coverage = (\n",
    "    final_counts_donor\n",
    "    .reset_index()\n",
    "    .merge(\n",
    "        donor_meta[\n",
    "            [\n",
    "                \"donor_id\",\n",
    "                \"diagnosis_binary\",\n",
    "            ]\n",
    "        ],\n",
    "\n",
    "        on=\n",
    "            \"donor_id\",\n",
    "\n",
    "        how=\n",
    "            \"left\",\n",
    "\n",
    "        validate=\n",
    "            \"one_to_one\",\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "coverage = coverage[\n",
    "    [\n",
    "        \"donor_id\",\n",
    "        \"diagnosis_binary\",\n",
    "        \"Astro\",\n",
    "        \"Micro\",\n",
    "        \"OPC\",\n",
    "        \"Oligo\",\n",
    "        \"Other\",\n",
    "    ]\n",
    "]\n",
    "\n",
    "\n",
    "assert coverage[\n",
    "    \"diagnosis_binary\"\n",
    "].notna().all()\n",
    "\n",
    "\n",
    "coverage.to_csv(\n",
    "    FINAL_DONOR_COVERAGE_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. THRESHOLD DIAGNOSTIC ONLY\n",
    "#\n",
    "# IMPORTANT:\n",
    "# Nothing here freezes the eventual donor threshold.\n",
    "# That is the NEXT step.\n",
    "# ============================================================\n",
    "\n",
    "coverage_rows = []\n",
    "\n",
    "\n",
    "for cell_type in [\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "]:\n",
    "\n",
    "    for threshold in [\n",
    "        10,\n",
    "        20,\n",
    "        50,\n",
    "        100,\n",
    "    ]:\n",
    "\n",
    "        eligible = (\n",
    "            coverage[\n",
    "                cell_type\n",
    "            ]\n",
    "            >=\n",
    "            threshold\n",
    "        )\n",
    "\n",
    "\n",
    "        subset = coverage.loc[\n",
    "            eligible\n",
    "        ]\n",
    "\n",
    "\n",
    "        coverage_rows.append(\n",
    "            {\n",
    "                \"cell_type\":\n",
    "                    cell_type,\n",
    "\n",
    "                \"minimum_nuclei_candidate\":\n",
    "                    threshold,\n",
    "\n",
    "                \"eligible_donors\":\n",
    "                    int(\n",
    "                        eligible.sum()\n",
    "                    ),\n",
    "\n",
    "                \"eligible_AD\":\n",
    "                    int(\n",
    "                        (\n",
    "                            subset[\n",
    "                                \"diagnosis_binary\"\n",
    "                            ]\n",
    "                            ==\n",
    "                            \"AD\"\n",
    "                        ).sum()\n",
    "                    ),\n",
    "\n",
    "                \"eligible_Control\":\n",
    "                    int(\n",
    "                        (\n",
    "                            subset[\n",
    "                                \"diagnosis_binary\"\n",
    "                            ]\n",
    "                            ==\n",
    "                            \"Control\"\n",
    "                        ).sum()\n",
    "                    ),\n",
    "\n",
    "                \"minimum_observed_nuclei\":\n",
    "                    int(\n",
    "                        coverage[\n",
    "                            cell_type\n",
    "                        ].min()\n",
    "                    ),\n",
    "\n",
    "                \"median_observed_nuclei\":\n",
    "                    float(\n",
    "                        coverage[\n",
    "                            cell_type\n",
    "                        ].median()\n",
    "                    ),\n",
    "\n",
    "                \"maximum_observed_nuclei\":\n",
    "                    int(\n",
    "                        coverage[\n",
    "                            cell_type\n",
    "                        ].max()\n",
    "                    ),\n",
    "\n",
    "                \"threshold_frozen\":\n",
    "                    False,\n",
    "            }\n",
    "        )\n",
    "\n",
    "\n",
    "coverage_diagnostic = pd.DataFrame(\n",
    "    coverage_rows\n",
    ")\n",
    "\n",
    "\n",
    "coverage_diagnostic.to_csv(\n",
    "    FINAL_COVERAGE_DIAGNOSTIC_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"FINAL TARGET DONOR COVERAGE\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    coverage.to_string(\n",
    "        index=False\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nThreshold diagnostic — NOT YET FROZEN:\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    coverage_diagnostic.to_string(\n",
    "        index=False\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. HASH FINAL MAPPING OUTPUTS\n",
    "# ============================================================\n",
    "\n",
    "OUTPUT_HASHES = {\n",
    "    \"cluster_mapping\":\n",
    "        sha256_file(\n",
    "            FINAL_CLUSTER_MAPPING_PATH\n",
    "        ),\n",
    "\n",
    "    \"final_cell_labels\":\n",
    "        sha256_file(\n",
    "            FINAL_CELL_LABEL_PATH\n",
    "        ),\n",
    "\n",
    "    \"final_target_counts\":\n",
    "        sha256_file(\n",
    "            FINAL_TARGET_COUNTS_PATH\n",
    "        ),\n",
    "\n",
    "    \"final_donor_coverage\":\n",
    "        sha256_file(\n",
    "            FINAL_DONOR_COVERAGE_PATH\n",
    "        ),\n",
    "\n",
    "    \"coverage_threshold_diagnostic\":\n",
    "        sha256_file(\n",
    "            FINAL_COVERAGE_DIAGNOSTIC_PATH\n",
    "        ),\n",
    "\n",
    "    \"final_author_benchmark\":\n",
    "        sha256_file(\n",
    "            FINAL_AUTHOR_BENCHMARK_PATH\n",
    "        ),\n",
    "}\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 12. FREEZE STEP26B\n",
    "# ============================================================\n",
    "\n",
    "LOCK = {\n",
    "    \"dataset\":\n",
    "        \"GSE157827\",\n",
    "\n",
    "    \"created_utc\":\n",
    "        datetime.now(\n",
    "            timezone.utc\n",
    "        ).isoformat(),\n",
    "\n",
    "    \"status\":\n",
    "        \"AD_REPLICATION_FINAL_CELLTYPE_MAPPING_FROZEN\",\n",
    "\n",
    "    \"role\":\n",
    "        \"primary_AD_brain_replication\",\n",
    "\n",
    "    \"upstream_provisional_annotation_lock\":\n",
    "        str(\n",
    "            STEP26A_LOCK\n",
    "        ),\n",
    "\n",
    "    \"upstream_provisional_annotation_lock_sha256\":\n",
    "        sha256_file(\n",
    "            STEP26A_LOCK\n",
    "        ),\n",
    "\n",
    "    \"input_QC_pass_nuclei\":\n",
    "        169506,\n",
    "\n",
    "    \"mapping_is_disease_blind\":\n",
    "        True,\n",
    "\n",
    "    \"diagnosis_used_in_mapping\":\n",
    "        False,\n",
    "\n",
    "    \"author_proportions_used_to_change_mapping\":\n",
    "        False,\n",
    "\n",
    "    \"diagnosis_first_attached_for\":\n",
    "        \"post_mapping_donor_coverage_only\",\n",
    "\n",
    "    \"final_target_classes\":\n",
    "        [\n",
    "            \"Astro\",\n",
    "            \"Micro\",\n",
    "            \"OPC\",\n",
    "            \"Oligo\",\n",
    "        ],\n",
    "\n",
    "    \"final_mapping_rule\": {\n",
    "        \"Astro\":\n",
    "            \"broad Astro AND broad_score_margin >= 0.5\",\n",
    "\n",
    "        \"Micro\":\n",
    "            \"broad Micro AND broad_score_margin >= 0.5\",\n",
    "\n",
    "        \"OPC\":\n",
    "            (\n",
    "                \"broad Oligo AND disease-blind \"\n",
    "                \"oligo_lineage_candidate == OPC_candidate\"\n",
    "            ),\n",
    "\n",
    "        \"Oligo\":\n",
    "            (\n",
    "                \"broad Oligo AND \"\n",
    "                \"oligo_lineage_candidate == Oligo_candidate \"\n",
    "                \"AND broad_score_margin >= 0.5\"\n",
    "            ),\n",
    "\n",
    "        \"Other\":\n",
    "            \"all remaining nuclei\",\n",
    "    },\n",
    "\n",
    "    \"final_cluster_assignments\": {\n",
    "        \"Astro\":\n",
    "            [\n",
    "                \"17\",\n",
    "                \"19\",\n",
    "                \"20\",\n",
    "            ],\n",
    "\n",
    "        \"Micro\":\n",
    "            [\n",
    "                \"6\",\n",
    "            ],\n",
    "\n",
    "        \"OPC\":\n",
    "            [\n",
    "                \"10\",\n",
    "            ],\n",
    "\n",
    "        \"Oligo\":\n",
    "            [\n",
    "                \"7\",\n",
    "                \"8\",\n",
    "                \"9\",\n",
    "            ],\n",
    "    },\n",
    "\n",
    "    \"ambiguous_clusters_excluded_from_target_replication\": {\n",
    "        \"Astro_low_margin\":\n",
    "            [\n",
    "                \"18\",\n",
    "                \"23\",\n",
    "                \"27\",\n",
    "            ],\n",
    "    },\n",
    "\n",
    "    \"OPC_decision\": {\n",
    "        \"cluster\":\n",
    "            \"10\",\n",
    "\n",
    "        \"broad_label\":\n",
    "            \"Oligo\",\n",
    "\n",
    "        \"broad_margin_below_0_5\":\n",
    "            True,\n",
    "\n",
    "        \"retained_despite_broad_margin\":\n",
    "            True,\n",
    "\n",
    "        \"reason\":\n",
    "            (\n",
    "                \"Independent prespecified oligodendroglial-lineage \"\n",
    "                \"rule supports OPC: OPC module exceeds mature-Oligo \"\n",
    "                \"module and >=2 OPC core markers are positive.\"\n",
    "            ),\n",
    "\n",
    "        \"extra_clusters_added_to_rescue_OPC_sample_size\":\n",
    "            False,\n",
    "    },\n",
    "\n",
    "    \"final_target_counts\":\n",
    "        {\n",
    "            key:\n",
    "                int(\n",
    "                    value\n",
    "                )\n",
    "\n",
    "            for key, value\n",
    "            in final_counts.items()\n",
    "        },\n",
    "\n",
    "    \"donor_threshold_frozen\":\n",
    "        False,\n",
    "\n",
    "    \"donor_exclusions_frozen\":\n",
    "        False,\n",
    "\n",
    "    \"DE_gene_universe_frozen\":\n",
    "        False,\n",
    "\n",
    "    \"pseudobulk_built\":\n",
    "        False,\n",
    "\n",
    "    \"replication_DE_performed\":\n",
    "        False,\n",
    "\n",
    "    \"discovery_vs_replication_compared\":\n",
    "        False,\n",
    "\n",
    "    \"PD_data_loaded\":\n",
    "        False,\n",
    "\n",
    "    \"AD_PD_convergence_performed\":\n",
    "        False,\n",
    "\n",
    "    \"outputs\": {\n",
    "        \"cluster_mapping\":\n",
    "            str(\n",
    "                FINAL_CLUSTER_MAPPING_PATH\n",
    "            ),\n",
    "\n",
    "        \"final_cell_labels\":\n",
    "            str(\n",
    "                FINAL_CELL_LABEL_PATH\n",
    "            ),\n",
    "\n",
    "        \"final_target_counts\":\n",
    "            str(\n",
    "                FINAL_TARGET_COUNTS_PATH\n",
    "            ),\n",
    "\n",
    "        \"final_donor_coverage\":\n",
    "            str(\n",
    "                FINAL_DONOR_COVERAGE_PATH\n",
    "            ),\n",
    "\n",
    "        \"coverage_threshold_diagnostic\":\n",
    "            str(\n",
    "                FINAL_COVERAGE_DIAGNOSTIC_PATH\n",
    "            ),\n",
    "\n",
    "        \"final_author_benchmark\":\n",
    "            str(\n",
    "                FINAL_AUTHOR_BENCHMARK_PATH\n",
    "            ),\n",
    "    },\n",
    "\n",
    "    \"output_sha256\":\n",
    "        OUTPUT_HASHES,\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    STEP26B_LOCK,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as handle:\n",
    "\n",
    "    json.dump(\n",
    "        LOCK,\n",
    "        handle,\n",
    "        indent=2,\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 13. FINAL VERIFICATION\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    STEP26B_LOCK,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as handle:\n",
    "\n",
    "    verify = json.load(\n",
    "        handle\n",
    "    )\n",
    "\n",
    "\n",
    "assert (\n",
    "    verify[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"AD_REPLICATION_FINAL_CELLTYPE_MAPPING_FROZEN\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    verify[\n",
    "        \"mapping_is_disease_blind\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    verify[\n",
    "        \"diagnosis_used_in_mapping\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    verify[\n",
    "        \"donor_threshold_frozen\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    verify[\n",
    "        \"pseudobulk_built\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    verify[\n",
    "        \"replication_DE_performed\"\n",
    "    ]\n",
