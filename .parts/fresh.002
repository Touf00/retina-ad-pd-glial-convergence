    "        0,\n",
    "\n",
    "    \"Oligo\":\n",
    "        18,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. LOAD STORED STEP-22 SUMMARIES\n",
    "# ============================================================\n",
    "\n",
    "stored_FDR_summary = pd.read_csv(\n",
    "    FDR_SUMMARY_PATH\n",
    ")\n",
