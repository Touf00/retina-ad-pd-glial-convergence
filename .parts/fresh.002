    "# Source analysis cell: 51\n",
    "# ============================================================\n",
    "# V2 STEP 28 — GSE157827 PRIMARY + PMD REPLICATION DE\n",
    "# ============================================================\n",
    "import sys, subprocess, importlib.metadata, json, hashlib\n",
    "from pathlib import Path\n",
    "TARGET={'pandas':'2.3.3','pydeseq2':'0.5.4'}\n",
    "for p,v in TARGET.items():\n",
    "    try: cur=importlib.metadata.version(p)\n",
    "    except: cur=None\n",
    "    if cur!=v: subprocess.check_call([sys.executable,'-m','pip','install','-q',f'{p}=={v}'])\n",
    "\n",
    "# Run in a fresh subprocess so package updates cannot leave stale imports.\n",
    "runner=ROOT/'scripts'/'STEP28_GSE157827_V2.py'; log=ROOT/'logs'/'STEP28_GSE157827_V2.log'\n",
    "runner.parent.mkdir(exist_ok=True); log.parent.mkdir(exist_ok=True)\n",
    "RUNNER=r'''\\\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "import json, hashlib, numpy as np, pandas as pd\n",
    "from pydeseq2.dds import DeseqDataSet\n",
    "from pydeseq2.ds import DeseqStats\n",
    "ROOT=Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"]); LOCKS=ROOT/'locks'\n",
    "with open(LOCKS/'GSE157827_AD_REPLICATION_PRE_DE_PSEUDOBULK_AND_GENE_UNIVERSE_FREEZE_v1.json') as f: pre=json.load(f)\n",
    "assert pre['status']=='AD_REPLICATION_PRE_DE_PSEUDOBULK_AND_GENE_UNIVERSE_FROZEN'\n",
    "out=ROOT/'AD_replication_frozen'; out.mkdir(parents=True,exist_ok=True)\n",
    "classes=['Astro','Micro','OPC','Oligo']; prim_all=[]; pmd_all=[]; summary=[]\n",
    "def sha(p):\n",
    " h=hashlib.sha256();\n",
    " with open(p,'rb') as f:\n",
    "  for b in iter(lambda:f.read(4*1024*1024),b''): h.update(b)\n",
    " return h.hexdigest()\n",
    "def fit(counts,meta,formula):\n",
    " dds=DeseqDataSet(counts=counts,metadata=meta,design=formula,refit_cooks=True,n_cpus=2,quiet=False); dds.deseq2()\n",
    " st=DeseqStats(dds,contrast=['diagnosis_binary','AD','Control'],alpha=.05,cooks_filter=True,independent_filter=True,n_cpus=2,quiet=False); st.summary()\n",
    " r=st.results_df.copy(); r.index=r.index.astype(str); r.index.name='gene_id'; return r.reset_index()\n",
    "for ct in classes:\n",
    " rec=pre['cell_type_gene_universes'][ct]\n",
    " raw=pd.read_csv(rec['filtered_pseudobulk_file'])\n",
    " meta=pd.read_csv(rec['eligible_donor_metadata_file'])\n",
    " ids=raw['gene_id'].astype(str).tolist(); syms=dict(zip(ids,raw['gene_symbol'].astype(str)))\n",
    " groups=meta['group_id'].astype(str).tolist(); counts=raw[groups].T; counts.columns=ids; counts=counts.astype(np.int64)\n",
    " def mk(cols):\n",
    "  m=meta[['group_id']+cols].copy(); m.index=m['group_id'].astype(str); m=m.drop(columns='group_id')\n",
    "  m['age']=pd.to_numeric(m['age']); m['sex']=pd.Categorical(m['sex'].astype(str),categories=['Female','Male']); m['diagnosis_binary']=pd.Categorical(m['diagnosis_binary'].astype(str),categories=['Control','AD'])\n",
    "  if 'PMD_hours' in m: m['PMD_hours']=pd.to_numeric(m['PMD_hours'])\n",
    "  return m\n",
    " p=fit(counts,mk(['age','sex','diagnosis_binary']),'~ age + sex + diagnosis_binary'); s=fit(counts,mk(['age','sex','PMD_hours','diagnosis_binary']),'~ age + sex + PMD_hours + diagnosis_binary')\n",
    " for tab,label,store in [(p,'PRIMARY',prim_all),(s,'PMD',pmd_all)]:\n",
    "  tab.insert(1,'gene_symbol',[syms[x] for x in tab['gene_id']]); tab['cell_type']=ct; tab['analysis_model']=label; tab['contrast']='AD_vs_Control'; store.append(tab)\n",
    " pf=int((p.padj<.05).fillna(False).sum()); sf=int((s.padj<.05).fillna(False).sum())\n",
    " summary.append({'cell_type':ct,'n_donors':len(meta),'AD':int((meta.diagnosis_binary=='AD').sum()),'Control':int((meta.diagnosis_binary=='Control').sum()),'tested_genes':len(ids),'primary_FDR':pf,'PMD_FDR':sf})\n",
    "P=pd.concat(prim_all,ignore_index=True); S=pd.concat(pmd_all,ignore_index=True)\n",
    "pp=out/'GSE157827_AD_REPLICATION_PRIMARY_ALL_EFFECTS_LONG_v1.csv.gz'; sp=out/'GSE157827_AD_REPLICATION_PMD_ALL_EFFECTS_LONG_v1.csv.gz'\n",
    "P.to_csv(pp,index=False,compression='gzip'); S.to_csv(sp,index=False,compression='gzip')\n",
    "summary=pd.DataFrame(summary); summary.to_csv(out/'GSE157827_AD_REPLICATION_PRIMARY_AND_PMD_SUMMARY_v1.csv',index=False)\n",
    "if True:\n",
    " exp={'Astro':0,'Micro':0,'OPC':0,'Oligo':4}; got=dict(zip(summary.cell_type,summary.primary_FDR)); assert got==exp,(got,exp)\n",
    "lock={'dataset':'GSE157827','created_utc':datetime.now(timezone.utc).isoformat(),'status':'AD_REPLICATION_PRIMARY_AND_PMD_EFFECTS_FROZEN','primary_effects_frozen':True,'PMD_effects_frozen':True,'primary_all_effects':str(pp),'primary_all_effects_sha256':sha(pp),'PMD_all_effects':str(sp),'PMD_all_effects_sha256':sha(sp),'summary':summary.to_dict('records'),'discovery_vs_replication_compared':False,'AD_PD_convergence_performed':False}\n",
    "with open(LOCKS/'GSE157827_AD_REPLICATION_STEP28_EFFECTS_FREEZE_v1.json','w') as f: json.dump(lock,f,indent=2)\n",
    "print('STEP 28 PASS — GSE157827 PRIMARY + PMD EFFECTS FROZEN'); print(summary.to_string(index=False))\n",
    "'''\n",
    "runner.write_text(RUNNER)\n",
    "with open(log,'w') as lf:\n",
    "    p=subprocess.Popen([sys.executable,'-u',str(runner)],stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True)\n",
    "    for line in p.stdout: print(line,end=''); lf.write(line)\n",
    "    rc=p.wait()\n",
    "assert rc==0,f'Step28 failed; see {log}'"
   ]
  },
