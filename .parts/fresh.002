    "            n_finite_padj,\n",
    "\n",
    "        \"FDR_lt_0.05\":\n",
    "            n_sig,\n",
    "\n",
    "        \"up_in_AD\":\n",
    "            n_up,\n",
    "\n",
    "        \"down_in_AD\":\n",
    "            n_down,\n",
    "\n",
    "        \"zero_LFC_FDR\":\n",
    "            n_zero,\n",
    "\n",
    "        \"min_pvalue\":\n",
