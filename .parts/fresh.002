    "combined_stored_hits = pd.read_csv(\n",
    "    COMBINED_HIT_SUPPORT_PATH,\n",
    "    compression=\"gzip\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    stored_FDR_summary[\n",
    "        \"cell_type\"\n",
    "    ].tolist()\n",
    "    ==\n",
    "    CLASSES\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    stored_concordance[\n",
    "        \"cell_type\"\n",
    "    ].tolist()\n",
    "    ==\n",
    "    CLASSES\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    stored_support_summary[\n",
    "        \"cell_type\"\n",
    "    ].tolist()\n",
    "    ==\n",
    "    CLASSES\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    combined_stored_hits\n",
    ") == 34\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. VERIFY ACTUAL STEP-22 PER-GENE SCHEMA\n",
    "# ============================================================\n",
    "\n",
    "required_actual_step22_columns = {\n",
    "\n",
    "    \"RIN_same_direction\",\n",
    "    \"RIN_nominal_p_lt_0.05\",\n",    "    \"RIN_FDR_lt_0.05\",\n",
    "    \"RIN_supported\",\n",
    "\n",
    "    \"PMI_same_direction\",\n",
    "    \"PMI_nominal_p_lt_0.05\",\n",
    "    \"PMI_FDR_lt_0.05\",\n",
    "    \"PMI_supported\",\n",
    "\n",
    "    \"RIN_and_PMI_supported\",\n",
    "\n",
    "    # THIS IS THE ACTUAL STEP-22 STORED NAME:\n",
    "    \"RIN_and_PMI_FDR\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "assert (\n",
    "    required_actual_step22_columns\n",
    "    <=\n",
    "    set(\n",
    "        combined_stored_hits.columns\n",
    "    )\n",
    "), (\n",
    "    \"STEP-22 combined support table does not have \"\n",
    "    \"the expected actual schema.\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nActual STEP-22 combined-support schema verified.\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Stored combined FDR flag: RIN_and_PMI_FDR\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. AUDIT EACH CELL CLASS\n",
    "# ============================================================\n",
    "\n",
    "audit_rows = []\n",
    "\n",
    "exact_hit_tables = []\n",
    "\n",
    "\n",
    "for cell_type in CLASSES:\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\n\"\n",
    "        +\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        cell_type\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 7.1 RECORDS\n",
    "    # ========================================================\n",
    "\n",
    "    universe_record = (\n",
    "        pre_de_lock[\n",
    "            \"cell_class_gene_universes\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    primary_record = (\n",
    "        primary_lock[\n",
    "            \"cell_class_results\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    sensitivity_record = (\n",
    "        sensitivity_lock[\n",
    "            \"cell_class_results\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 7.2 FILES\n",
    "    # ========================================================\n",
    "\n",
    "    universe_path = Path(\n",
    "        universe_record[\n",
    "            \"gene_universe_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    primary_path = Path(\n",
    "        primary_record[\n",
    "            \"all_gene_results\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    RIN_path = Path(\n",
    "        sensitivity_record[\n",
    "            \"RIN\"\n",
    "        ][\n",
    "            \"all_gene_result\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    PMI_path = Path(\n",
    "        sensitivity_record[\n",
    "            \"PMI\"\n",
    "        ][\n",
    "            \"all_gene_result\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    stored_hit_path = Path(\n",
    "        sensitivity_record[\n",
    "            \"primary_FDR_support\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    stored_comparison_path = Path(\n",
    "        sensitivity_record[\n",
    "            \"primary_vs_sensitivity_comparison\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    for path in [\n",
    "\n",
    "        universe_path,\n",
    "        primary_path,\n",
    "        RIN_path,\n",
    "        PMI_path,\n",
    "        stored_hit_path,\n",
    "        stored_comparison_path,\n",
    "\n",
    "    ]:\n",
    "\n",
    "        assert path.exists(), (\n",
    "            f\"Missing required file: {path}\"\n",
    "        )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 7.3 HASH VERIFICATION\n",
    "    # ========================================================\n",
    "\n",
    "    assert (\n",
    "        sha256_file(\n",
    "            primary_path\n",
    "        )\n",
    "        ==\n",
    "        primary_record[\n",
    "            \"all_gene_results_sha256\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        sha256_file(\n",
    "            RIN_path\n",
    "        )\n",
    "        ==\n",
    "        sensitivity_record[\n",
    "            \"RIN\"\n",
    "        ][\n",
    "            \"all_gene_result_sha256\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        sha256_file(\n",
    "            PMI_path\n",
    "        )\n",
    "        ==\n",
    "        sensitivity_record[\n",
    "            \"PMI\"\n",
    "        ][\n",
    "            \"all_gene_result_sha256\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Primary hash: PASS\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"RIN hash: PASS\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"PMI hash: PASS\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 7.4 LOAD TABLES\n",
    "    # ========================================================\n",
    "\n",
    "    universe = pd.read_csv(\n",
    "        universe_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    primary = pd.read_csv(\n",
    "        primary_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    RIN = pd.read_csv(\n",
    "        RIN_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    PMI = pd.read_csv(\n",
    "        PMI_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    stored_hits = pd.read_csv(\n",
    "        stored_hit_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    stored_comparison = pd.read_csv(\n",
    "        stored_comparison_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    expected_n = int(\n",
    "        universe_record[\n",
    "            \"frozen_AD_discovery_gene_universe\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        universe\n",
    "    ) == expected_n\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        primary\n",
    "    ) == expected_n\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        RIN\n",
    "    ) == expected_n\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        PMI\n",
    "    ) == expected_n\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        stored_comparison\n",
    "    ) == expected_n\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 7.5 EXACT FROZEN GENE UNIVERSE\n",
    "    # ========================================================\n",
    "\n",
    "    universe_ids = (\n",
    "        universe[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        primary[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "        ==\n",
    "        universe_ids\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        RIN[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "        ==\n",
    "        universe_ids\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        PMI[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "        ==\n",
    "        universe_ids\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Frozen universe identity: PASS\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 7.6 REBUILD PRIMARY + RIN + PMI TABLE\n",
    "    # ========================================================\n",
    "\n",
    "    comparison = (\n",
    "\n",
    "        primary[\n",
    "            [\n",
    "                \"gene_id\",\n",
    "                \"gene_symbol\",\n",
    "                \"gene_symbol_unique_in_GSE174367\",\n",
    "                \"log2FoldChange\",\n",
    "                \"stat\",\n",
    "                \"pvalue\",\n",
    "                \"padj\",\n",
    "            ]\n",
    "        ]\n",
    "        .rename(\n",
    "            columns={\n",
    "\n",
    "                \"log2FoldChange\":\n",
    "                    \"primary_LFC\",\n",
    "\n",
    "                \"stat\":\n",
    "                    \"primary_Wald\",\n",
    "\n",
    "                \"pvalue\":\n",
    "                    \"primary_p\",\n",
    "\n",
    "                \"padj\":\n",
    "                    \"primary_padj\",\n",
    "\n",
    "            }\n",
    "        )\n",
    "\n",
    "        .merge(\n",
    "\n",
    "            RIN[\n",
    "                [\n",
    "                    \"gene_id\",\n",
    "                    \"log2FoldChange\",\n",
    "                    \"stat\",\n",
    "                    \"pvalue\",\n",
    "                    \"padj\",\n",
    "                ]\n",
    "            ]\n",
    "            .rename(\n",
    "                columns={\n",
    "\n",
    "                    \"log2FoldChange\":\n",
    "                        \"RIN_LFC\",\n",
    "\n",
    "                    \"stat\":\n",
    "                        \"RIN_Wald\",\n",
    "\n",
    "                    \"pvalue\":\n",
    "                        \"RIN_p\",\n",
    "\n",
    "                    \"padj\":\n",
    "                        \"RIN_padj\",\n",
    "\n",
    "                }\n",
    "            ),\n",
    "\n",
    "            on=\"gene_id\",\n",
    "\n",
    "            how=\"inner\",\n",
    "\n",
    "            validate=\"one_to_one\"\n",
    "\n",
    "        )\n",
    "\n",
    "        .merge(\n",
    "\n",
    "            PMI[\n",
    "                [\n",
    "                    \"gene_id\",\n",
    "                    \"log2FoldChange\",\n",
    "                    \"stat\",\n",
    "                    \"pvalue\",\n",
    "                    \"padj\",\n",
    "                ]\n",
    "            ]\n",
    "            .rename(\n",
    "                columns={\n",
    "\n",
    "                    \"log2FoldChange\":\n",
    "                        \"PMI_LFC\",\n",
    "\n",
    "                    \"stat\":\n",
    "                        \"PMI_Wald\",\n",
    "\n",
    "                    \"pvalue\":\n",
    "                        \"PMI_p\",\n",
    "\n",
    "                    \"padj\":\n",
    "                        \"PMI_padj\",\n",
    "\n",
    "                }\n",
    "            ),\n",
    "\n",
    "            on=\"gene_id\",\n",
    "\n",
    "            how=\"inner\",\n",
    "\n",
    "            validate=\"one_to_one\"\n",
    "\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        comparison\n",
    "    ) == expected_n\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 7.7 VERIFY STORED ALL-GENE COMPARISON NUMERICALLY\n",
    "    # ========================================================\n",
    "\n",
    "    assert (\n",
    "        stored_comparison[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "        ==\n",
    "        comparison[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    numeric_comparison_columns = [\n",
    "\n",
    "        \"primary_LFC\",\n",
    "        \"primary_Wald\",\n",
    "        \"primary_p\",\n",
    "        \"primary_padj\",\n",
    "\n",
    "        \"RIN_LFC\",\n",
    "        \"RIN_Wald\",\n",
    "        \"RIN_p\",\n",
    "        \"RIN_padj\",\n",
    "\n",
    "        \"PMI_LFC\",\n",
    "        \"PMI_Wald\",\n",
    "        \"PMI_p\",\n",
    "        \"PMI_padj\",\n",
    "\n",
    "    ]\n",
    "\n",
    "\n",
    "    for column in numeric_comparison_columns:\n",
    "\n",
    "        assert np.allclose(\n",
    "\n",
    "            stored_comparison[\n",
    "                column\n",
    "            ]\n",
    "            .to_numpy(\n",
    "                dtype=float\n",
    "            ),\n",
    "\n",
    "            comparison[\n",
    "                column\n",
    "            ]\n",
    "            .to_numpy(\n",
    "                dtype=float\n",
    "            ),\n",
    "\n",
    "            equal_nan=True,\n",
    "\n",
    "            rtol=1e-12,\n",
    "\n",
    "            atol=1e-14,\n",
    "\n",
    "        ), (\n",
    "            f\"{cell_type}: stored comparison \"\n",
    "            f\"mismatch in {column}\"\n",
    "        )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Stored primary/RIN/PMI comparison identity: PASS\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 7.8 FDR COUNTS\n",
    "    # ========================================================\n",
    "\n",
    "    primary_FDR_mask = (\n",
    "\n",
    "        np.isfinite(\n",
    "            comparison[\n",
    "                \"primary_padj\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            comparison[\n",
    "                \"primary_padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    RIN_FDR_mask = (\n",
    "\n",
    "        np.isfinite(\n",
    "            comparison[\n",
    "                \"RIN_padj\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            comparison[\n",
    "                \"RIN_padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    PMI_FDR_mask = (\n",
    "\n",
    "        np.isfinite(\n",
    "            comparison[\n",
    "                \"PMI_padj\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            comparison[\n",
    "                \"PMI_padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_primary = int(\n",
    "        primary_FDR_mask.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_RIN = int(\n",
    "        RIN_FDR_mask.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_PMI = int(\n",
    "        PMI_FDR_mask.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_primary\n",
    "        ==\n",
    "        EXPECTED_PRIMARY_FDR[\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_RIN\n",
    "        ==\n",
    "        EXPECTED_RIN_FDR[\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_PMI\n",
    "        ==\n",
    "        EXPECTED_PMI_FDR[\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 7.9 REBUILD PRIMARY-HIT SUPPORT\n",
    "    # ========================================================\n",
    "\n",
    "    hits = (\n",
    "        comparison.loc[\n",
    "            primary_FDR_mask\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    hits[\n",
    "        \"RIN_same_direction\"\n",
    "    ] = (\n",
    "\n",
    "        np.sign(\n",
    "            hits[\n",
    "                \"primary_LFC\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        ==\n",
    "\n",
    "        np.sign(\n",
    "            hits[\n",
    "                \"RIN_LFC\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    hits[\n",
    "        \"RIN_nominal_p_lt_0.05\"\n",
    "    ] = (\n",
    "\n",
    "        np.isfinite(\n",
    "            hits[\n",
    "                \"RIN_p\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            hits[\n",
    "                \"RIN_p\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    hits[\n",
    "        \"RIN_FDR_lt_0.05\"\n",
    "    ] = (\n",
    "\n",
    "        np.isfinite(\n",
    "            hits[\n",
    "                \"RIN_padj\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            hits[\n",
    "                \"RIN_padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    hits[\n",
    "        \"RIN_supported\"\n",
    "    ] = (\n",
    "\n",
    "        hits[\n",
    "            \"RIN_same_direction\"\n",
    "        ]\n",
    "\n",
    "        &\n",
    "\n",
    "        hits[\n",
    "            \"RIN_nominal_p_lt_0.05\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    hits[\n",
    "        \"PMI_same_direction\"\n",
    "    ] = (\n",
    "\n",
    "        np.sign(\n",
    "            hits[\n",
    "                \"primary_LFC\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        ==\n",
    "\n",
    "        np.sign(\n",
    "            hits[\n",
    "                \"PMI_LFC\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    hits[\n",
    "        \"PMI_nominal_p_lt_0.05\"\n",
    "    ] = (\n",
    "\n",
    "        np.isfinite(\n",
    "            hits[\n",
    "                \"PMI_p\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            hits[\n",
    "                \"PMI_p\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    hits[\n",
    "        \"PMI_FDR_lt_0.05\"\n",
    "    ] = (\n",
    "\n",
    "        np.isfinite(\n",
    "            hits[\n",
    "                \"PMI_padj\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            hits[\n",
    "                \"PMI_padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    hits[\n",
    "        \"PMI_supported\"\n",
    "    ] = (\n",
    "\n",
    "        hits[\n",
    "            \"PMI_same_direction\"\n",
    "        ]\n",
    "\n",
    "        &\n",
    "\n",
    "        hits[\n",
    "            \"PMI_nominal_p_lt_0.05\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    hits[\n",
    "        \"RIN_and_PMI_supported\"\n",
    "    ] = (\n",
    "\n",
    "        hits[\n",
    "            \"RIN_supported\"\n",
    "        ]\n",
    "\n",
    "        &\n",
    "\n",
    "        hits[\n",
    "            \"PMI_supported\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Reproduce STEP-22 ACTUAL stored definition.\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    hits[\n",
    "        \"RIN_and_PMI_FDR\"\n",
    "    ] = (\n",
    "\n",
    "        hits[\n",
    "            \"RIN_same_direction\"\n",
    "        ]\n",
    "\n",
    "        &\n",
    "\n",
    "        hits[\n",
    "            \"PMI_same_direction\"\n",
    "        ]\n",
    "\n",
    "        &\n",
    "\n",
    "        hits[\n",
    "            \"RIN_FDR_lt_0.05\"\n",
    "        ]\n",
    "\n",
    "        &\n",
    "\n",
    "        hits[\n",
    "            \"PMI_FDR_lt_0.05\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Canonical clearer alias for final audited output.\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    hits[\n",
    "        \"RIN_and_PMI_same_direction_and_FDR\"\n",
    "    ] = (\n",
    "\n",
    "        hits[\n",
    "            \"RIN_and_PMI_FDR\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_both_supported = int(\n",
    "        hits[\n",
    "            \"RIN_and_PMI_supported\"\n",
    "        ].sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_both_FDR = int(\n",
    "        hits[\n",
    "            \"RIN_and_PMI_FDR\"\n",
    "        ].sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_both_supported\n",
    "        ==\n",
    "        EXPECTED_BOTH_SUPPORTED[\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_both_FDR\n",
    "        ==\n",
    "        EXPECTED_BOTH_FDR[\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 7.10 VERIFY ACTUAL STORED STEP-22 HIT TABLE\n",
    "    # ========================================================\n",
    "\n",
    "    assert len(\n",
    "        stored_hits\n",
    "    ) == n_primary\n",
    "\n",
    "\n",
    "    assert (\n",
    "        stored_hits[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "        ==\n",
    "        hits[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    actual_stored_boolean_columns = [\n",
    "\n",
    "        \"RIN_same_direction\",\n",
    "        \"RIN_nominal_p_lt_0.05\",\n",
    "        \"RIN_FDR_lt_0.05\",\n",
    "        \"RIN_supported\",\n",
    "\n",
    "        \"PMI_same_direction\",\n",
    "        \"PMI_nominal_p_lt_0.05\",\n",
    "        \"PMI_FDR_lt_0.05\",\n",
    "        \"PMI_supported\",\n",
    "\n",
    "        \"RIN_and_PMI_supported\",\n",
    "\n",
    "        # Actual saved STEP-22 name:\n",
    "        \"RIN_and_PMI_FDR\",\n",
    "\n",
    "    ]\n",
    "\n",
    "\n",
    "    for column in actual_stored_boolean_columns:\n",
    "\n",
    "        assert column in stored_hits.columns, (\n",
    "            f\"{cell_type}: expected stored STEP-22 \"\n",
    "            f\"column missing: {column}\"\n",
    "        )\n",
    "\n",
    "\n",
    "        stored_bool = as_bool(\n",
    "            stored_hits[\n",
    "                column\n",
    "            ]\n",
    "        )\n",
    "\n",
    "\n",
    "        rebuilt_bool = (\n",
    "            hits[\n",
    "                column\n",
    "            ]\n",
    "            .astype(\n",
    "                bool\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "        assert np.array_equal(\n",
    "\n",
    "            stored_bool.to_numpy(),\n",
    "\n",
    "            rebuilt_bool.to_numpy(),\n",
    "\n",
    "        ), (\n",
    "            f\"{cell_type}: stored STEP-22 support \"\n",
    "            f\"mismatch in {column}\"\n",
    "        )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Stored STEP-22 primary-hit support identity: PASS\"\n",
    "    )\n",
    "\n",    "\n",
    "    # ========================================================\n",
    "    # 7.11 ALL-GENE CONCORDANCE\n",
    "    # ========================================================\n",
    "\n",
    "    RIN_LFC_Pearson = safe_pearson(\n",
    "        comparison[\n",
    "            \"primary_LFC\"\n",
    "        ],\n",
    "        comparison[\n",
    "            \"RIN_LFC\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    RIN_LFC_Spearman = safe_spearman(\n",
    "        comparison[\n",
    "            \"primary_LFC\"\n",
    "        ],\n",
    "        comparison[\n",
    "            \"RIN_LFC\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    RIN_Wald_Spearman = safe_spearman(\n",
    "        comparison[\n",
    "            \"primary_Wald\"\n",
    "        ],\n",
    "        comparison[\n",
    "            \"RIN_Wald\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    RIN_direction = direction_fraction(\n",
    "        comparison[\n",
    "            \"primary_LFC\"\n",
    "        ],\n",
    "        comparison[\n",
    "            \"RIN_LFC\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    PMI_LFC_Pearson = safe_pearson(\n",
    "        comparison[\n",
    "            \"primary_LFC\"\n",
    "        ],\n",
    "        comparison[\n",
    "            \"PMI_LFC\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    PMI_LFC_Spearman = safe_spearman(\n",
    "        comparison[\n",
    "            \"primary_LFC\"\n",
    "        ],\n",
    "        comparison[\n",
    "            \"PMI_LFC\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    PMI_Wald_Spearman = safe_spearman(\n",
    "        comparison[\n",
    "            \"primary_Wald\"\n",
    "        ],\n",
    "        comparison[\n",
    "            \"PMI_Wald\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    PMI_direction = direction_fraction(\n",
    "        comparison[\n",
    "            \"primary_LFC\"\n",
    "        ],\n",
    "        comparison[\n",
    "            \"PMI_LFC\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 7.12 VERIFY STORED CONCORDANCE\n",
    "    # ========================================================\n",
    "\n",
    "    stored_concordance_row = (\n",
    "\n",
    "        stored_concordance[\n",
    "            stored_concordance[\n",
    "                \"cell_type\"\n",
    "            ]\n",
    "            ==\n",
    "            cell_type\n",
    "        ]\n",
    "        .iloc[\n",
    "            0\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    concordance_checks = {\n",
    "\n",
    "        \"primary_RIN_LFC_pearson\":\n",
    "            RIN_LFC_Pearson,\n",
    "\n",
    "        \"primary_RIN_LFC_spearman\":\n",
    "            RIN_LFC_Spearman,\n",
    "\n",
    "        \"primary_RIN_Wald_spearman\":\n",
    "            RIN_Wald_Spearman,\n",
    "\n",
    "        \"primary_RIN_direction_concordance\":\n",
    "            RIN_direction,\n",
    "\n",
    "        \"primary_PMI_LFC_pearson\":\n",
    "            PMI_LFC_Pearson,\n",
    "\n",
    "        \"primary_PMI_LFC_spearman\":\n",
    "            PMI_LFC_Spearman,\n",
    "\n",
    "        \"primary_PMI_Wald_spearman\":\n",
    "            PMI_Wald_Spearman,\n",
    "\n",
    "        \"primary_PMI_direction_concordance\":\n",
    "            PMI_direction,\n",
    "\n",
    "    }\n",
    "\n",
    "\n",
    "    for column, recalculated in (\n",
    "        concordance_checks.items()\n",
    "    ):\n",
    "\n",
    "        assert np.isclose(\n",
    "\n",
    "            float(\n",
    "                stored_concordance_row[\n",
    "                    column\n",
    "                ]\n",
    "            ),\n",
    "\n",
    "            recalculated,\n",
    "\n",
    "            rtol=1e-10,\n",
    "\n",
    "            atol=1e-12,\n",
    "\n",
    "        ), (\n",
    "            f\"{cell_type}: concordance mismatch \"\n",
    "            f\"in {column}\"\n",
    "        )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Stored concordance summary: PASS\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 7.13 VERIFY FDR SUMMARY\n",
    "    # ========================================================\n",
    "\n",
    "    stored_FDR_row = (\n",
    "\n",
    "        stored_FDR_summary[\n",
    "            stored_FDR_summary[\n",
    "                \"cell_type\"\n",
    "            ]\n",
    "            ==\n",
    "            cell_type\n",
    "        ]\n",
    "        .iloc[\n",
    "            0\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        stored_FDR_row[\n",
    "            \"primary_FDR\"\n",
    "        ]\n",
    "    ) == n_primary\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        stored_FDR_row[\n",
    "            \"RIN_FDR\"\n",
    "        ]\n",
    "    ) == n_RIN\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        stored_FDR_row[\n",
    "            \"PMI_FDR\"\n",
    "        ]\n",
    "    ) == n_PMI\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 7.14 VERIFY STORED SUPPORT SUMMARY\n",
    "    # ========================================================\n",
    "\n",
    "    stored_support_row = (\n",
    "\n",
    "        stored_support_summary[\n",
    "            stored_support_summary[\n",
    "                \"cell_type\"\n",
    "            ]\n",
    "            ==\n",
    "            cell_type\n",
    "        ]\n",
    "        .iloc[\n",
    "            0\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        stored_support_row[\n",
    "            \"primary_FDR\"\n",
    "        ]\n",
    "    ) == n_primary\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        stored_support_row[\n",
    "            \"RIN_and_PMI_supported\"\n",
    "        ]\n",
    "    ) == n_both_supported\n",
    "\n",
    "\n",
    "    # Summary uses the longer descriptive name.\n",
    "    assert int(\n",
    "        stored_support_row[\n",
    "            \"RIN_and_PMI_same_direction_and_FDR\"\n",
    "        ]\n",
    "    ) == n_both_FDR\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Stored FDR/support summaries: PASS\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 7.15 FINAL CLASS ANNOTATION\n",
    "    # ========================================================\n",
    "\n",
    "    hits.insert(\n",
    "        0,\n",
    "        \"cell_type\",\n",
    "        cell_type\n",
    "    )\n",
    "\n",
    "\n",
    "    hits[\n",
    "        \"technical_robustness\"\n",
    "    ] = np.where(\n",
    "\n",
    "        hits[\n",
    "            \"RIN_and_PMI_FDR\"\n",
    "        ],\n",
    "\n",
    "        \"SUPPORTED_AND_FDR_IN_BOTH\",\n",
    "\n",
    "        \"SUPPORTED_NOMINALLY_IN_BOTH\",\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    exact_hit_tables.append(\n",
    "        hits\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 7.16 AUDIT ROW\n",
    "    # ========================================================\n",
    "\n",
    "    audit_rows.append({\n",
    "\n",
    "        \"cell_type\":\n",
    "            cell_type,\n",
    "\n",
    "        \"tested_genes\":\n",
    "            expected_n,\n",
    "\n",
    "        \"primary_FDR\":\n",
    "            n_primary,\n",
    "\n",
    "        \"RIN_FDR\":\n",
    "            n_RIN,\n",
    "\n",
    "        \"PMI_FDR\":\n",
    "            n_PMI,\n",
    "\n",
    "        \"primary_RIN_LFC_pearson\":\n",
    "            RIN_LFC_Pearson,\n",
    "\n",
    "        \"primary_RIN_LFC_spearman\":\n",
    "            RIN_LFC_Spearman,\n",
    "\n",
    "        \"primary_RIN_Wald_spearman\":\n",
    "            RIN_Wald_Spearman,\n",
    "\n",
    "        \"primary_RIN_direction\":\n",
    "            RIN_direction,\n",
    "\n",
    "        \"primary_PMI_LFC_pearson\":\n",
    "            PMI_LFC_Pearson,\n",
    "\n",
    "        \"primary_PMI_LFC_spearman\":\n",
    "            PMI_LFC_Spearman,\n",
    "\n",
    "        \"primary_PMI_Wald_spearman\":\n",
    "            PMI_Wald_Spearman,\n",
    "\n",
    "        \"primary_PMI_direction\":\n",
    "            PMI_direction,\n",
    "\n",
    "        \"primary_FDR_supported_in_both\":\n",
    "            n_both_supported,\n",
    "\n",
    "        \"primary_FDR_FDR_in_both\":\n",
    "            n_both_FDR,\n",
    "\n",
    "        \"primary_hash_verified\":\n",
    "            True,\n",
    "\n",
    "        \"RIN_hash_verified\":\n",
    "            True,\n",
    "\n",
    "        \"PMI_hash_verified\":\n",
    "            True,\n",
    "\n",
    "        \"gene_universe_verified\":\n",
    "            True,\n",
    "\n",
    "        \"stored_comparison_verified\":\n",
    "            True,\n",
    "\n",
    "        \"stored_support_verified\":\n",
    "            True,\n",
    "\n",
    "        \"stored_support_schema\":\n",
    "            \"RIN_and_PMI_FDR\",\n",
    "\n",
    "    })\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nAudit result:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Primary FDR:\",\n",
    "        n_primary\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  RIN FDR:\",\n",
    "        n_RIN\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  PMI FDR:\",\n",
    "        n_PMI\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Supported in BOTH:\",\n",
    "        f\"{n_both_supported}/{n_primary}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  FDR in BOTH:\",\n",
    "        f\"{n_both_FDR}/{n_primary}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Primary/RIN LFC Spearman:\",\n",
    "        RIN_LFC_Spearman\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Primary/PMI LFC Spearman:\",\n",
    "        PMI_LFC_Spearman\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. COMBINE EXACT PRIMARY FDR HITS\n",
    "# ============================================================\n",
    "\n",
    "exact_hits = pd.concat(\n",
    "    exact_hit_tables,\n",
    "    axis=0,\n",
    "    ignore_index=True\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    exact_hits\n",
    ") == 34\n",
    "\n",
    "\n",
    "assert (\n",
    "    exact_hits[\n",
    "        \"RIN_and_PMI_supported\"\n",
    "    ]\n",
    "    .astype(bool)\n",
    "    .all()\n",
    ")\n",
    "\n",
    "\n",
    "assert int(\n",
    "    exact_hits[\n",
    "        \"RIN_and_PMI_FDR\"\n",
    "    ]\n",
    "    .astype(bool)\n",
    "    .sum()\n",
    ") == 22\n",
    "\n",
    "\n",
    "assert np.array_equal(\n",
    "\n",
    "    exact_hits[\n",
    "        \"RIN_and_PMI_FDR\"\n",
    "    ]\n",
    "    .astype(bool)\n",
    "    .to_numpy(),\n",
    "\n",
    "    exact_hits[\n",
    "        \"RIN_and_PMI_same_direction_and_FDR\"\n",
    "    ]\n",
    "    .astype(bool)\n",
    "    .to_numpy(),\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. VERIFY COMBINED STEP-22 SUPPORT TABLE\n",
    "# ============================================================\n",
    "\n",
    "combined_stored_hits = (\n",
    "    combined_stored_hits\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    combined_stored_hits[\n",
    "        \"gene_id\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .tolist()\n",
    "    ==\n",
    "    pd.concat(\n",
    "        exact_hit_tables,\n",
    "        axis=0,\n",
    "        ignore_index=True\n",
    "    )[\n",
    "        \"gene_id\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .tolist()\n",
    ")\n",
    "\n",
    "\n",
    "for column in [\n",
    "\n",
    "    \"RIN_supported\",\n",
    "    \"PMI_supported\",\n",
    "    \"RIN_and_PMI_supported\",\n",
    "    \"RIN_and_PMI_FDR\",\n",
    "\n",
    "]:\n",
    "\n",
    "    assert np.array_equal(\n",
    "\n",
    "        as_bool(\n",
    "            combined_stored_hits[\n",
    "                column\n",
    "            ]\n",
    "        ).to_numpy(),\n",
    "\n",
    "        pd.concat(\n",
    "            exact_hit_tables,\n",
    "            axis=0,\n",
    "            ignore_index=True\n",
    "        )[\n",
    "            column\n",
    "        ]\n",
    "        .astype(bool)\n",
    "        .to_numpy(),\n",
    "\n",
    "    ), (\n",
    "        f\"Combined STEP-22 support mismatch: {column}\"\n",
    "    )\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nCombined 34-hit STEP-22 support table: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. SORT FOR FINAL PRESENTATION ONLY\n",
    "# ============================================================\n",
    "\n",
    "class_order = pd.CategoricalDtype(\n",
    "    categories=CLASSES,\n",
    "    ordered=True\n",
    ")\n",
    "\n",
    "\n",
    "exact_hits[\n",
    "    \"cell_type\"\n",
    "] = (\n",
    "    exact_hits[\n",
    "        \"cell_type\"\n",
    "    ]\n",
    "    .astype(\n",
    "        class_order\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "exact_hits = (\n",
    "\n",
    "    exact_hits\n",
    "    .sort_values(\n",
    "        [\n",
    "            \"cell_type\",\n",
    "            \"primary_padj\",\n",
    "            \"primary_p\",\n",
    "        ],\n",
    "        ascending=[\n",
    "            True,\n",
    "            True,\n",
    "            True,\n",
    "        ]\n",
    "    )\n",
    "    .reset_index(\n",
    "        drop=True\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "exact_hits[\n",
    "    \"cell_type\"\n",
    "] = (\n",
    "    exact_hits[\n",
    "        \"cell_type\"\n",
    "    ]\n",
    "    .astype(str)\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. SAVE EXACT 34-HIT FINAL TABLE\n",
    "# ============================================================\n",
    "\n",
    "exact_hits.to_csv(\n",
    "\n",
    "    FINAL_34_PATH,\n",
    "\n",
    "    index=False,\n",
    "\n",
    "    compression={\n",
    "        \"method\":\n",
    "            \"gzip\",\n",
    "\n",
    "        \"compresslevel\":\n",
    "            6,\n",
    "    }\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "both_FDR_hits = (\n",
    "\n",
    "    exact_hits[\n",
    "        exact_hits[\n",
    "            \"RIN_and_PMI_FDR\"\n",
    "        ]\n",
    "        .astype(bool)\n",
    "    ]\n",
    "    .copy()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    both_FDR_hits\n",
    ") == 22\n",
    "\n",
    "\n",
    "both_FDR_hits.to_csv(\n",
    "\n",
    "    BOTH_FDR_PATH,\n",
    "\n",
    "    index=False,\n",
    "\n",
    "    compression={\n",
    "        \"method\":\n",
    "            \"gzip\",\n",
    "\n",
    "        \"compresslevel\":\n",
    "            6,\n",
    "    }\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 12. FINAL AUDIT TABLE\n",
    "# ============================================================\n",
    "\n",
    "audit = pd.DataFrame(\n",
    "    audit_rows\n",
    ")\n",
    "\n",
    "\n",
    "audit[\n",
    "    \"cell_type\"\n",
    "] = pd.Categorical(\n",
    "    audit[\n",
    "        \"cell_type\"\n",
    "    ],\n",
    "    categories=CLASSES,\n",
    "    ordered=True\n",
    ")\n",
    "\n",
    "\n",
    "audit = (\n",
    "\n",
    "    audit\n",
    "    .sort_values(\n",
    "        \"cell_type\"\n",
    "    )\n",
    "    .reset_index(\n",
    "        drop=True\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "audit[\n",
    "    \"cell_type\"\n",
    "] = (\n",
    "    audit[\n",
    "        \"cell_type\"\n",
    "    ]\n",
    "    .astype(str)\n",
    ")\n",
    "\n",
    "\n",
    "assert int(\n",
    "    audit[\n",
    "        \"primary_FDR\"\n",
    "    ].sum()\n",
    ") == 34\n",
    "\n",
    "\n",
    "assert int(\n",
    "    audit[\n",
    "        \"primary_FDR_supported_in_both\"\n",
    "    ].sum()\n",
    ") == 34\n",
    "\n",
    "\n",
    "assert int(\n",
    "    audit[\n",
    "        \"primary_FDR_FDR_in_both\"\n",
    "    ].sum()\n",
    ") == 22\n",
    "\n",
    "\n",
    "audit.to_csv(\n",
    "    AUDIT_SUMMARY_PATH,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 13. FINAL ROBUSTNESS FREEZE\n",
    "# ============================================================\n",
    "\n",
    "FINAL_ROBUSTNESS_FREEZE = {\n",
    "\n",
    "    \"dataset\":\n",
    "        \"GSE174367\",\n",
    "\n",
    "    \"created_utc\":\n",
    "        datetime.now(\n",
    "            timezone.utc\n",
    "        ).isoformat(),\n",
    "\n",
    "    \"status\":\n",
    "        \"AD_DISCOVERY_FINAL_ROBUSTNESS_FROZEN\",\n",
    "\n",
    "    \"primary_effect_freeze\":\n",
    "        str(\n",
    "            PRIMARY_FREEZE_PATH\n",
    "        ),\n",
    "\n",
    "    \"technical_sensitivity_lock\":\n",
    "        str(\n",
    "            SENSITIVITY_LOCK_PATH\n",
    "        ),\n",
    "\n",
    "    \"technical_support_freeze\":\n",
    "        str(\n",
    "            SUPPORT_FREEZE_PATH\n",
    "        ),\n",
    "\n",
    "    \"audit_completed\":\n",
    "        True,\n",
    "\n",
    "    \"audit_recovery_note\":\n",
    "        (\n",
    "            \"STEP 22 stored the per-gene combined FDR flag \"\n",
    "            \"as RIN_and_PMI_FDR. The failed first STEP 23 \"\n",
    "            \"attempt expected a longer non-existent column \"\n",
    "            \"name. STEP 23B audits the actual stored schema \"\n",
    "            \"without changing any statistical result.\"\n",
    "        ),\n",
    "\n",
    "    \"actual_STEP22_combined_FDR_column\":\n",
    "        \"RIN_and_PMI_FDR\",\n",
    "\n",
    "    \"canonical_final_alias\":\n",
    "        \"RIN_and_PMI_same_direction_and_FDR\",\n",
    "\n",
    "    \"primary_FDR_total\":\n",
    "        34,\n",
    "\n",
    "    \"primary_FDR_supported_in_RIN_and_PMI\":\n",
    "        34,\n",
    "\n",
    "    \"primary_FDR_FDR_in_RIN_and_PMI\":\n",
    "        22,\n",
    "\n",
    "    \"support_rule\":\n",
    "        (\n",
    "            \"same AD-vs-Control log2FC direction AND \"\n",
    "            \"nominal two-sided p<0.05 in both \"\n",
    "            \"RIN-adjusted and PMI-adjusted sensitivity models\"\n",
    "        ),\n",
    "\n",
    "    \"sensitivity_FDR_required_for_technical_support\":\n",
    "        False,\n",
    "\n",
    "    \"RIN_model\":\n",
    "        \"~ age + sex + batch + RIN + diagnosis_binary\",\n",
    "\n",
    "    \"RIN_donors\":\n",
    "        18,\n",
    "\n",
    "    \"RIN_AD\":\n",
    "        11,\n",
    "\n",
    "    \"RIN_Control\":\n",
    "        7,\n",
    "\n",
    "    \"PMI_model\":\n",
    "        \"~ age + sex + batch + PMI + diagnosis_binary\",\n",
    "\n",
    "    \"PMI_complete_case_donors\":\n",
    "        17,\n",
    "\n",
    "    \"PMI_AD\":\n",
    "        11,\n",
    "\n",
    "    \"PMI_Control\":\n",
    "        6,\n",
    "\n",
    "    \"age_overlap_sensitivity_performed\":\n",
    "        False,\n",
    "\n",
    "    \"exact_primary_FDR_robustness_table\":\n",
    "        str(\n",
    "            FINAL_34_PATH\n",
    "        ),\n",
    "\n",
    "    \"both_sensitivity_FDR_table\":\n",
    "        str(\n",
    "            BOTH_FDR_PATH\n",
    "        ),\n",
    "\n",
    "    \"audit_summary\":\n",
    "        str(\n",
    "            AUDIT_SUMMARY_PATH\n",
    "        ),\n",
    "\n",
    "    \"audit_summary_sha256\":\n",
    "        sha256_file(\n",
    "            AUDIT_SUMMARY_PATH\n",
    "        ),\n",
    "\n",
    "    \"exact_34_table_sha256\":\n",
    "        sha256_file(\n",
    "            FINAL_34_PATH\n",
    "        ),\n",
    "\n",
    "    \"both_FDR_table_sha256\":\n",
    "        sha256_file(\n",
    "            BOTH_FDR_PATH\n",
    "        ),\n",
    "\n",
    "    \"gene_universes_refiltered\":\n",
    "        False,\n",
    "\n",
    "    \"primary_effects_changed\":\n",
    "        False,\n",
    "\n",
    "    \"new_DE_performed_in_STEP23B\":\n",
    "        False,\n",
    "\n",
    "    \"AD_replication_performed\":\n",
    "        False,\n",
    "\n",
    "    \"PD_data_loaded\":\n",
    "        False,\n",
    "\n",
    "    \"AD_PD_convergence_performed\":\n",
    "        False,\n",
    "\n",
    "    \"robustness_frozen_before_AD_replication\":\n",
    "        True,\n",
    "\n",
    "    \"robustness_frozen_before_AD_PD_convergence\":\n",
    "        True,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    FINAL_ROBUSTNESS_LOCK_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        FINAL_ROBUSTNESS_FREEZE,\n",
    "        f,\n",
    "        indent=2\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 14. FINAL DISPLAY\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 23B PASSED — AD DISCOVERY ROBUSTNESS VERIFIED + FROZEN\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nTECHNICAL-SENSITIVITY AUDIT\"\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    audit\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"EXACT 34 PRIMARY AD FDR HITS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "display_columns = [\n",
    "\n",
    "    \"cell_type\",\n",
    "    \"gene_symbol\",\n",
    "\n",
    "    \"primary_LFC\",\n",
    "    \"primary_p\",\n",
    "    \"primary_padj\",\n",
    "\n",
    "    \"RIN_LFC\",\n",
    "    \"RIN_p\",\n",
    "    \"RIN_padj\",\n",
    "\n",
    "    \"PMI_LFC\",\n",
    "    \"PMI_p\",\n",
    "    \"PMI_padj\",\n",
    "\n",
    "    \"RIN_and_PMI_supported\",\n",
    "    \"RIN_and_PMI_same_direction_and_FDR\",\n",
    "\n",
    "    \"technical_robustness\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "display(\n",
    "    exact_hits[\n",
    "        display_columns\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nTotal primary FDR hits:\",\n",
    "    len(\n",
    "        exact_hits\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Supported nominally in BOTH sensitivities:\",\n",
    "    int(\n",
    "        exact_hits[\n",
    "            \"RIN_and_PMI_supported\"\n",
    "        ]\n",
    "        .astype(bool)\n",
    "        .sum()\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"FDR-significant in BOTH sensitivities:\",\n",
    "    int(\n",
    "        exact_hits[\n",
    "            \"RIN_and_PMI_FDR\"\n",
    "        ]\n",
    "        .astype(bool)\n",
    "        .sum()\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nExact 34-gene table:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    FINAL_34_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n22-hit BOTH-FDR table:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    BOTH_FDR_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFinal robustness freeze:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    FINAL_ROBUSTNESS_LOCK_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nNO NEW DE WAS RUN.\"\n",
    ")\n",
    "\n",
    "print(\n",    "    \"NO THRESHOLD WAS CHANGED.\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PRIMARY EFFECTS CHANGED: NO\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"AD REPLICATION PERFORMED: NO\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PD DATA LOADED: NO\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"AD↔PD CONVERGENCE PERFORMED: NO\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nNEXT:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 24 — GSE157827 independent AD replication \"\n",
    "    \"data audit and disease-blind cell-class mapping.\"\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Part III — AD primary replication\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 44\n",
    "# ============================================================\n",
    "# STEP 24 — GSE157827 AD REPLICATION RAW-DATA AUDIT\n",
    "#\n",
    "# PURPOSE\n",
    "# -------\n",
    "# 1. Verify GSE157827 is still the independently frozen\n",
    "#    PRIMARY AD replication dataset.\n",
    "#\n",
    "# 2. Download official GEO processed matrices:\n",
    "#       GSE157827_RAW.tar\n",
    "#\n",
    "#    containing 21 Cell Ranger filtered matrix triplets:\n",
    "#       matrix.mtx.gz\n",
    "#       features.tsv.gz\n",
    "#       barcodes.tsv.gz\n",
    "#\n",
    "# 3. Verify:\n",
    "#       12 AD\n",
    "#        9 NC\n",
    "#       21 samples total\n",
    "#\n",
    "# 4. Audit matrix dimensions without loading expression\n",
    "#    values into memory.\n",
    "#\n",
    "# 5. Verify feature/barcode dimensional consistency.\n",
    "#\n",
    "# 6. Download the original Lau et al. open-access\n",
    "#    supplementary package through the NCBI PMC OA API.\n",
    "#\n",
    "# 7. Locate and inspect Supplementary Table S1 so that\n",
    "#    age / sex / postmortem delay / pathology metadata are\n",
    "#    taken from the actual publication rather than guessed.\n",
    "#\n",
    "# 8. Freeze raw file identities and sample manifest.\n",
    "#\n",
    "# IMPORTANT\n",
    "# ---------\n",
    "# NO QC filtering yet.\n",
    "# NO NORMALIZATION.\n",
    "# NO CLUSTERING.\n",
    "# NO CELL-TYPE ANNOTATION.\n",
    "# NO OPC SPLITTING.\n",
    "# NO GENE FILTERING.\n",
    "# NO PSEUDOBULK.\n",
    "# NO DIFFERENTIAL EXPRESSION.\n",
    "# NO COMPARISON TO GSE174367 EFFECTS.\n",
    "# NO AD↔PD CONVERGENCE.\n",
    "#\n",
    "# Original GSE157827 major-cell annotation did NOT separate\n",
    "# OPC from oligodendrocytes. That issue will be handled\n",
    "# disease-blind in the next stage.\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "import requests\n",
    "import hashlib\n",
    "import tarfile\n",
    "import gzip\n",
    "import json\n",
    "import re\n",
    "import time\n",
    "import xml.etree.ElementTree as ET\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = ROOT / \"locks\"\n",
    "MANIFESTS = ROOT / \"manifests\"\n",
    "\n",
    "REP_DIR = (\n",
    "    ROOT /\n",
    "    \"GSE157827_AD_replication\"\n",
    ")\n",
    "\n",
    "DOWNLOAD_DIR = (\n",
    "    REP_DIR /\n",
    "    \"downloads\"\n",
    ")\n",
    "\n",
    "RAW_DIR = (\n",
    "    REP_DIR /\n",
    "    \"GEO_RAW_extracted\"\n",
    ")\n",
    "\n",
    "PMC_DIR = (\n",
    "    REP_DIR /\n",
    "    \"Lau2020_supplementary\"\n",
    ")\n",
    "\n",
    "\n",
    "for directory in [\n",
    "\n",
    "    LOCKS,\n",
    "    MANIFESTS,\n",
    "    REP_DIR,\n",
    "    DOWNLOAD_DIR,\n",
    "    RAW_DIR,\n",
    "    PMC_DIR,\n",
    "\n",
    "]:\n",
    "\n",
    "    directory.mkdir(\n",
    "        parents=True,\n",
    "        exist_ok=True\n",
    "    )\n",
    "\n",
    "\n",
    "DATASET_ROLE_LOCK = (\n",
    "    LOCKS /\n",
    "    \"AD_BRAIN_DATASET_ROLES_v1.json\"\n",
    ")\n",
    "\n",
    "DISCOVERY_ROBUSTNESS_LOCK = (\n",
    "    LOCKS /\n",
    "    \"GSE174367_AD_DISCOVERY_FINAL_ROBUSTNESS_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "RAW_TAR_PATH = (\n",
    "    DOWNLOAD_DIR /\n",
    "    \"GSE157827_RAW.tar\"\n",
    ")\n",
    "\n",
    "SERIES_MATRIX_PATH = (\n",
    "    DOWNLOAD_DIR /\n",
    "    \"GSE157827_series_matrix.txt.gz\"\n",
    ")\n",
    "\n",
    "PMC_OA_PACKAGE_PATH = (\n",
    "    DOWNLOAD_DIR /\n",
    "    \"PMC7568283_OA_package.tar.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "SAMPLE_MANIFEST_PATH = (\n",
    "    MANIFESTS /\n",
    "    \"GSE157827_OFFICIAL_RAW_SAMPLE_MANIFEST_v1.csv\"\n",
    ")\n",
    "\n",
    "FEATURE_MANIFEST_PATH = (\n",
    "    MANIFESTS /\n",
    "    \"GSE157827_RAW_FEATURE_FILE_AUDIT_v1.csv\"\n",
    ")\n",
    "\n",
    "SUPPLEMENTARY_MANIFEST_PATH = (\n",
    "    MANIFESTS /\n",
    "    \"GSE157827_LAU2020_SUPPLEMENTARY_FILE_MANIFEST_v1.csv\"\n",
    ")\n",
    "\n",
    "RAW_AUDIT_LOCK_PATH = (\n",
    "    LOCKS /\n",
    "    \"GSE157827_AD_REPLICATION_RAW_DATA_AUDIT_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "\n",
    "    DATASET_ROLE_LOCK,\n",
    "    DISCOVERY_ROBUSTNESS_LOCK,\n",
    "\n",
    "]:\n",
    "\n",
    "    assert path.exists(), (\n",
    "        f\"Missing required upstream lock: {path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. VERIFY REPLICATION ROLE WAS FROZEN BEFORE AD EFFECTS\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    DATASET_ROLE_LOCK,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    role_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    DISCOVERY_ROBUSTNESS_LOCK,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    discovery_lock = json.load(f)\n",
    "\n",
    "\n",
    "assert (\n",
    "    role_lock[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"AD_DATASET_ROLES_FROZEN_BEFORE_DISEASE_EXPRESSION\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    role_lock[\n",
    "        \"primary_replication\"\n",
    "    ][\n",
    "        \"dataset\"\n",
    "    ]\n",
    "    ==\n",
    "    \"GSE157827\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    role_lock[\n",
    "        \"primary_discovery\"\n",
    "    ][\n",
    "        \"dataset\"\n",
    "    ]\n",
    "    ==\n",
    "    \"GSE174367\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    discovery_lock[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"AD_DISCOVERY_FINAL_ROBUSTNESS_FROZEN\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    discovery_lock[\n",
    "        \"AD_replication_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    discovery_lock[\n",
    "        \"AD_PD_convergence_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"AD REPLICATION ROLE VERIFIED\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Discovery:          GSE174367\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Primary replication: GSE157827\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Replication disease-expression inspected: NO\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. OFFICIAL SAMPLE MAP\n",
    "#\n",
    "# From GEO accession GSE157827.\n",
    "#\n",
    "# We use this ONLY to verify downloaded filenames.\n",
    "# Expression is never inspected by diagnosis here.\n",
    "# ============================================================\n",
    "\n",
    "OFFICIAL_SAMPLES = [\n",
    "\n",
    "    (\"GSM4775561\", \"AD1\",  \"AD\"),\n",
    "    (\"GSM4775562\", \"AD2\",  \"AD\"),\n",
    "    (\"GSM4775563\", \"AD4\",  \"AD\"),\n",
    "    (\"GSM4775564\", \"AD5\",  \"AD\"),\n",
    "    (\"GSM4775565\", \"AD6\",  \"AD\"),\n",
    "    (\"GSM4775566\", \"AD8\",  \"AD\"),\n",
    "    (\"GSM4775567\", \"AD9\",  \"AD\"),\n",
    "    (\"GSM4775568\", \"AD10\", \"AD\"),\n",
    "    (\"GSM4775569\", \"AD13\", \"AD\"),\n",
    "    (\"GSM4775570\", \"AD19\", \"AD\"),\n",
    "    (\"GSM4775571\", \"AD20\", \"AD\"),\n",
    "    (\"GSM4775572\", \"AD21\", \"AD\"),\n",
    "\n",
    "    (\"GSM4775573\", \"NC3\",  \"Control\"),\n",
    "    (\"GSM4775574\", \"NC7\",  \"Control\"),\n",
    "    (\"GSM4775575\", \"NC11\", \"Control\"),\n",
    "    (\"GSM4775576\", \"NC12\", \"Control\"),\n",
    "    (\"GSM4775577\", \"NC14\", \"Control\"),\n",
    "    (\"GSM4775578\", \"NC15\", \"Control\"),\n",
    "    (\"GSM4775579\", \"NC16\", \"Control\"),\n",
    "    (\"GSM4775580\", \"NC17\", \"Control\"),\n",
    "    (\"GSM4775581\", \"NC18\", \"Control\"),\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "official_samples_df = pd.DataFrame(\n",
    "\n",
    "    OFFICIAL_SAMPLES,\n",
    "\n",
    "    columns=[\n",
    "        \"GSM\",\n",
    "        \"sample_id\",\n",
    "        \"diagnosis_binary\",\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    official_samples_df\n",
    ") == 21\n",
    "\n",
    "\n",
    "assert (\n",
    "    official_samples_df[\n",
    "        \"GSM\"\n",
    "    ]\n",
    "    .is_unique\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    official_samples_df[\n",
    "        \"sample_id\"\n",
    "    ]\n",
    "    .is_unique\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    official_samples_df[\n",
    "        \"diagnosis_binary\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    "    ==\n",
    "    {\n",
    "        \"AD\": 12,\n",
    "        \"Control\": 9,\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nOfficial GEO cohort:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"  AD:\",\n",
    "    12\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"  Control:\",\n",
    "    9\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"  Total:\",\n",
    "    21\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. DOWNLOAD HELPERS\n",
    "# ============================================================\n",
    "\n",
    "def download_with_resume(\n",
    "    url,\n",
    "    destination,\n",
    "    retries=5,\n",
    "    chunk_size=1024 * 1024,\n",
    "):\n",
    "\n",
    "\n",
    "    destination = Path(\n",
    "        destination\n",
    "    )\n",
    "\n",
    "\n",
    "    for attempt in range(\n",
    "        1,\n",
    "        retries + 1\n",
    "    ):\n",
    "\n",
    "\n",
    "        existing = (\n",
    "            destination.stat().st_size\n",
    "            if destination.exists()\n",
    "            else 0\n",
    "        )\n",
    "\n",
    "\n",
    "        headers = {}\n",
    "\n",
    "\n",
    "        if existing > 0:\n",
    "\n",
    "            headers[\n",
    "                \"Range\"\n",
    "            ] = (\n",
    "                f\"bytes={existing}-\"\n",
    "            )\n",
    "\n",
    "\n",
    "        print(\n",
    "            f\"\\nDownloading {destination.name} \"\n",
    "            f\"(attempt {attempt}/{retries})\"\n",
    "        )\n",
    "\n",
    "\n",
    "        print(\n",
    "            \"Existing bytes:\",\n",
    "            f\"{existing:,}\"\n",
    "        )\n",
    "\n",
    "\n",
    "        try:\n",
    "\n",
    "\n",
    "            with requests.get(\n",
    "                url,\n",
    "                headers=headers,\n",
    "                stream=True,\n",
    "                timeout=(30, 300),\n",
    "            ) as response:\n",
    "\n",
    "\n",
    "                # ------------------------------------------------\n",
    "                # If server ignores Range and returns full file,\n",
    "                # overwrite instead of appending.\n",
    "                # ------------------------------------------------\n",
    "\n",
    "                if (\n",
    "                    existing > 0\n",
    "                    and\n",
    "                    response.status_code == 200\n",
    "                ):\n",
    "\n",
    "                    mode = \"wb\"\n",
    "\n",
    "\n",
    "                elif (\n",
    "                    existing > 0\n",
    "                    and\n",
    "                    response.status_code == 206\n",
    "                ):\n",
    "\n",
    "                    mode = \"ab\"\n",
    "\n",
    "\n",
    "                else:\n",
    "\n",
    "                    mode = \"wb\"\n",
    "\n",
    "\n",
    "                response.raise_for_status()\n",
    "\n",
    "\n",
    "                with open(\n",
    "                    destination,\n",
    "                    mode\n",
    "                ) as f:\n",
    "\n",
    "\n",
    "                    for chunk in response.iter_content(\n",
    "                        chunk_size=chunk_size\n",
    "                    ):\n",
    "\n",
    "\n",
    "                        if chunk:\n",
    "\n",
    "                            f.write(\n",
    "                                chunk\n",
    "                            )\n",
    "\n",
    "\n",
    "            print(\n",
    "                \"Complete:\",\n",
    "                f\"{destination.stat().st_size:,}\",\n",
    "                \"bytes\"\n",
    "            )\n",
    "\n",
    "\n",
    "            return destination\n",
    "\n",
    "\n",
    "        except Exception as exc:\n",
    "\n",
    "\n",
    "            print(\n",
    "                \"Download error:\",\n",
    "                repr(\n",
    "                    exc\n",
    "                )\n",
    "            )\n",
    "\n",
    "\n",
    "            if attempt == retries:\n",
    "\n",
    "                raise\n",
    "\n",
    "\n",
    "            time.sleep(\n",
    "                min(\n",
    "                    2 ** attempt,\n",
    "                    30\n",
    "                )\n",
    "            )\n",
    "\n",
    "\n",
    "def sha256_file(\n",
    "    path,\n",
    "    block_size=1024 * 1024,\n",
    "):\n",
    "\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\"\n",
    "    ) as f:\n",
    "\n",
    "\n",
    "        while True:\n",
    "\n",
    "\n",
    "            block = f.read(\n",
    "                block_size\n",
    "            )\n",
    "\n",
    "\n",
    "            if not block:\n",
    "\n",
    "                break\n",
    "\n",
    "\n",
    "            h.update(\n",
    "                block\n",
    "            )\n",
    "\n",
    "\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. DOWNLOAD OFFICIAL GEO FILES\n",
    "# ============================================================\n",
    "\n",
    "RAW_TAR_URL = (\n",
    "    \"https://ftp.ncbi.nlm.nih.gov/geo/\"\n",
    "    \"series/GSE157nnn/GSE157827/suppl/\"\n",
    "    \"GSE157827_RAW.tar\"\n",
    ")\n",
    "\n",
    "\n",
    "SERIES_MATRIX_URL = (\n",
    "    \"https://ftp.ncbi.nlm.nih.gov/geo/\"\n",
    "    \"series/GSE157nnn/GSE157827/matrix/\"\n",
    "    \"GSE157827_series_matrix.txt.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "download_with_resume(\n",
    "    RAW_TAR_URL,\n",
    "    RAW_TAR_PATH,\n",
    ")\n",
    "\n",
    "\n",
    "download_with_resume(\n",
    "    SERIES_MATRIX_URL,\n",
    "    SERIES_MATRIX_PATH,\n",
    ")\n",
    "\n",
    "\n",
    "raw_tar_sha256 = sha256_file(\n",
    "    RAW_TAR_PATH\n",
    ")\n",
    "\n",
    "\n",
    "series_matrix_sha256 = sha256_file(\n",
    "    SERIES_MATRIX_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"OFFICIAL GEO FILE IDENTITIES\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"GSE157827_RAW.tar\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"  bytes:\",\n",
    "    f\"{RAW_TAR_PATH.stat().st_size:,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"  SHA256:\",\n",
    "    raw_tar_sha256\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nGSE157827_series_matrix.txt.gz\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"  bytes:\",\n",
    "    f\"{SERIES_MATRIX_PATH.stat().st_size:,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"  SHA256:\",\n",
    "    series_matrix_sha256\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. EXTRACT OFFICIAL GEO RAW TAR SAFELY\n",
    "# ============================================================\n",
    "\n",
    "def safe_extract_tar(\n",
    "    tar_path,\n",
    "    destination,\n",
    "):\n",
    "\n",
    "\n",
    "    destination = (\n",
    "        Path(\n",
    "            destination\n",
    "        )\n",
    "        .resolve()\n",
    "    )\n",
    "\n",
    "\n",
    "    with tarfile.open(\n",
    "        tar_path,\n",
    "        \"r:*\"\n",
    "    ) as tar:\n",
    "\n",
    "\n",
    "        members = tar.getmembers()\n",
    "\n",
    "\n",
    "        for member in members:\n",
    "\n",
    "\n",
    "            target = (\n",
    "                destination /\n",
    "                member.name\n",
    "            ).resolve()\n",
    "\n",
    "\n",
    "            assert str(\n",
    "                target\n",
    "            ).startswith(\n",
    "                str(\n",
    "                    destination\n",
    "                )\n",
    "            ), (\n",
    "                \"Unsafe tar path detected.\"\n",
    "            )\n",
    "\n",
    "\n",
    "        tar.extractall(\n",
    "            destination\n",
    "        )\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nExtracting official GEO RAW.tar ...\"\n",
    ")\n",
    "\n",
    "\n",
    "safe_extract_tar(\n",
    "    RAW_TAR_PATH,\n",
    "    RAW_DIR\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Extraction complete.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. DISCOVER MATRIX TRIPLETS\n",
    "# ============================================================\n",
    "\n",
    "all_files = sorted(\n",
    "\n",
    "    [\n",
    "        path\n",
    "        for path\n",
    "        in RAW_DIR.rglob(\"*\")\n",
    "        if path.is_file()\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "matrix_files = sorted(\n",
    "\n",
    "    [\n",
    "        path\n",
    "        for path\n",
    "        in all_files\n",
    "        if path.name.endswith(\n",
    "            \"_matrix.mtx.gz\"\n",
    "        )\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "barcode_files = sorted(\n",
    "\n",
    "    [\n",
    "        path\n",
    "        for path\n",
    "        in all_files\n",
    "        if path.name.endswith(\n",
    "            \"_barcodes.tsv.gz\"\n",
    "        )\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "feature_files = sorted(\n",
    "\n",
    "    [\n",
    "        path\n",
    "        for path\n",
    "        in all_files\n",
    "        if path.name.endswith(\n",
    "            \"_features.tsv.gz\"\n",
    "        )\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nExtracted matrix files:\",\n",
    "    len(\n",
    "        matrix_files\n",
    "    )\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Extracted barcode files:\",\n",
    "    len(\n",
    "        barcode_files\n",
    "    )\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Extracted feature files:\",\n",
    "    len(\n",
    "        feature_files\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    matrix_files\n",
    ") == 21\n",
    "\n",
    "\n",
    "assert len(\n",
    "    barcode_files\n",
    ") == 21\n",
    "\n",
    "\n",
    "assert len(\n",
    "    feature_files\n",
    ") == 21\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. PARSE FILE PREFIX\n",
    "# ============================================================\n",
    "\n",
    "FILE_PATTERN = re.compile(\n",
    "\n",
    "    r\"^(GSM\\d+)_\"\n",
    "    r\"((?:AD|NC)\\d+)_\"\n",
    "    r\"(matrix\\.mtx|barcodes\\.tsv|features\\.tsv)\"\n",
    "    r\"\\.gz$\"\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "def parse_filename(\n",
    "    path\n",
    "):\n",
    "\n",
    "\n",
    "    match = FILE_PATTERN.match(\n",
    "        path.name\n",
    "    )\n",
    "\n",
    "\n",
    "    assert match is not None, (\n",
    "        f\"Unexpected GEO raw filename: {path.name}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    return {\n",
    "        \"GSM\":\n",
    "            match.group(\n",
    "                1\n",
    "            ),\n",
    "\n",
    "        \"sample_id\":\n",
    "            match.group(\n",
    "                2\n",
    "            ),\n",
    "\n",
    "        \"kind\":\n",
    "            match.group(\n",
    "                3\n",
    "            ),\n",
    "\n",
    "        \"path\":\n",
    "            str(\n",
    "                path\n",
    "            ),\n",
    "    }\n",
    "\n",
    "\n",
    "parsed_files = pd.DataFrame(\n",
    "\n",
    "    [\n",
    "        parse_filename(\n",
    "            path\n",
    "        )\n",
    "        for path\n",
    "        in (\n",
    "            matrix_files\n",
    "            +\n",
    "            barcode_files\n",
    "            +\n",
    "            feature_files\n",
    "        )\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    parsed_files\n",
    ") == 63\n",
    "\n",
    "\n",
    "assert (\n",
    "\n",
    "    parsed_files\n",
    "    .groupby(\n",
    "        [\n",
    "            \"GSM\",\n",
    "            \"sample_id\",\n",
    "        ]\n",
    "    )[\n",
    "        \"kind\"\n",
    "    ]\n",
    "    .nunique()\n",
    "    .eq(\n",
    "        3\n",
    "    )\n",
    "    .all()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "downloaded_pairs = set(\n",
    "\n",
    "    zip(\n",
    "        parsed_files[\n",
    "            \"GSM\"\n",
    "        ],\n",
    "        parsed_files[\n",
    "            \"sample_id\"\n",
    "        ],\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "official_pairs = set(\n",
    "\n",
    "    zip(\n",
    "        official_samples_df[\n",
    "            \"GSM\"\n",
    "        ],\n",
    "        official_samples_df[\n",
    "            \"sample_id\"\n",
    "        ],\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    downloaded_pairs\n",
    "    ==\n",
    "    official_pairs\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nDownloaded sample identities exactly match GEO: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. MATRIX-MARKET HEADER AUDIT\n",
    "#\n",    "# This reads dimensions only.\n",
    "# It does NOT load expression values.\n",
    "# ============================================================\n",
    "\n",
    "def read_mtx_header(\n",
    "    path\n",
    "):\n",
    "\n",
    "\n",
    "    with gzip.open(\n",
    "        path,\n",
    "        \"rt\"\n",
    "    ) as f:\n",
    "\n",
    "\n",
    "        first = f.readline().strip()\n",
    "\n",
    "\n",
    "        assert first.startswith(\n",
    "            \"%%MatrixMarket\"\n",
    "        ), (\n",
    "            f\"Invalid Matrix Market header: {path}\"\n",
    "        )\n",
    "\n",
    "\n",
    "        while True:\n",
    "\n",
    "\n",
    "            line = f.readline()\n",
    "\n",
    "\n",
    "            assert line != \"\", (\n",
    "                f\"Unexpected EOF: {path}\"\n",
    "            )\n",
    "\n",
    "\n",
    "            line = line.strip()\n",
    "\n",
    "\n",
    "            if (\n",
    "                line\n",
    "                and\n",
    "                not line.startswith(\n",
    "                    \"%\"\n",
    "                )\n",
    "            ):\n",
    "\n",
    "\n",
    "                parts = line.split()\n",
    "\n",
    "\n",
    "                assert len(\n",
    "                    parts\n",
    "                ) == 3\n",
    "\n",
    "\n",
    "                n_rows = int(\n",
    "                    parts[\n",
    "                        0\n",
    "                    ]\n",
    "                )\n",
    "\n",
    "\n",
    "                n_cols = int(\n",
    "                    parts[\n",
    "                        1\n",
    "                    ]\n",
    "                )\n",
    "\n",
    "\n",
    "                n_nnz = int(\n",
    "                    parts[\n",
    "                        2\n",
    "                    ]\n",
    "                )\n",
    "\n",
    "\n",
    "                return (\n",
    "                    n_rows,\n",
    "                    n_cols,\n",
    "                    n_nnz,\n",
    "                )\n",
    "\n",
    "\n",
    "def count_gzip_lines(\n",
    "    path\n",
    "):\n",
    "\n",
    "\n",
    "    count = 0\n",
    "\n",
    "\n",
    "    with gzip.open(\n",
    "        path,\n",
    "        \"rt\"\n",
    "    ) as f:\n",
    "\n",
    "\n",
    "        for _ in f:\n",
    "\n",
    "            count += 1\n",
    "\n",
    "\n",
    "    return count\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. BUILD RAW SAMPLE MANIFEST\n",
    "# ============================================================\n",
    "\n",
    "manifest_rows = []\n",
    "\n",
    "\n",
    "for _, official in official_samples_df.iterrows():\n",
    "\n",
    "\n",
    "    gsm = official[\n",
    "        \"GSM\"\n",
    "    ]\n",
    "\n",
    "\n",
    "    sample_id = official[\n",
    "        \"sample_id\"\n",
    "    ]\n",
    "\n",
    "\n",
    "    diagnosis = official[\n",
    "        \"diagnosis_binary\"\n",
    "    ]\n",
    "\n",
    "\n",
    "    subset = parsed_files[\n",
    "        (\n",
    "            parsed_files[\n",
    "                \"GSM\"\n",
    "            ]\n",
    "            ==\n",
    "            gsm\n",
    "        )\n",
    "        &\n",
    "        (\n",
    "            parsed_files[\n",
    "                \"sample_id\"\n",
    "            ]\n",
    "            ==\n",
    "            sample_id\n",
    "        )\n",
    "    ]\n",
    "\n",
    "\n",
    "    matrix_path = Path(\n",
    "\n",
    "        subset.loc[\n",
    "            subset[\n",
    "                \"kind\"\n",
    "            ]\n",
    "            ==\n",
    "            \"matrix.mtx\",\n",
    "            \"path\"\n",
    "        ].iloc[\n",
    "            0\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    barcode_path = Path(\n",
    "\n",
    "        subset.loc[\n",
    "            subset[\n",
    "                \"kind\"\n",
    "            ]\n",
    "            ==\n",
    "            \"barcodes.tsv\",\n",
    "            \"path\"\n",
    "        ].iloc[\n",
    "            0\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    feature_path = Path(\n",
    "\n",
    "        subset.loc[\n",
    "            subset[\n",
    "                \"kind\"\n",
    "            ]\n",
    "            ==\n",
    "            \"features.tsv\",\n",
    "            \"path\"\n",
    "        ].iloc[\n",
    "            0\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_features_matrix, n_cells_matrix, n_nnz = (\n",
    "        read_mtx_header(\n",
    "            matrix_path\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    n_barcodes = count_gzip_lines(\n",
    "        barcode_path\n",
    "    )\n",
    "\n",
    "\n",
    "    n_feature_rows = count_gzip_lines(\n",
    "        feature_path\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_cells_matrix\n",
    "        ==\n",
    "        n_barcodes\n",
    "    ), (\n",
    "        f\"{sample_id}: matrix columns != barcodes\"\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_features_matrix\n",
    "        ==\n",
    "        n_feature_rows\n",
    "    ), (\n",
    "        f\"{sample_id}: matrix rows != feature rows\"\n",
    "    )\n",
    "\n",
    "\n",
    "    manifest_rows.append({\n",
    "\n",
    "        \"GSM\":\n",
    "            gsm,\n",
    "\n",
    "        \"sample_id\":\n",
    "            sample_id,\n",
    "\n",
    "        \"diagnosis_binary\":\n",
    "            diagnosis,\n",
    "\n",
    "        \"matrix_features\":\n",
    "            int(\n",
    "                n_features_matrix\n",
    "            ),\n",
    "\n",
    "        \"raw_filtered_barcodes\":\n",
    "            int(\n",
    "                n_cells_matrix\n",
    "            ),\n",
    "\n",
    "        \"matrix_nnz\":\n",
    "            int(\n",
    "                n_nnz\n",
    "            ),\n",
    "\n",
    "        \"barcode_rows\":\n",
    "            int(\n",
    "                n_barcodes\n",
    "            ),\n",
    "\n",
    "        \"feature_rows\":\n",
    "            int(\n",
    "                n_feature_rows\n",
    "            ),\n",
    "\n",
    "        \"matrix_file\":\n",
    "            str(\n",
    "                matrix_path\n",
    "            ),\n",
    "\n",
    "        \"barcode_file\":\n",
    "            str(\n",
    "                barcode_path\n",
    "            ),\n",
    "\n",
    "        \"feature_file\":\n",
    "            str(\n",
    "                feature_path\n",
    "            ),\n",
    "\n",
    "        \"matrix_sha256\":\n",
    "            sha256_file(\n",
    "                matrix_path\n",
    "            ),\n",
    "\n",
    "        \"barcode_sha256\":\n",
    "            sha256_file(\n",
    "                barcode_path\n",
    "            ),\n",
    "\n",
    "        \"feature_sha256\":\n",
    "            sha256_file(\n",
    "                feature_path\n",
    "            ),\n",
    "\n",
    "    })\n",
    "\n",
    "\n",
    "sample_manifest = pd.DataFrame(\n",
    "    manifest_rows\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    sample_manifest\n",
    ") == 21\n",
    "\n",
    "\n",
    "assert (\n",
    "    sample_manifest[\n",
    "        \"diagnosis_binary\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    "    ==\n",
    "    {\n",
    "        \"AD\": 12,\n",
    "        \"Control\": 9,\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"OFFICIAL RAW SAMPLE MANIFEST\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "\n",
    "    sample_manifest[\n",
    "        [\n",
    "            \"GSM\",\n",
    "            \"sample_id\",\n",
    "            \"diagnosis_binary\",\n",
    "            \"matrix_features\",\n",
    "            \"raw_filtered_barcodes\",\n",
    "            \"matrix_nnz\",\n",
    "        ]\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "raw_total_cells = int(\n",
    "\n",
    "    sample_manifest[\n",
    "        \"raw_filtered_barcodes\"\n",
    "    ]\n",
    "    .sum()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nRaw Cell Ranger filtered barcodes total:\",\n",
    "    f\"{raw_total_cells:,}\"\n",
    ")\n",
    "\n",
    "\n",
    "# Literature reconstruction reports ~179,392 raw nuclei.\n",
    "# This is an audit comparison, NOT an exclusion rule.\n",
    "EXPECTED_RAW_TOTAL_LITERATURE = 179392\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Published/reconstructed raw total reference:\",\n",
    "    f\"{EXPECTED_RAW_TOTAL_LITERATURE:,}\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Raw-total difference:\",\n",
    "    (\n",
    "        raw_total_cells\n",
    "        -\n",
    "        EXPECTED_RAW_TOTAL_LITERATURE\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "sample_manifest.to_csv(\n",
    "    SAMPLE_MANIFEST_PATH,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. FEATURE-FILE IDENTITY AUDIT\n",
    "# ============================================================\n",
    "\n",
    "feature_audit = (\n",
    "\n",
    "    sample_manifest[\n",
    "        [\n",
    "            \"GSM\",\n",
    "            \"sample_id\",\n",
    "            \"matrix_features\",\n",
    "            \"feature_sha256\",\n",
    "            \"feature_file\",\n",
    "        ]\n",
    "    ]\n",
    "    .copy()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "n_unique_feature_hashes = int(\n",
    "\n",
    "    feature_audit[\n",
    "        \"feature_sha256\"\n",
    "    ]\n",
    "    .nunique()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "n_unique_feature_counts = int(\n",
    "\n",
    "    feature_audit[\n",
    "        \"matrix_features\"\n",
    "    ]\n",
    "    .nunique()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"FEATURE-FILE AUDIT\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Unique feature-row counts:\",\n",
    "    n_unique_feature_counts\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Unique feature-file SHA256 values:\",\n",
    "    n_unique_feature_hashes\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    feature_audit\n",
    ")\n",
    "\n",
    "\n",
    "feature_audit.to_csv(\n",
    "    FEATURE_MANIFEST_PATH,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. SERIES-MATRIX AUDIT\n",
    "#\n",
    "# We only inspect GEO metadata text.\n",
    "# ============================================================\n",
    "\n",
    "with gzip.open(\n",
    "    SERIES_MATRIX_PATH,\n",
    "    \"rt\",\n",
    "    errors=\"replace\"\n",
    ") as f:\n",
    "\n",
    "    series_text = f.read()\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"GEO SERIES MATRIX METADATA LINES\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "interesting_prefixes = (\n",
    "\n",
    "    \"!Sample_geo_accession\",\n",
    "    \"!Sample_title\",\n",
    "    \"!Sample_source_name_ch1\",\n",
    "    \"!Sample_characteristics_ch1\",\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "series_lines = []\n",
    "\n",
    "\n",
    "for line in series_text.splitlines():\n",
    "\n",
    "\n",
    "    if line.startswith(\n",
    "        interesting_prefixes\n",
    "    ):\n",
    "\n",
    "        series_lines.append(\n",
    "            line\n",
    "        )\n",
    "\n",
    "\n",
    "for line in series_lines:\n",
    "\n",
    "    print(\n",
    "        line[:5000]\n",
    "    )\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "print('STEP 24A V2 PASS — official GEO raw archive, triplets, manifest and series audit ready')"
   ]
