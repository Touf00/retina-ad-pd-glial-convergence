    "] = str(\n",
    "    ROOT\n",
    ")\n",
    "\n",
    "\n",
    "env[\n",
    "    \"PYTHONUNBUFFERED\"\n",
    "] = \"1\"\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nLaunching STEP 29 in a fresh Python process...\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Log:\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    log\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. STREAM ALL OUTPUT DIRECTLY INTO COLAB\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    log,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as lf:\n",
    "\n",
    "    proc = subprocess.Popen(\n",
    "\n",
    "        [\n",
    "            sys.executable,\n",
    "            \"-u\",\n",
    "            str(\n",
    "                runner\n",
    "            ),\n",
    "        ],\n",
    "\n",
    "        stdout=subprocess.PIPE,\n",
    "\n",
    "        stderr=subprocess.STDOUT,\n",
    "\n",
    "        text=True,\n",
    "\n",
    "        env=env,\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    for line in proc.stdout:\n",
    "\n",
    "        print(\n",
    "            line,\n",
    "            end=\"\",\n",
    "        )\n",
    "\n",
    "        lf.write(\n",
    "            line\n",
    "        )\n",
    "\n",
    "\n",
    "    rc = proc.wait()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. FAIL WITH THE REAL OUTPUT ALREADY VISIBLE\n",
    "# ============================================================\n",
    "\n",
    "if rc != 0:\n",
    "\n",
    "    raise RuntimeError(\n",
    "\n",
    "        f\"STEP 29 failed with exit code {rc}. \"\n",
    "        \"The full child-process traceback is printed above \"\n",
    "        f\"and saved here:\\n{log}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 12. FINAL VERIFICATION\n",
    "# ============================================================\n",
    "\n",
    "assert FINAL_LOCK.exists(), (\n",
    "    \"STEP29 completed but final lock is missing: \"\n",
    "    f\"{FINAL_LOCK}\"\n",
    ")\n",
    "\n",
    "\n",
    "with open(\n",
    "    FINAL_LOCK,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    result = json.load(\n",
    "        f\n",
    "    )\n",
    "\n",
    "\n",
    "assert (\n",
    "    result[\n",
    "        \"GSE157827_replication_robustness_complete\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"STEP 29 REPLACEMENT COMPLETED SUCCESSFULLY\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    json.dumps(\n",
    "        result[\n",
    "            \"OPC_cellcount20\"\n",
    "        ],\n",
    "        indent=2,\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
