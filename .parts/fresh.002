   "source": [
    "# Source analysis cell: 68\n",
    "# ============================================================\n",
    "# WOLF et al. CELL 2023 — TABLE S7 INPUT CHECK\n",
    "# Non-interactive release version\n",
    "# ============================================================\n",
    "\n",
    "from pathlib import Path\n",
    "import hashlib\n",
    "import json\n",
    "import zipfile\n",
    "import pandas as pd\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "LOCKS = ROOT / \"locks\"\n",
    "WOLF_DIR = ROOT / \"ocular_validation\" / \"Wolf_Cell_2023\"\n",
    "LOCKS.mkdir(parents=True, exist_ok=True)\n",
    "WOLF_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "WORKBOOK = WOLF_DIR / \"NIHMS1931846-supplement-8.xlsx\"\n",
    "\n",
    "if not WORKBOOK.exists():\n",
    "    raise FileNotFoundError(\n",
    "        \"Missing Wolf et al. Cell 2023 Table S7 workbook.\\n\"\n",
    "        \"Download the paper's mmc3.xlsx / Table S7 supplementary workbook \"\n",
    "        \"and place it at:\\n\"\n",
    "        f\"{WORKBOOK}\\n\"\n",
    "        \"The release notebook intentionally avoids an interactive Colab upload step.\"\n",
    "    )\n",
    "\n",
    "assert WORKBOOK.read_bytes()[:2] == b\"PK\", \"Wolf Table S7 is not a valid XLSX file.\"\n",
    "assert zipfile.is_zipfile(WORKBOOK), \"Wolf Table S7 is not a valid XLSX/ZIP file.\"\n",
    "\n",
    "with zipfile.ZipFile(WORKBOOK, \"r\") as z:\n",
    "    bad = z.testzip()\n",
    "assert bad is None, f\"Corrupt XLSX member: {bad}\"\n",
    "\n",
    "def sha256_file(path):\n",
    "    h = hashlib.sha256()\n",
    "    with open(path, \"rb\") as f:\n",
    "        for block in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
    "            h.update(block)\n",
    "    return h.hexdigest()\n",
    "\n",
    "xls = pd.ExcelFile(WORKBOOK)\n",
    "assert \"Supplement_table_all_data\" in xls.sheet_names, (\n",
    "    \"Expected sheet 'Supplement_table_all_data' not found in Wolf Table S7.\"\n",
    ")\n",
    "\n",
    "record = {\n",
    "    \"status\": \"WOLF_CELL_2023_TABLE_S7_VERIFIED\",\n",
    "    \"paper\": \"Wolf et al., Cell 2023\",\n",
    "    \"table\": \"Table S7\",\n",
    "    \"local_file\": str(WORKBOOK),\n",
    "    \"file_bytes\": int(WORKBOOK.stat().st_size),\n",
    "    \"sha256\": sha256_file(WORKBOOK),\n",
    "    \"sheets\": xls.sheet_names,\n",
    "    \"PD_proteomic_analysis_performed\": False,\n",
    "}\n",
    "\n",
    "with open(\n",
    "    LOCKS / \"WOLF_CELL_2023_TABLE_S7_ACQUISITION_FREEZE_v1.json\",\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "    json.dump(record, f, indent=2)\n",
    "\n",
    "print(\"Wolf Table S7 input verified:\", WORKBOOK)\n",
    "print(\"SHA256:\", record[\"sha256\"])\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 70\n",
    "# ============================================================\n",
    "# V2 PXD073336 AD RETINA\n",
    "# WORKBOOK SCHEMA AUDIT + BRAIN-CONVERGENCE PROTEIN COVERAGE\n",
    "#\n",
    "# PURPOSE\n",
    "# -------\n",
    "# 1. Inspect the REAL PXD073336 processed workbook.\n",
    "# 2. Identify the protein/gene-symbol column.\n",
    "# 3. Identify retinal and hippocampal abundance columns.\n",
    "# 4. Determine whether author-level differential statistics\n",
    "#    are already contained in this workbook.\n",
    "# 5. Match frozen AD↔PD brain-convergent genes to proteins\n",
    "#    actually measured in PXD073336.\n",
    "#\n",
    "# IMPORTANT\n",
    "# ---------\n",
    "# This cell DOES NOT calculate AD-vs-control retinal effects.\n",
    "# We first establish the real workbook schema.\n",
    "#\n",
    "# The published PXD073336 study used:\n",
    "#\n",
    "# Protein ~ C(Buffer) * C(Diagnosis)\n",
    "#           + C(Sex) + Age\n",
    "#           + (1 | Subject)\n",
    "#\n",
    "# Retina:\n",
    "#     8 AD + 8 non-demented controls\n",
    "#\n",
    "# Expected raw MS runs:\n",
    "#     Retina      = 16 donors × 2 buffers = 32\n",
    "#     Hippocampus = 15 donors × 2 buffers = 30\n",
    "# ============================================================\n",
    "\n",
    "from pathlib import Path\n",
    "from IPython.display import display\n",
    "\n",
    "import json\n",
    "import re\n",
    "import hashlib\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = (\n",
    "    ROOT /\n",
    "    \"locks\"\n",
    ")\n",
    "\n",
    "PXD_DIR = (\n",
    "    ROOT /\n",
    "    \"ocular_validation\" /\n",
    "    \"PXD073336\"\n",
    ")\n",
    "\n",
    "WORKBOOK = (\n",
    "    PXD_DIR /\n",
    "    \"Retinaxhippocampus_Proteomics.xlsx\"\n",
    ")\n",
    "\n",
    "CONVERGENCE_PATH = (\n",
    "    ROOT /\n",
    "    \"results\" /\n",
    "    \"cross_disease_convergence\" /\n",
    "    \"AD_PD_ALL_GENE_CONVERGENCE_v2.csv.gz\"\n",
    ")\n",
    "\n",    "OUT = (\n",
    "    PXD_DIR /\n",
    "    \"analysis\"\n",
    ")\n",
    "\n",
    "\n",
    "OUT.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "LOCKS.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "\n",
    "assert WORKBOOK.exists(), (\n",
    "    \"Missing PXD073336 workbook:\\n\"\n",
    "    f\"{WORKBOOK}\"\n",
    ")\n",
    "\n",
    "assert CONVERGENCE_PATH.exists(), (\n",
    "    \"Missing frozen AD↔PD convergence table:\\n\"\n",
    "    f\"{CONVERGENCE_PATH}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. SHA256\n",
    "# ============================================================\n",
    "\n",
    "def sha256_file(\n",
    "    path\n",
    "):\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\"\n",
    "    ) as f:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            block = f.read(\n",
    "                1024 * 1024\n",
    "            )\n",
    "\n",
    "            if not block:\n",
    "                break\n",
    "\n",
    "            h.update(\n",
    "                block\n",
    "            )\n",
    "\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "WORKBOOK_SHA256 = sha256_file(\n",
    "    WORKBOOK\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. OPEN WORKBOOK\n",
    "# ============================================================\n",
    "\n",
    "xls = pd.ExcelFile(\n",
    "    WORKBOOK\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PXD073336 — WORKBOOK SCHEMA AUDIT\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nWorkbook:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    WORKBOOK\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nBytes:\",\n",
    "    f\"{WORKBOOK.stat().st_size:,}\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"SHA256:\",\n",
    "    WORKBOOK_SHA256\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSheets:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    xls.sheet_names\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    xls.sheet_names\n",
    ") >= 1\n",
    "\n",
    "\n",
    "if \"Proteins\" in xls.sheet_names:\n",
    "\n",
    "    SHEET = \"Proteins\"\n",
    "\n",
    "else:\n",
    "\n",
    "    SHEET = xls.sheet_names[\n",
    "        0\n",
    "    ]\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nUsing sheet:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    SHEET\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. RAW TOP-OF-SHEET PREVIEW\n",
    "#\n",
    "# Read without assuming a header.\n",
    "# ============================================================\n",
    "\n",
    "raw_preview = pd.read_excel(\n",
    "    WORKBOOK,\n",
    "    sheet_name=SHEET,\n",
    "    header=None,\n",
    "    nrows=15,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"RAW FIRST 15 ROWS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    raw_preview\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. LOAD WITH FIRST ROW AS HEADER\n",
    "# ============================================================\n",
    "\n",
    "df = pd.read_excel(\n",
    "    WORKBOOK,\n",
    "    sheet_name=SHEET,\n",
    "    header=0,\n",
    ")\n",
    "\n",
    "\n",
    "# Remove completely empty columns.\n",
    "df = df.dropna(\n",
    "    axis=1,\n",
    "    how=\"all\",\n",
    ")\n",
    "\n",
    "\n",
    "# Remove completely empty rows.\n",
    "df = df.dropna(\n",
    "    axis=0,\n",
    "    how=\"all\",\n",
    ").reset_index(\n",
    "    drop=True\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PROCESSED TABLE STRUCTURE\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Shape:\",\n",
    "    df.shape\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nColumns:\"\n",
    ")\n",
    "\n",
    "\n",
    "for i, col in enumerate(\n",
    "    df.columns\n",
    "):\n",
    "\n",
    "    print(\n",
    "        f\"{i:03d}: {col}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. COLUMN-NAME NORMALIZATION\n",
    "# ============================================================\n",
    "\n",
    "def norm_col(\n",
    "    value\n",
    "):\n",
    "\n",
    "    return re.sub(\n",
    "        r\"\\s+\",\n",
    "        \" \",\n",
    "        str(\n",
    "            value\n",
    "        )\n",
    "        .strip()\n",
    "        .lower()\n",
    "    )\n",
    "\n",
    "\n",
    "norm = {\n",
    "\n",
    "    col:\n",
    "        norm_col(\n",
    "            col\n",
    "        )\n",
    "\n",
    "    for col\n",
    "    in df.columns\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. IDENTIFY GENE-SYMBOL COLUMN\n",
    "# ============================================================\n",
    "\n",
    "def gene_score(\n",
    "    col\n",
    "):\n",
    "\n",
    "    c = norm[\n",
    "        col\n",
    "    ]\n",
    "\n",
    "\n",
    "    score = 0\n",
    "\n",
    "\n",
    "    if c in {\n",
    "        \"gene symbol\",\n",
    "        \"gene symbols\",\n",
    "        \"gene name\",\n",
    "        \"gene names\",\n",
    "        \"genes\",\n",
    "        \"symbol\",\n",
    "    }:\n",
    "\n",
    "        score += 100\n",
    "\n",
    "\n",
    "    if (\n",
    "        \"gene\"\n",
    "        in c\n",
    "        and\n",
    "        \"symbol\"\n",
    "        in c\n",
    "    ):\n",
    "\n",
    "        score += 80\n",
    "\n",
    "\n",
    "    if (\n",
    "        \"gene\"\n",
    "        in c\n",
    "        and\n",
    "        \"name\"\n",
    "        in c\n",
    "    ):\n",
    "\n",
    "        score += 60\n",
    "\n",
    "\n",
    "    if c.startswith(\n",
    "        \"gene\"\n",
    "    ):\n",
    "\n",
    "        score += 20\n",
    "\n",
    "\n",
    "    if \"accession\" in c:\n",
    "\n",
    "        score -= 20\n",
    "\n",
    "\n",
    "    if \"protein description\" in c:\n",
    "\n",
    "        score -= 50\n",
    "\n",
    "\n",
    "    if c == \"description\":\n",
    "\n",
    "        score -= 50\n",
    "\n",
    "\n",
    "    return score\n",
    "\n",
    "\n",
    "gene_scores = {\n",
    "\n",
    "    col:\n",
    "        gene_score(\n",
    "            col\n",
    "        )\n",
    "\n",
    "    for col\n",
    "    in df.columns\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "gene_candidates = sorted(\n",
    "\n",
    "    [\n",
    "        (\n",
    "            score,\n",
    "            col,\n",
    "        )\n",
    "\n",
    "        for col, score\n",
    "        in gene_scores.items()\n",
    "\n",
    "        if score > 0\n",
    "    ],\n",
    "\n",
    "    reverse=True,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nGene-column candidates:\"\n",
    ")\n",
    "\n",
    "\n",
    "if gene_candidates:\n",
    "\n",
    "    for score, col in gene_candidates[\n",
    "        :10\n",
    "    ]:\n",
    "\n",
    "        print(\n",
    "            f\"  score={score:3d}  {col}\"\n",
    "        )\n",
    "\n",
    "\n",
    "    GENE_COL = gene_candidates[\n",
    "        0\n",
    "    ][\n",
    "        1\n",
    "    ]\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nSelected gene-symbol column:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        GENE_COL\n",
    "    )\n",
    "\n",
    "\n",
    "else:\n",
    "\n",
    "    GENE_COL = None\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nWARNING:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"No convincing gene-symbol column was identified.\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. IDENTIFY PROTEIN IDENTIFIER COLUMNS\n",
    "# ============================================================\n",
    "\n",
    "protein_id_candidates = [\n",
    "\n",
    "    col\n",
    "\n",
    "    for col\n",
    "    in df.columns\n",
    "\n",
    "    if any(\n",
    "\n",
    "        token in norm[\n",
    "            col\n",
    "        ]\n",
    "\n",
    "        for token in [\n",
    "\n",
    "            \"accession\",\n",
    "            \"protein id\",\n",
    "            \"protein ids\",\n",
    "            \"master protein\",\n",
    "            \"protein group\",\n",
    "\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nProtein-ID candidate columns:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    protein_id_candidates\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. IDENTIFY RAW / ABUNDANCE SAMPLE COLUMNS\n",
    "#\n",
    "# PRIDE lists sample/run identifiers such as:\n",
    "#\n",
    "# S14_RET_Lysis_...\n",
    "# S19_Brain_Ripa_...\n",
    "# ============================================================\n",
    "\n",
    "retina_sample_cols = [\n",
    "\n",
    "    col\n",
    "\n",
    "    for col\n",
    "    in df.columns\n",
    "\n",
    "    if re.search(\n",
    "        r\"S\\d+.*RET.*(?:Lysis|Ripa)\",\n",
    "        str(\n",
    "            col\n",
    "        ),\n",
    "        flags=re.IGNORECASE,\n",
    "    )\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "brain_sample_cols = [\n",
    "\n",
    "    col\n",
    "\n",
    "    for col\n",
    "    in df.columns\n",
    "\n",
    "    if re.search(\n",
    "        r\"S\\d+.*Brain.*(?:Lysis|Ripa)\",\n",
    "        str(\n",
    "            col\n",
    "        ),\n",
    "        flags=re.IGNORECASE,\n",
    "    )\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "all_sample_cols = (\n",
    "\n",
    "    retina_sample_cols\n",
    "    +\n",
    "    brain_sample_cols\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"SAMPLE COLUMN DETECTION\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Retina sample columns detected:\",\n",
    "    len(\n",
    "        retina_sample_cols\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Brain sample columns detected:\",\n",
    "    len(\n",
    "        brain_sample_cols\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Total sample columns detected:\",\n",
    "    len(\n",
    "        all_sample_cols\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "if retina_sample_cols:\n",
    "\n",
    "    print(\n",
    "        \"\\nFirst retinal columns:\"\n",
    "    )\n",
    "\n",
    "\n",
    "    for col in retina_sample_cols[\n",
    "        :10\n",
    "    ]:\n",
    "\n",
    "        print(\n",
    "            \" \",\n",
    "            col\n",
    "        )\n",
    "\n",
    "\n",
    "if brain_sample_cols:\n",
    "\n",
    "    print(\n",
    "        \"\\nFirst hippocampal columns:\"\n",
    "    )\n",
    "\n",
    "\n",
    "    for col in brain_sample_cols[\n",
    "        :10\n",
    "    ]:\n",
    "\n",
    "        print(\n",
    "            \" \",\n",
    "            col\n",
    "        )\n",
    "\n",
    "\n",
    "# Expected study design from the published dataset.\n",
    "if len(\n",
    "    retina_sample_cols\n",
    ") == 32:\n",
    "\n",
    "    print(\n",
    "        \"\\nRetinal run count: PASS (expected 32)\"\n",
    "    )\n",
    "\n",
    "else:\n",
    "\n",
    "    print(\n",
    "        \"\\nRetinal run count:\"\n",
    "        f\" observed={len(retina_sample_cols)}, expected=32\"\n",
    "    )\n",
    "\n",
    "\n",
    "if len(\n",
    "    brain_sample_cols\n",
    ") == 30:\n",
    "\n",
    "    print(\n",
    "        \"Hippocampal run count: PASS (expected 30)\"\n",
    "    )\n",
    "\n",
    "else:\n",
    "\n",
    "    print(\n",
    "        \"Hippocampal run count:\"\n",
    "        f\" observed={len(brain_sample_cols)}, expected=30\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. IDENTIFY POSSIBLE AUTHOR STATISTIC COLUMNS\n",
    "# ============================================================\n",
    "\n",
    "effect_tokens = [\n",
    "\n",
    "    \"beta\",\n",
    "    \"coefficient\",\n",
    "    \"estimate\",\n",
    "    \"effect\",\n",
    "    \"log2fc\",\n",
    "    \"log2 fold\",\n",
    "    \"fold change\",\n",
    "]\n",
    "\n",
    "\n",
    "p_tokens = [\n",
    "\n",
    "    \"pvalue\",\n",
    "    \"p value\",\n",
    "    \"p-value\",\n",
    "    \"pval\",\n",
    "]\n",
    "\n",
    "\n",
    "fdr_tokens = [\n",
    "\n",
    "    \"fdr\",\n",
    "    \"adjusted p\",\n",
    "    \"adj p\",\n",
    "    \"q-value\",\n",
    "    \"q value\",\n",
    "    \"padj\",\n",
    "]\n",
    "\n",
    "\n",
    "effect_cols = [\n",
    "\n",
    "    col\n",
    "\n",
    "    for col\n",
    "    in df.columns\n",
    "\n",
    "    if any(\n",
    "        token in norm[\n",
    "            col\n",
    "        ]\n",
    "        for token in effect_tokens\n",
    "    )\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "pvalue_cols = [\n",
    "\n",
    "    col\n",
    "\n",
    "    for col\n",
    "    in df.columns\n",
    "\n",
    "    if any(\n",
    "        token in norm[\n",
    "            col\n",
    "        ]\n",
    "        for token in p_tokens\n",
    "    )\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "fdr_cols = [\n",
    "\n",
    "    col\n",
    "\n",
    "    for col\n",
    "    in df.columns\n",
    "\n",
    "    if any(\n",
    "        token in norm[\n",
    "            col\n",
    "        ]\n",
    "        for token in fdr_tokens\n",
    "    )\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"AUTHOR-STATISTIC COLUMN SEARCH\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Effect-size columns:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    effect_cols\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nP-value columns:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    pvalue_cols\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFDR / adjusted-P columns:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    fdr_cols\n",
    ")\n",
    "\n",
    "\n",
    "AUTHOR_STATS_PRESENT = (\n",
    "\n",
    "    len(\n",
    "        effect_cols\n",
    "    ) > 0\n",
    "\n",
    "    and\n",
    "\n",
    "    (\n",
    "        len(\n",
    "            fdr_cols\n",
    "        ) > 0\n",
    "        or\n",
    "        len(\n",
    "            pvalue_cols\n",
    "        ) > 0\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nAuthor differential-statistic columns present:\",\n",
    "    AUTHOR_STATS_PRESENT\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. SEARCH FOR METADATA-LIKE COLUMNS\n",
    "# ============================================================\n",
    "\n",
    "metadata_tokens = [\n",
    "\n",
    "    \"diagnosis\",\n",
    "    \"disease\",\n",
    "    \"group\",\n",
    "    \"condition\",\n",
    "    \"subject\",\n",
    "    \"donor\",\n",
    "    \"patient\",\n",
    "    \"age\",\n",
    "    \"sex\",\n",
    "    \"gender\",\n",
    "    \"buffer\",\n",
    "    \"tissue\",\n",
    "]\n",
    "\n",
    "\n",
    "metadata_cols = [\n",
    "\n",
    "    col\n",
    "\n",
    "    for col\n",
    "    in df.columns\n",
    "\n",
    "    if any(\n",
    "        token in norm[\n",
    "            col\n",
    "        ]\n",
    "        for token in metadata_tokens\n",
    "    )\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nMetadata-like columns:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    metadata_cols\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. GENE-SYMBOL NORMALIZATION\n",
    "# ============================================================\n",
    "\n",
    "def split_symbols(\n",
    "    value\n",
    "):\n",
    "\n",
    "    if pd.isna(\n",
    "        value\n",
    "    ):\n",
    "\n",
    "        return []\n",
    "\n",
    "\n",
    "    text = str(\n",
    "        value\n",
    "    ).strip()\n",
    "\n",
    "\n",
    "    if not text:\n",
    "\n",
    "        return []\n",
    "\n",
    "\n",
    "    # Proteomics exports commonly separate alternative/\n",
    "    # grouped gene symbols with semicolon, comma or pipe.\n",
    "    parts = re.split(\n",
    "        r\"[;,|]+\",\n",
    "        text,\n",
    "    )\n",
    "\n",
    "\n",
    "    clean = []\n",
    "\n",
    "\n",
    "    for part in parts:\n",
    "\n",
    "        symbol = (\n",
    "            str(\n",
    "                part\n",
    "            )\n",
    "            .strip()\n",
    "            .upper()\n",
    "        )\n",
    "\n",
    "\n",
    "        if (\n",
    "            symbol\n",
    "            and\n",
    "            symbol\n",
    "            not in {\n",
    "                \"NAN\",\n",
    "                \"NONE\",\n",
    "                \"NA\",\n",
    "            }\n",
    "        ):\n",
    "\n",
    "            clean.append(\n",
    "                symbol\n",
    "            )\n",
    "\n",
    "\n",
    "    return clean\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 12. BRAIN-CONVERGENCE PROTEIN MEASURABILITY\n",
    "# ============================================================\n",
    "\n",
    "MEASURABILITY_PATH = (\n",
    "    OUT /\n",
    "    \"PXD073336_BRAIN_CONVERGENCE_PROTEIN_MEASURABILITY_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "SUMMARY_PATH = (\n",
    "    OUT /\n",
    "    \"PXD073336_BRAIN_CONVERGENCE_PROTEIN_MEASURABILITY_SUMMARY_v1.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "if GENE_COL is not None:\n",
    "\n",
    "\n",
    "    measured_symbols = set()\n",
    "\n",
    "\n",
    "    for value in df[\n",
    "        GENE_COL\n",
    "    ]:\n",
    "\n",
    "        measured_symbols.update(\n",
    "            split_symbols(\n",
    "                value\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nUnique gene symbols represented in PXD073336:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"{len(measured_symbols):,}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    convergence = pd.read_csv(\n",
    "        CONVERGENCE_PATH,\n",
    "        compression=\"gzip\",\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        \"gene_symbol\"\n",
    "        in convergence.columns\n",
    "    )\n",
    "\n",
    "\n",
    "    convergence[\n",
    "        \"gene_symbol\"\n",
    "    ] = (\n",
    "        convergence[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .str.upper()\n",
    "        .str.strip()\n",
    "    )\n",
    "\n",
    "\n",
    "    convergence[\n",
    "        \"PXD073336_protein_measured\"\n",
    "    ] = (\n",
    "\n",
    "        convergence[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .isin(\n",
    "            measured_symbols\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    convergence.to_csv(\n",
    "        MEASURABILITY_PATH,\n",
    "        index=False,\n",
    "        compression=\"gzip\",\n",
    "    )\n",
    "\n",
    "\n",
    "    coverage_summary = (\n",
    "\n",
    "        convergence\n",
    "        .groupby(\n",
    "            \"cell_type\",\n",
    "            as_index=False,\n",
    "        )\n",
    "        .agg(\n",
    "\n",
    "            brain_convergence_genes=(\n",
    "                \"gene_symbol\",\n",
    "                \"size\",\n",
    "            ),\n",
    "\n",
    "            PXD073336_measured=(\n",
    "                \"PXD073336_protein_measured\",\n",
    "                \"sum\",\n",
    "            ),\n",
    "\n",
    "        )\n",
    "\n",