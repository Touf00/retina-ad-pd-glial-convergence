   "source": [
    "# Source analysis cell: 50\n",
    "# ============================================================\n",
    "# RETINA-ND — STEP 27 — CORRECTED\n",
    "# GSE157827 FINAL DONOR ELIGIBILITY\n",
    "# + DESIGN FEASIBILITY\n",
    "# + RAW DONOR PSEUDOBULK\n",
    "# + REPLICATION GENE-UNIVERSE FREEZE\n",
    "#\n",
    "# FIXES IN THIS VERSION\n",
    "# ---------------------\n",
    "# 1. Removed erroneous requirement that ROOT/results already exist.\n",
    "#    That directory is not required by this step.\n",
    "#\n",
    "# 2. Corrected sex coding:\n",
    "#       frozen metadata uses \"Male\" / \"Female\"\n",
    "#    and the design now accepts:\n",
    "#       Male / M\n",
    "#\n",
    "# PRIMARY DONOR-CELL THRESHOLD:\n",
    "#     >=10 nuclei / donor / final target cell type\n",
    "#\n",
    "# CELL-COUNT SENSITIVITY:\n",
    "#     >=20 nuclei / donor / final target cell type\n",
    "#\n",
    "# GENE FILTER:\n",
    "#     CPM >= 1 in >= smaller diagnosis-group size\n",
    "#     among PRIMARY-eligible donors within each cell type.\n",
    "#\n",
    "# MT- genes are removed AFTER the expression filter.\n",
    "#\n",
    "# NO DE\n",
    "# NO discovery-replication comparison\n",
    "# NO GSE138852 disease DE\n",
    "# NO PD loading\n",
    "# NO AD<->PD convergence\n",
    "# ============================================================\n",
    "\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "import gzip\n",
    "import hashlib\n",
    "import json\n",
    "import gc\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from scipy.io import mmread\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. CONSTANTS\n",
    "# ============================================================\n",
    "\n",
    "PRIMARY_MIN_NUCLEI = 10\n",
    "\n",
    "SENSITIVITY_MIN_NUCLEI = 20\n",
    "\n",
    "CPM_THRESHOLD = 1.0\n",
    "\n",
    "DESIGN_CONDITION_LIMIT = 10.0\n",
    "\n",
    "\n",
    "TARGET_CLASSES = [\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "]\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = (\n",
    "    ROOT\n",
    "    /\n",
    "    \"locks\"\n",
    ")\n",
    "\n",
    "MANIFESTS = (\n",
    "    ROOT\n",
    "    /\n",
    "    \"manifests\"\n",
    ")\n",
    "\n",
    "REP_DIR = (\n",
    "    ROOT\n",
    "    /\n",
    "    \"GSE157827_AD_replication\"\n",
    ")\n",
    "\n",
    "FINAL_ANNO_DIR = (\n",
    "    REP_DIR\n",
    "    /\n",
    "    \"annotation_final\"\n",
    ")\n",
    "\n",
    "PB_DIR = (\n",
    "    REP_DIR\n",
    "    /\n",
    "    \"pseudobulk\"\n",
    ")\n",
    "\n",
    "GENE_UNIVERSE_DIR = (\n",
    "    REP_DIR\n",
    "    /\n",
    "    \"gene_universes\"\n",
    ")\n",
    "\n",
    "\n",
    "# Only these upstream directories MUST already exist.\n",
    "for directory in [\n",
    "    ROOT,\n",
    "    LOCKS,\n",
    "    MANIFESTS,\n",
    "    REP_DIR,\n",
    "    FINAL_ANNO_DIR,\n",
    "]:\n",
    "\n",
    "    assert directory.exists(), (\n",
    "        f\"Required existing directory missing: {directory}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# These are STEP27 output directories, so create them if absent.\n",
    "PB_DIR.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "GENE_UNIVERSE_DIR.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. INPUT PATHS\n",
    "# ============================================================\n",
    "\n",
    "STEP26B_LOCK = (\n",
    "    LOCKS\n",
    "    /\n",
    "    \"GSE157827_AD_REPLICATION_FINAL_CELLTYPE_MAPPING_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "STEP25_LOCK = (\n",
    "    LOCKS\n",
    "    /\n",
    "    \"GSE157827_AD_REPLICATION_DONOR_METADATA_AND_QC_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "SAMPLE_MANIFEST_PATH = (\n",
    "    MANIFESTS\n",
    "    /\n",
    "    \"GSE157827_OFFICIAL_RAW_SAMPLE_MANIFEST_v1.csv\"\n",
    ")\n",
    "\n",
    "FINAL_CELL_LABEL_PATH = (\n",
    "    FINAL_ANNO_DIR\n",
    "    /\n",
    "    \"GSE157827_FINAL_TARGET_CELL_LABELS_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "FINAL_DONOR_COVERAGE_PATH = (\n",
    "    FINAL_ANNO_DIR\n",
    "    /\n",
    "    \"GSE157827_FINAL_TARGET_DONOR_COVERAGE_v1.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. OUTPUT PATHS\n",
    "# ============================================================\n",
    "\n",
    "ELIGIBILITY_PATH = (\n",
    "    MANIFESTS\n",
    "    /\n",
    "    \"GSE157827_FINAL_TARGET_DONOR_ELIGIBILITY_v1.csv\"\n",
    ")\n",
    "\n",
    "DESIGN_AUDIT_PATH = (\n",
    "    MANIFESTS\n",
    "    /\n",
    "    \"GSE157827_FINAL_TARGET_DESIGN_AUDIT_v1.csv\"\n",
    ")\n",
    "\n",
    "AGE_OVERLAP_AUDIT_PATH = (\n",
    "    MANIFESTS\n",
    "    /\n",
    "    \"GSE157827_FINAL_TARGET_AGE_OVERLAP_AUDIT_v1.csv\"\n",
    ")\n",
    "\n",
    "GROUP_METADATA_PATH = (\n",
    "    MANIFESTS\n",
    "    /\n",
    "    \"GSE157827_FINAL_TARGET_PSEUDOBULK_GROUP_METADATA_v1.csv\"\n",
    ")\n",
    "\n",
    "PSEUDOBULK_ALL_PATH = (\n",
    "    PB_DIR\n",
    "    /\n",
    "    \"GSE157827_FINAL_TARGET_DONOR_PSEUDOBULK_RAW_ALL_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "GENE_UNIVERSE_SUMMARY_PATH = (\n",
    "    GENE_UNIVERSE_DIR\n",
    "    /\n",
    "    \"GSE157827_REPLICATION_GENE_UNIVERSE_SUMMARY_v1.csv\"\n",
    ")\n",
    "\n",
    "STEP27_LOCK = (\n",
    "    LOCKS\n",
    "    /\n",
    "    \"GSE157827_AD_REPLICATION_PRE_DE_PSEUDOBULK_AND_GENE_UNIVERSE_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "    STEP26B_LOCK,\n",
    "    STEP25_LOCK,\n",
    "    SAMPLE_MANIFEST_PATH,\n",
    "    FINAL_CELL_LABEL_PATH,\n",
    "    FINAL_DONOR_COVERAGE_PATH,\n",
    "]:\n",
    "\n",
    "    assert path.exists(), (\n",
    "        f\"Missing required STEP27 input: {path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "if STEP27_LOCK.exists():\n",
    "\n",
    "    raise RuntimeError(\n",
    "        \"STEP27 pre-DE lock already exists.\\n\"\n",
    "        \"Stopping rather than overwriting a frozen state.\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. HELPERS\n",
    "# ============================================================\n",
    "\n",
    "def sha256_file(\n",
    "    path,\n",
    "    block_size=4 * 1024 * 1024,\n",
    "):\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\",\n",
    "    ) as handle:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            block = handle.read(\n",
    "                block_size\n",
    "            )\n",
    "\n",
    "            if not block:\n",
    "                break\n",
    "\n",
    "            h.update(\n",
    "                block\n",
    "            )\n",
    "\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "def standardized_design(\n",
    "    df,\n",
    "    include_PMD=False,\n",
    "):\n",
    "\n",
    "    d = df.copy()\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Age z-score\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    age = pd.to_numeric(\n",
    "        d[\n",
    "            \"age\"\n",
    "        ],\n",
    "        errors=\"raise\",\n",
    "    ).to_numpy(\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "\n",
    "    age_sd = float(\n",
    "        np.std(\n",
    "            age,\n",
    "            ddof=0,\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert age_sd > 0\n",
    "\n",
    "\n",
    "    age_z = (\n",
    "        age\n",
    "        -\n",
    "        float(\n",
    "            np.mean(\n",
    "                age\n",
    "            )\n",
    "        )\n",
    "    ) / age_sd\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Sex\n",
    "    #\n",
    "    # Frozen donor metadata uses Male/Female.\n",
    "    # Also accept M/F defensively.\n",
    "    # Female = reference = 0.\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    sex_clean = (\n",
    "        d[\n",
    "            \"sex\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .str.strip()\n",
    "        .str.upper()\n",
    "    )\n",
    "\n",
    "\n",
    "    allowed_sex = {\n",
    "        \"M\",\n",
    "        \"MALE\",\n",
    "        \"F\",\n",
    "        \"FEMALE\",\n",
    "    }\n",
    "\n",
    "\n",
    "    assert set(\n",
    "        sex_clean.unique()\n",
    "    ).issubset(\n",
    "        allowed_sex\n",
    "    ), (\n",
    "        \"Unexpected sex values: \"\n",
    "        f\"{sorted(sex_clean.unique())}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    sex_male = (\n",
    "        sex_clean\n",
    "        .isin(\n",
    "            [\n",
    "                \"M\",\n",
    "                \"MALE\",\n",
    "            ]\n",
    "        )\n",
    "        .astype(float)\n",
    "        .to_numpy()\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Diagnosis\n",
    "    # Control = reference = 0\n",
    "    # AD = 1\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    diagnosis_clean = (\n",
    "        d[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .str.strip()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert set(\n",
    "        diagnosis_clean.unique()\n",
    "    ).issubset(\n",
    "        {\n",
    "            \"AD\",\n",
    "            \"Control\",\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    diagnosis_AD = (\n",
    "        diagnosis_clean\n",
    "        .eq(\n",
    "            \"AD\"\n",
    "        )\n",
    "        .astype(float)\n",
    "        .to_numpy()\n",
    "    )\n",
    "\n",
    "\n",
    "    columns = [\n",
    "        np.ones(\n",
    "            len(\n",
    "                d\n",
    "            ),\n",
    "            dtype=float,\n",
    "        ),\n",
    "\n",
    "        age_z,\n",
    "\n",
    "        sex_male,\n",
    "    ]\n",
    "\n",
    "\n",
    "    column_names = [\n",
    "        \"Intercept\",\n",
    "        \"age_z\",\n",
    "        \"sex_Male\",\n",
    "    ]\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Optional PMD technical sensitivity\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    if include_PMD:\n",
    "\n",
    "        PMD = pd.to_numeric(\n",
    "            d[\n",
    "                \"PMD_hours\"\n",
    "            ],\n",
    "            errors=\"raise\",\n",
    "        ).to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "\n",
    "\n",
    "        PMD_sd = float(\n",
    "            np.std(\n",
    "                PMD,\n",
    "                ddof=0,\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "        assert PMD_sd > 0\n",
    "\n",
    "\n",
    "        PMD_z = (\n",
    "            PMD\n",
    "            -\n",
    "            float(\n",
    "                np.mean(\n",
    "                    PMD\n",
    "                )\n",
    "            )\n",
    "        ) / PMD_sd\n",
    "\n",
    "\n",
    "        columns.append(\n",
    "            PMD_z\n",
    "        )\n",
    "\n",
    "\n",
    "        column_names.append(\n",
    "            \"PMD_z\"\n",
    "        )\n",
    "\n",
    "\n",
    "    columns.append(\n",
    "        diagnosis_AD\n",
    "    )\n",
    "\n",
    "\n",
    "    column_names.append(\n",
    "        \"diagnosis_AD\"\n",
    "    )\n",
    "\n",
    "\n",
    "    X = np.column_stack(\n",
    "        columns\n",
    "    )\n",
    "\n",
    "\n",
    "    return (\n",
    "        X,\n",
    "        column_names,\n",
    "    )\n",
    "\n",
    "\n",
    "def design_record(\n",
    "    subset,\n",
    "    cell_type,\n",
    "    threshold,\n",
    "    model_name,\n",
    "    include_PMD,\n",
    "):\n",
    "\n",
    "    X, names = standardized_design(\n",
    "        subset,\n",
    "        include_PMD=\n",
    "            include_PMD,\n",
    "    )\n",
    "\n",
    "\n",
    "    rank = int(\n",
    "        np.linalg.matrix_rank(\n",
    "            X\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    n_columns = int(\n",
    "        X.shape[\n",
    "            1\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    condition = float(\n",
    "        np.linalg.cond(\n",
    "            X\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    return {\n",
    "        \"cell_type\":\n",
    "            cell_type,\n",
    "\n",
    "        \"minimum_nuclei\":\n",
    "            threshold,\n",
    "\n",
    "        \"model\":\n",
    "            model_name,\n",
    "\n",
    "        \"formula\":\n",
    "            (\n",
    "                \"~ age + sex + PMD_hours + diagnosis_binary\"\n",
    "                if include_PMD\n",
    "                else\n",
    "                \"~ age + sex + diagnosis_binary\"\n",
    "            ),\n",
    "\n",
    "        \"n_donors\":\n",
    "            int(\n",
    "                len(\n",
    "                    subset\n",
    "                )\n",
    "            ),\n",
    "\n",
    "        \"n_AD\":\n",
    "            int(\n",
    "                (\n",
    "                    subset[\n",
    "                        \"diagnosis_binary\"\n",
    "                    ]\n",
    "                    ==\n",
    "                    \"AD\"\n",
    "                ).sum()\n",
    "            ),\n",
    "\n",
    "        \"n_Control\":\n",
    "            int(\n",
    "                (\n",
    "                    subset[\n",
    "                        \"diagnosis_binary\"\n",
    "                    ]\n",
    "                    ==\n",
    "                    \"Control\"\n",
    "                ).sum()\n",
    "            ),\n",
    "\n",
    "        \"rank\":\n",
    "            rank,\n",
    "\n",
    "        \"columns\":\n",
    "            n_columns,\n",
    "\n",
    "        \"full_rank\":\n",
    "            bool(\n",
    "                rank\n",
    "                ==\n",
    "                n_columns\n",
    "            ),\n",
    "\n",
    "        \"standardized_condition_number\":\n",
    "            condition,\n",
    "\n",
    "        \"design_columns\":\n",
    "            \"|\".join(\n",
    "                names\n",
    "            ),\n",
    "    }\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. VERIFY UPSTREAM LOCKS\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    STEP26B_LOCK,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as handle:\n",
    "\n",
    "    step26b = json.load(\n",
    "        handle\n",
    "    )\n",
    "\n",
    "\n",
    "with open(\n",
    "    STEP25_LOCK,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as handle:\n",
    "\n",
    "    step25 = json.load(\n",
    "        handle\n",
    "    )\n",
    "\n",
    "\n",
    "assert (\n",
    "    step26b[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"AD_REPLICATION_FINAL_CELLTYPE_MAPPING_FROZEN\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    step26b[\n",
    "        \"mapping_is_disease_blind\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    step26b[\n",
    "        \"diagnosis_used_in_mapping\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    step26b[\n",
    "        \"pseudobulk_built\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    step26b[\n",
    "        \"replication_DE_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    step26b[\n",
    "        \"AD_PD_convergence_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    step25[\n",
    "        \"replication_DE_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "DONOR_METADATA_PATH = Path(\n",
    "    step25[\n",
    "        \"donor_metadata_file\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "FEATURE_METADATA_PATH = Path(\n",
    "    step25[\n",
    "        \"feature_table\"\n",
    "    ][\n",
    "        \"feature_metadata\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "    DONOR_METADATA_PATH,\n",
    "    FEATURE_METADATA_PATH,\n",
    "]:\n",
    "\n",
    "    assert path.exists(), path\n",
    "\n",
    "\n",
    "print(\"=\" * 100)\n",
    "print(\"RETINA-ND STEP 27 — FINAL ELIGIBILITY + PSEUDOBULK + GENE UNIVERSES\")\n",
    "print(\"=\" * 100)\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nUpstream final cell-type mapping: PASS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Primary minimum nuclei:\",\n",
    "    PRIMARY_MIN_NUCLEI,\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Sensitivity minimum nuclei:\",\n",
    "    SENSITIVITY_MIN_NUCLEI,\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Disease expression inspected: NO\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. LOAD FROZEN TABLES\n",
    "# ============================================================\n",
    "\n",
    "donor_meta = pd.read_csv(\n",
    "    DONOR_METADATA_PATH\n",
    ")\n",
    "\n",
    "\n",
    "coverage = pd.read_csv(\n",
    "    FINAL_DONOR_COVERAGE_PATH\n",
    ")\n",
    "\n",
    "\n",
    "cells = pd.read_csv(\n",
    "    FINAL_CELL_LABEL_PATH,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "sample_manifest = pd.read_csv(\n",
    "    SAMPLE_MANIFEST_PATH\n",
    ")\n",
    "\n",
    "\n",
    "feature_meta = pd.read_csv(\n",
    "    FEATURE_METADATA_PATH,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    donor_meta\n",
    ") == 21\n",
    "\n",
    "\n",
    "assert len(\n",
    "    coverage\n",
    ") == 21\n",
    "\n",
    "\n",
    "assert len(\n",
    "    cells\n",
    ") == 169506\n",
    "\n",
    "\n",
    "assert len(\n",
    "    sample_manifest\n",
    ") == 21\n",
    "\n",
    "\n",
    "assert len(\n",
    "    feature_meta\n",
    ") == 33538\n",
    "\n",
    "\n",
    "assert cells[\n",
    "    \"cell_uid\"\n",
    "].is_unique\n",
    "\n",
    "\n",
    "assert (\n",
    "    \"diagnosis_binary\"\n",
    "    not in\n",
    "    cells.columns\n",
    ")\n",
    "\n",
    "\n",
    "assert feature_meta[\n",
    "    \"gene_id\"\n",
    "].astype(\n",
    "    str\n",
    ").is_unique\n",
    "\n",
    "\n",
    "required_donor_columns = [\n",
    "    \"donor_id\",\n",
    "    \"diagnosis_binary\",\n",
    "    \"age\",\n",
    "    \"sex\",\n",
    "    \"PMD_hours\",\n",
    "]\n",
    "\n",
    "\n",
    "for column in required_donor_columns:\n",
    "\n",
    "    assert column in donor_meta.columns, column\n",
    "\n",
    "\n",
    "assert (\n",
    "    donor_meta[\n",
    "        \"diagnosis_binary\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    "    ==\n",
    "    {\n",
    "        \"AD\":\n",
    "            12,\n",
    "\n",
    "        \"Control\":\n",
    "            9,\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFrozen donor metadata: PASS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Sex values:\",\n",
    "    sorted(\n",
    "        donor_meta[\n",
    "            \"sex\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .unique()\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. FREEZE PRIMARY + SENSITIVITY ELIGIBILITY\n",
    "# ============================================================\n",
    "\n",
    "eligibility = coverage.copy()\n",
    "\n",
    "\n",
    "for cell_type in TARGET_CLASSES:\n",
    "\n",
    "    eligibility[\n",
    "        f\"{cell_type}_primary_eligible\"\n",
    "    ] = (\n",
    "        eligibility[\n",
    "            cell_type\n",
    "        ]\n",
    "        >=\n",
    "        PRIMARY_MIN_NUCLEI\n",
    "    )\n",
    "\n",
    "\n",
    "    eligibility[\n",
    "        f\"{cell_type}_sensitivity20_eligible\"\n",
    "    ] = (\n",
    "        eligibility[\n",
    "            cell_type\n",
    "        ]\n",
    "        >=\n",
    "        SENSITIVITY_MIN_NUCLEI\n",
    "    )\n",
    "\n",
    "\n",
    "eligibility.to_csv(\n",
    "    ELIGIBILITY_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "eligibility_summary_rows = []\n",
    "\n",
    "\n",
    "for cell_type in TARGET_CLASSES:\n",
    "\n",
    "    primary_mask = eligibility[\n",
    "        f\"{cell_type}_primary_eligible\"\n",
    "    ]\n",
    "\n",
    "\n",
    "    sensitivity_mask = eligibility[\n",
    "        f\"{cell_type}_sensitivity20_eligible\"\n",
    "    ]\n",
    "\n",
    "\n",
    "    primary_sub = eligibility.loc[\n",
    "        primary_mask\n",
    "    ]\n",
    "\n",
    "\n",
    "    sensitivity_sub = eligibility.loc[\n",
    "        sensitivity_mask\n",
    "    ]\n",
    "\n",
    "\n",
    "    eligibility_summary_rows.append(\n",
    "        {\n",
    "            \"cell_type\":\n",
    "                cell_type,\n",
    "\n",
    "            \"primary_threshold\":\n",
    "                PRIMARY_MIN_NUCLEI,\n",
    "\n",
    "            \"primary_donors\":\n",
    "                int(\n",
    "                    primary_mask.sum()\n",
    "                ),\n",
    "\n",
    "            \"primary_AD\":\n",
    "                int(\n",
    "                    (\n",
    "                        primary_sub[\n",
    "                            \"diagnosis_binary\"\n",
    "                        ]\n",
    "                        ==\n",
    "                        \"AD\"\n",
    "                    ).sum()\n",
    "                ),\n",
    "\n",
    "            \"primary_Control\":\n",
    "                int(\n",
    "                    (\n",
    "                        primary_sub[\n",
    "                            \"diagnosis_binary\"\n",
    "                        ]\n",
    "                        ==\n",
    "                        \"Control\"\n",
    "                    ).sum()\n",
    "                ),\n",
    "\n",
    "            \"sensitivity_threshold\":\n",
    "                SENSITIVITY_MIN_NUCLEI,\n",
    "\n",
    "            \"sensitivity_donors\":\n",
    "                int(\n",
    "                    sensitivity_mask.sum()\n",
    "                ),\n",
    "\n",
    "            \"sensitivity_AD\":\n",
    "                int(\n",
    "                    (\n",
    "                        sensitivity_sub[\n",
    "                            \"diagnosis_binary\"\n",    "                        ]\n",
    "                        ==\n",
    "                        \"AD\"\n",
    "                    ).sum()\n",
    "                ),\n",
    "\n",
    "            \"sensitivity_Control\":\n",
    "                int(\n",
    "                    (\n",
    "                        sensitivity_sub[\n",
    "                            \"diagnosis_binary\"\n",
    "                        ]\n",
    "                        ==\n",
    "                        \"Control\"\n",
    "                    ).sum()\n",
    "                ),\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "eligibility_summary = pd.DataFrame(\n",
    "    eligibility_summary_rows\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 100\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"FROZEN DONOR ELIGIBILITY\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 100\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    eligibility_summary.to_string(\n",
    "        index=False\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "EXPECTED_PRIMARY = {\n",
    "    \"Astro\":\n",
    "        (\n",
    "            21,\n",
    "            12,\n",
    "            9,\n",
    "        ),\n",
    "\n",
    "    \"Micro\":\n",
    "        (\n",
    "            20,\n",
    "            11,\n",
    "            9,\n",
    "        ),\n",
    "\n",
    "    \"OPC\":\n",
    "        (\n",
    "            17,\n",
    "            9,\n",
    "            8,\n",
    "        ),\n",
    "\n",
    "    \"Oligo\":\n",
    "        (\n",
    "            21,\n",
    "            12,\n",
    "            9,\n",
    "        ),\n",
    "}\n",
    "\n",
    "\n",
    "EXPECTED_SENS20 = {\n",
    "    \"Astro\":\n",
    "        (\n",
    "            21,\n",
    "            12,\n",
    "            9,\n",
    "        ),\n",
    "\n",
    "    \"Micro\":\n",
    "        (\n",
    "            20,\n",
    "            11,\n",
    "            9,\n",
    "        ),\n",
    "\n",
    "    \"OPC\":\n",
    "        (\n",
    "            12,\n",
    "            7,\n",
    "            5,\n",
    "        ),\n",
    "\n",
    "    \"Oligo\":\n",
    "        (\n",
    "            21,\n",
    "            12,\n",
    "            9,\n",
    "        ),\n",
    "}\n",
    "\n",
    "\n",
    "for cell_type in TARGET_CLASSES:\n",
    "\n",
    "    row = eligibility_summary.loc[\n",
    "        eligibility_summary[\n",
    "            \"cell_type\"\n",
    "        ]\n",
    "        ==\n",
    "        cell_type\n",
    "    ].iloc[\n",
    "        0\n",
    "    ]\n",
    "\n",
    "\n",
    "    assert (\n",
    "        int(\n",
    "            row[\n",
    "                \"primary_donors\"\n",
    "            ]\n",
    "        ),\n",
    "        int(\n",
    "            row[\n",
    "                \"primary_AD\"\n",
    "            ]\n",
    "        ),\n",
    "        int(\n",
    "            row[\n",
    "                \"primary_Control\"\n",
    "            ]\n",
    "        ),\n",
    "    ) == EXPECTED_PRIMARY[\n",
    "        cell_type\n",
    "    ]\n",
    "\n",
    "\n",
    "    assert (\n",
    "        int(\n",
    "            row[\n",
    "                \"sensitivity_donors\"\n",
    "            ]\n",
    "        ),\n",
    "        int(\n",
    "            row[\n",
    "                \"sensitivity_AD\"\n",
    "            ]\n",
    "        ),\n",
    "        int(\n",
    "            row[\n",
    "                \"sensitivity_Control\"\n",
    "            ]\n",
    "        ),\n",
    "    ) == EXPECTED_SENS20[\n",
    "        cell_type\n",
    "    ]\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPrimary eligibility: PASS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Sensitivity-20 eligibility: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. DESIGN FEASIBILITY\n",
    "# ============================================================\n",
    "\n",
    "coverage_design = coverage.merge(\n",
    "    donor_meta[\n",
    "        required_donor_columns\n",
    "    ],\n",
    "\n",
    "    on=[\n",
    "        \"donor_id\",\n",
    "        \"diagnosis_binary\",\n",
    "    ],\n",
    "\n",
    "    how=\"left\",\n",
    "\n",
    "    validate=\"one_to_one\",\n",
    ")\n",
    "\n",
    "\n",
    "assert coverage_design[\n",
    "    [\n",
    "        \"age\",\n",
    "        \"sex\",\n",
    "        \"PMD_hours\",\n",
    "    ]\n",
    "].notna().all().all()\n",
    "\n",
    "\n",
    "design_rows = []\n",
    "\n",
    "\n",
    "for threshold in [\n",
    "    PRIMARY_MIN_NUCLEI,\n",
    "    SENSITIVITY_MIN_NUCLEI,\n",
    "]:\n",
    "\n",
    "    for cell_type in TARGET_CLASSES:\n",
    "\n",
    "        subset = coverage_design.loc[\n",
    "            coverage_design[\n",
    "                cell_type\n",
    "            ]\n",
    "            >=\n",
    "            threshold\n",
    "        ].copy()\n",
    "\n",
    "\n",
    "        design_rows.append(\n",
    "            design_record(\n",
    "                subset=\n",
    "                    subset,\n",
    "\n",
    "                cell_type=\n",
    "                    cell_type,\n",
    "\n",
    "                threshold=\n",
    "                    threshold,\n",
    "\n",
    "                model_name=\n",
    "                    \"primary\",\n",
    "\n",
    "                include_PMD=\n",
    "                    False,\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "        design_rows.append(\n",
    "            design_record(\n",
    "                subset=\n",
    "                    subset,\n",
    "\n",
    "                cell_type=\n",
    "                    cell_type,\n",
    "\n",
    "                threshold=\n",
    "                    threshold,\n",
    "\n",
    "                model_name=\n",
    "                    \"PMD_technical_sensitivity\",\n",
    "\n",
    "                include_PMD=\n",
    "                    True,\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "design_audit = pd.DataFrame(\n",
    "    design_rows\n",
    ")\n",
    "\n",
    "\n",
    "assert design_audit[\n",
    "    \"full_rank\"\n",
    "].all()\n",
    "\n",
    "\n",
    "assert np.isfinite(\n",
    "    design_audit[\n",
    "        \"standardized_condition_number\"\n",
    "    ]\n",
    ").all()\n",
    "\n",
    "\n",
    "assert (\n",
    "    design_audit[\n",
    "        \"standardized_condition_number\"\n",
    "    ]\n",
    "    <\n",
    "    DESIGN_CONDITION_LIMIT\n",
    ").all()\n",
    "\n",
    "\n",
    "design_audit.to_csv(\n",
    "    DESIGN_AUDIT_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 100\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"DESIGN FEASIBILITY\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 100\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    design_audit.to_string(\n",
    "        index=False\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nAll primary + PMD designs: FULL RANK\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"All condition numbers <\",\n",
    "    DESIGN_CONDITION_LIMIT,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. DETERMINISTIC PRIMARY-DESIGN CHECK\n",
    "#\n",
    "# These exact values have now been independently checked from\n",
    "# the frozen donor covariates and Step26B coverage table.\n",
    "# ============================================================\n",
    "\n",
    "primary_design = design_audit.loc[\n",
    "    design_audit[\n",
    "        \"minimum_nuclei\"\n",
    "    ]\n",
    "    ==\n",
    "    PRIMARY_MIN_NUCLEI\n",
    "].copy()\n",
    "\n",
    "\n",
    "EXPECTED_PRIMARY_DESIGN = {\n",
    "    \"Astro\": {\n",
    "        \"primary\":\n",
    "            4.120778218423147,\n",
    "\n",
    "        \"PMD_technical_sensitivity\":\n",
    "            4.341365426297084,\n",
    "    },\n",
    "\n",
    "    \"Micro\": {\n",
    "        \"primary\":\n",
    "            3.9368018463488883,\n",
    "\n",
    "        \"PMD_technical_sensitivity\":\n",
    "            4.160113594834584,\n",
    "    },\n",
    "\n",
    "    \"OPC\": {\n",
    "        \"primary\":\n",
    "            4.208529991295468,\n",
    "\n",
    "        \"PMD_technical_sensitivity\":\n",
    "            4.254972783459334,\n",
    "    },\n",
    "\n",
    "    \"Oligo\": {\n",
    "        \"primary\":\n",
    "            4.120778218423147,\n",
    "\n",
    "        \"PMD_technical_sensitivity\":\n",
    "            4.341365426297084,\n",
    "    },\n",
    "}\n",
    "\n",
    "\n",
    "for cell_type in TARGET_CLASSES:\n",
    "\n",
    "    for model_name in [\n",
    "        \"primary\",\n",
    "        \"PMD_technical_sensitivity\",\n",
    "    ]:\n",
    "\n",
    "        row = primary_design.loc[\n",
    "            (\n",
    "                primary_design[\n",
    "                    \"cell_type\"\n",
    "                ]\n",
    "                ==\n",
    "                cell_type\n",
    "            )\n",
    "            &\n",
    "            (\n",
    "                primary_design[\n",
    "                    \"model\"\n",
    "                ]\n",
    "                ==\n",
    "                model_name\n",
    "            )\n",
    "        ]\n",
    "\n",
    "\n",
    "        assert len(\n",
    "            row\n",
    "        ) == 1\n",
    "\n",
    "\n",
    "        row = row.iloc[\n",
    "            0\n",
    "        ]\n",
    "\n",
    "\n",
    "        observed = float(\n",
    "            row[\n",
    "                \"standardized_condition_number\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "\n",
    "        expected = float(\n",
    "            EXPECTED_PRIMARY_DESIGN[\n",
    "                cell_type\n",
    "            ][\n",
    "                model_name\n",
    "            ]\n",
    "        )\n",
    "\n",
    "\n",
    "        assert np.isclose(\n",
    "            observed,\n",
    "            expected,\n",
    "            rtol=1e-10,\n",
    "            atol=1e-12,\n",
    "        ), (\n",
    "            cell_type,\n",
    "            model_name,\n",
    "            observed,\n",
    "            expected,\n",
    "        )\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPrimary design deterministic-value check: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. AGE-OVERLAP AUDIT\n",
    "#\n",
    "# Audit only.\n",
    "# Existing project decision remains:\n",
    "# no age-overlap sensitivity.\n",
    "# ============================================================\n",
    "\n",
    "age_overlap_rows = []\n",
    "\n",
    "\n",
    "for cell_type in TARGET_CLASSES:\n",
    "\n",
    "    subset = coverage_design.loc[\n",
    "        coverage_design[\n",
    "            cell_type\n",
    "        ]\n",
    "        >=\n",
    "        PRIMARY_MIN_NUCLEI\n",
    "    ].copy()\n",
    "\n",
    "\n",
    "    AD_age = subset.loc[\n",
    "        subset[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        ==\n",
    "        \"AD\",\n",
    "\n",
    "        \"age\",\n",
    "    ]\n",
    "\n",
    "\n",
    "    C_age = subset.loc[\n",
    "        subset[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        ==\n",
    "        \"Control\",\n",
    "\n",
    "        \"age\",\n",
    "    ]\n",
    "\n",
    "\n",
    "    common_min = float(\n",
    "        max(\n",
    "            AD_age.min(),\n",
    "            C_age.min(),\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    common_max = float(\n",
    "        min(\n",
    "            AD_age.max(),\n",
    "            C_age.max(),\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    overlap = subset.loc[\n",
    "        subset[\n",
    "            \"age\"\n",
    "        ].between(\n",
    "            common_min,\n",
    "            common_max,\n",
    "            inclusive=\"both\",\n",
    "        )\n",
    "    ]\n",
    "\n",
    "\n",
    "    n_AD_overlap = int(\n",
    "        (\n",
    "            overlap[\n",
    "                \"diagnosis_binary\"\n",
    "            ]\n",
    "            ==\n",
    "            \"AD\"\n",
    "        ).sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_Control_overlap = int(\n",
    "        (\n",
    "            overlap[\n",
    "                \"diagnosis_binary\"\n",
    "            ]\n",
    "            ==\n",
    "            \"Control\"\n",
    "        ).sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    age_overlap_rows.append(\n",
    "        {\n",
    "            \"cell_type\":\n",
    "                cell_type,\n",
    "\n",
    "            \"common_min_age\":\n",
    "                common_min,\n",
    "\n",
    "            \"common_max_age\":\n",
    "                common_max,\n",
    "\n",
    "            \"overlap_AD\":\n",
    "                n_AD_overlap,\n",
    "\n",
    "            \"overlap_Control\":\n",
    "                n_Control_overlap,\n",
    "\n",
    "            \"age_overlap_sensitivity_frozen\":\n",
    "                False,\n",
    "\n",
    "            \"reason\":\n",
    "                (\n",
    "                    \"Existing GSE157827 prespecified decision: \"\n",
    "                    \"common-age support too thin for an additional \"\n",
    "                    \"stable sensitivity analysis.\"\n",
    "                ),\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "age_overlap_audit = pd.DataFrame(\n",
    "    age_overlap_rows\n",
    ")\n",
    "\n",
    "\n",
    "age_overlap_audit.to_csv(\n",
    "    AGE_OVERLAP_AUDIT_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 100\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"AGE-OVERLAP AUDIT\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 100\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    age_overlap_audit.to_string(\n",
    "        index=False\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. VERIFY FINAL TARGET MANIFEST\n",
    "# ============================================================\n",
    "\n",
    "target_cells = cells.loc[\n",
    "    cells[\n",
    "        \"final_target_celltype\"\n",
    "    ]\n",
    "    .isin(\n",
    "        TARGET_CLASSES\n",
    "    )\n",
    "].copy()\n",
    "\n",
    "\n",
    "assert len(\n",
    "    target_cells\n",
    ") == 69005\n",
    "\n",
    "\n",
    "observed_coverage = (\n",
    "    pd.crosstab(\n",
    "        target_cells[\n",
    "            \"donor_id\"\n",
    "        ],\n",
    "\n",
    "        target_cells[\n",
    "            \"final_target_celltype\"\n",
    "        ],\n",
    "    )\n",
    "    .reindex(\n",
    "        index=\n",
    "            coverage[\n",
    "                \"donor_id\"\n",
    "            ],\n",
    "\n",
    "        columns=\n",
    "            TARGET_CLASSES,\n",
    "\n",
    "        fill_value=0,\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "for cell_type in TARGET_CLASSES:\n",
    "\n",
    "    expected = (\n",
    "        coverage\n",
    "        .set_index(\n",
    "            \"donor_id\"\n",
    "        )\n",
    "        .loc[\n",
    "            observed_coverage.index,\n",
    "            cell_type,\n",
    "        ]\n",
    "        .astype(int)\n",
    "        .to_numpy()\n",
    "    )\n",
    "\n",
    "\n",
    "    observed = (\n",
    "        observed_coverage[\n",
    "            cell_type\n",
    "        ]\n",
    "        .astype(int)\n",
    "        .to_numpy()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert np.array_equal(\n",
    "        observed,\n",
    "        expected,\n",
    "    )\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nTarget-cell manifest vs frozen coverage: PASS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Final target nuclei:\",\n",
    "    f\"{len(target_cells):,}\",\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 12. FEATURE TABLE\n",
    "# ============================================================\n",
    "\n",
    "feature_meta = feature_meta.copy()\n",
    "\n",
    "\n",
    "feature_meta[\n",
    "    \"gene_id\"\n",
    "] = (\n",
    "    feature_meta[\n",
    "        \"gene_id\"\n",
    "    ]\n",
    "    .astype(str)\n",
    ")\n",
    "\n",
    "\n",
    "feature_meta[\n",
    "    \"gene_symbol\"\n",
    "] = (\n",
    "    feature_meta[\n",
    "        \"gene_symbol\"\n",
    "    ]\n",
    "    .astype(str)\n",
    ")\n",
    "\n",
    "\n",
    "assert feature_meta[\n",
    "    \"gene_id\"\n",
    "].is_unique\n",
    "\n",
    "\n",
    "N_FEATURES = int(\n",
    "    len(\n",
    "        feature_meta\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert N_FEATURES == 33538\n",
    "\n",
    "\n",
    "feature_meta[\n",
    "    \"MT_prefix\"\n",
    "] = (\n",
    "    feature_meta[\n",
    "        \"gene_symbol\"\n",
    "    ]\n",
    "    .str.upper()\n",
    "    .str.startswith(\n",
    "        \"MT-\"\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "N_MT = int(\n",
    "    feature_meta[\n",
    "        \"MT_prefix\"\n",
    "    ].sum()\n",
    ")\n",
    "\n",
    "\n",
    "assert N_MT == 13\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFeatures:\",\n",
    "    N_FEATURES,\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"MT-prefix features:\",\n",
    "    N_MT,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 13. BUILD ALL 21 x 4 RAW DONOR PSEUDOBULKS\n",
    "#\n",
    "# All groups retained for provenance, including groups with\n",
    "# fewer than 10 cells or zero cells.\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 100\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"BUILDING RAW DONOR PSEUDOBULK\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 100\n",
    ")\n",
    "\n",
    "\n",
    "pb_vectors = []\n",
    "\n",
    "group_rows = []\n",
    "\n",
    "expected_selected_UMI = 0\n",
    "\n",
    "expected_selected_cells = 0\n",
    "\n",
    "\n",
    "sample_manifest[\n",
    "    \"sample_id\"\n",
    "] = (\n",
    "    sample_manifest[\n",
    "        \"sample_id\"\n",
    "    ]\n",
    "    .astype(str)\n",
    ")\n",
    "\n",
    "\n",
    "cells[\n",
    "    \"donor_id\"\n",
    "] = (\n",
    "    cells[\n",
    "        \"donor_id\"\n",
    "    ]\n",
    "    .astype(str)\n",
    ")\n",
    "\n",
    "\n",
    "for sample_index, sample_row in sample_manifest.iterrows():\n",
    "\n",
    "    donor_id = str(\n",
    "        sample_row[\n",
    "            \"sample_id\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    matrix_path = Path(\n",
    "        sample_row[\n",
    "            \"matrix_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    barcode_path = Path(\n",
    "        sample_row[\n",
    "            \"barcode_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert matrix_path.exists(), matrix_path\n",
    "    assert barcode_path.exists(), barcode_path\n",
    "\n",
    "\n",
    "    donor_cells = cells.loc[\n",
    "        cells[\n",
    "            \"donor_id\"\n",
    "        ]\n",
    "        ==\n",
    "        donor_id\n",
    "    ].copy()\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        donor_cells\n",
    "    ) > 0\n",
    "\n",
    "\n",
    "    raw_barcodes = (\n",
    "        pd.read_csv(\n",
    "            barcode_path,\n",
    "            sep=\"\\t\",\n",
    "            header=None,\n",
    "            compression=\"gzip\",\n",
    "            dtype=str,\n",
    "        )[\n",
    "            0\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    barcode_lookup = {\n",
    "        barcode:\n",
    "            index\n",
    "\n",
    "        for index, barcode\n",
    "        in enumerate(\n",
    "            raw_barcodes\n",
    "        )\n",
    "    }\n",
    "\n",
    "\n",
    "    assert donor_cells[\n",
    "        \"barcode\"\n",
    "    ].astype(\n",
    "        str\n",
    "    ).isin(\n",
    "        barcode_lookup\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    with gzip.open(\n",
    "        matrix_path,\n",
    "        \"rb\",\n",
    "    ) as handle:\n",
    "\n",
    "        matrix = mmread(\n",
    "            handle\n",
    "        ).tocsc()\n",
    "\n",
    "\n",
    "    assert matrix.shape == (\n",
    "        N_FEATURES,\n",
    "        len(\n",
    "            raw_barcodes\n",
    "        ),\n",
    "    )\n",
    "\n",
    "\n",
    "    donor_meta_row = donor_meta.loc[\n",
    "        donor_meta[\n",
    "            \"donor_id\"\n",
    "        ].astype(\n",
    "            str\n",
    "        )\n",
    "        ==\n",
    "        donor_id\n",
    "    ]\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        donor_meta_row\n",
    "    ) == 1\n",
    "\n",
    "\n",
    "    donor_meta_row = donor_meta_row.iloc[\n",
    "        0\n",
    "    ]\n",
    "\n",
    "\n",
    "    print(\n",
    "        f\"\\n[{sample_index + 1:02d}/21]\",\n",
    "        donor_id,\n",
    "    )\n",
    "\n",
    "\n",
    "    for cell_type in TARGET_CLASSES:\n",
    "\n",
    "        ct_cells = donor_cells.loc[\n",
    "            donor_cells[\n",
    "                \"final_target_celltype\"\n",
    "            ]\n",
    "            ==\n",
    "            cell_type\n",
    "        ].copy()\n",
    "\n",
    "\n",
    "        n_cells = int(\n",
    "            len(\n",
    "                ct_cells\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "        group_id = (\n",
    "            f\"{donor_id}__{cell_type}\"\n",
    "        )\n",
    "\n",
    "\n",
    "        if n_cells > 0:\n",
    "\n",
    "            indices = np.asarray(\n",
    "                [\n",
    "                    barcode_lookup[\n",
    "                        str(\n",
    "                            barcode\n",
    "                        )\n",
    "                    ]\n",
    "\n",
    "                    for barcode\n",
    "                    in ct_cells[\n",
    "                        \"barcode\"\n",
    "                    ]\n",
    "                ],\n",
    "                dtype=np.int64,\n",
    "            )\n",
    "\n",
    "\n",
    "            vector = np.asarray(\n",
    "                matrix[\n",
    "                    :,\n",
    "                    indices\n",
    "                ]\n",
    "                .sum(\n",
    "                    axis=1\n",
    "                )\n",
    "            ).ravel()\n",
    "\n",
    "\n",
    "            vector = np.rint(\n",
    "                vector\n",
    "            ).astype(\n",
    "                np.int64\n",
    "            )\n",
    "\n",
    "\n",
    "            expected_cell_UMI = int(\n",
    "                pd.to_numeric(\n",
    "                    ct_cells[\n",
    "                        \"n_UMI\"\n",
    "                    ],\n",
    "                    errors=\"raise\",\n",    "                )\n",
    "                .astype(\n",
    "                    np.int64\n",
    "                )\n",
    "                .sum()\n",
    "            )\n",
    "\n",
    "\n",
    "            observed_group_UMI = int(\n",
    "                vector.sum()\n",
    "            )\n",
    "\n",
    "\n",
    "            assert observed_group_UMI == expected_cell_UMI, (\n",
    "                f\"UMI mismatch for {group_id}: \"\n",
    "                f\"pseudobulk={observed_group_UMI}, \"\n",
    "                f\"cells={expected_cell_UMI}\"\n",
    "            )\n",
    "\n",
    "\n",
    "        else:\n",
    "\n",
    "            vector = np.zeros(\n",
    "                N_FEATURES,\n",
    "                dtype=np.int64,\n",
    "            )\n",
    "\n",
    "\n",
    "            expected_cell_UMI = 0\n",
    "\n",
    "            observed_group_UMI = 0\n",
    "\n",
    "\n",
    "        pb_vectors.append(\n",
    "            vector\n",
    "        )\n",
    "\n",
    "\n",
    "        primary_eligible = bool(\n",
    "            n_cells\n",
    "            >=\n",
    "            PRIMARY_MIN_NUCLEI\n",
    "        )\n",
    "\n",
    "\n",
    "        sensitivity20_eligible = bool(\n",
    "            n_cells\n",
    "            >=\n",
    "            SENSITIVITY_MIN_NUCLEI\n",
    "        )\n",
    "\n",
    "\n",
    "        group_rows.append(\n",
    "            {\n",
    "                \"group_id\":\n",
    "                    group_id,\n",
    "\n",
    "                \"donor_id\":\n",
    "                    donor_id,\n",
    "\n",
    "                \"cell_type\":\n",
    "                    cell_type,\n",
    "\n",
    "                \"diagnosis_binary\":\n",
    "                    str(\n",
    "                        donor_meta_row[\n",
    "                            \"diagnosis_binary\"\n",
    "                        ]\n",
    "                    ),\n",
    "\n",
    "                \"age\":\n",
    "                    float(\n",
    "                        donor_meta_row[\n",
    "                            \"age\"\n",
    "                        ]\n",
    "                    ),\n",
    "\n",
    "                \"sex\":\n",
    "                    str(\n",
    "                        donor_meta_row[\n",
    "                            \"sex\"\n",
    "                        ]\n",
    "                    ),\n",
    "\n",
    "                \"PMD_hours\":\n",
    "                    float(\n",
    "                        donor_meta_row[\n",
    "                            \"PMD_hours\"\n",
    "                        ]\n",
    "                    ),\n",
    "\n",
    "                \"n_nuclei\":\n",
    "                    n_cells,\n",
    "\n",
    "                \"library_size_UMI\":\n",
    "                    observed_group_UMI,\n",
    "\n",
    "                \"primary_min_nuclei\":\n",
    "                    PRIMARY_MIN_NUCLEI,\n",
    "\n",
    "                \"primary_eligible\":\n",
    "                    primary_eligible,\n",
    "\n",
    "                \"sensitivity20_min_nuclei\":\n",
    "                    SENSITIVITY_MIN_NUCLEI,\n",
    "\n",
    "                \"sensitivity20_eligible\":\n",
    "                    sensitivity20_eligible,\n",
    "            }\n",
    "        )\n",
    "\n",
    "\n",
    "        expected_selected_UMI += (\n",
    "            expected_cell_UMI\n",
    "        )\n",
    "\n",
    "\n",
    "        expected_selected_cells += (\n",
    "            n_cells\n",
    "        )\n",
    "\n",
    "\n",
    "        print(\n",
    "            \" \",\n",
    "            f\"{cell_type:6s}\",\n",
    "            \"cells=\",\n",
    "            n_cells,\n",
    "            \"UMI=\",\n",
    "            observed_group_UMI,\n",
    "            \"primary=\",\n",
    "            primary_eligible,\n",
    "        )\n",
    "\n",
    "\n",
    "    del matrix\n",
    "    del donor_cells\n",
    "    del raw_barcodes\n",
    "    del barcode_lookup\n",
    "\n",
    "    gc.collect()\n",
    "\n",
    "\n",
    "assert len(\n",
    "    pb_vectors\n",
    ") == 84\n",
    "\n",
    "\n",
    "assert len(\n",
    "    group_rows\n",
    ") == 84\n",
    "\n",
    "\n",
    "assert expected_selected_cells == 69005\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 14. COMBINE RAW PSEUDOBULK MATRIX\n",
    "# ============================================================\n",
    "\n",
    "pb_matrix = np.column_stack(\n",
    "    pb_vectors\n",
    ")\n",
    "\n",
    "\n",
    "del pb_vectors\n",
    "\n",
    "gc.collect()\n",
    "\n",
    "\n",
    "assert pb_matrix.shape == (\n",
    "    N_FEATURES,\n",
    "    84,\n",
    ")\n",
    "\n",
    "\n",
    "assert np.issubdtype(\n",
    "    pb_matrix.dtype,\n",
    "    np.integer,\n",
    ")\n",
    "\n",
    "\n",
    "group_meta = pd.DataFrame(\n",
    "    group_rows\n",
    ")\n",
    "\n",
    "\n",
    "assert group_meta[\n",
    "    \"group_id\"\n",
    "].is_unique\n",
    "\n",
    "\n",
    "expected_group_order = [\n",
    "    f\"{donor}__{cell_type}\"\n",
    "\n",
    "    for donor\n",
    "    in sample_manifest[\n",
    "        \"sample_id\"\n",
    "    ].astype(str)\n",
    "\n",
    "    for cell_type\n",
    "    in TARGET_CLASSES\n",
    "]\n",
    "\n",
    "\n",
    "assert (\n",
    "    group_meta[\n",
    "        \"group_id\"\n",
    "    ].tolist()\n",
    "    ==\n",
    "    expected_group_order\n",
    ")\n",
    "\n",
    "\n",
    "observed_total_UMI = int(\n",
    "    pb_matrix.sum()\n",
    ")\n",
    "\n",
    "\n",
    "assert observed_total_UMI == int(\n",
    "    expected_selected_UMI\n",
    ")\n",
    "\n",
    "\n",
    "assert int(\n",
    "    group_meta[\n",
    "        \"library_size_UMI\"\n",
    "    ].sum()\n",
    ") == observed_total_UMI\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 100\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PSEUDOBULK INTEGRITY\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 100\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Groups:\",\n",
    "    pb_matrix.shape[\n",
    "        1\n",
    "    ],\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Features:\",\n",
    "    pb_matrix.shape[\n",
    "        0\n",
    "    ],\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Target nuclei:\",\n",
    "    f\"{expected_selected_cells:,}\",\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Input target-cell UMIs:\",\n",
    "    f\"{expected_selected_UMI:,}\",\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Output pseudobulk UMIs:\",\n",
    "    f\"{observed_total_UMI:,}\",\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Exact UMI conservation: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 15. SAVE ALL-GROUP RAW PSEUDOBULK\n",
    "# ============================================================\n",
    "\n",
    "pb_export = feature_meta[\n",
    "    [\n",
    "        \"gene_id\",\n",
    "        \"gene_symbol\",\n",
    "    ]\n",
    "].copy()\n",
    "\n",
    "\n",
    "for column_index, group_id in enumerate(\n",
    "    group_meta[\n",
    "        \"group_id\"\n",
    "    ]\n",
    "):\n",
    "\n",
    "    pb_export[\n",
    "        group_id\n",
    "    ] = pb_matrix[\n",
    "        :,\n",
    "        column_index\n",
    "    ]\n",
    "\n",
    "\n",
    "pb_export.to_csv(\n",
    "    PSEUDOBULK_ALL_PATH,\n",
    "\n",
    "    index=False,\n",
    "\n",
    "    compression={\n",
    "        \"method\":\n",
    "            \"gzip\",\n",
    "\n",
    "        \"compresslevel\":\n",
    "            6,\n",
    "    },\n",
    ")\n",
    "\n",
    "\n",
    "group_meta.to_csv(\n",
    "    GROUP_METADATA_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nAll-group raw pseudobulk:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    PSEUDOBULK_ALL_PATH\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 16. FREEZE CELL-TYPE-SPECIFIC GENE UNIVERSES\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 100\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"FREEZING REPLICATION GENE UNIVERSES\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 100\n",
    ")\n",
    "\n",
    "\n",
    "gene_universe_rows = []\n",
    "\n",
    "class_output_records = {}\n",
    "\n",
    "\n",
    "MT_prefix = (\n",
    "    feature_meta[\n",
    "        \"MT_prefix\"\n",
    "    ]\n",
    "    .to_numpy(\n",
    "        dtype=bool\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "for cell_type in TARGET_CLASSES:\n",
    "\n",
    "    class_groups = group_meta.loc[\n",
    "        (\n",
    "            group_meta[\n",
    "                \"cell_type\"\n",
    "            ]\n",
    "            ==\n",
    "            cell_type\n",
    "        )\n",
    "        &\n",
    "        (\n",
    "            group_meta[\n",
    "                \"primary_eligible\"\n",
    "            ]\n",
    "        )\n",
    "    ].copy()\n",
    "\n",
    "\n",
    "    n_AD = int(\n",
    "        (\n",
    "            class_groups[\n",
    "                \"diagnosis_binary\"\n",
    "            ]\n",
    "            ==\n",
    "            \"AD\"\n",
    "        ).sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_Control = int(\n",
    "        (\n",
    "            class_groups[\n",
    "                \"diagnosis_binary\"\n",
    "            ]\n",
    "            ==\n",
    "            \"Control\"\n",
    "        ).sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    required_donors = int(\n",
    "        min(\n",
    "            n_AD,\n",
    "            n_Control,\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert required_donors >= 8\n",
    "\n",
    "\n",
    "    group_indices = [\n",
    "        int(\n",
    "            group_meta.index[\n",
    "                group_meta[\n",
    "                    \"group_id\"\n",
    "                ]\n",
    "                ==\n",
    "                group_id\n",
    "            ][\n",
    "                0\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        for group_id\n",
    "        in class_groups[\n",
    "            \"group_id\"\n",
    "        ]\n",
    "    ]\n",
    "\n",
    "\n",
    "    class_counts = pb_matrix[\n",
    "        :,\n",
    "        group_indices\n",
    "    ]\n",
    "\n",
    "\n",
    "    library_sizes = (\n",
    "        class_counts\n",
    "        .sum(\n",
    "            axis=0\n",
    "        )\n",
    "        .astype(\n",
    "            np.float64\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert np.all(\n",
    "        library_sizes\n",
    "        >\n",
    "        0\n",
    "    )\n",
    "\n",
    "\n",
    "    CPM = (\n",
    "        class_counts.astype(\n",
    "            np.float64\n",
    "        )\n",
    "        /\n",
    "        library_sizes[\n",
    "            None,\n",
    "            :\n",
    "        ]\n",
    "        *\n",
    "        1_000_000.0\n",
    "    )\n",
    "\n",
    "\n",
    "    n_donors_CPM_ge1 = (\n",
    "        CPM\n",
    "        >=\n",
    "        CPM_THRESHOLD\n",
    "    ).sum(\n",
    "        axis=1\n",
    "    )\n",
    "\n",
    "\n",
    "    expression_pass = (\n",
    "        n_donors_CPM_ge1\n",
    "        >=\n",
    "        required_donors\n",
    "    )\n",
    "\n",
    "\n",
    "    retained = (\n",
    "        expression_pass\n",
    "        &\n",
    "        (\n",
    "            ~MT_prefix\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    n_expression_pass = int(\n",
    "        expression_pass.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_retained = int(\n",
    "        retained.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert n_retained > 5000\n",
    "\n",
    "\n",
    "    universe_table = pd.DataFrame(\n",
    "        {\n",
    "            \"gene_id\":\n",
    "                feature_meta[\n",
    "                    \"gene_id\"\n",
    "                ]\n",
    "                .astype(str)\n",
    "                .to_numpy(),\n",
    "\n",
    "            \"gene_symbol\":\n",
    "                feature_meta[\n",
    "                    \"gene_symbol\"\n",
    "                ]\n",
    "                .astype(str)\n",
    "                .to_numpy(),\n",
    "\n",
    "            \"n_primary_eligible_donors\":\n",
    "                int(\n",
    "                    len(\n",
    "                        class_groups\n",
    "                    )\n",
    "                ),\n",
    "\n",
    "            \"n_AD\":\n",
    "                n_AD,\n",
    "\n",
    "            \"n_Control\":\n",
    "                n_Control,\n",
    "\n",
    "            \"required_donors_CPM_ge1\":\n",
    "                required_donors,\n",
    "\n",
    "            \"n_donors_CPM_ge1\":\n",
    "                n_donors_CPM_ge1.astype(\n",
    "                    int\n",
    "                ),\n",
    "\n",
    "            \"expression_pass_CPM1\":\n",
    "                expression_pass,\n",
    "\n",
    "            \"MT_prefix\":\n",
    "                MT_prefix,\n",
    "\n",
    "            \"retained_for_replication_DE\":\n",
    "                retained,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    universe_path = (\n",
    "        GENE_UNIVERSE_DIR\n",
    "        /\n",
    "        f\"GSE157827_{cell_type}_REPLICATION_GENE_UNIVERSE_v1.csv.gz\"\n",
    "    )\n",
    "\n",
    "\n",
    "    universe_table.to_csv(\n",
    "        universe_path,\n",
    "\n",
    "        index=False,\n",
    "\n",
    "        compression={\n",
    "            \"method\":\n",
    "                \"gzip\",\n",
    "\n",
    "            \"compresslevel\":\n",
    "                6,\n",
    "        },\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # PRIMARY eligible filtered raw pseudobulk\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    class_pb = feature_meta.loc[\n",
    "        retained,\n",
    "        [\n",
    "            \"gene_id\",\n",
    "            \"gene_symbol\",\n",
    "        ]\n",
    "    ].copy()\n",
    "\n",
    "\n",
    "    retained_counts = class_counts[\n",
    "        retained,\n",
    "        :\n",
    "    ]\n",
    "\n",
    "\n",
    "    assert retained_counts.shape[\n",
    "        0\n",
    "    ] == n_retained\n",
    "\n",
    "\n",
    "    for local_col, group_id in enumerate(\n",
    "        class_groups[\n",
    "            \"group_id\"\n",
    "        ]\n",
    "    ):\n",
    "\n",
    "        class_pb[\n",
    "            group_id\n",
    "        ] = retained_counts[\n",
    "            :,\n",
    "            local_col\n",
    "        ].astype(\n",
    "            np.int64\n",
    "        )\n",
    "\n",
    "\n",
    "    class_pb_path = (\n",
    "        PB_DIR\n",
    "        /\n",
    "        f\"GSE157827_{cell_type}_PRIMARY_PSEUDOBULK_FILTERED_RAW_v1.csv.gz\"\n",
    "    )\n",
    "\n",
    "\n",
    "    class_pb.to_csv(\n",
    "        class_pb_path,\n",
    "\n",
    "        index=False,\n",
    "\n",
    "        compression={\n",
    "            \"method\":\n",
    "                \"gzip\",\n",
    "\n",
    "            \"compresslevel\":\n",
    "                6,\n",
    "        },\n",
    "    )\n",
    "\n",
    "\n",
    "    class_meta_path = (\n",
    "        MANIFESTS\n",
    "        /\n",
    "        f\"GSE157827_{cell_type}_PRIMARY_ELIGIBLE_DONOR_METADATA_v1.csv\"\n",
    "    )\n",
    "\n",
    "\n",
    "    class_groups.to_csv(\n",
    "        class_meta_path,\n",
    "        index=False,\n",
    "    )\n",
    "\n",
    "\n",
    "    universe_sha = sha256_file(\n",
    "        universe_path\n",
    "    )\n",
    "\n",
    "\n",
    "    class_pb_sha = sha256_file(\n",
    "        class_pb_path\n",
    "    )\n",
    "\n",
    "\n",
    "    class_meta_sha = sha256_file(\n",
    "        class_meta_path\n",
    "    )\n",
    "\n",
    "\n",
    "    gene_universe_rows.append(\n",
    "        {\n",
    "            \"cell_type\":\n",
    "                cell_type,\n",
    "\n",
    "            \"primary_threshold\":\n",
    "                PRIMARY_MIN_NUCLEI,\n",
    "\n",
    "            \"primary_donors\":\n",
    "                int(\n",
    "                    len(\n",
    "                        class_groups\n",
    "                    )\n",
    "                ),\n",
    "\n",
    "            \"AD\":\n",
    "                n_AD,\n",
    "\n",
    "            \"Control\":\n",
    "                n_Control,\n",
    "\n",
    "            \"CPM_threshold\":\n",
    "                CPM_THRESHOLD,\n",
    "\n",
    "            \"required_donors_CPM_ge1\":\n",
    "                required_donors,\n",
    "\n",
    "            \"input_features\":\n",
    "                N_FEATURES,\n",
    "\n",
    "            \"expression_pass_features\":\n",
    "                n_expression_pass,\n",
    "\n",
    "            \"MT_prefix_features_total\":\n",
    "                N_MT,\n",
    "\n",
    "            \"retained_DE_features\":\n",
    "                n_retained,\n",
    "\n",
    "            \"gene_universe_file\":\n",
    "                str(\n",
    "                    universe_path\n",
    "                ),\n",
    "\n",
    "            \"gene_universe_sha256\":\n",
    "                universe_sha,\n",
    "\n",
    "            \"filtered_pseudobulk_file\":\n",
    "                str(\n",
    "                    class_pb_path\n",
    "                ),\n",
    "\n",
    "            \"filtered_pseudobulk_sha256\":\n",
    "                class_pb_sha,\n",
    "\n",
    "            \"eligible_donor_metadata_file\":\n",
    "                str(\n",
    "                    class_meta_path\n",
    "                ),\n",
    "\n",
    "            \"eligible_donor_metadata_sha256\":\n",
    "                class_meta_sha,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    class_output_records[\n",
    "        cell_type\n",
    "    ] = {\n",
    "        \"n_donors\":\n",
    "            int(\n",
    "                len(\n",
    "                    class_groups\n",
    "                )\n",
    "            ),\n",
    "\n",
    "        \"n_AD\":\n",
    "            n_AD,\n",
    "\n",
    "        \"n_Control\":\n",
    "            n_Control,\n",
    "\n",
    "        \"required_donors_CPM_ge1\":\n",
    "            required_donors,\n",
    "\n",
    "        \"expression_pass_features\":\n",
    "            n_expression_pass,\n",
    "\n",
    "        \"retained_DE_features\":\n",
    "            n_retained,\n",
    "\n",
    "        \"gene_universe_file\":\n",
    "            str(\n",
    "                universe_path\n",
    "            ),\n",
    "\n",
    "        \"gene_universe_sha256\":\n",
    "            universe_sha,\n",
    "\n",
    "        \"filtered_pseudobulk_file\":\n",
    "            str(\n",
    "                class_pb_path\n",
    "            ),\n",
    "\n",
    "        \"filtered_pseudobulk_sha256\":\n",
    "            class_pb_sha,\n",
    "\n",
    "        \"eligible_donor_metadata_file\":\n",
    "            str(\n",
    "                class_meta_path\n",
    "            ),\n",
    "\n",
    "        \"eligible_donor_metadata_sha256\":\n",
    "            class_meta_sha,\n",
    "    }\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\n\",\n",
    "        cell_type,\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \" donors:\",\n",
    "        len(\n",
    "            class_groups\n",
    "        ),\n",
    "        f\"({n_AD} AD / {n_Control} Control)\",\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \" CPM>=1 required donors:\",\n",
    "        required_donors,\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \" expression-pass features:\",\n",
    "        n_expression_pass,\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \" retained non-MT DE features:\",\n",
    "        n_retained,\n",
    "    )\n",
    "\n",
    "\n",
    "gene_universe_summary = pd.DataFrame(\n",
    "    gene_universe_rows\n",
    ")\n",
    "\n",
    "\n",
    "gene_universe_summary.to_csv(\n",
    "    GENE_UNIVERSE_SUMMARY_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 100\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"GENE-UNIVERSE SUMMARY\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 100\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    gene_universe_summary[\n",
    "        [\n",
    "            \"cell_type\",\n",
    "            \"primary_donors\",\n",
    "            \"AD\",\n",
    "            \"Control\",\n",
    "            \"required_donors_CPM_ge1\",\n",
    "            \"expression_pass_features\",\n",
    "            \"retained_DE_features\",\n",
    "        ]\n",
    "    ].to_string(\n",
    "        index=False\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 17. HASH MAIN OUTPUTS\n",
    "# ============================================================\n",
    "\n",
    "OUTPUT_HASHES = {\n",
    "    \"eligibility\":\n",
    "        sha256_file(\n",
    "            ELIGIBILITY_PATH\n",
    "        ),\n",
    "\n",
    "    \"design_audit\":\n",
    "        sha256_file(\n",
    "            DESIGN_AUDIT_PATH\n",
    "        ),\n",
    "\n",
    "    \"age_overlap_audit\":\n",
    "        sha256_file(\n",
    "            AGE_OVERLAP_AUDIT_PATH\n",
    "        ),\n",
    "\n",
    "    \"group_metadata\":\n",
    "        sha256_file(\n",
    "            GROUP_METADATA_PATH\n",
    "        ),\n",
    "\n",
    "    \"all_raw_pseudobulk\":\n",
    "        sha256_file(\n",
    "            PSEUDOBULK_ALL_PATH\n",
    "        ),\n",
    "\n",
    "    \"gene_universe_summary\":\n",
    "        sha256_file(\n",
    "            GENE_UNIVERSE_SUMMARY_PATH\n",
    "        ),\n",
    "}\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 18. FREEZE STEP27\n",
    "# ============================================================\n",
    "\n",
    "LOCK = {\n",
    "    \"dataset\":\n",
    "        \"GSE157827\",\n",
    "\n",
    "    \"created_utc\":\n",
    "        datetime.now(\n",
    "            timezone.utc\n",
    "        ).isoformat(),\n",
    "\n",
    "    \"status\":\n",
    "        \"AD_REPLICATION_PRE_DE_PSEUDOBULK_AND_GENE_UNIVERSE_FROZEN\",\n",
    "\n",
    "    \"role\":\n",
    "        \"primary_AD_brain_replication\",\n",
    "\n",
    "    \"upstream_final_celltype_mapping_lock\":\n",
    "        str(\n",
    "            STEP26B_LOCK\n",
    "        ),\n",
    "\n",
    "    \"upstream_final_celltype_mapping_lock_sha256\":\n",
    "        sha256_file(\n",
    "            STEP26B_LOCK\n",
    "        ),\n",
    "\n",
    "    \"final_target_classes\":\n",
    "        TARGET_CLASSES,\n",
    "\n",
    "    \"donor_eligibility\": {\n",
    "        \"primary_min_nuclei\":\n",
    "            PRIMARY_MIN_NUCLEI,\n",
    "\n",
    "        \"primary_threshold_frozen\":\n",
    "            True,\n",
    "\n",
    "        \"sensitivity_min_nuclei\":\n",
    "            SENSITIVITY_MIN_NUCLEI,\n",
    "\n",
    "        \"sensitivity_threshold_frozen\":\n",
    "            True,\n",
    "\n",
    "        \"threshold_selected_before_DE\":\n",
    "            True,\n",
    "\n",
    "        \"threshold_selected_without_gene_level_disease_results\":\n",
    "            True,\n",
    "\n",
    "        \"primary_counts\":\n",
    "            {\n",
    "                row[\n",
    "                    \"cell_type\"\n",
    "                ]:\n",
    "                    {\n",
    "                        \"donors\":\n",
    "                            int(\n",
    "                                row[\n",
    "                                    \"primary_donors\"\n",
    "                                ]\n",
    "                            ),\n",
    "\n",
    "                        \"AD\":\n",
    "                            int(\n",
    "                                row[\n",
    "                                    \"primary_AD\"\n",
    "                                ]\n",
    "                            ),\n",
    "\n",
    "                        \"Control\":\n",
    "                            int(\n",
    "                                row[\n",
    "                                    \"primary_Control\"\n",
    "                                ]\n",
    "                            ),\n",
    "                    }\n",
    "\n",
    "                for _, row\n",
    "                in eligibility_summary.iterrows()\n",
    "            },\n",
    "\n",
    "        \"sensitivity20_counts\":\n",
    "            {\n",
    "                row[\n",
    "                    \"cell_type\"\n",
    "                ]:\n",
    "                    {\n",
    "                        \"donors\":\n",
    "                            int(\n",
    "                                row[\n",    "                                    \"sensitivity_donors\"\n",
    "                                ]\n",
    "                            ),\n",
    "\n",
    "                        \"AD\":\n",
    "                            int(\n",
    "                                row[\n",
    "                                    \"sensitivity_AD\"\n",
    "                                ]\n",
    "                            ),\n",
    "\n",
    "                        \"Control\":\n",
    "                            int(\n",
    "                                row[\n",
    "                                    \"sensitivity_Control\"\n",
    "                                ]\n",
    "                            ),\n",
    "                    }\n",
    "\n",
    "                for _, row\n",
    "                in eligibility_summary.iterrows()\n",
    "            },\n",
    "    },\n",
    "\n",
    "    \"primary_model\":\n",
    "        \"~ age + sex + diagnosis_binary\",\n",
    "\n",
    "    \"technical_sensitivity_model\":\n",
    "        \"~ age + sex + PMD_hours + diagnosis_binary\",\n",
    "\n",
    "    \"reference_levels\": {\n",
    "        \"diagnosis\":\n",
    "            \"Control\",\n",
    "\n",
    "        \"sex\":\n",
    "            \"Female\",\n",
    "    },\n",
    "\n",
    "    \"age_overlap_sensitivity_frozen\":\n",
    "        False,\n",
    "\n",
    "    \"pseudobulk\": {\n",
    "        \"biological_replicate\":\n",
    "            \"donor\",\n",
    "\n",
    "        \"aggregation\":\n",
    "            \"sum_raw_integer_UMIs\",\n",
    "\n",
    "        \"n_groups_all_21x4\":\n",
    "            84,\n",
    "\n",
    "        \"target_nuclei\":\n",
    "            int(\n",
    "                expected_selected_cells\n",
    "            ),\n",
    "\n",
    "        \"input_target_cell_UMIs\":\n",
    "            int(\n",
    "                expected_selected_UMI\n",
    "            ),\n",
    "\n",
    "        \"output_pseudobulk_UMIs\":\n",
    "            int(\n",
    "                observed_total_UMI\n",
    "            ),\n",
    "\n",
    "        \"UMI_conservation\":\n",
    "            True,\n",
    "\n",
    "        \"all_group_raw_matrix\":\n",
    "            str(\n",
    "                PSEUDOBULK_ALL_PATH\n",
    "            ),\n",
    "\n",
    "        \"all_group_raw_matrix_sha256\":\n",
    "            OUTPUT_HASHES[\n",
    "                \"all_raw_pseudobulk\"\n",
    "            ],\n",
    "\n",
    "        \"group_metadata\":\n",
    "            str(\n",
    "                GROUP_METADATA_PATH\n",
    "            ),\n",
    "\n",
    "        \"group_metadata_sha256\":\n",
    "            OUTPUT_HASHES[\n",
