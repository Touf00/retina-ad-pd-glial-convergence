   "source": [
    "# Source analysis cell: 47\n",
    "# ============================================================\n",
    "# RETINA-ND — STEP 26A1\n",
    "# GSE157827 DISEASE-BLIND EMBEDDING + CLUSTERING CHECKPOINT\n",
    "#\n",
    "# SCIENTIFIC PURPOSE\n",
    "# ------------------\n",
    "# Reconstruct disease-blind cell states BEFORE any AD-vs-Control\n",
    "# expression analysis.\n",
    "#\n",
    "# THIS CELL DOES:\n",
    "#   1. verify frozen STEP-25 inputs\n",
    "#   2. detect genes in >=3 QC-pass nuclei\n",
    "#   3. build the 169,506 x 29,583 raw-count matrix\n",
    "#   4. select 1,000 Seurat-v3 HVGs, batch_key=donor_id\n",
    "#      with predeclared LOESS fallback:\n",
    "#          0.3 -> 0.5 -> 0.7 -> 1.0\n",
    "#   5. normalize/log1p for annotation only\n",
    "#   6. PCA50\n",
    "#   7. donor-only Harmony\n",
    "#   8. neighbors on first 20 Harmony dimensions\n",
    "#   9. Leiden resolution=1\n",
    "#  10. save cluster assignments + raw marker-expression checkpoint\n",
    "#\n",
    "# THIS CELL DOES NOT:\n",
    "#   - use diagnosis in filtering/HVG/PCA/Harmony/clustering\n",
    "#   - assign cell types\n",
    "#   - split OPC/Oligo\n",
    "#   - inspect author cell-type proportions\n",
    "#   - build pseudobulk\n",
    "#   - run DE\n",
    "#   - compare GSE174367\n",
    "#   - use PD data\n",
    "#   - run AD<->PD convergence\n",
    "#\n",
    "# STEP 26A2 will perform annotation + benchmarking.\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. INSTALL / VERIFY THE PREVIOUSLY USED ANNOTATION ENVIRONMENT\n",
    "# ============================================================\n",
    "\n",
    "import sys\n",
    "import subprocess\n",
    "import importlib.metadata\n",
    "from pathlib import Path\n",
    "\n",
    "\n",
    "REQUIRED_PACKAGES = {\n",
    "    \"scanpy\": \"1.12.4\",\n",
    "    \"harmonypy\": \"2.0.0\",\n",
    "    \"leidenalg\": \"0.12.0\",\n",
    "    \"igraph\": \"1.0.0\",\n",
    "    \"scikit-misc\": \"0.5.2\",\n",
    "}\n",
    "\n",
    "\n",
    "to_install = []\n",
    "\n",
    "\n",
    "for package, version in REQUIRED_PACKAGES.items():\n",
    "\n",
    "    try:\n",
    "        current = importlib.metadata.version(\n",
    "            package\n",
    "        )\n",
    "\n",
    "    except importlib.metadata.PackageNotFoundError:\n",
    "        current = None\n",
    "\n",
    "\n",
    "    print(\n",
    "        package,\n",
    "        \"current=\",\n",
    "        current,\n",
    "        \"required=\",\n",
    "        version,\n",
    "    )\n",
    "\n",
    "\n",
    "    if current != version:\n",
    "\n",
    "        to_install.append(\n",
    "            f\"{package}=={version}\"\n",
    "        )\n",
    "\n",
    "\n",
    "if to_install:\n",
    "\n",
    "    print(\n",
    "        \"\\nInstalling exact annotation packages:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        to_install\n",
    "    )\n",
    "\n",
    "    subprocess.check_call(\n",
    "        [\n",
    "            sys.executable,\n",
    "            \"-m\",\n",
    "            \"pip\",\n",
    "            \"install\",\n",
    "            \"-q\",\n",
    "            *to_install,\n",
    "        ]\n",
    "    )\n",
    "\n",
    "else:\n",
    "\n",
    "    print(\n",
    "        \"\\nAnnotation environment packages already match.\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. PERSISTENT RUNNER / LOG\n",
    "#\n",
    "# Use a child process so any package changes above cannot leave\n",
    "# stale imported modules in this notebook interpreter.\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "assert ROOT.exists(), ROOT\n",
    "\n",
    "\n",
    "SCRIPT_DIR = ROOT / \"scripts\"\n",
    "LOG_DIR = ROOT / \"logs\"\n",
    "\n",
    "SCRIPT_DIR.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "LOG_DIR.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "\n",
    "RUNNER_PATH = (\n",
    "    SCRIPT_DIR\n",
    "    /\n",
    "    \"STEP26A1_GSE157827_DISEASE_BLIND_CLUSTERING_v1.py\"\n",
    ")\n",
    "\n",
    "LOG_PATH = (\n",
    "    LOG_DIR\n",
    "    /\n",
    "    \"STEP26A1_GSE157827_DISEASE_BLIND_CLUSTERING_v1.log\"\n",
    ")\n",
    "\n",
    "\n",
    "RUNNER = r'''\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "import gc\n",
    "import gzip\n",
    "import hashlib\n",
