   "source": [
    "# Source analysis cell: 42\n",
    "# ============================================================\n",
    "# STEP 23B — GSE174367 AD TECHNICAL-SENSITIVITY AUDIT\n",
    "#            + FINAL DISCOVERY ROBUSTNESS FREEZE\n",
    "#\n",
    "# RECOVERY FROM STEP 23 AUDIT-ONLY FAILURE\n",
    "# ----------------------------------------\n",
    "# STEP 22 saved the per-gene combined-FDR flag as:\n",
    "#\n",
    "#     RIN_and_PMI_FDR\n",
    "#\n",
    "# The previous STEP 23 audit incorrectly expected:\n",
    "#\n",
    "#     RIN_and_PMI_same_direction_and_FDR\n",
    "#\n",
    "# They represent the SAME rule:\n",
    "#\n",
    "#     RIN same direction\n",
    "#     AND PMI same direction\n",
    "#     AND RIN FDR < 0.05\n",
    "#     AND PMI FDR < 0.05\n",
    "#\n",
    "# This cell:\n",
    "#   - does NOT rerun DE\n",
    "#   - does NOT alter STEP 22\n",
    "#   - verifies STEP 22 exactly as stored\n",
    "#   - creates the longer canonical alias only in the\n",
    "#     final audited/frozen output\n",
    "#\n",
    "# NO NEW DE.\n",
    "# NO REFILTERING.\n",
    "# NO MODEL CHANGE.\n",
    "# NO AD REPLICATION.\n",
    "# NO PD DATA.\n",
    "# NO AD↔PD CONVERGENCE.\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
