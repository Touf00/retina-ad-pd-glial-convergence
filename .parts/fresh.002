    "\n",
    "    })\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nResult audit:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Tested genes:\",\n",
    "        f\"{expected_n:,}\"\n",
