    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. HELPERS\n",
    "# ============================================================\n",
    "\n",
    "def sha256_file(\n",
    "    path,\n",
    "    block_size=1024 * 1024\n",
    "):\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\"\n",
    "    ) as f:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            block = f.read(\n",
    "                block_size\n",
    "            )\n",
    "\n",
    "            if not block:\n",
    "                break\n",
    "\n",
    "            h.update(\n",
    "                block\n",
    "            )\n",
    "\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "def safe_pearson(\n",
    "    x,\n",
    "    y\n",
    "):\n",
    "\n",
    "    x = np.asarray(\n",
    "        x,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "    y = np.asarray(\n",
    "        y,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "    mask = (\n",
    "        np.isfinite(x)\n",
    "        &\n",
    "        np.isfinite(y)\n",
    "    )\n",
    "\n",
    "    assert int(\n",
    "        mask.sum()\n",
    "    ) >= 3\n",
    "\n",
    "    return float(\n",
    "        pearsonr(\n",
    "            x[mask],\n",
    "            y[mask]\n",
    "        ).statistic\n",
    "    )\n",
    "\n",
    "\n",
    "def safe_spearman(\n",
    "    x,\n",
    "    y\n",
    "):\n",
    "\n",
    "    x = np.asarray(\n",
    "        x,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "    y = np.asarray(\n",
    "        y,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "    mask = (\n",
    "        np.isfinite(x)\n",
    "        &\n",
    "        np.isfinite(y)\n",
    "    )\n",
    "\n",
    "    assert int(\n",
    "        mask.sum()\n",
    "    ) >= 3\n",
    "\n",
    "    return float(\n",
    "        spearmanr(\n",
    "            x[mask],\n",
    "            y[mask]\n",
    "        ).statistic\n",
    "    )\n",
    "\n",
    "\n",
    "def direction_fraction(\n",
    "    x,\n",
    "    y\n",
    "):\n",
    "\n",
    "    x = np.asarray(\n",
    "        x,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "    y = np.asarray(\n",
    "        y,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "    mask = (\n",
    "        np.isfinite(x)\n",
    "        &\n",
    "        np.isfinite(y)\n",
    "        &\n",
    "        (x != 0)\n",
    "        &\n",
    "        (y != 0)\n",
    "    )\n",
    "\n",
    "    assert int(\n",
    "        mask.sum()\n",
    "    ) > 0\n",
    "\n",
    "    return float(\n",
    "        (\n",
    "            np.sign(\n",
    "                x[mask]\n",
    "            )\n",
    "            ==\n",
    "            np.sign(\n",
    "                y[mask]\n",
    "            )\n",
    "        ).mean()\n",
    "    )\n",
    "\n",
    "\n",
    "def as_bool(\n",
    "    series\n",
    "):\n",
    "\n",
    "    if pd.api.types.is_bool_dtype(\n",
    "        series\n",
    "    ):\n",
    "\n",
    "        return series.astype(\n",
    "            bool\n",
    "        )\n",
    "\n",
    "\n",
    "    mapped = (\n",
    "        series\n",
    "        .astype(str)\n",
    "        .str.strip()\n",
    "        .str.lower()\n",
    "        .map(\n",
    "            {\n",
    "                \"true\":\n",
    "                    True,\n",
    "\n",
    "                \"false\":\n",
    "                    False,\n",
    "\n",
    "                \"1\":\n",
    "                    True,\n",
    "\n",
    "                \"0\":\n",
    "                    False,\n",
    "            }\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert mapped.notna().all(), (\n",
    "        \"Boolean column contains unexpected values.\"\n",
    "    )\n",
    "\n",
    "\n",
    "    return mapped.astype(\n",
    "        bool\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. EXPECTED FROZEN RESULTS\n",
    "# ============================================================\n",
    "\n",
    "CLASSES = [\n",
