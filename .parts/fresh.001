    "        str(\n",
    "            combined_comparison_path\n",
    "        ),\n",
    "\n",
    "    \"DE_engine\":\n",
    "        \"PyDESeq2\",\n",
    "\n",
    "    \"DE_engine_version\":\n",
    "        PYDESEQ2_VERSION,\n",
    "\n",
    "    \"discovery_dataset_loaded\":\n",
    "        False,\n",
    "\n",
    "    \"discovery_replication_effect_comparison_performed\":\n",
    "        False,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    sensitivity_lock_path,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",    "        SENSITIVITY_LOCK,\n",
    "        f,\n",
    "        indent=2\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# J. SENSITIVITY SUPPORT FREEZE\n",
    "#\n",
    "# This freezes the internal robustness assessment BEFORE\n",
    "# cross-dataset comparison.\n",
    "# ============================================================\n",
    "\n",
    "SUPPORT_FREEZE = {\n",
    "\n",
    "    \"dataset\":\n",
    "        \"GSE157783\",\n",
    "\n",
    "    \"created_utc\":\n",
    "        datetime.now(\n",
    "            timezone.utc\n",
    "        ).isoformat(),\n",
    "\n",
    "    \"status\":\n",
    "        \"PD_REPLICATION_SENSITIVITY_SUPPORT_FROZEN\",\n",
    "\n",
    "    \"primary_effects\":\n",
    "        str(\n",
    "            primary_effect_freeze_path\n",
    "        ),\n",
    "\n",
