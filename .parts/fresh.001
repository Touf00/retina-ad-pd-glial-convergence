    "    \"GSE174367\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre_de_lock[\n",
    "        \"design_audit\"\n",
    "    ][\n",
    "        \"primary_rank\"\n",
    "    ]\n",
    "    ==\n",
    "    6\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre_de_lock[\n",
    "        \"design_audit\"\n",
    "    ][\n",
    "        \"primary_columns\"\n",
    "    ]\n",
    "    ==\n",
    "    6\n",
    ")\n",
    "\n",
