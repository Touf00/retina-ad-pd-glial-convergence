 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# RETINA-ND — fresh end-to-end bioRxiv release test\n",
    "\n",
    "This copy runs the clean release pipeline into a new project folder `RETINA_ND_RELEASE_TEST`. It copies only the immutable/manual inputs (frozen Reactome V97 and Wolf Table S7, plus PXD073336 if already present) from the completed project, then rebuilds the analysis products.\n",
    "\n",
    "**Do not use an existing non-empty test folder.** The setup cell deliberately stops if it detects one, so the test cannot accidentally pass by reusing old results.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# 00 — FRESH END-TO-END RELEASE TEST SETUP\n",
    "# ============================================================\n",
    "\n",
    "import os\n",
    "import sys\n",
    "import json\n",
    "import shutil\n",
    "import platform\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "try:\n",
    "    from google.colab import drive\n",
    "    mount = Path(\"/content/drive\")\n",
    "    if not (mount / \"MyDrive\").exists():\n",
    "        drive.mount(str(mount), force_remount=False)\n",
    "except Exception:\n",
    "    pass\n",
    "\n",
    "SOURCE_PROJECT = Path(\"/content/drive/MyDrive/RETINA_ND_V2 (1)\")\n",
    "if not SOURCE_PROJECT.exists():\n",
    "    SOURCE_PROJECT = Path(\"/content/drive/MyDrive/RETINA_ND_V2\")\n",
    "\n",
    "TEST_ROOT = Path(\"/content/drive/MyDrive/RETINA_ND_RELEASE_TEST\")\n",
    "\n",
    "# Do not silently reuse an old test run.\n",
    "if TEST_ROOT.exists() and any(TEST_ROOT.iterdir()):\n",
    "    raise RuntimeError(\n",
    "        f\"Fresh-test folder already contains files:\\n{TEST_ROOT}\\n\"\n",
    "        \"Rename/remove that old test folder before running this notebook. \"\n",
    "        \"This guard prevents a false 'fresh' rerun.\"\n",
    "    )\n",
    "\n",
    "TEST_ROOT.mkdir(parents=True, exist_ok=True)\n",
    "os.environ[\"RETINA_ND_ROOT\"] = str(TEST_ROOT.resolve())\n",
    "\n",
    "ROOT = TEST_ROOT.resolve()\n",
    "LOCKS = ROOT / \"locks\"\n",
    "MANIFESTS = ROOT / \"manifests\"\n",
    "RESULTS = ROOT / \"results\"\n",
    "\n",
    "for p in [\n",
    "    LOCKS,\n",
    "    MANIFESTS,\n",
    "    RESULTS,\n",
    "    ROOT / \"downloads\",\n",
    "    ROOT / \"scripts\",\n",
    "    ROOT / \"logs\",\n",
    "    ROOT / \"resources\" / \"pathways\",\n",
    "    ROOT / \"ocular_validation\" / \"Wolf_Cell_2023\",\n",
    "    ROOT / \"ocular_validation\" / \"PXD073336\",\n",
    "]:\n",
    "    p.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# Copy only immutable/manual source resources needed for an exact fresh rerun.\n",
    "resource_pairs = [\n",
    "    (\n",
    "        SOURCE_PROJECT / \"resources\" / \"pathways\" / \"ReactomePathways_V97.gmt\",\n",
    "        ROOT / \"resources\" / \"pathways\" / \"ReactomePathways_V97.gmt\",\n",
    "    ),\n",
    "    (\n",
    "        SOURCE_PROJECT / \"ocular_validation\" / \"Wolf_Cell_2023\" / \"NIHMS1931846-supplement-8.xlsx\",\n",
    "        ROOT / \"ocular_validation\" / \"Wolf_Cell_2023\" / \"NIHMS1931846-supplement-8.xlsx\",\n",
    "    ),\n",
    "]\n",
    "\n",
    "# PXD073336 can be downloaded automatically, but copy the exact source workbook\n",
    "# when it is already available in the completed project.\n",
    "pxd_src = SOURCE_PROJECT / \"ocular_validation\" / \"PXD073336\" / \"Retinaxhippocampus_Proteomics.xlsx\"\n",
    "pxd_dst = ROOT / \"ocular_validation\" / \"PXD073336\" / \"Retinaxhippocampus_Proteomics.xlsx\"\n",
    "if pxd_src.exists():\n",
    "    resource_pairs.append((pxd_src, pxd_dst))\n",
    "\n",
    "for src, dst in resource_pairs:\n",
    "    if not src.exists():\n",
    "        raise FileNotFoundError(\n",
    "            \"Required immutable/manual input is missing from the completed project:\\n\"\n",
    "            f\"{src}\"\n",
    "        )\n",
    "    shutil.copy2(src, dst)\n",
    "    print(\"Copied source resource:\", src.name)\n",
    "\n",
    "STRICT_REFERENCE_CHECKS = True\n",
    "PROJECT_VERSION = \"2.0-biorxiv-fresh-test\"\n",
    "\n",
    "print(\"\\nFRESH TEST ROOT:\", ROOT)\n",
    "print(\"SOURCE PROJECT:\", SOURCE_PROJECT)\n",
    "print(\"UTC:\", datetime.now(timezone.utc).isoformat())\n",
    "print(\"Python:\", platform.python_version())\n",
    "print(\"\\nRun the notebook from top to bottom. A successful finish should reach the final QC cell.\")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# 01 — ENVIRONMENT SNAPSHOT\n",
    "# Critical versions recorded in the executed analysis are checked here.\n",
    "# ============================================================\n",
    "\n",
    "import importlib.metadata\n",
    "\n",
    "expected = {\n",
    "    \"pandas\": \"2.3.3\",\n",
    "    \"pydeseq2\": \"0.5.4\",\n",
    "    \"numpy\": \"2.1.3\",\n",
    "    \"scipy\": \"1.16.3\",\n",
    "    \"anndata\": \"0.13.3.post0\",\n",
    "}\n",
    "\n",
    "optional_expected = {\n",
    "    \"scanpy\": \"1.12.4\",\n",
    "    \"harmonypy\": \"2.0.0\",\n",
    "    \"leidenalg\": \"0.12.0\",\n",
    "    \"igraph\": \"1.0.0\",\n",
    "    \"scikit-misc\": \"0.5.2\",\n",
    "}\n",
    "\n",
    "def version_of(pkg):\n",
    "    try:\n",
    "        return importlib.metadata.version(pkg)\n",
    "    except importlib.metadata.PackageNotFoundError:\n",
    "        return None\n",
    "\n",
    "print(\"Critical environment:\")\n",
    "for pkg, expected_version in expected.items():\n",
    "    current = version_of(pkg)\n",
    "    print(f\"  {pkg}: current={current}, expected={expected_version}\")\n",
    "\n",
    "print(\"\\nAnnotation environment:\")\n",
    "for pkg, expected_version in optional_expected.items():\n",
    "    current = version_of(pkg)\n",
    "    print(f\"  {pkg}: current={current}, expected={expected_version}\")\n",
    "\n",
    "print(\"\\nOther packages used:\")\n",
    "for pkg in [\"gseapy\", \"matplotlib\", \"requests\", \"openpyxl\", \"h5py\", \"pypdf\"]:\n",
    "    print(f\"  {pkg}: {version_of(pkg)}\")\n",
    "\n",
    "snapshot = {\n",
    "    pkg: version_of(pkg)\n",
    "    for pkg in sorted(set(expected) | set(optional_expected) |\n",
    "                      {\"gseapy\", \"matplotlib\", \"requests\", \"openpyxl\", \"h5py\", \"pypdf\"})\n",
    "}\n",
    "\n",
    "with open(ROOT / \"release_environment_snapshot.json\", \"w\", encoding=\"utf-8\") as f:\n",
    "    json.dump(snapshot, f, indent=2)\n",
    "\n",
    "print(\"\\nEnvironment snapshot written to:\")\n",
    "print(ROOT / \"release_environment_snapshot.json\")\n"
   ]
  },
