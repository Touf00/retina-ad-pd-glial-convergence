    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G23. CLEANUP\n",
    "    # ========================================================\n",
    "\n",
    "    del universe\n",
    "    del raw\n",
    "    del metadata\n",
    "    del counts\n",
    "    del de_meta\n",
    "    del dds\n",
    "    del stats\n",
    "    del result\n",
    "    del primary\n",
    "    del comparison\n",
    "    del primary_hits\n",
    "    del annotation\n",
    "    del design_matrix\n",
    "\n",
    "    gc.collect()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# H. COMBINED OUTPUTS\n",
    "# ============================================================\n",
    "\n",
    "summary = pd.DataFrame(\n",
    "    summary_rows\n",
    ")\n",
    "\n",
    "\n",
    "concordance = pd.DataFrame(\n",
    "    concordance_rows\n",
    ")\n",
    "\n",
    "\n",
    "summary[\n",
    "    \"cell_type\"\n",
    "] = pd.Categorical(\n",
    "    summary[\n",
    "        \"cell_type\"\n",
    "    ],\n",
    "    categories=PRIMARY_CLASSES,\n",
    "    ordered=True\n",
    ")\n",
    "\n",
    "\n",
    "concordance[\n",
    "    \"cell_type\"\n",
    "] = pd.Categorical(\n",
    "    concordance[\n",
    "        \"cell_type\"\n",
    "    ],\n",
    "    categories=PRIMARY_CLASSES,\n",
    "    ordered=True\n",
    ")\n",
    "\n",
    "\n",
    "summary = (\n",
    "    summary\n",
    "    .sort_values(\n",
    "        \"cell_type\"\n",
    "    )\n",
    "    .reset_index(\n",
    "        drop=True\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "concordance = (\n",
    "    concordance\n",
    "    .sort_values(\n",
    "        \"cell_type\"\n",
    "    )\n",
    "    .reset_index(\n",
    "        drop=True\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "summary[\n",
    "    \"cell_type\"\n",
    "] = (\n",
    "    summary[\n",
    "        \"cell_type\"\n",
    "    ]\n",
    "    .astype(str)\n",
    ")\n",
    "\n",
    "\n",
    "concordance[\n",
    "    \"cell_type\"\n",
    "] = (\n",
    "    concordance[\n",
    "        \"cell_type\"\n",
    "    ]\n",
    "    .astype(str)\n",
    ")\n",
    "\n",
    "\n",
    "summary.to_csv(\n",
    "    summary_path,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "concordance.to_csv(\n",
    "    concordance_path,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "combined_comparison = pd.concat(\n",
    "    comparison_tables,\n",
    "    axis=0,\n",
    "    ignore_index=True\n",
    ")\n",
    "\n",
    "\n",
    "combined_comparison.to_csv(\n",
    "    combined_comparison_path,\n",
    "    index=False,\n",
    "    compression={\n",
    "        \"method\":\n",
    "            \"gzip\",\n",
    "\n",
    "        \"compresslevel\":\n",
    "            6,\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# I. SENSITIVITY RUN LOCK\n",
    "# ============================================================\n",
    "\n",
    "SENSITIVITY_LOCK = {\n",
    "\n",
    "    \"dataset\":\n",
    "        \"GSE157783\",\n",
    "\n",
    "    \"created_utc\":\n",
    "        datetime.now(\n",
    "            timezone.utc\n",
    "        ).isoformat(),\n",
    "\n",
