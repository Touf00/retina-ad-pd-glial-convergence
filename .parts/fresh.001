    "        n_technical_sig\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  LFC Pearson:\",\n",
    "        lfc_pearson\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  LFC Spearman:\",\n",
    "        lfc_spearman\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Wald Spearman:\",\n",
    "        wald_spearman\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  All-gene direction concordance:\",\n",
    "        direction_concordance\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Primary FDR same direction:\",\n",
    "        f\"{n_same_direction}/{n_primary_sig}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Primary FDR nominal p<0.05:\",\n",
    "        f\"{n_nominal}/{n_primary_sig}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Primary FDR still FDR<0.05:\",\n",
    "        f\"{n_still_fdr}/{n_primary_sig}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Primary FDR PMI-supported:\",\n",
