   "source": [
    "# Source analysis cell: 39\n",
    "# ============================================================\n",
    "# STEP 21 — GSE174367 PRIMARY AD DISCOVERY DE\n",
    "#           + PRIMARY AD EFFECT FREEZE\n",
    "#\n",
    "# FIRST AD DISEASE-EXPRESSION ANALYSIS.\n",
    "#\n",
    "# PRIMARY MODEL:\n",
    "#     ~ age + sex + batch + diagnosis_binary\n",
    "#\n",
    "# CONTRAST:\n",
    "#     AD vs Control\n",
    "#\n",
    "# IMPORTANT\n",
    "# ---------\n",
    "# - Uses ONLY STEP-20 frozen gene universes.\n",
    "# - Uses all 18 frozen donors:\n",
    "#       11 AD\n",
    "#        7 Control\n",
    "#\n",
    "# - NO gene refiltering.\n",
    "# - NO donor changes.\n",
    "# - NO RIN sensitivity yet.\n",
    "# - NO PMI sensitivity yet.\n",
    "# - NO AD replication yet.\n",
    "# - NO AD↔PD convergence.\n",
    "#\n",
    "# At completion:\n",
    "#   1. primary AD discovery DE is complete;\n",
    "#   2. ALL tested effects are saved;\n",
    "#   3. primary AD discovery effects are frozen;\n",
    "#   4. nothing is compared with PD or AD replication.\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "import sys\n",
    "import subprocess\n",
    "from pathlib import Path\n",
    "import textwrap\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. FRESH COMPATIBLE ENVIRONMENT\n",
    "# ============================================================\n",
    "\n",
    "TARGET_PANDAS = \"2.3.3\"\n",
    "TARGET_PYDESEQ2 = \"0.5.4\"\n",
    "\n",
    "\n",
    "print(\"=\" * 80)\n",
    "print(\"STEP 21 ENVIRONMENT PREPARATION\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "\n",
    "subprocess.check_call(\n",
    "    [\n",
    "        sys.executable,\n",
    "        \"-m\",\n",
    "        \"pip\",\n",
    "        \"install\",\n",
    "        \"-q\",\n",
    "        \"--upgrade\",\n",
    "        f\"pandas=={TARGET_PANDAS}\",\n",
    "        f\"pydeseq2=={TARGET_PYDESEQ2}\",\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. WRITE FRESH STEP-21 RUNNER\n",
    "# ============================================================\n",
    "\n",
    "runner_path = Path(\n",
    "    \"/content/RETINA_ND_STEP21_GSE174367_PRIMARY_AD_DISCOVERY_DE.py\"\n",
    ")\n",
    "\n",
    "\n",
    "RUNNER = r'''\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "import platform\n",
