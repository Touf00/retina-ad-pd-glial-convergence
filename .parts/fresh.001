   "source": [
    "# Source analysis cell: 36\n",
    "# ============================================================\n",
    "# V2 GSE174367 SOURCE ACQUISITION — DIRECT GEO ONLY\n",
    "# ============================================================\n",
    "from pathlib import Path\n",
    "import requests, hashlib, shutil, time\n",
    "\n",
    "AD_DIR=ROOT/'GSE174367_AD_discovery'; DOWNLOAD_DIR=AD_DIR/'downloads'\n",
    "AD_DIR.mkdir(parents=True,exist_ok=True); DOWNLOAD_DIR.mkdir(parents=True,exist_ok=True)\n",
    "files={\n",
    " 'cell_meta':('https://ftp.ncbi.nlm.nih.gov/geo/series/GSE174nnn/GSE174367/suppl/GSE174367_snRNA-seq_cell_meta.csv.gz', DOWNLOAD_DIR/'GSE174367_snRNA-seq_cell_meta.csv.gz', 'ab1a029deb43196e2bb1fea5907d838885750cfff3850c600c07588c7c7cdb2b'),\n",
    " 'h5':('https://ftp.ncbi.nlm.nih.gov/geo/series/GSE174nnn/GSE174367/suppl/GSE174367_snRNA-seq_filtered_feature_bc_matrix.h5', DOWNLOAD_DIR/'GSE174367_snRNA-seq_filtered_feature_bc_matrix.h5', '6ba98a1af8772af08c8cdd5e5e63eebb0890daed48cac2e1b8961dcc67069b77'),\n",
    "}\n",
    "def sha(p):\n",
    " h=hashlib.sha256();\n",
    " with open(p,'rb') as f:\n",
    "  for b in iter(lambda:f.read(4*1024*1024),b''): h.update(b)\n",
    " return h.hexdigest()\n",
    "def download(url,dst):\n",
    " if dst.exists() and dst.stat().st_size>0: return\n",
    " part=Path(str(dst)+'.part'); part.unlink(missing_ok=True)\n",
    " with requests.get(url,stream=True,timeout=180) as r:\n",
    "  r.raise_for_status()\n",
    "  with open(part,'wb') as f:\n",
    "   for ch in r.iter_content(4*1024*1024):\n",
    "    if ch: f.write(ch)\n",
    " part.replace(dst)\n",
    "for name,(url,dst,expected) in files.items():\n",
    " download(url,dst); got=sha(dst); print(name,dst.stat().st_size,got); assert got==expected,(name,got,expected)\n",
    "print('GSE174367 official source hashes: PASS')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 37\n",
    "# ============================================================\n",
    "# STEP 19D — FINAL GSE174367 AD DISCOVERY DATA AUDIT\n",
    "#\n",
    "# FINAL RECOVERY:\n",
    "#   Use EXACT AUTHOR Cell.Type labels.\n",
    "#\n",
    "#   ASC     -> Astro\n",
    "#   MG      -> Micro\n",
    "#   OPC     -> OPC\n",
    "#   ODC     -> Oligo\n",
    "#   EX      -> Excitatory_neuron\n",
    "#   INH     -> Inhibitory_neuron\n",
    "#   PER.END -> Vascular\n",
    "#\n",
    "# NO DIFFERENTIAL EXPRESSION.\n",
    "# NO GENE FILTERING.\n",
    "# NO DE MODEL SELECTION.\n",
    "# NO AD↔PD CONVERGENCE.\n",
    "# ============================================================\n",
    "\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import h5py\n",
    "import hashlib\n",
    "import json\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "DOWNLOAD_DIR = (\n",
    "    ROOT /\n",
    "    \"GSE174367_AD_discovery\" /\n",
    "    \"downloads\"\n",
    ")\n",
    "\n",
    "MANIFESTS = ROOT / \"manifests\"\n",
    "LOCKS = ROOT / \"locks\"\n",
    "\n",
    "MANIFESTS.mkdir(parents=True, exist_ok=True)\n",
    "LOCKS.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "\n",
    "CELL_META_PATH = (\n",
    "    DOWNLOAD_DIR /\n",
    "    \"GSE174367_snRNA-seq_cell_meta.csv.gz\"\n",
    ")\n",
    "\n",
    "H5_PATH = (\n",
    "    DOWNLOAD_DIR /\n",
    "    \"GSE174367_snRNA-seq_filtered_feature_bc_matrix.h5\"\n",
    ")\n",
    "\n",
    "ROLE_LOCK_PATH = (\n",
    "    LOCKS /\n",
    "    \"AD_BRAIN_DATASET_ROLES_v1.json\"\n",
    ")\n",
    "\n",
    "AUDIT_LOCK_PATH = (\n",
    "    LOCKS /\n",
    "    \"GSE174367_AD_DISCOVERY_DATA_AUDIT_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "CELL_OUTPUT = (\n",
    "    MANIFESTS /\n",
    "    \"GSE174367_author_cell_metadata_AUDITED_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "DONOR_OUTPUT = (\n",
    "    MANIFESTS /\n",
    "    \"GSE174367_donor_metadata_FROZEN_v1.csv\"\n",
    ")\n",
    "\n",
    "FEATURE_OUTPUT = (\n",
    "    MANIFESTS /\n",
    "    \"GSE174367_H5_feature_metadata_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "H5_ONLY_OUTPUT = (\n",
    "    MANIFESTS /\n",
    "    \"GSE174367_H5_ONLY_UNANNOTATED_BARCODES_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "ALIGNMENT_OUTPUT = (\n",
    "    MANIFESTS /\n",
    "    \"GSE174367_H5_METADATA_BARCODE_ALIGNMENT_v1.csv\"\n",
    ")\n",
    "\n",
    "MAPPING_OUTPUT = (\n",
    "    MANIFESTS /\n",
    "    \"GSE174367_author_to_canonical_celltype_mapping_v1.csv\"\n",
    ")\n",
    "\n",
    "DONOR_CELL_OUTPUT = (\n",
    "    MANIFESTS /\n",
    "    \"GSE174367_donor_cellclass_counts_v1.csv\"\n",
    ")\n",
    "\n",
    "COVERAGE_OUTPUT = (\n",
    "    MANIFESTS /\n",
    "    \"GSE174367_AD_discovery_cellclass_coverage_v1.csv\"\n",
    ")\n",
    "\n",
    "MISSINGNESS_OUTPUT = (\n",
    "    MANIFESTS /\n",
    "    \"GSE174367_donor_covariate_missingness_v1.csv\"\n",
    ")\n",
    "\n",
    "CONSISTENCY_OUTPUT = (\n",
    "    MANIFESTS /\n",
    "    \"GSE174367_donor_metadata_consistency_v1.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "    CELL_META_PATH,\n",
    "    H5_PATH,\n",
    "    ROLE_LOCK_PATH,\n",
    "]:\n",
    "\n",
    "    assert path.exists(), f\"Missing: {path}\"\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. VERIFY DATASET-ROLE FREEZE\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    ROLE_LOCK_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    role_lock = json.load(f)\n",
    "\n",
    "\n",
    "assert (\n",
    "    role_lock[\"status\"]\n",
    "    ==\n",
    "    \"AD_DATASET_ROLES_FROZEN_BEFORE_DISEASE_EXPRESSION\"\n",
    ")\n",
    "\n",
    "assert (\n",
    "    role_lock[\"primary_discovery\"][\"dataset\"]\n",
    "    ==\n",
    "    \"GSE174367\"\n",
    ")\n",
    "\n",
    "assert (\n",
    "    role_lock[\"AD_disease_expression_inspected\"]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "print(\"=\" * 80)\n",
    "print(\"AD DATASET ROLE LOCK VERIFIED\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. HASH INPUT FILES\n",
    "# ============================================================\n",
    "\n",
    "def sha256_file(path, block_size=1024 * 1024):\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "    with open(path, \"rb\") as f:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            block = f.read(block_size)\n",
    "\n",
    "            if not block:\n",
    "                break\n",
    "\n",
    "            h.update(block)\n",
    "\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "CELL_META_SHA = sha256_file(CELL_META_PATH)\n",
    "H5_SHA = sha256_file(H5_PATH)\n",
    "\n",
    "\n",
    "assert (\n",
    "    CELL_META_SHA\n",
    "    ==\n",
    "    \"ab1a029deb43196e2bb1fea5907d838885750cfff3850c600c07588c7c7cdb2b\"\n",
    ")\n",
    "\n",
    "assert (\n",
    "    H5_SHA\n",
    "    ==\n",
    "    \"6ba98a1af8772af08c8cdd5e5e63eebb0890daed48cac2e1b8961dcc67069b77\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\nOfficial input hashes: PASS\")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. LOAD AUTHOR METADATA\n",
    "# ============================================================\n",
    "\n",
    "cells = pd.read_csv(\n",
    "    CELL_META_PATH,\n",
    "    compression=\"gzip\",\n",
    "    low_memory=False\n",
    ")\n",
    "\n",
    "\n",
    "EXPECTED_COLUMNS = [\n",
    "    \"Barcode\",\n",
    "    \"SampleID\",\n",
    "    \"Diagnosis\",\n",
    "    \"Batch\",\n",
    "    \"Cell.Type\",\n",
    "    \"cluster\",\n",
    "    \"Age\",\n",
    "    \"Sex\",\n",
    "    \"PMI\",\n",
    "    \"Tangle.Stage\",\n",
    "    \"Plaque.Stage\",\n",
    "    \"RIN\",\n",
    "]\n",
    "\n",
    "\n",
    "assert cells.columns.tolist() == EXPECTED_COLUMNS\n",
    "assert len(cells) == 61472\n",
    "\n",
    "cells[\"Barcode\"] = cells[\"Barcode\"].astype(str)\n",
    "\n",
    "assert cells[\"Barcode\"].is_unique\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. LOAD H5 METADATA\n",
    "# ============================================================\n",
    "\n",
    "def decode(values):\n",
    "\n",
    "    return [\n",
    "        x.decode(\"utf-8\")\n",
    "        if isinstance(x, bytes)\n",
    "        else str(x)\n",
    "        for x in values\n",
    "    ]\n",
    "\n",
    "\n",
    "with h5py.File(H5_PATH, \"r\") as h5:\n",
    "\n",
    "    matrix = h5[\"matrix\"]\n",
    "\n",
    "    shape = tuple(\n",
    "        int(x)\n",
    "        for x in matrix[\"shape\"][:]\n",
    "    )\n",
    "\n",
    "    n_features = shape[0]\n",
    "    n_h5_cells = shape[1]\n",
    "\n",
    "    h5_barcodes = decode(\n",
    "        matrix[\"barcodes\"][:]\n",
    "    )\n",
    "\n",
    "    features = matrix[\"features\"]\n",
    "\n",
    "    gene_ids = decode(\n",
    "        features[\"id\"][:]\n",
    "    )\n",
    "\n",
    "    gene_symbols = decode(\n",
    "        features[\"name\"][:]\n",
    "    )\n",
    "\n",
    "    if \"feature_type\" in features:\n",
    "\n",
    "        feature_types = decode(\n",
    "            features[\"feature_type\"][:]\n",
    "        )\n",
    "\n",
    "    else:\n",
    "\n",
    "        feature_types = [None] * n_features\n",
    "\n",
    "    n_nonzero = int(\n",
    "        matrix[\"data\"].shape[0]\n",
    "    )\n",
    "\n",
    "\n",
    "assert n_features == 58721\n",
    "assert n_h5_cells == 61770\n",
    "\n",
    "assert len(h5_barcodes) == 61770\n",
    "assert len(set(h5_barcodes)) == 61770\n",
    "\n",
    "\n",
    "print(\"\\nH5 structure:\")\n",
    "print(\"  features:\", f\"{n_features:,}\")\n",
    "print(\"  barcodes:\", f\"{n_h5_cells:,}\")\n",
    "print(\"  nonzero:\", f\"{n_nonzero:,}\")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. EXACT BARCODE RECONCILIATION\n",
    "# ============================================================\n",
    "\n",
    "metadata_set = set(\n",
    "    cells[\"Barcode\"]\n",
    ")\n",
    "\n",
    "h5_set = set(\n",
    "    h5_barcodes\n",
    ")\n",
    "\n",
    "\n",
    "metadata_only = (\n",
    "    metadata_set\n",
    "    -\n",
    "    h5_set\n",
    ")\n",
    "\n",
    "h5_only = (\n",
    "    h5_set\n",
    "    -\n",
    "    metadata_set\n",
    ")\n",
    "\n",
    "shared = (\n",
    "    metadata_set\n",
    "    &\n",
    "    h5_set\n",
    ")\n",
    "\n",
    "\n",
    "assert len(metadata_only) == 0\n",
    "assert len(shared) == 61472\n",
    "assert len(h5_only) == 298\n",
    "\n",
    "\n",
    "print(\"\\nBarcode reconciliation:\")\n",
    "print(\"  annotated/H5 shared:\", f\"{len(shared):,}\")\n",
    "print(\"  metadata-only:\", len(metadata_only))\n",
    "print(\"  H5-only:\", len(h5_only))\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. FREEZE H5 COLUMN INDEX\n",
    "# ============================================================\n",
    "\n",
    "barcode_to_h5_index = {\n",
    "    barcode: i\n",
    "    for i, barcode\n",
    "    in enumerate(h5_barcodes)\n",
    "}\n",
    "\n",
    "\n",
    "cells[\"H5_column_index\"] = (\n",
    "    cells[\"Barcode\"]\n",
    "    .map(barcode_to_h5_index)\n",
    "    .astype(np.int64)\n",
    ")\n",
    "\n",
    "\n",
    "assert cells[\"H5_column_index\"].notna().all()\n",
    "assert cells[\"H5_column_index\"].is_unique\n",
    "\n",
    "\n",
    "metadata_order_matches_H5_subset = bool(\n",
    "    cells[\"H5_column_index\"].is_monotonic_increasing\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"  metadata rows already in H5 subset order:\",\n",
    "    metadata_order_matches_H5_subset\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. H5-ONLY EXCLUSION MANIFEST\n",
    "# ============================================================\n",
    "\n",
    "h5_only_table = pd.DataFrame({\n",
    "    \"barcode\": sorted(\n",
    "        h5_only,\n",
    "        key=lambda x: barcode_to_h5_index[x]\n",
    "    )\n",
    "})\n",
    "\n",
    "\n",
    "h5_only_table[\"H5_column_index\"] = (\n",
    "    h5_only_table[\"barcode\"]\n",
    "    .map(barcode_to_h5_index)\n",
    "    .astype(np.int64)\n",
    ")\n",
    "\n",
    "h5_only_table[\"analysis_status\"] = (\n",
    "    \"EXCLUDED_NO_AUTHOR_METADATA\"\n",
    ")\n",
    "\n",
    "\n",
    "h5_only_table.to_csv(\n",
    "    H5_ONLY_OUTPUT,\n",
    "    index=False,\n",
    "    compression={\n",
    "        \"method\": \"gzip\",\n",
    "        \"compresslevel\": 6,\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "alignment = pd.DataFrame([\n",
    "    {\n",
    "        \"H5_total_barcodes\": 61770,\n",
    "        \"author_annotated_barcodes\": 61472,\n",
    "        \"exact_intersection\": 61472,\n",
    "        \"metadata_only_barcodes\": 0,\n",
    "        \"H5_only_unannotated_barcodes\": 298,\n",
    "        \"analysis_nuclei\": 61472,\n",
    "        \"analysis_population_rule\":\n",
    "            \"author annotated nuclei with exact H5 barcode match\",\n",
    "    }\n",
    "])\n",
    "\n",
    "\n",
    "alignment.to_csv(\n",
    "    ALIGNMENT_OUTPUT,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. FEATURE METADATA\n",
    "# ============================================================\n",
    "\n",
    "feature_meta = pd.DataFrame({\n",
    "    \"gene_id\": gene_ids,\n",
    "    \"gene_symbol\": gene_symbols,\n",
    "    \"feature_type\": feature_types,\n",
    "})\n",
    "\n",
    "\n",
    "assert len(feature_meta) == 58721\n",
    "assert feature_meta[\"gene_id\"].is_unique\n",
    "\n",
    "\n",
    "feature_meta[\"gene_symbol_unique\"] = (\n",
    "    ~feature_meta[\"gene_symbol\"]\n",
    "    .duplicated(keep=False)\n",
    ")\n",
    "\n",
    "\n",
    "feature_meta[\"MT_prefix\"] = (\n",
    "    feature_meta[\"gene_symbol\"]\n",
    "    .astype(str)\n",
    "    .str.upper()\n",
    "    .str.startswith(\"MT-\")\n",
    ")\n",
    "\n",
    "\n",
    "assert int(\n",
    "    feature_meta[\"gene_symbol_unique\"].sum()\n",
    ") == 56917\n",
    "\n",
    "assert int(\n",
    "    (~feature_meta[\"gene_symbol_unique\"]).sum()\n",
    ") == 1804\n",
    "\n",
    "assert int(\n",
    "    feature_meta[\"MT_prefix\"].sum()\n",
    ") == 37\n",
    "\n",
    "\n",
    "feature_meta.to_csv(\n",
    "    FEATURE_OUTPUT,\n",
    "    index=False,\n",
    "    compression={\n",
    "        \"method\": \"gzip\",\n",
    "        \"compresslevel\": 6,\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. EXACT AUTHOR CELL-TYPE MAPPING\n",
    "#\n",
    "# NO HEURISTICS.\n",
    "# ============================================================\n",
    "\n",
    "AUTHOR_CELL_MAP = {\n",
    "    \"ASC\": \"Astro\",\n",
    "    \"MG\": \"Micro\",\n",
    "    \"OPC\": \"OPC\",\n",
    "    \"ODC\": \"Oligo\",\n",
    "    \"EX\": \"Excitatory_neuron\",\n",
    "    \"INH\": \"Inhibitory_neuron\",\n",
    "    \"PER.END\": \"Vascular\",\n",
    "}\n",
    "\n",
    "\n",
    "observed_author_labels = set(\n",
    "    cells[\"Cell.Type\"]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    "    .unique()\n",
    ")\n",
    "\n",
    "\n",
    "expected_author_labels = set(\n",
    "    AUTHOR_CELL_MAP.keys()\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nObserved Cell.Type labels:\",\n",
    "    sorted(observed_author_labels)\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    observed_author_labels\n",
    "    ==\n",
    "    expected_author_labels\n",
    "), (\n",
    "    \"Unexpected author Cell.Type label detected. \"\n",
    "    f\"Observed={sorted(observed_author_labels)}\"\n",
    ")\n",
    "\n",
    "\n",
    "cells[\"author_cell_type\"] = (\n",
    "    cells[\"Cell.Type\"]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "\n",
    "cells[\"canonical_cell_class\"] = (\n",
    "    cells[\"author_cell_type\"]\n",
    "    .map(AUTHOR_CELL_MAP)\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    cells[\"canonical_cell_class\"]\n",
    "    .notna()\n",
    "    .all()\n",
    ")\n",
    "\n",
    "\n",
    "mapping = pd.DataFrame([\n",
    "    {\n",
    "        \"author_cell_type\": key,\n",
    "        \"canonical_cell_class\": value,\n",
    "    }\n",
    "    for key, value\n",
    "    in AUTHOR_CELL_MAP.items()\n",
    "])\n",
    "\n",
    "\n",
    "mapping = (\n",
    "    mapping\n",
    "    .sort_values(\n",
    "        \"canonical_cell_class\"\n",
    "    )\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "\n",
    "mapping.to_csv(\n",
    "    MAPPING_OUTPUT,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "canonical_counts = (\n",
    "    cells[\"canonical_cell_class\"]\n",
    "    .value_counts()\n",
    "    .rename_axis(\"canonical_cell_class\")\n",
    "    .reset_index(name=\"n_nuclei\")\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"CORRECTED AUTHOR → CANONICAL MAPPING\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "display(mapping)\n",
    "\n",
    "\n",
    "print(\"\\nCANONICAL CELL COUNTS\")\n",
    "\n",
    "display(canonical_counts)\n",
    "\n",
    "\n",
    "# Exact expected counts from author labels.\n",
    "EXPECTED_CANONICAL_COUNTS = {\n",
    "    \"Oligo\": 37052,\n",
    "    \"Excitatory_neuron\": 6369,\n",
    "    \"Inhibitory_neuron\": 5962,\n",
    "    \"Astro\": 4756,\n",
    "    \"Micro\": 4126,\n",
    "    \"OPC\": 2740,\n",
    "    \"Vascular\": 467,\n",
    "}\n",
    "\n",
    "\n",
    "observed_counts = (\n",
    "    canonical_counts\n",
    "    .set_index(\"canonical_cell_class\")[\"n_nuclei\"]\n",
    "    .astype(int)\n",
    "    .to_dict()\n",
    ")\n",
    "\n",
    "\n",
    "assert observed_counts == EXPECTED_CANONICAL_COUNTS\n",
    "\n",
    "\n",
    "TARGET_CLASSES = [\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "]\n",
    "\n",
    "\n",
    "assert (\n",
    "    set(TARGET_CLASSES)\n",
    "    <=\n",
    "    set(cells[\"canonical_cell_class\"])\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\nAll four primary homologous classes present: PASS\")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. STANDARDIZE DONOR / DIAGNOSIS\n",
    "# ============================================================\n",
    "\n",
    "cells[\"donor_id\"] = (\n",
    "    cells[\"SampleID\"]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "\n",
    "assert cells[\"donor_id\"].nunique() == 18\n",
    "\n",
    "\n",
    "DIAGNOSIS_MAP = {\n",
    "    \"AD\": \"AD\",\n",
    "    \"Control\": \"Control\",\n",
    "}\n",
    "\n",
    "\n",
    "cells[\"diagnosis_binary\"] = (\n",
    "    cells[\"Diagnosis\"]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    "    .map(DIAGNOSIS_MAP)\n",
    ")\n",
    "\n",
    "\n",
    "assert cells[\"diagnosis_binary\"].notna().all()\n",
    "\n",
    "assert set(\n",
    "    cells[\"diagnosis_binary\"]\n",
    ") == {\n",
    "    \"AD\",\n",
    "    \"Control\",\n",
    "}\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. STANDARDIZE COVARIATES\n",
    "# ============================================================\n",
    "\n",
    "cells[\"age\"] = pd.to_numeric(\n",
    "    cells[\"Age\"],\n",
    "    errors=\"coerce\"\n",
    ")\n",
    "\n",
    "cells[\"PMI\"] = pd.to_numeric(\n",
    "    cells[\"PMI\"],\n",
    "    errors=\"coerce\"\n",
    ")\n",
    "\n",
    "cells[\"RIN\"] = pd.to_numeric(\n",
    "    cells[\"RIN\"],\n",
    "    errors=\"coerce\"\n",
    ")\n",
    "\n",
    "\n",
    "SEX_MAP = {\n",
    "    \"M\": \"Male\",\n",
    "    \"Male\": \"Male\",\n",
    "    \"F\": \"Female\",\n",
    "    \"Female\": \"Female\",\n",
    "}\n",
    "\n",
    "\n",
    "cells[\"sex\"] = (\n",
    "    cells[\"Sex\"]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    "    .map(SEX_MAP)\n",
    ")\n",
    "\n",
    "\n",
    "assert cells[\"age\"].notna().all()\n",
    "assert cells[\"RIN\"].notna().all()\n",
    "assert cells[\"sex\"].notna().all()\n",
    "\n",
    "\n",
    "cells[\"batch\"] = (\n",
    "    cells[\"Batch\"]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "\n",
    "cells[\"tangle_stage\"] = (\n",
    "    cells[\"Tangle.Stage\"]\n",
    ")\n",
    "\n",
    "\n",
    "cells[\"plaque_stage\"] = (\n",
    "    cells[\"Plaque.Stage\"]\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 12. DONOR-LEVEL CONSISTENCY\n",
    "# ============================================================\n",
    "\n",
    "DONOR_VARIABLES = [\n",
    "    \"diagnosis_binary\",\n",
    "    \"age\",\n",
    "    \"sex\",\n",
    "    \"PMI\",\n",
    "    \"RIN\",\n",
    "    \"batch\",\n",
    "    \"tangle_stage\",\n",
    "    \"plaque_stage\",\n",
    "]\n",
    "\n",
    "\n",
    "consistency_rows = []\n",
    "\n",
    "\n",
    "for variable in DONOR_VARIABLES:\n",
    "\n",
    "    within_donor_unique = (\n",
    "        cells\n",
    "        .groupby(\n",
    "            \"donor_id\",\n",
    "            observed=True\n",
    "        )[variable]\n",
    "        .nunique(\n",
    "            dropna=True\n",
    "        )\n",
    "    )\n",
    "\n",
    "    max_unique = int(\n",
    "        within_donor_unique.max()\n",
    "    )\n",
    "\n",
    "    consistency_rows.append({\n",
    "        \"variable\": variable,\n",
    "        \"max_nonnull_values_within_donor\": max_unique,\n",
    "        \"donor_level_consistent\": bool(\n",
    "            max_unique <= 1\n",
    "        ),\n",
    "    })\n",
    "\n",
    "\n",
    "consistency = pd.DataFrame(\n",
    "    consistency_rows\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    consistency[\"donor_level_consistent\"]\n",
    "    .all()\n",
    ")\n",
    "\n",
    "\n",
    "consistency.to_csv(\n",
    "    CONSISTENCY_OUTPUT,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\nDonor-level consistency: PASS\")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 13. BUILD FROZEN DONOR METADATA\n",
    "# ============================================================\n",
    "\n",
    "def first_nonnull(series):\n",
    "\n",
    "    values = series.dropna()\n",
    "\n",
    "    if len(values) == 0:\n",
    "        return np.nan\n",
    "\n",
    "    return values.iloc[0]\n",
    "\n",
    "\n",
    "donor_meta = (\n",
    "    cells\n",
    "    .groupby(\n",
    "        \"donor_id\",\n",
    "        observed=True,\n",
    "        sort=True\n",
    "    )\n",
    "    .agg({\n",
    "        \"diagnosis_binary\": first_nonnull,\n",
    "        \"age\": first_nonnull,\n",
    "        \"sex\": first_nonnull,\n",
    "        \"PMI\": first_nonnull,\n",
    "        \"RIN\": first_nonnull,\n",
    "        \"batch\": first_nonnull,\n",
    "        \"tangle_stage\": first_nonnull,\n",
    "        \"plaque_stage\": first_nonnull,\n",
    "        \"Barcode\": \"size\",\n",
    "    })\n",    "    .rename(\n",
    "        columns={\n",
    "            \"Barcode\": \"n_annotated_nuclei\"\n",
    "        }\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "\n",
    "assert len(donor_meta) == 18\n",
    "assert donor_meta[\"donor_id\"].is_unique\n",
    "\n",
    "\n",
    "diagnosis_counts = (\n",
    "    donor_meta[\"diagnosis_binary\"]\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    ")\n",
    "\n",
    "\n",
    "assert diagnosis_counts == {\n",
    "    \"AD\": 11,\n",
    "    \"Control\": 7,\n",
    "}\n",
    "\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"ACTUAL AUTHOR-METADATA COHORT\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "print(\"Total donors:\", len(donor_meta))\n",
    "print(\"AD:\", diagnosis_counts[\"AD\"])\n",
    "print(\"Control:\", diagnosis_counts[\"Control\"])\n",
    "\n",
    "display(donor_meta)\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 14. COVARIATE MISSINGNESS\n",
    "# ============================================================\n",
    "\n",
    "MISSINGNESS_VARIABLES = [\n",
    "    \"age\",\n",
    "    \"sex\",\n",
    "    \"PMI\",\n",
    "    \"RIN\",\n",
    "    \"batch\",\n",
    "    \"tangle_stage\",\n",
    "    \"plaque_stage\",\n",
    "]\n",
    "\n",
    "\n",
    "missingness = pd.DataFrame({\n",
    "    \"variable\": MISSINGNESS_VARIABLES,\n",
    "    \"missing_donors\": [\n",
    "        int(\n",
    "            donor_meta[variable]\n",
    "            .isna()\n",
    "            .sum()\n",
    "        )\n",
    "        for variable\n",
    "        in MISSINGNESS_VARIABLES\n",
    "    ],\n",
    "})\n",
    "\n",
    "\n",
    "missingness.to_csv(\n",
    "    MISSINGNESS_OUTPUT,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"DONOR COVARIATE MISSINGNESS\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "display(missingness)\n",
    "\n",
    "\n",
    "# Hard checks from current audit.\n",
    "assert int(\n",
    "    donor_meta[\"age\"].isna().sum()\n",
    ") == 0\n",
    "\n",
    "assert int(\n",
    "    donor_meta[\"sex\"].isna().sum()\n",
    ") == 0\n",
    "\n",
    "assert int(\n",
    "    donor_meta[\"PMI\"].isna().sum()\n",
    ") == 1\n",
    "\n",
    "assert int(\n",
    "    donor_meta[\"RIN\"].isna().sum()\n",
    ") == 0\n",
    "\n",
    "assert int(\n",
    "    donor_meta[\"batch\"].isna().sum()\n",
    ") == 0\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 15. DONOR × CELL-CLASS COUNTS\n",
    "# ============================================================\n",
    "\n",
    "donor_cell_counts = (\n",
    "    cells\n",
    "    .groupby(\n",
    "        [\n",
    "            \"donor_id\",\n",
    "            \"diagnosis_binary\",\n",
    "            \"canonical_cell_class\",\n",
    "        ],\n",
    "        observed=True\n",
    "    )\n",
    "    .size()\n",
    "    .reset_index(\n",
    "        name=\"n_nuclei\"\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "donor_cell_counts.to_csv(\n",
    "    DONOR_CELL_OUTPUT,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 16. DISEASE-BLIND TARGET CLASS COVERAGE\n",
    "#\n",
    "# NO threshold is selected yet.\n",
    "# ============================================================\n",
    "\n",
    "donor_base = (\n",
    "    donor_meta[\n",
    "        [\n",
    "            \"donor_id\",\n",
    "            \"diagnosis_binary\",\n",
    "        ]\n",
    "    ]\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "\n",
    "coverage_rows = []\n",
    "\n",
    "\n",
    "for cell_class in TARGET_CLASSES:\n",
    "\n",
    "    class_counts = (\n",
    "        donor_cell_counts[\n",
    "            donor_cell_counts[\n",
    "                \"canonical_cell_class\"\n",
    "            ]\n",
    "            ==\n",
    "            cell_class\n",
    "        ][\n",
    "            [\n",
    "                \"donor_id\",\n",
    "                \"n_nuclei\",\n",
    "            ]\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    complete = donor_base.merge(\n",
    "        class_counts,\n",
    "        on=\"donor_id\",\n",
    "        how=\"left\",\n",
    "        validate=\"one_to_one\"\n",
    "    )\n",
    "\n",
    "\n",
    "    complete[\"n_nuclei\"] = (\n",
    "        complete[\"n_nuclei\"]\n",
    "        .fillna(0)\n",
    "        .astype(int)\n",
    "    )\n",
    "\n",
    "\n",
    "    for threshold in [\n",
    "        1,\n",
    "        20,\n",
    "        50,\n",
    "        100,\n",
    "    ]:\n",
    "\n",
    "        eligible = complete[\n",
    "            complete[\"n_nuclei\"]\n",
    "            >=\n",
    "            threshold\n",
    "        ]\n",
    "\n",
    "\n",
    "        dx_counts = (\n",
    "            eligible[\n",
    "                \"diagnosis_binary\"\n",
    "            ]\n",
    "            .value_counts()\n",
    "            .to_dict()\n",
    "        )\n",
    "\n",
    "\n",
    "        coverage_rows.append({\n",
    "            \"cell_class\": cell_class,\n",
    "            \"min_nuclei\": threshold,\n",
    "\n",
    "            \"AD\":\n",
    "                int(\n",
    "                    dx_counts.get(\n",
    "                        \"AD\",\n",
    "                        0\n",
    "                    )\n",
    "                ),\n",
    "\n",
    "            \"Control\":\n",
    "                int(\n",
    "                    dx_counts.get(\n",
    "                        \"Control\",\n",
    "                        0\n",
    "                    )\n",
    "                ),\n",
    "\n",
    "            \"Total\":\n",
    "                int(\n",
    "                    len(eligible)\n",
    "                ),\n",
    "\n",
    "            \"all_18_donors_min\":\n",
    "                int(\n",
    "                    complete[\n",
    "                        \"n_nuclei\"\n",
    "                    ].min()\n",
    "                ),\n",
    "\n",
    "            \"all_18_donors_median\":\n",
    "                float(\n",
    "                    complete[\n",
    "                        \"n_nuclei\"\n",
    "                    ].median()\n",
    "                ),\n",
    "\n",
    "            \"all_18_donors_max\":\n",
    "                int(\n",
    "                    complete[\n",
    "                        \"n_nuclei\"\n",
    "                    ].max()\n",
    "                ),\n",
    "        })\n",
    "\n",
    "\n",
    "coverage = pd.DataFrame(\n",
    "    coverage_rows\n",
    ")\n",
    "\n",
    "\n",
    "coverage.to_csv(\n",
    "    COVERAGE_OUTPUT,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"TARGET-CELL COVERAGE\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "display(coverage)\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 17. DONOR COVARIATE SUMMARY\n",
    "# ============================================================\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"DONOR COVARIATE SUMMARY\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "\n",
    "for variable in [\n",
    "    \"age\",\n",
    "    \"PMI\",\n",
    "    \"RIN\",\n",
    "]:\n",
    "\n",
    "    print(\n",
    "        f\"\\n{variable} by diagnosis:\"\n",
    "    )\n",
    "\n",
    "    display(\n",
    "        donor_meta\n",
    "        .groupby(\n",
    "            \"diagnosis_binary\"\n",
    "        )[variable]\n",
    "        .agg(\n",
    "            [\n",
    "                \"count\",\n",
    "                \"mean\",\n",
    "                \"std\",\n",
    "                \"min\",\n",
    "                \"max\",\n",
    "            ]\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "print(\"\\nSex × diagnosis:\")\n",
    "\n",
    "display(\n",
    "    pd.crosstab(\n",
    "        donor_meta[\"sex\"],\n",
    "        donor_meta[\"diagnosis_binary\"]\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\nBatch × diagnosis:\")\n",
    "\n",
    "display(\n",
    "    pd.crosstab(\n",
    "        donor_meta[\"batch\"],\n",
    "        donor_meta[\"diagnosis_binary\"]\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 18. SAVE AUDITED CELL + DONOR METADATA\n",
    "# ============================================================\n",
    "\n",
    "cells.to_csv(\n",
    "    CELL_OUTPUT,\n",
    "    index=False,\n",
    "    compression={\n",
    "        \"method\": \"gzip\",\n",
    "        \"compresslevel\": 6,\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "donor_meta.to_csv(\n",
    "    DONOR_OUTPUT,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 19. WRITE FINAL STEP-19 AUDIT LOCK\n",
    "# ============================================================\n",
    "\n",
    "AUDIT_LOCK = {\n",
    "\n",
    "    \"dataset\":\n",
    "        \"GSE174367\",\n",
    "\n",
    "    \"created_utc\":\n",
    "        datetime.now(\n",
    "            timezone.utc\n",
    "        ).isoformat(),\n",
    "\n",
    "    \"status\":\n",
    "        \"AD_DISCOVERY_DATA_AUDIT_COMPLETE\",\n",
    "\n",
    "    \"role\":\n",
    "        \"AD_brain_discovery\",\n",
    "\n",
    "    \"tissue\":\n",
    "        \"human_prefrontal_cortex\",\n",
    "\n",
    "    \"analysis_population\": {\n",
    "\n",
    "        \"H5_total_barcodes\":\n",
    "            61770,\n",
    "\n",
    "        \"author_annotated_nuclei\":\n",
    "            61472,\n",
    "\n",
    "        \"metadata_only_barcodes\":\n",
    "            0,\n",
    "\n",
    "        \"H5_only_unannotated_barcodes\":\n",
    "            298,\n",
    "\n",
    "        \"analysis_nuclei\":\n",
    "            61472,\n",
    "\n",
    "        \"analysis_population_rule\":\n",
    "            (\n",
    "                \"all author-annotated nuclei \"\n",
    "                \"with exact H5 barcode match\"\n",
    "            ),\n",
    "\n",
    "    },\n",
    "\n",
    "    \"source_files\": {\n",
    "\n",
    "        \"cell_metadata\": {\n",
    "            \"path\":\n",
    "                str(CELL_META_PATH),\n",
    "\n",
    "            \"sha256\":\n",
    "                CELL_META_SHA,\n",
    "        },\n",
    "\n",
    "        \"filtered_H5\": {\n",
    "            \"path\":\n",
    "                str(H5_PATH),\n",
    "\n",
    "            \"sha256\":\n",
    "                H5_SHA,\n",
    "        },\n",
    "\n",
    "    },\n",
    "\n",
    "    \"matrix\": {\n",
    "\n",
    "        \"n_features\":\n",
    "            int(n_features),\n",
    "\n",
    "        \"n_H5_barcodes\":\n",
    "            int(n_h5_cells),\n",
    "\n",
    "        \"n_nonzero_entries\":\n",
    "            int(n_nonzero),\n",
    "\n",
    "        \"metadata_order_matches_H5_subset_order\":\n",
    "            metadata_order_matches_H5_subset,\n",
    "\n",
    "        \"H5_column_index_frozen\":\n",
    "            True,\n",
    "\n",
    "    },\n",
    "\n",
    "    \"features\": {\n",
    "\n",
    "        \"feature_metadata\":\n",
    "            str(FEATURE_OUTPUT),\n",
    "\n",
    "        \"n_features\":\n",
    "            58721,\n",
    "\n",
    "        \"gene_IDs_unique\":\n",
    "            True,\n",
    "\n",
    "        \"n_unique_symbol_features\":\n",
    "            56917,\n",
    "\n",
    "        \"n_duplicate_symbol_features\":\n",
    "            1804,\n",
    "\n",
    "        \"n_MT_prefix_features\":\n",
    "            37,\n",
    "\n",
    "    },\n",
    "\n",
    "    \"donor_structure\": {\n",
    "\n",
    "        \"analysis_unit\":\n",
    "            \"SampleID\",\n",
    "\n",
    "        \"n_donors\":\n",
    "            18,\n",
    "\n",
    "        \"n_AD\":\n",
    "            11,\n",
    "\n",
    "        \"n_Control\":\n",
    "            7,\n",
    "\n",
    "        \"cohort_source\":\n",
    "            \"processed_author_cell_metadata\",\n",
    "\n",
    "        \"frozen_donor_metadata\":\n",
    "            str(DONOR_OUTPUT),\n",
    "\n",
    "    },\n",
    "\n",
    "    \"cell_types\": {\n",
    "\n",
    "        \"author_column\":\n",
    "            \"Cell.Type\",\n",
    "\n",
    "        \"mapping_policy\":\n",
    "            \"exact_author_label_dictionary\",\n",
    "\n",
    "        \"exact_mapping\": {\n",
    "            \"ASC\": \"Astro\",\n",
    "            \"MG\": \"Micro\",\n",
    "            \"OPC\": \"OPC\",\n",
    "            \"ODC\": \"Oligo\",\n",
    "            \"EX\": \"Excitatory_neuron\",\n",
    "            \"INH\": \"Inhibitory_neuron\",\n",
    "            \"PER.END\": \"Vascular\",\n",
    "        },\n",
    "\n",
    "        \"primary_homologous_classes\":\n",
    "            TARGET_CLASSES,\n",
    "\n",
    "        \"mapping_file\":\n",
    "            str(MAPPING_OUTPUT),\n",
    "\n",
    "        \"donor_cellclass_counts\":\n",
    "            str(DONOR_CELL_OUTPUT),\n",
    "\n",
    "        \"coverage_file\":\n",
    "            str(COVERAGE_OUTPUT),\n",
    "\n",
    "    },\n",
    "\n",
    "    \"covariates\": {\n",
    "\n",
    "        \"Age\": {\n",
    "            \"available\": True,\n",
    "            \"missing_donors\": 0,\n",
    "        },\n",
    "\n",
    "        \"Sex\": {\n",
    "            \"available\": True,\n",
    "            \"missing_donors\": 0,\n",
    "        },\n",
    "\n",
    "        \"PMI\": {\n",
    "            \"available\": True,\n",
    "            \"missing_donors\": 1,\n",
    "        },\n",
    "\n",
    "        \"RIN\": {\n",
    "            \"available\": True,\n",
    "            \"missing_donors\": 0,\n",
    "        },\n",
    "\n",
    "        \"Batch\": {\n",
    "            \"available\": True,\n",
    "            \"missing_donors\": 0,\n",
    "        },\n",
    "\n",
    "        \"Tangle.Stage\": {\n",
    "            \"available\": True,\n",
    "            \"role\":\n",
    "                \"pathology_descriptive_or_within_AD_only\",\n",
    "        },\n",
    "\n",
    "        \"Plaque.Stage\": {\n",
    "            \"available\": True,\n",
    "            \"role\":\n",
    "                \"pathology_descriptive_or_within_AD_only\",\n",
    "        },\n",
    "\n",
    "    },\n",
    "\n",
    "    \"pathology_policy\":\n",
    "        (\n",
    "            \"Tangle.Stage and Plaque.Stage are \"\n",
    "            \"not case-control adjustment covariates.\"\n",
    "        ),\n",
    "\n",
    "    \"excluded_H5_only_barcodes\":\n",
    "        str(H5_ONLY_OUTPUT),\n",
    "\n",
    "    \"barcode_alignment_manifest\":\n",
    "        str(ALIGNMENT_OUTPUT),\n",
    "\n",
    "    \"donor_covariate_missingness\":\n",
    "        str(MISSINGNESS_OUTPUT),\n",
    "\n",
    "    \"donor_metadata_consistency\":\n",
    "        str(CONSISTENCY_OUTPUT),\n",
    "\n",
    "    \"differential_expression_performed\":\n",
    "        False,\n",
    "\n",
    "    \"disease_gene_results_inspected\":\n",
    "        False,\n",
    "\n",
    "    \"gene_filter_selected\":\n",
    "        False,\n",
    "\n",
    "    \"DE_model_selected\":\n",
    "        False,\n",
    "\n",
    "    \"AD_PD_convergence_performed\":\n",
    "        False,\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    AUDIT_LOCK_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        AUDIT_LOCK,\n",
    "        f,\n",
    "        indent=2\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 20. FINAL HARD ASSERTIONS\n",
    "# ============================================================\n",
    "\n",
    "assert len(cells) == 61472\n",
    "\n",
    "assert len(donor_meta) == 18\n",
    "\n",
    "assert diagnosis_counts == {\n",
    "    \"AD\": 11,\n",
    "    \"Control\": 7,\n",
    "}\n",
    "\n",
    "assert len(h5_only) == 298\n",
    "\n",
    "assert len(metadata_only) == 0\n",
    "\n",
    "assert observed_counts[\"Astro\"] == 4756\n",
    "assert observed_counts[\"Micro\"] == 4126\n",
    "assert observed_counts[\"OPC\"] == 2740\n",
    "assert observed_counts[\"Oligo\"] == 37052\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 21. FINAL REPORT\n",
    "# ============================================================\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "\n",
    "print(\n",
    "    \"STEP 19D PASSED — \"\n",
    "    \"GSE174367 AD DISCOVERY DATA AUDITED\"\n",
    ")\n",
    "\n",
    "print(\"=\" * 80)\n",
    "\n",
    "\n",
    "print(\"\\nANALYSIS POPULATION\")\n",
    "\n",
    "print(\n",
    "    \"H5 barcodes:\",\n",
    "    f\"{n_h5_cells:,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Author-annotated nuclei:\",\n",
    "    f\"{len(cells):,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"H5-only exclusions:\",\n",
    "    len(h5_only)\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Metadata-only:\",\n",
    "    len(metadata_only)\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\nACTUAL COHORT\")\n",
    "\n",
    "print(\n",
    "    \"Total donors:\",\n",
    "    len(donor_meta)\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"AD:\",\n",
    "    diagnosis_counts[\"AD\"]\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Control:\",\n",
    "    diagnosis_counts[\"Control\"]\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\nCANONICAL CELL COUNTS\")\n",
    "\n",
    "display(\n",
    "    canonical_counts\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\nTARGET-CELL COVERAGE\")\n",
    "\n",
    "display(\n",
    "    coverage\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\nDONOR COVARIATE MISSINGNESS\")\n",
    "\n",
    "display(\n",
    "    missingness\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\nAudit lock:\")\n",
    "print(\n",
    "    AUDIT_LOCK_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nDIFFERENTIAL EXPRESSION PERFORMED: NO\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"DISEASE GENE RESULTS INSPECTED: NO\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"GENE FILTER SELECTED: NO\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"DE MODEL SELECTED: NO\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"AD↔PD CONVERGENCE PERFORMED: NO\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\nNEXT:\")\n",
    "\n",
    "print(\n",
    "    \"STEP 20 — use disease-blind class coverage and \"\n",
    "    \"donor covariates to freeze the AD discovery \"\n",
    "    \"threshold/model/filter and build raw donor pseudobulk.\"\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 38\n",
    "# ============================================================\n",
    "# STEP 20 — GSE174367 AD DISCOVERY PSEUDOBULK\n",
    "#           + GENE UNIVERSES\n",
    "#           + FINAL PRE-DE LOCK\n",
    "#\n",
    "# NO DIFFERENTIAL EXPRESSION.\n",
    "# NO AD↔PD CONVERGENCE.\n",
    "#\n",
    "# FROZEN PRIMARY ANALYSIS\n",
    "# -----------------------\n",
    "# Biological replicate:\n",
    "#     donor\n",
    "#\n",
    "# Primary cell classes:\n",
    "#     Astro\n",
    "#     Micro\n",
    "#     OPC\n",
    "#     Oligo\n",
    "#\n",
    "# Minimum nuclei / donor / class:\n",
    "#     >=50\n",
    "#\n",
    "# All 18 donors survive in all four classes.\n",
    "#\n",
    "# Primary model:\n",
    "#     ~ age + sex + batch + diagnosis_binary\n",
    "#\n",
    "# Technical sensitivity 1:\n",
    "#     ~ age + sex + batch + RIN + diagnosis_binary\n",
    "#     all 18 donors\n",
    "#\n",
    "# Technical sensitivity 2:\n",
    "#     ~ age + sex + batch + PMI + diagnosis_binary\n",
    "#     complete-case donors only\n",
    "#     expected 17 donors = 11 AD + 6 Control\n",
    "#\n",
    "# No age-overlap sensitivity:\n",
    "#     overlap restriction would retain only 3 controls.\n",
    "#\n",
    "# Gene filtering per cell class:\n",
    "#     CPM >= 1 in >=7 of 18 donors\n",
    "#\n",
    "# where 7 = smaller diagnosis group.\n",
    "#\n",
    "# Filtering is disease-blind.\n",
    "#\n",
    "# MT- genes removed AFTER expression filtering.\n",
    "#\n",
    "# Ensembl gene IDs remain the DE feature identifier.\n",
    "# Gene symbols are annotation only.\n",
    "#\n",
    "# Duplicate gene symbols are NOT collapsed.\n",
    "# Later cross-dataset matching will use unambiguous symbols.\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import h5py\n",
    "\n",
    "import hashlib\n",
    "import json\n",
    "import gc\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = ROOT / \"locks\"\n",
    "MANIFESTS = ROOT / \"manifests\"\n",
    "\n",
    "AD_DIR = (\n",
    "    ROOT /\n",
    "    \"GSE174367_AD_discovery\"\n",
    ")\n",
    "\n",
    "DOWNLOAD_DIR = (\n",
    "    AD_DIR /\n",
    "    \"downloads\"\n",
    ")\n",
    "\n",
    "UNIVERSES = (\n",
    "    ROOT /\n",
    "    \"GSE174367_gene_universes\"\n",
    ")\n",
    "\n",
    "RESULTS = (\n",
    "    ROOT /\n",
    "    \"results\"\n",
    ")\n",
    "\n",
    "\n",
    "for directory in [\n",
    "\n",
    "    LOCKS,\n",
    "    MANIFESTS,\n",
    "    UNIVERSES,\n",
    "    RESULTS,\n",
    "\n",
    "]:\n",
    "\n",
    "    directory.mkdir(\n",
    "        parents=True,\n",
    "        exist_ok=True\n",
    "    )\n",
    "\n",
    "\n",
    "AUDIT_LOCK_PATH = (\n",
    "    LOCKS /\n",
    "    \"GSE174367_AD_DISCOVERY_DATA_AUDIT_v1.json\"\n",
    ")\n",
    "\n",
    "ROLE_LOCK_PATH = (\n",
    "    LOCKS /\n",
    "    \"AD_BRAIN_DATASET_ROLES_v1.json\"\n",
    ")\n",
    "\n",
    "CELL_META_PATH = (\n",
    "    MANIFESTS /\n",
    "    \"GSE174367_author_cell_metadata_AUDITED_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "DONOR_META_PATH = (\n",
    "    MANIFESTS /\n",
    "    \"GSE174367_donor_metadata_FROZEN_v1.csv\"\n",
    ")\n",
    "\n",
    "FEATURE_META_PATH = (\n",
    "    MANIFESTS /\n",
    "    \"GSE174367_H5_feature_metadata_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "H5_PATH = (\n",
    "    DOWNLOAD_DIR /\n",
    "    \"GSE174367_snRNA-seq_filtered_feature_bc_matrix.h5\"\n",
    ")\n",
    "\n",
    "\n",
    "PSEUDOBULK_PATH = (\n",
    "    RESULTS /\n",
    "    \"GSE174367_donor_celltype_pseudobulk_RAW_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "GROUP_META_PATH = (\n",
    "    MANIFESTS /\n",
    "    \"GSE174367_pseudobulk_group_metadata_v1.csv\"\n",
    ")\n",
    "\n",
    "DESIGN_META_PATH = (\n",
    "    MANIFESTS /\n",
    "    \"GSE174367_AD_discovery_design_metadata_v1.csv\"\n",
    ")\n",
    "\n",
    "PSEUDOBULK_LOCK_PATH = (\n",
    "    LOCKS /\n",
    "    \"GSE174367_AD_DISCOVERY_PSEUDOBULK_BUILD_v1.json\"\n",
    ")\n",
    "\n",
    "PRE_DE_LOCK_PATH = (\n",
    "    LOCKS /\n",
    "    \"GSE174367_AD_DISCOVERY_PRE_DE_LOCK_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "\n",
    "    AUDIT_LOCK_PATH,\n",
    "    ROLE_LOCK_PATH,\n",
    "    CELL_META_PATH,\n",
    "    DONOR_META_PATH,\n",
    "    FEATURE_META_PATH,\n",
    "    H5_PATH,\n",
    "\n",
    "]:\n",
    "\n",
    "    assert path.exists(), (\n",
    "        f\"Missing required input: {path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. VERIFY UPSTREAM LOCKS\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    AUDIT_LOCK_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    audit_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    ROLE_LOCK_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    role_lock = json.load(f)\n",
    "\n",
    "\n",
    "assert (\n",
    "    audit_lock[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"AD_DISCOVERY_DATA_AUDIT_COMPLETE\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    audit_lock[\n",
    "        \"differential_expression_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    audit_lock[\n",
    "        \"disease_gene_results_inspected\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    audit_lock[\n",
    "        \"AD_PD_convergence_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    role_lock[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"AD_DATASET_ROLES_FROZEN_BEFORE_DISEASE_EXPRESSION\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    role_lock[\n",
    "        \"primary_discovery\"\n",
    "    ][\n",
    "        \"dataset\"\n",
    "    ]\n",
    "    ==\n",
    "    \"GSE174367\"\n",
    ")\n",    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"UPSTREAM AD DISCOVERY LOCKS VERIFIED\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. LOAD AUDITED METADATA\n",
    "# ============================================================\n",
    "\n",
    "cells = pd.read_csv(\n",
    "    CELL_META_PATH,\n",
    "    compression=\"gzip\",\n",
    "    low_memory=False\n",
    ")\n",
    "\n",
    "\n",
    "donors = pd.read_csv(\n",
    "    DONOR_META_PATH\n",
    ")\n",
    "\n",
    "\n",
    "feature_meta = pd.read_csv(\n",
    "    FEATURE_META_PATH,\n",
    "    compression=\"gzip\",\n",
    "    low_memory=False\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    cells\n",
    ") == 61472\n",
    "\n",
    "\n",
    "assert len(\n",
    "    donors\n",
    ") == 18\n",
    "\n",
    "\n",
    "assert len(\n",
    "    feature_meta\n",
    ") == 58721\n",
    "\n",
    "\n",
    "assert (\n",
    "    cells[\n",
    "        \"Barcode\"\n",
    "    ]\n",
    "    .is_unique\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    cells[\n",
    "        \"H5_column_index\"\n",
    "    ]\n",
    "    .is_unique\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    feature_meta[\n",
    "        \"gene_id\"\n",
    "    ]\n",
    "    .is_unique\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    donors[\n",
    "        \"diagnosis_binary\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    "    ==\n",
    "    {\n",
    "        \"AD\": 11,\n",
    "        \"Control\": 7,\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. FREEZE PRIMARY CELL THRESHOLD\n",
    "# ============================================================\n",
    "\n",
    "TARGET_CLASSES = [\n",
    "\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "MIN_NUCLEI_PER_DONOR = 50\n",
    "\n",
    "\n",
    "donor_cell_counts = (\n",
    "\n",
    "    cells\n",
    "    .groupby(\n",
    "        [\n",
    "            \"donor_id\",\n",
    "            \"diagnosis_binary\",\n",
    "            \"canonical_cell_class\",\n",
    "        ],\n",
    "        observed=True\n",
    "    )\n",
    "    .size()\n",
    "    .reset_index(\n",
    "        name=\"n_nuclei\"\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "coverage_check_rows = []\n",
    "\n",
    "\n",
    "for cell_type in TARGET_CLASSES:\n",
    "\n",
    "\n",
    "    class_counts = (\n",
    "\n",
    "        donor_cell_counts[\n",
    "            donor_cell_counts[\n",
    "                \"canonical_cell_class\"\n",
    "            ]\n",
    "            ==\n",
    "            cell_type\n",
    "        ]\n",
    "        [\n",
    "            [\n",
    "                \"donor_id\",\n",
    "                \"n_nuclei\",\n",
    "            ]\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    complete = (\n",
    "\n",
    "        donors[\n",
    "            [\n",
    "                \"donor_id\",\n",
    "                \"diagnosis_binary\",\n",
    "            ]\n",
    "        ]\n",
    "        .merge(\n",
    "            class_counts,\n",
    "            on=\"donor_id\",\n",
    "            how=\"left\",\n",
    "            validate=\"one_to_one\"\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    complete[\n",
    "        \"n_nuclei\"\n",
    "    ] = (\n",
    "\n",
    "        complete[\n",
    "            \"n_nuclei\"\n",
    "        ]\n",
    "        .fillna(\n",
    "            0\n",
    "        )\n",
    "        .astype(\n",
    "            int\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    eligible = (\n",
    "\n",
    "        complete[\n",
    "            complete[\n",
    "                \"n_nuclei\"\n",
    "            ]\n",
    "            >=\n",
    "            MIN_NUCLEI_PER_DONOR\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    dx = (\n",
    "\n",
    "        eligible[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        .value_counts()\n",
    "        .to_dict()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    coverage_check_rows.append({\n",
    "\n",
    "        \"cell_type\":\n",
    "            cell_type,\n",
    "\n",
    "        \"min_nuclei\":\n",
    "            int(\n",
    "                complete[\n",
    "                    \"n_nuclei\"\n",
    "                ].min()\n",
    "            ),\n",
    "\n",
    "        \"AD\":\n",
    "            int(\n",
    "                dx.get(\n",
    "                    \"AD\",\n",
    "                    0\n",
    "                )\n",
    "            ),\n",
    "\n",
    "        \"Control\":\n",
    "            int(\n",
    "                dx.get(\n",
    "                    \"Control\",\n",
    "                    0\n",
    "                )\n",
    "            ),\n",
    "\n",
    "        \"Total\":\n",
    "            int(\n",
    "                len(\n",
    "                    eligible\n",
    "                )\n",
    "            ),\n",
    "    })\n",
    "\n",
    "\n",
    "coverage_check = pd.DataFrame(\n",
    "    coverage_check_rows\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFrozen >=50 nuclei coverage:\"\n",
    ")\n",
    "\n",
    "display(\n",
    "    coverage_check\n",
    ")\n",
    "\n",
    "\n",
    "for cell_type in TARGET_CLASSES:\n",
    "\n",
    "    row = (\n",
    "\n",
    "        coverage_check[\n",
    "            coverage_check[\n",
    "                \"cell_type\"\n",
    "            ]\n",
    "            ==\n",
    "            cell_type\n",
    "        ]\n",
    "        .iloc[\n",
    "            0\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        row[\n",
    "            \"AD\"\n",
    "        ]\n",
    "    ) == 11\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        row[\n",
    "            \"Control\"\n",
    "        ]\n",
    "    ) == 7\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        row[\n",
    "            \"Total\"\n",
    "        ]\n",
    "    ) == 18\n",
    "\n",
    "\n",
    "print(\n",
    "    \"All four target classes retain all 18 donors: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. VERIFY FEATURE TYPES\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\nFeature-type counts:\"\n",
    ")\n",
    "\n",
    "display(\n",
    "\n",
    "    feature_meta[\n",
    "        \"feature_type\"\n",
    "    ]\n",
    "    .value_counts(\n",
    "        dropna=False\n",
    "    )\n",
    "    .rename_axis(\n",
    "        \"feature_type\"\n",
    "    )\n",
    "    .reset_index(\n",
    "        name=\"n_features\"\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "GEX_MASK = (\n",
    "\n",
    "    feature_meta[\n",
    "        \"feature_type\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .eq(\n",
    "        \"Gene Expression\"\n",
    "    )\n",
    "    .to_numpy(\n",
    "        dtype=bool\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "N_GEX = int(\n",
    "    GEX_MASK.sum()\n",
    ")\n",
    "\n",
    "\n",
    "assert N_GEX > 0\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Gene Expression features:\",\n",
    "    f\"{N_GEX:,}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. TARGET ANALYSIS CELLS\n",
    "# ============================================================\n",
    "\n",
    "target_cells = (\n",
    "\n",
    "    cells[\n",
    "        cells[\n",
    "            \"canonical_cell_class\"\n",
    "        ]\n",
    "        .isin(\n",
    "            TARGET_CLASSES\n",
    "        )\n",
    "    ]\n",
    "    .copy()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "EXPECTED_TARGET_COUNTS = {\n",
    "\n",
    "    \"Astro\":\n",
    "        4756,\n",
    "\n",
    "    \"Micro\":\n",
    "        4126,\n",
    "\n",
    "    \"OPC\":\n",
    "        2740,\n",
    "\n",
    "    \"Oligo\":\n",
    "        37052,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "observed_target_counts = (\n",
    "\n",
    "    target_cells[\n",
    "        \"canonical_cell_class\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    observed_target_counts\n",
    "    ==\n",
    "    EXPECTED_TARGET_COUNTS\n",
    ")\n",
    "\n",
    "\n",
    "N_TARGET_CELLS = int(\n",
    "    len(\n",
    "        target_cells\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    N_TARGET_CELLS\n",
    "    ==\n",
    "    48674\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nTarget analysis nuclei:\",\n",
    "    f\"{N_TARGET_CELLS:,}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. BUILD EXACT 72-GROUP METADATA\n",
    "#\n",
    "# 18 donors × 4 classes\n",
    "# ============================================================\n",
    "\n",
    "donor_order = (\n",
    "\n",
    "    donors[\n",
    "        \"donor_id\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .tolist()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    donor_order\n",
    ") == 18\n",
    "\n",
    "\n",
    "group_rows = []\n",
    "\n",
    "\n",
    "for cell_type in TARGET_CLASSES:\n",
    "\n",
    "    for donor_id in donor_order:\n",
    "\n",
    "\n",
    "        donor_row = (\n",
    "\n",
    "            donors[\n",
    "                donors[\n",
    "                    \"donor_id\"\n",
    "                ]\n",
    "                .astype(str)\n",
    "                ==\n",
    "                donor_id\n",
    "            ]\n",
    "            .iloc[\n",
    "                0\n",
    "            ]\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        n_nuclei = int(\n",
    "\n",
    "            (\n",
    "                (\n",
    "                    target_cells[\n",
    "                        \"donor_id\"\n",
    "                    ]\n",
    "                    .astype(str)\n",
    "                    ==\n",
    "                    donor_id\n",
    "                )\n",
    "                &\n",
    "                (\n",
    "                    target_cells[\n",
    "                        \"canonical_cell_class\"\n",
    "                    ]\n",
    "                    ==\n",
    "                    cell_type\n",
    "                )\n",
    "            ).sum()\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        assert (\n",
    "            n_nuclei\n",
    "            >=\n",
    "            MIN_NUCLEI_PER_DONOR\n",
    "        )\n",
    "\n",
    "\n",
    "        group_rows.append({\n",
    "\n",
    "            \"pseudobulk_group\":\n",
    "                (\n",
    "                    f\"{donor_id}\"\n",
    "                    f\"__\"\n",
    "                    f\"{cell_type}\"\n",
    "                ),\n",
    "\n",
    "            \"donor_id\":\n",
    "                donor_id,\n",
    "\n",
    "            \"diagnosis_binary\":\n",
    "                donor_row[\n",
    "                    \"diagnosis_binary\"\n",
    "                ],\n",
    "\n",
    "            \"age\":\n",
    "                float(\n",
    "                    donor_row[\n",
    "                        \"age\"\n",
    "                    ]\n",
    "                ),\n",
    "\n",
    "            \"sex\":\n",
    "                donor_row[\n",
    "                    \"sex\"\n",
    "                ],\n",
    "\n",
    "            \"batch\":\n",
    "                str(\n",
    "                    donor_row[\n",
    "                        \"batch\"\n",
    "                    ]\n",
    "                ),\n",
    "\n",
    "            \"PMI\":\n",
    "                (\n",
    "                    float(\n",
    "                        donor_row[\n",
    "                            \"PMI\"\n",
    "                        ]\n",
    "                    )\n",
    "                    if pd.notna(\n",
    "                        donor_row[\n",
    "                            \"PMI\"\n",
    "                        ]\n",
    "                    )\n",
    "                    else np.nan\n",
    "                ),\n",
    "\n",
    "            \"RIN\":\n",
    "                float(\n",
    "                    donor_row[\n",
    "                        \"RIN\"\n",
    "                    ]\n",
    "                ),\n",
    "\n",
    "            \"canonical_cell_class\":\n",
    "                cell_type,\n",
    "\n",
    "            \"n_nuclei\":\n",
    "                n_nuclei,\n",
    "        })\n",
    "\n",
    "\n",
    "group_meta = pd.DataFrame(\n",
    "    group_rows\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    group_meta\n",
    ") == 72\n",
    "\n",
    "\n",
    "assert (\n",
    "    group_meta[\n",
    "        \"pseudobulk_group\"\n",
    "    ]\n",
    "    .is_unique\n",
    ")\n",
    "\n",
    "\n",
    "for cell_type in TARGET_CLASSES:\n",
    "\n",
    "    check = (\n",
    "\n",
    "        group_meta[\n",
    "            group_meta[\n",
    "                \"canonical_cell_class\"\n",
    "            ]\n",
    "            ==\n",
    "            cell_type\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        check\n",
    "    ) == 18\n",
    "\n",
    "\n",
    "    assert (\n",
    "        check[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        .value_counts()\n",
    "        .to_dict()\n",
    "        ==\n",
    "        {\n",
    "            \"AD\": 11,\n",
    "            \"Control\": 7,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "group_meta.to_csv(\n",
    "    GROUP_META_PATH,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. ASSIGN TARGET CELLS TO PSEUDOBULK GROUPS\n",
    "# ============================================================\n",
    "\n",
    "group_to_code = {\n",
    "\n",
    "    group:\n",
    "        index\n",
    "\n",
    "    for index, group\n",
    "    in enumerate(\n",
    "        group_meta[\n",
    "            \"pseudobulk_group\"\n",
    "        ].tolist()\n",
    "    )\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "target_cells[\n",
    "    \"pseudobulk_group\"\n",
    "] = (\n",
    "\n",
    "    target_cells[\n",
    "        \"donor_id\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "\n",
    "    +\n",
    "\n",
    "    \"__\"\n",
    "\n",
    "    +\n",
    "\n",
    "    target_cells[\n",
    "        \"canonical_cell_class\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "target_cells[\n",
    "    \"group_code\"\n",
    "] = (\n",
    "\n",
    "    target_cells[\n",
    "        \"pseudobulk_group\"\n",
    "    ]\n",
    "    .map(\n",
    "        group_to_code\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    target_cells[\n",
    "        \"group_code\"\n",
    "    ]\n",
    "    .notna()\n",
    "    .all()\n",
    ")\n",
    "\n",
    "\n",
    "target_cells[\n",
    "    \"group_code\"\n",
    "] = (\n",
    "\n",
    "    target_cells[\n",
    "        \"group_code\"\n",
    "    ]\n",
    "    .astype(\n",
    "        np.int16\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "N_GROUPS = int(\n",
    "    len(\n",
    "        group_meta\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "observed_nuclei_by_group = np.bincount(\n",
    "\n",
    "    target_cells[\n",
    "        \"group_code\"\n",
    "    ]\n",
    "    .to_numpy(\n",
    "        dtype=np.int64\n",
    "    ),\n",
    "\n",
    "    minlength=N_GROUPS\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "expected_nuclei_by_group = (\n",
    "\n",
    "    group_meta[\n",
    "        \"n_nuclei\"\n",
    "    ]\n",
    "    .to_numpy(\n",
    "        dtype=np.int64\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert np.array_equal(\n",
    "\n",
    "    observed_nuclei_by_group,\n",
    "\n",
    "    expected_nuclei_by_group\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. BUILD H5-COLUMN → GROUP-CODE VECTOR\n",
    "# ============================================================\n",
    "\n",
    "N_H5_CELLS = 61770\n",
    "N_FEATURES = 58721\n",
    "\n",
    "\n",
    "group_code_by_h5_column = np.full(\n",
    "\n",
    "    N_H5_CELLS,\n",
    "\n",
    "    -1,\n",
    "\n",
    "    dtype=np.int16\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "h5_indices = (\n",
    "\n",
    "    target_cells[\n",
    "        \"H5_column_index\"\n",
    "    ]\n",
    "    .to_numpy(\n",
    "        dtype=np.int64\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "target_group_codes = (\n",
    "\n",
    "    target_cells[\n",
    "        \"group_code\"\n",
    "    ]\n",
    "    .to_numpy(\n",
    "        dtype=np.int16\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    h5_indices\n",
    ") == N_TARGET_CELLS\n",
    "\n",
    "\n",
    "assert len(\n",
    "    np.unique(\n",
    "        h5_indices\n",
    "    )\n",
    ") == N_TARGET_CELLS\n",
    "\n",
    "\n",
    "group_code_by_h5_column[\n",
    "    h5_indices\n",
    "] = target_group_codes\n",
    "\n",
    "\n",
    "assert int(\n",
    "\n",
    "    (\n",
    "        group_code_by_h5_column\n",
    "        >=\n",
    "        0\n",
    "    ).sum()\n",
    "\n",
    ") == N_TARGET_CELLS\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. STREAM H5 → RAW DONOR PSEUDOBULK\n",
    "#\n",
    "# H5 is CSC:\n",
    "#\n",
    "#   features × cells\n",
    "#\n",
    "# We process contiguous cell-column blocks and aggregate\n",
    "# non-zero counts directly into feature × group pseudobulk.\n",
    "#\n",
    "# No dense single-cell matrix is created.\n",
    "# ============================================================\n",
    "\n",
    "pseudobulk = np.zeros(\n",
    "\n",
    "    (\n",
    "        N_FEATURES,\n",
    "        N_GROUPS\n",
    "    ),\n",
    "\n",
    "    dtype=np.int64\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "BLOCK_COLUMNS = 512\n",
    "\n",
    "\n",
    "total_target_input_UMIs = 0\n",
    "total_pseudobulk_output_UMIs = 0\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STREAMING OFFICIAL H5 → DONOR PSEUDOBULK\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "with h5py.File(\n",
    "    H5_PATH,\n",
    "    \"r\"\n",
    ") as h5:\n",
    "\n",
    "\n",
    "    matrix = h5[\n",
    "        \"matrix\"\n",
    "    ]\n",
    "\n",
    "\n",
    "    data_ds = matrix[\n",
    "        \"data\"\n",
    "    ]\n",
    "\n",
    "\n",
    "    indices_ds = matrix[\n",
    "        \"indices\"\n",
    "    ]\n",
    "\n",
    "\n",
    "    indptr = (\n",
    "\n",
    "        matrix[\n",
    "            \"indptr\"\n",
    "        ][:]\n",
    "        .astype(\n",
    "            np.int64\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        indptr\n",
    "    ) == (\n",
    "        N_H5_CELLS\n",
    "        +\n",
    "        1\n",
    "    )\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        indptr[\n",
    "            -1\n",
    "        ]\n",
    "    ) == int(\n",
    "        data_ds.shape[\n",
    "            0\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    for col_start in range(\n",
    "        0,\n",
    "        N_H5_CELLS,\n",
    "        BLOCK_COLUMNS\n",
    "    ):\n",
    "\n",
    "\n",
    "        col_end = min(\n",
    "            col_start\n",
    "            +\n",
    "            BLOCK_COLUMNS,\n",
    "            N_H5_CELLS\n",
    "        )\n",
    "\n",
    "\n",
    "        block_group_codes = (\n",
    "\n",
    "            group_code_by_h5_column[\n",
    "                col_start:\n",
    "                col_end\n",
    "            ]\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        # Skip blocks containing no target cells.\n",
    "        if not np.any(\n",
    "            block_group_codes\n",
    "            >=\n",
    "            0\n",
    "        ):\n",
    "\n",
    "            continue\n",
    "\n",
    "\n",
    "        data_start = int(\n",
    "            indptr[\n",
    "                col_start\n",
    "            ]\n",
    "        )\n",
    "\n",
    "\n",
    "        data_end = int(\n",
    "            indptr[\n",
    "                col_end\n",
    "            ]\n",
    "        )\n",
    "\n",
    "\n",
    "        if (\n",
    "            data_end\n",
    "            ==\n",
    "            data_start\n",
    "        ):\n",
    "\n",
    "            continue\n",
    "\n",
    "\n",
    "        feature_indices = (\n",
    "\n",
    "            indices_ds[\n",
    "                data_start:\n",
    "                data_end\n",
    "            ]\n",
    "            .astype(\n",
    "                np.int64,\n",
    "                copy=False\n",
    "            )\n",
    "\n",
    "        )\n",    "\n",
    "\n",
    "        values = (\n",
    "\n",
    "            data_ds[\n",
    "                data_start:\n",
    "                data_end\n",
    "            ]\n",
    "            .astype(\n",
    "                np.int64,\n",
    "                copy=False\n",
    "            )\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        assert (\n",
    "            values\n",
    "            >=\n",
    "            0\n",
    "        ).all()\n",
    "\n",
    "\n",
    "        nnz_per_column = np.diff(\n",
    "\n",
    "            indptr[\n",
    "                col_start:\n",
    "                col_end\n",
    "                +\n",
    "                1\n",
    "            ]\n",
    "\n",
    "        ).astype(\n",
    "            np.int64\n",
    "        )\n",
    "\n",
    "\n",
    "        expanded_group_codes = np.repeat(\n",
    "\n",
    "            block_group_codes,\n",
    "\n",
    "            nnz_per_column\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        assert len(\n",
    "            expanded_group_codes\n",
    "        ) == len(\n",
    "            values\n",
    "        )\n",
    "\n",
    "\n",
    "        keep = (\n",
    "\n",
    "            expanded_group_codes\n",
    "            >=\n",
    "            0\n",
    "        )\n",
    "\n",
    "\n",
    "        if not np.any(\n",
    "            keep\n",
    "        ):\n",
    "\n",
    "            continue\n",
    "\n",
    "\n",
    "        kept_features = (\n",
    "\n",
    "            feature_indices[\n",
    "                keep\n",
    "            ]\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        kept_values = (\n",
    "\n",
    "            values[\n",
    "                keep\n",
    "            ]\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        kept_groups = (\n",
    "\n",
    "            expanded_group_codes[\n",
    "                keep\n",
    "            ]\n",
    "            .astype(\n",
    "                np.int64,\n",
    "                copy=False\n",
    "            )\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        # ----------------------------------------------------\n",
    "        # Encode feature × group into one integer index.\n",
    "        # ----------------------------------------------------\n",
    "\n",
    "        flat_indices = (\n",
    "\n",
    "            kept_features\n",
    "            *\n",
    "            N_GROUPS\n",
    "\n",
    "            +\n",
    "\n",
    "            kept_groups\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        block_sum_float = np.bincount(\n",
    "\n",
    "            flat_indices,\n",
    "\n",
    "            weights=\n",
    "                kept_values.astype(\n",
    "                    np.float64,\n",
    "                    copy=False\n",
    "                ),\n",
    "\n",
    "            minlength=\n",
    "                N_FEATURES\n",
    "                *\n",
    "                N_GROUPS\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        # Counts are integer and far below float64 exactness limit.\n",
    "        assert np.all(\n",
    "\n",
    "            block_sum_float\n",
    "            ==\n",
    "            np.floor(\n",
    "                block_sum_float\n",
    "            )\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        block_sum = (\n",
    "\n",
    "            block_sum_float\n",
    "            .reshape(\n",
    "                N_FEATURES,\n",
    "                N_GROUPS\n",
    "            )\n",
    "            .astype(\n",
    "                np.int64\n",
    "            )\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        block_input = int(\n",
    "\n",
    "            kept_values.sum(\n",
    "                dtype=np.int64\n",
    "            )\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        block_output = int(\n",
    "\n",
    "            block_sum.sum(\n",
    "                dtype=np.int64\n",
    "            )\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        assert (\n",
    "            block_input\n",
    "            ==\n",
    "            block_output\n",
    "        )\n",
    "\n",
    "\n",
    "        pseudobulk += block_sum\n",
    "\n",
    "\n",
    "        total_target_input_UMIs += (\n",
    "            block_input\n",
    "        )\n",
    "\n",
    "\n",
    "        total_pseudobulk_output_UMIs += (\n",
    "            block_output\n",
    "        )\n",
    "\n",
    "\n",
    "        del (\n",
    "            feature_indices,\n",
    "            values,\n",
    "            expanded_group_codes,\n",
    "            kept_features,\n",
    "            kept_values,\n",
    "            kept_groups,\n",
    "            flat_indices,\n",
    "            block_sum_float,\n",
    "            block_sum\n",
    "        )\n",
    "\n",
    "\n",
    "        gc.collect()\n",
    "\n",
    "\n",
    "        if (\n",
    "            col_end\n",
    "            % 5120\n",
    "            <\n",
    "            BLOCK_COLUMNS\n",
    "        ):\n",
    "\n",
    "            print(\n",
    "                \"Processed H5 columns:\",\n",
    "                f\"{col_end:,}\",\n",
    "                \"/\",\n",
    "                f\"{N_H5_CELLS:,}\"\n",
    "            )\n",
    "\n",
    "\n",
    "assert (\n",
    "    total_target_input_UMIs\n",
    "    ==\n",
    "    total_pseudobulk_output_UMIs\n",
    ")\n",
    "\n",
    "\n",
    "assert int(\n",
    "\n",
    "    pseudobulk.sum(\n",
    "        dtype=np.int64\n",
    "    )\n",
    "\n",
    ") == total_target_input_UMIs\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nUMI conservation: PASS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Target-cell input UMIs:\",\n",
    "    f\"{total_target_input_UMIs:,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Pseudobulk output UMIs:\",\n",
    "    f\"{total_pseudobulk_output_UMIs:,}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. RAW PSEUDOBULK DATAFRAME\n",
    "# ============================================================\n",
    "\n",
    "gene_ids = (\n",
    "\n",
    "    feature_meta[\n",
    "        \"gene_id\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .tolist()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    gene_ids\n",
    ") == N_FEATURES\n",
    "\n",
    "\n",
    "pb = pd.DataFrame(\n",
    "\n",
    "    pseudobulk,\n",
    "\n",
    "    index=pd.Index(\n",
    "        gene_ids,\n",
    "        name=\"gene_id\"\n",
    "    ),\n",
    "\n",
    "    columns=\n",
    "        group_meta[\n",
    "            \"pseudobulk_group\"\n",
    "        ].tolist()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert pb.shape == (\n",
    "    58721,\n",
    "    72\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    pb.index\n",
    "    .is_unique\n",
    ")\n",
    "\n",
    "\n",
    "pb.to_csv(\n",
    "\n",
    "    PSEUDOBULK_PATH,\n",
    "\n",
    "    compression={\n",
    "        \"method\":\n",
    "            \"gzip\",\n",
    "\n",
    "        \"compresslevel\":\n",
    "            6\n",
    "    }\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. HASH HELPERS\n",
    "# ============================================================\n",
    "\n",
    "def sha256_file(\n",
    "    path,\n",
    "    block_size=1024 * 1024\n",
    "):\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\"\n",
    "    ) as f:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            block = f.read(\n",
    "                block_size\n",
    "            )\n",
    "\n",
    "\n",
    "            if not block:\n",
    "\n",
    "                break\n",
    "\n",
    "\n",
    "            h.update(\n",
    "                block\n",
    "            )\n",
    "\n",
    "\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "def ordered_feature_hash(\n",
    "    feature_ids\n",
    "):\n",
    "\n",
    "    payload = (\n",
    "\n",
    "        \"\\n\".join(\n",
    "            map(\n",
    "                str,\n",
    "                feature_ids\n",
    "            )\n",
    "        )\n",
    "\n",
    "        +\n",
    "\n",
    "        \"\\n\"\n",
    "\n",
    "    ).encode(\n",
    "        \"utf-8\"\n",
    "    )\n",
    "\n",
    "\n",
    "    return hashlib.sha256(\n",
    "        payload\n",
    "    ).hexdigest()\n",
    "\n",
    "\n",
    "pseudobulk_sha256 = sha256_file(\n",
    "    PSEUDOBULK_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nRaw pseudobulk:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    PSEUDOBULK_PATH\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"SHA256:\",\n",
    "    pseudobulk_sha256\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 12. FEATURE ANNOTATION VECTORS\n",
    "# ============================================================\n",
    "\n",
    "gene_symbols = (\n",
    "\n",
    "    feature_meta[\n",
    "        \"gene_symbol\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .to_numpy()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "symbol_unique = (\n",
    "\n",
    "    feature_meta[\n",
    "        \"gene_symbol_unique\"\n",
    "    ]\n",
    "    .astype(bool)\n",
    "    .to_numpy()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "mt_mask = (\n",
    "\n",
    "    feature_meta[\n",
    "        \"MT_prefix\"\n",
    "    ]\n",
    "    .astype(bool)\n",
    "    .to_numpy()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "gex_mask = (\n",
    "\n",
    "    feature_meta[\n",
    "        \"feature_type\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .eq(\n",
    "        \"Gene Expression\"\n",
    "    )\n",
    "    .to_numpy(\n",
    "        dtype=bool\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 13. FREEZE GENE FILTER\n",
    "#\n",
    "# CPM >= 1 in >=7 of 18 donors.\n",
    "#\n",
    "# 7 = smaller diagnosis group.\n",
    "#\n",
    "# CPM denominator:\n",
    "# total Gene Expression UMI count in each donor×class\n",
    "# pseudobulk before expression filtering.\n",
    "#\n",
    "# MT- removed after expression threshold.\n",
    "# ============================================================\n",
    "\n",
    "CPM_THRESHOLD = 1.0\n",
    "MIN_DONORS_CPM = 7\n",
    "\n",
    "\n",
    "universe_records = {}\n",
    "universe_summary_rows = []\n",
    "\n",
    "\n",
    "for cell_type in TARGET_CLASSES:\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\n\"\n",
    "        +\n",
    "        \"=\" * 72\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        cell_type\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"=\" * 72\n",
    "    )\n",
    "\n",
    "\n",
    "    class_meta = (\n",
    "\n",
    "        group_meta[\n",
    "            group_meta[\n",
    "                \"canonical_cell_class\"\n",
    "            ]\n",
    "            ==\n",
    "            cell_type\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        class_meta\n",
    "    ) == 18\n",
    "\n",
    "\n",
    "    class_columns = (\n",
    "\n",
    "        class_meta[\n",
    "            \"pseudobulk_group\"\n",
    "        ]\n",
    "        .tolist()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    class_counts = (\n",
    "\n",
    "        pb[\n",
    "            class_columns\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    arr = (\n",
    "\n",
    "        class_counts\n",
    "        .to_numpy(\n",
    "            dtype=np.int64,\n",
    "            copy=False\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Library size from Gene Expression features only.\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    library_sizes = (\n",
    "\n",
    "        arr[\n",
    "            gex_mask,\n",
    "            :\n",
    "        ]\n",
    "        .sum(\n",
    "            axis=0,\n",
    "            dtype=np.int64\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        library_sizes\n",
    "        >\n",
    "        0\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    class_meta[\n",
    "        \"library_size\"\n",
    "    ] = (\n",
    "        library_sizes\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # CPM for every feature using frozen library denominator.\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    cpm = (\n",
    "\n",
    "        arr.astype(\n",
    "            np.float64\n",
    "        )\n",
    "\n",
    "        /\n",
    "\n",
    "        library_sizes[\n",
    "            None,\n",
    "            :\n",
    "        ]\n",
    "\n",
    "        *\n",
    "\n",
    "        1_000_000.0\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert np.isfinite(\n",
    "        cpm\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    n_donors_ge_1cpm = (\n",
    "\n",
    "        (\n",
    "            cpm\n",
    "            >=\n",
    "            CPM_THRESHOLD\n",
    "        )\n",
    "        .sum(\n",
    "            axis=1\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    expression_pass = (\n",
    "\n",
    "        n_donors_ge_1cpm\n",
    "        >=\n",
    "        MIN_DONORS_CPM\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    final_mask = (\n",
    "\n",
    "        expression_pass\n",
    "\n",
    "        &\n",
    "\n",
    "        gex_mask\n",
    "\n",
    "        &\n",
    "\n",
    "        ~mt_mask\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    retained_indices = np.flatnonzero(\n",
    "        final_mask\n",
    "    )\n",
    "\n",
    "\n",
    "    retained_gene_ids = [\n",
    "\n",
    "        gene_ids[\n",
    "            i\n",
    "        ]\n",
    "\n",
    "        for i\n",
    "        in retained_indices\n",
    "\n",
    "    ]\n",
    "\n",
    "\n",
    "    n_expression_pass_GEX = int(\n",
    "\n",
    "        (\n",
    "            expression_pass\n",
    "            &\n",
    "            gex_mask\n",
    "        ).sum()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_MT_expression_pass = int(\n",
    "\n",
    "        (\n",
    "            expression_pass\n",
    "            &\n",
    "            gex_mask\n",
    "            &\n",
    "            mt_mask\n",
    "        ).sum()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_retained = int(\n",
    "        final_mask.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "\n",
    "        n_retained\n",
    "\n",
    "        ==\n",
    "\n",
    "        n_expression_pass_GEX\n",
    "        -\n",
    "        n_MT_expression_pass\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Expression-passing Gene Expression features:\",\n",
    "        f\"{n_expression_pass_GEX:,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Expression-passing MT- removed:\",\n",
    "        n_MT_expression_pass\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Frozen AD discovery universe:\",\n",
    "        f\"{n_retained:,}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 13A. GENE UNIVERSE TABLE\n",
    "    # ========================================================\n",
    "\n",
    "    universe_table = pd.DataFrame({\n",
    "\n",
    "        \"original_feature_index\":\n",
    "            retained_indices,\n",
    "\n",
    "        \"AD_discovery_universe_index\":\n",
    "            np.arange(\n",
    "                n_retained,\n",
    "                dtype=np.int64\n",
    "            ),\n",
    "\n",
    "        \"gene_id\":\n",
    "            np.asarray(\n",
    "                gene_ids,\n",
    "                dtype=object\n",
    "            )[\n",
    "                retained_indices\n",
    "            ],\n",
    "\n",
    "        \"gene_symbol\":\n",
    "            gene_symbols[\n",
    "                retained_indices\n",
    "            ],\n",
    "\n",
    "        \"gene_symbol_unique_in_GSE174367\":\n",
    "            symbol_unique[\n",
    "                retained_indices\n",
    "            ],\n",
    "\n",
    "        \"feature_type\":\n",
    "            feature_meta[\n",
    "                \"feature_type\"\n",
    "            ]\n",
    "            .astype(str)\n",
    "            .to_numpy()[\n",
    "                retained_indices\n",
    "            ],\n",
    "\n",
    "        \"n_donors_CPM_ge_1\":\n",
    "            n_donors_ge_1cpm[\n",
    "                retained_indices\n",
    "            ].astype(\n",
    "                np.int64\n",
    "            ),\n",
    "    })\n",
    "\n",
    "\n",
    "    assert (\n",
    "        universe_table[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .is_unique\n",
    "    )\n",
    "\n",
    "\n",
    "    assert not (\n",
    "\n",
    "        universe_table[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .str.upper()\n",
    "        .str.startswith(\n",
    "            \"MT-\"\n",
    "        )\n",
    "        .any()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    universe_path = (\n",
    "\n",
    "        UNIVERSES /\n",
    "        (\n",
    "            f\"GSE174367_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"AD_DISCOVERY_GENE_UNIVERSE_v1.csv.gz\"\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    universe_table.to_csv(\n",
    "\n",
    "        universe_path,\n",
    "\n",
    "        index=False,\n",
    "\n",
    "        compression={\n",
    "            \"method\":\n",
    "                \"gzip\",\n",
    "\n",
    "            \"compresslevel\":\n",
    "                6\n",
    "        }\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 13B. FROZEN RAW COUNTS\n",
    "    # ========================================================\n",
    "\n",
    "    filtered_counts = (\n",
    "\n",
    "        class_counts\n",
    "        .iloc[\n",
    "            retained_indices,\n",
    "            :\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "\n",
    "        filtered_counts\n",
    "        .index\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "\n",
    "        ==\n",
    "\n",
    "        retained_gene_ids\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    counts_path = (\n",
    "\n",
    "        UNIVERSES /\n",
    "        (\n",
    "            f\"GSE174367_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"RAW_COUNTS_FROZEN_v1.csv.gz\"\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    filtered_counts.to_csv(\n",
    "\n",
    "        counts_path,\n",
    "\n",
    "        compression={\n",
    "            \"method\":\n",
    "                \"gzip\",\n",
    "\n",
    "            \"compresslevel\":\n",
    "                6\n",
    "        }\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 13C. DONOR METADATA FOR THIS CLASS\n",
    "    # ========================================================\n",
    "\n",
    "    donor_path = (\n",
    "\n",
    "        MANIFESTS /\n",
    "        (\n",
    "            f\"GSE174367_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"AD_DISCOVERY_DONORS_v1.csv\"\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    class_meta[\n",
    "        [\n",
    "            \"pseudobulk_group\",\n",
    "            \"donor_id\",\n",
    "            \"diagnosis_binary\",\n",
    "            \"age\",\n",
    "            \"sex\",\n",
    "            \"batch\",\n",
    "            \"PMI\",\n",
    "            \"RIN\",\n",
    "            \"n_nuclei\",\n",
    "            \"library_size\",\n",
    "        ]\n",
    "    ].to_csv(\n",
    "        donor_path,\n",
    "        index=False\n",
    "    )\n",
    "\n",
    "\n",
    "    feature_hash = ordered_feature_hash(\n",
    "        retained_gene_ids\n",
    "    )\n",
    "\n",
    "\n",
    "    universe_records[\n",
    "        cell_type\n",
    "    ] = {\n",
    "\n",
    "        \"minimum_nuclei_per_donor\":\n",
    "            50,\n",
    "\n",
    "        \"n_AD\":\n",
    "            11,\n",
    "\n",
    "        \"n_Control\":\n",
    "            7,\n",
    "\n",
    "        \"n_total_donors\":\n",
    "            18,\n",
    "\n",
    "        \"CPM_threshold\":\n",
    "            1.0,\n",
    "\n",
    "        \"minimum_donors_CPM\":\n",
    "            7,\n",
    "\n",
    "        \"input_features\":\n",
    "            58721,\n",
    "\n",
    "        \"input_Gene_Expression_features\":\n",
    "            int(\n",
    "                N_GEX\n",
    "            ),\n",
    "\n",
    "        \"Gene_Expression_features_passing_expression_rule\":\n",
    "            n_expression_pass_GEX,\n",
    "\n",
    "        \"expression_passing_MT_removed\":\n",
    "            n_MT_expression_pass,\n",
    "\n",
    "        \"frozen_AD_discovery_gene_universe\":\n",
    "            n_retained,\n",
    "\n",
    "        \"feature_identifier\":\n",
    "            \"Ensembl_gene_id\",\n",
    "\n",
    "        \"gene_symbol_policy\":\n",
    "            (\n",
    "                \"annotation only; duplicate symbols retained \"\n",
    "                \"for DE and later excluded from direct \"\n",
    "                \"cross-dataset symbol matching\"\n",
    "            ),\n",
    "\n",
    "        \"ordered_gene_id_sha256\":\n",
    "            feature_hash,\n",
    "\n",
    "        \"gene_universe_file\":\n",
    "            str(\n",
    "                universe_path\n",
    "            ),\n",
    "\n",
    "        \"raw_counts_file\":\n",
    "            str(\n",
    "                counts_path\n",
    "            ),\n",
    "\n",
    "        \"donor_metadata_file\":\n",
    "            str(\n",
    "                donor_path\n",
    "            ),\n",
    "    }\n",
    "\n",
    "\n",
    "    universe_summary_rows.append({\n",
    "\n",
    "        \"cell_type\":\n",
    "            cell_type,\n",
    "\n",
    "        \"AD\":\n",
    "            11,\n",
    "\n",    "        \"Control\":\n",
    "            7,\n",
    "\n",
    "        \"min_nuclei\":\n",
    "            50,\n",
    "\n",
    "        \"CPM_min_donors\":\n",
    "            7,\n",
    "\n",
    "        \"expression_pass_GEX\":\n",
    "            n_expression_pass_GEX,\n",
    "\n",
    "        \"MT_removed\":\n",
    "            n_MT_expression_pass,\n",
    "\n",
    "        \"frozen_universe\":\n",
    "            n_retained,\n",
    "\n",
    "        \"unique_symbol_features\":\n",
    "            int(\n",
    "                universe_table[\n",
    "                    \"gene_symbol_unique_in_GSE174367\"\n",
    "                ].sum()\n",
    "            ),\n",
    "    })\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 14. DESIGN METADATA\n",
    "# ============================================================\n",
    "\n",
    "design_meta = (\n",
    "\n",
    "    donors[\n",
    "        [\n",
    "            \"donor_id\",\n",
    "            \"diagnosis_binary\",\n",
    "            \"age\",\n",
    "            \"sex\",\n",
    "            \"batch\",\n",
    "            \"PMI\",\n",
    "            \"RIN\",\n",
    "        ]\n",
    "    ]\n",
    "    .copy()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "design_meta[\n",
    "    \"age\"\n",
    "] = pd.to_numeric(\n",
    "    design_meta[\n",
    "        \"age\"\n",
    "    ],\n",
    "    errors=\"raise\"\n",
    ")\n",
    "\n",
    "\n",
    "design_meta[\n",
    "    \"RIN\"\n",
    "] = pd.to_numeric(\n",
    "    design_meta[\n",
    "        \"RIN\"\n",
    "    ],\n",
    "    errors=\"raise\"\n",
    ")\n",
    "\n",
    "\n",
    "design_meta[\n",
    "    \"PMI\"\n",
    "] = pd.to_numeric(\n",
    "    design_meta[\n",
    "        \"PMI\"\n",
    "    ],\n",
    "    errors=\"coerce\"\n",
    ")\n",
    "\n",
    "\n",
    "design_meta[\n",
    "    \"batch\"\n",
    "] = (\n",
    "\n",
    "    design_meta[\n",
    "        \"batch\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    design_meta[\n",
    "        [\n",
    "            \"diagnosis_binary\",\n",
    "            \"age\",\n",
    "            \"sex\",\n",
    "            \"batch\",\n",
    "            \"RIN\",\n",
    "        ]\n",
    "    ]\n",
    "    .notna()\n",
    "    .all()\n",
    "    .all()\n",
    ")\n",
    "\n",
    "\n",
    "assert int(\n",
    "\n",
    "    design_meta[\n",
    "        \"PMI\"\n",
    "    ]\n",
    "    .isna()\n",
    "    .sum()\n",
    "\n",
    ") == 1\n",
    "\n",
    "\n",
    "design_meta.to_csv(\n",
    "    DESIGN_META_PATH,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 15. DESIGN CODING\n",
    "#\n",
    "# References:\n",
    "#     diagnosis = Control\n",
    "#     sex       = Female\n",
    "#     batch     = 1\n",
    "# ============================================================\n",
    "\n",
    "assert (\n",
    "    set(\n",
    "        design_meta[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "    )\n",
    "    ==\n",
    "    {\n",
    "        \"AD\",\n",
    "        \"Control\",\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    set(\n",
    "        design_meta[\n",
    "            \"sex\"\n",
    "        ]\n",
    "    )\n",
    "    ==\n",
    "    {\n",
    "        \"Female\",\n",
    "        \"Male\",\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    set(\n",
    "        design_meta[\n",
    "            \"batch\"\n",
    "        ]\n",
    "    )\n",
    "    ==\n",
    "    {\n",
    "        \"1\",\n",
    "        \"2\",\n",
    "        \"3\",\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "def make_design_matrix(\n",
    "    df,\n",
    "    include_RIN=False,\n",
    "    include_PMI=False\n",
    "):\n",
    "\n",
    "\n",
    "    columns = [\n",
    "\n",
    "        np.ones(\n",
    "            len(\n",
    "                df\n",
    "            )\n",
    "        ),\n",
    "\n",
    "        df[\n",
    "            \"age\"\n",
    "        ]\n",
    "        .to_numpy(\n",
    "            dtype=float\n",
    "        ),\n",
    "\n",
    "        df[\n",
    "            \"sex\"\n",
    "        ]\n",
    "        .eq(\n",
    "            \"Male\"\n",
    "        )\n",
    "        .astype(float)\n",
    "        .to_numpy(),\n",
    "\n",
    "        df[\n",
    "            \"batch\"\n",
    "        ]\n",
    "        .eq(\n",
    "            \"2\"\n",
    "        )\n",
    "        .astype(float)\n",
    "        .to_numpy(),\n",
    "\n",
    "        df[\n",
    "            \"batch\"\n",
    "        ]\n",
    "        .eq(\n",
    "            \"3\"\n",
    "        )\n",
    "        .astype(float)\n",
    "        .to_numpy(),\n",
    "\n",
    "    ]\n",
    "\n",
    "\n",
    "    names = [\n",
    "\n",
    "        \"Intercept\",\n",
    "        \"age\",\n",
    "        \"sex_Male\",\n",
    "        \"batch_2\",\n",
    "        \"batch_3\",\n",
    "\n",
    "    ]\n",
    "\n",
    "\n",
    "    if include_RIN:\n",
    "\n",
    "        columns.append(\n",
    "\n",
    "            df[\n",
    "                \"RIN\"\n",
    "            ]\n",
    "            .to_numpy(\n",
    "                dtype=float\n",
    "            )\n",
    "\n",
    "        )\n",
    "\n",
    "        names.append(\n",
    "            \"RIN\"\n",
    "        )\n",
    "\n",
    "\n",
    "    if include_PMI:\n",
    "\n",
    "        columns.append(\n",
    "\n",
    "            df[\n",
    "                \"PMI\"\n",
    "            ]\n",
    "            .to_numpy(\n",
    "                dtype=float\n",
    "            )\n",
    "\n",
    "        )\n",
    "\n",
    "        names.append(\n",
    "            \"PMI\"\n",
    "        )\n",
    "\n",
    "\n",
    "    columns.append(\n",
    "\n",
    "        df[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        .eq(\n",
    "            \"AD\"\n",
    "        )\n",
    "        .astype(float)\n",
    "        .to_numpy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    names.append(\n",
    "        \"diagnosis_AD\"\n",
    "    )\n",
    "\n",
    "\n",
    "    X = np.column_stack(\n",
    "        columns\n",
    "    )\n",
    "\n",
    "\n",
    "    return (\n",
    "        X,\n",
    "        names\n",
    "    )\n",
    "\n",
    "\n",
    "X_primary, primary_names = (\n",
    "    make_design_matrix(\n",
    "        design_meta,\n",
    "        include_RIN=False,\n",
    "        include_PMI=False\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "X_RIN, RIN_names = (\n",
    "    make_design_matrix(\n",
    "        design_meta,\n",
    "        include_RIN=True,\n",
    "        include_PMI=False\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "PMI_meta = (\n",
    "\n",
    "    design_meta[\n",
    "        design_meta[\n",
    "            \"PMI\"\n",
    "        ]\n",
    "        .notna()\n",
    "    ]\n",
    "    .copy()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    PMI_meta\n",
    ") == 17\n",
    "\n",
    "\n",
    "assert (\n",
    "    PMI_meta[\n",
    "        \"diagnosis_binary\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    "    ==\n",
    "    {\n",
    "        \"AD\": 11,\n",
    "        \"Control\": 6,\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "X_PMI, PMI_names = (\n",
    "    make_design_matrix(\n",
    "        PMI_meta,\n",
    "        include_RIN=False,\n",
    "        include_PMI=True\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "primary_rank = int(\n",
    "    np.linalg.matrix_rank(\n",
    "        X_primary\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "RIN_rank = int(\n",
    "    np.linalg.matrix_rank(\n",
    "        X_RIN\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "PMI_rank = int(\n",
    "    np.linalg.matrix_rank(\n",
    "        X_PMI\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    primary_rank\n",
    "    ==\n",
    "    X_primary.shape[\n",
    "        1\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    RIN_rank\n",
    "    ==\n",
    "    X_RIN.shape[\n",
    "        1\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    PMI_rank\n",
    "    ==\n",
    "    X_PMI.shape[\n",
    "        1\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 16. STANDARDIZED CONDITION NUMBERS\n",
    "#\n",
    "# Diagnostic only.\n",
    "# Actual DE keeps original covariate scales.\n",
    "# ============================================================\n",
    "\n",
    "def zscore(\n",
    "    values\n",
    "):\n",
    "\n",
    "    values = np.asarray(\n",
    "        values,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "\n",
    "    sd = values.std(\n",
    "        ddof=0\n",
    "    )\n",
    "\n",
    "\n",
    "    assert sd > 0\n",
    "\n",
    "\n",
    "    return (\n",
    "\n",
    "        values\n",
    "        -\n",
    "        values.mean()\n",
    "\n",
    "    ) / sd\n",
    "\n",
    "\n",
    "def make_standardized_design(\n",
    "    df,\n",
    "    include_RIN=False,\n",
    "    include_PMI=False\n",
    "):\n",
    "\n",
    "\n",
    "    columns = [\n",
    "\n",
    "        np.ones(\n",
    "            len(\n",
    "                df\n",
    "            )\n",
    "        ),\n",
    "\n",
    "        zscore(\n",
    "            df[\n",
    "                \"age\"\n",
    "            ]\n",
    "        ),\n",
    "\n",
    "        df[\n",
    "            \"sex\"\n",
    "        ]\n",
    "        .eq(\n",
    "            \"Male\"\n",
    "        )\n",
    "        .astype(float)\n",
    "        .to_numpy(),\n",
    "\n",
    "        df[\n",
    "            \"batch\"\n",
    "        ]\n",
    "        .eq(\n",
    "            \"2\"\n",
    "        )\n",
    "        .astype(float)\n",
    "        .to_numpy(),\n",
    "\n",
    "        df[\n",
    "            \"batch\"\n",
    "        ]\n",
    "        .eq(\n",
    "            \"3\"\n",
    "        )\n",
    "        .astype(float)\n",
    "        .to_numpy(),\n",
    "\n",
    "    ]\n",
    "\n",
    "\n",
    "    if include_RIN:\n",
    "\n",
    "        columns.append(\n",
    "\n",
    "            zscore(\n",
    "                df[\n",
    "                    \"RIN\"\n",
    "                ]\n",
    "            )\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "    if include_PMI:\n",
    "\n",
    "        columns.append(\n",
    "\n",
    "            zscore(\n",
    "                df[\n",
    "                    \"PMI\"\n",
    "                ]\n",
    "            )\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "    columns.append(\n",
    "\n",
    "        df[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        .eq(\n",
    "            \"AD\"\n",
    "        )\n",
    "        .astype(float)\n",
    "        .to_numpy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    return np.column_stack(\n",
    "        columns\n",
    "    )\n",
    "\n",
    "\n",
    "primary_condition = float(\n",
    "\n",
    "    np.linalg.cond(\n",
    "\n",
    "        make_standardized_design(\n",
    "            design_meta\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "RIN_condition = float(\n",
    "\n",
    "    np.linalg.cond(\n",
    "\n",
    "        make_standardized_design(\n",
    "            design_meta,\n",
    "            include_RIN=True\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "PMI_condition = float(\n",
    "\n",
    "    np.linalg.cond(\n",
    "\n",
    "        make_standardized_design(\n",
    "            PMI_meta,\n",
    "            include_PMI=True\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"DESIGN AUDIT\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPRIMARY:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"~ age + sex + batch + diagnosis_binary\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Columns:\",\n",
    "    primary_names\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Rank:\",\n",
    "    primary_rank,\n",
    "    \"/\",\n",
    "    X_primary.shape[\n",
    "        1\n",
    "    ]\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Standardized condition number:\",\n",
    "    primary_condition\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nRIN SENSITIVITY:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"~ age + sex + batch + RIN + diagnosis_binary\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Rank:\",\n",
    "    RIN_rank,\n",
    "    \"/\",\n",
    "    X_RIN.shape[\n",
    "        1\n",
    "    ]\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Standardized condition number:\",\n",
    "    RIN_condition\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPMI COMPLETE-CASE SENSITIVITY:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"~ age + sex + batch + PMI + diagnosis_binary\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Donors:\",\n",
    "    len(\n",
    "        PMI_meta\n",
    "    ),\n",
    "    \"(11 AD / 6 Control)\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Rank:\",\n",
    "    PMI_rank,\n",
    "    \"/\",\n",
    "    X_PMI.shape[\n",
    "        1\n",
    "    ]\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Standardized condition number:\",\n",
    "    PMI_condition\n",
    ")\n",
    "\n",
    "\n",
    "# Hard-stop only for severe numerical instability.\n",
    "assert (\n",
    "    primary_condition\n",
    "    <\n",
    "    30\n",
    "), (\n",
    "    \"Primary design is poorly conditioned.\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    RIN_condition\n",
    "    <\n",
    "    30\n",
    "), (\n",
    "    \"RIN sensitivity design is poorly conditioned.\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    PMI_condition\n",
    "    <\n",
    "    30\n",
    "), (\n",
    "    \"PMI sensitivity design is poorly conditioned.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 17. AGE OVERLAP AUDIT\n",
    "# ============================================================\n",
    "\n",
    "AD_age = (\n",
    "\n",
    "    design_meta.loc[\n",
    "        design_meta[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        ==\n",
    "        \"AD\",\n",
    "        \"age\"\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "Control_age = (\n",
    "\n",
    "    design_meta.loc[\n",
    "        design_meta[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        ==\n",
    "        \"Control\",\n",
    "        \"age\"\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "common_age_min = float(\n",
    "\n",
    "    max(\n",
    "        AD_age.min(),\n",
    "        Control_age.min()\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "common_age_max = float(\n",
    "\n",
    "    min(\n",
    "        AD_age.max(),\n",
    "        Control_age.max()\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "age_overlap_meta = (\n",
    "\n",
    "    design_meta[\n",
    "        design_meta[\n",
    "            \"age\"\n",
    "        ]\n",
    "        .between(\n",
    "            common_age_min,\n",
    "            common_age_max,\n",
    "            inclusive=\"both\"\n",
    "        )\n",
    "    ]\n",
    "    .copy()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "age_overlap_counts = (\n",
    "\n",
    "    age_overlap_meta[\n",
    "        \"diagnosis_binary\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nCommon age support:\",\n",
    "    common_age_min,\n",
    "    \"to\",\n",
    "    common_age_max\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Age-overlap counts:\",\n",
    "    age_overlap_counts\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    age_overlap_counts\n",
    "    ==\n",
    "    {\n",
    "        \"AD\": 11,\n",
    "        \"Control\": 3,\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 18. SAVE PSEUDOBULK BUILD LOCK\n",
    "# ============================================================\n",
    "\n",
    "PSEUDOBULK_LOCK = {\n",
    "\n",
    "    \"dataset\":\n",
    "        \"GSE174367\",\n",
    "\n",
    "    \"created_utc\":\n",
    "        datetime.now(\n",
    "            timezone.utc\n",
    "        ).isoformat(),\n",
    "\n",
    "    \"status\":\n",
    "        \"AD_DISCOVERY_PSEUDOBULK_BUILT\",\n",
    "\n",
    "    \"biological_replicate\":\n",
    "        \"human_donor\",\n",
    "\n",
    "    \"source_matrix\":\n",
    "        \"official_10x_filtered_feature_bc_matrix_H5\",\n",
    "\n",
    "    \"matrix_orientation\":\n",
    "        \"features_by_cells_CSC\",\n",
    "\n",
    "    \"input_H5_cells\":\n",
    "        61770,\n",
    "\n",
    "    \"author_annotated_analysis_cells\":\n",
    "        61472,\n",
    "\n",
    "    \"target_primary_class_cells\":\n",
    "        int(\n",
    "            N_TARGET_CELLS\n",
    "        ),\n",
    "\n",
    "    \"target_cell_classes\":\n",
    "        TARGET_CLASSES,\n",
    "\n",
    "    \"minimum_nuclei_per_donor\":\n",
    "        50,\n",
    "\n",
    "    \"n_donors\":\n",
    "        18,\n",
    "\n",
    "    \"n_AD\":\n",
    "        11,\n",
    "\n",
    "    \"n_Control\":\n",
    "        7,\n",
    "\n",
    "    \"n_pseudobulk_groups\":\n",
    "        72,\n",
    "\n",
    "    \"UMI_conservation\":\n",
    "        True,\n",
    "\n",
    "    \"total_target_input_UMIs\":\n",
    "        int(\n",
    "            total_target_input_UMIs\n",
    "        ),\n",
    "\n",
    "    \"total_pseudobulk_output_UMIs\":\n",
    "        int(\n",
    "            total_pseudobulk_output_UMIs\n",
    "        ),\n",
    "\n",
    "    \"raw_pseudobulk_file\":\n",
    "        str(\n",
    "            PSEUDOBULK_PATH\n",
    "        ),\n",
    "\n",
    "    \"raw_pseudobulk_sha256\":\n",
    "        pseudobulk_sha256,\n",
    "\n",
    "    \"group_metadata\":\n",
    "        str(\n",
    "            GROUP_META_PATH\n",
    "        ),\n",
    "\n",
    "    \"differential_expression_performed\":\n",
    "        False,\n",
    "\n",
    "    \"AD_PD_convergence_performed\":\n",
    "        False,\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    PSEUDOBULK_LOCK_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        PSEUDOBULK_LOCK,\n",
    "        f,\n",
    "        indent=2\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 19. FREEZE FINAL AD DISCOVERY INFERENCE POLICY\n",
    "# ============================================================\n",
    "\n",
    "AD_DISCOVERY_POLICY = {\n",
    "\n",
    "    \"biological_replicate\":\n",
    "        \"human donor\",\n",
    "\n",
    "    \"primary_cell_classes\":\n",
    "        TARGET_CLASSES,\n",
    "\n",
    "    \"minimum_nuclei_per_donor\":\n",
    "        50,\n",
    "\n",
    "    \"primary_donor_cohort\": {\n",
    "\n",
    "        \"AD\":\n",
    "            11,\n",
    "\n",
    "        \"Control\":\n",
    "            7,\n",
    "\n",
    "        \"total\":\n",
    "            18,\n",
    "    },\n",
    "\n",
    "    \"primary_model\":\n",
    "        \"~ age + sex + batch + diagnosis_binary\",\n",
    "\n",
    "    \"primary_reference_levels\": {\n",
    "\n",
    "        \"diagnosis_binary\":\n",
    "            \"Control\",\n",
    "\n",
    "        \"sex\":\n",
    "            \"Female\",\n",
    "\n",
    "        \"batch\":\n",
    "            \"1\",\n",
    "    },\n",
    "\n",
    "    \"primary_contrast\":\n",
    "        \"AD_vs_Control\",\n",
    "\n",
    "    \"technical_sensitivity_RIN\": {\n",
    "\n",
    "        \"model\":\n",
    "            \"~ age + sex + batch + RIN + diagnosis_binary\",\n",
    "\n",
    "        \"donors\":\n",
    "            18,\n",
    "\n",
    "        \"reason\":\n",
    "            (\n",
    "                \"RIN is fully observed and is tested \"\n",
    "                \"as a technical robustness covariate.\"\n",
    "            ),\n",
    "    },\n",
    "\n",
    "    \"technical_sensitivity_PMI\": {\n",
    "\n",
    "        \"model\":\n",
    "            \"~ age + sex + batch + PMI + diagnosis_binary\",\n",
    "\n",
    "        \"complete_case_only\":\n",
    "            True,\n",
    "\n",
    "        \"donors\":\n",
    "            17,\n",
    "\n",
    "        \"AD\":\n",
    "            11,\n",
    "\n",
    "        \"Control\":\n",
    "            6,\n",
    "\n",
    "        \"reason\":\n",
    "            (\n",
    "                \"PMI is missing for one control donor; \"\n",
    "                \"therefore PMI is not used in the primary model.\"\n",
    "            ),\n",
    "    },\n",
    "\n",
    "    \"age_overlap_sensitivity\":\n",
    "        False,\n",    "\n",
    "    \"age_overlap_reason\":\n",
    "        (\n",
    "            \"Common observed age support retains \"\n",
    "            \"11 AD but only 3 controls, so an \"\n",
    "            \"age-restricted cohort is not predeclared.\"\n",
    "        ),\n",
    "\n",
    "    \"pathology_covariates_in_case_control_DE\":\n",
    "        False,\n",
    "\n",
    "    \"pathology_reason\":\n",
    "        (\n",
    "            \"Tangle.Stage and Plaque.Stage are disease/pathology \"\n",
    "            \"variables and are not adjusted in AD-vs-Control DE.\"\n",
    "        ),\n",
    "\n",
    "    \"gene_filter\":\n",
    "        (\n",
    "            \"CPM >= 1 in at least 7 of 18 donors \"\n",
    "            \"within each cell class\"\n",
    "        ),\n",
    "\n",
    "    \"gene_filter_is_disease_blind\":\n",
    "        True,\n",
    "\n",
    "    \"CPM_denominator\":\n",
    "        (\n",
    "            \"raw Gene Expression UMI library size \"\n",
    "            \"within each donor×cell-class pseudobulk\"\n",
    "        ),\n",
    "\n",
    "    \"mitochondrial_policy\":\n",
    "        (\n",
    "            \"remove expression-passing Gene Expression \"\n",
    "            \"features whose gene symbol begins MT-\"\n",
    "        ),\n",
    "\n",
    "    \"feature_identifier_for_DE\":\n",
    "        \"Ensembl_gene_id\",\n",
    "\n",
    "    \"duplicate_gene_symbol_policy\":\n",
    "        (\n",
    "            \"retain duplicate-symbol Ensembl features in DE; \"\n",
    "            \"direct cross-dataset symbol matching later uses \"\n",
    "            \"unambiguous symbols only\"\n",
    "        ),\n",
    "\n",
    "    \"multiple_testing\":\n",
    "        \"Benjamini-Hochberg within each cell class\",\n",
    "\n",
    "    \"FDR_threshold\":\n",
    "        0.05,\n",
    "\n",
    "    \"all_tested_genes_retained\":\n",
    "        True,\n",
    "\n",
    "    \"AD_PD_convergence_allowed\":\n",
    "        False,\n",
    "\n",
