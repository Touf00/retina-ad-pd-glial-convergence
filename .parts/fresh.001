   "source": [
    "# Source analysis cell: 20\n",
    "# ============================================================\n",
    "# STEP 11 — PRIMARY PD vs CONTROL DIFFERENTIAL EXPRESSION\n",
    "# ENVIRONMENT-SAFE COMPLETE VERSION\n",
    "#\n",
    "# WHY THIS VERSION EXISTS\n",
    "# -----------------------\n",
    "# Current notebook kernel loaded:\n",
    "#   PyDESeq2 0.5.4\n",
    "#   Pandas 2.2.3\n",
    "#   newer AnnData\n",
    "#\n",
    "# Newer AnnData uses:\n",
    "#   pd.StringDtype(na_value=...)\n",
    "#\n",
    "# That API is available in Pandas >= 2.3.\n",
    "#\n",
    "# Rather than corrupt/reload the active Colab Python process,\n",
    "# this cell:\n",
    "#\n",
    "#   1. installs Pandas 2.3.3 on disk,\n",
    "#   2. writes a fresh standalone STEP 11 runner,\n",
    "#   3. launches that runner in a NEW Python process,\n",
    "#   4. performs all four frozen primary DE analyses,\n",
    "#   5. saves all results and run locks,\n",
    "#   6. prints the final four-row summary.\n",
    "#\n",
    "# FROZEN BIOLOGICAL ANALYSIS IS UNCHANGED.\n",
    "#\n",
    "# PRIMARY CLASSES:\n",
    "#   Astro\n",
    "#   Micro\n",
    "#   OPC\n",
    "#   Oligo\n",
    "#\n",
    "# MODEL:\n",
    "#   ~ age + sex + diagnosis_binary\n",
    "#\n",
    "# CONTRAST:\n",
    "#   PD vs Control\n",
    "#\n",
    "# NO refiltering.\n",
    "# NO secondary VC/Neuron DE.\n",
    "# NO sensitivity analysis yet.\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "import sys\n",
    "import subprocess\n",
    "from pathlib import Path\n",
    "import textwrap\n",
    "import importlib.metadata\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. FIX DISK ENVIRONMENT FOR FRESH SUBPROCESS\n",
    "# ============================================================\n",
    "\n",
    "TARGET_PANDAS = \"2.3.3\"\n",
    "TARGET_PYDESEQ2 = \"0.5.4\"\n",
    "\n",
    "\n",
    "print(\"=\" * 80)\n",
    "print(\"STEP 11 ENVIRONMENT PREPARATION\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Install compatible pandas.\n",
    "#\n",
    "# The CURRENT notebook process may continue reporting the old\n",
    "# pandas because it is already imported in memory.\n",
    "#\n",
    "# The fresh subprocess launched below will import 2.3.3.\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "subprocess.check_call(\n",
    "    [\n",
    "        sys.executable,\n",
    "        \"-m\",\n",
    "        \"pip\",\n",
    "        \"install\",\n",
    "        \"-q\",\n",
    "        \"--upgrade\",\n",
    "        f\"pandas=={TARGET_PANDAS}\",\n",
    "        f\"pydeseq2=={TARGET_PYDESEQ2}\",\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Compatible packages installed on disk.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. CREATE STANDALONE RUNNER\n",
    "# ============================================================\n",
    "\n",
    "runner_path = Path(\n",
    "    \"/content/RETINA_ND_STEP11_PRIMARY_DE_RUNNER.py\"\n",
    ")\n",
    "\n",
    "\n",
    "RUNNER = r'''\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "import sys\n",
    "import platform\n",
    "import hashlib\n",
    "import json\n",
    "import gc\n",
    "import io\n",
    "import contextlib\n",
    "import importlib.metadata\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from packaging.version import Version\n",
    "\n",
    "from pydeseq2.dds import DeseqDataSet\n",
    "from pydeseq2.ds import DeseqStats\n",
    "\n",
    "import anndata\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# A. ENVIRONMENT LOCK\n",
    "# ============================================================\n",
    "\n",
    "REQUIRED_PYDESEQ2 = \"0.5.4\"\n",
    "MINIMUM_PANDAS = Version(\"2.3.0\")\n",
    "\n",
    "\n",
    "def package_version(name):\n",
    "\n",
    "    try:\n",
    "        return importlib.metadata.version(\n",
    "            name\n",
    "        )\n",
    "\n",
    "    except importlib.metadata.PackageNotFoundError:\n",
    "        return None\n",
    "\n",
    "\n",
    "PYDESEQ2_VERSION = package_version(\n",
    "    \"pydeseq2\"\n",
    ")\n",
    "\n",
    "PANDAS_VERSION = package_version(\n",
    "    \"pandas\"\n",
    ")\n",
    "\n",
    "ANNDATA_VERSION = package_version(\n",
    "    \"anndata\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"FRESH STEP 11 SUBPROCESS ENVIRONMENT\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "print(\n",
    "    \"Python:\",\n",
    "    platform.python_version()\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PyDESeq2:\",\n",
    "    PYDESEQ2_VERSION\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"AnnData:\",\n",
    "    ANNDATA_VERSION\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Pandas:\",\n",
    "    PANDAS_VERSION\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"NumPy:\",\n",
    "    np.__version__\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    PYDESEQ2_VERSION\n",
    "    ==\n",
    "    REQUIRED_PYDESEQ2\n",
    "), (\n",
    "    f\"Expected PyDESeq2 \"\n",
    "    f\"{REQUIRED_PYDESEQ2}; \"\n",
    "    f\"found {PYDESEQ2_VERSION}\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    Version(\n",
    "        PANDAS_VERSION\n",
    "    )\n",
    "    >=\n",
    "    MINIMUM_PANDAS\n",
    "), (\n",
    "    f\"Pandas >=2.3 required; \"\n",
    "    f\"found {PANDAS_VERSION}\"\n",
    ")\n",
    "\n",
    "\n",
    "# Direct API compatibility test that failed previously.\n",
    "_string_dtype_test = pd.StringDtype(\n",
    "    na_value=pd.NA\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Pandas StringDtype(na_value=...) compatibility: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# B. PROJECT PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = ROOT / \"locks\"\n",
    "MANIFESTS = ROOT / \"manifests\"\n",
    "UNIVERSES = ROOT / \"gene_universes\"\n",
    "\n",
    "DE_ROOT = (\n",
    "    ROOT /\n",
    "    \"PD_primary_DE\"\n",
    ")\n",
    "\n",
    "DE_ROOT.mkdir(\n",
    "    exist_ok=True\n",
    ")\n",
    "\n",
    "\n",
    "pre_de_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_PRE_DE_ANALYSIS_LOCK_v1.json\"\n",
    ")\n",
    "\n",
    "design_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_DESIGN_AUDIT_v1.json\"\n",
    ")\n",
    "\n",
    "de_run_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_PRIMARY_PD_DE_RUN_v1.json\"\n",
    ")\n",
    "\n",
    "summary_path = (\n",
    "    DE_ROOT /\n",
    "    \"GSE243639_PRIMARY_PD_DE_SUMMARY_v1.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "assert pre_de_lock_path.exists()\n",
    "assert design_lock_path.exists()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# C. LOAD FROZEN PRE-DE LOCKS\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    pre_de_lock_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    pre_de_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    design_lock_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    design_lock = json.load(f)\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre_de_lock[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"FINAL_PRE_DE_LOCK\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre_de_lock[\n",
    "        \"differential_expression_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre_de_lock[\n",
    "        \"disease_gene_results_inspected\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    design_lock[\n",
    "        \"primary_design_full_rank\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    design_lock[\n",
    "        \"primary_design_rank\"\n",
    "    ]\n",
    "    ==\n",
    "    4\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    design_lock[\n",
    "        \"primary_design_columns\"\n",
    "    ]\n",
    "    ==\n",
    "    4\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFrozen pre-DE locks verified.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# D. PRIMARY CLASSES / EXPECTED UNIVERSES\n",
    "# ============================================================\n",
    "\n",
    "PRIMARY_CLASSES = [\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "]\n",
    "\n",
    "\n",
    "EXPECTED_UNIVERSES = {\n",
    "\n",
    "    \"Astro\":\n",
    "        16942,\n",
    "\n",
    "    \"Micro\":\n",
    "        16050,\n",
    "\n",
    "    \"OPC\":\n",
    "        16268,\n",
    "\n",
    "    \"Oligo\":\n",
    "        15957,\n",
    "}\n",
    "\n",
    "\n",
    "for cell_type in PRIMARY_CLASSES:\n",
    "\n",
    "    rec = (\n",
    "        pre_de_lock[\n",
    "            \"cell_class_universes\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        rec[\n",
    "            \"role\"\n",
    "        ]\n",
    "        ==\n",
    "        \"primary\"\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        rec[\n",
    "            \"frozen_DE_gene_universe\"\n",
    "        ]\n",
    "        ==\n",
    "        EXPECTED_UNIVERSES[\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Frozen primary classes verified:\",\n",
    "    PRIMARY_CLASSES\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# E. HASH HELPERS\n",
    "# ============================================================\n",
    "\n",
    "def sha256_file(\n",
    "    path,\n",
    "    block_size=1024 * 1024\n",
    "):\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\"\n",
    "    ) as f:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            block = f.read(\n",
    "                block_size\n",
    "            )\n",
    "\n",
    "            if not block:\n",
    "                break\n",
    "\n",
    "            h.update(\n",
    "                block\n",
    "            )\n",
    "\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "def ordered_gene_hash(\n",
    "    ordered_genes\n",
    "):\n",
    "\n",
    "    payload = (\n",
    "        \"\\n\".join(\n",
    "            map(\n",
    "                str,\n",
    "                ordered_genes\n",
    "            )\n",
    "        )\n",
    "        +\n",
    "        \"\\n\"\n",
    "    ).encode(\n",
    "        \"utf-8\"\n",
    "    )\n",
    "\n",
    "    return hashlib.sha256(\n",
    "        payload\n",
    "    ).hexdigest()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# F. RESULT STORAGE\n",
    "# ============================================================\n",
    "\n",
    "run_records = {}\n",
    "\n",
    "summary_rows = []\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# G. RUN FOUR PRIMARY CELL CLASSES\n",
    "# ============================================================\n",
    "\n",
    "for class_number, cell_type in enumerate(\n",
    "    PRIMARY_CLASSES,\n",
    "    start=1\n",
    "):\n",
    "\n",
    "    print(\n",
    "        \"\\n\"\n",
    "        +\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"[{class_number}/4] \"\n",
    "        f\"{cell_type} — PRIMARY PD vs CONTROL DE\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G1. Frozen input record\n",
    "    # ========================================================\n",
    "\n",
    "    frozen_record = (\n",
    "        pre_de_lock[\n",
    "            \"cell_class_universes\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    counts_path = Path(\n",
    "        frozen_record[\n",
    "            \"raw_counts_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    metadata_path = Path(\n",
    "        frozen_record[\n",
    "            \"eligible_donor_metadata\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    universe_path = Path(\n",
    "        frozen_record[\n",
    "            \"gene_universe_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    for path in [\n",
    "        counts_path,\n",
    "        metadata_path,\n",
    "        universe_path,\n",
    "    ]:\n",
    "\n",
    "        assert path.exists(), (\n",
    "            f\"Missing frozen input: {path}\"\n",
    "        )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G2. Exact frozen gene universe\n",
    "    # ========================================================\n",
    "\n",
    "    universe = pd.read_csv(\n",
    "        universe_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    required_universe_columns = {\n",
    "\n",
    "        \"original_gene_index\",\n",
    "        \"DE_universe_index\",\n",
    "        \"gene_symbol\",\n",
    "        \"n_donors_CPM_ge_1\",\n",
    "    }\n",
    "\n",
    "\n",
    "    assert (\n",
    "        required_universe_columns\n",
    "        <=\n",
    "        set(\n",
    "            universe.columns\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    expected_genes = (\n",
    "        universe[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        len(\n",
    "            expected_genes\n",
    "        )\n",
    "        ==\n",
    "        EXPECTED_UNIVERSES[\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        len(\n",
    "            expected_genes\n",
    "        )\n",
    "        ==\n",
    "        len(\n",
    "            set(\n",
    "                expected_genes\n",
    "            )\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    observed_gene_hash = (\n",
    "        ordered_gene_hash(\n",
    "            expected_genes\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    expected_gene_hash = (\n",
    "        frozen_record[\n",
    "            \"gene_universe_sha256\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        observed_gene_hash\n",
    "        ==\n",
    "        expected_gene_hash\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Frozen genes:\",\n",
    "        f\"{len(expected_genes):,}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G3. Frozen counts\n",
    "    #\n",
    "    # Stored:\n",
    "    # genes × donor\n",
    "    #\n",
    "    # Required:\n",
    "    # donor × genes\n",
    "    # ========================================================\n",
    "\n",
    "    raw = pd.read_csv(\n",
    "        counts_path,\n",
    "        compression=\"gzip\",\n",
    "        index_col=0\n",
    "    )\n",
    "\n",
    "\n",
    "    raw.index = (\n",
    "        raw.index\n",
    "        .astype(str)\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        raw.index.tolist()\n",
    "        ==\n",
    "        expected_genes\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G4. Frozen donor metadata\n",
    "    # ========================================================\n",
    "\n",
    "    metadata = pd.read_csv(\n",
    "        metadata_path\n",
    "    )\n",
    "\n",
    "\n",
    "    required_metadata_columns = {\n",
    "\n",
    "        \"pseudobulk_group\",\n",
    "        \"donor_id\",\n",
    "        \"diagnosis_binary\",\n",
    "        \"age\",\n",
    "        \"sex\",\n",
    "        \"PMI\",\n",
    "        \"RIN\",\n",
    "        \"n_nuclei\",\n",
    "        \"library_size\",\n",
    "    }\n",
    "\n",
    "\n",
    "    assert (\n",
    "        required_metadata_columns\n",
    "        <=\n",
    "        set(\n",
    "            metadata.columns\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        metadata\n",
    "    ) == 29\n",
    "\n",
    "\n",
    "    assert (\n",
    "        metadata[\n",
    "            \"donor_id\"\n",
    "        ]\n",
    "        .nunique()\n",
    "        ==\n",
    "        29\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        metadata[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        .value_counts()\n",
    "        .to_dict()\n",
    "        ==\n",
    "        {\n",
    "            \"PD\": 15,\n",
    "            \"Control\": 14,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        metadata[\n",
    "            \"n_nuclei\"\n",
    "        ]\n",
    "        >=\n",
    "        50\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    sample_order = (\n",
    "        metadata[\n",
    "            \"pseudobulk_group\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        raw.columns\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "        ==\n",
    "        sample_order\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G5. donor × genes count matrix\n",
    "    # ========================================================\n",
    "\n",
    "    counts = (\n",
    "        raw.T\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Explicit OBJECT indexes.\n",
    "    #\n",
    "    # This makes index semantics unambiguous even though\n",
    "    # the fresh Pandas/AnnData pair is now compatible.\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    counts.index = pd.Index(\n",
    "        [\n",
    "            str(x)\n",
    "            for x in counts.index\n",
    "        ],\n",
    "        dtype=\"object\"\n",
    "    )\n",
    "\n",
    "\n",
    "    counts.columns = pd.Index(\n",
    "        [\n",
    "            str(x)\n",
    "            for x in counts.columns\n",
    "        ],\n",
    "        dtype=\"object\"\n",
    "    )\n",
    "\n",
    "\n",
    "    assert counts.shape == (\n",
    "        29,\n",
    "        len(\n",
    "            expected_genes\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        counts.index.tolist()\n",
    "        ==\n",
    "        sample_order\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        counts.columns.tolist()\n",
    "        ==\n",
    "        expected_genes\n",
    "    )\n",
    "\n",
    "\n",
    "    count_array = (\n",
    "        counts\n",
    "        .to_numpy()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert np.isfinite(\n",
    "        count_array\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    assert (\n",
    "        count_array >= 0\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    assert np.allclose(\n",
    "        count_array,\n",
    "        np.round(\n",
    "            count_array\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    counts = counts.astype(\n",
    "        np.int64\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Counts:\",\n",
    "        counts.shape\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G6. DE metadata\n",
    "    # ========================================================\n",
    "\n",
    "    de_meta = (\n",
    "        metadata[\n",
    "            [\n",
    "                \"pseudobulk_group\",\n",
    "                \"donor_id\",\n",
    "                \"age\",\n",
    "                \"sex\",\n",
    "                \"diagnosis_binary\",\n",
    "            ]\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta.index = pd.Index(\n",
    "        [\n",
    "            str(x)\n",
    "            for x\n",
    "            in de_meta[\n",
    "                \"pseudobulk_group\"\n",
    "            ]\n",
    "        ],\n",
    "        dtype=\"object\"\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta = de_meta.drop(\n",
    "        columns=[\n",
    "            \"pseudobulk_group\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta[\n",
    "        \"donor_id\"\n",
    "    ] = (\n",
    "        de_meta[\n",
    "            \"donor_id\"\n",
    "        ]\n",
    "        .astype(\n",
    "            \"object\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta[\n",
    "        \"age\"\n",
    "    ] = pd.to_numeric(\n",
    "        de_meta[\n",
    "            \"age\"\n",
    "        ],\n",
    "        errors=\"raise\"\n",    "    )\n",
    "\n",
    "\n",
    "    de_meta[\n",
    "        \"sex\"\n",
    "    ] = pd.Categorical(\n",
    "        de_meta[\n",
    "            \"sex\"\n",
    "        ].astype(str),\n",
    "        categories=[\n",
    "            \"Female\",\n",
    "            \"Male\",\n",
    "        ],\n",
    "        ordered=False\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta[\n",
    "        \"diagnosis_binary\"\n",
    "    ] = pd.Categorical(\n",
    "        de_meta[\n",
    "            \"diagnosis_binary\"\n",
    "        ].astype(str),\n",
    "        categories=[\n",
    "            \"Control\",\n",
    "            \"PD\",\n",
    "        ],\n",
    "        ordered=False\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        counts.index.equals(\n",
    "            de_meta.index\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        de_meta[\n",
    "            \"age\"\n",
    "        ]\n",
    "        .notna()\n",
    "        .all()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        de_meta[\n",
    "            \"sex\"\n",
    "        ]\n",
    "        .notna()\n",
    "        .all()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        de_meta[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        .notna()\n",
    "        .all()\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Metadata:\",\n",
    "        de_meta.shape\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Donor ordering verified: YES\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G7. Construct PyDESeq2 object\n",
    "    # ========================================================\n",
    "\n",
    "    dds = DeseqDataSet(\n",
    "        counts=counts,\n",
    "        metadata=de_meta,\n",
    "        design=(\n",
    "            \"~ age + sex + \"\n",
    "            \"diagnosis_binary\"\n",
    "        ),\n",
    "        refit_cooks=True,\n",
    "        n_cpus=2,\n",
    "        quiet=False,\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"DeseqDataSet construction: PASS\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G8. Verify ACTUAL PyDESeq2 design\n",
    "    # ========================================================\n",
    "\n",
    "    design_matrix = (\n",
    "        dds.obsm[\n",
    "            \"design_matrix\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    design_rank = int(\n",
    "        np.linalg.matrix_rank(\n",
    "            design_matrix.to_numpy()\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    design_n_columns = int(\n",
    "        design_matrix.shape[\n",
    "            1\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nPyDESeq2 design columns:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        design_matrix.columns.tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"PyDESeq2 design rank:\",\n",
    "        design_rank,\n",
    "        \"/\",\n",
    "        design_n_columns\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        design_rank\n",
    "        ==\n",
    "        design_n_columns\n",
    "        ==\n",
    "        4\n",
    "    )\n",
    "\n",
    "\n",
    "    diagnosis_columns = [\n",
    "\n",
    "        str(col)\n",
    "\n",
    "        for col\n",
    "        in design_matrix.columns\n",
    "\n",
    "        if (\n",
    "            \"diagnosis_binary\"\n",
    "            in str(col)\n",
    "        )\n",
    "    ]\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        diagnosis_columns\n",
    "    ) == 1\n",
    "\n",
    "\n",
    "    assert (\n",
    "        \"PD\"\n",
    "        in diagnosis_columns[\n",
    "            0\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G9. Cell-class output directory\n",
    "    # ========================================================\n",
    "\n",
    "    class_dir = (\n",
    "        DE_ROOT /\n",
    "        cell_type\n",
    "    )\n",
    "\n",
    "\n",
    "    class_dir.mkdir(\n",
    "        exist_ok=True\n",
    "    )\n",
    "\n",
    "\n",
    "    design_matrix_path = (\n",
    "        class_dir /\n",
    "        (\n",
    "            f\"GSE243639_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"PRIMARY_DESIGN_MATRIX_v1.csv\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    design_matrix.to_csv(\n",
    "        design_matrix_path\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G10. FIT DESEQ2\n",
    "    # ========================================================\n",
    "\n",
    "    print(\n",
    "        \"\\nRunning DESeq2 fit...\"\n",
    "    )\n",
    "\n",
    "\n",
    "    dds.deseq2()\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"DESeq2 fit complete.\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G11. Size factors\n",
    "    # ========================================================\n",
    "\n",
    "    assert (\n",
    "        \"size_factors\"\n",
    "        in\n",
    "        dds.obs.columns\n",
    "    )\n",
    "\n",
    "\n",
    "    size_factors = (\n",
    "        dds.obs[\n",
    "            \"size_factors\"\n",
    "        ]\n",
    "        .to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        size_factors\n",
    "    ) == 29\n",
    "\n",
    "\n",
    "    assert np.isfinite(\n",
    "        size_factors\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    assert (\n",
    "        size_factors > 0\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    size_factor_table = pd.DataFrame({\n",
    "\n",
    "        \"pseudobulk_group\":\n",
    "            counts.index.tolist(),\n",
    "\n",
    "        \"donor_id\":\n",
    "            metadata[\n",
    "                \"donor_id\"\n",
    "            ]\n",
    "            .astype(str)\n",
    "            .tolist(),\n",
    "\n",
    "        \"diagnosis_binary\":\n",
    "            metadata[\n",
    "                \"diagnosis_binary\"\n",
    "            ]\n",
    "            .astype(str)\n",
    "            .tolist(),\n",
    "\n",
    "        \"size_factor\":\n",
    "            size_factors,\n",
    "    })\n",
    "\n",
    "\n",
    "    size_factor_path = (\n",
    "        class_dir /\n",
    "        (\n",
    "            f\"GSE243639_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"DESEQ2_SIZE_FACTORS_v1.csv\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    size_factor_table.to_csv(\n",
    "        size_factor_path,\n",
    "        index=False\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G12. PD vs CONTROL STATISTICS\n",
    "    #\n",
    "    # Positive LFC:\n",
    "    #   higher in PD\n",
    "    #\n",
    "    # Negative LFC:\n",
    "    #   lower in PD\n",
    "    # ========================================================\n",
    "\n",
    "    stats = DeseqStats(\n",
    "        dds,\n",
    "        contrast=[\n",
    "            \"diagnosis_binary\",\n",
    "            \"PD\",\n",
    "            \"Control\",\n",
    "        ],\n",
    "        alpha=0.05,\n",
    "        cooks_filter=True,\n",
    "        independent_filter=True,\n",
    "        n_cpus=2,\n",
    "        quiet=False,\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Complete DE result generation, but suppress large\n",
    "    # dataframe display until all genes are saved.\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    captured_summary = io.StringIO()\n",
    "\n",
    "\n",
    "    with contextlib.redirect_stdout(\n",
    "        captured_summary\n",
    "    ):\n",
    "\n",
    "        stats.summary()\n",
    "\n",
    "\n",
    "    results = (\n",
    "        stats.results_df\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G13. COMPLETE RESULT INTEGRITY\n",
    "    # ========================================================\n",
    "\n",
    "    results.index = pd.Index(\n",
    "        [\n",
    "            str(x)\n",
    "            for x\n",
    "            in results.index\n",
    "        ],\n",
    "        dtype=\"object\"\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        results.index.is_unique\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        set(\n",
    "            results.index\n",
    "        )\n",
    "        ==\n",
    "        set(\n",
    "            expected_genes\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    # Restore exact frozen universe order.\n",
    "    results = (\n",
    "        results\n",
    "        .loc[\n",
    "            expected_genes\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        results.index.tolist()\n",
    "        ==\n",
    "        expected_genes\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        len(\n",
    "            results\n",
    "        )\n",
    "        ==\n",
    "        EXPECTED_UNIVERSES[\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    required_result_columns = [\n",
    "\n",
    "        \"baseMean\",\n",
    "        \"log2FoldChange\",\n",
    "        \"lfcSE\",\n",
    "        \"stat\",\n",
    "        \"pvalue\",\n",
    "        \"padj\",\n",
    "    ]\n",
    "\n",
    "\n",
    "    missing_result_columns = [\n",
    "\n",
    "        col\n",
    "\n",
    "        for col\n",
    "        in required_result_columns\n",
    "\n",
    "        if col not in results.columns\n",
    "    ]\n",
    "\n",
    "\n",
    "    assert not missing_result_columns, (\n",
    "        f\"{cell_type}: missing \"\n",
    "        f\"{missing_result_columns}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    results.index.name = (\n",
    "        \"gene_symbol\"\n",
    "    )\n",
    "\n",
    "\n",
    "    results = (\n",
    "        results[\n",
    "            required_result_columns\n",
    "        ]\n",
    "        .reset_index()\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G14. PREDECLARED RANK VECTOR\n",
    "    # ========================================================\n",
    "\n",
    "    results[\n",
    "        \"rank_stat\"\n",
    "    ] = (\n",
    "        results[\n",
    "            \"stat\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    results[\n",
    "        \"cell_type\"\n",
    "    ] = (\n",
    "        cell_type\n",
    "    )\n",
    "\n",
    "\n",
    "    results[\n",
    "        \"contrast\"\n",
    "    ] = (\n",
    "        \"PD_vs_Control\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G15. SAVE ALL GENES BEFORE SELECTING SIGNIFICANT GENES\n",
    "    # ========================================================\n",
    "\n",
    "    full_results_path = (\n",
    "        class_dir /\n",
    "        (\n",
    "            f\"GSE243639_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"PD_vs_Control_\"\n",
    "            f\"PRIMARY_DE_ALL_GENES_v1.csv.gz\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    results.to_csv(\n",
    "        full_results_path,\n",
    "        index=False,\n",
    "        compression={\n",
    "            \"method\":\n",
    "                \"gzip\",\n",
    "\n",
    "            \"compresslevel\":\n",
    "                6,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        full_results_path.exists()\n",
    "    )\n",
    "\n",
    "\n",
    "    full_results_hash = (\n",
    "        sha256_file(\n",
    "            full_results_path\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nFull all-gene result saved.\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G16. RESULT QC\n",
    "    # ========================================================\n",
    "\n",
    "    finite_lfc = np.isfinite(\n",
    "        results[\n",
    "            \"log2FoldChange\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    finite_stat = np.isfinite(\n",
    "        results[\n",
    "            \"stat\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    finite_p = np.isfinite(\n",
    "        results[\n",
    "            \"pvalue\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    finite_padj = np.isfinite(\n",
    "        results[\n",
    "            \"padj\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    genome_sig = (\n",
    "        finite_padj\n",
    "        &\n",
    "        (\n",
    "            results[\n",
    "                \"padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    significant = (\n",
    "        results\n",
    "        .loc[\n",
    "            genome_sig\n",
    "        ]\n",
    "        .copy()\n",
    "        .sort_values(\n",
    "            [\n",
    "                \"padj\",\n",
    "                \"pvalue\",\n",
    "            ],\n",
    "            ascending=[\n",
    "                True,\n",
    "                True,\n",
    "            ]\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    significant_up = int(\n",
    "        (\n",
    "            significant[\n",
    "                \"log2FoldChange\"\n",
    "            ]\n",
    "            >\n",
    "            0\n",
    "        ).sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    significant_down = int(\n",
    "        (\n",
    "            significant[\n",
    "                \"log2FoldChange\"\n",
    "            ]\n",
    "            <\n",
    "            0\n",
    "        ).sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    significant_zero = int(\n",
    "        (\n",
    "            significant[\n",
    "                \"log2FoldChange\"\n",
    "            ]\n",
    "            ==\n",
    "            0\n",
    "        ).sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G17. SAVE FDR<0.05 CONVENIENCE TABLE\n",
    "    # ========================================================\n",
    "\n",
    "    significant_path = (\n",
    "        class_dir /\n",
    "        (\n",
    "            f\"GSE243639_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"PD_vs_Control_\"\n",
    "            f\"PRIMARY_DE_FDR05_v1.csv.gz\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    significant.to_csv(\n",
    "        significant_path,\n",
    "        index=False,\n",
    "        compression={\n",
    "            \"method\":\n",
    "                \"gzip\",\n",
    "\n",
    "            \"compresslevel\":\n",
    "                6,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G18. SAVE FULL WALD RANK VECTOR\n",
    "    # ========================================================\n",
    "\n",
    "    rank_table = (\n",
    "        results[\n",
    "            [\n",
    "                \"gene_symbol\",\n",
    "                \"rank_stat\",\n",
    "                \"log2FoldChange\",\n",
    "                \"pvalue\",\n",
    "                \"padj\",\n",
    "            ]\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    rank_path = (\n",
    "        class_dir /\n",
    "        (\n",
    "            f\"GSE243639_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"PD_vs_Control_\"\n",
    "            f\"WALD_RANK_VECTOR_v1.csv.gz\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    rank_table.to_csv(\n",
    "        rank_path,\n",
    "        index=False,\n",
    "        compression={\n",
    "            \"method\":\n",
    "                \"gzip\",\n",
    "\n",
    "            \"compresslevel\":\n",
    "                6,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G19. SAVE DESEQ2 SUMMARY TEXT\n",
    "    # ========================================================\n",
    "\n",
    "    summary_text_path = (\n",
    "        class_dir /\n",
    "        (\n",
    "            f\"GSE243639_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"DESEQ2_SUMMARY_OUTPUT_v1.txt\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    with open(\n",
    "        summary_text_path,\n",
    "        \"w\",\n",
    "        encoding=\"utf-8\"\n",
    "    ) as f:\n",
    "\n",
    "        f.write(\n",
    "            captured_summary.getvalue()\n",
    "        )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G20. CELL-CLASS RUN RECORD\n",
    "    # ========================================================\n",
    "\n",
    "    cell_record = {\n",
    "\n",
    "        \"cell_type\":\n",
    "            cell_type,\n",
    "\n",
    "        \"role\":\n",
    "            \"primary\",\n",
    "\n",
    "        \"model\":\n",
    "            \"~ age + sex + diagnosis_binary\",\n",
    "\n",
    "        \"contrast\":\n",
    "            \"PD_vs_Control\",\n",
    "\n",
    "        \"reference_diagnosis\":\n",
    "            \"Control\",\n",
    "\n",
    "        \"reference_sex\":\n",
    "            \"Female\",\n",
    "\n",
    "        \"n_PD\":\n",
    "            15,\n",
    "\n",
    "        \"n_Control\":\n",
    "            14,\n",
    "\n",
    "        \"n_donors\":\n",
    "            29,\n",
    "\n",
    "        \"n_frozen_genes\":\n",
    "            int(\n",
    "                len(\n",
    "                    expected_genes\n",
    "                )\n",
    "            ),\n",
    "\n",
    "        \"gene_universe_sha256\":\n",
    "            expected_gene_hash,\n",
    "\n",
    "        \"design_rank\":\n",
    "            int(\n",
    "                design_rank\n",
    "            ),\n",
    "\n",
    "        \"design_columns\":\n",
    "            int(\n",
    "                design_n_columns\n",
    "            ),\n",
    "\n",
    "        \"n_finite_log2FoldChange\":\n",
    "            int(\n",
    "                finite_lfc.sum()\n",
    "            ),\n",
    "\n",
    "        \"n_finite_Wald_statistics\":\n",
    "            int(\n",
    "                finite_stat.sum()\n",
    "            ),\n",
    "\n",
    "        \"n_finite_pvalues\":\n",
    "            int(\n",
    "                finite_p.sum()\n",
    "            ),\n",
    "\n",
    "        \"n_finite_padj\":\n",
    "            int(\n",
    "                finite_padj.sum()\n",
    "            ),\n",
    "\n",
    "        \"n_FDR_lt_0_05\":\n",
    "            int(\n",
    "                genome_sig.sum()\n",
    "            ),\n",
    "\n",
    "        \"n_FDR_lt_0_05_up_in_PD\":\n",
    "            significant_up,\n",
    "\n",
    "        \"n_FDR_lt_0_05_down_in_PD\":\n",
    "            significant_down,\n",
    "\n",
    "        \"n_FDR_lt_0_05_zero_LFC\":\n",
    "            significant_zero,\n",
    "\n",
    "        \"all_gene_results\":\n",
    "            str(\n",
    "                full_results_path\n",
    "            ),\n",
    "\n",
    "        \"all_gene_results_sha256\":\n",
    "            full_results_hash,\n",
    "\n",
    "        \"FDR05_results\":\n",
    "            str(\n",
    "                significant_path\n",
    "            ),\n",
    "\n",
    "        \"rank_vector\":\n",
    "            str(\n",
    "                rank_path\n",
    "            ),\n",
    "\n",
    "        \"size_factors\":\n",
    "            str(\n",
    "                size_factor_path\n",
    "            ),\n",
    "\n",
    "        \"design_matrix\":\n",
    "            str(\n",
    "                design_matrix_path\n",
    "            ),\n",
    "\n",
    "        \"DESeq2_summary_text\":\n",
    "            str(\n",
    "                summary_text_path\n",
    "            ),\n",
    "    }\n",
    "\n",
    "\n",
    "    run_records[\n",
    "        cell_type\n",
    "    ] = (\n",
    "        cell_record\n",
    "    )\n",
    "\n",
    "\n",
    "    summary_rows.append({\n",
    "\n",
    "        \"cell_type\":\n",
    "            cell_type,\n",
    "\n",
    "        \"PD\":\n",
    "            15,\n",
    "\n",
    "        \"Control\":\n",
    "            14,\n",
    "\n",
    "        \"tested_genes\":\n",
    "            int(\n",
    "                len(\n",
    "                    expected_genes\n",
    "                )\n",
    "            ),\n",
    "\n",
    "        \"finite_pvalue\":\n",
    "            int(\n",
    "                finite_p.sum()\n",
    "            ),\n",
    "\n",
    "        \"finite_padj\":\n",
    "            int(\n",
    "                finite_padj.sum()\n",
    "            ),\n",
    "\n",
    "        \"FDR_lt_0.05\":\n",
    "            int(\n",
    "                genome_sig.sum()\n",
    "            ),\n",
    "\n",
    "        \"up_in_PD\":\n",
    "            significant_up,\n",
    "\n",
    "        \"down_in_PD\":\n",
    "            significant_down,\n",
    "    })\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G21. AGGREGATE-ONLY DISPLAY\n",
    "    # ========================================================\n",
    "\n",
    "    print(\n",
    "        \"\\nResult integrity:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Tested genes:\",\n",
    "        f\"{len(expected_genes):,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Finite p-values:\",\n",
    "        f\"{int(finite_p.sum()):,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Finite adjusted p-values:\",\n",
    "        f\"{int(finite_padj.sum()):,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  FDR < 0.05:\",\n",
    "        f\"{int(genome_sig.sum()):,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Up in PD:\",\n",
    "        f\"{significant_up:,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Down in PD:\",\n",
    "        f\"{significant_down:,}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G22. MEMORY CLEANUP\n",
    "    # ========================================================\n",
    "\n",
    "    del universe\n",
    "    del raw\n",
    "    del metadata\n",
    "    del counts\n",
    "    del count_array\n",
    "    del de_meta\n",
    "    del dds\n",
    "    del stats\n",
    "    del results\n",
    "    del significant\n",
    "    del rank_table\n",
    "    del design_matrix\n",
    "\n",
    "    gc.collect()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# H. COMBINED PRIMARY DE SUMMARY\n",
    "# ============================================================\n",
    "\n",
    "summary = pd.DataFrame(\n",
    "    summary_rows\n",
    ")\n",
    "\n",
    "\n",
    "summary[\n",
    "    \"cell_type\"\n",
    "] = pd.Categorical(\n",
    "    summary[\n",
    "        \"cell_type\"\n",
    "    ],\n",
    "    categories=PRIMARY_CLASSES,\n",
    "    ordered=True\n",
    ")\n",
    "\n",
    "\n",
    "summary = (\n",
    "    summary\n",
    "    .sort_values(\n",
    "        \"cell_type\"\n",
    "    )\n",
    "    .reset_index(\n",
    "        drop=True\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "summary[\n",
    "    \"cell_type\"\n",
    "] = (\n",
    "    summary[\n",
    "        \"cell_type\"\n",
    "    ]\n",
    "    .astype(str)\n",
    ")\n",
    "\n",
    "\n",
    "summary.to_csv(\n",
    "    summary_path,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# I. ENVIRONMENT RECORD\n",
    "# ============================================================\n",
    "\n",
    "environment_record = {\n",
    "\n",
    "    \"python\":\n",
    "        platform.python_version(),\n",
    "\n",
    "    \"pydeseq2\":\n",
    "        PYDESEQ2_VERSION,\n",
    "\n",
    "    \"anndata\":\n",
    "        ANNDATA_VERSION,\n",
    "\n",
    "    \"pandas\":\n",
    "        PANDAS_VERSION,\n",    "\n",
    "    \"numpy\":\n",
    "        np.__version__,\n",
    "}\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# J. FINAL DE RUN LOCK\n",
    "# ============================================================\n",
    "\n",
    "DE_RUN_LOCK = {\n",
    "\n",
    "    \"dataset\":\n",
    "        \"GSE243639\",\n",
    "\n",
    "    \"created_utc\":\n",
    "        datetime.now(\n",
    "            timezone.utc\n",
    "        ).isoformat(),\n",
    "\n",
    "    \"analysis\":\n",
    "        \"PRIMARY_PD_vs_Control_DE\",\n",
    "\n",
    "    \"status\":\n",
    "        \"PRIMARY_DE_COMPLETE\",\n",
    "\n",
    "    \"biological_replicate\":\n",
    "        \"human donor\",\n",
    "\n",
    "    \"primary_cell_classes\":\n",
    "        PRIMARY_CLASSES,\n",
    "\n",
    "    \"model\":\n",
    "        \"~ age + sex + diagnosis_binary\",\n",
    "\n",
    "    \"contrast\": [\n",
    "        \"diagnosis_binary\",\n",
    "        \"PD\",\n",
    "        \"Control\",\n",
    "    ],\n",
    "\n",
    "    \"reference_levels\": {\n",
    "\n",
    "        \"diagnosis_binary\":\n",
    "            \"Control\",\n",
    "\n",
    "        \"sex\":\n",
    "            \"Female\",\n",
    "    },\n",
    "\n",
    "    \"DE_engine\":\n",
    "        \"PyDESeq2\",\n",
    "\n",
    "    \"DE_engine_version\":\n",
    "        REQUIRED_PYDESEQ2,\n",
    "\n",
    "    \"cooks_filter\":\n",
    "        True,\n",
    "\n",
    "    \"independent_filter\":\n",
    "        True,\n",
    "\n",
    "    \"FDR\":\n",
    "        0.05,\n",
    "\n",
    "    \"multiple_testing\":\n",
    "        \"Benjamini-Hochberg\",\n",
    "\n",
    "    \"pathway_rank\":\n",
    "        \"signed_DESeq2_Wald_statistic\",\n",
    "\n",
    "    \"gene_universes_refiltered\":\n",
    "        False,\n",
    "\n",
    "    \"secondary_cell_classes_analyzed\":\n",
    "        False,\n",
    "\n",
    "    \"sensitivity_analyses_performed\":\n",
    "        False,\n",
    "\n",
    "    \"cell_class_results\":\n",
    "        run_records,\n",
    "\n",
    "    \"combined_summary\":\n",
    "        str(\n",
    "            summary_path\n",
    "        ),\n",
    "\n",
    "    \"environment\":\n",
    "        environment_record,\n",
    "\n",
    "    \"differential_expression_performed\":\n",
    "        True,\n",
    "\n",
    "    \"all_tested_gene_results_saved\":\n",
    "        True,\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    de_run_lock_path,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        DE_RUN_LOCK,\n",
    "        f,\n",
    "        indent=2\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# K. FINAL REPORT\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 11 PASSED — PRIMARY PD DIFFERENTIAL EXPRESSION COMPLETE\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    summary.to_string(\n",
    "        index=False\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nCombined summary:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    summary_path\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPrimary DE run lock:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    de_run_lock_path\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nALL TESTED GENES SAVED: YES\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"SECONDARY VC/NEURON DE RUN: NO\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"SENSITIVITY ANALYSES RUN: NO\"\n",
    ")\n",
    "'''\n",
    "\n",
    "\n",
    "runner_path.write_text(\n",
    "    textwrap.dedent(\n",
    "        RUNNER\n",
    "    ),\n",
    "    encoding=\"utf-8\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Fresh STEP 11 runner written:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    runner_path\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. VERIFY NEW SUBPROCESS ENVIRONMENT BEFORE DE\n",
    "# ============================================================\n",
    "\n",
    "environment_check = r'''\n",
    "import sys\n",
    "import pandas\n",
    "import anndata\n",
    "import pydeseq2\n",
    "import importlib.metadata\n",
    "\n",
    "print(\"Fresh subprocess versions:\")\n",
    "print(\"Python:\", sys.version.split()[0])\n",
    "print(\"pandas:\", pandas.__version__)\n",
    "print(\"anndata:\", anndata.__version__)\n",
    "print(\n",
    "    \"pydeseq2:\",\n",
    "    importlib.metadata.version(\"pydeseq2\")\n",
    ")\n",
    "\n",
    "# This is the API that failed in the notebook process.\n",
    "x = pandas.StringDtype(na_value=pandas.NA)\n",
    "\n",
    "print(\n",
    "    \"StringDtype na_value API: PASS\"\n",
    ")\n",
    "'''\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nTesting fresh subprocess environment...\"\n",
    ")\n",
    "\n",
    "\n",
    "subprocess.run(\n",
    "    [\n",
    "        sys.executable,\n",
    "        \"-c\",\n",
    "        environment_check,\n",
    "    ],\n",
    "    check=True\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. RUN STEP 11 IN FRESH PYTHON PROCESS\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"LAUNCHING PRIMARY PD DIFFERENTIAL EXPRESSION\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "completed = subprocess.run(\n",
    "    [\n",
    "        sys.executable,\n",
    "        str(\n",
    "            runner_path\n",
    "        ),\n",
    "    ],\n",
    "    check=False\n",
    ")\n",
    "\n",
    "\n",
    "if completed.returncode != 0:\n",
    "\n",
    "    raise RuntimeError(\n",
    "        \"\\nSTEP 11 subprocess failed. \"\n",
    "        f\"Exit code: {completed.returncode}\\n\"\n",
    "        \"Paste the traceback/output exactly as shown.\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. VERIFY FINAL OUTPUT FILES FROM NOTEBOOK PROCESS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "summary_path = (\n",
    "    ROOT /\n",
    "    \"PD_primary_DE\" /\n",
    "    \"GSE243639_PRIMARY_PD_DE_SUMMARY_v1.csv\"\n",
    ")\n",
    "\n",
    "run_lock_path = (\n",
    "    ROOT /\n",
    "    \"locks\" /\n",
    "    \"GSE243639_PRIMARY_PD_DE_RUN_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "assert summary_path.exists(), (\n",
    "    f\"Missing summary: {summary_path}\"\n",
    ")\n",
    "\n",
    "assert run_lock_path.exists(), (\n",
    "    f\"Missing run lock: {run_lock_path}\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"NOTEBOOK-SIDE FINAL VERIFICATION: PASS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Summary:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    summary_path\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nRun lock:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    run_lock_path\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSTEP 11 COMPLETE.\"\n",
    ")"
   ]
