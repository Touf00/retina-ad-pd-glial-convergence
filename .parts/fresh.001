    "\n",
    "        \"primary_FDR\":\n",
    "            n_primary_sig,\n",
    "\n",
    "        \"LFC_pearson\":\n",
    "            lfc_pearson,\n",
    "\n",
    "        \"LFC_spearman\":\n",
    "            lfc_spearman,\n",
    "\n",
    "        \"Wald_spearman\":\n",
    "            wald_spearman,\n",
    "\n",
    "        \"all_gene_direction_concordance\":\n",
    "            direction_concordance,\n",
    "\n",
    "        \"primary_FDR_same_direction\":\n",
    "            n_same_direction,\n",
    "\n",
    "        \"primary_FDR_nominal_p_lt_0.05\":\n",
    "            n_nominal,\n",
    "\n",
    "        \"primary_FDR_still_FDR_lt_0.05\":\n",
    "            n_still_fdr,\n",
    "\n",
    "        \"primary_FDR_PMI_supported\":\n",
    "            n_supported,\n",
    "\n",
    "    })\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nSensitivity summary:\"\n",
    "    )\n",
    "\n",
