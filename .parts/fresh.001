    "    }\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G22. SUMMARY TABLES\n",
    "    # ========================================================\n",
    "\n",
    "    summary_rows.append({\n",
    "\n",
    "        \"cell_type\":\n",
