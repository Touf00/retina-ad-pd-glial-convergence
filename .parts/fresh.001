    "        False,\n",
    "\n",
    "    \"cell_class_results\":\n",
    "        run_records,\n",
    "\n",
    "    \"summary\":\n",
    "        str(\n",
    "            summary_path\n",
    "        ),\n",
    "\n",
    "    \"concordance\":\n",
    "        str(\n",
    "            concordance_path\n",
    "        ),\n",
    "\n",
