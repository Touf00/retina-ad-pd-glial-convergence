    "print(\n",
    "    \"\\nFrozen GSE174367 pre-DE state verified.\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Primary model:\",\n",
    "    pre_de_lock[\n",
    "        \"design_audit\"\n",
    "    ][\n",
    "        \"primary_model\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"AD disease effects previously inspected: NO\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"AD↔PD convergence previously performed: NO\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# D. CELL CLASSES\n",
    "# ============================================================\n",
    "\n",
    "PRIMARY_CLASSES = [\n",
    "\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "for cell_type in PRIMARY_CLASSES:\n",
    "\n",
    "    assert (\n",
    "        cell_type\n",
    "        in\n",
    "        pre_de_lock[\n",
    "            \"cell_class_gene_universes\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# E. HELPERS\n",
    "# ============================================================\n",
    "\n",
    "def sha256_file(\n",
    "    path,\n",
    "    block_size=1024 * 1024\n",
    "):\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\"\n",
    "    ) as f:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            block = f.read(\n",
    "                block_size\n",
    "            )\n",
    "\n",
    "            if not block:\n",
    "                break\n",
    "\n",
    "            h.update(\n",
    "                block\n",
    "            )\n",
    "\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "def ordered_feature_hash(\n",
    "    features\n",
    "):\n",
    "\n",
    "    payload = (\n",
    "        \"\\n\".join(\n",
    "            map(\n",
    "                str,\n",
    "                features\n",
    "            )\n",
    "        )\n",
    "        +\n",
    "        \"\\n\"\n",
    "    ).encode(\n",
    "        \"utf-8\"\n",
    "    )\n",
    "\n",
    "    return hashlib.sha256(\n",
    "        payload\n",
    "    ).hexdigest()\n",
    "\n",
    "\n",
    "def ordered_effect_hash(\n",
    "    df\n",
    "):\n",
    "\n",
    "    columns = [\n",
    "\n",
    "        \"gene_id\",\n",
    "        \"log2FoldChange\",\n",
    "        \"stat\",\n",
    "        \"pvalue\",\n",
    "        \"padj\",\n",
    "\n",
    "    ]\n",
    "\n",
    "\n",
    "    payload = (\n",
    "        df[\n",
    "            columns\n",
    "        ]\n",
    "        .to_csv(\n",
    "            index=False,\n",
    "            lineterminator=\"\\n\"\n",
    "        )\n",
    "        .encode(\n",
    "            \"utf-8\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    return hashlib.sha256(\n",
    "        payload\n",
    "    ).hexdigest()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# F. STORAGE\n",
    "# ============================================================\n",
    "\n",
    "run_records = {}\n",
    "freeze_records = {}\n",
    "\n",
    "summary_rows = []\n",
    "\n",
    "all_effect_tables = []\n",
    "all_fdr_tables = []\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# G. FOUR CELL CLASSES\n",
    "# ============================================================\n",
    "\n",
    "for class_number, cell_type in enumerate(\n",
    "    PRIMARY_CLASSES,\n",
    "    start=1\n",
    "):\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\n\"\n",
    "        +\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"[{class_number}/4] \"\n",
    "        f\"{cell_type} — PRIMARY AD DISCOVERY DE\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G1. FROZEN STEP-20 RECORD\n",
    "    # ========================================================\n",
    "\n",
    "    frozen_record = (\n",
    "        pre_de_lock[\n",
    "            \"cell_class_gene_universes\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    expected_n_genes = int(\n",
    "        frozen_record[\n",
    "            \"frozen_AD_discovery_gene_universe\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        frozen_record[\n",
    "            \"n_AD\"\n",
    "        ]\n",
    "    ) == 11\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        frozen_record[\n",
    "            \"n_Control\"\n",
    "        ]\n",
    "    ) == 7\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        frozen_record[\n",
    "            \"n_total_donors\"\n",
    "        ]\n",
    "    ) == 18\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        frozen_record[\n",
    "            \"minimum_nuclei_per_donor\"\n",
    "        ]\n",
    "    ) == 50\n",
    "\n",
    "\n",
    "    counts_path = Path(\n",
    "        frozen_record[\n",
    "            \"raw_counts_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    metadata_path = Path(\n",
    "        frozen_record[\n",
    "            \"donor_metadata_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    universe_path = Path(\n",
    "        frozen_record[\n",
    "            \"gene_universe_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    for path in [\n",
    "\n",
    "        counts_path,\n",
    "        metadata_path,\n",
    "        universe_path,\n",
    "\n",
    "    ]:\n",
    "\n",
    "        assert path.exists(), (\n",
    "            f\"Missing frozen input: {path}\"\n",
    "        )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G2. LOAD FROZEN GENE UNIVERSE\n",
    "    # ========================================================\n",
    "\n",
    "    universe = pd.read_csv(\n",
    "        universe_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    required_universe_columns = {\n",
    "\n",
    "        \"gene_id\",\n",
    "        \"gene_symbol\",\n",
    "        \"gene_symbol_unique_in_GSE174367\",\n",
    "        \"feature_type\",\n",
    "        \"n_donors_CPM_ge_1\",\n",
    "\n",
    "    }\n",
    "\n",
    "\n",
    "    assert (\n",
    "        required_universe_columns\n",
    "        <=\n",
    "        set(\n",
    "            universe.columns\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        universe\n",
    "    ) == expected_n_genes\n",
    "\n",
    "\n",
    "    assert (\n",
    "        universe[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .is_unique\n",
    "    )\n",
    "\n",
    "\n",
    "    expected_gene_ids = (\n",