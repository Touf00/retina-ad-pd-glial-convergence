   "outputs": [],
   "source": [
    "# Source analysis cell: 30\n",
    "# ============================================================\n",
    "# STEP 16 — GSE157783 PRIMARY PD REPLICATION DE\n",
    "#           + REPLICATION EFFECT FREEZE\n",
    "#\n",
    "# FIRST DISEASE-EXPRESSION ANALYSIS IN THE REPLICATION COHORT.\n",
    "#\n",
    "# IMPORTANT\n",
    "# ---------\n",
    "# - Uses ONLY STEP-15 frozen gene universes.\n",
    "# - Uses ONLY the 11 frozen donors:\n",
    "#       5 PD\n",
    "#       6 Control\n",
    "#\n",
    "# - PRIMARY MODEL:\n",
    "#       ~ age + sex + diagnosis_binary\n",
    "#\n",
    "# - CONTRAST:\n",
    "#       PD vs Control\n",
    "#\n",
    "# - NO gene refiltering.\n",
    "# - NO PMI sensitivity yet.\n",
    "# - NO discovery/replication comparison yet.\n",
    "# - NO selection of genes based on GSE243639.\n",
    "# - ALL tested genes are saved before selective inspection.\n",
    "#\n",
    "# At the end:\n",
    "#   1. primary replication DE is complete;\n",
    "#   2. complete replication effects are frozen + hashed;\n",
    "#   3. GSE243639 has still NOT been compared to GSE157783.\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "import sys\n",
    "import subprocess\n",
    "from pathlib import Path\n",
    "import textwrap\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. FRESH COMPATIBLE ENVIRONMENT\n",
    "# ============================================================\n",
    "\n",
    "TARGET_PANDAS = \"2.3.3\"\n",
    "TARGET_PYDESEQ2 = \"0.5.4\"\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 16 ENVIRONMENT PREPARATION\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "subprocess.check_call(\n",
    "    [\n",
    "        sys.executable,\n",
    "        \"-m\",\n",
    "        \"pip\",\n",
    "        \"install\",\n",
    "        \"-q\",\n",
    "        \"--upgrade\",\n",
    "        f\"pandas=={TARGET_PANDAS}\",\n",
    "        f\"pydeseq2=={TARGET_PYDESEQ2}\",\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. WRITE FRESH STEP-16 RUNNER\n",
    "# ============================================================\n",
    "\n",
    "runner_path = Path(\n",
    "    \"/content/RETINA_ND_STEP16_GSE157783_PRIMARY_REPLICATION_DE.py\"\n",
    ")\n",
    "\n",
    "\n",
    "RUNNER = r'''\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "import sys\n",
    "import platform\n",
    "import hashlib\n",
    "import json\n",
    "import gc\n",
    "import io\n",
    "import contextlib\n",
    "import importlib.metadata\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from packaging.version import Version\n",
    "\n",
    "from pydeseq2.dds import DeseqDataSet\n",
    "from pydeseq2.ds import DeseqStats\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# A. ENVIRONMENT\n",
    "# ============================================================\n",
    "\n",
    "REQUIRED_PYDESEQ2 = \"0.5.4\"\n",
    "MINIMUM_PANDAS = Version(\n",
    "    \"2.3.0\"\n",
    ")\n",
    "\n",
    "\n",
    "def package_version(\n",
    "    name\n",
    "):\n",
    "\n",
    "    try:\n",
    "\n",
    "        return importlib.metadata.version(\n",
    "            name\n",
    "        )\n",
    "\n",
    "    except importlib.metadata.PackageNotFoundError:\n",
    "\n",
    "        return None\n",
    "\n",
    "\n",
    "PYDESEQ2_VERSION = package_version(\n",
    "    \"pydeseq2\"\n",
    ")\n",
    "\n",
    "PANDAS_VERSION = package_version(\n",
    "    \"pandas\"\n",
    ")\n",
    "\n",
    "ANNDATA_VERSION = package_version(\n",
    "    \"anndata\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    PYDESEQ2_VERSION\n",
    "    ==\n",
    "    REQUIRED_PYDESEQ2\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    Version(\n",
    "        PANDAS_VERSION\n",
    "    )\n",
    "    >=\n",
    "    MINIMUM_PANDAS\n",
    ")\n",
    "\n",
    "\n",
    "# Explicit compatibility test for the issue encountered earlier.\n",
    "_ = pd.StringDtype(\n",
    "    na_value=pd.NA\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 16 FRESH SUBPROCESS ENVIRONMENT\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Python:\",\n",
    "    platform.python_version()\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PyDESeq2:\",\n",
    "    PYDESEQ2_VERSION\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"AnnData:\",\n",
    "    ANNDATA_VERSION\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Pandas:\",\n",
    "    PANDAS_VERSION\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"NumPy:\",\n",
    "    np.__version__\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# B. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = (\n",
    "    ROOT /\n",
    "    \"locks\"\n",
    ")\n",
    "\n",
    "MANIFESTS = (\n",
    "    ROOT /\n",
    "    \"manifests\"\n",
    ")\n",
    "\n",
    "UNIVERSES = (\n",
    "    ROOT /\n",
    "    \"GSE157783_gene_universes\"\n",
    ")\n",
    "\n",
    "DE_ROOT = (\n",
    "    ROOT /\n",
    "    \"PD_replication_DE\"\n",
    ")\n",
    "\n",
    "FREEZE_ROOT = (\n",
    "    ROOT /\n",
    "    \"PD_replication_frozen\"\n",
    ")\n",
    "\n",
    "\n",
    "DE_ROOT.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True\n",
    ")\n",
    "\n",
    "FREEZE_ROOT.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True\n",
    ")\n",
    "\n",
    "\n",
    "pre_de_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE157783_REPLICATION_PRE_DE_LOCK_v1.json\"\n",
    ")\n",
    "\n",
    "replication_plan_path = (\n",
    "    LOCKS /\n",
    "    \"GSE157783_PD_REPLICATION_PLAN_v1.json\"\n",
    ")\n",
    "\n",
    "discovery_freeze_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_PD_DISCOVERY_EFFECT_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "de_run_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE157783_PRIMARY_PD_REPLICATION_DE_RUN_v1.json\"\n",
    ")\n",
    "\n",
    "effect_freeze_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE157783_PD_REPLICATION_EFFECT_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "combined_summary_path = (\n",
    "    DE_ROOT /\n",
    "    \"GSE157783_PRIMARY_PD_REPLICATION_DE_SUMMARY_v1.csv\"\n",
    ")\n",
    "\n",
    "combined_effect_path = (\n",
    "    FREEZE_ROOT /\n",
    "    \"GSE157783_PD_REPLICATION_ALL_EFFECTS_LONG_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "combined_fdr_path = (\n",
    "    FREEZE_ROOT /\n",
    "    \"GSE157783_PD_REPLICATION_FDR05_HITS_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "\n",
    "    pre_de_lock_path,\n",
    "    replication_plan_path,\n",
    "    discovery_freeze_path,\n",
    "\n",
    "]:\n",
    "\n",
    "    assert path.exists(), (\n",
    "        f\"Missing required lock: {path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# C. VERIFY FROZEN PRE-DE STATE\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    pre_de_lock_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    pre_de_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    replication_plan_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    replication_plan = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    discovery_freeze_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    discovery_freeze = json.load(f)\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre_de_lock[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"REPLICATION_PRE_DE_LOCK\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre_de_lock[\n",
    "        \"differential_expression_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre_de_lock[\n",
    "        \"replication_disease_effects_inspected\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre_de_lock[\n",
    "        \"discovery_replication_effect_comparison_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    replication_plan[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"PD_REPLICATION_PLAN_FROZEN_BEFORE_ANALYSIS\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    discovery_freeze[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"PD_DISCOVERY_EFFECTS_FROZEN\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre_de_lock[\n",
    "        \"design_audit\"\n",
    "    ][\n",
    "        \"primary_rank\"\n",
    "    ]\n",
    "    ==\n",
    "    4\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre_de_lock[\n",
    "        \"design_audit\"\n",
    "    ][\n",
    "        \"primary_columns\"\n",
    "    ]\n",
    "    ==\n",
    "    4\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFrozen replication pre-DE lock verified.\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Discovery effects already frozen: YES\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Discovery/replication comparison performed: NO\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# D. PRIMARY CELL CLASSES\n",
    "# ============================================================\n",
    "\n",
    "PRIMARY_CLASSES = [\n",
    "\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "for cell_type in PRIMARY_CLASSES:\n",
    "\n",
    "    assert (\n",
    "        cell_type\n",
    "        in\n",
    "        pre_de_lock[\n",
    "            \"cell_class_gene_universes\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# E. HELPERS\n",
    "# ============================================================\n",
    "\n",
    "def sha256_file(\n",
    "    path,\n",
    "    block_size=1024 * 1024\n",
    "):\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\"\n",
    "    ) as f:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            block = f.read(\n",
    "                block_size\n",
    "            )\n",
    "\n",
    "\n",
    "            if not block:\n",
    "\n",
    "                break\n",
    "\n",
    "\n",
    "            h.update(\n",
    "                block\n",
    "            )\n",
    "\n",
    "\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "def ordered_feature_hash(\n",
    "    features\n",
    "):\n",
    "\n",
    "    payload = (\n",
    "\n",
    "        \"\\n\".join(\n",
    "            map(\n",
    "                str,\n",
    "                features\n",
    "            )\n",
    "        )\n",
    "\n",
    "        +\n",
    "\n",
    "        \"\\n\"\n",
    "\n",
    "    ).encode(\n",
    "        \"utf-8\"\n",
    "    )\n",
    "\n",
    "\n",
    "    return hashlib.sha256(\n",
    "        payload\n",
    "    ).hexdigest()\n",
    "\n",
    "\n",
    "def ordered_effect_hash(\n",
    "    df\n",
    "):\n",
    "\n",
    "    columns = [\n",
    "\n",
    "        \"gene_id\",\n",
    "        \"log2FoldChange\",\n",
    "        \"stat\",\n",
    "        \"pvalue\",\n",
    "        \"padj\",\n",
    "\n",
    "    ]\n",
    "\n",
    "\n",
    "    payload = (\n",
    "\n",
    "        df[\n",
    "            columns\n",
    "        ]\n",
    "        .to_csv(\n",
    "            index=False,\n",
    "            lineterminator=\"\\n\"\n",
    "        )\n",
    "        .encode(\n",
    "            \"utf-8\"\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    return hashlib.sha256(\n",
    "        payload\n",
    "    ).hexdigest()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# F. OUTPUT STORAGE\n",
    "# ============================================================\n",
    "\n",
    "run_records = {}\n",
    "\n",
    "freeze_records = {}\n",
    "\n",
    "summary_rows = []\n",
    "\n",
    "all_effect_tables = []\n",
    "\n",
    "all_fdr_tables = []\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# G. LOOP THROUGH FOUR REPLICATION CELL CLASSES\n",
    "# ============================================================\n",
    "\n",
    "for class_number, cell_type in enumerate(\n",
    "    PRIMARY_CLASSES,\n",
    "    start=1\n",
    "):\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\n\"\n",
    "        +\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"[{class_number}/4] \"\n",
    "        f\"{cell_type} — INDEPENDENT PD REPLICATION DE\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G1. FROZEN STEP-15 RECORD\n",
    "    # ========================================================\n",
    "\n",
    "    frozen_record = (\n",
    "\n",
    "        pre_de_lock[\n",
    "            \"cell_class_gene_universes\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    expected_n_genes = int(\n",
    "\n",
    "        frozen_record[\n",
    "            \"frozen_replication_gene_universe\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    counts_path = Path(\n",
    "\n",
    "        frozen_record[\n",
    "            \"raw_counts_file\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    metadata_path = Path(\n",
    "\n",
    "        frozen_record[\n",
    "            \"donor_metadata_file\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    universe_path = Path(\n",
    "\n",
    "        frozen_record[\n",
    "            \"gene_universe_file\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    for path in [\n",
    "\n",
    "        counts_path,\n",
    "        metadata_path,\n",
    "        universe_path,\n",
    "\n",
    "    ]:\n",
    "\n",
    "        assert path.exists(), (\n",
    "            f\"Missing frozen input: {path}\"\n",    "        )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G2. LOAD FROZEN GENE UNIVERSE\n",
    "    # ========================================================\n",
    "\n",
    "    universe = pd.read_csv(\n",
    "        universe_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    required_universe_columns = {\n",
    "\n",
    "        \"gene_id\",\n",
    "        \"gene_symbol\",\n",
    "        \"gene_biotype\",\n",
    "        \"gene_symbol_unique_in_replication\",\n",
    "        \"n_donors_CPM_ge_1\",\n",
    "\n",
    "    }\n",
    "\n",
    "\n",
    "    assert (\n",
    "        required_universe_columns\n",
    "        <=\n",
    "        set(\n",
    "            universe.columns\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        universe\n",
    "    ) == expected_n_genes\n",
    "\n",
    "\n",
    "    assert (\n",
    "        universe[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .is_unique\n",
    "    )\n",
    "\n",
    "\n",
    "    expected_gene_ids = (\n",
    "\n",
    "        universe[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    observed_feature_hash = (\n",
    "        ordered_feature_hash(\n",
    "            expected_gene_ids\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    expected_feature_hash = (\n",
    "\n",
    "        frozen_record[\n",
    "            \"ordered_gene_id_sha256\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        observed_feature_hash\n",
    "        ==\n",
    "        expected_feature_hash\n",
    "    ), (\n",
    "        f\"{cell_type}: frozen gene-universe hash mismatch.\"\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Frozen genes:\",\n",
    "        f\"{expected_n_genes:,}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G3. LOAD FROZEN RAW COUNTS\n",
    "    #\n",
    "    # stored:\n",
    "    #   genes × donors\n",
    "    #\n",
    "    # required by PyDESeq2:\n",
    "    #   donors × genes\n",
    "    # ========================================================\n",
    "\n",
    "    raw = pd.read_csv(\n",
    "        counts_path,\n",
    "        compression=\"gzip\",\n",
    "        index_col=0\n",
    "    )\n",
    "\n",
    "\n",
    "    raw.index = pd.Index(\n",
    "\n",
    "        raw.index\n",
    "        .astype(str)\n",
    "        .tolist(),\n",
    "\n",
    "        dtype=\"object\"\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        raw.index.tolist()\n",
    "        ==\n",
    "        expected_gene_ids\n",
    "    )\n",
    "\n",
    "\n",
    "    assert raw.shape == (\n",
    "        expected_n_genes,\n",
    "        11\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G4. LOAD FROZEN DONOR METADATA\n",
    "    # ========================================================\n",
    "\n",
    "    metadata = pd.read_csv(\n",
    "        metadata_path\n",
    "    )\n",
    "\n",
    "\n",
    "    required_metadata_columns = {\n",
    "\n",
    "        \"pseudobulk_group\",\n",
    "        \"sample_id\",\n",
    "        \"diagnosis_binary\",\n",
    "        \"age\",\n",
    "        \"sex\",\n",
    "        \"PMI\",\n",
    "        \"n_nuclei\",\n",
    "        \"library_size\",\n",
    "\n",
    "    }\n",
    "\n",
    "\n",
    "    assert (\n",
    "        required_metadata_columns\n",
    "        <=\n",
    "        set(\n",
    "            metadata.columns\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        metadata\n",
    "    ) == 11\n",
    "\n",
    "\n",
    "    assert (\n",
    "        metadata[\n",
    "            \"sample_id\"\n",
    "        ]\n",
    "        .nunique()\n",
    "        ==\n",
    "        11\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        metadata[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        .value_counts()\n",
    "        .to_dict()\n",
    "        ==\n",
    "        {\n",
    "            \"Control\": 6,\n",
    "            \"PD\": 5,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        metadata[\n",
    "            \"n_nuclei\"\n",
    "        ]\n",
    "        >=\n",
    "        50\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G5. VERIFY SAMPLE ORDER\n",
    "    # ========================================================\n",
    "\n",
    "    sample_order = (\n",
    "\n",
    "        metadata[\n",
    "            \"pseudobulk_group\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        raw.columns\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "        ==\n",
    "        sample_order\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G6. TRANSPOSE COUNTS\n",
    "    # ========================================================\n",
    "\n",
    "    counts = (\n",
    "\n",
    "        raw.T\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    counts.index = pd.Index(\n",
    "\n",
    "        [\n",
    "            str(x)\n",
    "            for x\n",
    "            in counts.index\n",
    "        ],\n",
    "\n",
    "        dtype=\"object\"\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    counts.columns = pd.Index(\n",
    "\n",
    "        [\n",
    "            str(x)\n",
    "            for x\n",
    "            in counts.columns\n",
    "        ],\n",
    "\n",
    "        dtype=\"object\"\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert counts.shape == (\n",
    "        11,\n",
    "        expected_n_genes\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        counts.index.tolist()\n",
    "        ==\n",
    "        sample_order\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        counts.columns.tolist()\n",
    "        ==\n",
    "        expected_gene_ids\n",
    "    )\n",
    "\n",
    "\n",
    "    count_array = (\n",
    "        counts.to_numpy()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert np.isfinite(\n",
    "        count_array\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    assert (\n",
    "        count_array >= 0\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    assert np.allclose(\n",
    "\n",
    "        count_array,\n",
    "\n",
    "        np.round(\n",
    "            count_array\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    counts = (\n",
    "        counts.astype(\n",
    "            np.int64\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Counts:\",\n",
    "        counts.shape\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G7. PRIMARY DESIGN METADATA\n",
    "    #\n",
    "    # PMI intentionally NOT included in primary model.\n",
    "    # ========================================================\n",
    "\n",
    "    de_meta = (\n",
    "\n",
    "        metadata[\n",
    "            [\n",
    "                \"pseudobulk_group\",\n",
    "                \"sample_id\",\n",
    "                \"age\",\n",
    "                \"sex\",\n",
    "                \"diagnosis_binary\",\n",
    "            ]\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta.index = pd.Index(\n",
    "\n",
    "        de_meta[\n",
    "            \"pseudobulk_group\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist(),\n",
    "\n",
    "        dtype=\"object\"\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta = de_meta.drop(\n",
    "        columns=[\n",
    "            \"pseudobulk_group\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta[\n",
    "        \"sample_id\"\n",
    "    ] = (\n",
    "\n",
    "        de_meta[\n",
    "            \"sample_id\"\n",
    "        ]\n",
    "        .astype(\n",
    "            \"object\"\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta[\n",
    "        \"age\"\n",
    "    ] = pd.to_numeric(\n",
    "\n",
    "        de_meta[\n",
    "            \"age\"\n",
    "        ],\n",
    "\n",
    "        errors=\"raise\"\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta[\n",
    "        \"sex\"\n",
    "    ] = pd.Categorical(\n",
    "\n",
    "        de_meta[\n",
    "            \"sex\"\n",
    "        ]\n",
    "        .astype(str),\n",
    "\n",
    "        categories=[\n",
    "            \"Female\",\n",
    "            \"Male\",\n",
    "        ],\n",
    "\n",
    "        ordered=False\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta[\n",
    "        \"diagnosis_binary\"\n",
    "    ] = pd.Categorical(\n",
    "\n",
    "        de_meta[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        .astype(str),\n",
    "\n",
    "        categories=[\n",
    "            \"Control\",\n",
    "            \"PD\",\n",
    "        ],\n",
    "\n",
    "        ordered=False\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        counts.index.equals(\n",
    "            de_meta.index\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        de_meta[\n",
    "            [\n",
    "                \"age\",\n",
    "                \"sex\",\n",
    "                \"diagnosis_binary\",\n",
    "            ]\n",
    "        ]\n",
    "        .notna()\n",
    "        .all()\n",
    "        .all()\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Metadata:\",\n",
    "        de_meta.shape\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"PD = 5 | Control = 6\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Donor ordering verified: YES\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G8. CONSTRUCT DESEQDATASET\n",
    "    # ========================================================\n",
    "\n",
    "    dds = DeseqDataSet(\n",
    "\n",
    "        counts=counts,\n",
    "\n",
    "        metadata=de_meta,\n",
    "\n",
    "        design=(\n",
    "            \"~ age + sex + diagnosis_binary\"\n",
    "        ),\n",
    "\n",
    "        refit_cooks=True,\n",
    "\n",
    "        n_cpus=2,\n",
    "\n",
    "        quiet=False,\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"DeseqDataSet construction: PASS\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G9. VERIFY ACTUAL PYDESEQ2 DESIGN\n",
    "    # ========================================================\n",
    "\n",
    "    design_matrix = (\n",
    "\n",
    "        dds.obsm[\n",
    "            \"design_matrix\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    design_rank = int(\n",
    "\n",
    "        np.linalg.matrix_rank(\n",
    "\n",
    "            design_matrix.to_numpy()\n",
    "\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    design_columns = int(\n",
    "\n",
    "        design_matrix.shape[\n",
    "            1\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nPyDESeq2 design columns:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        design_matrix.columns.tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Design rank:\",\n",
    "        design_rank,\n",
    "        \"/\",\n",
    "        design_columns\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        design_rank\n",
    "        ==\n",
    "        design_columns\n",
    "        ==\n",
    "        4\n",
    "    )\n",
    "\n",
    "\n",
    "    diagnosis_columns = [\n",
    "\n",
    "        str(column)\n",
    "\n",
    "        for column\n",
    "        in design_matrix.columns\n",
    "\n",
    "        if (\n",
    "            \"diagnosis_binary\"\n",
    "            in str(\n",
    "                column\n",
    "            )\n",
    "        )\n",
    "\n",
    "    ]\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        diagnosis_columns\n",
    "    ) == 1\n",
    "\n",
    "\n",
    "    assert (\n",
    "        \"PD\"\n",
    "        in diagnosis_columns[\n",
    "            0\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G10. OUTPUT DIRECTORY\n",
    "    # ========================================================\n",
    "\n",
    "    class_dir = (\n",
    "\n",
    "        DE_ROOT /\n",
    "        cell_type\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    class_dir.mkdir(\n",
    "        parents=True,\n",
    "        exist_ok=True\n",
    "    )\n",
    "\n",
    "\n",
    "    design_matrix_path = (\n",
    "\n",
    "        class_dir /\n",
    "        (\n",
    "            f\"GSE157783_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"PRIMARY_REPLICATION_DESIGN_MATRIX_v1.csv\"\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    design_matrix.to_csv(\n",
    "        design_matrix_path\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G11. FIT PRIMARY REPLICATION MODEL\n",
    "    # ========================================================\n",
    "\n",
    "    print(\n",
    "        \"\\nRunning DESeq2 replication fit...\"\n",
    "    )\n",
    "\n",
    "\n",
    "    dds.deseq2()\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"DESeq2 replication fit complete.\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G12. SAVE SIZE FACTORS\n",
    "    # ========================================================\n",
    "\n",
    "    assert (\n",
    "        \"size_factors\"\n",
    "        in\n",
    "        dds.obs.columns\n",
    "    )\n",
    "\n",
    "\n",
    "    size_factors = (\n",
    "\n",
    "        dds.obs[\n",
    "            \"size_factors\"\n",
    "        ]\n",
    "        .to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        size_factors\n",
    "    ) == 11\n",
    "\n",
    "\n",
    "    assert np.isfinite(\n",
    "        size_factors\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    assert (\n",
    "        size_factors > 0\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    size_factor_table = pd.DataFrame({\n",
    "\n",
    "        \"pseudobulk_group\":\n",
    "            counts.index.tolist(),\n",
    "\n",
    "        \"sample_id\":\n",
    "            metadata[\n",
    "                \"sample_id\"\n",
    "            ]\n",
    "            .astype(str)\n",
    "            .tolist(),\n",
    "\n",
    "        \"diagnosis_binary\":\n",
    "            metadata[\n",
    "                \"diagnosis_binary\"\n",
    "            ]\n",
    "            .astype(str)\n",
    "            .tolist(),\n",
    "\n",
    "        \"size_factor\":\n",
    "            size_factors,\n",
    "\n",
    "    })\n",
    "\n",
    "\n",
    "    size_factor_path = (\n",
    "\n",
    "        class_dir /\n",
    "        (\n",
    "            f\"GSE157783_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"DESEQ2_SIZE_FACTORS_v1.csv\"\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    size_factor_table.to_csv(\n",
    "        size_factor_path,\n",
    "        index=False\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G13. PD vs CONTROL WALD TEST\n",
    "    #\n",
    "    # Positive log2FC:\n",
    "    #   higher in PD\n",
    "    #\n",
    "    # Negative log2FC:\n",
    "    #   lower in PD\n",
    "    # ========================================================\n",
    "\n",
    "    stats = DeseqStats(\n",
    "\n",
    "        dds,\n",
    "\n",
    "        contrast=[\n",
    "            \"diagnosis_binary\",\n",
    "            \"PD\",\n",
    "            \"Control\",\n",
    "        ],\n",
    "\n",
    "        alpha=0.05,\n",
    "\n",
    "        cooks_filter=True,\n",
    "\n",
    "        independent_filter=True,\n",
    "\n",
    "        n_cpus=2,\n",
    "\n",
    "        quiet=False,\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    captured_summary = io.StringIO()\n",
    "\n",
    "\n",
    "    # Suppress large result printout.\n",
    "    with contextlib.redirect_stdout(\n",
    "        captured_summary\n",
    "    ):\n",
    "\n",
    "        stats.summary()\n",
    "\n",
    "\n",
    "    results = (\n",
    "\n",
    "        stats.results_df\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G14. COMPLETE RESULT INTEGRITY\n",
    "    # ========================================================\n",
    "\n",
    "    results.index = pd.Index(\n",
    "\n",
    "        [\n",
    "            str(x)\n",
    "            for x\n",
    "            in results.index\n",
    "        ],\n",
    "\n",
    "        dtype=\"object\"\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        results.index.is_unique\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        set(\n",
    "            results.index\n",
    "        )\n",
    "        ==\n",
    "        set(\n",
    "            expected_gene_ids\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    # Restore exact STEP-15 frozen universe order.\n",
    "    results = (\n",
    "\n",
    "        results.loc[\n",
    "            expected_gene_ids\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        results.index.tolist()\n",
    "        ==\n",
    "        expected_gene_ids\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        results\n",
    "    ) == expected_n_genes\n",
    "\n",
    "\n",
    "    required_result_columns = [\n",
    "\n",
    "        \"baseMean\",\n",
    "        \"log2FoldChange\",\n",
    "        \"lfcSE\",\n",
    "        \"stat\",\n",
    "        \"pvalue\",\n",
    "        \"padj\",\n",
    "\n",
    "    ]\n",
    "\n",
    "\n",
    "    missing_result_columns = [\n",
    "\n",
    "        column\n",
    "\n",
    "        for column\n",
    "        in required_result_columns\n",
    "\n",
    "        if (\n",
    "            column\n",
    "            not in\n",
    "            results.columns\n",
    "        )\n",
    "\n",
    "    ]\n",
    "\n",
    "\n",
    "    assert not missing_result_columns, (\n",
    "        f\"{cell_type}: missing DE columns \"\n",
    "        f\"{missing_result_columns}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    results.index.name = (\n",
    "        \"gene_id\"\n",
    "    )\n",
    "\n",
    "\n",
    "    results = (\n",
    "\n",
    "        results[\n",
    "            required_result_columns\n",
    "        ]\n",
    "        .reset_index()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G15. ADD FROZEN ANNOTATION\n",
    "    # ========================================================\n",
    "\n",
    "    annotation = (\n",
    "\n",
    "        universe[\n",
    "            [\n",
    "                \"gene_id\",\n",
    "                \"gene_symbol\",\n",
    "                \"gene_biotype\",\n",
    "                \"gene_symbol_unique_in_replication\",\n",
    "            ]\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    results = results.merge(\n",
    "\n",
    "        annotation,\n",
    "\n",
    "        on=\"gene_id\",\n",
    "\n",
    "        how=\"left\",\n",
    "\n",
    "        validate=\"one_to_one\"\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        results[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .notna()\n",
    "        .all()\n",
    "    )\n",
    "\n",
    "\n",
    "    # Restore exact preferred column order.\n",
    "    results = results[\n",
    "        [\n",
    "            \"gene_id\",\n",
    "            \"gene_symbol\",\n",
    "            \"gene_biotype\",\n",
    "            \"gene_symbol_unique_in_replication\",\n",
    "\n",
    "            \"baseMean\",\n",
    "            \"log2FoldChange\",\n",
    "            \"lfcSE\",\n",
    "            \"stat\",\n",
    "            \"pvalue\",\n",
    "            \"padj\",\n",
    "        ]\n",
    "    ]\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G16. PREDECLARED RANK\n",
    "    # ========================================================\n",
    "\n",
    "    results[\n",
    "        \"rank_stat\"\n",
    "    ] = (\n",
    "        results[\n",
    "            \"stat\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    results[\n",
    "        \"cell_type\"\n",
    "    ] = (\n",
    "        cell_type\n",
    "    )\n",
    "\n",
    "\n",
    "    results[\n",
    "        \"contrast\"\n",
    "    ] = (\n",
    "        \"PD_vs_Control\"\n",
    "    )\n",
    "\n",
    "\n",
    "    results[\n",
    "        \"dataset\"\n",
    "    ] = (\n",
    "        \"GSE157783\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G17. SAVE ALL TESTED GENES FIRST\n",
    "    # ========================================================\n",
    "\n",
    "    all_gene_path = (\n",
    "\n",
    "        class_dir /\n",
    "        (\n",
    "            f\"GSE157783_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"PD_vs_Control_\"\n",
    "            f\"PRIMARY_REPLICATION_ALL_GENES_v1.csv.gz\"\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    results.to_csv(\n",
    "\n",
    "        all_gene_path,\n",
    "\n",
    "        index=False,\n",
    "\n",
    "        compression={\n",
    "            \"method\":\n",
    "                \"gzip\",\n",
    "\n",
    "            \"compresslevel\":\n",
    "                6,\n",
    "        }\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        all_gene_path.exists()\n",
    "    )\n",
    "\n",    "\n",
    "    all_gene_file_hash = (\n",
    "        sha256_file(\n",
    "            all_gene_path\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    effect_content_hash = (\n",
    "        ordered_effect_hash(\n",
    "            results\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nComplete all-gene replication result saved.\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G18. QC COUNTS\n",
    "    # ========================================================\n",
    "\n",
    "    finite_lfc = np.isfinite(\n",
    "\n",
    "        results[\n",
    "            \"log2FoldChange\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    finite_stat = np.isfinite(\n",
    "\n",
    "        results[\n",
    "            \"stat\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    finite_p = np.isfinite(\n",
    "\n",
    "        results[\n",
    "            \"pvalue\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    finite_padj = np.isfinite(\n",
    "\n",
    "        results[\n",
    "            \"padj\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    sig_mask = (\n",
    "\n",
    "        finite_padj\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            results[\n",
    "                \"padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    significant = (\n",
    "\n",
    "        results.loc[\n",
    "            sig_mask\n",
    "        ]\n",
    "        .copy()\n",
    "        .sort_values(\n",
    "            [\n",
    "                \"padj\",\n",
    "                \"pvalue\",\n",
    "            ],\n",
    "            ascending=[\n",
    "                True,\n",
    "                True,\n",
    "            ]\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_sig = int(\n",
    "        sig_mask.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_up = int(\n",
    "\n",
    "        (\n",
    "            significant[\n",
    "                \"log2FoldChange\"\n",
    "            ]\n",
    "            >\n",
    "            0\n",
    "        ).sum()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_down = int(\n",
    "\n",
    "        (\n",
    "            significant[\n",
    "                \"log2FoldChange\"\n",
    "            ]\n",
    "            <\n",
    "            0\n",
    "        ).sum()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G19. SAVE FDR TABLE\n",
    "    #\n",
    "    # Convenience output only.\n",
    "    # ========================================================\n",
    "\n",
    "    fdr_path = (\n",
    "\n",
    "        class_dir /\n",
    "        (\n",
    "            f\"GSE157783_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"PD_vs_Control_\"\n",
    "            f\"PRIMARY_REPLICATION_FDR05_v1.csv.gz\"\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    significant.to_csv(\n",
    "\n",
    "        fdr_path,\n",
    "\n",
    "        index=False,\n",
    "\n",
    "        compression={\n",
    "            \"method\":\n",
    "                \"gzip\",\n",
    "\n",
    "            \"compresslevel\":\n",
    "                6,\n",
    "        }\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G20. SAVE COMPLETE WALD RANK VECTOR\n",
    "    # ========================================================\n",
    "\n",
    "    rank_table = (\n",
    "\n",
    "        results[\n",
    "            [\n",
    "                \"gene_id\",\n",
    "                \"gene_symbol\",\n",
    "                \"gene_symbol_unique_in_replication\",\n",
    "                \"rank_stat\",\n",
    "                \"log2FoldChange\",\n",
    "                \"pvalue\",\n",
    "                \"padj\",\n",
    "            ]\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    rank_path = (\n",
    "\n",
    "        class_dir /\n",
    "        (\n",
    "            f\"GSE157783_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"PD_vs_Control_\"\n",
    "            f\"WALD_RANK_VECTOR_v1.csv.gz\"\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    rank_table.to_csv(\n",
    "\n",
    "        rank_path,\n",
    "\n",
    "        index=False,\n",
    "\n",
    "        compression={\n",
    "            \"method\":\n",
    "                \"gzip\",\n",
    "\n",
    "            \"compresslevel\":\n",
    "                6,\n",
    "        }\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G21. SAVE DESEQ2 TEXT SUMMARY\n",
    "    # ========================================================\n",
    "\n",
    "    summary_text_path = (\n",
    "\n",
    "        class_dir /\n",
    "        (\n",
    "            f\"GSE157783_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"DESEQ2_SUMMARY_OUTPUT_v1.txt\"\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    with open(\n",
    "        summary_text_path,\n",
    "        \"w\",\n",
    "        encoding=\"utf-8\"\n",
    "    ) as f:\n",
    "\n",
    "        f.write(\n",
    "            captured_summary.getvalue()\n",
    "        )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G22. CREATE FROZEN EFFECT VECTOR\n",
    "    #\n",
    "    # This is the immutable replication effect vector that\n",
    "    # will be used in STEP 17/18 for independent comparison.\n",
    "    # ========================================================\n",
    "\n",
    "    frozen_effect = (\n",
    "\n",
    "        results[\n",
    "            [\n",
    "                \"gene_id\",\n",
    "                \"gene_symbol\",\n",
    "                \"gene_biotype\",\n",
    "                \"gene_symbol_unique_in_replication\",\n",
    "\n",
    "                \"baseMean\",\n",
    "                \"log2FoldChange\",\n",
    "                \"lfcSE\",\n",
    "                \"stat\",\n",
    "                \"pvalue\",\n",
    "                \"padj\",\n",
    "            ]\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    frozen_effect = frozen_effect.rename(\n",
    "        columns={\n",
    "\n",
    "            \"log2FoldChange\":\n",
    "                \"PD_vs_Control_log2FC\",\n",
    "\n",
    "            \"lfcSE\":\n",
    "                \"PD_vs_Control_lfcSE\",\n",
    "\n",
    "            \"stat\":\n",
    "                \"PD_vs_Control_Wald\",\n",
    "\n",
    "            \"pvalue\":\n",
    "                \"PD_vs_Control_pvalue\",\n",
    "\n",
    "            \"padj\":\n",
    "                \"PD_vs_Control_padj\",\n",
    "\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    frozen_effect.insert(\n",
    "        0,\n",
    "        \"cell_type\",\n",
    "        cell_type\n",
    "    )\n",
    "\n",
    "\n",
    "    frozen_effect[\n",
    "        \"replication_FDR05\"\n",
    "    ] = (\n",
    "\n",
    "        np.isfinite(\n",
    "            frozen_effect[\n",
    "                \"PD_vs_Control_padj\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            frozen_effect[\n",
    "                \"PD_vs_Control_padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    effect_path = (\n",
    "\n",
    "        FREEZE_ROOT /\n",
    "        (\n",
    "            f\"GSE157783_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"PD_REPLICATION_EFFECT_VECTOR_v1.csv.gz\"\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    frozen_effect.to_csv(\n",
    "\n",
    "        effect_path,\n",
    "\n",
    "        index=False,\n",
    "\n",
    "        compression={\n",
    "            \"method\":\n",
    "                \"gzip\",\n",
    "\n",
    "            \"compresslevel\":\n",
    "                6,\n",
    "        }\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    effect_file_hash = (\n",
    "        sha256_file(\n",
    "            effect_path\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G23. RECORD\n",
    "    # ========================================================\n",
    "\n",
    "    run_records[\n",
    "        cell_type\n",
    "    ] = {\n",
    "\n",
    "        \"dataset\":\n",
    "            \"GSE157783\",\n",
    "\n",
    "        \"cell_type\":\n",
    "            cell_type,\n",
    "\n",
    "        \"model\":\n",
    "            \"~ age + sex + diagnosis_binary\",\n",
    "\n",
    "        \"contrast\":\n",
    "            \"PD_vs_Control\",\n",
    "\n",
    "        \"reference_diagnosis\":\n",
    "            \"Control\",\n",
    "\n",
    "        \"reference_sex\":\n",
    "            \"Female\",\n",
    "\n",
    "        \"n_PD\":\n",
    "            5,\n",
    "\n",
    "        \"n_Control\":\n",
    "            6,\n",
    "\n",
    "        \"n_total_donors\":\n",
    "            11,\n",
    "\n",
    "        \"n_tested_genes\":\n",
    "            int(\n",
    "                expected_n_genes\n",
    "            ),\n",
    "\n",
    "        \"frozen_gene_universe_sha256\":\n",
    "            expected_feature_hash,\n",
    "\n",
    "        \"design_rank\":\n",
    "            int(\n",
    "                design_rank\n",
    "            ),\n",
    "\n",
    "        \"design_columns\":\n",
    "            int(\n",
    "                design_columns\n",
    "            ),\n",
    "\n",
    "        \"n_finite_log2FoldChange\":\n",
    "            int(\n",
    "                finite_lfc.sum()\n",
    "            ),\n",
    "\n",
    "        \"n_finite_Wald\":\n",
    "            int(\n",
    "                finite_stat.sum()\n",
    "            ),\n",
    "\n",
    "        \"n_finite_pvalue\":\n",
    "            int(\n",
    "                finite_p.sum()\n",
    "            ),\n",
    "\n",
    "        \"n_finite_padj\":\n",
    "            int(\n",
    "                finite_padj.sum()\n",
    "            ),\n",
    "\n",
    "        \"n_FDR_lt_0_05\":\n",
    "            n_sig,\n",
    "\n",
    "        \"n_FDR_lt_0_05_up_in_PD\":\n",
    "            n_up,\n",
    "\n",
    "        \"n_FDR_lt_0_05_down_in_PD\":\n",
    "            n_down,\n",
    "\n",
    "        \"all_gene_results\":\n",
    "            str(\n",
    "                all_gene_path\n",
    "            ),\n",
    "\n",
    "        \"all_gene_results_sha256\":\n",
    "            all_gene_file_hash,\n",
    "\n",
    "        \"effect_content_sha256\":\n",
    "            effect_content_hash,\n",
    "\n",
    "        \"FDR05_results\":\n",
    "            str(\n",
    "                fdr_path\n",
    "            ),\n",
    "\n",
    "        \"rank_vector\":\n",
    "            str(\n",
    "                rank_path\n",
    "            ),\n",
    "\n",
    "        \"size_factors\":\n",
    "            str(\n",
    "                size_factor_path\n",
    "            ),\n",
    "\n",
    "        \"design_matrix\":\n",
    "            str(\n",
    "                design_matrix_path\n",
    "            ),\n",
    "\n",
    "        \"DESeq2_summary_text\":\n",
    "            str(\n",
    "                summary_text_path\n",
