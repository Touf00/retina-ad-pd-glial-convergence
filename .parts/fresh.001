    "    \"GSE174367_PRIMARY_AD_DISCOVERY_DE_SUMMARY_v1.csv\"\n",
    ")\n",
    "\n",
    "combined_effect_path = (\n",
    "    FREEZE_ROOT /\n",
    "    \"GSE174367_AD_DISCOVERY_ALL_EFFECTS_LONG_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "combined_fdr_path = (\n",
    "    FREEZE_ROOT /\n",
    "    \"GSE174367_AD_DISCOVERY_FDR05_HITS_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "\n",
    "    pre_de_lock_path,\n",
    "    data_audit_lock_path,\n",
    "    dataset_role_lock_path,\n",
    "\n",
    "]:\n",
    "\n",
    "    assert path.exists(), (\n",
    "        f\"Missing required lock: {path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# C. VERIFY FROZEN PRE-DE STATE\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
