  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 34\n",
    "# ============================================================\n",
    "# STEP 18A — FREEZE PD REPLICATION EVIDENCE\n",
    "#            + IDENTIFY REPLICATED DISCOVERY GENES\n",
    "#\n",
    "# NO NEW DE.\n",
    "# NO NEW THRESHOLDS.\n",
    "# NO NEW GENE SELECTION.\n",
    "#\n",
    "# PURPOSE\n",
    "# -------\n",
    "# 1. Audit STEP-18 comparison outputs.\n",
    "# 2. Apply ONLY the already-preregistered evidence rules.\n",
    "# 3. Freeze class-level PD replication evidence.\n",
    "# 4. List the exact discovery FDR genes that replicated.\n",
    "# 5. Quantify Micro reverse-direction behavior descriptively.\n",
    "#\n",
    "# IMPORTANT\n",
    "# ---------\n",
    "# The Micro lower-tail binomial test below is explicitly\n",
    "# POST HOC DIAGNOSTIC ONLY.\n",
    "#\n",    "# It does NOT modify the preregistered replication criteria.\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import hashlib\n",
    "import json\n",
    "\n",
    "from scipy.stats import binomtest\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = ROOT / \"locks\"\n",
    "\n",
    "COMPARE_ROOT = (\n",
    "    ROOT /\n",
    "    \"PD_discovery_replication_comparison\"\n",
    ")\n",
    "\n",
    "\n",
    "comparison_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_GSE157783_PD_REPLICATION_COMPARISON_v1.json\"\n",
    ")\n",
    "\n",
    "null_plan_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_GSE157783_PD_COMPARISON_NULL_PLAN_v1.json\"\n",
    ")\n",
    "\n",
    "summary_path = (\n",
    "    COMPARE_ROOT /\n",
    "    \"PD_DISCOVERY_REPLICATION_SUMMARY_v1.csv\"\n",
    ")\n",
    "\n",
    "hit_summary_path = (\n",
    "    COMPARE_ROOT /\n",
    "    \"PD_DISCOVERY_FDR_REPLICATION_SUMMARY_v1.csv\"\n",
    ")\n",
    "\n",
    "combined_hits_path = (\n",
    "    COMPARE_ROOT /\n",
    "    \"PD_DISCOVERY_FDR_GENE_REPLICATION_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "evidence_table_path = (\n",
    "    COMPARE_ROOT /\n",
    "    \"PD_REPLICATION_EVIDENCE_MATRIX_v1.csv\"\n",
    ")\n",
    "\n",
    "replicated_hits_path = (\n",
    "    COMPARE_ROOT /\n",
    "    \"PD_PREREGISTERED_GENE_LEVEL_REPLICATION_SUCCESSES_v1.csv\"\n",
    ")\n",
    "\n",
    "PMI_robust_hits_path = (\n",
    "    COMPARE_ROOT /\n",
    "    \"PD_GENE_LEVEL_REPLICATION_SUCCESSES_PMI_SUPPORTED_v1.csv\"\n",
    ")\n",
    "\n",
    "evidence_lock_path = (\n",
    "    LOCKS /\n",
    "    \"PD_REPLICATION_EVIDENCE_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "    comparison_lock_path,\n",
    "    null_plan_path,\n",
    "    summary_path,\n",
    "    hit_summary_path,\n",
    "    combined_hits_path,\n",
    "]:\n",
    "\n",
    "    assert path.exists(), (\n",
    "        f\"Missing required file: {path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. LOAD LOCKS\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    comparison_lock_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    comparison_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    null_plan_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    null_plan = json.load(f)\n",
    "\n",
    "\n",
    "assert (\n",
    "    comparison_lock[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"PD_DISCOVERY_REPLICATION_COMPARISON_COMPLETE\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    comparison_lock[\n",
    "        \"comparison_was_performed_only_after_both_effect_sets_frozen\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    comparison_lock[\n",
    "        \"posthoc_gene_selection\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    null_plan[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"CROSS_DATASET_NULL_PLAN_FROZEN\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    null_plan[\n",
    "        \"written_before_effect_vectors_loaded\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 18 COMPARISON LOCKS VERIFIED\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. HASH HELPER\n",
    "# ============================================================\n",
    "\n",
    "def sha256_file(\n",
    "    path,\n",
    "    block_size=1024 * 1024\n",
    "):\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\"\n",
    "    ) as f:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            block = f.read(\n",
    "                block_size\n",
    "            )\n",
    "\n",
    "            if not block:\n",
    "                break\n",
    "\n",
    "            h.update(\n",
    "                block\n",
    "            )\n",
    "\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. LOAD SUMMARIES\n",
    "# ============================================================\n",
    "\n",
    "summary = pd.read_csv(\n",
    "    summary_path\n",
    ")\n",
    "\n",
    "hit_summary = pd.read_csv(\n",
    "    hit_summary_path\n",
    ")\n",
    "\n",
    "hits = pd.read_csv(\n",
    "    combined_hits_path,\n",
    "    compression=\"gzip\"\n",
    ")\n",
    "\n",
    "\n",
    "CELL_CLASSES = [\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "]\n",
    "\n",
    "\n",
    "assert (\n",
    "    summary[\n",
    "        \"cell_type\"\n",
    "    ].tolist()\n",
    "    ==\n",
    "    CELL_CLASSES\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    hit_summary[\n",
    "        \"cell_type\"\n",
    "    ].tolist()\n",
    "    ==\n",
    "    CELL_CLASSES\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    hits\n",
    ") == int(\n",
    "    hit_summary[\n",
    "        \"discovery_FDR_measurable\"\n",
    "    ].sum()\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. VERIFY PER-CLASS FILE HASHES\n",
    "# ============================================================\n",
    "\n",
    "for cell_type in CELL_CLASSES:\n",
    "\n",
    "    record = (\n",
    "        comparison_lock[\n",
    "            \"cell_class_results\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    matched_path = Path(\n",
    "        record[\n",
    "            \"matched_gene_table\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    hit_path = Path(\n",
    "        record[\n",
    "            \"discovery_FDR_replication_table\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert matched_path.exists()\n",
    "    assert hit_path.exists()\n",
    "\n",
    "\n",
    "    assert (\n",
    "        sha256_file(\n",
    "            matched_path\n",
    "        )\n",
    "        ==\n",
    "        record[\n",
    "            \"matched_gene_table_sha256\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        sha256_file(\n",
    "            hit_path\n",
    "        )\n",
    "        ==\n",
    "        record[\n",
    "            \"discovery_FDR_replication_table_sha256\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "print(\n",
    "    \"All STEP-18 per-class hashes: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. BOOLEAN NORMALIZATION\n",
    "# ============================================================\n",
    "\n",
    "def as_bool(\n",
    "    series\n",
    "):\n",
    "\n",
    "    if pd.api.types.is_bool_dtype(\n",
    "        series\n",
    "    ):\n",
    "\n",
    "        return series.astype(\n",
    "            bool\n",
    "        )\n",
    "\n",
    "\n",
    "    return (\n",
    "        series\n",
    "        .astype(str)\n",
    "        .str.strip()\n",
    "        .str.lower()\n",
    "        .map(\n",
    "            {\n",
    "                \"true\": True,\n",
    "                \"false\": False,\n",
    "                \"1\": True,\n",
    "                \"0\": False,\n",
    "            }\n",
    "        )\n",
    "        .fillna(\n",
    "            False\n",
    "        )\n",
    "        .astype(\n",
    "            bool\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "for column in [\n",
    "\n",
    "    \"discovery_primary_FDR05\",\n",
    "    \"same_direction\",\n",
    "    \"replication_nominal_p_lt_0.05\",\n",
    "    \"gene_level_replication_success\",\n",
    "    \"replication_FDR_same_direction\",\n",
    "    \"PMI_same_direction_as_discovery\",\n",
    "    \"PMI_nominal_p_lt_0.05\",\n",
    "    \"gene_level_replication_success_PMI_supported\",\n",
    "\n",
    "]:\n",
    "\n",
    "    assert column in hits.columns\n",
    "\n",
    "    hits[\n",
    "        column\n",
    "    ] = as_bool(\n",
    "        hits[\n",
    "            column\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. VERIFY PREREGISTERED GENE-LEVEL RULE\n",
    "# ============================================================\n",
    "\n",
    "recalculated_success = (\n",
    "\n",
    "    hits[\n",
    "        \"same_direction\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    hits[\n",
    "        \"replication_nominal_p_lt_0.05\"\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert np.array_equal(\n",
    "\n",
    "    recalculated_success.to_numpy(),\n",
    "\n",
    "    hits[\n",
    "        \"gene_level_replication_success\"\n",
    "    ].to_numpy(),\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "recalculated_PMI_support = (\n",
    "\n",
    "    hits[\n",
    "        \"gene_level_replication_success\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    hits[\n",
    "        \"PMI_same_direction_as_discovery\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    hits[\n",
    "        \"PMI_nominal_p_lt_0.05\"\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert np.array_equal(\n",
    "\n",
    "    recalculated_PMI_support.to_numpy(),\n",
    "\n",
    "    hits[\n",
    "        \"gene_level_replication_success_PMI_supported\"\n",
    "    ].to_numpy(),\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Preregistered individual-gene replication rule: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. EXACT REPLICATED GENES\n",
    "# ============================================================\n",
    "\n",
    "replicated_hits = (\n",
    "\n",
    "    hits[\n",
    "        hits[\n",
    "            \"gene_level_replication_success\"\n",
    "        ]\n",
    "    ]\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "\n",
    "PMI_robust_hits = (\n",
    "\n",
    "    replicated_hits[\n",
    "        replicated_hits[\n",
    "            \"gene_level_replication_success_PMI_supported\"\n",
    "        ]\n",
    "    ]\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    replicated_hits\n",
    ") == int(\n",
    "    hit_summary[\n",
    "        \"gene_level_replication_success\"\n",
    "    ].sum()\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    PMI_robust_hits\n",
    ") == int(\n",
    "    hit_summary[\n",
    "        \"gene_level_replication_success_PMI_supported\"\n",
    "    ].sum()\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nTotal preregistered gene-level replication successes:\",\n",
    "    len(\n",
    "        replicated_hits\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Of those, PMI-supported:\",\n",
    "    len(\n",
    "        PMI_robust_hits\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. CLEAN DISPLAY TABLE\n",
    "# ============================================================\n",
    "\n",
    "display_columns = [\n",
    "\n",
    "    \"cell_type\",\n",
    "    \"gene_symbol\",\n",
    "\n",
    "    \"discovery_LFC\",\n",
    "    \"discovery_padj\",\n",
    "\n",
    "    \"replication_LFC\",\n",
    "    \"replication_p\",\n",
    "    \"replication_padj\",\n",
    "\n",
    "    \"PMI_LFC\",\n",
    "    \"PMI_p\",\n",
    "    \"PMI_padj\",\n",
    "\n",
    "    \"gene_level_replication_success_PMI_supported\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "for column in display_columns:\n",
    "\n",
    "    assert column in replicated_hits.columns\n",
    "\n",
    "\n",
    "replicated_hits_display = (\n",
    "\n",
    "    replicated_hits[\n",
    "        display_columns\n",
    "    ]\n",
    "    .sort_values(\n",
    "        [\n",
    "            \"cell_type\",\n",
    "            \"replication_p\",\n",
    "        ]\n",
    "    )\n",
    "    .reset_index(\n",
    "        drop=True\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Prespecified gene-level successes: \"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    replicated_hits_display\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. SAVE EXACT GENE LISTS\n",
    "# ============================================================\n",
    "\n",
    "replicated_hits_display.to_csv(\n",
    "    replicated_hits_path,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "PMI_robust_hits[\n",
    "    display_columns\n",
    "].sort_values(\n",
    "    [\n",
    "        \"cell_type\",\n",
    "        \"replication_p\",\n",
    "    ]\n",
    ").to_csv(\n",
    "    PMI_robust_hits_path,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. CLASS-LEVEL EVIDENCE MATRIX\n",
    "#\n",
    "# IMPORTANT:\n",
    "#\n",
    "# \"vector_level_replication_supported\" is based strictly on:\n",
    "#\n",
    "#   positive LFC rho\n",
    "#   LFC permutation q < 0.05\n",
    "#   positive Wald rho\n",
    "#   Wald permutation q < 0.05\n",
    "#\n",
    "# These are the preregistered all-gene replication metrics.\n",
    "#\n",
    "# This is NOT an invented gene threshold.\n",
    "# ============================================================\n",
    "\n",
    "evidence = (\n",
    "\n",
    "    summary.merge(\n",
    "        hit_summary,\n",
    "        on=\"cell_type\",\n",
    "        validate=\"one_to_one\"\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "evidence[\n",
    "    \"vector_level_replication_supported\"\n",
    "] = (\n",
    "\n",
    "    (\n",
    "        evidence[\n",
    "            \"LFC_spearman\"\n",
    "        ]\n",
    "        >\n",
    "        0\n",
    "    )\n",
    "\n",
    "    &\n",
    "\n",
    "    (\n",
    "        evidence[\n",
    "            \"LFC_permutation_q_BH\"\n",
    "        ]\n",
    "        <\n",
    "        0.05\n",
    "    )\n",
    "\n",
    "    &\n",
    "\n",
    "    (\n",
    "        evidence[\n",
    "            \"Wald_spearman\"\n",
    "        ]\n",
    "        >\n",
    "        0\n",
    "    )\n",
    "\n",
    "    &\n",
    "\n",
    "    (\n",
    "        evidence[\n",
    "            \"Wald_permutation_q_BH\"\n",
    "        ]\n",
    "        <\n",
    "        0.05\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "evidence[\n",
    "    \"discovery_hit_direction_enrichment_supported\"\n",
    "] = (\n",
    "\n",
    "    evidence[\n",
    "        \"direction_binomial_q_BH\"\n",
    "    ]\n",
    "    <\n",
    "    0.05\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. POST-HOC MICRO DIAGNOSTIC\n",
    "#\n",
    "# The preregistered test asked:\n",
    "#   \"are MORE than half in the same direction?\"\n",
    "#\n",
    "# Micro failed that test dramatically.\n",
    "#\n",
    "# This lower-tail test asks descriptively:\n",
    "#   \"are FEWER than half in the same direction?\"\n",
    "#\n",
    "# This is POST HOC.\n",
    "# It MUST NOT replace the preregistered test.\n",
    "# ============================================================\n",
    "\n",
    "micro_row = (\n",
    "\n",
    "    hit_summary[\n",
    "        hit_summary[\n",
    "            \"cell_type\"\n",
    "        ]\n",
    "        ==\n",
    "        \"Micro\"\n",
    "    ]\n",
    "    .iloc[\n",
    "        0\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "micro_same = int(\n",
    "    micro_row[\n",
    "        \"same_direction\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "micro_n = int(\n",
    "    micro_row[\n",
    "        \"discovery_FDR_measurable\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "micro_reverse_diagnostic = binomtest(\n",
    "\n",
    "    k=\n",
    "        micro_same,\n",
    "\n",
    "    n=\n",
    "        micro_n,\n",
    "\n",
    "    p=\n",
    "        0.5,\n",
    "\n",
    "    alternative=\n",
    "        \"less\",\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "micro_lower_tail_p_posthoc = float(\n",
    "    micro_reverse_diagnostic.pvalue\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"POST-HOC MICRO DIRECTION DIAGNOSTIC\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Same-direction discovery hits:\",\n",
    "    f\"{micro_same}/{micro_n}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Same-direction fraction:\",\n",
    "    micro_same / micro_n\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Post-hoc lower-tail binomial p:\",\n",
    "    micro_lower_tail_p_posthoc\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"INTERPRETATION STATUS: DIAGNOSTIC ONLY\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 12. EVIDENCE TIER LABELS\n",
    "#\n",
    "# These labels summarize the already-frozen evidence.\n",
    "# They do NOT alter any statistical result.\n",
    "# ============================================================\n",
    "\n",
    "def evidence_label(\n",
    "    row\n",
    "):\n",
    "\n",
    "    if not bool(\n",
    "        row[\n",
    "            \"vector_level_replication_supported\"\n",
    "        ]\n",
    "    ):\n",
    "\n",
    "        return (\n",
    "            \"NOT_REPLICATED_AT_GENE_EFFECT_VECTOR_LEVEL\"\n",
    "        )\n",
    "\n",
    "\n",
    "    n_gene_success = int(\n",
    "        row[\n",
    "            \"gene_level_replication_success\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    n_hits = int(\n",
    "        row[\n",
    "            \"discovery_FDR_measurable\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    if (\n",
    "        n_gene_success\n",
    "        >\n",
    "        0\n",
    "    ):\n",
    "\n",
    "        return (\n",
    "            \"VECTOR_REPLICATION_WITH_SOME_GENE_LEVEL_SUPPORT\"\n",
    "        )\n",
    "\n",
    "\n",
    "    return (\n",
    "        \"VECTOR_REPLICATION_WITHOUT_INDIVIDUAL_GENE_CONFIRMATION\"\n",
    "    )\n",
    "\n",
    "\n",
    "evidence[\n",
    "    \"evidence_label\"\n",
    "] = evidence.apply(\n",
    "    evidence_label,\n",
    "    axis=1\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 13. SAVE EVIDENCE MATRIX\n",
    "# ============================================================\n",
    "\n",
    "evidence_columns = [\n",
    "\n",
    "    \"cell_type\",\n",
    "\n",
    "    \"matched_unique_genes\",\n",
    "\n",
    "    \"LFC_spearman\",\n",
    "    \"LFC_permutation_q_BH\",\n",
    "\n",
    "    \"Wald_spearman\",\n",
    "    \"Wald_permutation_q_BH\",\n",
    "\n",
    "    \"all_gene_direction_concordance\",\n",
    "\n",
    "    \"vector_level_replication_supported\",\n",
    "\n",
    "    \"discovery_FDR_total\",\n",
    "    \"discovery_FDR_measurable\",\n",
    "\n",
    "    \"same_direction\",\n",
    "    \"same_direction_fraction\",\n",
    "\n",
    "    \"direction_binomial_q_BH\",\n",
    "\n",
    "    \"discovery_hit_direction_enrichment_supported\",\n",
    "\n",
    "    \"gene_level_replication_success\",\n",
    "    \"gene_level_replication_fraction\",\n",
    "\n",
    "    \"replication_FDR_same_direction\",\n",
    "\n",
    "    \"gene_level_replication_success_PMI_supported\",\n",
    "\n",
    "    \"evidence_label\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "evidence[\n",
    "    evidence_columns\n",
    "].to_csv(\n",
    "    evidence_table_path,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 14. FINAL EVIDENCE FREEZE LOCK\n",
    "# ============================================================\n",
    "\n",
    "EVIDENCE_LOCK = {\n",
    "\n",
    "    \"created_utc\":\n",
    "        datetime.now(\n",
    "            timezone.utc\n",
    "        ).isoformat(),\n",
    "\n",
    "    \"status\":\n",
    "        \"PD_REPLICATION_EVIDENCE_FROZEN\",\n",
    "\n",
    "    \"discovery_dataset\":\n",
    "        \"GSE243639\",\n",
    "\n",
    "    \"replication_dataset\":\n",
    "        \"GSE157783\",\n",
    "\n",
    "    \"comparison_lock\":\n",
    "        str(\n",
    "            comparison_lock_path\n",
    "        ),\n",
    "\n",
    "    \"null_plan\":\n",
    "        str(\n",
    "            null_plan_path\n",
    "        ),\n",
    "\n",
    "    \"primary_class_level_rule\":\n",
    "        (\n",
    "            \"positive LFC Spearman with BH q<0.05 \"\n",
    "            \"AND positive Wald Spearman with BH q<0.05\"\n",
    "        ),\n",
    "\n",
    "    \"individual_gene_rule\":\n",
    "        (\n",
    "            \"same direction AND replication primary \"\n",
    "            \"nominal two-sided p<0.05\"\n",
    "        ),\n",
    "\n",
    "    \"replication_FDR_required\":\n",
    "        False,\n",
    "\n",
    "    \"PMI_role\":\n",
    "        \"robustness_annotation_only\",\n",
    "\n",
    "    \"evidence_matrix\":\n",
    "        str(\n",
    "            evidence_table_path\n",
    "        ),\n",
    "\n",
    "    \"replicated_discovery_genes\":\n",
    "        str(\n",
    "            replicated_hits_path\n",
    "        ),\n",
    "\n",
    "    \"PMI_supported_replicated_discovery_genes\":\n",
    "        str(\n",
    "            PMI_robust_hits_path\n",
    "        ),\n",
    "\n",
    "    \"n_total_measurable_discovery_FDR_hits\":\n",
    "        int(\n",
    "            hit_summary[\n",
    "                \"discovery_FDR_measurable\"\n",
    "            ].sum()\n",
    "        ),\n",
    "\n",
    "    \"n_total_gene_level_replication_successes\":\n",
    "        int(\n",
    "            len(\n",
    "                replicated_hits\n",
    "            )\n",
    "        ),\n",
    "\n",
    "    \"n_total_gene_level_replication_successes_PMI_supported\":\n",
    "        int(\n",
    "            len(\n",
    "                PMI_robust_hits\n",
    "            )\n",
    "        ),\n",
    "\n",
    "    \"posthoc_micro_lower_tail_binomial\": {\n",
    "\n",
    "        \"performed\":\n",
    "            True,\n",
    "\n",
    "        \"purpose\":\n",
    "            \"diagnostic_only\",\n",
    "\n",
    "        \"same_direction\":\n",
    "            micro_same,\n",
    "\n",
    "        \"n\":\n",
    "            micro_n,\n",
    "\n",
    "        \"p_less_than_0_5\":\n",
    "            micro_lower_tail_p_posthoc,\n",
    "\n",
    "        \"changes_preregistered_conclusion\":\n",
    "            False,\n",
    "    },\n",
    "\n",
    "    \"no_reanalysis_or_threshold_change\":\n",
    "        True,\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",    "    evidence_lock_path,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        EVIDENCE_LOCK,\n",
    "        f,\n",
    "        indent=2\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 15. FINAL REPORT\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 18A PASSED — PD REPLICATION EVIDENCE FROZEN\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPD REPLICATION EVIDENCE MATRIX\"\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    evidence[\n",
    "        evidence_columns\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nExact preregistered replicated discovery genes:\"\n",
    ")\n",
    "\n",
    "display(\n",
    "    replicated_hits_display\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nEvidence matrix:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    evidence_table_path\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nReplicated gene list:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    replicated_hits_path\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPMI-supported replicated gene list:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    PMI_robust_hits_path\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nEvidence freeze lock:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    evidence_lock_path\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nNO NEW DIFFERENTIAL EXPRESSION WAS RUN.\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"NO THRESHOLD WAS CHANGED.\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PD DISCOVERY/REPLICATION ARM IS NOW COMPLETE.\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nNEXT:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Start the AD brain discovery/replication arm \"\n",
    "    \"and freeze AD effects before any AD↔PD convergence analysis.\"\n",
    ")"
   ]
  },
