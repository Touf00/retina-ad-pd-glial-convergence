    "# Source analysis cell: 13\n",
    "# ============================================================\n",
    "# STEP 7 — LOAD AUTHOR CELL-LEVEL ANNOTATIONS\n",
    "# ============================================================\n",
    "\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "import requests\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "PD_DIR = ROOT / \"GSE243639_PD_discovery\"\n",
    "\n",
    "umap_path = (\n",
    "    PD_DIR /\n",
    "    \"GSE243639_UMAP_coordinates.xlsx\"\n",
    ")\n",
    "\n",
    "umap_url = (\n",
    "    \"https://ftp.ncbi.nlm.nih.gov/geo/series/GSE243nnn/\"\n",
    "    \"GSE243639/suppl/\"\n",
    "    \"GSE243639_UMAP_coordinates.xlsx\"\n",
    ")\n",
    "\n",
    "if not umap_path.exists():\n",
    "\n",
    "    print(\"Downloading cell annotation workbook...\")\n",
    "\n",
    "    r = requests.get(\n",
    "        umap_url,\n",
    "        timeout=180\n",
    "    )\n",
    "\n",
    "    r.raise_for_status()\n",
    "\n",
    "    umap_path.write_bytes(r.content)\n",
    "\n",
    "    print(\n",
    "        \"Downloaded:\",\n",
    "        round(\n",
    "            umap_path.stat().st_size / 1e6,\n",
    "            2\n",
    "        ),\n",
    "        \"MB\"\n",
    "    )\n",
    "\n",
    "else:\n",
    "\n",
    "    print(\n",
    "        \"Annotation workbook already exists:\",\n",
    "        umap_path\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# Inspect all sheets first\n",
    "# ============================================================\n",
    "\n",
    "xls = pd.ExcelFile(umap_path)\n",
    "\n",
    "print(\"\\nSheets:\")\n",
    "print(xls.sheet_names)\n",
    "\n",
    "for sheet in xls.sheet_names:\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 80)\n",
    "    print(\"SHEET:\", sheet)\n",
    "    print(\"=\" * 80)\n",
    "\n",
    "    tmp = pd.read_excel(\n",
    "        umap_path,\n",
    "        sheet_name=sheet,\n",
    "        nrows=10\n",
    "    )\n",
    "\n",
    "    print(\"Shape preview:\", tmp.shape)\n",
    "\n",
    "    print(\"\\nColumns:\")\n",
    "    for i, col in enumerate(tmp.columns):\n",
    "        print(i, repr(col))\n",
    "\n",
    "    display(tmp.head(10))"
   ]
