    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    pre_de_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    data_audit_lock_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    data_audit = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    dataset_role_lock_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    role_lock = json.load(f)\n",
    "\n",
    "\n",
    "assert (\n",
