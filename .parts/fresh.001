    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSensitivity-support freeze:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    sensitivity_support_lock_path\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nNO DISCOVERY DATA LOADED: YES\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"DISCOVERY/REPLICATION COMPARISON: NO\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nNEXT:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 18 — first frozen GSE243639 ↔ GSE157783 \"\n",
    "    \"replication comparison using the preregistered metrics.\"\n",
    ")\n",
    "'''\n",
    "\n",
    "\n",
    "runner_path.write_text(\n",
    "    textwrap.dedent(\n",
    "        RUNNER\n",
    "    ),\n",
    "    encoding=\"utf-8\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"STEP 17 runner written:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    runner_path\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. ENVIRONMENT CHECK\n",
    "# ============================================================\n",
    "\n",
    "environment_check = r'''\n",
    "import pandas\n",
    "import anndata\n",
    "import importlib.metadata\n",
    "\n",
    "print(\"Fresh subprocess:\")\n",
    "print(\"pandas:\", pandas.__version__)\n",
    "print(\"anndata:\", anndata.__version__)\n",
    "print(\n",
    "    \"pydeseq2:\",\n",
    "    importlib.metadata.version(\"pydeseq2\")\n",
    ")\n",
    "\n",
    "_ = pandas.StringDtype(\n",
    "    na_value=pandas.NA\n",
    ")\n",
    "\n",
    "print(\"Compatibility: PASS\")\n",
    "'''\n",
    "\n",
    "\n",
    "subprocess.run(\n",
    "    [\n",
    "        sys.executable,\n",
    "        \"-c\",\n",
    "        environment_check,\n",
    "    ],\n",
    "    check=True\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. RUN\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"LAUNCHING GSE157783 PMI SENSITIVITY\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "completed = subprocess.run(\n",
    "    [\n",
    "        sys.executable,\n",
    "        str(\n",
    "            runner_path\n",
    "        ),\n",
    "    ],\n",
    "    check=False\n",
    ")\n",
    "\n",
    "\n",
    "if completed.returncode != 0:\n",
    "\n",
    "    raise RuntimeError(\n",
    "        \"\\nSTEP 17 subprocess failed. \"\n",
    "        f\"Exit code: {completed.returncode}\\n\"\n",
    "        \"Paste the traceback/output exactly.\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. NOTEBOOK-SIDE VERIFICATION\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "\n",
    "summary_path = (\n",
    "    ROOT /\n",
    "    \"PD_replication_sensitivity\" /\n",
    "    \"GSE157783_PD_REPLICATION_PMI_SENSITIVITY_SUMMARY_v1.csv\"\n",
    ")\n",
    "\n",
    "concordance_path = (\n",
    "    ROOT /\n",
    "    \"PD_replication_sensitivity\" /\n",
    "    \"GSE157783_PD_REPLICATION_PMI_CONCORDANCE_v1.csv\"\n",
    ")\n",
    "\n",
    "lock_path = (\n",
    "    ROOT /\n",
    "    \"locks\" /\n",
    "    \"GSE157783_PD_REPLICATION_PMI_SENSITIVITY_v1.json\"\n",
    ")\n",
    "\n",
    "support_lock_path = (\n",
    "    ROOT /\n",
    "    \"locks\" /\n",
    "    \"GSE157783_PD_REPLICATION_SENSITIVITY_SUPPORT_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "\n",
    "    summary_path,\n",
    "    concordance_path,\n",
    "    lock_path,\n",
    "    support_lock_path,\n",
    "\n",
    "]:\n",
    "\n",
    "    assert path.exists()\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"NOTEBOOK-SIDE STEP 17 VERIFICATION: PASS\"\n",
