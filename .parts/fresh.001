   "source": [
    "# Source analysis cell: 16\n",
    "# ============================================================\n",
    "# STEP 8C — COUNT MATRIX IDENTITY / ORIENTATION AUDIT\n",
    "# Handles R-style conversion of terminal \"-1\" -> \".1\"\n",
    "#\n",
    "# NO differential expression.\n",
    "# ============================================================\n",
    "\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import json\n",
    "import re\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "PD_DIR = ROOT / \"GSE243639_PD_discovery\"\n",
    "LOCKS = ROOT / \"locks\"\n",
    "\n",
    "count_path = (\n",
    "    PD_DIR /\n",
    "    \"GSE243639_Filtered_count_table.csv.gz\"\n",
    ")\n",
    "\n",
    "umap_path = (\n",
    "    PD_DIR /\n",
    "    \"GSE243639_UMAP_coordinates.xlsx\"\n",
    ")\n",
    "\n",
    "assert count_path.exists(), count_path\n",
    "assert umap_path.exists(), umap_path\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 1. Load authoritative author-QC annotation\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "cells = pd.read_excel(\n",
    "    umap_path,\n",
    "    sheet_name=\"HighLevelCellTypes\",\n",
    "    usecols=[\"CELL_ID\", \"IDENT\"]\n",
    ")\n",
    "\n",
    "cells[\"CELL_ID\"] = (\n",
    "    cells[\"CELL_ID\"]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "assert len(cells) == 83484\n",
    "assert cells[\"CELL_ID\"].is_unique\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 2. Read count-table header only\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "header = pd.read_csv(\n",
    "    count_path,\n",
    "    compression=\"gzip\",\n",
    "    nrows=0\n",
    ")\n",
    "\n",
    "matrix_columns = list(header.columns)\n",
    "\n",
    "gene_column = matrix_columns[0]\n",
    "\n",
    "matrix_cell_ids_raw = (\n",
    "    matrix_columns[1:]\n",
    ")\n",
    "\n",
    "print(\"Total CSV columns:\",\n",
    "      len(matrix_columns))\n",
    "\n",
    "print(\"\\nGene identifier column:\")\n",
    "print(repr(gene_column))\n",
    "\n",
    "print(\"\\nNumber of raw matrix cell columns:\")\n",
    "print(f\"{len(matrix_cell_ids_raw):,}\")\n",
    "\n",
    "print(\"\\nRaw matrix examples:\")\n",
    "print(matrix_cell_ids_raw[:3])\n",
    "\n",
    "print(\"\\nAnnotation examples:\")\n",
    "print(cells[\"CELL_ID\"].head(3).tolist())\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 3. Canonicalize ONLY terminal R-style barcode suffix\n",
    "#\n",
    "# Example:\n",
    "#\n",
    "# s.0096_AAACCCAAGTACGAGC.1\n",
    "#\n",
    "# becomes:\n",
    "#\n",
    "# s.0096_AAACCCAAGTACGAGC-1\n",
    "#\n",
    "# The donor prefix s.0096 is left untouched.\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "def canonicalize_matrix_cell_id(x):\n",
    "\n",
    "    x = str(x).strip()\n",
    "\n",
    "    return re.sub(\n",
    "        r\"\\.(\\d+)$\",\n",
    "        r\"-\\1\",\n",
    "        x\n",
    "    )\n",
    "\n",
    "\n",
    "matrix_cell_ids = [\n",
    "    canonicalize_matrix_cell_id(x)\n",
    "    for x in matrix_cell_ids_raw\n",
    "]\n",
    "\n",
    "\n",
    "print(\"\\nCanonicalized matrix examples:\")\n",
    "print(matrix_cell_ids[:3])\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 4. Check transformation itself\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "n_changed = sum(\n",
    "    raw != canonical\n",
    "    for raw, canonical\n",
    "    in zip(\n",
    "        matrix_cell_ids_raw,\n",
    "        matrix_cell_ids\n",
    "    )\n",
    ")\n",
    "\n",
    "print(\"\\nColumn names changed by canonicalization:\")\n",
    "print(f\"{n_changed:,}\")\n",
    "\n",
    "assert n_changed == 83484, (\n",
    "    \"Expected all 83,484 matrix cell IDs \"\n",
    "    \"to require terminal suffix normalization.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 5. Exact canonical cell identity\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "annotation_cells = set(\n",
    "    cells[\"CELL_ID\"]\n",
    ")\n",
    "\n",
    "matrix_cells = set(\n",
    "    matrix_cell_ids\n",
    ")\n",
    "\n",
    "only_matrix = sorted(\n",
    "    matrix_cells - annotation_cells\n",
    ")\n",
    "\n",
    "only_annotation = sorted(\n",
    "    annotation_cells - matrix_cells\n",
    ")\n",
    "\n",
    "print(\"\\nAfter canonicalization:\")\n",
    "\n",
    "print(\n",
    "    \"Only in matrix:\",\n",
    "    len(only_matrix)\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Only in annotation:\",\n",
    "    len(only_annotation)\n",
    ")\n",
    "\n",
    "if only_matrix:\n",
    "    print(\"\\nExamples only in matrix:\")\n",
    "    print(only_matrix[:10])\n",
    "\n",
    "if only_annotation:\n",
    "    print(\"\\nExamples only in annotation:\")\n",
    "    print(only_annotation[:10])\n",
    "\n",
    "\n",
    "assert len(matrix_cell_ids) == 83484\n",
    "\n",
    "assert len(matrix_cell_ids) == len(\n",
    "    set(matrix_cell_ids)\n",
    "), (\n",
    "    \"Canonicalization created duplicate \"\n",
    "    \"cell identifiers.\"\n",
    ")\n",
    "\n",
    "assert not only_matrix, (\n",
    "    f\"{len(only_matrix)} canonical matrix \"\n",
    "    \"cells absent from annotations.\"\n",
    ")\n",
    "\n",
    "assert not only_annotation, (\n",
    "    f\"{len(only_annotation)} annotated cells \"\n",
    "    \"absent from canonical matrix.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 6. Check ORDER as well as identity\n",
    "#\n",
    "# We don't require annotation workbook and matrix to have\n",
    "# originally been in the same order, but we record whether\n",
    "# they happen to be.\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "annotation_order = (\n",
    "    cells[\"CELL_ID\"]\n",
    "    .tolist()\n",
    ")\n",
    "\n",
    "same_order = (\n",
    "    matrix_cell_ids\n",
    "    ==\n",
    "    annotation_order\n",
    ")\n",
    "\n",
    "print(\"\\nSame cell order as annotation workbook:\")\n",
    "print(same_order)\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 7. Read only first 3 genes\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "probe = pd.read_csv(\n",
    "    count_path,\n",
    "    compression=\"gzip\",\n",
    "    nrows=3\n",
    ")\n",
    "\n",
    "print(\"\\nProbe shape:\")\n",
    "print(probe.shape)\n",
    "\n",
    "print(\"\\nFirst three gene IDs:\")\n",
    "print(\n",
    "    probe.iloc[:, 0]\n",
    "    .tolist()\n",
    ")\n",
    "\n",
    "\n",
    "preview_cols = (\n",
    "    [probe.columns[0]]\n",
    "    +\n",
    "    list(probe.columns[1:9])\n",
    ")\n",
    "\n",
    "display(\n",
    "    probe[preview_cols]\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 8. Raw count sanity check\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "sample_values = (\n",
    "    probe\n",
    "    .iloc[:, 1:501]\n",
    "    .apply(\n",
    "        pd.to_numeric,\n",
    "        errors=\"raise\"\n",
    "    )\n",
    "    .to_numpy()\n",
    ")\n",
    "\n",
    "assert np.isfinite(\n",
    "    sample_values\n",
    ").all()\n",
    "\n",
    "assert (\n",
    "    sample_values >= 0\n",
    ").all()\n",
    "\n",
    "assert np.allclose(\n",
    "    sample_values,\n",
    "    np.round(sample_values)\n",
    "), (\n",
    "    \"Probe contains non-integer values; \"\n",
    "    \"expected raw counts.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 9. Freeze translation map for downstream processing\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "id_translation = pd.DataFrame({\n",
    "    \"matrix_cell_id_raw\":\n",
    "        matrix_cell_ids_raw,\n",
    "\n",
    "    \"CELL_ID\":\n",
    "        matrix_cell_ids\n",
    "})\n",
    "\n",
    "translation_path = (\n",
    "    PD_DIR /\n",
    "    \"GSE243639_matrix_to_annotation_CELL_ID_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "id_translation.to_csv(\n",
    "    translation_path,\n",
    "    index=False,\n",
    "    compression=\"gzip\"\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 10. Freeze matrix audit\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "matrix_audit = {\n",
    "\n",
    "    \"dataset\":\n",
    "        \"GSE243639\",\n",
    "\n",
    "    \"file\":\n",
    "        count_path.name,\n",
    "\n",
    "    \"orientation\":\n",
    "        \"genes_by_cells\",\n",
    "\n",
    "    \"gene_identifier_column\":\n",
    "        str(gene_column),\n",
    "\n",
    "    \"n_cell_columns\":\n",
    "        int(len(matrix_cell_ids)),\n",
    "\n",
    "    \"n_annotation_cells\":\n",
    "        int(len(annotation_cells)),\n",
    "\n",
    "    \"matrix_cell_id_format\":\n",
    "        \"R-style terminal .1\",\n",
    "\n",
    "    \"canonical_cell_id_format\":\n",
    "        \"10x-style terminal -1\",\n",
    "\n",
    "    \"canonicalization_rule\":\n",
    "        r\"terminal \\\\.(digits) -> -(digits)\",\n",
    "\n",
    "    \"n_cell_ids_changed\":\n",
    "        int(n_changed),\n",
    "\n",
    "    \"exact_cell_identity_after_canonicalization\":\n",
    "        True,\n",
    "\n",
    "    \"same_order_as_annotation_workbook\":\n",
    "        bool(same_order),\n",
    "\n",
    "    \"raw_nonnegative_integer_probe\":\n",
    "        True,\n",
    "\n",
    "    \"translation_table\":\n",
    "        str(translation_path)\n",
    "}\n",
    "\n",
    "\n",
    "audit_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_COUNT_MATRIX_AUDIT_v1.json\"\n",
    ")\n",
    "\n",
    "with open(\n",
    "    audit_path,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        matrix_audit,\n",
    "        f,\n",
    "        indent=2\n",
    "    )\n",
    "\n",
    "\n",
    "print(\"\\n========================================\")\n",
    "print(\"STEP 8C PASSED\")\n",
    "print(\"========================================\")\n",
    "\n",
    "print(\n",
    "    json.dumps(\n",
    "        matrix_audit,\n",
    "        indent=2\n",
    "    )\n",
    ")\n",
    "\n",
    "print(\"\\nTranslation table saved:\")\n",
    "print(translation_path)\n",
    "\n",
    "print(\"\\nAudit saved:\")\n",
    "print(audit_path)"
   ]
