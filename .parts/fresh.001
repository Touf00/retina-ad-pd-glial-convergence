  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 21\n",
    "# ============================================================\n",
    "# STEP 11A — PRIMARY DE OUTPUT AUDIT + FIRST BIOLOGICAL REVEAL\n",
    "#\n",
    "# PURPOSE\n",
    "# -------\n",
    "# 1. Verify STEP 11 run lock.\n",
    "# 2. Verify hashes of all four complete DE result files.\n",
    "# 3. Verify exact frozen gene counts.\n",
    "# 4. Verify no duplicated/missing genes.\n",
    "# 5. Recalculate FDR<0.05 counts independently.\n",
    "# 6. Compare recalculated counts with STEP 11 summary.\n",
    "# 7. Display the first controlled biological results.\n",
    "#\n",
    "# NO sensitivity analysis yet.\n",
    "# NO secondary VC / Neuron DE yet.\n",
    "# ============================================================\n",
    "\n",
    "from pathlib import Path\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import json\n",
    "import hashlib\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = ROOT / \"locks\"\n",
    "\n",
    "DE_ROOT = (\n",
    "    ROOT /\n",
    "    \"PD_primary_DE\"\n",
    ")\n",
    "\n",
    "summary_path = (\n",
    "    DE_ROOT /\n",
    "    \"GSE243639_PRIMARY_PD_DE_SUMMARY_v1.csv\"\n",
    ")\n",
    "\n",
    "run_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_PRIMARY_PD_DE_RUN_v1.json\"\n",
    ")\n",
    "\n",
    "pre_de_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_PRE_DE_ANALYSIS_LOCK_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "    summary_path,\n",
    "    run_lock_path,\n",
    "    pre_de_lock_path,\n",
    "]:\n",
    "\n",
    "    assert path.exists(), (\n",
    "        f\"Missing required file: {path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. LOAD LOCKS + SUMMARY\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    run_lock_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    run_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    pre_de_lock_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    pre_de_lock = json.load(f)\n",
    "\n",
    "\n",
    "summary = pd.read_csv(\n",
    "    summary_path\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. RUN-LOCK INTEGRITY\n",
    "# ============================================================\n",
    "\n",
    "assert (\n",
    "    run_lock[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"PRIMARY_DE_COMPLETE\"\n",
    ")\n",
    "\n",
    "assert (\n",
    "    run_lock[\n",
    "        \"differential_expression_performed\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "assert (\n",
    "    run_lock[\n",
    "        \"all_tested_gene_results_saved\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "assert (\n",
    "    run_lock[\n",
    "        \"gene_universes_refiltered\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "assert (\n",
    "    run_lock[\n",
    "        \"secondary_cell_classes_analyzed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "assert (\n",
    "    run_lock[\n",
    "        \"sensitivity_analyses_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "PRIMARY_CLASSES = [\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "]\n",
    "\n",
    "\n",
    "EXPECTED_UNIVERSES = {\n",
    "\n",
    "    \"Astro\":\n",
    "        16942,\n",
    "\n",
    "    \"Micro\":\n",
    "        16050,\n",
    "\n",
    "    \"OPC\":\n",
    "        16268,\n",
    "\n",
    "    \"Oligo\":\n",
    "        15957,\n",
    "}\n",
    "\n",
    "\n",
    "assert (\n",
    "    summary[\n",
    "        \"cell_type\"\n",
    "    ].tolist()\n",
    "    ==\n",
    "    PRIMARY_CLASSES\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 11 RUN LOCK: PASS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nDE environment:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    json.dumps(\n",
    "        run_lock[\n",
    "            \"environment\"\n",
    "        ],\n",
    "        indent=2\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. FILE HASH HELPER\n",
    "# ============================================================\n",
    "\n",
    "def sha256_file(\n",
    "    path,\n",
    "    block_size=1024 * 1024\n",
    "):\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\"\n",
    "    ) as f:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            block = f.read(\n",
    "                block_size\n",
    "            )\n",
    "\n",
    "            if not block:\n",
    "                break\n",
    "\n",
    "            h.update(\n",
    "                block\n",
    "            )\n",
    "\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. AUDIT EACH COMPLETE ALL-GENE RESULT\n",
    "# ============================================================\n",
    "\n",
    "audit_rows = []\n",
    "\n",
    "top_tables = {}\n",
    "\n",
    "\n",
    "for cell_type in PRIMARY_CLASSES:\n",
    "\n",
    "    print(\n",
    "        \"\\n\"\n",
    "        +\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        cell_type\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "\n",
    "    record = (\n",
    "        run_lock[\n",
    "            \"cell_class_results\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Result path\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    result_path = Path(\n",
    "        record[\n",
    "            \"all_gene_results\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert result_path.exists(), (\n",
    "        f\"Missing result file: {result_path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # SHA256 verification\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    observed_hash = (\n",
    "        sha256_file(\n",
    "            result_path\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    expected_hash = (\n",
    "        record[\n",
    "            \"all_gene_results_sha256\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        observed_hash\n",
    "        ==\n",
    "        expected_hash\n",
    "    ), (\n",
    "        f\"{cell_type}: \"\n",
    "        \"all-gene DE result hash mismatch.\"\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"SHA256: PASS\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Load complete result\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    res = pd.read_csv(\n",
    "        result_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    required_columns = [\n",
    "\n",
    "        \"gene_symbol\",\n",
    "        \"baseMean\",\n",
    "        \"log2FoldChange\",\n",
    "        \"lfcSE\",\n",
    "        \"stat\",\n",
    "        \"pvalue\",\n",
    "        \"padj\",\n",
    "        \"rank_stat\",\n",
    "        \"cell_type\",\n",
    "        \"contrast\",\n",
    "    ]\n",
    "\n",
    "\n",
    "    missing = [\n",
    "        col\n",
    "        for col in required_columns\n",
    "        if col not in res.columns\n",
    "    ]\n",
    "\n",
    "\n",
    "    assert not missing, (\n",
    "        f\"{cell_type}: missing columns {missing}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Exact gene count\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    expected_n = (\n",
    "        EXPECTED_UNIVERSES[\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        res\n",
    "    ) == expected_n\n",
    "\n",
    "\n",
    "    assert (\n",
    "        res[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .is_unique\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        res[\n",
    "            \"cell_type\"\n",
    "        ]\n",
    "        .eq(\n",
    "            cell_type\n",
    "        )\n",
    "        .all()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        res[\n",
    "            \"contrast\"\n",
    "        ]\n",
    "        .eq(\n",
    "            \"PD_vs_Control\"\n",
    "        )\n",
    "        .all()\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Verify exact frozen gene universe\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    frozen_universe_path = Path(\n",
    "        pre_de_lock[\n",
    "            \"cell_class_universes\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ][\n",
    "            \"gene_universe_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    universe = pd.read_csv(\n",
    "        frozen_universe_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    frozen_genes = (\n",
    "        universe[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    result_genes = (\n",
    "        res[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        result_genes\n",
    "        ==\n",
    "        frozen_genes\n",
    "    ), (\n",
    "        f\"{cell_type}: \"\n",
    "        \"DE output gene order differs \"\n",
    "        \"from frozen universe.\"\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Frozen universe identity: PASS\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Rank statistic must equal Wald statistic\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    both_finite = (\n",
    "        np.isfinite(\n",
    "            res[\n",
    "                \"stat\"\n",
    "            ]\n",
    "        )\n",
    "        &\n",
    "        np.isfinite(\n",
    "            res[\n",
    "                \"rank_stat\"\n",
    "            ]\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert np.allclose(\n",
    "\n",
    "        res.loc[\n",
    "            both_finite,\n",
    "            \"stat\"\n",
    "        ],\n",
    "\n",
    "        res.loc[\n",
    "            both_finite,\n",
    "            \"rank_stat\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Result finite-value audit\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    finite_lfc = np.isfinite(\n",
    "        res[\n",
    "            \"log2FoldChange\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    finite_stat = np.isfinite(\n",
    "        res[\n",
    "            \"stat\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    finite_p = np.isfinite(\n",
    "        res[\n",
    "            \"pvalue\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    finite_padj = np.isfinite(\n",
    "        res[\n",
    "            \"padj\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    fdr_mask = (\n",
    "        finite_padj\n",
    "        &\n",
    "        (\n",
    "            res[\n",
    "                \"padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    sig = (\n",
    "        res.loc[\n",
    "            fdr_mask\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_sig = int(\n",
    "        len(\n",
    "            sig\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    n_up = int(\n",
    "        (\n",
    "            sig[\n",
    "                \"log2FoldChange\"\n",
    "            ]\n",
    "            >\n",
    "            0\n",
    "        ).sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_down = int(\n",
    "        (\n",
    "            sig[\n",
    "                \"log2FoldChange\"\n",
    "            ]\n",
    "            <\n",
    "            0\n",
    "        ).sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Compare independently recalculated counts to run lock\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    assert (\n",
    "        n_sig\n",
    "        ==\n",
    "        record[\n",
    "            \"n_FDR_lt_0_05\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_up\n",
    "        ==\n",
    "        record[\n",
    "            \"n_FDR_lt_0_05_up_in_PD\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_down\n",
    "        ==\n",
    "        record[\n",
    "            \"n_FDR_lt_0_05_down_in_PD\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Compare with combined summary\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    summary_row = (\n",
    "        summary.loc[\n",
    "            summary[\n",
    "                \"cell_type\"\n",
    "            ]\n",
    "            ==\n",
    "            cell_type\n",
    "        ]\n",
    "        .iloc[\n",
    "            0\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        int(\n",
    "            summary_row[\n",
    "                \"tested_genes\"\n",
    "            ]\n",
    "        )\n",
    "        ==\n",
    "        expected_n\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        int(\n",
    "            summary_row[\n",
    "                \"FDR_lt_0.05\"\n",
    "            ]\n",
    "        )\n",
    "        ==\n",
    "        n_sig\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        int(\n",
    "            summary_row[\n",
    "                \"up_in_PD\"\n",
    "            ]\n",
    "        )\n",
    "        ==\n",
    "        n_up\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        int(\n",
    "            summary_row[\n",
    "                \"down_in_PD\"\n",
    "            ]\n",
    "        )\n",
    "        ==\n",
    "        n_down\n",
    "    )\n",    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Minimum p / padj\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    finite_p_values = (\n",
    "        res.loc[\n",
    "            finite_p,\n",
    "            \"pvalue\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    finite_padj_values = (\n",
    "        res.loc[\n",
    "            finite_padj,\n",
    "            \"padj\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    min_p = (\n",
    "        float(\n",
    "            finite_p_values.min()\n",
    "        )\n",
    "        if len(\n",
    "            finite_p_values\n",
    "        )\n",
    "        else np.nan\n",
    "    )\n",
    "\n",
    "\n",
    "    min_padj = (\n",
    "        float(\n",
    "            finite_padj_values.min()\n",
    "        )\n",
    "        if len(\n",
    "            finite_padj_values\n",
    "        )\n",
    "        else np.nan\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Top genes for FIRST biological reveal\n",
    "    #\n",
    "    # If there are FDR-significant genes:\n",
    "    #   show strongest FDR results.\n",
    "    #\n",
    "    # Otherwise:\n",
    "    #   show lowest nominal p-values,\n",
    "    #   explicitly NOT as significant genes.\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    if n_sig > 0:\n",
    "\n",
    "        reveal = (\n",
    "            sig\n",
    "            .sort_values(\n",
    "                [\n",
    "                    \"padj\",\n",
    "                    \"pvalue\",\n",
    "                ]\n",
    "            )\n",
    "            [\n",
    "                [\n",
    "                    \"gene_symbol\",\n",
    "                    \"baseMean\",\n",
    "                    \"log2FoldChange\",\n",
    "                    \"stat\",\n",
    "                    \"pvalue\",\n",
    "                    \"padj\",\n",
    "                ]\n",
    "            ]\n",
    "            .head(\n",
    "                15\n",
    "            )\n",
    "            .copy()\n",
    "        )\n",
    "\n",
    "\n",
    "        reveal[\n",
    "            \"status\"\n",
    "        ] = (\n",
    "            \"FDR<0.05\"\n",
    "        )\n",
    "\n",
    "    else:\n",
    "\n",
    "        reveal = (\n",
    "            res.loc[\n",
    "                finite_p\n",
    "            ]\n",
    "            .sort_values(\n",
    "                \"pvalue\"\n",
    "            )\n",
    "            [\n",
    "                [\n",
    "                    \"gene_symbol\",\n",
    "                    \"baseMean\",\n",
    "                    \"log2FoldChange\",\n",
    "                    \"stat\",\n",
    "                    \"pvalue\",\n",
    "                    \"padj\",\n",
    "                ]\n",
    "            ]\n",
    "            .head(\n",
    "                15\n",
    "            )\n",
    "            .copy()\n",
    "        )\n",
    "\n",
    "\n",
    "        reveal[\n",
    "            \"status\"\n",
    "        ] = (\n",
    "            \"NOT_FDR_SIGNIFICANT\"\n",
    "        )\n",
    "\n",
    "\n",
    "    top_tables[\n",
    "        cell_type\n",
    "    ] = reveal\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Audit record\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    audit_rows.append({\n",
    "\n",
    "        \"cell_type\":\n",
    "            cell_type,\n",
    "\n",
    "        \"tested_genes\":\n",
    "            expected_n,\n",
    "\n",
    "        \"finite_LFC\":\n",
    "            int(\n",
    "                finite_lfc.sum()\n",
    "            ),\n",
    "\n",
    "        \"finite_Wald\":\n",
    "            int(\n",
    "                finite_stat.sum()\n",
    "            ),\n",
    "\n",
    "        \"finite_p\":\n",
    "            int(\n",
    "                finite_p.sum()\n",
    "            ),\n",
    "\n",
    "        \"finite_padj\":\n",
    "            int(\n",
    "                finite_padj.sum()\n",
    "            ),\n",
    "\n",
    "        \"FDR_lt_0.05\":\n",
    "            n_sig,\n",
    "\n",
    "        \"up_in_PD\":\n",
    "            n_up,\n",
    "\n",
    "        \"down_in_PD\":\n",
    "            n_down,\n",
    "\n",
    "        \"min_pvalue\":\n",
    "            min_p,\n",
    "\n",
    "        \"min_padj\":\n",
    "            min_padj,\n",
    "\n",
    "        \"hash_verified\":\n",
    "            True,\n",
    "\n",
    "        \"gene_universe_verified\":\n",
    "            True,\n",
    "    })\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Tested genes:\",\n",
    "        f\"{expected_n:,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Finite Wald stats:\",\n",
    "        f\"{int(finite_stat.sum()):,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Finite p-values:\",\n",
    "        f\"{int(finite_p.sum()):,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Finite padj:\",\n",
    "        f\"{int(finite_padj.sum()):,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"FDR < 0.05:\",\n",
    "        f\"{n_sig:,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Up in PD:\",\n",
    "        f\"{n_up:,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Down in PD:\",\n",
    "        f\"{n_down:,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Minimum p-value:\",\n",
    "        min_p\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Minimum padj:\",\n",
    "        min_padj\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. COMBINED AUDIT TABLE\n",
    "# ============================================================\n",
    "\n",
    "audit = pd.DataFrame(\n",
    "    audit_rows\n",
    ")\n",
    "\n",
    "\n",
    "audit_path = (\n",
    "    DE_ROOT /\n",
    "    \"GSE243639_PRIMARY_PD_DE_AUDIT_v1.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "audit.to_csv(\n",
    "    audit_path,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PRIMARY PD DE AUDIT\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    audit\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. FIRST BIOLOGICAL REVEAL\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"FIRST BIOLOGICAL REVEAL\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "for cell_type in PRIMARY_CLASSES:\n",
    "\n",
    "    print(\n",
    "        \"\\n\"\n",
    "        +\n",
    "        \"-\" * 80\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        cell_type\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"-\" * 80\n",
    "    )\n",
    "\n",
    "    display(\n",
    "        top_tables[\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. CROSS-CELL FDR OVERLAP — DESCRIPTIVE ONLY\n",
    "#\n",
    "# This does NOT define convergence yet.\n",
    "# It simply reports overlap among significant PD genes.\n",
    "# ============================================================\n",
    "\n",
    "sig_sets = {}\n",
    "\n",
    "\n",
    "for cell_type in PRIMARY_CLASSES:\n",
    "\n",
    "    result_path = Path(\n",
    "        run_lock[\n",
    "            \"cell_class_results\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ][\n",
    "            \"all_gene_results\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    res = pd.read_csv(\n",
    "        result_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    mask = (\n",
    "        np.isfinite(\n",
    "            res[\n",
    "                \"padj\"\n",
    "            ]\n",
    "        )\n",
    "        &\n",
    "        (\n",
    "            res[\n",
    "                \"padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    sig_sets[\n",
    "        cell_type\n",
    "    ] = set(\n",
    "        res.loc[\n",
    "            mask,\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "    )\n",
    "\n",
    "\n",
    "shared_all_four = (\n",
    "    sig_sets[\n",
    "        \"Astro\"\n",
    "    ]\n",
    "    &\n",
    "    sig_sets[\n",
    "        \"Micro\"\n",
    "    ]\n",
    "    &\n",
    "    sig_sets[\n",
    "        \"OPC\"\n",
    "    ]\n",
    "    &\n",
    "    sig_sets[\n",
    "        \"Oligo\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFDR-significant genes shared \"\n",
    "    \"by all four primary PD classes:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    len(\n",
    "        shared_all_four\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "if len(\n",
    "    shared_all_four\n",
    ") <= 50:\n",
    "\n",
    "    print(\n",
    "        sorted(\n",
    "            shared_all_four\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. FINAL\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 11A PASSED — PRIMARY PD RESULTS VERIFIED\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nAudit saved:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    audit_path\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nNEXT:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Interpret primary PD signal, then run \"\n",
    "    \"the frozen technical and age-overlap sensitivities.\"\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 22\n",
    "# ============================================================\n",
    "# STEP 12 — FROZEN PRIMARY PD SENSITIVITY ANALYSES\n",
    "#\n",
    "# COMPLETE SELF-CONTAINED VERSION\n",
    "#\n",
    "# SENSITIVITY A:\n",
    "#   Full 29 donors\n",
    "#   ~ age + sex + PMI + RIN + diagnosis_binary\n",
    "#\n",
    "# SENSITIVITY B:\n",
    "#   Age-overlap donors only: 57–93 years\n",
    "#   N = 26 (13 PD / 13 Control)\n",
    "#   ~ age + sex + diagnosis_binary\n",
    "#\n",
    "# IMPORTANT\n",
    "# ---------\n",
    "# - Uses EXACT frozen gene universes from STEP 10C.\n",
    "# - NO gene refiltering.\n",
    "# - NO donor changes beyond the already-frozen age-overlap set.\n",
    "# - NO secondary VC / Neuron analysis.\n",
    "# - Saves ALL tested genes.\n",
    "# - Produces descriptive concordance with PRIMARY DE.\n",
    "#\n",
    "# The biological conclusions are NOT altered automatically.\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "import sys\n",
    "import subprocess\n",
    "from pathlib import Path\n",
    "import textwrap\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. ENSURE FRESH COMPATIBLE ENVIRONMENT\n",
    "# ============================================================\n",
    "\n",
    "TARGET_PANDAS = \"2.3.3\"\n",
    "TARGET_PYDESEQ2 = \"0.5.4\"\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 12 ENVIRONMENT PREPARATION\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "subprocess.check_call(\n",
    "    [\n",
    "        sys.executable,\n",
    "        \"-m\",\n",
    "        \"pip\",\n",
    "        \"install\",\n",
    "        \"-q\",\n",
    "        \"--upgrade\",\n",
    "        f\"pandas=={TARGET_PANDAS}\",\n",
    "        f\"pydeseq2=={TARGET_PYDESEQ2}\",\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. WRITE FRESH STEP-12 RUNNER\n",
    "# ============================================================\n",
    "\n",
    "runner_path = Path(\n",
    "    \"/content/RETINA_ND_STEP12_PD_SENSITIVITY_RUNNER.py\"\n",
    ")\n",
    "\n",
    "\n",
    "RUNNER = r'''\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "import sys\n",
    "import platform\n",
    "import hashlib\n",
    "import json\n",
    "import gc\n",
    "import io\n",
    "import contextlib\n",
    "import importlib.metadata\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from packaging.version import Version\n",
    "\n",
    "from scipy.stats import (\n",
    "    pearsonr,\n",
    "    spearmanr,\n",
    ")\n",
    "\n",
    "from pydeseq2.dds import DeseqDataSet\n",
    "from pydeseq2.ds import DeseqStats\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# A. ENVIRONMENT\n",
    "# ============================================================\n",
    "\n",
    "REQUIRED_PYDESEQ2 = \"0.5.4\"\n",
    "MINIMUM_PANDAS = Version(\n",
    "    \"2.3.0\"\n",
    ")\n",
    "\n",
    "\n",
    "def package_version(\n",
    "    name\n",
    "):\n",
    "\n",
    "    try:\n",
    "\n",
    "        return (\n",
    "            importlib.metadata.version(\n",
    "                name\n",
    "            )\n",
    "        )\n",
    "\n",
    "    except importlib.metadata.PackageNotFoundError:\n",
    "\n",
    "        return None\n",
    "\n",
    "\n",
    "PYDESEQ2_VERSION = (\n",
    "    package_version(\n",
    "        \"pydeseq2\"\n",
    "    )\n",
    ")\n",
    "\n",
    "PANDAS_VERSION = (\n",
    "    package_version(\n",
    "        \"pandas\"\n",
    "    )\n",
    ")\n",
    "\n",
    "ANNDATA_VERSION = (\n",
    "    package_version(\n",
    "        \"anndata\"\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    PYDESEQ2_VERSION\n",
    "    ==\n",
    "    REQUIRED_PYDESEQ2\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    Version(\n",
    "        PANDAS_VERSION\n",
    "    )\n",
    "    >=\n",
    "    MINIMUM_PANDAS\n",
    ")\n",
    "\n",
    "\n",
    "# Explicit test for previous AnnData/Pandas issue\n",
    "_ = pd.StringDtype(\n",
    "    na_value=pd.NA\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 12 FRESH SUBPROCESS ENVIRONMENT\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Python:\",\n",
    "    platform.python_version()\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PyDESeq2:\",\n",
    "    PYDESEQ2_VERSION\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"AnnData:\",\n",
    "    ANNDATA_VERSION\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Pandas:\",\n",
    "    PANDAS_VERSION\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"NumPy:\",\n",
    "    np.__version__\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# B. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = ROOT / \"locks\"\n",
    "MANIFESTS = ROOT / \"manifests\"\n",
    "\n",
    "DE_ROOT = (\n",
    "    ROOT /\n",
    "    \"PD_primary_DE\"\n",
    ")\n",
    "\n",
    "SENS_ROOT = (\n",
    "    ROOT /\n",
    "    \"PD_primary_sensitivity\"\n",
    ")\n",
    "\n",
    "SENS_ROOT.mkdir(\n",
    "    exist_ok=True\n",
    ")\n",
    "\n",
    "\n",
    "pre_de_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_PRE_DE_ANALYSIS_LOCK_v1.json\"\n",
    ")\n",
    "\n",
    "primary_run_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_PRIMARY_PD_DE_RUN_v1.json\"\n",
    ")\n",
    "\n",
    "design_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_DESIGN_AUDIT_v1.json\"\n",
    ")\n",
    "\n",
    "age_overlap_path = (\n",
    "    MANIFESTS /\n",
    "    \"GSE243639_age_overlap_sensitivity_donors_v1.csv\"\n",
    ")\n",
    "\n",
    "sensitivity_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_PRIMARY_PD_SENSITIVITY_RUN_v1.json\"\n",
    ")\n",
    "\n",
    "combined_summary_path = (\n",
    "    SENS_ROOT /\n",
    "    \"GSE243639_PRIMARY_PD_SENSITIVITY_SUMMARY_v1.csv\"\n",
    ")\n",
    "\n",
    "concordance_path = (\n",
    "    SENS_ROOT /\n",
    "    \"GSE243639_PRIMARY_PD_SENSITIVITY_CONCORDANCE_v1.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "    pre_de_lock_path,\n",
    "    primary_run_lock_path,\n",
    "    design_lock_path,\n",
    "    age_overlap_path,\n",
    "]:\n",
    "\n",
    "    assert path.exists(), (\n",
    "        f\"Missing required input: {path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# C. LOAD LOCKS\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    pre_de_lock_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    pre_de_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    primary_run_lock_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    primary_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    design_lock_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    design_lock = json.load(f)\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre_de_lock[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"FINAL_PRE_DE_LOCK\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    primary_lock[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"PRIMARY_DE_COMPLETE\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    primary_lock[\n",
    "        \"gene_universes_refiltered\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    design_lock[\n",
    "        \"sensitivity_design_full_rank\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    design_lock[\n",
    "        \"age_overlap_design_full_rank\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# D. AGE-OVERLAP DONORS\n",
    "# ============================================================\n",
    "\n",
    "age_overlap = pd.read_csv(\n",
    "    age_overlap_path\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    age_overlap\n",
    ") == 26\n",
    "\n",
    "\n",
    "assert (\n",
    "    age_overlap[\n",
    "        \"donor_id\"\n",
    "    ]\n",
    "    .nunique()\n",
    "    ==\n",
    "    26\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    age_overlap[\n",
    "        \"diagnosis_binary\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    "    ==\n",
    "    {\n",
    "        \"PD\": 13,\n",
    "        \"Control\": 13,\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    age_overlap[\n",
    "        \"age\"\n",
    "    ].min()\n",
    "    >=\n",
    "    57\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    age_overlap[\n",
    "        \"age\"\n",
    "    ].max()\n",
    "    <=\n",
    "    93\n",
    ")\n",
    "\n",
    "\n",
    "AGE_OVERLAP_DONORS = set(\n",
    "    age_overlap[\n",
    "        \"donor_id\"\n",
    "    ].astype(str)\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFrozen age-overlap cohort:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"N =\",\n",
    "    len(\n",
    "        AGE_OVERLAP_DONORS\n",
    "    )\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PD = 13, Control = 13\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# E. PRIMARY CELL CLASSES\n",
    "# ============================================================\n",
    "\n",
    "PRIMARY_CLASSES = [\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "]\n",
    "\n",
    "\n",
    "EXPECTED_UNIVERSES = {\n",
    "\n",
    "    \"Astro\":\n",
    "        16942,\n",
    "\n",
    "    \"Micro\":\n",
    "        16050,\n",
    "\n",
    "    \"OPC\":\n",
    "        16268,\n",
    "\n",
    "    \"Oligo\":\n",
    "        15957,\n",
    "}\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# F. HELPERS\n",
    "# ============================================================\n",
    "\n",
    "def sha256_file(\n",
    "    path,\n",
    "    block_size=1024 * 1024\n",
    "):\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\"\n",
    "    ) as f:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            block = f.read(\n",
    "                block_size\n",
    "            )\n",
    "\n",
    "            if not block:\n",
    "                break\n",
    "\n",
    "            h.update(\n",
    "                block\n",
    "            )\n",
    "\n",
    "    return (\n",
    "        h.hexdigest()\n",
    "    )\n",
    "\n",
    "\n",
    "def safe_pearson(\n",
    "    x,\n",
    "    y\n",
    "):\n",
    "\n",
    "    x = np.asarray(\n",
    "        x,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "    y = np.asarray(\n",
    "        y,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "    mask = (\n",
    "        np.isfinite(x)\n",
    "        &\n",
    "        np.isfinite(y)\n",
    "    )\n",
    "\n",
    "\n",
    "    if mask.sum() < 3:\n",
    "\n",
    "        return np.nan\n",
    "\n",
    "\n",
    "    return float(\n",
    "        pearsonr(\n",
    "            x[\n",
    "                mask\n",
    "            ],\n",
    "            y[\n",
    "                mask\n",
    "            ]\n",
    "        ).statistic\n",
    "    )\n",
    "\n",
    "\n",
    "def safe_spearman(\n",
    "    x,\n",
    "    y\n",
    "):\n",
    "\n",
    "    x = np.asarray(\n",
    "        x,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",    "    y = np.asarray(\n",
    "        y,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "    mask = (\n",
    "        np.isfinite(x)\n",
    "        &\n",
    "        np.isfinite(y)\n",
    "    )\n",
    "\n",
    "\n",
    "    if mask.sum() < 3:\n",
    "\n",
    "        return np.nan\n",
    "\n",
    "\n",
    "    return float(\n",
    "        spearmanr(\n",
    "            x[\n",
    "                mask\n",
    "            ],\n",
    "            y[\n",
    "                mask\n",
    "            ]\n",
    "        ).statistic\n",
    "    )\n",
    "\n",
    "\n",
    "def fit_deseq(\n",
    "    *,\n",
    "    counts,\n",
    "    metadata,\n",
    "    design,\n",
    "    contrast,\n",
    "    output_dir,\n",
    "    output_prefix,\n",
    "):\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Construct DESeqDataSet\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    dds = DeseqDataSet(\n",
    "        counts=counts,\n",
    "        metadata=metadata,\n",
    "        design=design,\n",
    "        refit_cooks=True,\n",
    "        n_cpus=2,\n",
    "        quiet=False,\n",
    "    )\n",
    "\n",
    "\n",
    "    design_matrix = (\n",
    "        dds.obsm[\n",
    "            \"design_matrix\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    rank = int(\n",
    "        np.linalg.matrix_rank(\n",
    "            design_matrix.to_numpy()\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    n_columns = int(\n",
    "        design_matrix.shape[\n",
    "            1\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        rank\n",
    "        ==\n",
    "        n_columns\n",
    "    )\n",
    "\n",
    "\n",
    "    design_path = (\n",
    "        output_dir /\n",
    "        f\"{output_prefix}_DESIGN_MATRIX.csv\"\n",
    "    )\n",
    "\n",
    "\n",
    "    design_matrix.to_csv(\n",
    "        design_path\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Fit DESeq2\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    dds.deseq2()\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Statistics\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    stats = DeseqStats(\n",
    "        dds,\n",
    "        contrast=contrast,\n",
    "        alpha=0.05,\n",
    "        cooks_filter=True,\n",
    "        independent_filter=True,\n",
    "        n_cpus=2,\n",
    "        quiet=False,\n",
    "    )\n",
    "\n",
    "\n",
    "    buffer = io.StringIO()\n",
    "\n",
    "\n",
    "    with contextlib.redirect_stdout(\n",
    "        buffer\n",
    "    ):\n",
    "\n",
    "        stats.summary()\n",
    "\n",
    "\n",
    "    result = (\n",
    "        stats.results_df\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    result.index = pd.Index(\n",
    "        [\n",
    "            str(x)\n",
    "            for x\n",
    "            in result.index\n",
    "        ],\n",
    "        dtype=\"object\"\n",
    "    )\n",
    "\n",
    "\n",
    "    result.index.name = (\n",
    "        \"gene_symbol\"\n",
    "    )\n",
    "\n",
    "\n",
    "    result = (\n",
    "        result\n",
    "        .reset_index()\n",
    "    )\n",
    "\n",
    "\n",
    "    required = [\n",
    "        \"gene_symbol\",\n",
    "        \"baseMean\",\n",
    "        \"log2FoldChange\",\n",
    "        \"lfcSE\",\n",
    "        \"stat\",\n",
    "        \"pvalue\",\n",
    "        \"padj\",\n",
    "    ]\n",
    "\n",
    "\n",
    "    assert all(\n",
    "        x in result.columns\n",
    "        for x in required\n",
    "    )\n",
    "\n",
    "\n",
    "    result = result[\n",
    "        required\n",
    "    ]\n",
    "\n",
    "\n",
    "    result[\n",
    "        \"rank_stat\"\n",
    "    ] = (\n",
    "        result[\n",
    "            \"stat\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    result_path = (\n",
    "        output_dir /\n",
    "        f\"{output_prefix}_ALL_GENES.csv.gz\"\n",
    "    )\n",
    "\n",
    "\n",
    "    result.to_csv(\n",
    "        result_path,\n",
    "        index=False,\n",
    "        compression={\n",
    "            \"method\":\n",
    "                \"gzip\",\n",
    "\n",
    "            \"compresslevel\":\n",
    "                6,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    summary_text_path = (\n",
    "        output_dir /\n",
    "        f\"{output_prefix}_DESEQ2_SUMMARY.txt\"\n",
    "    )\n",
    "\n",
    "\n",
    "    with open(\n",
    "        summary_text_path,\n",
    "        \"w\",\n",
    "        encoding=\"utf-8\"\n",
    "    ) as f:\n",
    "\n",
    "        f.write(\n",
    "            buffer.getvalue()\n",
    "        )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Size factors\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    size_factors = (\n",
    "        dds.obs[\n",
    "            \"size_factors\"\n",
    "        ]\n",
    "        .to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        np.isfinite(\n",
    "            size_factors\n",
    "        ).all()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        size_factors > 0\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    sf = pd.DataFrame({\n",
    "\n",
    "        \"pseudobulk_group\":\n",
    "            counts.index\n",
    "            .astype(str),\n",
    "\n",
    "        \"size_factor\":\n",
    "            size_factors,\n",
    "    })\n",
    "\n",
    "\n",
    "    sf_path = (\n",
    "        output_dir /\n",
    "        f\"{output_prefix}_SIZE_FACTORS.csv\"\n",
    "    )\n",
    "\n",
    "\n",
    "    sf.to_csv(\n",
    "        sf_path,\n",
    "        index=False\n",
    "    )\n",
    "\n",
    "\n",
    "    return {\n",
    "        \"dds\":\n",
    "            dds,\n",
    "\n",
    "        \"stats\":\n",
    "            stats,\n",
    "\n",
    "        \"result\":\n",
    "            result,\n",
    "\n",
    "        \"result_path\":\n",
    "            result_path,\n",
    "\n",
    "        \"design_path\":\n",
    "            design_path,\n",
    "\n",
    "        \"summary_text_path\":\n",
    "            summary_text_path,\n",
    "\n",
    "        \"size_factor_path\":\n",
    "            sf_path,\n",
    "\n",
    "        \"design_rank\":\n",
    "            rank,\n",
    "\n",
    "        \"design_columns\":\n",
    "            n_columns,\n",
    "    }\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# G. STORAGE\n",
    "# ============================================================\n",
    "\n",
    "run_records = {}\n",
    "\n",
    "summary_rows = []\n",
    "\n",
    "concordance_rows = []\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# H. ANALYZE FOUR PRIMARY CELL CLASSES\n",
    "# ============================================================\n",
    "\n",
    "for class_number, cell_type in enumerate(\n",
    "    PRIMARY_CLASSES,\n",
    "    start=1\n",
    "):\n",
    "\n",
    "    print(\n",
    "        \"\\n\"\n",
    "        +\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"[{class_number}/4] \"\n",
    "        f\"{cell_type}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "\n",
    "    frozen = (\n",
    "        pre_de_lock[\n",
    "            \"cell_class_universes\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    counts_path = Path(\n",
    "        frozen[\n",
    "            \"raw_counts_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    metadata_path = Path(\n",
    "        frozen[\n",
    "            \"eligible_donor_metadata\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    primary_result_path = Path(\n",
    "        primary_lock[\n",
    "            \"cell_class_results\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ][\n",
    "            \"all_gene_results\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    for path in [\n",
    "        counts_path,\n",
    "        metadata_path,\n",
    "        primary_result_path,\n",
    "    ]:\n",
    "\n",
    "        assert path.exists()\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # H1. Load exact frozen counts and metadata\n",
    "    # ========================================================\n",
    "\n",
    "    raw = pd.read_csv(\n",
    "        counts_path,\n",
    "        compression=\"gzip\",\n",
    "        index_col=0\n",
    "    )\n",
    "\n",
    "\n",
    "    metadata = pd.read_csv(\n",
    "        metadata_path\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        raw.shape[\n",
    "            0\n",
    "        ]\n",
    "        ==\n",
    "        EXPECTED_UNIVERSES[\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        metadata\n",
    "    ) == 29\n",
    "\n",
    "\n",
    "    sample_order = (\n",
    "        metadata[\n",
    "            \"pseudobulk_group\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        raw.columns\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "        ==\n",
    "        sample_order\n",
    "    )\n",
    "\n",
    "\n",
    "    counts_full = (\n",
    "        raw.T\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    counts_full.index = pd.Index(\n",
    "        [\n",
    "            str(x)\n",
    "            for x\n",
    "            in counts_full.index\n",
    "        ],\n",
    "        dtype=\"object\"\n",
    "    )\n",
    "\n",
    "\n",
    "    counts_full.columns = pd.Index(\n",
    "        [\n",
    "            str(x)\n",
    "            for x\n",
    "            in counts_full.columns\n",
    "        ],\n",
    "        dtype=\"object\"\n",
    "    )\n",
    "\n",
    "\n",
    "    counts_full = (\n",
    "        counts_full\n",
    "        .astype(\n",
    "            np.int64\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # H2. Metadata preparation helper\n",
    "    # ========================================================\n",
    "\n",
    "    def prepare_metadata(\n",
    "        m,\n",
    "        include_technical=False\n",
    "    ):\n",
    "\n",
    "        columns = [\n",
    "            \"pseudobulk_group\",\n",
    "            \"donor_id\",\n",
    "            \"age\",\n",
    "            \"sex\",\n",
    "            \"diagnosis_binary\",\n",
    "        ]\n",
    "\n",
    "\n",
    "        if include_technical:\n",
    "\n",
    "            columns += [\n",
    "                \"PMI\",\n",
    "                \"RIN\",\n",
    "            ]\n",
    "\n",
    "\n",
    "        out = (\n",
    "            m[\n",
    "                columns\n",
    "            ]\n",
    "            .copy()\n",
    "        )\n",
    "\n",
    "\n",
    "        out.index = pd.Index(\n",
    "            out[\n",
    "                \"pseudobulk_group\"\n",
    "            ]\n",
    "            .astype(str)\n",
    "            .tolist(),\n",
    "            dtype=\"object\"\n",
    "        )\n",
    "\n",
    "\n",
    "        out = out.drop(\n",
    "            columns=[\n",
    "                \"pseudobulk_group\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "\n",
    "        out[\n",
    "            \"age\"\n",
    "        ] = pd.to_numeric(\n",
    "            out[\n",
    "                \"age\"\n",
    "            ],\n",
    "            errors=\"raise\"\n",
    "        )\n",
    "\n",
    "\n",
    "        if include_technical:\n",
    "\n",
    "            out[\n",
    "                \"PMI\"\n",
    "            ] = pd.to_numeric(\n",
    "                out[\n",
    "                    \"PMI\"\n",
    "                ],\n",
    "                errors=\"raise\"\n",
    "            )\n",
    "\n",
    "\n",
    "            out[\n",
    "                \"RIN\"\n",
    "            ] = pd.to_numeric(\n",
    "                out[\n",
    "                    \"RIN\"\n",
    "                ],\n",
    "                errors=\"raise\"\n",
    "            )\n",
    "\n",
    "\n",
    "        out[\n",
    "            \"sex\"\n",
    "        ] = pd.Categorical(\n",
    "            out[\n",
    "                \"sex\"\n",
    "            ].astype(str),\n",
    "            categories=[\n",
    "                \"Female\",\n",
    "                \"Male\",\n",
    "            ],\n",
    "            ordered=False\n",
    "        )\n",
    "\n",
    "\n",
    "        out[\n",
    "            \"diagnosis_binary\"\n",
    "        ] = pd.Categorical(\n",
    "            out[\n",
    "                \"diagnosis_binary\"\n",
    "            ].astype(str),\n",
    "            categories=[\n",
    "                \"Control\",\n",
    "                \"PD\",\n",
    "            ],\n",
    "            ordered=False\n",
    "        )\n",
    "\n",
    "\n",
    "        return out\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # H3. Load primary result\n",
    "    # ========================================================\n",
    "\n",
    "    primary = pd.read_csv(\n",
    "        primary_result_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        primary[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .is_unique\n",
    "    )\n",
    "\n",
    "\n",
    "    frozen_gene_order = (\n",
    "        raw.index\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        primary[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "        ==\n",
    "        frozen_gene_order\n",
    "    )\n",
    "\n",
    "\n",
    "    primary_sig = (\n",
    "        np.isfinite(\n",
    "            primary[\n",
    "                \"padj\"\n",
    "            ]\n",
    "        )\n",
    "        &\n",
    "        (\n",
    "            primary[\n",
    "                \"padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    n_primary_sig = int(\n",
    "        primary_sig.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # H4. SENSITIVITY A — PMI/RIN MODEL\n",
    "    # ========================================================\n",
    "\n",
    "    print(\n",
    "        \"\\nSensitivity A:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"~ age + sex + PMI + RIN + diagnosis_binary\"\n",
    "    )\n",
    "\n",
    "\n",
    "    tech_dir = (\n",
    "        SENS_ROOT /\n",
    "        cell_type /\n",
    "        \"technical_covariates\"\n",
    "    )\n",
    "\n",
    "\n",
    "    tech_dir.mkdir(\n",
    "        parents=True,\n",
    "        exist_ok=True\n",
    "    )\n",
    "\n",
    "\n",
    "    meta_tech = (\n",
    "        prepare_metadata(\n",
    "            metadata,\n",
    "            include_technical=True\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        counts_full.index.equals(\n",
    "            meta_tech.index\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    tech_fit = fit_deseq(\n",
    "\n",
    "        counts=\n",
    "            counts_full,\n",
    "\n",
    "        metadata=\n",
    "            meta_tech,\n",
    "\n",
    "        design=(\n",
    "            \"~ age + sex + PMI + RIN \"\n",
    "            \"+ diagnosis_binary\"\n",
    "        ),\n",
    "\n",
    "        contrast=[\n",
    "            \"diagnosis_binary\",\n",
    "            \"PD\",\n",
    "            \"Control\",\n",
    "        ],\n",
    "\n",
    "        output_dir=\n",
    "            tech_dir,\n",
    "\n",
    "        output_prefix=(\n",
    "            f\"GSE243639_{cell_type}_\"\n",
    "            f\"TECHNICAL_SENSITIVITY_v1\"\n",
    "        ),\n",
    "    )\n",
    "\n",
    "\n",
    "    tech = (\n",
    "        tech_fit[\n",
    "            \"result\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        tech[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "        ==\n",
    "        frozen_gene_order\n",
    "    )\n",
    "\n",
    "\n",
    "    tech_sig = (\n",
    "        np.isfinite(\n",
    "            tech[\n",
    "                \"padj\"\n",
    "            ]\n",
    "        )\n",
    "        &\n",
    "        (\n",
    "            tech[\n",
    "                \"padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # H5. SENSITIVITY B — AGE OVERLAP\n",
    "    # ========================================================\n",
    "\n",
    "    print(\n",
    "        \"\\nSensitivity B:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Age 57–93, 13 PD / 13 Control\"\n",
    "    )\n",
    "\n",
    "\n",
    "    overlap_dir = (\n",
    "        SENS_ROOT /\n",
    "        cell_type /\n",
    "        \"age_overlap\"\n",
    "    )\n",
    "\n",
    "\n",
    "    overlap_dir.mkdir(\n",
    "        parents=True,\n",
    "        exist_ok=True\n",
    "    )\n",
    "\n",
    "\n",
    "    overlap_meta_raw = (\n",
    "        metadata[\n",
    "            metadata[\n",
    "                \"donor_id\"\n",
    "            ]\n",
    "            .astype(str)\n",
    "            .isin(\n",
    "                AGE_OVERLAP_DONORS\n",
    "            )\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        overlap_meta_raw\n",
    "    ) == 26\n",
    "\n",
    "\n",
    "    assert (\n",
    "        overlap_meta_raw[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        .value_counts()\n",
    "        .to_dict()\n",
    "        ==\n",
    "        {\n",
    "            \"PD\": 13,\n",
    "            \"Control\": 13,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    overlap_samples = (\n",
    "        overlap_meta_raw[\n",
    "            \"pseudobulk_group\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    counts_overlap = (\n",
    "        counts_full\n",
    "        .loc[\n",
    "            overlap_samples,\n",
    "            :\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert counts_overlap.shape == (\n",
    "        26,\n",
    "        EXPECTED_UNIVERSES[\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    meta_overlap = (\n",
    "        prepare_metadata(\n",
    "            overlap_meta_raw,\n",
    "            include_technical=False\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        counts_overlap.index.equals(\n",
    "            meta_overlap.index\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    overlap_fit = fit_deseq(\n",
    "\n",
    "        counts=\n",
    "            counts_overlap,\n",
    "\n",
    "        metadata=\n",
    "            meta_overlap,\n",
    "\n",
    "        design=(\n",
    "            \"~ age + sex + diagnosis_binary\"\n",
    "        ),\n",
    "\n",
    "        contrast=[\n",
    "            \"diagnosis_binary\",\n",
    "            \"PD\",\n",
    "            \"Control\",\n",
    "        ],\n",
    "\n",
    "        output_dir=\n",
    "            overlap_dir,\n",
    "\n",
    "        output_prefix=(\n",
    "            f\"GSE243639_{cell_type}_\"\n",
    "            f\"AGE_OVERLAP_SENSITIVITY_v1\"\n",
    "        ),\n",
    "    )\n",
    "\n",
    "\n",
    "    overlap = (\n",
    "        overlap_fit[\n",
    "            \"result\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        overlap[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "        ==\n",
    "        frozen_gene_order\n",
    "    )\n",
    "\n",
    "\n",
    "    overlap_sig = (\n",
    "        np.isfinite(\n",
    "            overlap[\n",
    "                \"padj\"\n",
    "            ]\n",
    "        )\n",
    "        &\n",
    "        (\n",
    "            overlap[\n",
    "                \"padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # H6. MERGE THREE EFFECT VECTORS\n",
    "    # ========================================================\n",
    "\n",
    "    merged = (\n",
    "\n",
    "        primary[\n",
    "            [\n",
    "                \"gene_symbol\",\n",
    "                \"log2FoldChange\",\n",
    "                \"stat\",\n",
    "                \"pvalue\",\n",
    "                \"padj\",\n",
    "            ]\n",
    "        ]\n",
    "        .rename(\n",
    "            columns={\n",
    "\n",
    "                \"log2FoldChange\":\n",
    "                    \"primary_LFC\",\n",
    "\n",
    "                \"stat\":\n",
    "                    \"primary_Wald\",\n",
    "\n",
    "                \"pvalue\":\n",
    "                    \"primary_p\",\n",
    "\n",
    "                \"padj\":\n",
    "                    \"primary_padj\",\n",
    "            }\n",
    "        )\n",
    "        .merge(\n",
    "\n",
    "            tech[\n",
    "                [\n",
    "                    \"gene_symbol\",\n",
    "                    \"log2FoldChange\",\n",
    "                    \"stat\",\n",
    "                    \"pvalue\",\n",
    "                    \"padj\",\n",
    "                ]\n",
    "            ]\n",
    "            .rename(\n",
    "                columns={\n",
    "\n",
    "                    \"log2FoldChange\":\n",
    "                        \"technical_LFC\",\n",
    "\n",
    "                    \"stat\":\n",
    "                        \"technical_Wald\",\n",
    "\n",
    "                    \"pvalue\":\n",
    "                        \"technical_p\",\n",
    "\n",
    "                    \"padj\":\n",
    "                        \"technical_padj\",\n",
    "                }\n",
    "            ),\n",
    "\n",
    "            on=\n",
    "                \"gene_symbol\",\n",
    "\n",
    "            validate=\n",
    "                \"one_to_one\"\n",
    "        )\n",
    "        .merge(\n",
    "\n",
    "            overlap[\n",
    "                [\n",
    "                    \"gene_symbol\",\n",
    "                    \"log2FoldChange\",\n",
    "                    \"stat\",\n",
    "                    \"pvalue\",\n",
    "                    \"padj\",\n",
    "                ]\n",
    "            ]\n",
    "            .rename(\n",
    "                columns={\n",
    "\n",
    "                    \"log2FoldChange\":\n",
    "                        \"age_overlap_LFC\",\n",
    "\n",
    "                    \"stat\":\n",
    "                        \"age_overlap_Wald\",\n",
    "\n",
    "                    \"pvalue\":\n",
    "                        \"age_overlap_p\",\n",
    "\n",
    "                    \"padj\":\n",
    "                        \"age_overlap_padj\",\n",
    "                }\n",
    "            ),\n",
    "\n",
    "            on=\n",
    "                \"gene_symbol\",\n",
    "\n",
    "            validate=\n",
    "                \"one_to_one\"\n",
    "        )\n",
    "    )\n",    "\n",
    "\n",
    "    assert len(\n",
    "        merged\n",
    "    ) == EXPECTED_UNIVERSES[\n",
    "        cell_type\n",
    "    ]\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # H7. DESCRIPTIVE CONCORDANCE\n",
    "    # ========================================================\n",
    "\n",
    "    primary_lfc = (\n",
    "        merged[\n",
    "            \"primary_LFC\"\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    technical_lfc = (\n",
    "        merged[\n",
    "            \"technical_LFC\"\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    overlap_lfc = (\n",
    "        merged[\n",
    "            \"age_overlap_LFC\"\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    primary_wald = (\n",
    "        merged[\n",
    "            \"primary_Wald\"\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    technical_wald = (\n",
    "        merged[\n",
    "            \"technical_Wald\"\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    overlap_wald = (\n",
    "        merged[\n",
    "            \"age_overlap_Wald\"\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    # All-gene effect correlations\n",
    "    tech_lfc_pearson = (\n",
    "        safe_pearson(\n",
    "            primary_lfc,\n",
    "            technical_lfc\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    tech_lfc_spearman = (\n",
    "        safe_spearman(\n",
    "            primary_lfc,\n",
    "            technical_lfc\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    overlap_lfc_pearson = (\n",
    "        safe_pearson(\n",
    "            primary_lfc,\n",
    "            overlap_lfc\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    overlap_lfc_spearman = (\n",
    "        safe_spearman(\n",
    "            primary_lfc,\n",
    "            overlap_lfc\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    tech_wald_spearman = (\n",
    "        safe_spearman(\n",
    "            primary_wald,\n",
    "            technical_wald\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    overlap_wald_spearman = (\n",
    "        safe_spearman(\n",
    "            primary_wald,\n",
    "            overlap_wald\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Direction concordance across ALL finite nonzero effects\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    tech_direction_mask = (\n",
    "        np.isfinite(\n",
    "            primary_lfc\n",
    "        )\n",
    "        &\n",
    "        np.isfinite(\n",
    "            technical_lfc\n",
    "        )\n",
    "        &\n",
    "        (\n",
    "            primary_lfc\n",
    "            !=\n",
    "            0\n",
    "        )\n",
    "        &\n",
    "        (\n",
    "            technical_lfc\n",
    "            !=\n",
    "            0\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    overlap_direction_mask = (\n",
    "        np.isfinite(\n",
    "            primary_lfc\n",
    "        )\n",
    "        &\n",
    "        np.isfinite(\n",
    "            overlap_lfc\n",
    "        )\n",
    "        &\n",
    "        (\n",
    "            primary_lfc\n",
    "            !=\n",
    "            0\n",
    "        )\n",
    "        &\n",
    "        (\n",
    "            overlap_lfc\n",
    "            !=\n",
    "            0\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    tech_direction_concordance = float(\n",
    "\n",
    "        (\n",
    "            np.sign(\n",
    "                primary_lfc[\n",
    "                    tech_direction_mask\n",
    "                ]\n",
    "            )\n",
    "            ==\n",
    "            np.sign(\n",
    "                technical_lfc[\n",
    "                    tech_direction_mask\n",
    "                ]\n",
    "            )\n",
    "        ).mean()\n",
    "    )\n",
    "\n",
    "\n",
    "    overlap_direction_concordance = float(\n",
    "\n",
    "        (\n",
    "            np.sign(\n",
    "                primary_lfc[\n",
    "                    overlap_direction_mask\n",
    "                ]\n",
    "            )\n",
    "            ==\n",
    "            np.sign(\n",
    "                overlap_lfc[\n",
    "                    overlap_direction_mask\n",
    "                ]\n",
    "            )\n",
    "        ).mean()\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # H8. PRIMARY FDR-GENE ROBUSTNESS\n",
    "    #\n",
    "    # This is descriptive.\n",
    "    # We are NOT redefining the primary result.\n",
    "    # ========================================================\n",
    "\n",
    "    primary_sig_genes = set(\n",
    "        primary.loc[\n",
    "            primary_sig,\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "    )\n",
    "\n",
    "\n",
    "    primary_sig_merged = (\n",
    "        merged[\n",
    "            merged[\n",
    "                \"gene_symbol\"\n",
    "            ]\n",
    "            .isin(\n",
    "                primary_sig_genes\n",
    "            )\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        primary_sig_merged\n",
    "    ) == n_primary_sig\n",
    "\n",
    "\n",
    "    tech_primary_sig_direction_same = int(\n",
    "\n",
    "        (\n",
    "            np.sign(\n",
    "                primary_sig_merged[\n",
    "                    \"primary_LFC\"\n",
    "                ]\n",
    "            )\n",
    "            ==\n",
    "            np.sign(\n",
    "                primary_sig_merged[\n",
    "                    \"technical_LFC\"\n",
    "                ]\n",
    "            )\n",
    "        ).sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    overlap_primary_sig_direction_same = int(\n",
    "\n",
    "        (\n",
    "            np.sign(\n",
    "                primary_sig_merged[\n",
    "                    \"primary_LFC\"\n",
    "                ]\n",
    "            )\n",
    "            ==\n",
    "            np.sign(\n",
    "                primary_sig_merged[\n",
    "                    \"age_overlap_LFC\"\n",
    "                ]\n",
    "            )\n",
    "        ).sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    tech_primary_sig_nominal = int(\n",
    "\n",
    "        (\n",
    "            primary_sig_merged[\n",
    "                \"technical_p\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        ).sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    overlap_primary_sig_nominal = int(\n",
    "\n",
    "        (\n",
    "            primary_sig_merged[\n",
    "                \"age_overlap_p\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        ).sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    tech_primary_sig_FDR = int(\n",
    "\n",
    "        (\n",
    "            primary_sig_merged[\n",
    "                \"technical_padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "        .fillna(\n",
    "            False\n",
    "        )\n",
    "        .sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    overlap_primary_sig_FDR = int(\n",
    "\n",
    "        (\n",
    "            primary_sig_merged[\n",
    "                \"age_overlap_padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "        .fillna(\n",
    "            False\n",
    "        )\n",
    "        .sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # H9. SAVE THREE-WAY COMPARISON\n",
    "    # ========================================================\n",
    "\n",
    "    comparison_path = (\n",
    "        SENS_ROOT /\n",
    "        cell_type /\n",
    "        (\n",
    "            f\"GSE243639_{cell_type}_\"\n",
    "            f\"PRIMARY_vs_SENSITIVITIES_v1.csv.gz\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    merged.to_csv(\n",
    "        comparison_path,\n",
    "        index=False,\n",
    "        compression={\n",
    "            \"method\":\n",
    "                \"gzip\",\n",
    "\n",
    "            \"compresslevel\":\n",
    "                6,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # H10. SUMMARY COUNTS\n",
    "    # ========================================================\n",
    "\n",
    "    n_tech_sig = int(\n",
    "        tech_sig.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_overlap_sig = int(\n",
    "        overlap_sig.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    summary_rows.append({\n",
    "\n",
    "        \"cell_type\":\n",
    "            cell_type,\n",
    "\n",
    "        \"primary_FDR\":\n",
    "            n_primary_sig,\n",
    "\n",
    "        \"technical_FDR\":\n",
    "            n_tech_sig,\n",
    "\n",
    "        \"age_overlap_FDR\":\n",
    "            n_overlap_sig,\n",
    "\n",
    "        \"technical_up\":\n",
    "            int(\n",
    "                (\n",
    "                    tech.loc[\n",
    "                        tech_sig,\n",
    "                        \"log2FoldChange\"\n",
    "                    ]\n",
    "                    >\n",
    "                    0\n",
    "                ).sum()\n",
    "            ),\n",
    "\n",
    "        \"technical_down\":\n",
    "            int(\n",
    "                (\n",
    "                    tech.loc[\n",
    "                        tech_sig,\n",
    "                        \"log2FoldChange\"\n",
    "                    ]\n",
    "                    <\n",
    "                    0\n",
    "                ).sum()\n",
    "            ),\n",
    "\n",
    "        \"age_overlap_up\":\n",
    "            int(\n",
    "                (\n",
    "                    overlap.loc[\n",
    "                        overlap_sig,\n",
    "                        \"log2FoldChange\"\n",
    "                    ]\n",
    "                    >\n",
    "                    0\n",
    "                ).sum()\n",
    "            ),\n",
    "\n",
    "        \"age_overlap_down\":\n",
    "            int(\n",
    "                (\n",
    "                    overlap.loc[\n",
    "                        overlap_sig,\n",
    "                        \"log2FoldChange\"\n",
    "                    ]\n",
    "                    <\n",
    "                    0\n",
    "                ).sum()\n",
    "            ),\n",
    "    })\n",
    "\n",
    "\n",
    "    concordance_rows.append({\n",
    "\n",
    "        \"cell_type\":\n",
    "            cell_type,\n",
    "\n",
    "        \"primary_n_FDR\":\n",
    "            n_primary_sig,\n",
    "\n",
    "        \"technical_LFC_pearson\":\n",
    "            tech_lfc_pearson,\n",
    "\n",
    "        \"technical_LFC_spearman\":\n",
    "            tech_lfc_spearman,\n",
    "\n",
    "        \"technical_Wald_spearman\":\n",
    "            tech_wald_spearman,\n",
    "\n",
    "        \"technical_all_gene_direction_concordance\":\n",
    "            tech_direction_concordance,\n",
    "\n",
    "        \"technical_primary_FDR_same_direction\":\n",
    "            tech_primary_sig_direction_same,\n",
    "\n",
    "        \"technical_primary_FDR_nominal_p_lt_0.05\":\n",
    "            tech_primary_sig_nominal,\n",
    "\n",
    "        \"technical_primary_FDR_still_FDR_lt_0.05\":\n",
    "            tech_primary_sig_FDR,\n",
    "\n",
    "        \"age_overlap_LFC_pearson\":\n",
    "            overlap_lfc_pearson,\n",
    "\n",
    "        \"age_overlap_LFC_spearman\":\n",
    "            overlap_lfc_spearman,\n",
    "\n",
    "        \"age_overlap_Wald_spearman\":\n",
    "            overlap_wald_spearman,\n",
    "\n",
    "        \"age_overlap_all_gene_direction_concordance\":\n",
    "            overlap_direction_concordance,\n",
    "\n",
    "        \"age_overlap_primary_FDR_same_direction\":\n",
    "            overlap_primary_sig_direction_same,\n",
    "\n",
    "        \"age_overlap_primary_FDR_nominal_p_lt_0.05\":\n",
    "            overlap_primary_sig_nominal,\n",
    "\n",
    "        \"age_overlap_primary_FDR_still_FDR_lt_0.05\":\n",
    "            overlap_primary_sig_FDR,\n",
    "    })\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # H11. RECORD\n",
    "    # ========================================================\n",
    "\n",
    "    run_records[\n",
    "        cell_type\n",
    "    ] = {\n",
    "\n",
    "        \"frozen_gene_universe\":\n",
    "            int(\n",
    "                EXPECTED_UNIVERSES[\n",
    "                    cell_type\n",
    "                ]\n",
    "            ),\n",
    "\n",
    "        \"gene_refiltered\":\n",
    "            False,\n",
    "\n",
    "        \"technical_sensitivity\": {\n",
    "\n",
    "            \"n_donors\":\n",
    "                29,\n",
    "\n",
    "            \"n_PD\":\n",
    "                15,\n",
    "\n",
    "            \"n_Control\":\n",
    "                14,\n",
    "\n",
    "            \"model\":\n",
    "                (\n",
    "                    \"~ age + sex + PMI + RIN \"\n",
    "                    \"+ diagnosis_binary\"\n",
    "                ),\n",
    "\n",
    "            \"design_rank\":\n",
    "                int(\n",
    "                    tech_fit[\n",
    "                        \"design_rank\"\n",
    "                    ]\n",
    "                ),\n",
    "\n",
    "            \"design_columns\":\n",
    "                int(\n",
    "                    tech_fit[\n",
    "                        \"design_columns\"\n",
    "                    ]\n",
    "                ),\n",
    "\n",
    "            \"all_gene_results\":\n",
    "                str(\n",
    "                    tech_fit[\n",
    "                        \"result_path\"\n",
