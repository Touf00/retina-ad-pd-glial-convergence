   "source": [
    "# Source analysis cell: 101\n",
    "# ============================================================\n",
    "# SUPPLEMENTARY FIGURE S1 — FINAL IMPROVED VERSION\n",
    "# PD DISCOVERY → INDEPENDENT REPLICATION ROBUSTNESS\n",
    "#\n",
    "# Improvements vs previous version:\n",
    "# - Panel B: 50% expectation note moved OUTSIDE the graph\n",
    "# - Panel D: table moved higher for cleaner spacing\n",
    "# - No DE rerun\n",
    "# - No statistics rerun\n",
    "# - Exact frozen notebook values\n",
    "# ============================================================\n",
    "\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "import json\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from matplotlib.patches import Patch\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "assert ROOT.exists(), f\"Project root missing:\\n{ROOT}\"\n",
    "\n",
    "FIG_DIR = ROOT / \"results\" / \"publication_figures\" / \"supplementary\"\n",
    "FIG_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. EXACT FROZEN VALUES\n",
    "# ============================================================\n",
    "\n",
    "evidence = pd.DataFrame(\n",
    "    {\n",
    "        \"cell_type\": [\n",
    "            \"Astro\",\n",
    "            \"Micro\",\n",
    "            \"OPC\",\n",
    "            \"Oligo\",\n",
    "        ],\n",
    "\n",
    "        \"matched_unique_genes\": [\n",
    "            16460,\n",
    "            15283,\n",
    "            15665,\n",
    "            15030,\n",
    "        ],\n",
    "\n",
    "        \"LFC_spearman\": [\n",
    "            0.2248951159524824,\n",
    "            -0.02409736663067012,\n",
    "            0.10876192070858962,\n",
    "            0.2837557803320344,\n",
    "        ],\n",
    "\n",
    "        \"LFC_permutation_q_BH\": [\n",
    "            0.000133,\n",
    "            0.998900,\n",
    "            0.000133,\n",
    "            0.000133,\n",
    "        ],\n",
    "\n",
    "        \"Wald_spearman\": [\n",
    "            0.24774251487102902,\n",
    "            0.026362773225425785,\n",
    "            0.15458377281517324,\n",
    "            0.3415968827330343,\n",
    "        ],\n",
    "\n",
    "        \"Wald_permutation_q_BH\": [\n",
    "            0.000133,\n",
    "            0.000400,\n",
    "            0.000133,\n",
    "            0.000133,\n",
    "        ],\n",
    "\n",
    "        \"all_gene_direction_concordance\": [\n",
    "            0.5759416767922235,\n",
    "            0.5169796505921612,\n",
    "            0.5463134375997446,\n",
    "            0.6095143047238856,\n",
    "        ],\n",
    "\n",
    "        \"vector_level_replication_supported\": [\n",
    "            True,\n",
    "            False,\n",
    "            True,\n",
    "            True,\n",
    "        ],\n",
    "\n",
    "        \"discovery_FDR_total\": [\n",
    "            18,\n",
    "            144,\n",
    "            1,\n",
    "            2,\n",
    "        ],\n",
    "\n",
    "        \"discovery_FDR_measurable\": [\n",
    "            18,\n",
    "            141,\n",
    "            1,\n",
    "            2,\n",
    "        ],\n",
    "\n",
    "        \"same_direction\": [\n",
    "            13,\n",
    "            36,\n",
    "            1,\n",
    "            2,\n",
    "        ],\n",
    "\n",
    "        \"same_direction_fraction\": [\n",
    "            13 / 18,\n",
    "            36 / 141,\n",
    "            1.0,\n",
    "            1.0,\n",
    "        ],\n",
    "\n",
    "        \"direction_binomial_q_BH\": [\n",
    "            0.192505,\n",
    "            1.000000,\n",
    "            0.666667,\n",
    "            0.500000,\n",
    "        ],\n",
    "\n",
    "        \"gene_level_replication_success\": [\n",
    "            4,\n",
    "            3,\n",
    "            1,\n",
    "            0,\n",
    "        ],\n",
    "\n",
    "        \"gene_level_replication_fraction\": [\n",
    "            4 / 18,\n",
    "            3 / 141,\n",
    "            1.0,\n",
    "            0.0,\n",
    "        ],\n",
    "\n",
    "        \"replication_FDR_same_direction\": [\n",
    "            0,\n",
    "            0,\n",
    "            0,\n",
    "            0,\n",
    "        ],\n",
    "\n",
    "        \"gene_level_replication_success_PMI_supported\": [\n",
    "            3,\n",
    "            2,\n",
    "            0,\n",
    "            0,\n",
    "        ],\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. SAVE SOURCE DATA\n",
    "# ============================================================\n",
    "\n",
    "SOURCE_DATA_PATH = (\n",
    "    FIG_DIR\n",
    "    / \"Supplementary_Figure_S1_PD_replication_source_data.csv\"\n",
    ")\n",
    "\n",
    "evidence.to_csv(\n",
    "    SOURCE_DATA_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. FIGURE FRAME\n",
    "# ============================================================\n",
    "\n",
    "CELL_TYPES = [\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "]\n",
    "\n",
    "x = np.arange(len(CELL_TYPES))\n",
    "\n",
    "fig = plt.figure(\n",
    "    figsize=(14.4, 10.8)\n",
    ")\n",
    "\n",
    "outer = fig.add_gridspec(\n",
    "    2,\n",
    "    2,\n",
    "    left=0.065,\n",
    "    right=0.985,\n",
    "    bottom=0.085,\n",
    "    top=0.905,\n",
    "    wspace=0.16,\n",
    "    hspace=0.24,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# HELPER — TITLE + INFO STRIP + PLOT\n",
    "# ============================================================\n",
    "\n",
    "def make_panel(\n",
    "    spec,\n",
    "    title,\n",
    "    title_height=0.12,\n",
    "    info_height=0.12,\n",
    "):\n",
    "    inner = spec.subgridspec(\n",
    "        3,\n",
    "        1,\n",
    "        height_ratios=[\n",
    "            title_height,\n",
    "            info_height,\n",
    "            1.0,\n",
    "        ],\n",
    "        hspace=0.0,\n",
    "    )\n",
    "\n",
    "    title_ax = fig.add_subplot(inner[0])\n",
    "    info_ax = fig.add_subplot(inner[1])\n",
    "    plot_ax = fig.add_subplot(inner[2])\n",
    "\n",
    "    title_ax.axis(\"off\")\n",
    "    info_ax.axis(\"off\")\n",
    "\n",
    "    title_ax.text(\n",
    "        0.0,\n",
    "        0.50,\n",
    "        title,\n",
    "        fontsize=12,\n",
    "        fontweight=\"bold\",\n",
    "        ha=\"left\",\n",
    "        va=\"center\",\n",
    "        transform=title_ax.transAxes,\n",
    "    )\n",
    "\n",
    "    return title_ax, info_ax, plot_ax\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# PANEL A\n",
    "# ============================================================\n",
    "\n",
    "titleA, infoA, axA = make_panel(\n",
    "    outer[0, 0],\n",
    "    \"A   Discovery–replication effect-vector concordance\",\n",
    "    title_height=0.12,\n",
    "    info_height=0.13,\n",
    ")\n",
    "\n",
    "width = 0.34\n",
    "\n",
    "bars_lfc = axA.bar(\n",
    "    x - width / 2,\n",
    "    evidence[\"LFC_spearman\"],\n",
    "    width,\n",
    "    label=\"log2FC\",\n",
    ")\n",
    "\n",
    "bars_wald = axA.bar(\n",
    "    x + width / 2,\n",
    "    evidence[\"Wald_spearman\"],\n",
    "    width,\n",
    "    label=\"Wald statistic\",\n",
    ")\n",
    "\n",
    "axA.axhline(0, linewidth=0.8)\n",
    "axA.set_ylim(-0.045, 0.43)\n",
    "axA.set_xticks(x)\n",
    "axA.set_xticklabels(CELL_TYPES)\n",
    "axA.set_ylabel(\"Spearman ρ\")\n",
    "\n",
    "legend_A = [\n",
    "    Patch(facecolor=bars_lfc.patches[0].get_facecolor(), label=\"log2FC\"),\n",
    "    Patch(facecolor=bars_wald.patches[0].get_facecolor(), label=\"Wald statistic\"),\n",
    "]\n",
    "\n",
    "infoA.legend(\n",
    "    handles=legend_A,\n",
    "    loc=\"center left\",\n",
    "    bbox_to_anchor=(0.0, 0.50),\n",
    "    frameon=False,\n",
    "    fontsize=8.4,\n",
    "    ncol=2,\n",
    "    borderaxespad=0,\n",
    "    handlelength=1.8,\n",
    "    columnspacing=1.4,\n",
    ")\n",
    "\n",
    "infoA.text(\n",
    "    0.99,\n",
    "    0.50,\n",
    "    \"* permutation q < 0.05\",\n",
    "    fontsize=7.8,\n",
    "    ha=\"right\",\n",
    "    va=\"center\",\n",
    "    transform=infoA.transAxes,\n",
    ")\n",
    "\n",
    "for i in range(len(evidence)):\n",
    "    if evidence.loc[i, \"LFC_permutation_q_BH\"] < 0.05:\n",
    "        y = evidence.loc[i, \"LFC_spearman\"]\n",
    "        axA.text(\n",
    "            x[i] - width / 2,\n",
    "            y + (0.017 if y >= 0 else 0.010),\n",
    "            \"*\",\n",
    "            ha=\"center\",\n",
    "            va=\"bottom\",\n",
    "            fontsize=13,\n",
    "        )\n",
    "\n",
    "    if evidence.loc[i, \"Wald_permutation_q_BH\"] < 0.05:\n",
    "        y = evidence.loc[i, \"Wald_spearman\"]\n",
    "        axA.text(\n",
    "            x[i] + width / 2,\n",
    "            y + 0.017,\n",
    "            \"*\",\n",
    "            ha=\"center\",\n",
    "            va=\"bottom\",\n",
    "            fontsize=13,\n",
    "        )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# PANEL B\n",
    "# ============================================================\n",
    "\n",
    "titleB, infoB, axB = make_panel(\n",
    "    outer[0, 1],\n",
    "    \"B   All-gene directional concordance\",\n",
    "    title_height=0.12,\n",
    "    info_height=0.08,\n",
    ")\n",
    "\n",
    "direction_pct = evidence[\"all_gene_direction_concordance\"] * 100\n",
    "\n",
    "bars_direction = axB.bar(\n",
    "    x,\n",
    "    direction_pct,\n",
    "    width=0.76,\n",
    ")\n",
    "\n",
    "axB.axhline(\n",
    "    50,\n",
    "    linestyle=\"--\",\n",
    "    linewidth=1.0,\n",
    "    color=\"0.35\",\n",
    "    zorder=0,\n",
    ")\n",
    "\n",
    "axB.set_ylim(0, 70)\n",
    "axB.set_xticks(x)\n",
    "axB.set_xticklabels(CELL_TYPES)\n",
    "axB.set_ylabel(\"Same-direction genes (%)\")\n",
    "\n",
    "for i, bar in enumerate(bars_direction):\n",
    "    axB.text(\n",
    "        bar.get_x() + bar.get_width() / 2,\n",
    "        bar.get_height() + 1.1,\n",
    "        f\"{direction_pct.iloc[i]:.1f}%\",\n",
    "        ha=\"center\",\n",
    "        va=\"bottom\",\n",
    "        fontsize=9,\n",
    "    )\n",
    "\n",
    "# moved fully outside the graph\n",
    "infoB.text(\n",
    "    1.0,\n",
    "    0.50,\n",
    "    \"Dashed line = 50% directional expectation\",\n",
    "    fontsize=7.8,\n",
    "    ha=\"right\",\n",
    "    va=\"center\",\n",
    "    color=\"0.35\",\n",
    "    transform=infoB.transAxes,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# PANEL C\n",
    "# ============================================================\n",
    "\n",
    "titleC, infoC, axC = make_panel(\n",
    "    outer[1, 0],\n",
    "    \"C   Discovery-FDR hit replication\",\n",
    "    title_height=0.12,\n",
    "    info_height=0.12,\n",
    ")\n",
    "\n",
    "same_pct = evidence[\"same_direction_fraction\"] * 100\n",
    "rep_pct = evidence[\"gene_level_replication_fraction\"] * 100\n",
    "\n",
    "bars_same = axC.bar(\n",
    "    x - width / 2,\n",
    "    same_pct,\n",
    "    width,\n",
    "    label=\"Same direction\",\n",
    ")\n",
    "\n",
    "bars_rep = axC.bar(\n",
    "    x + width / 2,\n",
    "    rep_pct,\n",
    "    width,\n",
    "    label=\"Same direction + replication P < 0.05\",\n",
    ")\n",
    "\n",
    "axC.set_ylim(0, 130)\n",
    "axC.set_xticks(x)\n",
    "axC.set_xticklabels(CELL_TYPES)\n",
    "axC.set_ylabel(\"Discovery-FDR hits supported (%)\")\n",
    "\n",
    "legend_C = [\n",
    "    Patch(facecolor=bars_same.patches[0].get_facecolor(), label=\"Same direction\"),\n",
    "    Patch(facecolor=bars_rep.patches[0].get_facecolor(), label=\"Same direction + replication P < 0.05\"),\n",
    "]\n",
    "\n",
    "infoC.legend(\n",
    "    handles=legend_C,\n",
    "    loc=\"center left\",\n",
    "    bbox_to_anchor=(0.0, 0.50),\n",
    "    frameon=False,\n",
    "    fontsize=8.0,\n",
    "    ncol=2,\n",
    "    borderaxespad=0,\n",
    "    handlelength=1.8,\n",
    "    columnspacing=1.2,\n",
    ")\n",
    "\n",
    "for i in range(len(evidence)):\n",
    "    n = int(evidence.loc[i, \"discovery_FDR_measurable\"])\n",
    "    same = int(evidence.loc[i, \"same_direction\"])\n",
    "    success = int(evidence.loc[i, \"gene_level_replication_success\"])\n",
    "\n",
    "    axC.text(\n",
    "        x[i] - width / 2,\n",
    "        same_pct.iloc[i] + 3,\n",
    "        f\"{same}/{n}\",\n",
    "        ha=\"center\",\n",
    "        va=\"bottom\",\n",
    "        fontsize=8,\n",
    "    )\n",
    "\n",
    "    axC.text(\n",
    "        x[i] + width / 2,\n",
    "        rep_pct.iloc[i] + 3,\n",
    "        f\"{success}/{n}\",\n",
    "        ha=\"center\",\n",
    "        va=\"bottom\",\n",
    "        fontsize=8,\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# PANEL D\n",
    "# ============================================================\n",
    "\n",
    "titleD, infoD, axD = make_panel(\n",
    "    outer[1, 1],\n",
    "    \"D   Frozen replication evidence summary\",\n",
    "    title_height=0.12,\n",
    "    info_height=0.04,\n",
    ")\n",
    "\n",
    "axD.axis(\"off\")\n",
    "\n",
    "table_data = []\n",
    "\n",
    "for _, r in evidence.iterrows():\n",
    "    vector = \"YES\" if bool(r[\"vector_level_replication_supported\"]) else \"NO\"\n",
    "    gene_success = int(r[\"gene_level_replication_success\"])\n",
    "    pmi_success = int(r[\"gene_level_replication_success_PMI_supported\"])\n",
    "    measurable = int(r[\"discovery_FDR_measurable\"])\n",
    "\n",
    "    table_data.append(\n",
    "        [\n",
    "            r[\"cell_type\"],\n",
    "            f\"{int(r['matched_unique_genes']):,}\",\n",
    "            vector,\n",
    "            f\"{gene_success}/{measurable}\",\n",
    "            str(pmi_success),\n",
    "        ]\n",
    "    )\n",
    "\n",
    "# moved higher\n",
    "table = axD.table(\n",
    "    cellText=table_data,\n",
    "    colLabels=[\n",
    "        \"Cell type\",\n",
    "        \"Matched\\ngenes\",\n",
    "        \"Vector-level\\nreplication\",\n",
    "        \"Nominal gene\\nreplication\",\n",
    "        \"PMI-supported\\nsuccesses\",\n",
    "    ],\n",
    "    loc=\"center\",\n",
    "    cellLoc=\"center\",\n",
    "    colLoc=\"center\",\n",
    "    bbox=[\n",
    "        0.00,   # x\n",
    "        0.38,   # y  (higher than before)\n",
    "        1.00,   # width\n",
    "        0.50,   # height\n",
    "    ],\n",
    ")\n",
    "\n",
    "table.auto_set_font_size(False)\n",
    "table.set_fontsize(8.3)\n",
    "table.scale(1.0, 1.65)\n",
    "\n",
    "total_success = int(evidence[\"gene_level_replication_success\"].sum())\n",
    "total_pmi = int(evidence[\"gene_level_replication_success_PMI_supported\"].sum())\n",
    "\n",
    "axD.text(\n",
    "    0.5,\n",
    "    0.24,\n",
    "    (\n",
    "        f\"Prespecified gene-level successes: \"\n",
    "        f\"{total_success}; PMI-supported: {total_pmi}\"\n",
    "    ),\n",
    "    transform=axD.transAxes,\n",
    "    ha=\"center\",\n",
    "    va=\"center\",\n",
    "    fontsize=9,\n",
    "    fontweight=\"bold\",\n",
    ")\n",
    "\n",
    "axD.text(\n",
    "    0.5,\n",
    "    0.16,\n",
    "    (\n",
    "        \"Success = discovery FDR < 0.05, same direction, \"\n",
    "        \"replication P < 0.05.\"\n",    "    ),\n",
    "    transform=axD.transAxes,\n",
    "    ha=\"center\",\n",
    "    va=\"center\",\n",
    "    fontsize=7.9,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. GLOBAL TITLE / FOOTNOTE\n",
    "# ============================================================\n",
    "\n",
    "fig.suptitle(\n",
    "    (\n",
    "        \"Independent Parkinson’s disease replication supports \"\n",
    "        \"glial effect-vector reproducibility\"\n",
    "    ),\n",
    "    fontsize=15,\n",
    "    fontweight=\"bold\",\n",
    "    y=0.985,\n",
    ")\n",
    "\n",
    "fig.text(\n",
    "    0.5,\n",
    "    0.025,\n",
    "    (\n",
    "        \"GSE243639 discovery → GSE157783 replication. \"\n",
    "        \"Whole-vector replication is the primary evidence; \"\n",
    "        \"discovery-FDR gene support is secondary.\"\n",
    "    ),\n",
    "    ha=\"center\",\n",
    "    va=\"center\",\n",
    "    fontsize=8.1,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. SAVE\n",
    "# ============================================================\n",
    "\n",
    "PNG_PATH = (\n",
    "    FIG_DIR\n",
    "    / \"Supplementary_Figure_S1_PD_replication_QC.png\"\n",
    ")\n",
    "\n",
    "PDF_PATH = (\n",
    "    FIG_DIR\n",
    "    / \"Supplementary_Figure_S1_PD_replication_QC.pdf\"\n",
    ")\n",
    "\n",
    "SVG_PATH = (\n",
    "    FIG_DIR\n",
    "    / \"Supplementary_Figure_S1_PD_replication_QC.svg\"\n",
    ")\n",
    "\n",
    "fig.savefig(\n",
    "    PNG_PATH,\n",
    "    dpi=600,\n",
    "    bbox_inches=\"tight\",\n",
    ")\n",
    "\n",
    "fig.savefig(\n",
    "    PDF_PATH,\n",
    "    bbox_inches=\"tight\",\n",
    ")\n",
    "\n",
    "fig.savefig(\n",
    "    SVG_PATH,\n",
    "    bbox_inches=\"tight\",\n",
    ")\n",
    "\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. PROVENANCE\n",
    "# ============================================================\n",
    "\n",
    "PROVENANCE_PATH = (\n",
    "    FIG_DIR\n",
    "    / \"Supplementary_Figure_S1_PD_replication_QC_provenance.json\"\n",
    ")\n",
    "\n",
    "record = {\n",
    "    \"figure\": \"Supplementary Figure S1\",\n",
    "    \"analysis\": \"GSE243639 discovery versus GSE157783 replication\",\n",
    "    \"source_mode\": \"exact frozen values preserved in executed master notebook\",\n",
    "    \"statistics_rerun\": False,\n",
    "    \"replication_rule\": (\n",
    "        \"discovery FDR < 0.05 AND same direction \"\n",
    "        \"AND replication nominal P < 0.05\"\n",
    "    ),\n",
    "    \"created_utc\": datetime.now(timezone.utc).isoformat(),\n",
    "}\n",
    "\n",
    "with open(\n",
    "    PROVENANCE_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "    json.dump(\n",
    "        record,\n",
    "        f,\n",
    "        indent=2,\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. REPORT\n",
    "# ============================================================\n",
    "\n",
    "print(\"=\" * 90)\n",
    "print(\"SUPPLEMENTARY FIGURE S1 — FINAL IMPROVED VERSION COMPLETE\")\n",
    "print(\"=\" * 90)\n",
    "\n",
    "for p in [\n",
    "    PNG_PATH,\n",
    "    PDF_PATH,\n",
    "    SVG_PATH,\n",
    "    SOURCE_DATA_PATH,\n",
    "    PROVENANCE_PATH,\n",
    "]:\n",
    "    print(\n",
    "        f\"{p.name}:\",\n",
    "        \"OK\" if p.exists() else \"MISSING\",\n",
    "    )\n",
    "\n",
    "print(\"\\nSaved to:\")\n",
    "print(FIG_DIR)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 99\n",
    "# ============================================================\n",
    "# SUPPLEMENTARY FIGURE S2 — FINAL NO-OVERLAP VERSION\n",
    "# AD DISCOVERY → PRIMARY SAME-REGION REPLICATION\n",
    "#\n",
    "# - no upstream files required\n",
    "# - no DE rerun\n",
    "# - no statistics rerun\n",
    "# - exact frozen notebook values\n",
    "# - legends and annotations separated from data\n",
    "# ============================================================\n",
    "\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "import json\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from matplotlib.patches import Patch\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "assert ROOT.exists(), f\"Project root missing:\\n{ROOT}\"\n",
    "\n",
    "FIG_DIR = (\n",
    "    ROOT\n",
    "    / \"results\"\n",
    "    / \"publication_figures\"\n",
    "    / \"supplementary\"\n",
    ")\n",
    "\n",
    "FIG_DIR.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. EXACT FROZEN PRIMARY-REPLICATION VALUES\n",
    "# ============================================================\n",
    "\n",
    "evidence = pd.DataFrame(\n",
    "    {\n",
    "        \"cell_type\": [\n",
    "            \"Astro\",\n",
    "            \"Micro\",\n",
    "            \"OPC\",\n",
    "            \"Oligo\",\n",
    "        ],\n",
    "\n",
    "        \"matched_unique_genes\": [\n",
    "            15492,\n",
    "            15024,\n",
    "            13647,\n",
    "            14307,\n",
    "        ],\n",
    "\n",
    "        \"finite_LFC_pairs\": [\n",
    "            15492,\n",
    "            15024,\n",
    "            13647,\n",
    "            14307,\n",
    "        ],\n",
    "\n",
    "        \"LFC_spearman\": [\n",
    "            0.1817996292636457,\n",
    "            0.04735547031110996,\n",
    "            0.05067622860365389,\n",
    "            0.16324710120303587,\n",
    "        ],\n",
    "\n",
    "        \"LFC_perm_p\": [\n",
    "            9.999000099990002e-05,\n",
    "            9.999000099990002e-05,\n",
    "            9.999000099990002e-05,\n",
    "            9.999000099990002e-05,\n",
    "        ],\n",
    "\n",
    "        \"finite_Wald_pairs\": [\n",
    "            15492,\n",
    "            15024,\n",
    "            13647,\n",
    "            14307,\n",
    "        ],\n",
    "\n",
    "        \"Wald_spearman\": [\n",
    "            0.2125570715425283,\n",
    "            0.058468998912983884,\n",
    "            0.06578216804876995,\n",
    "            0.16277925041815067,\n",
    "        ],\n",
    "\n",
    "        \"Wald_perm_p\": [\n",
    "            9.999000099990002e-05,\n",
    "            9.999000099990002e-05,\n",
    "            9.999000099990002e-05,\n",
    "            9.999000099990002e-05,\n",
    "        ],\n",
    "\n",
    "        \"all_gene_direction_concordance\": [\n",
    "            0.5713916860315001,\n",
    "            0.5150425985090522,\n",
    "            0.5220194914633253,\n",
    "            0.5647585098203677,\n",
    "        ],\n",
    "\n",
    "        \"discovery_FDR_measurable\": [\n",
    "            1,\n",
    "            3,\n",
    "            0,\n",
    "            30,\n",
    "        ],\n",
    "\n",
    "        \"same_direction_hits\": [\n",
    "            0,\n",
    "            2,\n",
    "            0,\n",
    "            21,\n",
    "        ],\n",
    "\n",
    "        \"gene_level_replication_success\": [\n",
    "            0,\n",
    "            1,\n",
    "            0,\n",
    "            2,\n",
    "        ],\n",
    "\n",
    "        \"direction_binomial_p\": [\n",
    "            1.0,\n",
    "            0.5,\n",
    "            np.nan,\n",
    "            0.02138697251677513,\n",
    "        ],\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. EXACT FROZEN GSE157827 ROBUSTNESS VALUES\n",
    "# ============================================================\n",
    "\n",
    "robustness = {\n",
    "\n",
    "    \"primary_FDR_counts\": {\n",
    "        \"Astro\": 0,\n",
    "        \"Micro\": 0,\n",
    "        \"OPC\": 0,\n",
    "        \"Oligo\": 4,\n",
    "    },\n",
    "\n",
    "    \"PMD_FDR_counts\": {\n",
    "        \"Astro\": 0,\n",
    "        \"Micro\": 0,\n",
    "        \"OPC\": 0,\n",
    "        \"Oligo\": 1,\n",
    "    },\n",
    "\n",
    "    \"OPC_cellcount20\": {\n",
    "        \"OPC_sensitivity_donors\": 12,\n",
    "        \"AD\": 7,\n",
    "        \"Control\": 5,\n",
    "        \"tested_genes\": 15145,\n",
    "        \"FDR\": 0,\n",
    "        \"LFC_pearson\": 0.9268640706459932,\n",
    "        \"LFC_spearman\": 0.9279787816889752,\n",
    "        \"Wald_spearman\": 0.9340710771611961,\n",
    "    },\n",
    "\n",
    "    \"Oligo_primary_FDR_hits_all_same_direction_PMD\":\n",
    "        True,\n",
    "\n",
    "    \"Oligo_primary_FDR_hits_all_PMD_nominal\":\n",
    "        True,\n",
    "}\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. SAVE SOURCE DATA\n",
    "# ============================================================\n",
    "\n",
    "SOURCE_DATA_PATH = (\n",
    "    FIG_DIR\n",
    "    / \"Supplementary_Figure_S2_AD_primary_replication_source_data.csv\"\n",
    ")\n",
    "\n",
    "ROBUSTNESS_DATA_PATH = (\n",
    "    FIG_DIR\n",
    "    / \"Supplementary_Figure_S2_GSE157827_robustness.json\"\n",
    ")\n",
    "\n",
    "evidence.to_csv(\n",
    "    SOURCE_DATA_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "with open(\n",
    "    ROBUSTNESS_DATA_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "    json.dump(\n",
    "        robustness,\n",
    "        f,\n",
    "        indent=2,\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. FIGURE FRAME\n",
    "# ============================================================\n",
    "\n",
    "CELL_TYPES = [\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "]\n",
    "\n",
    "x = np.arange(\n",
    "    len(CELL_TYPES)\n",
    ")\n",
    "\n",
    "fig = plt.figure(\n",
    "    figsize=(\n",
    "        14.4,\n",
    "        10.8,\n",
    "    )\n",
    ")\n",
    "\n",
    "outer = fig.add_gridspec(\n",
    "    2,\n",
    "    2,\n",
    "    left=0.065,\n",
    "    right=0.985,\n",
    "    bottom=0.085,\n",
    "    top=0.905,\n",
    "    wspace=0.16,\n",
    "    hspace=0.24,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# HELPER — TITLE + INFO STRIP + PLOT\n",
    "# ============================================================\n",
    "\n",
    "def make_panel(\n",
    "    spec,\n",
    "    title,\n",
    "    title_height=0.12,\n",
    "    info_height=0.12,\n",
    "):\n",
    "\n",
    "    inner = spec.subgridspec(\n",
    "        3,\n",
    "        1,\n",
    "        height_ratios=[\n",
    "            title_height,\n",
    "            info_height,\n",
    "            1.0,\n",
    "        ],\n",
    "        hspace=0.0,\n",
    "    )\n",
    "\n",
    "    title_ax = fig.add_subplot(\n",
    "        inner[0]\n",
    "    )\n",
    "\n",
    "    info_ax = fig.add_subplot(\n",
    "        inner[1]\n",
    "    )\n",
    "\n",
    "    plot_ax = fig.add_subplot(\n",
    "        inner[2]\n",
    "    )\n",
    "\n",
    "    title_ax.axis(\n",
    "        \"off\"\n",
    "    )\n",
    "\n",
    "    info_ax.axis(\n",
    "        \"off\"\n",
    "    )\n",
    "\n",
    "    title_ax.text(\n",
    "        0.0,\n",
    "        0.50,\n",
    "        title,\n",
    "        fontsize=12,\n",
    "        fontweight=\"bold\",\n",
    "        ha=\"left\",\n",
    "        va=\"center\",\n",
    "        transform=title_ax.transAxes,\n",
    "    )\n",
    "\n",
    "    return title_ax, info_ax, plot_ax\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# PANEL A\n",
    "# ============================================================\n",
    "\n",
    "titleA, infoA, axA = make_panel(\n",
    "    outer[0, 0],\n",
    "    \"A   Discovery–replication effect-vector concordance\",\n",
    "    title_height=0.12,\n",
    "    info_height=0.13,\n",
    ")\n",
    "\n",
    "width = 0.34\n",
    "\n",
    "bars_lfc = axA.bar(\n",
    "    x - width / 2,\n",
    "    evidence[\n",
    "        \"LFC_spearman\"\n",
    "    ],\n",
    "    width,\n",
    "    label=\"log2FC\",\n",
    ")\n",
    "\n",
    "bars_wald = axA.bar(\n",
    "    x + width / 2,\n",
    "    evidence[\n",
    "        \"Wald_spearman\"\n",
    "    ],\n",
    "    width,\n",
    "    label=\"Wald statistic\",\n",
    ")\n",
    "\n",
    "axA.axhline(\n",
    "    0,\n",
    "    linewidth=0.8,\n",
    ")\n",
    "\n",
    "axA.set_ylim(\n",
    "    0,\n",
    "    0.25,\n",
    ")\n",
    "\n",
    "axA.set_xticks(\n",
    "    x\n",
    ")\n",
    "\n",
    "axA.set_xticklabels(\n",
    "    CELL_TYPES\n",
    ")\n",
    "\n",
    "axA.set_ylabel(\n",
    "    \"Spearman ρ\"\n",
    ")\n",
    "\n",
    "legend_A = [\n",
    "    Patch(\n",
    "        facecolor=\n",
    "        bars_lfc.patches[0].get_facecolor(),\n",
    "        label=\"log2FC\",\n",
    "    ),\n",
    "\n",
    "    Patch(\n",
    "        facecolor=\n",
    "        bars_wald.patches[0].get_facecolor(),\n",
    "        label=\"Wald statistic\",\n",
    "    ),\n",
    "]\n",
    "\n",
    "infoA.legend(\n",
    "    handles=legend_A,\n",
    "    loc=\"center left\",\n",
    "    bbox_to_anchor=(\n",
    "        0.0,\n",
    "        0.50,\n",
    "    ),\n",
    "    frameon=False,\n",
    "    fontsize=8.4,\n",
    "    ncol=2,\n",
    "    borderaxespad=0,\n",
    "    handlelength=1.8,\n",
    "    columnspacing=1.4,\n",
    ")\n",
    "\n",
    "infoA.text(\n",
    "    0.99,\n",
    "    0.50,\n",
    "    \"* 10,000-permutation P < 0.05\",\n",
    "    fontsize=7.8,\n",
    "    ha=\"right\",\n",
    "    va=\"center\",\n",
    "    transform=infoA.transAxes,\n",
    ")\n",
    "\n",
    "for i in range(\n",
    "    len(evidence)\n",
    "):\n",
    "\n",
    "    y1 = evidence.loc[\n",
    "        i,\n",
    "        \"LFC_spearman\"\n",
    "    ]\n",
    "\n",
    "    y2 = evidence.loc[\n",
    "        i,\n",
    "        \"Wald_spearman\"\n",
    "    ]\n",
    "\n",
    "    axA.text(\n",
    "        x[i] - width / 2,\n",
    "        y1 + 0.008,\n",
    "        \"*\",\n",
    "        ha=\"center\",\n",
    "        va=\"bottom\",\n",
    "        fontsize=13,\n",
    "    )\n",
    "\n",
    "    axA.text(\n",
    "        x[i] + width / 2,\n",
    "        y2 + 0.008,\n",
    "        \"*\",\n",
    "        ha=\"center\",\n",
    "        va=\"bottom\",\n",
    "        fontsize=13,\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# PANEL B\n",
    "# ============================================================\n",
    "\n",
    "titleB, infoB, axB = make_panel(\n",
    "    outer[0, 1],\n",
    "    \"B   All-gene directional concordance\",\n",
    "    title_height=0.12,\n",
    "    info_height=0.05,\n",
    ")\n",
    "\n",
    "direction_pct = (\n",
    "    evidence[\n",
    "        \"all_gene_direction_concordance\"\n",
    "    ]\n",
    "    * 100\n",
    ")\n",
    "\n",
    "bars_direction = axB.bar(\n",
    "    x,\n",
    "    direction_pct,\n",
    "    width=0.76,\n",
    ")\n",
    "\n",
    "axB.axhline(\n",
    "    50,\n",
    "    linestyle=\"--\",\n",
    "    linewidth=1,\n",
    "    color=\"0.35\",\n",
    ")\n",
    "\n",
    "axB.set_ylim(\n",
    "    0,\n",
    "    70,\n",
    ")\n",
    "\n",
    "axB.set_xticks(\n",
    "    x\n",
    ")\n",
    "\n",
    "axB.set_xticklabels(\n",
    "    CELL_TYPES\n",
    ")\n",
    "\n",
    "axB.set_ylabel(\n",
    "    \"Same-direction genes (%)\"\n",
    ")\n",
    "\n",
    "for i, bar in enumerate(\n",
    "    bars_direction\n",
    "):\n",
    "\n",
    "    axB.text(\n",
    "        (\n",
    "            bar.get_x()\n",
    "            +\n",
    "            bar.get_width() / 2\n",
    "        ),\n",
    "        (\n",
    "            bar.get_height()\n",
    "            +\n",
    "            1.1\n",
    "        ),\n",
    "        f\"{direction_pct.iloc[i]:.1f}%\",\n",
    "        ha=\"center\",\n",
    "        va=\"bottom\",\n",
    "        fontsize=9,\n",
    "    )\n",
    "\n",
    "infoB.text(\n",
    "    1.0,\n",
    "    0.5,\n",
    "    \"Dashed line = 50% directional expectation\",\n",
    "    fontsize=7.8,\n",
    "    ha=\"right\",\n",
    "    va=\"center\",\n",
    "    color=\"0.35\",\n",
    "    transform=infoB.transAxes,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# PANEL C\n",
    "# ============================================================\n",
    "\n",
    "titleC, infoC, axC = make_panel(\n",
    "    outer[1, 0],\n",
    "    \"C   Discovery-FDR gene support in primary replication\",\n",
    "    title_height=0.12,\n",
    "    info_height=0.18,\n",
    ")\n",
    "\n",
    "measurable = evidence[\n",
    "    \"discovery_FDR_measurable\"\n",
    "].to_numpy()\n",
    "\n",
    "same_direction = evidence[\n",
    "    \"same_direction_hits\"\n",
    "].to_numpy()\n",
    "\n",
    "nominal_success = evidence[\n",
    "    \"gene_level_replication_success\"\n",
    "].to_numpy()\n",
    "\n",
    "w3 = 0.23\n",
    "\n",
    "b1 = axC.bar(\n",
    "    x - w3,\n",
    "    measurable,\n",
    "    w3,\n",
    "    label=\"Discovery FDR measurable\",\n",
    ")\n",
    "\n",
    "b2 = axC.bar(\n",
    "    x,\n",
    "    same_direction,\n",
    "    w3,\n",
    "    label=\"Same direction\",\n",
    ")\n",
    "\n",
    "b3 = axC.bar(\n",
    "    x + w3,\n",
    "    nominal_success,\n",
    "    w3,\n",
    "    label=\"Same direction + replication P < 0.05\",\n",
    ")\n",
    "\n",
    "axC.set_ylim(\n",
    "    0,\n",
    "    34,\n",
    ")\n",
    "\n",
    "axC.set_xticks(\n",
    "    x\n",
    ")\n",
    "\n",
    "axC.set_xticklabels(\n",
    "    CELL_TYPES\n",
    ")\n",
    "\n",
    "axC.set_ylabel(\n",
    "    \"Number of genes\"\n",
    ")\n",
    "\n",
    "legend_C = [\n",
    "    Patch(\n",
    "        facecolor=\n",
    "        b1.patches[0].get_facecolor(),\n",
    "        label=\"Discovery FDR measurable\",\n",
    "    ),\n",
    "\n",
    "    Patch(\n",
    "        facecolor=\n",
    "        b2.patches[0].get_facecolor(),\n",
    "        label=\"Same direction\",\n",
    "    ),\n",
    "\n",
    "    Patch(\n",
    "        facecolor=\n",
    "        b3.patches[0].get_facecolor(),\n",
    "        label=\"Same direction + replication P < 0.05\",\n",
    "    ),\n",
    "]\n",
    "\n",
    "infoC.legend(\n",
    "    handles=legend_C,\n",
    "    loc=\"center left\",\n",
    "    bbox_to_anchor=(\n",
    "        0.0,\n",
    "        0.63,\n",
    "    ),\n",
    "    frameon=False,\n",
    "    fontsize=7.6,\n",
    "    ncol=2,\n",
    "    borderaxespad=0,\n",
    "    handlelength=1.8,\n",
    "    columnspacing=1.1,\n",
    ")\n",
    "\n",
    "# Oligo note moved completely OUTSIDE graph.\n",
    "infoC.text(\n",
    "    0.99,\n",
    "    0.15,\n",
    "    (\n",
    "        \"Oligo directional support: 21/30; \"\n",
    "        \"binomial P = 0.021\"\n",
    "    ),\n",
    "    fontsize=7.8,\n",
    "    ha=\"right\",\n",
    "    va=\"center\",\n",
    "    transform=infoC.transAxes,\n",
    ")\n",
    "\n",
    "for bars_group in [\n",
    "    b1,\n",
    "    b2,\n",
    "    b3,\n",
    "]:\n",
    "\n",
    "    for bar in bars_group:\n",
    "\n",
    "        if (\n",
    "            bar.get_height()\n",
    "            > 0\n",
    "        ):\n",
    "\n",
    "            axC.text(\n",
    "                (\n",
    "                    bar.get_x()\n",
    "                    +\n",
    "                    bar.get_width() / 2\n",
    "                ),\n",
    "                (\n",
    "                    bar.get_height()\n",
    "                    +\n",
    "                    0.45\n",
    "                ),\n",
    "                f\"{int(bar.get_height())}\",\n",
    "                ha=\"center\",\n",
    "                va=\"bottom\",\n",
    "                fontsize=8,\n",
    "            )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# PANEL D\n",
    "# ============================================================\n",
    "\n",
    "titleD, infoD, axD = make_panel(\n",
    "    outer[1, 1],\n",
    "    \"D   GSE157827 internal robustness\",\n",
    "    title_height=0.12,\n",
    "    info_height=0.16,\n",
    ")\n",
    "\n",
    "primary_fdr = np.array(\n",
    "    [\n",
    "        robustness[\n",
    "            \"primary_FDR_counts\"\n",
    "        ][ct]\n",
    "        for ct in CELL_TYPES\n",
    "    ]\n",
    ")\n",
    "\n",
    "pmd_fdr = np.array(\n",
    "    [\n",
    "        robustness[\n",
    "            \"PMD_FDR_counts\"\n",
    "        ][ct]\n",
    "        for ct in CELL_TYPES\n",
    "    ]\n",
    ")\n",
    "\n",
    "d1 = axD.bar(\n",
    "    x - width / 2,\n",
    "    primary_fdr,\n",
    "    width,\n",
    "    label=\"Primary model FDR < 0.05\",\n",
    ")\n",
    "\n",
    "d2 = axD.bar(\n",
    "    x + width / 2,\n",
    "    pmd_fdr,\n",
    "    width,\n",
    "    label=\"PMD sensitivity FDR < 0.05\",\n",
    ")\n",
    "\n",
    "axD.set_ylim(\n",
    "    0,\n",
    "    5.2,\n",
    ")\n",
    "\n",
    "axD.set_xticks(\n",
    "    x\n",
    ")\n",
    "\n",
    "axD.set_xticklabels(\n",
    "    CELL_TYPES\n",
    ")\n",
    "\n",
    "axD.set_ylabel(\n",
    "    \"GSE157827 significant genes\"\n",
    ")\n",
    "\n",
    "legend_D = [\n",
    "    Patch(\n",
    "        facecolor=\n",
    "        d1.patches[0].get_facecolor(),\n",
    "        label=\"Primary model FDR < 0.05\",\n",
    "    ),\n",
    "\n",
    "    Patch(\n",
    "        facecolor=\n",
    "        d2.patches[0].get_facecolor(),\n",
    "        label=\"PMD sensitivity FDR < 0.05\",\n",
    "    ),\n",
    "]\n",
    "\n",
    "infoD.legend(\n",
    "    handles=legend_D,\n",
    "    loc=\"center left\",\n",
    "    bbox_to_anchor=(\n",
    "        0.0,\n",
    "        0.60,\n",
    "    ),\n",
    "    frameon=False,\n",
    "    fontsize=7.9,\n",
    "    ncol=2,\n",
    "    borderaxespad=0,\n",
    "    handlelength=1.8,\n",
    "    columnspacing=1.2,\n",
    ")\n",
    "\n",
    "for group in [\n",
    "    d1,\n",
    "    d2,\n",
    "]:\n",
    "\n",
    "    for bar in group:\n",
    "\n",
    "        if (\n",
    "            bar.get_height()\n",
    "            > 0\n",
    "        ):\n",
    "\n",
    "            axD.text(\n",
    "                (\n",
    "                    bar.get_x()\n",
    "                    +\n",
    "                    bar.get_width() / 2\n",
    "                ),\n",
    "                (\n",
    "                    bar.get_height()\n",
    "                    +\n",
    "                    0.08\n",
    "                ),\n",
    "                f\"{int(bar.get_height())}\",\n",
    "                ha=\"center\",\n",
    "                va=\"bottom\",\n",
    "                fontsize=8.5,\n",
    "            )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# D — COMBINED ROBUSTNESS NOTE\n",
    "# Kept entirely in EMPTY left half of plot.\n",
    "# ============================================================\n",
    "\n",
    "opc = robustness[\n",
    "    \"OPC_cellcount20\"\n",
    "]\n",
    "\n",
    "combined_note = (\n",
    "    \"OPC ≥20-nucleus sensitivity\\n\"\n",
    "    \"12 donors (7 AD / 5 control)\\n\"\n",
    "    f\"log2FC Spearman ρ = {float(opc['LFC_spearman']):.3f}; \"\n",
    "    f\"Wald ρ = {float(opc['Wald_spearman']):.3f}\\n\"\n",
    "    \"FDR hits = 0\\n\\n\"\n",
    "    \"Oligo PMD sensitivity\\n\"\n",
    "    \"All 4 primary FDR hits retained the same direction\\n\"\n",
    "    \"and nominal P < 0.05.\"\n",
    ")\n",
    "\n",
    "axD.text(\n",
    "    0.025,\n",
    "    0.94,\n",
    "    combined_note,\n",
    "    transform=axD.transAxes,\n",
    "    ha=\"left\",\n",
    "    va=\"top\",\n",
    "    fontsize=7.8,\n",
    "    linespacing=1.15,\n",
    "    bbox=dict(\n",
    "        boxstyle=\"round,pad=0.38\",\n",
    "        facecolor=\"white\",\n",
    "        edgecolor=\"0.78\",\n",
    "        linewidth=0.8,\n",
    "    ),\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. GLOBAL TITLE / FOOTNOTE\n",
    "# ============================================================\n",
    "\n",
    "fig.suptitle(\n",
    "    (\n",
    "        \"Independent same-region replication supports \"\n",
    "        \"Alzheimer’s disease glial effect-vector reproducibility\"\n",
    "    ),\n",
    "    fontsize=15,\n",
    "    fontweight=\"bold\",\n",
    "    y=0.985,\n",
    ")\n",
    "\n",
    "fig.text(\n",
    "    0.5,\n",
    "    0.025,\n",
    "    (\n",
    "        \"GSE174367 prefrontal-cortex discovery → \"\n",
    "        \"GSE157827 prefrontal-cortex replication. \"\n",
    "        \"Whole-vector concordance is the primary replication evidence; \"\n",
    "        \"discovery-FDR gene support is secondary.\"\n",
    "    ),\n",
    "    ha=\"center\",\n",
    "    va=\"center\",\n",
    "    fontsize=8.1,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. SAVE\n",
    "# ============================================================\n",
    "\n",
    "PNG_PATH = (\n",
    "    FIG_DIR\n",
    "    / \"Supplementary_Figure_S2_AD_primary_replication_QC.png\"\n",
    ")\n",
    "\n",
    "PDF_PATH = (\n",
    "    FIG_DIR\n",
    "    / \"Supplementary_Figure_S2_AD_primary_replication_QC.pdf\"\n",
    ")\n",
    "\n",
    "SVG_PATH = (\n",
    "    FIG_DIR\n",
    "    / \"Supplementary_Figure_S2_AD_primary_replication_QC.svg\"\n",
    ")\n",
    "\n",
    "fig.savefig(\n",
    "    PNG_PATH,\n",
    "    dpi=600,\n",
    "    bbox_inches=\"tight\",\n",
    ")\n",
    "\n",    "fig.savefig(\n",
    "    PDF_PATH,\n",
    "    bbox_inches=\"tight\",\n",
    ")\n",
    "\n",
    "fig.savefig(\n",
    "    SVG_PATH,\n",
    "    bbox_inches=\"tight\",\n",
    ")\n",
    "\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. PROVENANCE\n",
    "# ============================================================\n",
    "\n",
    "PROVENANCE_PATH = (\n",
    "    FIG_DIR\n",
    "    / \"Supplementary_Figure_S2_AD_primary_replication_QC_provenance.json\"\n",
    ")\n",
    "\n",
    "record = {\n",
    "    \"figure\":\n",
    "        \"Supplementary Figure S2\",\n",
    "\n",
    "    \"discovery\":\n",
    "        \"GSE174367\",\n",
    "\n",
    "    \"primary_replication\":\n",
    "        \"GSE157827\",\n",
    "\n",
    "    \"source_mode\":\n",
    "        \"exact frozen values preserved in executed master notebook\",\n",
    "\n",
    "    \"statistics_rerun\":\n",
    "        False,\n",
    "\n",
    "    \"permutations\":\n",
    "        10000,\n",
    "\n",
    "    \"created_utc\":\n",
    "        datetime.now(\n",
    "            timezone.utc\n",
    "        ).isoformat(),\n",
    "}\n",
    "\n",
    "with open(\n",
    "    PROVENANCE_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "    json.dump(\n",
    "        record,\n",
    "        f,\n",
    "        indent=2,\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. REPORT\n",
    "# ============================================================\n",
    "\n",
    "print(\"=\" * 90)\n",
    "\n",
    "print(\n",
    "    \"SUPPLEMENTARY FIGURE S2 — FINAL NO-OVERLAP VERSION COMPLETE\"\n",
    ")\n",
    "\n",
    "print(\"=\" * 90)\n",
    "\n",
    "for p in [\n",
    "    PNG_PATH,\n",
    "    PDF_PATH,\n",
    "    SVG_PATH,\n",
    "    SOURCE_DATA_PATH,\n",
    "    ROBUSTNESS_DATA_PATH,\n",
    "    PROVENANCE_PATH,\n",
    "]:\n",
    "\n",
    "    print(\n",
    "        f\"{p.name}:\",\n",
    "        \"OK\"\n",
    "        if p.exists()\n",
    "        else \"MISSING\"\n",
    "    )\n",
    "\n",
    "print(\"\\nSaved to:\")\n",
    "print(FIG_DIR)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 100\n",
    "# ============================================================\n",
    "# SUPPLEMENTARY FIGURE S3 — FINAL CLEAN REBUILD\n",
    "# AD SECONDARY EXTERNAL REPLICATION — GSE138852\n",
    "#\n",
    "# Discovery:\n",
    "#   GSE174367 — prefrontal cortex\n",
    "#\n",
    "# Secondary external replication:\n",
    "#   GSE138852 — entorhinal cortex\n",
    "#\n",
    "# IMPORTANT\n",
    "# - No upstream files required\n",
    "# - No DE rerun\n",
    "# - No statistics rerun\n",
    "# - Exact frozen notebook values\n",
    "# - Titles / legends / notes separated from graphs\n",
    "# ============================================================\n",
    "\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "import json\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from matplotlib.patches import Patch\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "assert ROOT.exists(), (\n",
    "    f\"Project root missing:\\n{ROOT}\"\n",
    ")\n",
    "\n",
    "FIG_DIR = (\n",
    "    ROOT\n",
    "    / \"results\"\n",
    "    / \"publication_figures\"\n",
    "    / \"supplementary\"\n",
    ")\n",
    "\n",
    "FIG_DIR.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. EXACT FROZEN SECONDARY-REPLICATION VALUES\n",
    "# ============================================================\n",
    "\n",
    "evidence = pd.DataFrame(\n",
    "    {\n",
    "        \"cell_type\": [\n",
    "            \"Astro\",\n",
    "            \"Micro\",\n",
    "            \"OPC\",\n",
    "            \"Oligo\",\n",
    "        ],\n",
    "\n",
    "        \"matched_unique_genes\": [\n",
    "            9393,\n",
    "            6495,\n",
    "            8902,\n",
    "            9208,\n",
    "        ],\n",
    "\n",
    "        \"secondary_LFC_spearman\": [\n",
    "            0.1329155085680608,\n",
    "            0.09631014665575124,\n",
    "            0.015531853390351432,\n",
    "            0.15704820877982997,\n",
    "        ],\n",
    "\n",
    "        \"secondary_Wald_spearman\": [\n",
    "            0.1315821472916661,\n",
    "            0.11397028151677353,\n",
    "            0.00012120871765729997,\n",
    "            0.15874225480216575,\n",
    "        ],\n",
    "\n",
    "        \"all_gene_direction_concordance\": [\n",
    "            0.5438092196316405,\n",
    "            0.5280985373364127,\n",
    "            0.5029206919793305,\n",
    "            0.554735013032146,\n",
    "        ],\n",
    "\n",
    "        \"discovery_FDR_measurable\": [\n",
    "            1,\n",
    "            2,\n",
    "            0,\n",
    "            19,\n",
    "        ],\n",
    "\n",
    "        \"discovery_FDR_same_direction\": [\n",
    "            0,\n",
    "            2,\n",
    "            0,\n",
    "            13,\n",
    "        ],\n",
    "\n",
    "        \"discovery_FDR_same_direction_nominal\": [\n",
    "            0,\n",
    "            1,\n",
    "            0,\n",
    "            2,\n",
    "        ],\n",
    "\n",
    "        \"discovery_FDR_same_direction_secondary_FDR\": [\n",
    "            0,\n",
    "            0,\n",
    "            0,\n",
    "            0,\n",
    "        ],\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. EXACT FROZEN GSE138852 INTERNAL ROBUSTNESS VALUES\n",
    "# ============================================================\n",
    "\n",
    "secondary_de = pd.DataFrame(\n",
    "    {\n",
    "        \"cell_type\": [\n",
    "            \"Astro\",\n",
    "            \"Micro\",\n",
    "            \"OPC\",\n",
    "            \"Oligo\",\n",
    "        ],\n",
    "\n",
    "        \"donors\": [\n",
    "            12,\n",
    "            10,\n",
    "            12,\n",
    "            12,\n",
    "        ],\n",
    "\n",
    "        \"AD\": [\n",
    "            6,\n",
    "            5,\n",
    "            6,\n",
    "            6,\n",
    "        ],\n",
    "\n",
    "        \"Control\": [\n",
    "            6,\n",
    "            5,\n",
    "            6,\n",
    "            6,\n",
    "        ],\n",
    "\n",
    "        \"eligible_nuclei\": [\n",
    "            2129,\n",
    "            408,\n",
    "            1056,\n",
    "            7253,\n",
    "        ],\n",
    "\n",
    "        \"tested_genes\": [\n",
    "            10458,\n",
    "            7009,\n",
    "            9826,\n",
    "            10667,\n",
    "        ],\n",
    "\n",
    "        \"primary_FDR\": [\n",
    "            469,\n",
    "            30,\n",
    "            138,\n",
    "            440,\n",
    "        ],\n",
    "\n",
    "        \"PMI_FDR\": [\n",
    "            198,\n",
    "            0,\n",
    "            27,\n",
    "            212,\n",
    "        ],\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. SAVE SOURCE TABLES\n",
    "# ============================================================\n",
    "\n",
    "EVIDENCE_PATH = (\n",
    "    FIG_DIR\n",
    "    / \"Supplementary_Figure_S3_AD_secondary_replication_source_data.csv\"\n",
    ")\n",
    "\n",
    "DE_PATH = (\n",
    "    FIG_DIR\n",
    "    / \"Supplementary_Figure_S3_GSE138852_DE_robustness.csv\"\n",
    ")\n",
    "\n",
    "evidence.to_csv(\n",
    "    EVIDENCE_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "secondary_de.to_csv(\n",
    "    DE_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. FIGURE FRAME\n",
    "# ============================================================\n",
    "\n",
    "CELL_TYPES = [\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "]\n",
    "\n",
    "x = np.arange(\n",
    "    len(CELL_TYPES)\n",
    ")\n",
    "\n",
    "fig = plt.figure(\n",
    "    figsize=(\n",
    "        14.4,\n",
    "        10.8,\n",
    "    )\n",
    ")\n",
    "\n",
    "outer = fig.add_gridspec(\n",
    "    2,\n",
    "    2,\n",
    "    left=0.065,\n",
    "    right=0.985,\n",
    "    bottom=0.085,\n",
    "    top=0.905,\n",
    "    wspace=0.16,\n",
    "    hspace=0.24,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# HELPER — TITLE + INFO STRIP + GRAPH\n",
    "# ============================================================\n",
    "\n",
    "def make_panel(\n",
    "    spec,\n",
    "    title,\n",
    "    title_height=0.12,\n",
    "    info_height=0.14,\n",
    "):\n",
    "\n",
    "    inner = spec.subgridspec(\n",
    "        3,\n",
    "        1,\n",
    "        height_ratios=[\n",
    "            title_height,\n",
    "            info_height,\n",
    "            1.0,\n",
    "        ],\n",
    "        hspace=0.0,\n",
    "    )\n",
    "\n",
    "    title_ax = fig.add_subplot(\n",
    "        inner[0]\n",
    "    )\n",
    "\n",
    "    info_ax = fig.add_subplot(\n",
    "        inner[1]\n",
    "    )\n",
    "\n",
    "    plot_ax = fig.add_subplot(\n",
    "        inner[2]\n",
    "    )\n",
    "\n",
    "    title_ax.axis(\n",
    "        \"off\"\n",
    "    )\n",
    "\n",
    "    info_ax.axis(\n",
    "        \"off\"\n",
    "    )\n",
    "\n",
    "    title_ax.text(\n",
    "        0.0,\n",
    "        0.50,\n",
    "        title,\n",
    "        fontsize=12,\n",
    "        fontweight=\"bold\",\n",
    "        ha=\"left\",\n",
    "        va=\"center\",\n",
    "        transform=title_ax.transAxes,\n",
    "    )\n",
    "\n",
    "    return title_ax, info_ax, plot_ax\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# PANEL A\n",
    "# PFC DISCOVERY ↔ ENTORHINAL-CORTEX REPLICATION\n",
    "# ============================================================\n",
    "\n",
    "titleA, infoA, axA = make_panel(\n",
    "    outer[0, 0],\n",
    "    \"A   PFC discovery → entorhinal-cortex replication\",\n",
    "    title_height=0.12,\n",
    "    info_height=0.16,\n",
    ")\n",
    "\n",
    "width = 0.34\n",
    "\n",
    "a1 = axA.bar(\n",
    "    x - width / 2,\n",
    "    evidence[\n",
    "        \"secondary_LFC_spearman\"\n",
    "    ],\n",
    "    width,\n",
    "    label=\"log2FC\",\n",
    ")\n",
    "\n",
    "a2 = axA.bar(\n",
    "    x + width / 2,\n",
    "    evidence[\n",
    "        \"secondary_Wald_spearman\"\n",
    "    ],\n",
    "    width,\n",
    "    label=\"Wald statistic\",\n",
    ")\n",
    "\n",
    "axA.axhline(\n",
    "    0,\n",
    "    linewidth=0.8,\n",
    ")\n",
    "\n",
    "axA.set_ylim(\n",
    "    0,\n",
    "    0.19,\n",
    ")\n",
    "\n",
    "axA.set_xticks(\n",
    "    x\n",
    ")\n",
    "\n",
    "axA.set_xticklabels(\n",
    "    CELL_TYPES\n",
    ")\n",
    "\n",
    "axA.set_ylabel(\n",
    "    \"Spearman ρ\"\n",
    ")\n",
    "\n",
    "legend_A = [\n",
    "    Patch(\n",
    "        facecolor=\n",
    "        a1.patches[0].get_facecolor(),\n",
    "        label=\"log2FC\",\n",
    "    ),\n",
    "\n",
    "    Patch(\n",
    "        facecolor=\n",
    "        a2.patches[0].get_facecolor(),\n",
    "        label=\"Wald statistic\",\n",
    "    ),\n",
    "]\n",
    "\n",
    "infoA.legend(\n",
    "    handles=legend_A,\n",
    "    loc=\"center left\",\n",
    "    bbox_to_anchor=(\n",
    "        0.0,\n",
    "        0.64,\n",
    "    ),\n",
    "    frameon=False,\n",
    "    fontsize=8.4,\n",
    "    ncol=2,\n",
    "    borderaxespad=0,\n",
    "    handlelength=1.8,\n",
    "    columnspacing=1.4,\n",
    ")\n",
    "\n",
    "infoA.text(\n",
    "    0.99,\n",
    "    0.18,\n",
    "    (\n",
    "        \"OPC shows essentially no cross-region \"\n",
    "        \"effect-vector concordance.\"\n",
    "    ),\n",
    "    fontsize=7.8,\n",
    "    ha=\"right\",\n",
    "    va=\"center\",\n",
    "    transform=infoA.transAxes,\n",
    ")\n",
    "\n",
    "for group in [\n",
    "    a1,\n",
    "    a2,\n",
    "]:\n",
    "\n",
    "    for bar in group:\n",
    "\n",
    "        value = bar.get_height()\n",
    "\n",
    "        axA.text(\n",
    "            (\n",
    "                bar.get_x()\n",
    "                +\n",
    "                bar.get_width() / 2\n",
    "            ),\n",
    "            value + 0.005,\n",
    "            f\"{value:.3f}\",\n",
    "            ha=\"center\",\n",
    "            va=\"bottom\",\n",
    "            fontsize=7.8,\n",
    "        )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# PANEL B\n",
    "# CROSS-REGION DIRECTIONAL CONCORDANCE\n",
    "# ============================================================\n",
    "\n",
    "titleB, infoB, axB = make_panel(\n",
    "    outer[0, 1],\n",
    "    \"B   Cross-region directional concordance\",\n",
    "    title_height=0.12,\n",
    "    info_height=0.08,\n",
    ")\n",
    "\n",
    "direction_pct = (\n",
    "    evidence[\n",
    "        \"all_gene_direction_concordance\"\n",
    "    ]\n",
    "    * 100\n",
    ")\n",
    "\n",
    "barsB = axB.bar(\n",
    "    x,\n",
    "    direction_pct,\n",
    "    width=0.76,\n",
    ")\n",
    "\n",
    "axB.axhline(\n",
    "    50,\n",
    "    linestyle=\"--\",\n",
    "    linewidth=1,\n",
    "    color=\"0.35\",\n",
    ")\n",
    "\n",
    "axB.set_ylim(\n",
    "    0,\n",
    "    65,\n",
    ")\n",
    "\n",
    "axB.set_xticks(\n",
    "    x\n",
    ")\n",
    "\n",
    "axB.set_xticklabels(\n",
    "    CELL_TYPES\n",
    ")\n",
    "\n",
    "axB.set_ylabel(\n",
    "    \"Same-direction genes (%)\"\n",
    ")\n",
    "\n",
    "for i, bar in enumerate(\n",
    "    barsB\n",
    "):\n",
    "\n",
    "    axB.text(\n",
    "        (\n",
    "            bar.get_x()\n",
    "            +\n",
    "            bar.get_width() / 2\n",
    "        ),\n",
    "        (\n",
    "            bar.get_height()\n",
    "            +\n",
    "            1.0\n",
    "        ),\n",
    "        f\"{direction_pct.iloc[i]:.1f}%\",\n",
    "        ha=\"center\",\n",
    "        va=\"bottom\",\n",
    "        fontsize=9,\n",
    "    )\n",
    "\n",
    "infoB.text(\n",
    "    1.0,\n",
    "    0.50,\n",
    "    \"Dashed line = 50% directional expectation\",\n",
    "    fontsize=7.8,\n",
    "    ha=\"right\",\n",
    "    va=\"center\",\n",
    "    color=\"0.35\",\n",
    "    transform=infoB.transAxes,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# PANEL C\n",
    "# DISCOVERY-FDR SUPPORT IN EXTERNAL REPLICATION\n",
    "# ============================================================\n",
    "\n",
    "titleC, infoC, axC = make_panel(\n",
    "    outer[1, 0],\n",
    "    \"C   Discovery-FDR support in external replication\",\n",
    "    title_height=0.12,\n",
    "    info_height=0.20,\n",
    ")\n",
    "\n",
    "measurable = evidence[\n",
    "    \"discovery_FDR_measurable\"\n",
    "].to_numpy()\n",
    "\n",
    "same = evidence[\n",
    "    \"discovery_FDR_same_direction\"\n",
    "].to_numpy()\n",
    "\n",
    "nominal = evidence[\n",
    "    \"discovery_FDR_same_direction_nominal\"\n",
    "].to_numpy()\n",
    "\n",
    "secondary_fdr = evidence[\n",
    "    \"discovery_FDR_same_direction_secondary_FDR\"\n",
    "].to_numpy()\n",
    "\n",
    "w = 0.23\n",
    "\n",
    "c1 = axC.bar(\n",
    "    x - w,\n",
    "    measurable,\n",
    "    w,\n",
    "    label=\"Measurable discovery FDR\",\n",
    ")\n",
    "\n",
    "c2 = axC.bar(\n",
    "    x,\n",
    "    same,\n",
    "    w,\n",
    "    label=\"Same direction\",\n",
    ")\n",
    "\n",
    "c3 = axC.bar(\n",
    "    x + w,\n",
    "    nominal,\n",
    "    w,\n",
    "    label=\"Same direction + external P < 0.05\",\n",
    ")\n",
    "\n",
    "axC.set_ylim(\n",
    "    0,\n",
    "    22,\n",
    ")\n",
    "\n",
    "axC.set_xticks(\n",
    "    x\n",
    ")\n",
    "\n",
    "axC.set_xticklabels(\n",
    "    CELL_TYPES\n",
    ")\n",
    "\n",
    "axC.set_ylabel(\n",
    "    \"Number of discovery-FDR genes\"\n",
    ")\n",
    "\n",
    "legend_C = [\n",
    "    Patch(\n",
    "        facecolor=\n",
    "        c1.patches[0].get_facecolor(),\n",
    "        label=\"Measurable discovery FDR\",\n",
    "    ),\n",
    "\n",
    "    Patch(\n",
    "        facecolor=\n",
    "        c2.patches[0].get_facecolor(),\n",
    "        label=\"Same direction\",\n",
    "    ),\n",
    "\n",
    "    Patch(\n",
    "        facecolor=\n",
    "        c3.patches[0].get_facecolor(),\n",
    "        label=\"Same direction + external P < 0.05\",\n",
    "    ),\n",
    "]\n",
    "\n",
    "infoC.legend(\n",
    "    handles=legend_C,\n",
    "    loc=\"center left\",\n",
    "    bbox_to_anchor=(\n",
    "        0.0,\n",
    "        0.65,\n",
    "    ),\n",
    "    frameon=False,\n",
    "    fontsize=7.5,\n",
    "    ncol=2,\n",
    "    borderaxespad=0,\n",
    "    handlelength=1.7,\n",
    "    columnspacing=1.0,\n",
    ")\n",
    "\n",
    "infoC.text(\n",
    "    0.99,\n",
    "    0.13,\n",
    "    (\n",
    "        \"Same-direction + external FDR < 0.05: \"\n",
    "        \"0 genes in every cell class\"\n",
    "    ),\n",
    "    fontsize=7.8,\n",
    "    ha=\"right\",\n",
    "    va=\"center\",\n",
    "    transform=infoC.transAxes,\n",
    ")\n",
    "\n",
    "for group in [\n",
    "    c1,\n",
    "    c2,\n",
    "    c3,\n",
    "]:\n",
    "\n",
    "    for bar in group:\n",
    "\n",
    "        if (\n",
    "            bar.get_height()\n",
    "            > 0\n",
    "        ):\n",
    "\n",
    "            axC.text(\n",
    "                (\n",
    "                    bar.get_x()\n",
    "                    +\n",
    "                    bar.get_width() / 2\n",
    "                ),\n",
    "                (\n",
    "                    bar.get_height()\n",
    "                    +\n",
    "                    0.30\n",
    "                ),\n",
    "                str(\n",
    "                    int(\n",
    "                        bar.get_height()\n",
    "                    )\n",
    "                ),\n",
    "                ha=\"center\",\n",
    "                va=\"bottom\",\n",
    "                fontsize=8,\n",
    "            )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# PANEL D\n",
    "# GSE138852 INTERNAL ROBUSTNESS\n",
    "# ============================================================\n",
    "\n",
    "titleD, infoD, axD = make_panel(\n",
    "    outer[1, 1],\n",
    "    \"D   GSE138852 internal disease-signal robustness\",\n",
    "    title_height=0.12,\n",
    "    info_height=0.20,\n",
    ")\n",
    "\n",
    "d1 = axD.bar(\n",
    "    x - width / 2,\n",
    "    secondary_de[\n",
    "        \"primary_FDR\"\n",
    "    ],\n",
    "    width,\n",
    "    label=\"Primary model FDR < 0.05\",\n",
    ")\n",
    "\n",
    "d2 = axD.bar(\n",
    "    x + width / 2,\n",
    "    secondary_de[\n",
    "        \"PMI_FDR\"\n",
    "    ],\n",
    "    width,\n",
    "    label=\"PMI sensitivity FDR < 0.05\",\n",
    ")\n",
    "\n",
    "axD.set_ylim(\n",
    "    0,\n",
    "    525,\n",
    ")\n",
    "\n",
    "axD.set_xticks(\n",
    "    x\n",
    ")\n",
    "\n",
    "axD.set_xticklabels(\n",
    "    CELL_TYPES\n",
    ")\n",
    "\n",
    "axD.set_ylabel(\n",
    "    \"Significant genes\"\n",
    ")\n",
    "\n",
    "legend_D = [\n",
    "    Patch(\n",
    "        facecolor=\n",
    "        d1.patches[0].get_facecolor(),\n",
    "        label=\"Primary model FDR < 0.05\",\n",
    "    ),\n",
    "\n",
    "    Patch(\n",
    "        facecolor=\n",
    "        d2.patches[0].get_facecolor(),\n",
    "        label=\"PMI sensitivity FDR < 0.05\",\n",
    "    ),\n",
    "]\n",
    "\n",
    "infoD.legend(\n",
    "    handles=legend_D,\n",
    "    loc=\"center left\",\n",
    "    bbox_to_anchor=(\n",
    "        0.0,\n",
    "        0.68,\n",
    "    ),\n",
    "    frameon=False,\n",
    "    fontsize=7.8,\n",
    "    ncol=2,\n",
    "    borderaxespad=0,\n",
    "    handlelength=1.8,\n",
    "    columnspacing=1.1,\n",
    ")\n",
    "\n",
    "# Donor information entirely outside plotting area.\n",
    "infoD.text(\n",
    "    0.99,\n",
    "    0.12,\n",
    "    (\n",
    "        \"Primary donor eligibility — \"\n",
    "        \"Astro 6 AD/6 Ctrl; Micro 5/5; \"\n",
    "        \"OPC 6/6; Oligo 6/6\"\n",
    "    ),\n",
    "    fontsize=7.6,\n",
    "    ha=\"right\",\n",
    "    va=\"center\",\n",
    "    transform=infoD.transAxes,\n",
    ")\n",
    "\n",
    "for group in [\n",
    "    d1,\n",
    "    d2,\n",
    "]:\n",
    "\n",
    "    for bar in group:\n",
    "\n",
    "        if (\n",
    "            bar.get_height()\n",
    "            > 0\n",
    "        ):\n",
    "\n",
    "            axD.text(\n",
    "                (\n",
    "                    bar.get_x()\n",
    "                    +\n",
    "                    bar.get_width() / 2\n",
    "                ),\n",
    "                (\n",
    "                    bar.get_height()\n",
    "                    +\n",
    "                    8\n",
    "                ),\n",
    "                str(\n",
    "                    int(\n",
    "                        bar.get_height()\n",
    "                    )\n",
    "                ),\n",
    "                ha=\"center\",\n",
    "                va=\"bottom\",\n",
    "                fontsize=8,\n",
    "            )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. GLOBAL TITLE + FOOTNOTE\n",
    "# ============================================================\n",
    "\n",
    "fig.suptitle(\n",
    "    (\n",
    "        \"Secondary external Alzheimer’s disease replication \"\n",
    "        \"supports partial cross-region generalization\"\n",
    "    ),\n",
    "    fontsize=15,\n",
    "    fontweight=\"bold\",\n",
    "    y=0.985,\n",
    ")\n",
    "\n",
    "fig.text(\n",
    "    0.5,\n",
    "    0.025,\n",
    "    (\n",
    "        \"GSE174367 prefrontal-cortex discovery → \"\n",
    "        \"GSE138852 entorhinal-cortex replication. \"\n",
    "        \"This secondary analysis tests regional generalization \"\n",
    "        \"and does not replace the same-region GSE157827 primary replication.\"\n",
    "    ),\n",
    "    ha=\"center\",\n",
    "    va=\"center\",\n",
    "    fontsize=8.1,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. SAVE FIGURE\n",
    "# ============================================================\n",
    "\n",
    "PNG_PATH = (\n",
    "    FIG_DIR\n",
    "    / \"Supplementary_Figure_S3_AD_secondary_external_replication.png\"\n",
    ")\n",
    "\n",
    "PDF_PATH = (\n",
    "    FIG_DIR\n",
    "    / \"Supplementary_Figure_S3_AD_secondary_external_replication.pdf\"\n",
    ")\n",
    "\n",
    "SVG_PATH = (\n",
    "    FIG_DIR\n",
    "    / \"Supplementary_Figure_S3_AD_secondary_external_replication.svg\"\n",
    ")\n",
    "\n",
    "fig.savefig(\n",
    "    PNG_PATH,\n",
    "    dpi=600,\n",
    "    bbox_inches=\"tight\",\n",
    ")\n",
    "\n",
    "fig.savefig(\n",
    "    PDF_PATH,\n",
    "    bbox_inches=\"tight\",\n",
    ")\n",
    "\n",
    "fig.savefig(\n",
    "    SVG_PATH,\n",
    "    bbox_inches=\"tight\",\n",
    ")\n",
    "\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. PROVENANCE\n",
    "# ============================================================\n",
    "\n",
    "PROVENANCE_PATH = (\n",
    "    FIG_DIR\n",
    "    / \"Supplementary_Figure_S3_provenance.json\"\n",
    ")\n",
    "\n",
    "record = {\n",
    "\n",
    "    \"figure\":\n",
    "        \"Supplementary Figure S3\",\n",
    "\n",
    "    \"discovery\":\n",
    "        \"GSE174367\",\n",
    "\n",
    "    \"discovery_region\":\n",
    "        \"prefrontal cortex\",\n",
    "\n",
    "    \"secondary_external_replication\":\n",
    "        \"GSE138852\",\n",
    "\n",
    "    \"secondary_region\":\n",
    "        \"entorhinal cortex\",\n",
    "\n",
    "    \"source_mode\":\n",
    "        \"exact frozen values preserved in executed master notebook\",\n",
    "\n",
    "    \"statistics_rerun\":\n",
    "        False,\n",
    "\n",
    "    \"interpretation\":\n",
    "        (\n",
    "            \"Tests regional generalization; does not replace \"\n",
    "            \"same-region primary AD replication.\"\n",
    "        ),\n",
    "\n",
    "    \"created_utc\":\n",
    "        datetime.now(\n",
    "            timezone.utc\n",
    "        ).isoformat(),\n",
    "}\n",
    "\n",
    "with open(\n",
    "    PROVENANCE_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        record,\n",
    "        f,\n",
    "        indent=2,\n",
    "    )\n",    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. FINAL REPORT\n",
    "# ============================================================\n",
    "\n",
    "print(\"=\" * 90)\n",
    "\n",
    "print(\n",
    "    \"SUPPLEMENTARY FIGURE S3 — FINAL CLEAN REBUILD COMPLETE\"\n",
    ")\n",
    "\n",
    "print(\"=\" * 90)\n",
    "\n",
    "for p in [\n",
    "    PNG_PATH,\n",
    "    PDF_PATH,\n",
    "    SVG_PATH,\n",
    "    EVIDENCE_PATH,\n",
    "    DE_PATH,\n",
    "    PROVENANCE_PATH,\n",
    "]:\n",
    "\n",
    "    print(\n",
    "        f\"{p.name}:\",\n",
    "        \"OK\"\n",
    "        if p.exists()\n",
    "        else \"MISSING\"\n",
    "    )\n",
    "\n",
    "print(\"\\nSaved to:\")\n",
    "print(FIG_DIR)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Part XII — Final submission QC\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 96\n",
    "# ============================================================\n",
    "# RETINA-ND — FINAL NOTEBOOK STATISTICAL / ARTIFACT QC\n",
    "#\n",
    "# PURPOSE\n",
    "# -------\n",
    "# Final submission-facing audit of the already-frozen outputs.\n",
    "#\n",
    "# Checks:\n",
    "#\n",
    "# CORE BRAIN\n",
    "#   GSE243639  PD discovery\n",
    "#   GSE157783  PD replication\n",
    "#   GSE174367  AD discovery\n",
    "#   GSE157827  AD primary replication\n",
    "#   GSE138852  AD external replication\n",
    "#\n",
    "# For every dataset × cell class:\n",
    "#   - tested rows\n",
    "#   - finite LFC\n",
    "#   - finite Wald\n",
    "#   - finite p\n",
    "#   - finite adjusted p\n",
    "#   - missing adjusted p\n",
    "#   - FDR hits\n",
    "#   - illegal infinities\n",
    "#   - p-value range\n",
    "#\n",
    "# SUPPORTING LAYERS\n",
    "#   - healthy retina >=2 donor gate\n",
    "#   - PXD073336 AD-retina statistics\n",
    "#   - Wolf PD aqueous-humor statistics\n",
    "#   - R3 profile-preserving permutation audit\n",
    "#   - multimodal audit files\n",
    "#\n",
    "# ARTIFACTS\n",
    "#   - revised Figures 3–5\n",
    "#\n",
    "# DOES NOT rerun DE.\n",
    "# DOES NOT refilter genes.\n",
    "# DOES NOT alter frozen results.\n",
    "# ============================================================\n",
    "\n",
    "from google.colab import drive\n",
    "from pathlib import Path\n",
    "from IPython.display import display\n",
    "\n",
    "import json\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. MOUNT DRIVE\n",
    "# ============================================================\n",
    "\n",
    "drive.mount(\n",
    "    \"/content/drive\",\n",
    "    force_remount=False,\n",
    ")\n",
    "\n",
    "MYDRIVE = Path(\n",
    "    \"/content/drive/MyDrive\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. IDENTIFY THE CORRECT PROJECT ROOT\n",
    "#\n",
    "# Do not assume RETINA_ND_V2 versus RETINA_ND_V2 (1).\n",
    "# ============================================================\n",
    "\n",
    "RANKING_NAME = (\n",
    "    \"RETINA_ND_UNIQUE_GENE_\"\n",
    "    \"CANDIDATE_RANKING_v4.csv\"\n",
    ")\n",
    "\n",
    "ranking_hits = list(\n",
    "    MYDRIVE.rglob(\n",
    "        RANKING_NAME\n",
    "    )\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Candidate-ranking matches:\",\n",
    "    len(ranking_hits),\n",
    ")\n",
    "\n",
    "for p in ranking_hits:\n",
    "    print(\" \", p)\n",
    "\n",
    "\n",
    "EXPECTED_TOP8 = [\n",
    "    \"SCAMP5\",\n",
    "    \"XYLB\",\n",
    "    \"RABEPK\",\n",
    "    \"ITGAM\",\n",
    "    \"CD38\",\n",
    "    \"CTCF\",\n",
    "    \"UBTD2\",\n",
    "    \"NAPEPLD\",\n",
    "]\n",
    "\n",
    "\n",
    "valid_roots = []\n",
    "\n",
    "\n",
    "for path in ranking_hits:\n",
    "\n",
    "    try:\n",
    "        x = pd.read_csv(path)\n",
    "\n",
    "    except Exception:\n",
    "        continue\n",
    "\n",
    "    if not {\n",
    "        \"candidate_rank\",\n",
    "        \"gene_symbol\",\n",
    "    }.issubset(\n",
    "        x.columns\n",
    "    ):\n",
    "        continue\n",
    "\n",
    "    top8 = (\n",
    "        x\n",
    "        .sort_values(\n",
    "            \"candidate_rank\"\n",
    "        )\n",
    "        .head(8)\n",
    "        [\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .str.upper()\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "    if (\n",
    "        len(x) == 17745\n",
    "        and\n",
    "        top8 == EXPECTED_TOP8\n",
    "    ):\n",
    "\n",
    "        # path =\n",
    "        # ROOT/results/final_evidence/file.csv\n",
    "        root = (\n",
    "            path\n",
    "            .parent\n",
    "            .parent\n",
    "            .parent\n",
    "        )\n",
    "\n",
    "        valid_roots.append(\n",
    "            root\n",
    "        )\n",
    "\n",
    "\n",
    "valid_roots = list(\n",
    "    dict.fromkeys(\n",
    "        valid_roots\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert len(valid_roots) == 1, (\n",
    "    \"Could not identify exactly one verified \"\n",
    "    \"RETINA_ND project root.\"\n",
    ")\n",
    "\n",
    "\n",
    "ROOT = valid_roots[0]\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nVERIFIED PROJECT ROOT:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    ROOT\n",
    ")\n",
    "\n",
    "\n",
    "FINAL_DIR = (\n",
    "    ROOT\n",
    "    / \"results\"\n",
    "    / \"final_evidence\"\n",
    ")\n",
    "\n",
    "FIG_DIR = (\n",
    "    ROOT\n",
    "    / \"results\"\n",
    "    / \"publication_figures\"\n",
    ")\n",
    "\n",
    "QC_DIR = (\n",
    "    ROOT\n",
    "    / \"results\"\n",
    "    / \"final_qc\"\n",
    ")\n",
    "\n",
    "QC_DIR.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. EXACT-FILE RESOLVER\n",
    "# ============================================================\n",
    "\n",
    "def one_exact(\n",
    "    filename,\n",
    "    required=True,\n",
    "):\n",
    "\n",
    "    hits = list(\n",
    "        ROOT.rglob(\n",
    "            filename\n",
    "        )\n",
    "    )\n",
    "\n",
    "    if len(hits) == 1:\n",
    "        return hits[0]\n",
    "\n",
    "    if (\n",
    "        len(hits) == 0\n",
    "        and\n",
    "        not required\n",
    "    ):\n",
    "        return None\n",
    "\n",
    "    raise RuntimeError(\n",
    "        f\"Expected exactly one file named:\\n\"\n",
    "        f\"{filename}\\n\"\n",
    "        f\"Found {len(hits)}:\\n\"\n",
    "        f\"{hits}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. FIVE CORE BRAIN TABLES\n",
    "# ============================================================\n",
    "\n",
    "brain_specs = [\n",
    "\n",
    "    {\n",
    "        \"dataset\":\n",
    "            \"GSE243639\",\n",
    "\n",
    "        \"role\":\n",
    "            \"PD discovery\",\n",
    "\n",
    "        \"file\":\n",
    "            \"GSE243639_PD_DISCOVERY_ALL_EFFECTS_LONG_v1.csv.gz\",\n",
    "\n",
    "        \"expected_total_rows\":\n",
    "            65217,\n",
    "    },\n",
    "\n",
    "    {\n",
    "        \"dataset\":\n",
    "            \"GSE157783\",\n",
    "\n",
    "        \"role\":\n",
    "            \"PD replication\",\n",
    "\n",
    "        \"file\":\n",
    "            \"GSE157783_PD_REPLICATION_ALL_EFFECTS_LONG_v1.csv.gz\",\n",
    "\n",
    "        \"expected_total_rows\":\n",
    "            None,\n",
    "    },\n",
    "\n",
    "    {\n",
    "        \"dataset\":\n",
    "            \"GSE174367\",\n",
    "\n",
    "        \"role\":\n",
    "            \"AD discovery\",\n",
    "\n",
    "        \"file\":\n",
    "            \"GSE174367_AD_DISCOVERY_ALL_EFFECTS_LONG_v1.csv.gz\",\n",
    "\n",
    "        \"expected_total_rows\":\n",
    "            66921,\n",
    "    },\n",
    "\n",
    "    {\n",
    "        \"dataset\":\n",
    "            \"GSE157827\",\n",
    "\n",
    "        \"role\":\n",
    "            \"AD primary replication\",\n",
    "\n",
    "        \"file\":\n",
    "            \"GSE157827_AD_REPLICATION_PRIMARY_ALL_EFFECTS_LONG_v1.csv.gz\",\n",
    "\n",
    "        \"expected_total_rows\":\n",
    "            65737,\n",
    "    },\n",
    "\n",
    "    {\n",
    "        \"dataset\":\n",
    "            \"GSE138852\",\n",
    "\n",
    "        \"role\":\n",
    "            \"AD external replication\",\n",
    "\n",
    "        \"file\":\n",
    "            \"GSE138852_AD_SECONDARY_PRIMARY_ALL_EFFECTS_LONG_v1.csv.gz\",\n",
    "\n",
    "        \"expected_total_rows\":\n",
    "            37960,\n",
    "    },\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "CELL_TYPES = [\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "]\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. METRIC-SCHEMA HARMONIZATION\n",
    "# ============================================================\n",
    "\n",
    "METRIC_CANDIDATES = {\n",
    "\n",
    "    \"lfc\": [\n",
    "        \"log2FoldChange\",\n",
    "        \"AD_vs_Control_log2FC\",\n",
    "        \"PD_vs_Control_log2FC\",\n",
    "    ],\n",
    "\n",
    "    \"wald\": [\n",
    "        \"stat\",\n",
    "        \"AD_vs_Control_Wald\",\n",
    "        \"PD_vs_Control_Wald\",\n",
    "    ],\n",
    "\n",
    "    \"pvalue\": [\n",
    "        \"pvalue\",\n",
    "        \"AD_vs_Control_pvalue\",\n",
    "        \"PD_vs_Control_pvalue\",\n",
    "    ],\n",
    "\n",
    "    \"padj\": [\n",
    "        \"padj\",\n",
    "        \"AD_vs_Control_padj\",\n",
    "        \"PD_vs_Control_padj\",\n",
    "    ],\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "def choose_metric_column(\n",
    "    df,\n",
    "    metric,\n",
    "):\n",
    "\n",
    "    hits = [\n",
    "        c\n",
    "        for c in METRIC_CANDIDATES[\n",
    "            metric\n",
    "        ]\n",
    "        if c in df.columns\n",
    "    ]\n",
    "\n",
    "    assert len(hits) == 1, (\n",
    "        f\"{metric}: expected exactly one compatible \"\n",
    "        f\"column, found {hits}\"\n",
    "    )\n",
    "\n",
    "    return hits[0]\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. AUDIT EACH CORE BRAIN TABLE\n",
    "# ============================================================\n",
    "\n",
    "brain_qc_rows = []\n",
    "\n",
    "brain_file_rows = []\n",
    "\n",
    "\n",
    "for spec in brain_specs:\n",
    "\n",
    "    path = one_exact(\n",
    "        spec[\n",
    "            \"file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    df = pd.read_csv(\n",
    "        path,\n",
    "        compression=\"gzip\",\n",
    "        low_memory=False,\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\n\"\n",
    "        + \"=\" * 90\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        spec[\n",
    "            \"dataset\"\n",
    "        ],\n",
    "        \"—\",\n",
    "        spec[\n",
    "            \"role\"\n",
    "        ],\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"=\" * 90\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        path\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Shape:\",\n",
    "        df.shape,\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        \"cell_type\"\n",
    "        in df.columns\n",
    "    )\n",
    "\n",
    "\n",
    "    observed_classes = set(\n",
    "        df[\n",
    "            \"cell_type\"\n",
    "        ]\n",
    "        .dropna()\n",
    "        .astype(str)\n",
    "        .unique()\n",
    "    )\n",
    "\n",
    "\n",
    "    missing_classes = (\n",
    "        set(\n",
    "            CELL_TYPES\n",
    "        )\n",
    "        -\n",
    "        observed_classes\n",
    "    )\n",
    "\n",
    "\n",
    "    assert not missing_classes, (\n",
    "        f\"{spec['dataset']} missing target classes: \"\n",
    "        f\"{sorted(missing_classes)}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    expected_total = spec[\n",
    "        \"expected_total_rows\"\n",
    "    ]\n",
    "\n",
    "\n",
    "    if expected_total is not None:\n",
    "\n",
    "        assert len(df) == expected_total, (\n",
    "            f\"{spec['dataset']} expected \"\n",
    "            f\"{expected_total:,} rows, \"\n",
    "            f\"found {len(df):,}\"\n",
    "        )\n",
    "\n",
    "\n",
    "    lfc_col = choose_metric_column(\n",
    "        df,\n",
    "        \"lfc\",\n",
    "    )\n",
    "\n",
    "    stat_col = choose_metric_column(\n",
    "        df,\n",
    "        \"wald\",\n",
    "    )\n",
    "\n",
    "    p_col = choose_metric_column(\n",
    "        df,\n",
    "        \"pvalue\",\n",
    "    )\n",
    "\n",
    "    padj_col = choose_metric_column(\n",
    "        df,\n",
    "        \"padj\",\n",
    "    )\n",
    "\n",
    "\n",
    "    # Convert only audit copies.\n",
    "    for col in [\n",
    "        lfc_col,\n",
    "        stat_col,\n",
    "        p_col,\n",
    "        padj_col,\n",
    "    ]:\n",
    "\n",
    "        df[\n",
    "            col\n",
    "        ] = pd.to_numeric(\n",
    "            df[\n",
    "                col\n",
    "            ],\n",
    "            errors=\"coerce\",\n",
    "        )\n",
    "\n",
    "\n",
    "    brain_file_rows.append(\n",
    "        {\n",
    "            \"dataset\":\n",
    "                spec[\n",
    "                    \"dataset\"\n",
    "                ],\n",
    "\n",
    "            \"role\":\n",
    "                spec[\n",
    "                    \"role\"\n",
    "                ],\n",
    "\n",
    "            \"path\":\n",
    "                str(path),\n",
    "\n",
    "            \"rows\":\n",
    "                len(df),\n",
    "\n",
    "            \"lfc_column\":\n",
    "                lfc_col,\n",
    "\n",
    "            \"wald_column\":\n",
    "                stat_col,\n",
    "\n",
    "            \"pvalue_column\":\n",
    "                p_col,\n",
    "\n",
    "            \"padj_column\":\n",
    "                padj_col,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    for ct in CELL_TYPES:\n",
    "\n",
    "        x = df.loc[\n",
    "            df[\n",
    "                \"cell_type\"\n",
    "            ]\n",
    "            ==\n",
    "            ct\n",
    "        ].copy()\n",
    "\n",
    "\n",
    "        n = len(x)\n",
    "\n",
    "\n",
    "        assert n > 0\n",
    "\n",
    "\n",
    "        lfc = x[\n",
    "            lfc_col\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "\n",
    "        stat = x[\n",
    "            stat_col\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "\n",
    "        p = x[\n",
    "            p_col\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "\n",
    "        padj = x[\n",
    "            padj_col\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "\n",
    "\n",
    "        finite_lfc = np.isfinite(\n",
    "            lfc\n",
    "        )\n",
    "\n",
    "        finite_stat = np.isfinite(\n",
    "            stat\n",
    "        )\n",
    "\n",
    "        finite_p = np.isfinite(\n",
    "            p\n",
    "        )\n",
    "\n",
    "        finite_padj = np.isfinite(\n",
    "            padj\n",
    "        )\n",
    "\n",
    "\n",
    "        n_inf = int(\n",
    "            np.isinf(\n",
    "                lfc\n",
    "            ).sum()\n",
    "            +\n",
    "            np.isinf(\n",
    "                stat\n",
    "            ).sum()\n",
    "            +\n",
    "            np.isinf(\n",
    "                p\n",
    "            ).sum()\n",
    "            +\n",
    "            np.isinf(\n",
    "                padj\n",
    "            ).sum()\n",
    "        )\n",
    "\n",
    "\n",
    "        # Illegal numeric state.\n",
    "        assert n_inf == 0, (\n",
    "            f\"Infinite value found: \"\n",
    "            f\"{spec['dataset']} {ct}\"\n",
    "        )\n",
    "\n",
    "\n",
    "        # All finite p-values must be valid probabilities.\n",
    "        if finite_p.any():\n",
    "\n",
    "            assert (\n",
    "                (\n",
    "                    p[\n",
    "                        finite_p\n",
    "                    ]\n",
    "                    >=\n",
    "                    0\n",
    "                )\n",
    "                &\n",
    "                (\n",
    "                    p[\n",
    "                        finite_p\n",
    "                    ]\n",
    "                    <=\n",
    "                    1\n",
    "                )\n",
    "            ).all()\n",
    "\n",
    "\n",
    "        if finite_padj.any():\n",
    "\n",
    "            assert (\n",
    "                (\n",
    "                    padj[\n",
    "                        finite_padj\n",
    "                    ]\n",
    "                    >=\n",
    "                    0\n",
    "                )\n",
    "                &\n",
    "                (\n",
    "                    padj[\n",
    "                        finite_padj\n",
    "                    ]\n",
    "                    <=\n",
    "                    1\n",
    "                )\n",
    "            ).all()\n",
    "\n",
    "\n",
    "        n_fdr = int(\n",
    "            (\n",
    "                finite_padj\n",
    "                &\n",
    "                (\n",
    "                    padj\n",
    "                    <\n",
    "                    0.05\n",
    "                )\n",
    "            ).sum()\n",
    "        )\n",
    "\n",
    "\n",
    "        # Missing adjusted p-values are permissible.\n",
    "        # Missing LFC/Wald/raw-p are flagged for review.\n",
    "        core_complete = (\n",
    "            finite_lfc.sum()\n",
    "            ==\n",
    "            n\n",
    "            and\n",
    "            finite_stat.sum()\n",
    "            ==\n",
    "            n\n",
    "            and\n",
    "            finite_p.sum()\n",
    "            ==\n",
    "            n\n",
    "        )\n",
    "\n",
    "\n",
    "        status = (\n",
    "            \"PASS\"\n",
    "            if core_complete\n",
    "            else\n",
    "            \"REVIEW_NONFINITE_PRIMARY_METRIC\"\n",
    "        )\n",
    "\n",
    "\n",
    "        gene_id_col = (\n",
    "            \"gene_id\"\n",
    "            if \"gene_id\" in x.columns\n",
    "            else None\n",
    "        )\n",
    "\n",
    "\n",
    "        n_unique_gene_id = (\n",
    "            int(\n",
    "                x[\n",
    "                    gene_id_col\n",
    "                ]\n",
    "                .nunique(\n",
    "                    dropna=True\n",
    "                )\n",
    "            )\n",
    "            if gene_id_col\n",
    "            else\n",
    "            np.nan\n",
    "        )\n",
    "\n",
    "\n",
    "        n_unique_symbols = (\n",
    "            int(\n",
    "                x[\n",
    "                    \"gene_symbol\"\n",
    "                ]\n",
    "                .nunique(\n",
    "                    dropna=True\n",
    "                )\n",
    "            )\n",
    "            if \"gene_symbol\"\n",
    "            in x.columns\n",
    "            else\n",
    "            np.nan\n",
    "        )\n",
    "\n",
    "\n",
    "        brain_qc_rows.append(\n",
    "            {\n",
    "\n",
    "                \"dataset\":\n",
    "                    spec[\n",
    "                        \"dataset\"\n",
    "                    ],\n",
    "\n",
    "                \"role\":\n",
    "                    spec[\n",
    "                        \"role\"\n",
    "                    ],\n",
    "\n",
    "                \"cell_type\":\n",
    "                    ct,\n",
    "\n",
    "                \"tested_rows\":\n",
    "                    n,\n",
    "\n",
    "                \"unique_gene_ids\":\n",
    "                    n_unique_gene_id,\n",
    "\n",
    "                \"unique_gene_symbols\":\n",
    "                    n_unique_symbols,\n",
    "\n",
    "                \"finite_LFC\":\n",
    "                    int(\n",
    "                        finite_lfc.sum()\n",
    "                    ),\n",
    "\n",
    "                \"missing_LFC\":\n",
    "                    int(\n",
    "                        (\n",
    "                            ~finite_lfc\n",
    "                        ).sum()\n",
    "                    ),\n",
    "\n",
    "                \"finite_Wald\":\n",
    "                    int(\n",
    "                        finite_stat.sum()\n",
    "                    ),\n",
    "\n",
    "                \"missing_Wald\":\n",
    "                    int(\n",
    "                        (\n",
    "                            ~finite_stat\n",
    "                        ).sum()\n",
    "                    ),\n",
    "\n",
    "                \"finite_pvalue\":\n",
    "                    int(\n",
    "                        finite_p.sum()\n",
    "                    ),\n",
    "\n",
    "                \"missing_pvalue\":\n",
    "                    int(\n",
    "                        (\n",
    "                            ~finite_p\n",
    "                        ).sum()\n",
    "                    ),\n",
    "\n",
    "                \"finite_padj\":\n",
    "                    int(\n",
    "                        finite_padj.sum()\n",
    "                    ),\n",
    "\n",
    "                \"missing_padj\":\n",
    "                    int(\n",
    "                        (\n",
    "                            ~finite_padj\n",
    "                        ).sum()\n",
    "                    ),\n",
    "\n",
    "                \"FDR_lt_0_05\":\n",
    "                    n_fdr,\n",
    "\n",
    "                \"infinite_numeric_values\":\n",
    "                    n_inf,\n",
    "\n",
    "                \"status\":\n",
    "                    status,\n",
    "\n",
    "            }\n",
    "        )\n",
    "\n",
    "\n",
    "brain_qc = pd.DataFrame(\n",
    "    brain_qc_rows\n",
    ")\n",
    "\n",
    "\n",
    "brain_files = pd.DataFrame(\n",
    "    brain_file_rows\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    + \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"CORE BRAIN EFFECT-TABLE QC\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    brain_qc\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. FINAL PRIMARY-METRIC STATUS\n",
    "# ============================================================\n",
    "\n",
    "review_rows = brain_qc.loc[\n",
    "    brain_qc[\n",
    "        \"status\"\n",
    "    ]\n",
    "    !=\n",
    "    \"PASS\"\n",
    "]\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nDataset × cell-class rows requiring review:\",\n",
    "    len(\n",
    "        review_rows\n",
    "    ),\n",
    ")\n",
    "\n",
    "\n",
    "if len(\n",
    "    review_rows\n",
    ") > 0:\n",
    "\n",
    "    display(\n",
    "        review_rows\n",
    "    )\n",
    "\n",
    "\n",
    "# Do not silently accept missing LFC / Wald / raw p.\n",
    "assert len(\n",
    "    review_rows\n",
    ") == 0, (\n",
    "    \"At least one frozen core brain result table contains \"\n",
    "    \"non-finite LFC, Wald or raw p-values.\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nCORE BRAIN PRIMARY METRICS: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. HEALTHY-RETINA EXPRESSION GATE\n",
    "# ============================================================\n",
    "\n",
    "RETINA_EXPR_PATH = one_exact(\n",
    "    \"GSE148077_BRAIN_CONVERGENCE_\"\n",
    "    \"RETINAL_EXPRESSION_SUMMARY_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "retina = pd.read_csv(\n",
    "    RETINA_EXPR_PATH,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "required_retina = {\n",
    "\n",
    "    \"gene_symbol\",\n",
    "    \"retinal_donors_detected\",\n",
    "    \"retina_expression\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "assert required_retina.issubset(\n",
    "    retina.columns\n",
    ")\n",
    "\n",
    "\n",
    "retina[\n",
    "    \"retinal_donors_detected\"\n",
    "] = pd.to_numeric(\n",
    "    retina[\n",
    "        \"retinal_donors_detected\"\n",
    "    ],\n",
    "    errors=\"coerce\",\n",
    ")\n",
    "\n",
    "\n",    "expected_gate = (\n",
    "    retina[\n",
    "        \"retinal_donors_detected\"\n",
    "    ]\n",
    "    >=\n",
    "    2\n",
    ")\n",
    "\n",
    "\n",
    "observed_gate = (\n",
    "    retina[\n",
    "        \"retina_expression\"\n",
    "    ]\n",
    "    .fillna(False)\n",
    "    .astype(bool)\n",
    ")\n",
    "\n",
    "\n",
    "assert np.array_equal(\n",
    "    expected_gate.to_numpy(),\n",
    "    observed_gate.to_numpy(),\n",
    "), (\n",
    "    \"Retina-expression Boolean does not exactly equal \"\n",
    "    \"the >=2-donor criterion.\"\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    retina\n",
    ") == 17745\n",
    "\n",
    "\n",
    "assert int(\n",
    "    observed_gate.sum()\n",
    ") == 14469\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    + \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"HEALTHY RETINA EXPRESSION GATE: PASS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Genes evaluated:\",\n",
    "    len(\n",
    "        retina\n",
    "    ),\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Detected in >=2 retinal donors:\",\n",
    "    int(\n",
    "        observed_gate.sum()\n",
    "    ),\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Criterion verified directly: retinal_donors_detected >= 2\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. PXD073336 AD-RETINA SUPPORT QC\n",
    "# ============================================================\n",
    "\n",
    "PXD_PATH = one_exact(\n",
    "    \"PXD073336_AD_RETINA_INTERNAL_GENE_EFFECTS_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "pxd = pd.read_csv(\n",
    "    PXD_PATH,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    pxd\n",
    ") == 5562\n",
    "\n",
    "\n",
    "def first_existing(\n",
    "    df,\n",
    "    names,\n",
    "):\n",
    "\n",
    "    hits = [\n",
    "        x\n",
    "        for x in names\n",
    "        if x in df.columns\n",
    "    ]\n",
    "\n",
    "    assert len(hits) == 1, (\n",
    "        f\"Expected exactly one of {names}; \"\n",
    "        f\"found {hits}\"\n",
    "    )\n",
    "\n",
    "    return hits[0]\n",
    "\n",
    "\n",
    "PXD_P_COL = first_existing(\n",
    "    pxd,\n",
    "    [\n",
    "        \"retina_pvalue\",\n",
    "        \"AD_retina_pvalue\",\n",
    "    ],\n",
    ")\n",
    "\n",
    "\n",
    "PXD_FDR_COL = first_existing(\n",
    "    pxd,\n",
    "    [\n",
    "        \"retina_FDR\",\n",
    "        \"AD_retina_FDR\",\n",
    "    ],\n",
    ")\n",
    "\n",
    "\n",
    "pxd_p = pd.to_numeric(\n",
    "    pxd[\n",
    "        PXD_P_COL\n",
    "    ],\n",
    "    errors=\"coerce\",\n",
    ").to_numpy(\n",
    "    dtype=float\n",
    ")\n",
    "\n",
    "\n",
    "pxd_fdr = pd.to_numeric(\n",
    "    pxd[\n",
    "        PXD_FDR_COL\n",
    "    ],\n",
    "    errors=\"coerce\",\n",
    ").to_numpy(\n",
    "    dtype=float\n",
    ")\n",
    "\n",
    "\n",
    "pxd_tested = np.isfinite(\n",
    "    pxd_p\n",
    ")\n",
    "\n",
    "\n",
    "pxd_fdr_finite = np.isfinite(\n",
    "    pxd_fdr\n",
    ")\n",
    "\n",
    "\n",
    "n_pxd_tested = int(\n",
    "    pxd_tested.sum()\n",
    ")\n",
    "\n",
    "\n",
    "n_pxd_nominal = int(\n",
    "    (\n",
    "        pxd_tested\n",
    "        &\n",
    "        (\n",
    "            pxd_p\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "    ).sum()\n",
    ")\n",
    "\n",
    "\n",
    "n_pxd_fdr = int(\n",
    "    (\n",
    "        pxd_fdr_finite\n",
    "        &\n",
    "        (\n",
    "            pxd_fdr\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "    ).sum()\n",
    ")\n",
    "\n",
    "\n",
    "assert n_pxd_tested == 4995\n",
    "assert n_pxd_nominal == 227\n",
    "assert n_pxd_fdr == 2\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    + \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PXD073336 AD-RETINA SUPPORT QC: PASS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Unique gene symbols:\",\n",
    "    len(\n",
    "        pxd\n",
    "    ),\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Statistically tested genes:\",\n",
    "    n_pxd_tested,\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Nominal P<0.05:\",\n",
    "    n_pxd_nominal,\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"FDR<0.05:\",\n",
    "    n_pxd_fdr,\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Interpretation: internal supportive reanalysis.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. WOLF PD AQUEOUS-HUMOR QC\n",
    "# ============================================================\n",
    "\n",
    "WOLF_PATH = one_exact(\n",
    "    \"Wolf_PD_AQUEOUS_HUMOR_WELCH_GENE_EFFECTS_v3.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "wolf = pd.read_csv(\n",
    "    WOLF_PATH,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "required_wolf = {\n",
    "\n",
    "    \"gene_symbol\",\n",
    "    \"PD_AH_log2RFU_diff\",\n",
    "    \"PD_AH_pvalue\",\n",
    "    \"PD_AH_FDR\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "assert required_wolf.issubset(\n",
    "    wolf.columns\n",
    ")\n",
    "\n",
    "\n",
    "wolf_p = pd.to_numeric(\n",
    "    wolf[\n",
    "        \"PD_AH_pvalue\"\n",
    "    ],\n",
    "    errors=\"coerce\",\n",
    ").to_numpy(\n",
    "    dtype=float\n",
    ")\n",
    "\n",
    "\n",
    "wolf_fdr = pd.to_numeric(\n",
    "    wolf[\n",
    "        \"PD_AH_FDR\"\n",
    "    ],\n",
    "    errors=\"coerce\",\n",
    ").to_numpy(\n",
    "    dtype=float\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    wolf\n",
    ") == 5691\n",
    "\n",
    "\n",
    "assert np.isfinite(\n",
    "    wolf_p\n",
    ").all()\n",
    "\n",
    "\n",
    "assert np.isfinite(\n",
    "    wolf_fdr\n",
    ").all()\n",
    "\n",
    "\n",
    "n_wolf_nominal = int(\n",
    "    (\n",
    "        wolf_p\n",
    "        <\n",
    "        0.05\n",
    "    ).sum()\n",
    ")\n",
    "\n",
    "\n",
    "n_wolf_fdr = int(\n",
    "    (\n",
    "        wolf_fdr\n",
    "        <\n",
    "        0.05\n",
    "    ).sum()\n",
    ")\n",
    "\n",
    "\n",
    "assert n_wolf_nominal == 2713\n",
    "assert n_wolf_fdr == 1803\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    + \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"WOLF PD AQUEOUS-HUMOR QC: PASS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Proteins tested:\",\n",
    "    len(\n",
    "        wolf\n",
    "    ),\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Nominal P<0.05:\",\n",
    "    n_wolf_nominal,\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"FDR<0.05:\",\n",
    "    n_wolf_fdr,\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Interpretation: independent supportive Welch reanalysis.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. R3 PROFILE-PRESERVING NULL\n",
    "# ============================================================\n",
    "\n",
    "R3_PATH = one_exact(\n",
    "    \"AD_PD_REACTOME_R3_\"\n",
    "    \"PROFILE_PRESERVING_NULL_AUDIT_v1.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "r3 = pd.read_csv(\n",
    "    R3_PATH\n",
    ")\n",
    "\n",
    "\n",
    "r3_lookup = dict(\n",
    "    zip(\n",
    "        r3[\n",
    "            \"metric\"\n",
    "        ],\n",
    "        r3[\n",
    "            \"value\"\n",
    "        ],\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "observed_r3 = int(\n",
    "    float(\n",
    "        r3_lookup[\n",
    "            \"observed_R3\"\n",
    "        ]\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "r3_mean = float(\n",
    "    r3_lookup[\n",
    "        \"null_R3_mean\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "r3_low = float(\n",
    "    r3_lookup[\n",
    "        \"null_R3_2.5pct\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "r3_high = float(\n",
    "    r3_lookup[\n",
    "        \"null_R3_97.5pct\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "r3_p = float(\n",
    "    r3_lookup[\n",
    "        \"empirical_P\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "assert observed_r3 == 665\n",
    "\n",
    "assert r3_low == 411\n",
    "\n",
    "assert r3_high == 476\n",
    "\n",
    "assert r3_p <= 1e-4\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    + \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"R3 PROFILE-PRESERVING NULL: PASS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Observed R3:\",\n",
    "    observed_r3,\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Null mean:\",\n",
    "    r3_mean,\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Null 95% interval:\",\n",
    "    (\n",
    "        r3_low,\n",
    "        r3_high,\n",
    "    ),\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Empirical P:\",\n",
    "    r3_p,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. MULTIMODAL AUDIT FILES\n",
    "# ============================================================\n",
    "\n",
    "MULTIMODAL_COUNT_PATH = one_exact(\n",
    "    \"RETINA-ND_MULTIMODAL_COUNT_AUDIT_v1.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "FIG4_AUDIT_PATH = one_exact(\n",
    "    \"RETINA-ND_FIGURE4_TOP20_AUDIT_v1.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "mm = pd.read_csv(\n",
    "    MULTIMODAL_COUNT_PATH\n",
    ")\n",
    "\n",
    "\n",
    "expected_class_B = {\n",
    "\n",
    "    \"Astro\":\n",
    "        4,\n",
    "\n",
    "    \"Micro\":\n",
    "        6,\n",
    "\n",
    "    \"OPC\":\n",
    "        3,\n",
    "\n",
    "    \"Oligo\":\n",
    "        6,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "for ct, expected_n in (\n",
    "    expected_class_B.items()\n",
    "):\n",
    "\n",
    "    observed = int(\n",
    "        mm.loc[\n",
    "            mm[\n",
    "                \"cell_type\"\n",
    "            ]\n",
    "            ==\n",
    "            ct,\n",
    "            \"class_B\",\n",
    "        ]\n",
    "        .iloc[\n",
    "            0\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    assert observed == expected_n\n",
    "\n",
    "\n",
    "assert int(\n",
    "    mm[\n",
    "        \"class_A\"\n",
    "    ].sum()\n",
    ") == 0\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nMULTIMODAL CLASS AUDIT: PASS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Class A total: 0\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Class B by cell type:\",\n",
    "    expected_class_B,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 12. FINAL FIGURE ARTIFACT AUDIT\n",
    "# ============================================================\n",
    "\n",
    "figure_specs = [\n",
    "\n",
    "    \"Figure3_REVISED_AD_PD_Reactome_convergence\",\n",
    "\n",
    "    \"Figure4_REVISED_multimodal_candidate_gene_support\",\n",
    "\n",
    "    \"Figure5_REVISED_candidate_pathway_matrix\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "artifact_rows = []\n",
    "\n",
    "\n",
    "for stem in figure_specs:\n",
    "\n",
    "    for ext in [\n",
    "        \"png\",\n",
    "        \"pdf\",\n",
    "        \"svg\",\n",
    "    ]:\n",
    "\n",
    "        path = (\n",
    "            FIG_DIR\n",
    "            /\n",
    "            f\"{stem}.{ext}\"\n",
    "        )\n",
    "\n",
    "        artifact_rows.append(\n",
    "            {\n",
    "                \"artifact\":\n",
    "                    stem,\n",
    "\n",
    "                \"format\":\n",
    "                    ext,\n",
    "\n",
    "                \"exists\":\n",
    "                    path.exists(),\n",
    "\n",
    "                \"bytes\":\n",
    "                    (\n",
    "                        path.stat().st_size\n",
    "                        if path.exists()\n",
    "                        else\n",
    "                        np.nan\n",
    "                    ),\n",
    "\n",
    "                \"path\":\n",
    "                    str(path),\n",
    "            }\n",
    "        )\n",
    "\n",
    "\n",
    "artifact_qc = pd.DataFrame(\n",
    "    artifact_rows\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    + \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"REVISED FIGURE ARTIFACTS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    artifact_qc\n",
    ")\n",
    "\n",
    "\n",
    "missing_artifacts = artifact_qc.loc[\n",
    "    ~artifact_qc[\n",
    "        \"exists\"\n",
    "    ]\n",
    "]\n",
    "\n",
    "\n",
    "if len(\n",
    "    missing_artifacts\n",
    ") > 0:\n",
    "\n",
    "    print(\n",
    "        \"\\nWARNING:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Some revised figure formats are missing.\"\n",
    "    )\n",
    "\n",
    "    display(\n",
    "        missing_artifacts\n",
    "    )\n",
    "\n",
    "else:\n",
    "\n",
    "    print(\n",
    "        \"\\nAll revised Figure 3–5 PNG/PDF/SVG files exist.\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 13. SAVE FINAL QC TABLES\n",
    "# ============================================================\n",
    "\n",
    "BRAIN_QC_PATH = (\n",
    "    QC_DIR\n",
    "    /\n",
    "    \"RETINA-ND_FINAL_CORE_BRAIN_DE_QC_v1.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "BRAIN_FILE_PATH = (\n",
    "    QC_DIR\n",
    "    /\n",
    "    \"RETINA-ND_FINAL_CORE_BRAIN_FILE_MANIFEST_v1.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "ARTIFACT_QC_PATH = (\n",
    "    QC_DIR\n",
    "    /\n",
    "    \"RETINA-ND_FINAL_FIGURE_ARTIFACT_QC_v1.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "SUMMARY_PATH = (\n",
    "    QC_DIR\n",
    "    /\n",
    "    \"RETINA-ND_FINAL_NOTEBOOK_QC_SUMMARY_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "brain_qc.to_csv(\n",
    "    BRAIN_QC_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "brain_files.to_csv(\n",
    "    BRAIN_FILE_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "artifact_qc.to_csv(\n",
    "    ARTIFACT_QC_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "summary = {\n",
    "\n",
    "    \"status\":\n",
    "        \"RETINA-ND_FINAL_NOTEBOOK_QC_COMPLETE\",\n",
    "\n",
    "    \"project_root\":\n",
    "        str(\n",
    "            ROOT\n",
    "        ),\n",
    "\n",
    "    \"core_brain_datasets\":\n",
    "        [\n",
    "            x[\n",
    "                \"dataset\"\n",
    "            ]\n",
    "            for x in brain_specs\n",
    "        ],\n",
    "\n",
    "    \"core_brain_dataset_celltype_rows\":\n",
    "        int(\n",
    "            len(\n",
    "                brain_qc\n",
    "            )\n",
    "        ),\n",
    "\n",
    "    \"core_brain_rows_requiring_review\":\n",
    "        int(\n",
    "            len(\n",
    "                review_rows\n",
    "            )\n",
    "        ),\n",
    "\n",
    "    \"healthy_retina_total_genes\":\n",
    "        int(\n",
    "            len(\n",
    "                retina\n",
    "            )\n",
    "        ),\n",
    "\n",
    "    \"healthy_retina_detected_ge2_donors\":\n",
    "        int(\n",
    "            observed_gate.sum()\n",
    "        ),\n",
    "\n",
    "    \"PXD073336_genes_represented\":\n",
    "        int(\n",
    "            len(\n",
    "                pxd\n",
    "            )\n",
    "        ),\n",
    "\n",
    "    \"PXD073336_tested_genes\":\n",
    "        int(\n",
    "            n_pxd_tested\n",
    "        ),\n",
    "\n",
    "    \"PXD073336_nominal_P05\":\n",
    "        int(\n",
    "            n_pxd_nominal\n",
    "        ),\n",
    "\n",
    "    \"PXD073336_FDR05\":\n",
    "        int(\n",
    "            n_pxd_fdr\n",
    "        ),\n",
    "\n",
    "    \"Wolf_tested_proteins\":\n",
    "        int(\n",
    "            len(\n",
    "                wolf\n",
    "            )\n",
    "        ),\n",
    "\n",
    "    \"Wolf_nominal_P05\":\n",
    "        int(\n",
    "            n_wolf_nominal\n",
    "        ),\n",
    "\n",
    "    \"Wolf_FDR05\":\n",
    "        int(\n",
    "            n_wolf_fdr\n",
    "        ),\n",
    "\n",
    "    \"R3_observed\":\n",
    "        int(\n",
    "            observed_r3\n",
    "        ),\n",
    "\n",
    "    \"R3_null_mean\":\n",
    "        float(\n",
    "            r3_mean\n",
    "        ),\n",
    "\n",
    "    \"R3_null_95_interval\":\n",
    "        [\n",
    "            float(\n",
    "                r3_low\n",
    "            ),\n",
    "            float(\n",
    "                r3_high\n",
    "            ),\n",
    "        ],\n",
    "\n",
    "    \"R3_empirical_P\":\n",
    "        float(\n",
    "            r3_p\n",
    "        ),\n",
    "\n",
    "    \"multimodal_class_A_total\":\n",
    "        0,\n",
    "\n",
    "    \"multimodal_class_B_celltype_counts\":\n",
    "        expected_class_B,\n",
    "\n",
    "    \"revised_figure_artifacts_missing\":\n",
    "        int(\n",
    "            len(\n",
    "                missing_artifacts\n",
    "            )\n",
    "        ),\n",
    "\n",
    "    \"interpretation_notes\": [\n",
    "\n",
    "        (\n",
    "            \"Missing adjusted p-values are reported but are \"\n",
    "            \"not treated as failed model fits.\"\n",
    "        ),\n",
    "\n",
    "        (\n",
    "            \"Core LFC, Wald statistic and raw p-value columns \"\n",
    "            \"must be finite for all frozen tested rows.\"\n",
    "        ),\n",
    "\n",
    "        (\n",
    "            \"PyDESeq2 dispersion-trend fallback warnings occurred \"\n",
    "            \"during some fits and should be documented rather than \"\n",
    "            \"silently omitted.\"\n",
    "        ),\n",
    "\n",
    "        (\n",
    "            \"PXD073336 effects are an internal supportive reanalysis, \"\n",
    "            \"not the authors' published adjusted DAP statistics.\"\n",
    "        ),\n",
    "\n",
    "        (\n",
    "            \"Wolf aqueous-humor results are a supportive Welch \"\n",
    "            \"reanalysis, not an exact reproduction of the publication model.\"\n",
    "        ),\n",
    "\n",
    "        (\n",
    "            \"R3 has global permutation support; individual R3 pathways \"\n",
    "            \"are not individually significant cross-disease calls.\"\n",
    "        ),\n",
    "\n",
    "    ],\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    SUMMARY_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        summary,\n",
    "        f,\n",
    "        indent=2,\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 14. FINAL REPORT\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    + \"=\" * 100\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"RETINA-ND FINAL NOTEBOOK QC COMPLETE\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 100\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nCore brain datasets audited:\",\n",
    "    len(\n",
    "        brain_specs\n",
    "    ),\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Dataset × cell-class combinations:\",\n",
    "    len(\n",
    "        brain_qc\n",
    "    ),\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Rows requiring statistical review:\",\n",
    "    len(\n",
    "        review_rows\n",
    "    ),\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nHealthy retina:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"  >=2-donor gate = \"\n",
    "    f\"{int(observed_gate.sum()):,}\"\n",
    "    f\" / {len(retina):,}\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPXD073336:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"  tested = {n_pxd_tested:,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"  nominal = {n_pxd_nominal:,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"  FDR = {n_pxd_fdr:,}\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nWolf PD aqueous:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"  tested = {len(wolf):,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"  nominal = {n_wolf_nominal:,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"  FDR = {n_wolf_fdr:,}\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nR3:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"  observed = {observed_r3}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"  null 95% = \"\n",
    "    f\"{r3_low:.0f}–{r3_high:.0f}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"  empirical P = {r3_p}\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nMissing revised figure artifacts:\",\n",
    "    len(\n",
    "        missing_artifacts\n",
    "    ),\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSaved:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    BRAIN_QC_PATH\n",
    ")\n",
    "\n",
    "print(\n",
    "    BRAIN_FILE_PATH\n",
    ")\n",
    "\n",    "print(\n",
    "    ARTIFACT_QC_PATH\n",
    ")\n",
    "\n",
    "print(\n",
    "    SUMMARY_PATH\n",
    ")"
   ]
  }
