    "    SVG_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nMAIN FIGURES 1–5: COMPLETE\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nNEXT:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Supplementary Figure S1 — PD discovery/replication robustness.\"\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 92\n",
    "# ============================================================\n",
    "# RETINA-ND — REVISED PUBLICATION FIGURE 3\n",
    "#\n",
    "# FORMAL R2 CONVERGENCE + PERMUTATION-SUPPORTED\n",
    "# RECURRENT R3 DIRECTIONAL PROGRAMS\n",
    "#\n",
    "# SAFE AFTER COLAB RESTART.\n",
    "#\n",
    "# Does NOT rerun GSEA.\n",
    "# Does NOT alter frozen results.\n",
    "# Does NOT overwrite original Figure 3.\n",
    "# ============================================================\n",
    "\n",
    "from google.colab import drive\n",
    "from pathlib import Path\n",
    "import textwrap\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from matplotlib.colors import TwoSlopeNorm\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. MOUNT DRIVE\n",
    "# ============================================================\n",
    "\n",
    "drive.mount(\n",
    "    \"/content/drive\",\n",
    "    force_remount=False,\n",
    ")\n",
    "\n",
    "MYDRIVE = Path(\n",
    "    \"/content/drive/MyDrive\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. FIND FROZEN FIGURE-3 MATRIX\n",
    "# ============================================================\n",
    "\n",
    "MATRIX_NAME = (\n",
    "    \"RETINA_ND_REACTOME_\"\n",
    "    \"FIGURE_MATRIX_v6.csv\"\n",
    ")\n",
    "\n",
    "matrix_hits = list(\n",
    "    MYDRIVE.rglob(\n",
    "        MATRIX_NAME\n",
    "    )\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Figure-matrix matches:\",\n",
    "    len(matrix_hits),\n",
    ")\n",
    "\n",
    "for p in matrix_hits:\n",
    "    print(\" \", p)\n",
    "\n",
    "\n",
    "assert len(matrix_hits) >= 1, (\n",
    "    f\"Could not find {MATRIX_NAME}\"\n",
    ")\n",
    "\n",
    "\n",
    "CELL_TYPES = [\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "]\n",
    "\n",
    "DISEASES = [\n",
    "    \"AD\",\n",
    "    \"PD\",\n",
    "]\n",
    "\n",
    "\n",
    "value_cols = [\n",
    "    f\"{ct}_{disease}_NES\"\n",
    "    for ct in CELL_TYPES\n",
    "    for disease in DISEASES\n",
    "]\n",
    "\n",
    "fdr_cols = [\n",
    "    f\"{ct}_{disease}_FDR\"\n",
    "    for ct in CELL_TYPES\n",
    "    for disease in DISEASES\n",
    "]\n",
    "\n",
    "\n",
    "required_cols = {\n",
    "    \"pathway\",\n",
    "    \"pathway_rank\",\n",
    "    \"priority_group\",\n",
    "    *value_cols,\n",
    "    *fdr_cols,\n",
    "}\n",
    "\n",
    "\n",
    "valid_matrices = []\n",
    "\n",
    "for path in matrix_hits:\n",
    "\n",
    "    try:\n",
    "        x = pd.read_csv(path)\n",
    "\n",
    "    except Exception:\n",
    "        continue\n",
    "\n",
    "    if not required_cols.issubset(\n",
    "        x.columns\n",
    "    ):\n",
    "        continue\n",
    "\n",
    "    if len(x) != 30:\n",
    "        continue\n",
    "\n",
    "    priority_counts = (\n",
    "        x[\n",
    "            \"priority_group\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .value_counts()\n",
    "    )\n",
    "\n",
    "    n_r2 = int(\n",
    "        priority_counts[\n",
    "            priority_counts.index.str.startswith(\n",
    "                \"R2\"\n",
    "            )\n",
    "        ].sum()\n",
    "    )\n",
    "\n",
    "    n_r3 = int(\n",
    "        priority_counts[\n",
    "            priority_counts.index.str.startswith(\n",
    "                \"R3\"\n",
    "            )\n",
    "        ].sum()\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"\\nCandidate matrix:\",\n",
    "        path,\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  rows:\",\n",
    "        len(x),\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  R2 displayed:\",\n",
    "        n_r2,\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  R3 displayed:\",\n",
    "        n_r3,\n",
    "    )\n",
    "\n",
    "    if (\n",
    "        n_r2 == 6\n",
    "        and\n",
    "        n_r3 == 24\n",
    "    ):\n",
    "        valid_matrices.append(\n",
    "            (\n",
    "                path,\n",
    "                x,\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "assert len(valid_matrices) == 1, (\n",
    "    \"Could not identify exactly one frozen \"\n",
    "    \"Figure-3 matrix with 6 R2 + 24 R3 rows.\"\n",
    ")\n",
    "\n",
    "\n",
    "INPUT_PATH, df = (\n",
    "    valid_matrices[0]\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nUsing VERIFIED Figure-3 matrix:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    INPUT_PATH\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. IDENTIFY PROJECT ROOT\n",
    "# ============================================================\n",
    "\n",
    "# INPUT:\n",
    "# ROOT/results/final_evidence/file.csv\n",
    "\n",
    "ROOT = (\n",
    "    INPUT_PATH\n",
    "    .parent\n",
    "    .parent\n",
    "    .parent\n",
    ")\n",
    "\n",
    "FIG_DIR = (\n",
    "    ROOT\n",
    "    / \"results\"\n",
    "    / \"publication_figures\"\n",
    ")\n",
    "\n",
    "FIG_DIR.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nProject root:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    ROOT\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. LOAD PROFILE-PRESERVING R3 AUDIT\n",
    "# ============================================================\n",
    "\n",
    "AUDIT_NAME = (\n",
    "    \"AD_PD_REACTOME_R3_\"\n",
    "    \"PROFILE_PRESERVING_NULL_AUDIT_v1.csv\"\n",
    ")\n",
    "\n",
    "audit_hits = list(\n",
    "    ROOT.rglob(\n",
    "        AUDIT_NAME\n",
    "    )\n",
    ")\n",
    "\n",
    "assert len(audit_hits) == 1, (\n",
    "    f\"Expected exactly one {AUDIT_NAME}; \"\n",
    "    f\"found {len(audit_hits)}\"\n",
    ")\n",
    "\n",
    "AUDIT_PATH = audit_hits[0]\n",
    "\n",
    "audit = pd.read_csv(\n",
    "    AUDIT_PATH\n",
    ")\n",
    "\n",
    "audit_lookup = dict(\n",
    "    zip(\n",
    "        audit[\"metric\"],\n",
    "        audit[\"value\"],\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "OBSERVED_R3 = int(\n",
    "    float(\n",
    "        audit_lookup[\n",
    "            \"observed_R3\"\n",
    "        ]\n",
    "    )\n",
    ")\n",
    "\n",
    "NULL_MEAN = float(\n",
    "    audit_lookup[\n",
    "        \"null_R3_mean\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "NULL_MEDIAN = float(\n",
    "    audit_lookup[\n",
    "        \"null_R3_median\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "NULL_LOW = float(\n",
    "    audit_lookup[\n",
    "        \"null_R3_2.5pct\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "NULL_HIGH = float(\n",
    "    audit_lookup[\n",
    "        \"null_R3_97.5pct\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "R3_EMPIRICAL_P = float(\n",
    "    audit_lookup[\n",
    "        \"empirical_P\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "assert OBSERVED_R3 == 665\n",
    "\n",
    "assert (\n",
    "    R3_EMPIRICAL_P\n",
    "    <=\n",
    "    1e-4\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nR3 audit:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \" observed:\",\n",
    "    OBSERVED_R3,\n",
    ")\n",
    "\n",
    "print(\n",
    "    \" null mean:\",\n",
    "    NULL_MEAN,\n",
    ")\n",
    "\n",
    "print(\n",
    "    \" null 95% interval:\",\n",
    "    (\n",
    "        NULL_LOW,\n",
    "        NULL_HIGH,\n",
    "    ),\n",
    ")\n",
    "\n",
    "print(\n",
    "    \" empirical P:\",\n",
    "    R3_EMPIRICAL_P,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. ORDER FIGURE\n",
    "#\n",
    "# Formal R2 first.\n",
    "# Descriptive/permutation-supported R3 second.\n",
    "# Within each tier, preserve pathway ranking.\n",
    "# ============================================================\n",
    "\n",
    "df = df.copy()\n",
    "\n",
    "\n",
    "df[\n",
    "    \"_tier\"\n",
    "] = np.where(\n",
    "    df[\n",
    "        \"priority_group\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .str.startswith(\n",
    "        \"R2\"\n",
    "    ),\n",
    "    0,\n",
    "    1,\n",
    ")\n",
    "\n",
    "\n",
    "df[\n",
    "    \"pathway_rank\"\n",
    "] = pd.to_numeric(\n",
    "    df[\n",
    "        \"pathway_rank\"\n",
    "    ],\n",
    "    errors=\"coerce\",\n",
    ")\n",
    "\n",
    "\n",
    "df = (\n",
    "    df\n",
    "    .sort_values(\n",
    "        [\n",
    "            \"_tier\",\n",
    "            \"pathway_rank\",\n",
    "        ],\n",
    "        ascending=[\n",
    "            True,\n",
    "            True,\n",
    "        ],\n",
    "    )\n",
    "    .reset_index(\n",
    "        drop=True\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "n_r2_display = int(\n",
    "    (\n",
    "        df[\n",
    "            \"_tier\"\n",
    "        ]\n",
    "        ==\n",
    "        0\n",
    "    ).sum()\n",
    ")\n",
    "\n",
    "n_r3_display = int(\n",
    "    (\n",
    "        df[\n",
    "            \"_tier\"\n",
    "        ]\n",
    "        ==\n",
    "        1\n",
    "    ).sum()\n",
    ")\n",
    "\n",
    "\n",
    "assert n_r2_display == 6\n",
    "assert n_r3_display == 24\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. BUILD NES / FDR MATRICES\n",
    "# ============================================================\n",
    "\n",
    "matrix = (\n",
    "    df[\n",
    "        value_cols\n",
    "    ]\n",
    "    .apply(\n",
    "        pd.to_numeric,\n",
    "        errors=\"coerce\",\n",
    "    )\n",
    "    .to_numpy(\n",
    "        dtype=float\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "fdr_matrix = (\n",
    "    df[\n",
    "        fdr_cols\n",
    "    ]\n",
    "    .apply(\n",
    "        pd.to_numeric,\n",
    "        errors=\"coerce\",\n",
    "    )\n",
    "    .to_numpy(\n",
    "        dtype=float\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert matrix.shape == (\n",
    "    30,\n",
    "    8,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. DISPLAY LABELS\n",
    "# ============================================================\n",
    "\n",
    "def clean_pathway_name(\n",
    "    name\n",
    "):\n",
    "\n",
    "    name = str(\n",
    "        name\n",
    "    )\n",
    "\n",
    "    replacements = {\n",
    "\n",
    "        \"SARS-CoV-1 modulates host translation machinery\":\n",
    "            \"Host translation machinery\",\n",
    "\n",
    "        \"SARS-CoV-2-host interactions\":\n",
    "            \"Host interaction / stress-response machinery\",\n",
    "\n",
    "        \"Vif-mediated degradation of APOBEC3G\":\n",
    "            \"Proteasome-dependent protein degradation\",\n",
    "\n",
    "        \"Constitutive Signaling by Aberrant PI3K in Cancer\":\n",
    "            \"PI3K signaling\",\n",
    "\n",
    "        \"Diseases associated with the TLR signaling cascade\":\n",
    "            \"TLR signaling\",\n",
    "\n",
    "        \"Major pathway of rRNA processing in the nucleolus and cytosol\":\n",
    "            \"rRNA processing\",\n",
    "\n",
    "        \"Gamma carboxylation, hypusine formation and arylsulfatase activation\":\n",
    "            \"Post-translational modification pathways\",\n",
    "    }\n",
    "\n",
    "\n",
    "    name = replacements.get(\n",
    "        name,\n",
    "        name,\n",
    "    )\n",
    "\n",
    "\n",
    "    return textwrap.fill(\n",
    "        name,\n",
    "        width=43,\n",
    "        break_long_words=False,\n",
    "        break_on_hyphens=False,\n",
    "    )\n",
    "\n",
    "\n",
    "pathway_labels = [\n",
    "    clean_pathway_name(\n",
    "        x\n",
    "    )\n",
    "    for x in df[\n",
    "        \"pathway\"\n",
    "    ]\n",
    "]\n",
    "\n",
    "\n",
    "column_labels = [\n",
    "    f\"{ct}\\n{disease}\"\n",
    "    for ct in CELL_TYPES\n",
    "    for disease in DISEASES\n",
    "]\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. COLOR SCALE\n",
    "# ============================================================\n",
    "\n",
    "finite_values = matrix[\n",
    "    np.isfinite(\n",
    "        matrix\n",
    "    )\n",
    "]\n",
    "\n",
    "\n",
    "assert len(\n",
    "    finite_values\n",
    ") > 0\n",
    "\n",
    "\n",
    "robust_limit = float(\n",
    "    np.nanpercentile(\n",
    "        np.abs(\n",
    "            finite_values\n",
    "        ),\n",
    "        97.5,\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "color_limit = min(\n",
    "    max(\n",
    "        1.5,\n",
    "        robust_limit,\n",
    "    ),\n",
    "    3.0,\n",
    ")\n",
    "\n",
    "\n",
    "norm = TwoSlopeNorm(\n",
    "    vmin=-color_limit,\n",
    "    vcenter=0,\n",
    "    vmax=color_limit,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. CREATE FIGURE\n",
    "# ============================================================\n",
    "\n",
    "fig = plt.figure(\n",
    "    figsize=(\n",
    "        12.6,\n",
    "        13.2,\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "gs = fig.add_gridspec(\n",
    "    nrows=1,\n",
    "    ncols=3,\n",
    "    width_ratios=[\n",
    "        1.0,\n",
    "        0.105,\n",
    "        0.045,\n",
    "    ],\n",
    "    wspace=0.08,\n",
    ")\n",
    "\n",
    "\n",
    "ax = fig.add_subplot(\n",
    "    gs[\n",
    "        0,\n",
    "        0,\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "tier_ax = fig.add_subplot(\n",
    "    gs[\n",
    "        0,\n",
    "        1,\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "cax = fig.add_subplot(\n",
    "    gs[\n",
    "        0,\n",
    "        2,\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "im = ax.imshow(\n",
    "    matrix,\n",
    "    aspect=\"auto\",\n",
    "    interpolation=\"nearest\",\n",
    "    cmap=\"RdBu_r\",\n",
    "    norm=norm,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. AXES\n",
    "# ============================================================\n",
    "\n",
    "ax.set_xticks(\n",
    "    np.arange(\n",
    "        len(\n",
    "            column_labels\n",
    "        )\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "ax.set_xticklabels(\n",
    "    column_labels,\n",
    "    fontsize=10,\n",
    "    fontweight=\"bold\",\n",
    ")\n",
    "\n",
    "\n",
    "ax.set_yticks(\n",
    "    np.arange(\n",
    "        len(\n",
    "            pathway_labels\n",
    "        )\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "ax.set_yticklabels(\n",
    "    pathway_labels,\n",
    "    fontsize=8.8,\n",
    ")\n",
    "\n",
    "\n",
    "ax.tick_params(\n",
    "    axis=\"x\",\n",
    "    top=True,\n",
    "    bottom=False,\n",
    "    labeltop=True,\n",
    "    labelbottom=False,\n",
    "    length=0,\n",
    ")\n",
    "\n",
    "\n",
    "ax.tick_params(\n",
    "    axis=\"y\",\n",
    "    length=0,\n",
    ")\n",
    "\n",
    "\n",
    "# Bold formal R2 pathway labels only.\n",
    "for i, label in enumerate(\n",
    "    ax.get_yticklabels()\n",
    "):\n",
    "\n",
    "    if (\n",
    "        df.loc[\n",
    "            i,\n",
    "            \"_tier\",\n",
    "        ]\n",
    "        ==\n",
    "        0\n",
    "    ):\n",
    "\n",
    "        label.set_fontweight(\n",
    "            \"bold\"\n",
    "        )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. INDIVIDUAL DISEASE/CELL-TYPE FDR MARKERS\n",
    "#\n",
    "# * = FDR < 0.05 in that individual GSEA result.\n",
    "# ============================================================\n",
    "\n",
    "for i in range(\n",
    "    matrix.shape[0]\n",
    "):\n",
    "\n",
    "    for j in range(\n",
    "        matrix.shape[1]\n",
    "    ):\n",
    "\n",
    "        fdr = (\n",
    "            fdr_matrix[\n",
    "                i,\n",
    "                j,\n",
    "            ]\n",
    "        )\n",
    "\n",
    "\n",
    "        if (\n",
    "            np.isfinite(\n",
    "                fdr\n",
    "            )\n",
    "            and\n",
    "            fdr\n",
    "            <\n",
    "            0.05\n",
    "        ):\n",
    "\n",
    "            value = (\n",
    "                matrix[\n",
    "                    i,\n",
    "                    j,\n",
    "                ]\n",
    "            )\n",
    "\n",
    "\n",
    "            text_color = (\n",
    "                \"white\"\n",
    "                if (\n",
    "                    np.isfinite(\n",
    "                        value\n",
    "                    )\n",
    "                    and\n",
    "                    abs(\n",
    "                        value\n",
    "                    )\n",
    "                    >\n",
    "                    (\n",
    "                        0.52\n",
    "                        *\n",
    "                        color_limit\n",
    "                    )\n",
    "                )\n",
    "                else\n",
    "                \"black\"\n",
    "            )\n",
    "\n",
    "\n",
    "            ax.text(\n",
    "                j,\n",
    "                i,\n",
    "                \"*\",\n",
    "                ha=\"center\",\n",
    "                va=\"center\",\n",
    "                fontsize=11.5,\n",
    "                fontweight=\"bold\",\n",
    "                color=text_color,\n",
    "            )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. CELL-TYPE SEPARATORS\n",
    "# ============================================================\n",
    "\n",
    "for x in [\n",
    "    1.5,\n",
    "    3.5,\n",
    "    5.5,\n",
    "]:\n",
    "\n",
    "    ax.axvline(\n",
    "        x,\n",
    "        linewidth=1.8,\n",
    "        color=\"white\",\n",
    "    )\n",
    "\n",
    "\n",
    "for y in np.arange(\n",
    "    0.5,\n",
    "    len(df),\n",
    "    1,\n",
    "):\n",
    "\n",
    "    ax.axhline(\n",
    "        y,\n",
    "        linewidth=0.25,\n",
    "        color=\"white\",\n",
    "        alpha=0.65,\n",
    "    )\n",
    "\n",
    "\n",
    "# Strong divider between R2 and R3 sections.\n",
    "r2_boundary = (\n",
    "    n_r2_display\n",
    "    -\n",
    "    0.5\n",
    ")\n",
    "\n",
    "ax.axhline(\n",
    "    r2_boundary,\n",
    "    linewidth=2.5,\n",
    "    color=\"black\",\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 12. EVIDENCE-TIER COLUMN\n",
    "# ============================================================\n",
    "\n",
    "tier_ax.set_xlim(\n",
    "    0,\n",
    "    1,\n",
    ")\n",
    "\n",
    "tier_ax.set_ylim(\n",
    "    len(df) - 0.5,\n",
    "    -0.5,\n",
    ")\n",
    "\n",
    "tier_ax.set_xticks([])\n",
    "tier_ax.set_yticks([])\n",
    "\n",
    "\n",
    "for spine in (\n",
    "    tier_ax.spines.values()\n",
    "):\n",
    "\n",
    "    spine.set_visible(\n",
    "        False\n",
    "    )\n",
    "\n",
    "\n",
    "for i in range(\n",
    "    len(df)\n",
    "):\n",
    "\n",
    "    is_r2 = (\n",
    "        df.loc[\n",
    "            i,\n",
    "            \"_tier\",\n",
    "        ]\n",
    "        ==\n",
    "        0\n",
    "    )\n",
    "\n",
    "\n",
    "    label = (\n",
    "        \"R2\"\n",
    "        if is_r2\n",
    "        else\n",
    "        \"R3\"\n",
    "    )\n",
    "\n",
    "\n",
    "    tier_ax.text(\n",
    "        0.5,\n",
    "        i,\n",
    "        label,\n",
    "        ha=\"center\",\n",
    "        va=\"center\",\n",
    "        fontsize=8.8,\n",
    "        fontweight=(\n",
    "            \"bold\"\n",
    "            if is_r2\n",
    "            else\n",
    "            \"normal\"\n",
    "        ),\n",
    "    )\n",
    "\n",
    "\n",
    "tier_ax.axhline(\n",
    "    r2_boundary,\n",
    "    linewidth=2.5,\n",
    "    color=\"black\",\n",
    ")\n",
    "\n",
    "\n",
    "tier_ax.set_title(\n",
    "    \"Evidence\\nclass\",\n",
    "    fontsize=9,\n",
    "    fontweight=\"bold\",\n",
    "    pad=12,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 13. COLORBAR\n",
    "# ============================================================\n",
    "\n",
    "cbar = fig.colorbar(\n",
    "    im,\n",
    "    cax=cax,\n",
    ")\n",
    "\n",
    "\n",
    "cbar.set_label(\n",
    "    \"Normalized enrichment score (NES)\",\n",
    "    fontsize=10,\n",
    ")\n",
    "\n",
    "\n",
    "cbar.ax.tick_params(\n",
    "    labelsize=8.5\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 14. TITLES\n",
    "# ============================================================\n",
    "\n",
    "fig.suptitle(\n",
    "    (\n",
    "        \"Shared Reactome pathway perturbations across \"\n",
    "        \"Alzheimer’s and Parkinson’s disease\"\n",
    "    ),\n",
    "    fontsize=16,\n",
    "    fontweight=\"bold\",\n",
    "    y=0.985,\n",
    ")\n",
    "\n",
    "\n",
    "ax.set_title(\n",
    "    (\n",
    "        \"Formal pathway convergence (R2) and \"\n",
    "        \"permutation-supported recurrent directionality (R3)\"\n",
    "    ),\n",
    "    fontsize=10.5,\n",
    "    pad=46,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 15. FOOTNOTES\n",
    "# ============================================================\n",
    "\n",
    "p_display = (\n",
    "    \"< 1×10⁻⁴\"\n",
    "    if R3_EMPIRICAL_P\n",
    "    <=\n",
    "    1e-4\n",
    "    else\n",
    "    f\"= {R3_EMPIRICAL_P:.3g}\"\n",
    ")\n",
    "\n",
    "\n",
    "footnote_1 = (\n",
    "    \"R2: AD and PD FDR < 0.05 with the same NES direction \"\n",
    "    \"in ≥1 glial cell class. \"\n",
    "    \"R3: same AD–PD NES direction in ≥3 glial cell classes \"\n",
    "    \"without R2-level pathway convergence.\"\n",
    ")\n",
    "\n",
    "\n",
    "footnote_2 = (\n",
    "    f\"Global R3 recurrence exceeded the profile-preserving null: \"\n",
    "    f\"{OBSERVED_R3} observed; null median \"\n",
    "    f\"{NULL_MEDIAN:.0f}, 95% interval \"\n",
    "    f\"{NULL_LOW:.0f}–{NULL_HIGH:.0f}; \"\n",
    "    f\"empirical P {p_display}. \"\n",
    "    \"This supports the R3 category globally, not individual \"\n",
    "    \"pathway significance.\"\n",
    ")\n",    "\n",
    "\n",
    "footnote_3 = (\n",
    "    \"* FDR < 0.05 for the individual disease/cell-class GSEA. \"\n",
    "    \"Positive NES indicates enrichment toward increased expression; \"\n",
    "    \"negative NES toward decreased expression.\"\n",
    ")\n",
    "\n",
    "\n",
    "fig.text(\n",
    "    0.075,\n",
    "    0.045,\n",
    "    footnote_1,\n",
    "    fontsize=8.2,\n",
    "    ha=\"left\",\n",
    "    va=\"bottom\",\n",
    ")\n",
    "\n",
    "\n",
    "fig.text(\n",
    "    0.075,\n",
    "    0.026,\n",
    "    footnote_2,\n",
    "    fontsize=8.2,\n",
    "    ha=\"left\",\n",
    "    va=\"bottom\",\n",
    ")\n",
    "\n",
    "\n",
    "fig.text(\n",
    "    0.075,\n",
    "    0.009,\n",
    "    footnote_3,\n",
    "    fontsize=8.2,\n",
    "    ha=\"left\",\n",
    "    va=\"bottom\",\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 16. LAYOUT\n",
    "# ============================================================\n",
    "\n",
    "fig.subplots_adjust(\n",
    "    left=0.38,\n",
    "    right=0.94,\n",
    "    top=0.89,\n",
    "    bottom=0.09,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 17. SAVE — NEW FILES ONLY\n",
    "# ============================================================\n",
    "\n",
    "PNG_PATH = (\n",
    "    FIG_DIR\n",
    "    /\n",
    "    \"Figure3_REVISED_AD_PD_Reactome_convergence.png\"\n",
    ")\n",
    "\n",
    "\n",
    "PDF_PATH = (\n",
    "    FIG_DIR\n",
    "    /\n",
    "    \"Figure3_REVISED_AD_PD_Reactome_convergence.pdf\"\n",
    ")\n",
    "\n",
    "\n",
    "SVG_PATH = (\n",
    "    FIG_DIR\n",
    "    /\n",
    "    \"Figure3_REVISED_AD_PD_Reactome_convergence.svg\"\n",
    ")\n",
    "\n",
    "\n",
    "DATA_PATH = (\n",
    "    FIG_DIR\n",
    "    /\n",
    "    \"Figure3_REVISED_AD_PD_Reactome_convergence_data.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "df.drop(\n",
    "    columns=[\n",
    "        \"_tier\",\n",
    "    ]\n",
    ").to_csv(\n",
    "    DATA_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "fig.savefig(\n",
    "    PNG_PATH,\n",
    "    dpi=600,\n",
    "    bbox_inches=\"tight\",\n",
    ")\n",
    "\n",
    "\n",
    "fig.savefig(\n",
    "    PDF_PATH,\n",
    "    bbox_inches=\"tight\",\n",
    ")\n",
    "\n",
    "\n",
    "fig.savefig(\n",
    "    SVG_PATH,\n",
    "    bbox_inches=\"tight\",\n",
    ")\n",
    "\n",
    "\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 18. REPORT\n",
    "# ============================================================\n",
    "\n",
    "n_sig_cells = int(\n",
    "    (\n",
    "        np.isfinite(\n",
    "            fdr_matrix\n",
    "        )\n",
    "        &\n",
    "        (\n",
    "            fdr_matrix\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "    ).sum()\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    + \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"REVISED FIGURE 3 COMPLETE\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPathways displayed:\",\n",
    "    len(df),\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Formal R2 representatives:\",\n",
    "    n_r2_display,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"R3 representatives:\",\n",
    "    n_r3_display,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Individual FDR<0.05 cells:\",\n",
    "    n_sig_cells,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nR3 global audit:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \" observed =\",\n",
    "    OBSERVED_R3,\n",
    ")\n",
    "\n",
    "print(\n",
    "    \" null median =\",\n",
    "    NULL_MEDIAN,\n",
    ")\n",
    "\n",
    "print(\n",
    "    \" null 95% interval =\",\n",
    "    (\n",
    "        NULL_LOW,\n",
    "        NULL_HIGH,\n",
    "    ),\n",
    ")\n",
    "\n",
    "print(\n",
    "    \" empirical P =\",\n",
    "    R3_EMPIRICAL_P,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSaved:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    PNG_PATH\n",
    ")\n",
    "\n",
    "print(\n",
    "    PDF_PATH\n",
    ")\n",
    "\n",
    "print(\n",
    "    SVG_PATH\n",
    ")\n",
    "\n",
    "print(\n",
    "    DATA_PATH\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 93\n",
    "# ============================================================\n",
    "# RETINA-ND — MULTIMODAL CANDIDATE / RANKING AUDIT\n",
    "#\n",
    "# PURPOSE\n",
    "# -------\n",
    "# 1. Recover the correct frozen multimodal evidence matrix.\n",
    "# 2. Recover the correct frozen unique-gene ranking.\n",
    "# 3. Reconcile:\n",
    "#       raw ocular evidence\n",
    "#       versus\n",
    "#       stricter multimodal evidence classes.\n",
    "# 4. Verify the leading candidate genes.\n",
    "# 5. Check ocular gene-level values are consistent across\n",
    "#    repeated brain cell-type rows.\n",
    "#\n",
    "# DOES NOT rerun any statistical model.\n",
    "# DOES NOT modify frozen outputs.\n",
    "# ============================================================\n",
    "\n",
    "from google.colab import drive\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. MOUNT DRIVE\n",
    "# ============================================================\n",
    "\n",
    "drive.mount(\n",
    "    \"/content/drive\",\n",
    "    force_remount=False,\n",
    ")\n",
    "\n",
    "MYDRIVE = Path(\n",
    "    \"/content/drive/MyDrive\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. LOCATE FROZEN INPUT FILES\n",
    "# ============================================================\n",
    "\n",
    "EVIDENCE_NAME = (\n",
    "    \"RETINA_ND_CORE_MULTIMODAL_\"\n",
    "    \"EVIDENCE_MATRIX_v3.csv.gz\"\n",
    ")\n",
    "\n",
    "RANKING_NAME = (\n",
    "    \"RETINA_ND_UNIQUE_GENE_\"\n",
    "    \"CANDIDATE_RANKING_v4.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "evidence_hits = list(\n",
    "    MYDRIVE.rglob(\n",
    "        EVIDENCE_NAME\n",
    "    )\n",
    ")\n",
    "\n",
    "ranking_hits = list(\n",
    "    MYDRIVE.rglob(\n",
    "        RANKING_NAME\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Evidence-matrix matches:\",\n",
    "    len(evidence_hits),\n",
    ")\n",
    "\n",
    "for p in evidence_hits:\n",
    "    print(\" \", p)\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nRanking matches:\",\n",
    "    len(ranking_hits),\n",
    ")\n",
    "\n",
    "for p in ranking_hits:\n",
    "    print(\" \", p)\n",
    "\n",
    "\n",
    "assert len(evidence_hits) >= 1, (\n",
    "    f\"Could not find {EVIDENCE_NAME}\"\n",
    ")\n",
    "\n",
    "assert len(ranking_hits) >= 1, (\n",
    "    f\"Could not find {RANKING_NAME}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. IDENTIFY THE CORRECT EVIDENCE MATRIX\n",
    "# ============================================================\n",
    "\n",
    "required_evidence = {\n",
    "\n",
    "    \"cell_type\",\n",
    "    \"gene_symbol\",\n",
    "\n",
    "    \"brain_AD_PD_same_direction\",\n",
    "    \"retina_expression\",\n",
    "\n",
    "    \"dual_ocular_nominal_support\",\n",
    "    \"dual_ocular_FDR_support\",\n",
    "\n",
    "    \"multimodal_directional_support\",\n",
    "    \"multimodal_nominal_support\",\n",
    "    \"multimodal_FDR_support\",\n",
    "\n",
    "    \"core_evidence_class\",\n",
    "\n",
    "    \"AD_retina_log2FC\",\n",
    "    \"AD_retina_pvalue\",\n",
    "    \"AD_retina_FDR\",\n",
    "\n",
    "    \"PD_AH_log2RFU_diff\",\n",
    "    \"PD_AH_pvalue\",\n",
    "    \"PD_AH_FDR\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "valid_evidence = []\n",
    "\n",
    "\n",
    "for path in evidence_hits:\n",
    "\n",
    "    try:\n",
    "\n",
    "        x = pd.read_csv(\n",
    "            path,\n",
    "            compression=\"gzip\",\n",
    "        )\n",
    "\n",
    "    except Exception:\n",
    "\n",
    "        continue\n",
    "\n",
    "\n",
    "    if not required_evidence.issubset(\n",
    "        x.columns\n",
    "    ):\n",
    "\n",
    "        continue\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nEvidence candidate:\",\n",
    "        path,\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \" rows:\",\n",
    "        len(x),\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \" genes:\",\n",
    "        x[\"gene_symbol\"].nunique(),\n",
    "    )\n",
    "\n",
    "\n",
    "    if len(x) == 59481:\n",
    "\n",
    "        valid_evidence.append(\n",
    "            (\n",
    "                path,\n",
    "                x,\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "assert len(valid_evidence) == 1, (\n",
    "    \"Could not identify exactly one frozen \"\n",
    "    \"59,481-row evidence matrix.\"\n",
    ")\n",
    "\n",
    "\n",
    "EVIDENCE_PATH, evidence = (\n",
    "    valid_evidence[0]\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nUsing VERIFIED evidence matrix:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    EVIDENCE_PATH\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. IDENTIFY MATCHING UNIQUE-GENE RANKING\n",
    "# ============================================================\n",
    "\n",
    "required_ranking = {\n",
    "\n",
    "    \"candidate_rank\",\n",
    "    \"gene_symbol\",\n",
    "    \"priority_group\",\n",
    "\n",
    "    \"best_evidence_class\",\n",
    "\n",
    "    \"n_class_A\",\n",
    "    \"n_class_B\",\n",
    "    \"n_class_C\",\n",
    "    \"n_class_D\",\n",
    "\n",
    "    \"n_brain_AD_PD_concordant_celltypes\",\n",
    "\n",
    "    \"AD_retina_log2FC\",\n",
    "    \"AD_retina_pvalue\",\n",
    "    \"AD_retina_FDR\",\n",
    "\n",
    "    \"PD_AH_log2RFU_diff\",\n",
    "    \"PD_AH_pvalue\",\n",
    "    \"PD_AH_FDR\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "valid_rankings = []\n",
    "\n",
    "\n",
    "for path in ranking_hits:\n",
    "\n",
    "    try:\n",
    "\n",
    "        x = pd.read_csv(\n",
    "            path\n",
    "        )\n",
    "\n",
    "    except Exception:\n",
    "\n",
    "        continue\n",
    "\n",
    "\n",
    "    if not required_ranking.issubset(\n",
    "        x.columns\n",
    "    ):\n",
    "\n",
    "        continue\n",
    "\n",
    "\n",
    "    x[\n",
    "        \"candidate_rank\"\n",
    "    ] = pd.to_numeric(\n",
    "        x[\n",
    "            \"candidate_rank\"\n",
    "        ],\n",
    "        errors=\"coerce\",\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nRanking candidate:\",\n",
    "        path,\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \" rows:\",\n",
    "        len(x),\n",
    "    )\n",
    "\n",
    "\n",
    "    top8 = (\n",
    "        x\n",
    "        .sort_values(\n",
    "            \"candidate_rank\"\n",
    "        )\n",
    "        .head(8)\n",
    "        [\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .str.upper()\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \" top 8:\",\n",
    "        top8,\n",
    "    )\n",
    "\n",
    "\n",
    "    expected_top8 = [\n",
    "\n",
    "        \"SCAMP5\",\n",
    "        \"XYLB\",\n",
    "        \"RABEPK\",\n",
    "        \"ITGAM\",\n",
    "        \"CD38\",\n",
    "        \"CTCF\",\n",
    "        \"UBTD2\",\n",
    "        \"NAPEPLD\",\n",
    "\n",
    "    ]\n",
    "\n",
    "\n",
    "    if top8 == expected_top8:\n",
    "\n",
    "        valid_rankings.append(\n",
    "            (\n",
    "                path,\n",
    "                x,\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "assert len(valid_rankings) == 1, (\n",
    "    \"Could not identify exactly one frozen ranking \"\n",
    "    \"with the expected leading eight candidates.\"\n",
    ")\n",
    "\n",
    "\n",
    "RANKING_PATH, ranking = (\n",
    "    valid_rankings[0]\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nUsing VERIFIED ranking:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    RANKING_PATH\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. STANDARDIZE TYPES\n",
    "# ============================================================\n",
    "\n",
    "CELL_TYPES = [\n",
    "\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "for df in [\n",
    "    evidence,\n",
    "    ranking,\n",
    "]:\n",
    "\n",
    "    df[\n",
    "        \"gene_symbol\"\n",
    "    ] = (\n",
    "        df[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .str.upper()\n",
    "        .str.strip()\n",
    "    )\n",
    "\n",
    "\n",
    "boolean_cols = [\n",
    "\n",
    "    \"brain_AD_PD_same_direction\",\n",
    "    \"retina_expression\",\n",
    "\n",
    "    \"dual_ocular_nominal_support\",\n",
    "    \"dual_ocular_FDR_support\",\n",
    "\n",
    "    \"multimodal_directional_support\",\n",
    "    \"multimodal_nominal_support\",\n",
    "    \"multimodal_FDR_support\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "for col in boolean_cols:\n",
    "\n",
    "    if col in evidence.columns:\n",
    "\n",
    "        evidence[\n",
    "            col\n",
    "        ] = (\n",
    "            evidence[\n",
    "                col\n",
    "            ]\n",
    "            .fillna(False)\n",
    "            .astype(bool)\n",
    "        )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. RAW OCULAR vs MULTIMODAL COUNTS\n",
    "# ============================================================\n",
    "\n",
    "rows = []\n",
    "\n",
    "\n",
    "for ct in CELL_TYPES:\n",
    "\n",
    "    x = evidence.loc[\n",
    "        evidence[\n",
    "            \"cell_type\"\n",
    "        ]\n",
    "        ==\n",
    "        ct\n",
    "    ].copy()\n",
    "\n",
    "\n",
    "    class_counts = (\n",
    "        x[\n",
    "            \"core_evidence_class\"\n",
    "        ]\n",
    "        .value_counts()\n",
    "        .to_dict()\n",
    "    )\n",
    "\n",
    "\n",
    "    row = {\n",
    "\n",
    "        \"cell_type\":\n",
    "            ct,\n",
    "\n",
    "        \"n_rows\":\n",
    "            len(x),\n",
    "\n",
    "        \"raw_dual_ocular_nominal\":\n",
    "            int(\n",
    "                x[\n",
    "                    \"dual_ocular_nominal_support\"\n",
    "                ].sum()\n",
    "            ),\n",
    "\n",
    "        \"raw_dual_ocular_FDR\":\n",
    "            int(\n",
    "                x[\n",
    "                    \"dual_ocular_FDR_support\"\n",
    "                ].sum()\n",
    "            ),\n",
    "\n",
    "        \"multimodal_directional\":\n",
    "            int(\n",
    "                x[\n",
    "                    \"multimodal_directional_support\"\n",
    "                ].sum()\n",
    "            ),\n",
    "\n",
    "        \"multimodal_nominal\":\n",
    "            int(\n",
    "                x[\n",
    "                    \"multimodal_nominal_support\"\n",
    "                ].sum()\n",
    "            ),\n",
    "\n",
    "        \"multimodal_FDR\":\n",
    "            int(\n",
    "                x[\n",
    "                    \"multimodal_FDR_support\"\n",
    "                ].sum()\n",
    "            ),\n",
    "\n",
    "        \"class_A\":\n",
    "            int(\n",
    "                class_counts.get(\n",
    "                    \"A_dual_ocular_FDR\",\n",
    "                    0,\n",
    "                )\n",
    "            ),\n",
    "\n",
    "        \"class_B\":\n",
    "            int(\n",
    "                class_counts.get(\n",
    "                    \"B_dual_ocular_nominal\",\n",
    "                    0,\n",
    "                )\n",
    "            ),\n",
    "\n",
    "        \"class_C\":\n",
    "            int(\n",
    "                class_counts.get(\n",
    "                    \"C_dual_ocular_directional\",\n",
    "                    0,\n",
    "                )\n",
    "            ),\n",
    "\n",
    "        \"class_D\":\n",
    "            int(\n",
    "                class_counts.get(\n",
    "                    \"D_single_ocular_FDR\",\n",
    "                    0,\n",
    "                )\n",
    "            ),\n",
    "\n",
    "    }\n",
    "\n",
    "\n",
    "    rows.append(\n",
    "        row\n",
    "    )\n",
    "\n",
    "\n",
    "audit_counts = pd.DataFrame(\n",
    "    rows\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    + \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"RAW OCULAR vs STRICT MULTIMODAL COUNTS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    audit_counts\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. VERIFY FROZEN EXPECTED COUNTS\n",
    "# ============================================================\n",
    "\n",
    "expected = pd.DataFrame(\n",
    "    {\n",
    "\n",
    "        \"cell_type\": [\n",
    "            \"Astro\",\n",
    "            \"Micro\",\n",
    "            \"OPC\",\n",
    "            \"Oligo\",\n",
    "        ],\n",
    "\n",
    "        \"raw_dual_ocular_nominal\": [\n",
    "            6,\n",
    "            10,\n",
    "            8,\n",
    "            9,\n",
    "        ],\n",
    "\n",
    "        \"multimodal_nominal\": [\n",
    "            4,\n",
    "            6,\n",
    "            3,\n",
    "            6,\n",
    "        ],\n",
    "\n",
    "        \"class_A\": [\n",
    "            0,\n",
    "            0,\n",
    "            0,\n",
    "            0,\n",
    "        ],\n",
    "\n",
    "        \"class_B\": [\n",
    "            4,\n",
    "            6,\n",
    "            3,\n",
    "            6,\n",
    "        ],\n",
    "\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "check = audit_counts.merge(\n",
    "    expected,\n",
    "    on=\"cell_type\",\n",
    "    suffixes=(\n",
    "        \"_observed\",\n",
    "        \"_expected\",\n",
    "    ),\n",
    ")\n",
    "\n",
    "\n",
    "for col in [\n",
    "\n",
    "    \"raw_dual_ocular_nominal\",\n",
    "    \"multimodal_nominal\",\n",
    "    \"class_A\",\n",
    "    \"class_B\",\n",
    "\n",
    "]:\n",
    "\n",
    "    obs = check[\n",
    "        f\"{col}_observed\"\n",
    "    ].to_numpy()\n",
    "\n",
    "    exp = check[\n",
    "        f\"{col}_expected\"\n",
    "    ].to_numpy()\n",
    "\n",
    "    assert np.array_equal(\n",
    "        obs,\n",
    "        exp,\n",
    "    ), (\n",
    "        f\"{col} mismatch:\\n\"\n",
    "        f\"observed={obs}\\n\"\n",
    "        f\"expected={exp}\"\n",
    "    )\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFROZEN OCULAR / MULTIMODAL COUNTS: VERIFIED\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. VERIFY CLASS LOGIC DIRECTLY\n",
    "# ============================================================\n",
    "\n",
    "# With zero multimodal FDR hits,\n",
    "# Class B should equal multimodal nominal support.\n",
    "\n",
    "class_B_mask = (\n",
    "    evidence[\n",
    "        \"core_evidence_class\"\n",
    "    ]\n",
    "    ==\n",
    "    \"B_dual_ocular_nominal\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    evidence.loc[\n",
    "        class_B_mask,\n",
    "        \"multimodal_nominal_support\",\n",
    "    ]\n",
    "    .all()\n",
    "), (\n",
    "    \"Found Class-B row without multimodal nominal support.\"\n",
    ")\n",
    "\n",
    "\n",
    "assert not evidence[\n",
    "    \"multimodal_FDR_support\"\n",
    "].any(), (\n",
    "    \"Unexpected multimodal FDR-supported row detected.\"\n",
    ")\n",
    "\n",
    "\n",
    "assert not (\n",
    "    evidence[\n",
    "        \"core_evidence_class\"\n",
    "    ]\n",
    "    ==\n",
    "    \"A_dual_ocular_FDR\"\n",
    ").any(), (\n",
    "    \"Unexpected Class-A row detected.\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Class hierarchy consistency: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. UNIQUE-GENE PRIORITY COUNTS\n",
    "# ============================================================\n",
    "\n",
    "priority_counts = (\n",
    "    ranking[\n",
    "        \"priority_group\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .rename_axis(\n",
    "        \"priority_group\"\n",
    "    )\n",
    "    .reset_index(\n",
    "        name=\"n_unique_genes\"\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    + \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"UNIQUE-GENE PRIORITY COUNTS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    priority_counts\n",
    ")\n",
    "\n",
    "\n",
    "expected_priority = {\n",
    "\n",
    "    \"P1_recurrent_dual_ocular_nominal\":\n",
    "        6,\n",
    "\n",
    "    \"P2_single_dual_ocular_nominal\":\n",
    "        2,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "for group, expected_n in (\n",
    "    expected_priority.items()\n",
    "):\n",
    "\n",
    "    observed_n = int(\n",
    "        priority_counts.loc[\n",
    "            priority_counts[\n",
    "                \"priority_group\"\n",
    "            ]\n",
    "            ==\n",
    "            group,\n",
    "            \"n_unique_genes\",\n",
    "        ].iloc[0]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert observed_n == expected_n, (\n",
    "        f\"{group}: expected {expected_n}, \"\n",
    "        f\"found {observed_n}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. VERIFY LEADING EIGHT CANDIDATES\n",
    "# ============================================================\n",
    "\n",
    "top8 = (\n",
    "    ranking\n",
    "    .sort_values(\n",
    "        \"candidate_rank\"\n",
    "    )\n",
    "    .head(8)\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "\n",
    "cols = [\n",
    "\n",
    "    \"candidate_rank\",\n",
    "    \"gene_symbol\",\n",
    "    \"priority_group\",\n",
    "\n",
    "    \"best_evidence_class\",\n",
    "\n",
    "    \"n_class_A\",\n",
    "    \"n_class_B\",\n",
    "    \"n_class_C\",\n",
    "    \"n_class_D\",\n",
    "\n",
    "    \"n_brain_AD_PD_concordant_celltypes\",\n",
    "\n",
    "    \"AD_retina_log2FC\",\n",
    "    \"AD_retina_pvalue\",\n",
    "    \"AD_retina_FDR\",\n",
    "\n",    "    \"PD_AH_log2RFU_diff\",\n",
    "    \"PD_AH_pvalue\",\n",
    "    \"PD_AH_FDR\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    + \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"LEADING MULTIMODAL CANDIDATES\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    top8[\n",
    "        cols\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "expected_top8 = [\n",
    "\n",
    "    \"SCAMP5\",\n",
    "    \"XYLB\",\n",
    "    \"RABEPK\",\n",
    "    \"ITGAM\",\n",
    "    \"CD38\",\n",
    "    \"CTCF\",\n",
    "    \"UBTD2\",\n",
    "    \"NAPEPLD\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "assert (\n",
    "    top8[\n",
    "        \"gene_symbol\"\n",
    "    ]\n",
    "    .tolist()\n",
    "    ==\n",
    "    expected_top8\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    top8\n",
    "    .iloc[\n",
    "        :6\n",
    "    ][\n",
    "        \"priority_group\"\n",
    "    ]\n",
    "    ==\n",
    "    \"P1_recurrent_dual_ocular_nominal\"\n",
    ").all()\n",
    "\n",
    "\n",
    "assert (\n",
    "    top8\n",
    "    .iloc[\n",
    "        6:8\n",
    "    ][\n",
    "        \"priority_group\"\n",
    "    ]\n",
    "    ==\n",
    "    \"P2_single_dual_ocular_nominal\"\n",
    ").all()\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nTop-eight hierarchy: VERIFIED\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. OCULAR GENE-LEVEL CONSISTENCY CHECK\n",
    "#\n",
    "# Ocular measurements repeat across brain cell-type rows.\n",
    "# They must not disagree for the same gene.\n",
    "# ============================================================\n",
    "\n",
    "ocular_cols = [\n",
    "\n",
    "    \"AD_retina_log2FC\",\n",
    "    \"AD_retina_pvalue\",\n",
    "    \"AD_retina_FDR\",\n",
    "\n",
    "    \"PD_AH_log2RFU_diff\",\n",
    "    \"PD_AH_pvalue\",\n",
    "    \"PD_AH_FDR\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "inconsistencies = []\n",
    "\n",
    "\n",
    "for gene, g in evidence.groupby(\n",
    "    \"gene_symbol\"\n",
    "):\n",
    "\n",
    "    for col in ocular_cols:\n",
    "\n",
    "        values = (\n",
    "            pd.to_numeric(\n",
    "                g[\n",
    "                    col\n",
    "                ],\n",
    "                errors=\"coerce\",\n",
    "            )\n",
    "            .dropna()\n",
    "            .unique()\n",
    "        )\n",
    "\n",
    "\n",
    "        # Gene-level ocular effect should be identical\n",
    "        # wherever repeated across brain cell-type rows.\n",
    "        if len(values) > 1:\n",
    "\n",
    "            inconsistencies.append(\n",
    "                {\n",
    "\n",
    "                    \"gene_symbol\":\n",
    "                        gene,\n",
    "\n",
    "                    \"column\":\n",
    "                        col,\n",
    "\n",
    "                    \"n_unique_values\":\n",
    "                        len(values),\n",
    "\n",
    "                    \"values\":\n",
    "                        \";\".join(\n",
    "                            map(\n",
    "                                str,\n",
    "                                values,\n",
    "                            )\n",
    "                        ),\n",
    "\n",
    "                }\n",
    "            )\n",
    "\n",
    "\n",
    "inconsistency_df = pd.DataFrame(\n",
    "    inconsistencies\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    + \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"OCULAR REPEATED-VALUE CONSISTENCY\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Inconsistent gene/ocular-variable combinations:\",\n",
    "    len(\n",
    "        inconsistency_df\n",
    "    ),\n",
    ")\n",
    "\n",
    "\n",
    "if len(\n",
    "    inconsistency_df\n",
    ") > 0:\n",
    "\n",
    "    display(\n",
    "        inconsistency_df.head(\n",
    "            30\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "assert len(\n",
    "    inconsistency_df\n",
    ") == 0, (\n",
    "    \"Ocular gene-level values are not identical \"\n",
    "    \"across repeated cell-type rows.\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Ocular gene-level replication across rows: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. TOP-20 FIGURE-4 INPUT QC\n",
    "# ============================================================\n",
    "\n",
    "top20 = (\n",
    "    ranking\n",
    "    .sort_values(\n",
    "        \"candidate_rank\"\n",
    "    )\n",
    "    .head(20)\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "\n",
    "top20_summary = top20[\n",
    "    [\n",
    "\n",
    "        \"candidate_rank\",\n",
    "        \"gene_symbol\",\n",
    "        \"priority_group\",\n",
    "        \"best_evidence_class\",\n",
    "\n",
    "        \"n_class_B\",\n",
    "        \"n_class_C\",\n",
    "        \"n_class_D\",\n",
    "\n",
    "        \"n_brain_AD_PD_concordant_celltypes\",\n",
    "\n",
    "        \"AD_retina_log2FC\",\n",
    "        \"AD_retina_pvalue\",\n",
    "        \"AD_retina_FDR\",\n",
    "\n",
    "        \"PD_AH_log2RFU_diff\",\n",
    "        \"PD_AH_pvalue\",\n",
    "        \"PD_AH_FDR\",\n",
    "\n",
    "    ]\n",
    "].copy()\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    + \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"TOP-20 FIGURE-4 INPUT TABLE\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    top20_summary\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 12. SAVE AUDIT TABLES\n",
    "# ============================================================\n",
    "\n",
    "ROOT = (\n",
    "    EVIDENCE_PATH\n",
    "    .parent\n",
    "    .parent\n",
    "    .parent\n",
    ")\n",
    "\n",
    "\n",
    "OUT_DIR = (\n",
    "    ROOT\n",
    "    / \"results\"\n",
    "    / \"final_evidence\"\n",
    ")\n",
    "\n",
    "\n",
    "COUNT_PATH = (\n",
    "    OUT_DIR\n",
    "    /\n",
    "    \"RETINA-ND_MULTIMODAL_COUNT_AUDIT_v1.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "TOP20_PATH = (\n",
    "    OUT_DIR\n",
    "    /\n",
    "    \"RETINA-ND_FIGURE4_TOP20_AUDIT_v1.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "audit_counts.to_csv(\n",
    "    COUNT_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "top20_summary.to_csv(\n",
    "    TOP20_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    + \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"RETINA-ND MULTIMODAL AUDIT COMPLETE\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nEvidence matrix:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    EVIDENCE_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nRanking:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    RANKING_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSaved:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    COUNT_PATH\n",
    ")\n",
    "\n",
    "print(\n",
    "    TOP20_PATH\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 94\n",
    "# ============================================================\n",
    "# RETINA-ND — REVISED PUBLICATION FIGURE 4\n",
    "#\n",
    "# PRIORITIZED AD–PD BRAIN-CONCORDANT GENES WITH\n",
    "# INDEPENDENT OCULAR SUPPORT\n",
    "#\n",
    "# Uses ONLY frozen:\n",
    "#   - multimodal evidence matrix v3\n",
    "#   - unique-gene ranking v4\n",
    "#\n",
    "# Does NOT rerun statistics.\n",
    "# Does NOT alter ranking.\n",
    "# Does NOT overwrite original Figure 4.\n",
    "# ============================================================\n",
    "\n",
    "from google.colab import drive\n",
    "from pathlib import Path\n",
    "from IPython.display import display\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "from matplotlib.colors import TwoSlopeNorm\n",
    "from matplotlib.gridspec import GridSpec\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. MOUNT DRIVE\n",
    "# ============================================================\n",
    "\n",
    "drive.mount(\n",
    "    \"/content/drive\",\n",
    "    force_remount=False,\n",
    ")\n",
    "\n",
    "MYDRIVE = Path(\n",
    "    \"/content/drive/MyDrive\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. FIND FROZEN INPUTS\n",
    "# ============================================================\n",
    "\n",
    "EVIDENCE_NAME = (\n",
    "    \"RETINA_ND_CORE_MULTIMODAL_\"\n",
    "    \"EVIDENCE_MATRIX_v3.csv.gz\"\n",
    ")\n",
    "\n",
    "RANKING_NAME = (\n",
    "    \"RETINA_ND_UNIQUE_GENE_\"\n",
    "    \"CANDIDATE_RANKING_v4.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "evidence_hits = list(\n",
    "    MYDRIVE.rglob(\n",
    "        EVIDENCE_NAME\n",
    "    )\n",
    ")\n",
    "\n",
    "ranking_hits = list(\n",
    "    MYDRIVE.rglob(\n",
    "        RANKING_NAME\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Evidence matches:\",\n",
    "    len(evidence_hits),\n",
    ")\n",
    "\n",
    "for p in evidence_hits:\n",
    "    print(\" \", p)\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nRanking matches:\",\n",
    "    len(ranking_hits),\n",
    ")\n",
    "\n",
    "for p in ranking_hits:\n",
    "    print(\" \", p)\n",
    "\n",
    "\n",
    "assert len(evidence_hits) >= 1\n",
    "assert len(ranking_hits) >= 1\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. IDENTIFY CORRECT EVIDENCE MATRIX\n",
    "# ============================================================\n",
    "\n",
    "required_evidence = {\n",
    "\n",
    "    \"cell_type\",\n",
    "    \"gene_symbol\",\n",
    "\n",
    "    \"log2FoldChange_AD\",\n",
    "    \"log2FoldChange_PD\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "valid_evidence = []\n",
    "\n",
    "\n",
    "for path in evidence_hits:\n",
    "\n",
    "    try:\n",
    "\n",
    "        x = pd.read_csv(\n",
    "            path,\n",
    "            compression=\"gzip\",\n",
    "        )\n",
    "\n",
    "    except Exception:\n",
    "\n",
    "        continue\n",
    "\n",
    "\n",
    "    if not required_evidence.issubset(\n",
    "        x.columns\n",
    "    ):\n",
    "        continue\n",
    "\n",
    "\n",
    "    if len(x) == 59481:\n",
    "\n",
    "        valid_evidence.append(\n",
    "            (\n",
    "                path,\n",
    "                x,\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "assert len(valid_evidence) == 1, (\n",
    "    \"Could not uniquely recover frozen \"\n",
    "    \"59,481-row evidence matrix.\"\n",
    ")\n",
    "\n",
    "\n",
    "EVIDENCE_PATH, evidence = (\n",
    "    valid_evidence[0]\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. IDENTIFY CORRECT RANKING\n",
    "# ============================================================\n",
    "\n",
    "required_ranking = {\n",
    "\n",
    "    \"candidate_rank\",\n",
    "    \"gene_symbol\",\n",
    "    \"priority_group\",\n",
    "    \"best_evidence_class\",\n",
    "\n",
    "    \"n_class_A\",\n",
    "    \"n_class_B\",\n",
    "    \"n_class_C\",\n",
    "    \"n_class_D\",\n",
    "\n",
    "    \"n_brain_AD_PD_concordant_celltypes\",\n",
    "\n",
    "    \"AD_retina_log2FC\",\n",
    "    \"AD_retina_pvalue\",\n",
    "    \"AD_retina_FDR\",\n",
    "\n",
    "    \"PD_AH_log2RFU_diff\",\n",
    "    \"PD_AH_pvalue\",\n",
    "    \"PD_AH_FDR\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "expected_top8 = [\n",
    "\n",
    "    \"SCAMP5\",\n",
    "    \"XYLB\",\n",
    "    \"RABEPK\",\n",
    "    \"ITGAM\",\n",
    "    \"CD38\",\n",
    "    \"CTCF\",\n",
    "    \"UBTD2\",\n",
    "    \"NAPEPLD\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "valid_rankings = []\n",
    "\n",
    "\n",
    "for path in ranking_hits:\n",
    "\n",
    "    try:\n",
    "\n",
    "        x = pd.read_csv(\n",
    "            path\n",
    "        )\n",
    "\n",
    "    except Exception:\n",
    "\n",
    "        continue\n",
    "\n",
    "\n",
    "    if not required_ranking.issubset(\n",
    "        x.columns\n",
    "    ):\n",
    "        continue\n",
    "\n",
    "\n",
    "    x[\n",
    "        \"candidate_rank\"\n",
    "    ] = pd.to_numeric(\n",
    "        x[\n",
    "            \"candidate_rank\"\n",
    "        ],\n",
    "        errors=\"coerce\",\n",
    "    )\n",
    "\n",
    "\n",
    "    top8 = (\n",
    "        x\n",
    "        .sort_values(\n",
    "            \"candidate_rank\"\n",
    "        )\n",
    "        .head(8)\n",
    "        [\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .str.upper()\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    if (\n",
    "        len(x) == 17745\n",
    "        and\n",
    "        top8 == expected_top8\n",
    "    ):\n",
    "\n",
    "        valid_rankings.append(\n",
    "            (\n",
    "                path,\n",
    "                x,\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "assert len(valid_rankings) == 1, (\n",
    "    \"Could not uniquely recover frozen \"\n",
    "    \"17,745-gene ranking.\"\n",
    ")\n",
    "\n",
    "\n",
    "RANKING_PATH, ranking = (\n",
    "    valid_rankings[0]\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nUsing:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    EVIDENCE_PATH\n",
    ")\n",
    "\n",
    "print(\n",
    "    RANKING_PATH\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. PROJECT ROOT / OUTPUT\n",
    "# ============================================================\n",
    "\n",
    "ROOT = (\n",
    "    EVIDENCE_PATH\n",
    "    .parent\n",
    "    .parent\n",
    "    .parent\n",
    ")\n",
    "\n",
    "\n",
    "FIG_DIR = (\n",
    "    ROOT\n",
    "    / \"results\"\n",
    "    / \"publication_figures\"\n",
    ")\n",
    "\n",
    "\n",
    "FIG_DIR.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. STANDARDIZE SYMBOLS\n",
    "# ============================================================\n",
    "\n",
    "for df in [\n",
    "    evidence,\n",
    "    ranking,\n",
    "]:\n",
    "\n",
    "    df[\n",
    "        \"gene_symbol\"\n",
    "    ] = (\n",
    "        df[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .str.upper()\n",
    "        .str.strip()\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. SELECT FROZEN TOP 20\n",
    "# ============================================================\n",
    "\n",
    "N_GENES = 20\n",
    "\n",
    "\n",
    "top = (\n",
    "    ranking\n",
    "    .sort_values(\n",
    "        \"candidate_rank\"\n",
    "    )\n",
    "    .head(\n",
    "        N_GENES\n",
    "    )\n",
    "    .copy()\n",
    "    .reset_index(\n",
    "        drop=True\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "genes = (\n",
    "    top[\n",
    "        \"gene_symbol\"\n",
    "    ]\n",
    "    .tolist()\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    genes[:8]\n",
    "    ==\n",
    "    expected_top8\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nTop 20:\"\n",
    ")\n",
    "\n",
    "display(\n",
    "    top[\n",
    "        [\n",
    "            \"candidate_rank\",\n",
    "            \"gene_symbol\",\n",
    "            \"priority_group\",\n",
    "            \"best_evidence_class\",\n",
    "            \"n_class_B\",\n",
    "            \"n_class_C\",\n",
    "            \"n_brain_AD_PD_concordant_celltypes\",\n",
    "        ]\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. VERIFY EXPECTED EVIDENCE TIERS\n",
    "# ============================================================\n",
    "\n",
    "assert (\n",
    "    top.loc[\n",
    "        0:5,\n",
    "        \"priority_group\",\n",
    "    ]\n",
    "    ==\n",
    "    \"P1_recurrent_dual_ocular_nominal\"\n",
    ").all()\n",
    "\n",
    "\n",
    "assert (\n",
    "    top.loc[\n",
    "        6:7,\n",
    "        \"priority_group\",\n",
    "    ]\n",
    "    ==\n",
    "    \"P2_single_dual_ocular_nominal\"\n",
    ").all()\n",
    "\n",
    "\n",
    "assert (\n",
    "    top.loc[\n",
    "        8:19,\n",
    "        \"priority_group\",\n",
    "    ]\n",
    "    ==\n",
    "    \"P3_recurrent_dual_ocular_directional\"\n",
    ").all()\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nTop-20 priority structure: VERIFIED\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. BRAIN MATRIX\n",
    "# ============================================================\n",
    "\n",
    "CELL_TYPES = [\n",
    "\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "brain = evidence.loc[\n",
    "    evidence[\n",
    "        \"gene_symbol\"\n",
    "    ]\n",
    "    .isin(\n",
    "        genes\n",
    "    )\n",
    "].copy()\n",
    "\n",
    "\n",
    "for col in [\n",
    "\n",
    "    \"log2FoldChange_AD\",\n",
    "    \"log2FoldChange_PD\",\n",
    "\n",
    "]:\n",
    "\n",
    "    brain[\n",
    "        col\n",
    "    ] = pd.to_numeric(\n",
    "        brain[\n",
    "            col\n",
    "        ],\n",
    "        errors=\"coerce\",\n",
    "    )\n",
    "\n",
    "\n",
    "duplicate_check = (\n",
    "    brain\n",
    "    .groupby(\n",
    "        [\n",
    "            \"gene_symbol\",\n",
    "            \"cell_type\",\n",
    "        ]\n",
    "    )\n",
    "    .size()\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    duplicate_check.max()\n",
    "    <=\n",
    "    1\n",
    "), (\n",
    "    \"Duplicate gene × cell-type rows found.\"\n",
    ")\n",
    "\n",
    "\n",
    "brain_columns = []\n",
    "\n",
    "brain_labels = []\n",
    "\n",
    "\n",
    "for ct in CELL_TYPES:\n",
    "\n",
    "    brain_columns.extend(\n",
    "        [\n",
    "            (\n",
    "                ct,\n",
    "                \"AD\",\n",
    "            ),\n",
    "            (\n",
    "                ct,\n",
    "                \"PD\",\n",
    "            ),\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    brain_labels.extend(\n",
    "        [\n",
    "            f\"{ct}\\nAD\",\n",
    "            f\"{ct}\\nPD\",\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "brain_matrix = np.full(\n",
    "    (\n",
    "        len(genes),\n",
    "        8,\n",
    "    ),\n",
    "    np.nan,\n",
    "    dtype=float,\n",
    ")\n",
    "\n",
    "\n",
    "for i, gene in enumerate(\n",
    "    genes\n",
    "):\n",
    "\n",
    "    g = brain.loc[\n",
    "        brain[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        ==\n",
    "        gene\n",
    "    ]\n",
    "\n",
    "\n",
    "    for j, (\n",
    "        ct,\n",
    "        disease,\n",
    "    ) in enumerate(\n",
    "        brain_columns\n",
    "    ):\n",
    "\n",
    "        q = g.loc[\n",
    "            g[\n",
    "                \"cell_type\"\n",
    "            ]\n",
    "            ==\n",
    "            ct\n",
    "        ]\n",
    "\n",
    "\n",
    "        if len(q) == 0:\n",
    "\n",
    "            continue\n",
    "\n",
    "\n",
    "        assert len(q) == 1\n",
    "\n",
    "\n",
    "        if disease == \"AD\":\n",
    "\n",
    "            value = q.iloc[\n",
    "                0\n",
    "            ][\n",
    "                \"log2FoldChange_AD\"\n",
    "            ]\n",
    "\n",
    "        else:\n",
    "\n",
    "            value = q.iloc[\n",
    "                0\n",
    "            ][\n",
    "                \"log2FoldChange_PD\"\n",
    "            ]\n",
    "\n",
    "\n",
    "        brain_matrix[\n",
    "            i,\n",
    "            j,\n",
    "        ] = value\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. OCULAR ARRAYS\n",
    "# ============================================================\n",
    "\n",
    "AD_RETINA = (\n",
    "    pd.to_numeric(\n",
    "        top[\n",
    "            \"AD_retina_log2FC\"\n",
    "        ],\n",
    "        errors=\"coerce\",\n",
    "    )\n",
    "    .to_numpy(\n",
    "        dtype=float\n",
    "    )\n",
    "    .reshape(\n",
    "        -1,\n",
    "        1,\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "PD_AQUEOUS = (\n",
    "    pd.to_numeric(\n",
    "        top[\n",
    "            \"PD_AH_log2RFU_diff\"\n",
    "        ],\n",
    "        errors=\"coerce\",\n",
    "    )\n",
    "    .to_numpy(\n",
    "        dtype=float\n",
    "    )\n",
    "    .reshape(\n",
    "        -1,\n",
    "        1,\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "AD_RETINA_P = pd.to_numeric(\n",
    "    top[\n",
    "        \"AD_retina_pvalue\"\n",
    "    ],\n",
    "    errors=\"coerce\",\n",
    ").to_numpy(\n",
    "    dtype=float\n",
    ")\n",
    "\n",
    "\n",
    "AD_RETINA_FDR = pd.to_numeric(\n",
    "    top[\n",
    "        \"AD_retina_FDR\"\n",
    "    ],\n",
    "    errors=\"coerce\",\n",
    ").to_numpy(\n",
    "    dtype=float\n",
    ")\n",
    "\n",
    "\n",
    "PD_AQUEOUS_P = pd.to_numeric(\n",
    "    top[\n",
    "        \"PD_AH_pvalue\"\n",
    "    ],\n",
    "    errors=\"coerce\",\n",    ").to_numpy(\n",
    "    dtype=float\n",
    ")\n",
    "\n",
    "\n",
    "PD_AQUEOUS_FDR = pd.to_numeric(\n",
    "    top[\n",
    "        \"PD_AH_FDR\"\n",
    "    ],\n",
    "    errors=\"coerce\",\n",
    ").to_numpy(\n",
    "    dtype=float\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. COLOR SCALE HELPER\n",
    "# ============================================================\n",
    "\n",
    "def symmetric_limit(\n",
    "    values,\n",
    "    percentile=100,\n",
    "    minimum=0.5,\n",
    "):\n",
    "\n",
    "    x = np.asarray(\n",
    "        values,\n",
    "        dtype=float,\n",
    "    )\n",
    "\n",
    "    x = x[\n",
    "        np.isfinite(\n",
    "            x\n",
    "        )\n",
    "    ]\n",
    "\n",
    "\n",
    "    assert len(x) > 0\n",
    "\n",
    "\n",
    "    limit = float(\n",
    "        np.percentile(\n",
    "            np.abs(\n",
    "                x\n",
    "            ),\n",
    "            percentile,\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    return max(\n",
    "        minimum,\n",
    "        limit,\n",
    "    )\n",
    "\n",
    "\n",
    "brain_limit = symmetric_limit(\n",
    "    brain_matrix,\n",
    "    percentile=97.5,\n",
    "    minimum=0.5,\n",
    ")\n",
    "\n",
    "\n",
    "ad_limit = symmetric_limit(\n",
    "    AD_RETINA,\n",
    "    percentile=100,\n",
    "    minimum=0.5,\n",
    ")\n",
    "\n",
    "\n",
    "pd_limit = symmetric_limit(\n",
    "    PD_AQUEOUS,\n",
    "    percentile=100,\n",
    "    minimum=0.5,\n",
    ")\n",
    "\n",
    "\n",
    "brain_norm = TwoSlopeNorm(\n",
    "    vmin=-brain_limit,\n",
    "    vcenter=0,\n",
    "    vmax=brain_limit,\n",
    ")\n",
    "\n",
    "\n",
    "ad_norm = TwoSlopeNorm(\n",
    "    vmin=-ad_limit,\n",
    "    vcenter=0,\n",
    "    vmax=ad_limit,\n",
    ")\n",
    "\n",
    "\n",
    "pd_norm = TwoSlopeNorm(\n",
    "    vmin=-pd_limit,\n",
    "    vcenter=0,\n",
    "    vmax=pd_limit,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. MISSING-VALUE-AWARE COLORMAPS\n",
    "# ============================================================\n",
    "\n",
    "brain_cmap = (\n",
    "    plt\n",
    "    .get_cmap(\n",
    "        \"RdBu_r\"\n",
    "    )\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "ad_cmap = (\n",
    "    plt\n",
    "    .get_cmap(\n",
    "        \"RdBu_r\"\n",
    "    )\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "pd_cmap = (\n",
    "    plt\n",
    "    .get_cmap(\n",
    "        \"RdBu_r\"\n",
    "    )\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "\n",
    "# Missing is deliberately NOT white.\n",
    "for cmap in [\n",
    "\n",
    "    brain_cmap,\n",
    "    ad_cmap,\n",
    "    pd_cmap,\n",
    "\n",
    "]:\n",
    "\n",
    "    cmap.set_bad(\n",
    "        \"#D9D9D9\"\n",
    "    )\n",
    "\n",
    "\n",
    "brain_masked = np.ma.masked_invalid(\n",
    "    brain_matrix\n",
    ")\n",
    "\n",
    "ad_masked = np.ma.masked_invalid(\n",
    "    AD_RETINA\n",
    ")\n",
    "\n",
    "pd_masked = np.ma.masked_invalid(\n",
    "    PD_AQUEOUS\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 12. FIGURE LAYOUT\n",
    "# ============================================================\n",
    "\n",
    "fig = plt.figure(\n",
    "    figsize=(\n",
    "        15.8,\n",
    "        10.8,\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "gs = GridSpec(\n",
    "    nrows=1,\n",
    "    ncols=7,\n",
    "\n",
    "    width_ratios=[\n",
    "\n",
    "        8.0,   # brain\n",
    "        0.22,  # brain colorbar\n",
    "\n",
    "        1.05,  # AD retina\n",
    "        0.22,  # AD colorbar\n",
    "\n",
    "        1.05,  # PD aqueous\n",
    "        0.22,  # PD colorbar\n",
    "\n",
    "        1.35,  # evidence tier\n",
    "\n",
    "    ],\n",
    "\n",
    "    wspace=0.20,\n",
    ")\n",
    "\n",
    "\n",
    "ax_brain = fig.add_subplot(\n",
    "    gs[\n",
    "        0,\n",
    "        0,\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "cax_brain = fig.add_subplot(\n",
    "    gs[\n",
    "        0,\n",
    "        1,\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "ax_ad = fig.add_subplot(\n",
    "    gs[\n",
    "        0,\n",
    "        2,\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "cax_ad = fig.add_subplot(\n",
    "    gs[\n",
    "        0,\n",
    "        3,\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "ax_pd = fig.add_subplot(\n",
    "    gs[\n",
    "        0,\n",
    "        4,\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "cax_pd = fig.add_subplot(\n",
    "    gs[\n",
    "        0,\n",
    "        5,\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "ax_evidence = fig.add_subplot(\n",
    "    gs[\n",
    "        0,\n",
    "        6,\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 13. PANEL A — BRAIN\n",
    "# ============================================================\n",
    "\n",
    "im_brain = ax_brain.imshow(\n",
    "\n",
    "    brain_masked,\n",
    "\n",
    "    aspect=\"auto\",\n",
    "    interpolation=\"nearest\",\n",
    "\n",
    "    cmap=brain_cmap,\n",
    "    norm=brain_norm,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "ax_brain.set_xticks(\n",
    "    np.arange(\n",
    "        8\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "ax_brain.set_xticklabels(\n",
    "    brain_labels,\n",
    "    fontsize=10,\n",
    "    fontweight=\"bold\",\n",
    ")\n",
    "\n",
    "\n",
    "ax_brain.set_yticks(\n",
    "    np.arange(\n",
    "        len(\n",
    "            genes\n",
    "        )\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# Deliberately remove numeric rank from the main gene labels.\n",
    "ax_brain.set_yticklabels(\n",
    "    genes,\n",
    "    fontsize=10,\n",
    ")\n",
    "\n",
    "\n",
    "# Highlight strongest full multimodal candidates.\n",
    "for i, label in enumerate(\n",
    "    ax_brain.get_yticklabels()\n",
    "):\n",
    "\n",
    "    if i < 8:\n",
    "\n",
    "        label.set_fontweight(\n",
    "            \"bold\"\n",
    "        )\n",
    "\n",
    "\n",
    "ax_brain.tick_params(\n",
    "\n",
    "    axis=\"x\",\n",
    "\n",
    "    top=True,\n",
    "    bottom=False,\n",
    "\n",
    "    labeltop=True,\n",
    "    labelbottom=False,\n",
    "\n",
    "    length=0,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "ax_brain.tick_params(\n",
    "\n",
    "    axis=\"y\",\n",
    "\n",
    "    length=0,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "for x in [\n",
    "\n",
    "    1.5,\n",
    "    3.5,\n",
    "    5.5,\n",
    "\n",
    "]:\n",
    "\n",
    "    ax_brain.axvline(\n",
    "\n",
    "        x,\n",
    "\n",
    "        color=\"white\",\n",
    "\n",
    "        linewidth=2.0,\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 14. OCULAR PANELS\n",
    "# ============================================================\n",
    "\n",
    "im_ad = ax_ad.imshow(\n",
    "\n",
    "    ad_masked,\n",
    "\n",
    "    aspect=\"auto\",\n",
    "    interpolation=\"nearest\",\n",
    "\n",
    "    cmap=ad_cmap,\n",
    "    norm=ad_norm,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "im_pd = ax_pd.imshow(\n",
    "\n",
    "    pd_masked,\n",
    "\n",
    "    aspect=\"auto\",\n",
    "    interpolation=\"nearest\",\n",
    "\n",
    "    cmap=pd_cmap,\n",
    "    norm=pd_norm,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "for ax, label in [\n",
    "\n",
    "    (\n",
    "        ax_ad,\n",
    "        \"AD retina\\nprotein\",\n",
    "    ),\n",
    "\n",
    "    (\n",
    "        ax_pd,\n",
    "        \"PD aqueous\\nprotein\",\n",
    "    ),\n",
    "\n",
    "]:\n",
    "\n",
    "    ax.set_xticks(\n",
    "        [\n",
    "            0\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    ax.set_xticklabels(\n",
    "        [\n",
    "            label\n",
    "        ],\n",
    "        fontsize=9.5,\n",
    "        fontweight=\"bold\",\n",
    "    )\n",
    "\n",
    "    ax.tick_params(\n",
    "\n",
    "        axis=\"x\",\n",
    "\n",
    "        top=True,\n",
    "        bottom=False,\n",
    "\n",
    "        labeltop=True,\n",
    "        labelbottom=False,\n",
    "\n",
    "        length=0,\n",
    "\n",
    "    )\n",
    "\n",
    "    ax.set_yticks(\n",
    "        np.arange(\n",
    "            len(\n",
    "                genes\n",
    "            )\n",
    "        )\n",
    "    )\n",
    "\n",
    "    ax.set_yticklabels(\n",
    "        []\n",
    "    )\n",
    "\n",
    "    ax.tick_params(\n",
    "\n",
    "        axis=\"y\",\n",
    "\n",
    "        length=0,\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 15. SIGNIFICANCE MARKERS\n",
    "#\n",
    "# *  nominal P < 0.05\n",
    "# ** FDR < 0.05\n",
    "# ============================================================\n",
    "\n",
    "def add_significance_markers(\n",
    "\n",
    "    ax,\n",
    "    values,\n",
    "    pvalues,\n",
    "    fdrs,\n",
    "    limit,\n",
    "\n",
    "):\n",
    "\n",
    "    for i in range(\n",
    "        len(\n",
    "            pvalues\n",
    "        )\n",
    "    ):\n",
    "\n",
    "        p = pvalues[\n",
    "            i\n",
    "        ]\n",
    "\n",
    "        fdr = fdrs[\n",
    "            i\n",
    "        ]\n",
    "\n",
    "        value = values[\n",
    "            i,\n",
    "            0\n",
    "        ]\n",
    "\n",
    "\n",
    "        marker = \"\"\n",
    "\n",
    "\n",
    "        if (\n",
    "            np.isfinite(\n",
    "                fdr\n",
    "            )\n",
    "            and\n",
    "            fdr < 0.05\n",
    "        ):\n",
    "\n",
    "            marker = \"**\"\n",
    "\n",
    "\n",
    "        elif (\n",
    "            np.isfinite(\n",
    "                p\n",
    "            )\n",
    "            and\n",
    "            p < 0.05\n",
    "        ):\n",
    "\n",
    "            marker = \"*\"\n",
    "\n",
    "\n",
    "        if marker:\n",
    "\n",
    "            text_color = (\n",
    "\n",
    "                \"white\"\n",
    "\n",
    "                if (\n",
    "                    np.isfinite(\n",
    "                        value\n",
    "                    )\n",
    "                    and\n",
    "                    abs(\n",
    "                        value\n",
    "                    )\n",
    "                    >\n",
    "                    (\n",
    "                        limit\n",
    "                        *\n",
    "                        0.52\n",
    "                    )\n",
    "                )\n",
    "\n",
    "                else\n",
    "\n",
    "                \"black\"\n",
    "\n",
    "            )\n",
    "\n",
    "\n",
    "            ax.text(\n",
    "\n",
    "                0,\n",
    "                i,\n",
    "\n",
    "                marker,\n",
    "\n",
    "                ha=\"center\",\n",
    "                va=\"center\",\n",
    "\n",
    "                fontsize=11,\n",
    "\n",
    "                fontweight=\"bold\",\n",
    "\n",
    "                color=text_color,\n",
    "\n",
    "            )\n",
    "\n",
    "\n",
    "add_significance_markers(\n",
    "\n",
    "    ax_ad,\n",
    "    AD_RETINA,\n",
    "    AD_RETINA_P,\n",
    "    AD_RETINA_FDR,\n",
    "    ad_limit,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "add_significance_markers(\n",
    "\n",
    "    ax_pd,\n",
    "    PD_AQUEOUS,\n",
    "    PD_AQUEOUS_P,\n",
    "    PD_AQUEOUS_FDR,\n",
    "    pd_limit,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 16. EXPLICIT NA LABELS\n",
    "# ============================================================\n",
    "\n",
    "for i in range(\n",
    "    len(\n",
    "        genes\n",
    "    )\n",
    "):\n",
    "\n",
    "    for j in range(\n",
    "        brain_matrix.shape[\n",
    "            1\n",
    "        ]\n",
    "    ):\n",
    "\n",
    "        if not np.isfinite(\n",
    "            brain_matrix[\n",
    "                i,\n",
    "                j,\n",
    "            ]\n",
    "        ):\n",
    "\n",
    "            ax_brain.text(\n",
    "\n",
    "                j,\n",
    "                i,\n",
    "\n",
    "                \"NA\",\n",
    "\n",
    "                ha=\"center\",\n",
    "                va=\"center\",\n",
    "\n",
    "                fontsize=6.5,\n",
    "\n",
    "            )\n",
    "\n",
    "\n",
    "    if not np.isfinite(\n",
    "        AD_RETINA[\n",
    "            i,\n",
    "            0,\n",
    "        ]\n",
    "    ):\n",
    "\n",
    "        ax_ad.text(\n",
    "\n",
    "            0,\n",
    "            i,\n",
    "\n",
    "            \"NA\",\n",
    "\n",
    "            ha=\"center\",\n",
    "            va=\"center\",\n",
    "\n",
    "            fontsize=7,\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "    if not np.isfinite(\n",
    "        PD_AQUEOUS[\n",
    "            i,\n",
    "            0,\n",
    "        ]\n",
    "    ):\n",
    "\n",
    "        ax_pd.text(\n",
    "\n",
    "            0,\n",
    "            i,\n",
    "\n",
    "            \"NA\",\n",
    "\n",
    "            ha=\"center\",\n",
    "            va=\"center\",\n",
    "\n",
    "            fontsize=7,\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 17. EVIDENCE-TIER COLUMN\n",
    "# ============================================================\n",
    "\n",
    "ax_evidence.set_xlim(\n",
    "    0,\n",
    "    1,\n",
    ")\n",
    "\n",
    "\n",
    "ax_evidence.set_ylim(\n",
    "    len(\n",
    "        genes\n",
    "    )\n",
    "    -\n",
    "    0.5,\n",
    "    -0.5,\n",
    ")\n",
    "\n",
    "\n",
    "ax_evidence.set_xticks([])\n",
    "ax_evidence.set_yticks([])\n",
    "\n",
    "\n",
    "for spine in (\n",
    "    ax_evidence\n",
    "    .spines\n",
    "    .values()\n",
    "):\n",
    "\n",
    "    spine.set_visible(\n",
    "        False\n",
    "    )\n",
    "\n",
    "\n",
    "def priority_short(\n",
    "    x\n",
    "):\n",
    "\n",
    "    return str(\n",
    "        x\n",
    "    ).split(\n",
    "        \"_\",\n",
    "        1,\n",
    "    )[0]\n",
    "\n",
    "\n",
    "def class_letter(\n",
    "    x\n",
    "):\n",
    "\n",
    "    return str(\n",
    "        x\n",
    "    ).split(\n",
    "        \"_\",\n",
    "        1,\n",
    "    )[0]\n",
    "\n",
    "\n",
    "for i, row in top.iterrows():\n",
    "\n",
    "    priority = priority_short(\n",
    "        row[\n",
    "            \"priority_group\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    cls = class_letter(\n",
    "        row[\n",
    "            \"best_evidence_class\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    if cls == \"A\":\n",
    "\n",
    "        n_cls = int(\n",
    "            row[\n",
    "                \"n_class_A\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "    elif cls == \"B\":\n",
    "\n",
    "        n_cls = int(\n",
    "            row[\n",
    "                \"n_class_B\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "    elif cls == \"C\":\n",
    "\n",
    "        n_cls = int(\n",
    "            row[\n",
    "                \"n_class_C\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "    elif cls == \"D\":\n",
    "\n",
    "        n_cls = int(\n",
    "            row[\n",
    "                \"n_class_D\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "    else:\n",
    "\n",
    "        n_cls = 0\n",
    "\n",
    "\n",
    "    text = (\n",
    "        f\"{priority}  |  \"\n",
    "        f\"{cls}×{n_cls}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    ax_evidence.text(\n",
    "\n",
    "        0.5,\n",
    "        i,\n",
    "\n",
    "        text,\n",
    "\n",
    "        ha=\"center\",\n",
    "        va=\"center\",\n",
    "\n",
    "        fontsize=8.7,\n",
    "\n",
    "        fontweight=(\n",
    "            \"bold\"\n",
    "            if i < 8\n",
    "            else\n",
    "            \"normal\"\n",
    "        ),\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "ax_evidence.set_title(\n",
    "\n",
    "    \"Priority | evidence\\nrecurrence\",\n",
    "\n",
    "    fontsize=9,\n",
    "\n",
    "    fontweight=\"bold\",\n",
    "\n",
    "    pad=14,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 18. ROW SEPARATORS\n",
    "# ============================================================\n",
    "\n",
    "for ax in [\n",
    "\n",
    "    ax_brain,\n",
    "    ax_ad,\n",
    "    ax_pd,\n",
    "    ax_evidence,\n",
    "\n",
    "]:\n",
    "\n",
    "    for y in np.arange(\n",
    "\n",
    "        0.5,\n",
    "\n",
    "        len(\n",
    "            genes\n",
    "        ),\n",
    "\n",
    "        1,\n",
    "\n",
    "    ):\n",
    "\n",
    "        ax.axhline(\n",
    "\n",
    "            y,\n",
    "\n",
    "            linewidth=0.30,\n",
    "\n",
    "            color=\"white\"\n",
    "            if ax is not ax_evidence\n",
    "            else\n",
    "            \"0.85\",\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "# Strong divider:\n",
    "# rows 1–8 = Class-B candidates\n",
    "# rows 9–20 = directional-only tier\n",
    "\n",
    "divider_y = (\n",
    "    8\n",
    "    -\n",
    "    0.5\n",
    ")\n",
    "\n",
    "\n",
    "for ax in [\n",
    "\n",
    "    ax_brain,\n",
    "    ax_ad,\n",
    "    ax_pd,\n",
    "    ax_evidence,\n",
    "\n",
    "]:\n",
    "\n",
    "    ax.axhline(\n",
    "\n",
    "        divider_y,\n",
    "\n",
    "        linewidth=2.4,\n",
    "\n",
    "        color=\"black\",\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 19. IDENTICAL Y LIMITS\n",
    "# ============================================================\n",
    "\n",
    "for ax in [\n",
    "\n",
    "    ax_brain,\n",
    "    ax_ad,\n",
    "    ax_pd,\n",
    "    ax_evidence,\n",
    "\n",
    "]:\n",
    "\n",
    "    ax.set_ylim(\n",
    "\n",
    "        len(\n",
    "            genes\n",
    "        )\n",
    "        -\n",
    "        0.5,\n",
    "\n",
    "        -0.5,\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 20. PANEL LABELS\n",
    "# ============================================================\n",
    "\n",
    "ax_brain.set_title(\n",
    "\n",
    "    \"A   Brain transcriptomic effects\",\n",
    "\n",
    "    loc=\"left\",\n",
    "\n",
    "    fontsize=13.5,\n",
    "\n",
    "    fontweight=\"bold\",\n",
    "\n",
    "    pad=42,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "ax_ad.set_title(\n",
    "\n",
    "    \"B\",\n",
    "\n",
    "    loc=\"left\",\n",
    "\n",
    "    fontsize=13.5,\n",
    "\n",
    "    fontweight=\"bold\",\n",
    "\n",
    "    pad=42,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "ax_pd.set_title(\n",
    "\n",
    "    \"C\",\n",
    "\n",
    "    loc=\"left\",\n",
    "\n",
    "    fontsize=13.5,\n",
    "\n",
    "    fontweight=\"bold\",\n",
    "\n",
    "    pad=42,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 21. COLORBARS\n",
    "# ============================================================\n",
    "\n",
    "brain_cb = fig.colorbar(\n",
    "\n",
    "    im_brain,\n",
    "\n",
    "    cax=cax_brain,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "brain_cb.set_label(\n",
    "\n",
    "    \"Brain\\nlog$_2$FC\",\n",
    "\n",
    "    fontsize=9,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "brain_cb.ax.tick_params(\n",
    "    labelsize=7.5\n",
    ")\n",
    "\n",
    "\n",
    "ad_cb = fig.colorbar(\n",
    "\n",
    "    im_ad,\n",
    "\n",
    "    cax=cax_ad,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "ad_cb.set_label(\n",
    "\n",
    "    \"AD retina\\nlog$_2$ effect\",\n",
    "\n",
    "    fontsize=8,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "ad_cb.ax.tick_params(\n",
    "    labelsize=7\n",
    ")\n",    "\n",
    "\n",
    "pd_cb = fig.colorbar(\n",
    "\n",
    "    im_pd,\n",
    "\n",
    "    cax=cax_pd,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "pd_cb.set_label(\n",
    "\n",
    "    \"PD aqueous\\nlog$_2$ RFU Δ\",\n",
    "\n",
    "    fontsize=8,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "pd_cb.ax.tick_params(\n",
    "    labelsize=7\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 22. TITLE / INTERPRETATION\n",
    "# ============================================================\n",
    "\n",
    "fig.suptitle(\n",
    "\n",
    "    (\n",
    "        \"Prioritized AD–PD brain-concordant genes \"\n",
    "        \"with independent ocular support\"\n",
    "    ),\n",
    "\n",
    "    fontsize=16,\n",
    "\n",
    "    fontweight=\"bold\",\n",
    "\n",
    "    y=0.985,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "fig.text(\n",
    "\n",
    "    0.075,\n",
    "    0.045,\n",
    "\n",
    "    (\n",
    "        \"Rows 1–8: Class-B candidates with nominal support \"\n",
    "        \"in both ocular datasets after the brain-concordance \"\n",
    "        \"and retinal-expression gates. \"\n",
    "        \"Rows 9–20: recurrent directional ocular support.\"\n",
    "    ),\n",
    "\n",
    "    fontsize=8.5,\n",
    "\n",
    "    ha=\"left\",\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "fig.text(\n",
    "\n",
    "    0.075,\n",
    "    0.027,\n",
    "\n",
    "    (\n",
    "        \"Ocular panels: * nominal P < 0.05; ** FDR < 0.05. \"\n",
    "        \"Gray/NA denotes unavailable measurement. \"\n",
    "        \"Each assay uses its own effect-size scale.\"\n",
    "    ),\n",
    "\n",
    "    fontsize=8.5,\n",
    "\n",
    "    ha=\"left\",\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "fig.text(\n",
    "\n",
    "    0.075,\n",
    "    0.009,\n",
    "\n",
    "    (\n",
    "        \"Ocular measurements provide independent supportive evidence \"\n",
    "        \"for prioritization; they are not formal biomarker validation.\"\n",
    "    ),\n",
    "\n",
    "    fontsize=8.5,\n",
    "\n",
    "    ha=\"left\",\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 23. LAYOUT\n",
    "# ============================================================\n",
    "\n",
    "fig.subplots_adjust(\n",
    "\n",
    "    left=0.16,\n",
    "    right=0.97,\n",
    "\n",
    "    top=0.89,\n",
    "    bottom=0.085,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 24. SAVE EXACT FIGURE DATA\n",
    "# ============================================================\n",
    "\n",
    "figure_data = top[\n",
    "    [\n",
    "\n",
    "        \"candidate_rank\",\n",
    "        \"gene_symbol\",\n",
    "        \"priority_group\",\n",
    "        \"best_evidence_class\",\n",
    "\n",
    "        \"n_class_A\",\n",
    "        \"n_class_B\",\n",
    "        \"n_class_C\",\n",
    "        \"n_class_D\",\n",
    "\n",
    "        \"n_brain_AD_PD_concordant_celltypes\",\n",
    "\n",
    "        \"AD_retina_log2FC\",\n",
    "        \"AD_retina_pvalue\",\n",
    "        \"AD_retina_FDR\",\n",
    "\n",
    "        \"PD_AH_log2RFU_diff\",\n",
    "        \"PD_AH_pvalue\",\n",
    "        \"PD_AH_FDR\",\n",
    "\n",
    "    ]\n",
    "].copy()\n",
    "\n",
    "\n",
    "for j, (\n",
    "    ct,\n",
    "    disease,\n",
    ") in enumerate(\n",
    "    brain_columns\n",
    "):\n",
    "\n",
    "    figure_data[\n",
    "        f\"{ct}_{disease}_log2FC\"\n",
    "    ] = brain_matrix[\n",
    "        :,\n",
    "        j,\n",
    "    ]\n",
    "\n",
    "\n",
    "DATA_PATH = (\n",
    "\n",
    "    FIG_DIR\n",
    "    /\n",
    "    \"Figure4_REVISED_multimodal_candidate_gene_support_data.csv\"\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "figure_data.to_csv(\n",
    "\n",
    "    DATA_PATH,\n",
    "\n",
    "    index=False,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 25. SAVE FIGURE — NEW FILES ONLY\n",
    "# ============================================================\n",
    "\n",
    "PNG_PATH = (\n",
    "\n",
    "    FIG_DIR\n",
    "    /\n",
    "    \"Figure4_REVISED_multimodal_candidate_gene_support.png\"\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "PDF_PATH = (\n",
    "\n",
    "    FIG_DIR\n",
    "    /\n",
    "    \"Figure4_REVISED_multimodal_candidate_gene_support.pdf\"\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "SVG_PATH = (\n",
    "\n",
    "    FIG_DIR\n",
    "    /\n",
    "    \"Figure4_REVISED_multimodal_candidate_gene_support.svg\"\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "fig.savefig(\n",
    "\n",
    "    PNG_PATH,\n",
    "\n",
    "    dpi=600,\n",
    "\n",
    "    bbox_inches=\"tight\",\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "fig.savefig(\n",
    "\n",
    "    PDF_PATH,\n",
    "\n",
    "    bbox_inches=\"tight\",\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "fig.savefig(\n",
    "\n",
    "    SVG_PATH,\n",
    "\n",
    "    bbox_inches=\"tight\",\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 26. REPORT\n",
    "# ============================================================\n",
    "\n",
    "n_ad_nominal = int(\n",
    "\n",
    "    (\n",
    "        np.isfinite(\n",
    "            AD_RETINA_P\n",
    "        )\n",
    "        &\n",
    "        (\n",
    "            AD_RETINA_P\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "    ).sum()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "n_ad_fdr = int(\n",
    "\n",
    "    (\n",
    "        np.isfinite(\n",
    "            AD_RETINA_FDR\n",
    "        )\n",
    "        &\n",
    "        (\n",
    "            AD_RETINA_FDR\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "    ).sum()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "n_pd_nominal = int(\n",
    "\n",
    "    (\n",
    "        np.isfinite(\n",
    "            PD_AQUEOUS_P\n",
    "        )\n",
    "        &\n",
    "        (\n",
    "            PD_AQUEOUS_P\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "    ).sum()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "n_pd_fdr = int(\n",
    "\n",
    "    (\n",
    "        np.isfinite(\n",
    "            PD_AQUEOUS_FDR\n",
    "        )\n",
    "        &\n",
    "        (\n",
    "            PD_AQUEOUS_FDR\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "    ).sum()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    + \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"REVISED FIGURE 4 COMPLETE\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nGenes displayed:\",\n",
    "    len(\n",
    "        genes\n",
    "    ),\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Class-B genes displayed:\",\n",
    "    8,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Directional-tier genes displayed:\",\n",
    "    12,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nAD retina:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \" nominal P<0.05:\",\n",
    "    n_ad_nominal,\n",
    ")\n",
    "\n",
    "print(\n",
    "    \" FDR<0.05:\",\n",
    "    n_ad_fdr,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPD aqueous:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \" nominal P<0.05:\",\n",
    "    n_pd_nominal,\n",
    ")\n",
    "\n",
    "print(\n",
    "    \" FDR<0.05:\",\n",
    "    n_pd_fdr,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSaved:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    PNG_PATH\n",
    ")\n",
    "\n",
    "print(\n",
    "    PDF_PATH\n",
    ")\n",
    "\n",
    "print(\n",
    "    SVG_PATH\n",
    ")\n",
    "\n",
    "print(\n",
    "    DATA_PATH\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 95\n",
    "# ============================================================\n",
    "# RETINA-ND — REVISED PUBLICATION FIGURE 5\n",
    "#\n",
    "# CANDIDATE × REACTOME PATHWAY MATRIX\n",
    "#\n",
    "# Replaces the visually misleading bipartite network.\n",
    "#\n",
    "# Filled circle:\n",
    "#   candidate occurs in a shared AD + PD leading edge\n",
    "#\n",
    "# Open circle:\n",
    "#   candidate occurs in the broader leading-edge union only\n",
    "#\n",
    "# Empty cell:\n",
    "#   no mapped connection to that selected R2/R3\n",
    "#   nonredundant pathway family\n",
    "#\n",
    "# SAFE AFTER COLAB RESTART.\n",
    "#\n",
    "# Does NOT rerun GSEA.\n",
    "# Does NOT alter frozen rankings.\n",
    "# Does NOT overwrite original Figure 5.\n",
    "# ============================================================\n",
    "\n",
    "from google.colab import drive\n",
    "from pathlib import Path\n",
    "from IPython.display import display\n",
    "\n",
    "import textwrap\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "from matplotlib.lines import Line2D\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. MOUNT DRIVE\n",
    "# ============================================================\n",
    "\n",
    "drive.mount(\n",
    "    \"/content/drive\",\n",
    "    force_remount=False,\n",
    ")\n",
    "\n",
    "MYDRIVE = Path(\n",
    "    \"/content/drive/MyDrive\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. FIND THE CORRECT FROZEN RANKING\n",
    "# ============================================================\n",
    "\n",
    "RANKING_NAME = (\n",
    "    \"RETINA_ND_UNIQUE_GENE_\"\n",
    "    \"CANDIDATE_RANKING_v4.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "ranking_hits = list(\n",
    "    MYDRIVE.rglob(\n",
    "        RANKING_NAME\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Ranking matches:\",\n",
    "    len(ranking_hits),\n",
    ")\n",
    "\n",
    "for p in ranking_hits:\n",
    "    print(\" \", p)\n",
    "\n",
    "\n",
    "assert len(ranking_hits) >= 1\n",
    "\n",
    "\n",
    "expected_top8 = [\n",
    "    \"SCAMP5\",\n",
    "    \"XYLB\",\n",
    "    \"RABEPK\",\n",
    "    \"ITGAM\",\n",
    "    \"CD38\",\n",
    "    \"CTCF\",\n",
    "    \"UBTD2\",\n",
    "    \"NAPEPLD\",\n",
    "]\n",
    "\n",
    "\n",
    "valid_rankings = []\n",
    "\n",
    "\n",
    "for path in ranking_hits:\n",
    "\n",
    "    try:\n",
    "        x = pd.read_csv(path)\n",
    "\n",
    "    except Exception:\n",
    "        continue\n",
    "\n",
    "\n",
    "    required = {\n",
    "        \"candidate_rank\",\n",
    "        \"gene_symbol\",\n",
    "        \"priority_group\",\n",
    "        \"best_evidence_class\",\n",
    "    }\n",
    "\n",
    "\n",
    "    if not required.issubset(\n",
    "        x.columns\n",
    "    ):\n",
    "        continue\n",
    "\n",
    "\n",
    "    x[\n",
    "        \"candidate_rank\"\n",
    "    ] = pd.to_numeric(\n",
    "        x[\n",
    "            \"candidate_rank\"\n",
    "        ],\n",
    "        errors=\"coerce\",\n",
    "    )\n",
    "\n",
    "\n",
    "    top8 = (\n",
    "        x\n",
    "        .sort_values(\n",
    "            \"candidate_rank\"\n",
    "        )\n",
    "        .head(8)\n",
    "        [\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .str.upper()\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    if (\n",
    "        len(x) == 17745\n",
    "        and\n",
    "        top8 == expected_top8\n",
    "    ):\n",
    "\n",
    "        valid_rankings.append(\n",
    "            (\n",
    "                path,\n",
    "                x,\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "assert len(valid_rankings) == 1, (\n",
    "    \"Could not uniquely identify the frozen \"\n",
    "    \"17,745-gene candidate ranking.\"\n",
    ")\n",
    "\n",
    "\n",
    "RANKING_PATH, ranking = (\n",
    "    valid_rankings[0]\n",
    ")\n",
    "\n",
    "\n",
    "FINAL_DIR = (\n",
    "    RANKING_PATH.parent\n",
    ")\n",
    "\n",
    "\n",
    "ROOT = (\n",
    "    FINAL_DIR\n",
    "    .parent\n",
    "    .parent\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nUsing project root:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    ROOT\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. COMPANION FROZEN FILES\n",
    "# ============================================================\n",
    "\n",
    "CANDIDATE_PATHWAY_PATH = (\n",
    "    FINAL_DIR\n",
    "    /\n",
    "    \"RETINA_ND_CANDIDATE_REACTOME_MAP_v5.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "REDUNDANCY_MAP_PATH = (\n",
    "    FINAL_DIR\n",
    "    /\n",
    "    \"RETINA_ND_REACTOME_REDUNDANCY_MAP_v6.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "REPRESENTATIVE_PATH = (\n",
    "    FINAL_DIR\n",
    "    /\n",
    "    \"RETINA_ND_REACTOME_NONREDUNDANT_REPRESENTATIVES_v6.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "    CANDIDATE_PATHWAY_PATH,\n",
    "    REDUNDANCY_MAP_PATH,\n",
    "    REPRESENTATIVE_PATH,\n",
    "]:\n",
    "\n",
    "    assert path.exists(), (\n",
    "        f\"Missing frozen Figure-5 input:\\n{path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "FIG_DIR = (\n",
    "    ROOT\n",
    "    / \"results\"\n",
    "    / \"publication_figures\"\n",
    ")\n",
    "\n",
    "\n",
    "FIG_DIR.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. LOAD\n",
    "# ============================================================\n",
    "\n",
    "candidate_map = pd.read_csv(\n",
    "    CANDIDATE_PATHWAY_PATH\n",
    ")\n",
    "\n",
    "\n",
    "redundancy = pd.read_csv(\n",
    "    REDUNDANCY_MAP_PATH\n",
    ")\n",
    "\n",
    "\n",
    "representatives = pd.read_csv(\n",
    "    REPRESENTATIVE_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFrozen inputs:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Ranked genes:\",\n",
    "    f\"{len(ranking):,}\",\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Candidate-pathway records:\",\n",
    "    f\"{len(candidate_map):,}\",\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Nonredundant representatives:\",\n",
    "    f\"{len(representatives):,}\",\n",
    ")\n",
    "\n",
    "\n",
    "# Verify original frozen file dimensions where known.\n",
    "\n",
    "assert len(\n",
    "    candidate_map\n",
    ") == 69297, (\n",
    "    \"Candidate-pathway map no longer matches \"\n",
    "    \"the frozen notebook.\"\n",
    ")\n",
    "\n",
    "assert len(\n",
    "    representatives\n",
    ") == 268, (\n",
    "    \"Representative table no longer matches \"\n",
    "    \"the frozen notebook.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. VERIFY REQUIRED COLUMNS\n",
    "# ============================================================\n",
    "\n",
    "required_candidate = {\n",
    "\n",
    "    \"gene_symbol\",\n",
    "    \"pathway\",\n",
    "    \"shared_AD_PD_leading_edge\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "required_redundancy = {\n",
    "\n",
    "    \"pathway\",\n",
    "    \"selected_representative\",\n",
    "    \"is_representative\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "required_rep = {\n",
    "\n",
    "    \"pathway\",\n",
    "    \"pathway_rank\",\n",
    "    \"priority_group\",\n",
    "    \"n_pathways_represented\",\n",
    "    \"n_convergent_FDR_celltypes\",\n",
    "    \"n_same_direction_celltypes\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "assert not (\n",
    "    required_candidate\n",
    "    -\n",
    "    set(\n",
    "        candidate_map.columns\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert not (\n",
    "    required_redundancy\n",
    "    -\n",
    "    set(\n",
    "        redundancy.columns\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert not (\n",
    "    required_rep\n",
    "    -\n",
    "    set(\n",
    "        representatives.columns\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. STANDARDIZE GENE SYMBOLS\n",
    "# ============================================================\n",
    "\n",
    "ranking[\n",
    "    \"gene_symbol\"\n",
    "] = (\n",
    "    ranking[\n",
    "        \"gene_symbol\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .str.upper()\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "\n",
    "candidate_map[\n",
    "    \"gene_symbol\"\n",
    "] = (\n",
    "    candidate_map[\n",
    "        \"gene_symbol\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .str.upper()\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. SELECT SAME FROZEN TOP 12 CANDIDATES\n",
    "# ============================================================\n",
    "\n",
    "N_GENES = 12\n",
    "\n",
    "\n",
    "top_genes = (\n",
    "    ranking\n",
    "    .sort_values(\n",
    "        \"candidate_rank\"\n",
    "    )\n",
    "    .head(\n",
    "        N_GENES\n",
    "    )\n",
    "    .copy()\n",
    "    .reset_index(\n",
    "        drop=True\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "selected_genes = (\n",
    "    top_genes[\n",
    "        \"gene_symbol\"\n",
    "    ]\n",
    "    .tolist()\n",
    ")\n",
    "\n",
    "\n",
    "expected_top12 = [\n",
    "\n",
    "    \"SCAMP5\",\n",
    "    \"XYLB\",\n",
    "    \"RABEPK\",\n",
    "    \"ITGAM\",\n",
    "    \"CD38\",\n",
    "    \"CTCF\",\n",
    "\n",
    "    \"UBTD2\",\n",
    "    \"NAPEPLD\",\n",
    "\n",
    "    \"GAPDH\",\n",
    "    \"STX1B\",\n",
    "    \"NDUFB10\",\n",
    "    \"NT5C\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "assert (\n",
    "    selected_genes\n",
    "    ==\n",
    "    expected_top12\n",
    "), (\n",
    "    \"Top-12 frozen ranking changed.\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSelected genes:\"\n",
    ")\n",
    "\n",
    "display(\n",
    "    top_genes[\n",
    "        [\n",
    "            \"candidate_rank\",\n",
    "            \"gene_symbol\",\n",
    "            \"priority_group\",\n",
    "            \"best_evidence_class\",\n",
    "        ]\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. RECONSTRUCT ORIGINAL R2/R3 FAMILY MAPPING\n",
    "# ============================================================\n",
    "\n",
    "edge_source = candidate_map.loc[\n",
    "    candidate_map[\n",
    "        \"gene_symbol\"\n",
    "    ]\n",
    "    .isin(\n",
    "        selected_genes\n",
    "    )\n",
    "].copy()\n",
    "\n",
    "\n",
    "edge_source = edge_source.merge(\n",
    "\n",
    "    redundancy[\n",
    "        [\n",
    "            \"pathway\",\n",
    "            \"selected_representative\",\n",
    "        ]\n",
    "    ],\n",
    "\n",
    "    on=\"pathway\",\n",
    "\n",
    "    how=\"inner\",\n",
    "\n",
    "    validate=\"many_to_one\",\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nOriginal candidate-pathway rows retained \"\n",
    "    \"inside R2/R3 redundancy pool:\",\n",
    "    len(\n",
    "        edge_source\n",
    "    ),\n",
    ")\n",
    "\n",
    "\n",
    "# Frozen notebook reported 16 before redundant\n",
    "# pathway terms were collapsed.\n",
    "\n",
    "assert len(\n",
    "    edge_source\n",
    ") == 16, (\n",
    "    \"R2/R3 candidate mapping no longer reproduces \"\n",
    "    \"the frozen Figure-5 source.\"\n",
    ")\n",
    "\n",
    "\n",
    "edge_source[\n",
    "    \"shared_AD_PD_leading_edge\"\n",
    "] = (\n",
    "    edge_source[\n",
    "        \"shared_AD_PD_leading_edge\"\n",
    "    ]\n",
    "    .fillna(False)\n",
    "    .astype(bool)\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. COLLAPSE REDUNDANT PATHWAY TERMS\n",
    "# ============================================================\n",
    "\n",
    "edges = (\n",
    "\n",
    "    edge_source\n",
    "\n",
    "    .groupby(\n",
    "        [\n",
    "            \"gene_symbol\",\n",
    "            \"selected_representative\",\n",
    "        ],\n",
    "        as_index=False,\n",
    "    )\n",
    "\n",
    "    .agg(\n",
    "\n",
    "        shared_AD_PD_leading_edge=(\n",
    "            \"shared_AD_PD_leading_edge\",\n",
    "            \"max\",\n",
    "        ),\n",
    "\n",
    "        n_original_pathway_links=(\n",
    "            \"pathway\",\n",
    "            \"nunique\",\n",
    "        ),\n",
    "\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "edges = edges.rename(\n",
    "\n",
    "    columns={\n",
    "\n",
    "        \"selected_representative\":\n",
    "            \"pathway\",\n",
    "\n",
    "    }\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. ADD REPRESENTATIVE-PATHWAY INFORMATION\n",
    "# ============================================================\n",
    "\n",
    "rep_info = representatives[\n",
    "    [\n",
    "        \"pathway\",\n",
    "        \"pathway_rank\",\n",
    "        \"priority_group\",\n",
    "        \"n_pathways_represented\",\n",
    "        \"n_convergent_FDR_celltypes\",\n",
    "        \"n_same_direction_celltypes\",\n",
    "    ]\n",
    "].copy()\n",
    "\n",
    "\n",
    "edges = edges.merge(\n",
    "\n",
    "    rep_info,\n",
    "\n",
    "    on=\"pathway\",\n",
    "\n",
    "    how=\"left\",\n",
    "\n",
    "    validate=\"many_to_one\",\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert edges[\n",    "    \"pathway_rank\"\n",
    "].notna().all()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. REPRODUCE ORIGINAL PATHWAY-SELECTION RULE\n",
    "# ============================================================\n",
    "\n",
    "pathway_connection_summary = (\n",
    "\n",
    "    edges\n",
    "\n",
    "    .groupby(\n",
    "        \"pathway\",\n",
    "        as_index=False,\n",
    "    )\n",
    "\n",
    "    .agg(\n",
    "\n",
    "        n_selected_genes=(\n",
    "            \"gene_symbol\",\n",
    "            \"nunique\",\n",
    "        ),\n",
    "\n",
    "        n_shared_AD_PD_genes=(\n",
    "            \"shared_AD_PD_leading_edge\",\n",
    "            \"sum\",\n",
    "        ),\n",
    "\n",
    "        pathway_rank=(\n",
    "            \"pathway_rank\",\n",
    "            \"first\",\n",
    "        ),\n",
    "\n",
    "        priority_group=(\n",
    "            \"priority_group\",\n",
    "            \"first\",\n",
    "        ),\n",
    "\n",
    "        n_pathways_represented=(\n",
    "            \"n_pathways_represented\",\n",
    "            \"first\",\n",
    "        ),\n",
    "\n",
    "        n_convergent_FDR_celltypes=(\n",
    "            \"n_convergent_FDR_celltypes\",\n",
    "            \"first\",\n",
    "        ),\n",
    "\n",
    "        n_same_direction_celltypes=(\n",
    "            \"n_same_direction_celltypes\",\n",
    "            \"first\",\n",
    "        ),\n",
    "\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "pathway_connection_summary = (\n",
    "\n",
    "    pathway_connection_summary\n",
    "\n",
    "    .sort_values(\n",
    "\n",
    "        [\n",
    "            \"n_selected_genes\",\n",
    "            \"n_shared_AD_PD_genes\",\n",
    "            \"pathway_rank\",\n",
    "        ],\n",
    "\n",
    "        ascending=[\n",
    "            False,\n",
    "            False,\n",
    "            True,\n",
    "        ],\n",
    "\n",
    "    )\n",
    "\n",
    "    .reset_index(\n",
    "        drop=True\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "N_PATHWAYS = min(\n",
    "\n",
    "    12,\n",
    "\n",
    "    len(\n",
    "        pathway_connection_summary\n",
    "    ),\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "selected_pathways_df = (\n",
    "\n",
    "    pathway_connection_summary\n",
    "\n",
    "    .head(\n",
    "        N_PATHWAYS\n",
    "    )\n",
    "\n",
    "    .copy()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "selected_pathways = (\n",
    "    selected_pathways_df[\n",
    "        \"pathway\"\n",
    "    ]\n",
    "    .tolist()\n",
    ")\n",
    "\n",
    "\n",
    "plot_edges = edges.loc[\n",
    "    edges[\n",
    "        \"pathway\"\n",
    "    ]\n",
    "    .isin(\n",
    "        selected_pathways\n",
    "    )\n",
    "].copy()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. HARD REPRODUCTION CHECK\n",
    "#\n",
    "# Do NOT draw a new figure unless we first reproduce\n",
    "# the exact old frozen Figure-5 content.\n",
    "# ============================================================\n",
    "\n",
    "connected_genes = set(\n",
    "    plot_edges[\n",
    "        \"gene_symbol\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "unconnected = [\n",
    "\n",
    "    gene\n",
    "\n",
    "    for gene in selected_genes\n",
    "\n",
    "    if gene not in connected_genes\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "EXPECTED_UNCONNECTED = [\n",
    "\n",
    "    \"SCAMP5\",\n",
    "    \"RABEPK\",\n",
    "    \"UBTD2\",\n",
    "    \"NAPEPLD\",\n",
    "    \"STX1B\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "assert len(\n",
    "    selected_genes\n",
    ") == 12\n",
    "\n",
    "\n",
    "assert len(\n",
    "    selected_pathways\n",
    ") == 9, (\n",
    "    f\"Expected 9 pathway families; \"\n",
    "    f\"found {len(selected_pathways)}\"\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    plot_edges\n",
    ") == 10, (\n",
    "    f\"Expected 10 collapsed displayed links; \"\n",
    "    f\"found {len(plot_edges)}\"\n",
    ")\n",
    "\n",
    "\n",
    "assert int(\n",
    "    plot_edges[\n",
    "        \"shared_AD_PD_leading_edge\"\n",
    "    ].sum()\n",
    ") == 5, (\n",
    "    \"Expected 5 shared AD-PD leading-edge links.\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    unconnected\n",
    "    ==\n",
    "    EXPECTED_UNCONNECTED\n",
    "), (\n",
    "    f\"Unconnected-gene list changed:\\n\"\n",
    "    f\"{unconnected}\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    + \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"ORIGINAL FIGURE-5 DATA REPRODUCED EXACTLY\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Candidate genes:\",\n",
    "    len(\n",
    "        selected_genes\n",
    "    ),\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Pathway families:\",\n",
    "    len(\n",
    "        selected_pathways\n",
    "    ),\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Displayed links:\",\n",
    "    len(\n",
    "        plot_edges\n",
    "    ),\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Shared AD-PD leading-edge links:\",\n",
    "    int(\n",
    "        plot_edges[\n",
    "            \"shared_AD_PD_leading_edge\"\n",
    "        ].sum()\n",
    "    ),\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Genes without selected R2/R3 family link:\",\n",
    "    unconnected,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 12. PREPARE MATRIX\n",
    "#\n",
    "# 0 = no link\n",
    "# 1 = broader leading-edge-union link\n",
    "# 2 = shared AD + PD leading-edge link\n",
    "# ============================================================\n",
    "\n",
    "n_pathways = len(\n",
    "    selected_pathways\n",
    ")\n",
    "\n",
    "n_genes = len(\n",
    "    selected_genes\n",
    ")\n",
    "\n",
    "\n",
    "link_matrix = np.zeros(\n",
    "    (\n",
    "        n_pathways,\n",
    "        n_genes,\n",
    "    ),\n",
    "    dtype=int,\n",
    ")\n",
    "\n",
    "\n",
    "original_link_counts = np.zeros(\n",
    "    (\n",
    "        n_pathways,\n",
    "        n_genes,\n",
    "    ),\n",
    "    dtype=int,\n",
    ")\n",
    "\n",
    "\n",
    "pathway_index = {\n",
    "\n",
    "    pathway:\n",
    "        i\n",
    "\n",
    "    for i, pathway\n",
    "    in enumerate(\n",
    "        selected_pathways\n",
    "    )\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "gene_index = {\n",
    "\n",
    "    gene:\n",
    "        j\n",
    "\n",
    "    for j, gene\n",
    "    in enumerate(\n",
    "        selected_genes\n",
    "    )\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "for row in plot_edges.itertuples(\n",
    "    index=False\n",
    "):\n",
    "\n",
    "    i = pathway_index[\n",
    "        row.pathway\n",
    "    ]\n",
    "\n",
    "    j = gene_index[\n",
    "        row.gene_symbol\n",
    "    ]\n",
    "\n",
    "\n",
    "    link_matrix[\n",
    "        i,\n",
    "        j\n",
    "    ] = (\n",
    "        2\n",
    "        if bool(\n",
    "            row.shared_AD_PD_leading_edge\n",
    "        )\n",
    "        else\n",
    "        1\n",
    "    )\n",
    "\n",
    "\n",
    "    original_link_counts[\n",
    "        i,\n",
    "        j\n",
    "    ] = int(\n",
    "        row.n_original_pathway_links\n",
    "    )\n",
    "\n",
    "\n",
    "assert int(\n",
    "    (\n",
    "        link_matrix > 0\n",
    "    ).sum()\n",
    ") == 10\n",
    "\n",
    "\n",
    "assert int(\n",
    "    (\n",
    "        link_matrix == 2\n",
    "    ).sum()\n",
    ") == 5\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 13. DISPLAY-LABEL HELPERS\n",
    "# ============================================================\n",
    "\n",
    "DISPLAY_REPLACEMENTS = {\n",
    "\n",
    "    \"SARS-CoV-1 modulates host translation machinery\":\n",
    "        \"Host translation machinery\",\n",
    "\n",
    "    \"SARS-CoV-2-host interactions\":\n",
    "        \"Host interaction / stress-response machinery\",\n",
    "\n",
    "    \"Vif-mediated degradation of APOBEC3G\":\n",
    "        \"Proteasome-dependent protein degradation\",\n",
    "\n",
    "    \"Constitutive Signaling by Aberrant PI3K in Cancer\":\n",
    "        \"PI3K signaling\",\n",
    "\n",
    "    \"Diseases associated with the TLR signaling cascade\":\n",
    "        \"TLR signaling\",\n",
    "\n",
    "    \"Major pathway of rRNA processing in the nucleolus and cytosol\":\n",
    "        \"rRNA processing\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "def pathway_label(\n",
    "    x\n",
    "):\n",
    "\n",
    "    x = str(\n",
    "        x\n",
    "    )\n",
    "\n",
    "\n",
    "    x = DISPLAY_REPLACEMENTS.get(\n",
    "        x,\n",
    "        x,\n",
    "    )\n",
    "\n",
    "\n",
    "    return textwrap.fill(\n",
    "\n",
    "        x,\n",
    "\n",
    "        width=42,\n",
    "\n",
    "        break_long_words=False,\n",
    "\n",
    "        break_on_hyphens=False,\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "def compact_priority(\n",
    "    x\n",
    "):\n",
    "\n",
    "    return str(\n",
    "        x\n",
    "    ).split(\n",
    "        \"_\",\n",
    "        1,\n",
    "    )[0]\n",
    "\n",
    "\n",
    "gene_priorities = [\n",
    "\n",
    "    compact_priority(\n",
    "        x\n",
    "    )\n",
    "\n",
    "    for x in top_genes[\n",
    "        \"priority_group\"\n",
    "    ]\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "gene_labels = []\n",
    "\n",
    "\n",
    "for gene, priority in zip(\n",
    "    selected_genes,\n",
    "    gene_priorities,\n",
    "):\n",
    "\n",
    "    dagger = (\n",
    "        \"†\"\n",
    "        if gene in unconnected\n",
    "        else\n",
    "        \"\"\n",
    "    )\n",
    "\n",
    "\n",
    "    gene_labels.append(\n",
    "        f\"{gene}{dagger}\\n{priority}\"\n",
    "    )\n",
    "\n",
    "\n",
    "pathway_labels = [\n",
    "\n",
    "    pathway_label(\n",
    "        pathway\n",
    "    )\n",
    "\n",
    "    for pathway in selected_pathways\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 14. CREATE MATRIX FIGURE\n",
    "# ============================================================\n",
    "\n",
    "fig, ax = plt.subplots(\n",
    "\n",
    "    figsize=(\n",
    "        15.5,\n",
    "        8.8,\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# Extra room on right for pathway annotations.\n",
    "ax.set_xlim(\n",
    "\n",
    "    -0.5,\n",
    "    n_genes + 1.75,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "ax.set_ylim(\n",
    "\n",
    "    n_pathways - 0.5,\n",
    "    -0.5,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 15. GRID\n",
    "# ============================================================\n",
    "\n",
    "for x in np.arange(\n",
    "    -0.5,\n",
    "    n_genes + 0.5,\n",
    "    1,\n",
    "):\n",
    "\n",
    "    ax.axvline(\n",
    "\n",
    "        x,\n",
    "\n",
    "        linewidth=0.6,\n",
    "\n",
    "        color=\"0.88\",\n",
    "\n",
    "        zorder=0,\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "for y in np.arange(\n",
    "    -0.5,\n",
    "    n_pathways + 0.5,\n",
    "    1,\n",
    "):\n",
    "\n",
    "    ax.axhline(\n",
    "\n",
    "        y,\n",
    "\n",
    "        linewidth=0.6,\n",
    "\n",
    "        color=\"0.88\",\n",
    "\n",
    "        zorder=0,\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "# Strong divider between Class-B candidate block\n",
    "# (first eight genes) and Class-C directional block.\n",
    "\n",
    "ax.axvline(\n",
    "\n",
    "    7.5,\n",
    "\n",
    "    linewidth=2.0,\n",
    "\n",
    "    color=\"black\",\n",
    "\n",
    "    zorder=1,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# Divider before pathway metadata.\n",
    "\n",
    "ax.axvline(\n",
    "\n",
    "    n_genes - 0.5,\n",
    "\n",
    "    linewidth=1.5,\n",
    "\n",
    "    color=\"black\",\n",
    "\n",
    "    zorder=1,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 16. DRAW CONNECTION SYMBOLS\n",
    "# ============================================================\n",
    "\n",
    "for i in range(\n",
    "    n_pathways\n",
    "):\n",
    "\n",
    "    for j in range(\n",
    "        n_genes\n",
    "    ):\n",
    "\n",
    "        value = link_matrix[\n",
    "            i,\n",
    "            j\n",
    "        ]\n",
    "\n",
    "\n",
    "        if value == 0:\n",
    "\n",
    "            continue\n",
    "\n",
    "\n",
    "        if value == 2:\n",
    "\n",
    "            # Shared AD + PD leading edge.\n",
    "            ax.scatter(\n",
    "\n",
    "                j,\n",
    "                i,\n",
    "\n",
    "                s=115,\n",
    "\n",
    "                marker=\"o\",\n",
    "\n",
    "                facecolors=\"black\",\n",
    "                edgecolors=\"black\",\n",
    "\n",
    "                linewidths=1.2,\n",
    "\n",
    "                zorder=3,\n",
    "\n",
    "            )\n",
    "\n",
    "\n",
    "        elif value == 1:\n",
    "\n",
    "            # Broader leading-edge union only.\n",
    "            ax.scatter(\n",
    "\n",
    "                j,\n",
    "                i,\n",
    "\n",
    "                s=115,\n",
    "\n",
    "                marker=\"o\",\n",
    "\n",
    "                facecolors=\"none\",\n",
    "                edgecolors=\"black\",\n",
    "\n",
    "                linewidths=1.5,\n",
    "\n",
    "                zorder=3,\n",
    "\n",
    "            )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 17. AXIS LABELS\n",
    "# ============================================================\n",
    "\n",
    "ax.set_xticks(\n",
    "    np.arange(\n",
    "        n_genes\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "ax.set_xticklabels(\n",
    "\n",
    "    gene_labels,\n",
    "\n",
    "    fontsize=9.4,\n",
    "\n",
    "    rotation=45,\n",
    "\n",
    "    ha=\"left\",\n",
    "\n",
    "    rotation_mode=\"anchor\",\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "ax.xaxis.tick_top()\n",
    "\n",
    "\n",
    "ax.tick_params(\n",
    "\n",
    "    axis=\"x\",\n",
    "\n",
    "    length=0,\n",
    "\n",
    "    pad=10,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "ax.set_yticks(\n",
    "    np.arange(\n",
    "        n_pathways\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "ax.set_yticklabels(\n",
    "\n",
    "    pathway_labels,\n",
    "\n",
    "    fontsize=9,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "ax.tick_params(\n",
    "\n",
    "    axis=\"y\",\n",
    "\n",
    "    length=0,\n",
    "\n",
    "    pad=8,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# Bold Class-B candidates.\n",
    "for i, label in enumerate(\n",
    "    ax.get_xticklabels()\n",
    "):\n",
    "\n",
    "    if i < 8:\n",
    "\n",
    "        label.set_fontweight(\n",
    "            \"bold\"\n",
    "        )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 18. PATHWAY EVIDENCE / FAMILY-SIZE COLUMNS\n",
    "# ============================================================\n",
    "\n",
    "CLASS_X = (\n",
    "    n_genes\n",
    "    +\n",
    "    0.10\n",
    ")\n",
    "\n",
    "FAMILY_X = (\n",
    "    n_genes\n",
    "    +\n",
    "    0.95\n",
    ")\n",
    "\n",
    "\n",
    "ax.text(\n",
    "\n",
    "    CLASS_X,\n",
    "    -0.92,\n",
    "\n",
    "    \"Pathway\\nclass\",\n",
    "\n",
    "    ha=\"center\",\n",
    "    va=\"center\",\n",
    "\n",
    "    fontsize=9,\n",
    "\n",
    "    fontweight=\"bold\",\n",
    "\n",
    "    clip_on=False,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "ax.text(\n",
    "\n",
    "    FAMILY_X,\n",
    "    -0.92,\n",
    "\n",
    "    \"Family\\nsize\",\n",
    "\n",
    "    ha=\"center\",\n",
    "    va=\"center\",\n",
    "\n",
    "    fontsize=9,\n",
    "\n",
    "    fontweight=\"bold\",\n",
    "\n",
    "    clip_on=False,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "for i, row in (\n",
    "    selected_pathways_df\n",
    "    .reset_index(\n",
    "        drop=True\n",
    "    )\n",
    "    .iterrows()\n",
    "):\n",
    "\n",
    "    pathway_class = compact_priority(\n",
    "        row[\n",
    "            \"priority_group\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    family_size = int(\n",
    "        row[\n",
    "            \"n_pathways_represented\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    ax.text(\n",
    "\n",
    "        CLASS_X,\n",
    "        i,\n",
    "\n",
    "        pathway_class,\n",
    "\n",
    "        ha=\"center\",\n",
    "        va=\"center\",\n",
    "\n",
    "        fontsize=9,\n",
    "\n",
    "        fontweight=(\n",
    "            \"bold\"\n",
    "            if pathway_class == \"R2\"\n",
    "            else\n",
    "            \"normal\"\n",
    "        ),\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    ax.text(\n",
    "\n",
    "        FAMILY_X,\n",
    "        i,\n",
    "\n",
    "        str(\n",
    "            family_size\n",
    "        ),\n",
    "\n",
    "        ha=\"center\",\n",
    "        va=\"center\",\n",
    "\n",
    "        fontsize=9,\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 19. CLEAN SPINES\n",
    "# ============================================================\n",
    "\n",
    "for spine in (\n",
    "    ax.spines.values()\n",
    "):\n",
    "\n",
    "    spine.set_visible(\n",
    "        False\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 20. TITLE\n",
    "# ============================================================\n",
    "\n",
    "fig.suptitle(\n",
    "\n",
    "    (\n",
    "        \"Prioritized multimodal candidates map sparsely \"\n",
    "        \"to nonredundant AD–PD Reactome programs\"\n",
    "    ),\n",
    "\n",
    "    fontsize=16,\n",
    "\n",
    "    fontweight=\"bold\",\n",
    "\n",
    "    y=0.985,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "ax.set_title(\n",
    "\n",
    "    (\n",
    "        \"Top 12 frozen candidates × selected R2/R3 \"\n",
    "        \"nonredundant pathway families\"\n",
    "    ),\n",
    "\n",
    "    fontsize=10.5,\n",
    "\n",
    "    pad=72,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 21. LEGEND\n",
    "# ============================================================\n",
    "\n",
    "legend_handles = [\n",
    "\n",
    "    Line2D(\n",
    "\n",
    "        [0],\n",
    "        [0],\n",
    "\n",
    "        marker=\"o\",\n",
    "\n",
    "        linestyle=\"None\",\n",
    "\n",
    "        markerfacecolor=\"black\",\n",
    "        markeredgecolor=\"black\",\n",
    "\n",
    "        markersize=8,\n",
    "\n",
    "        label=(\n",
    "            \"Shared AD–PD leading-edge membership\"\n",
    "        ),\n",
    "\n",
    "    ),\n",
    "\n",
    "    Line2D(\n",
    "\n",
    "        [0],\n",
    "        [0],\n",
    "\n",
    "        marker=\"o\",\n",
    "\n",
    "        linestyle=\"None\",\n",
    "\n",
    "        markerfacecolor=\"none\",\n",
    "        markeredgecolor=\"black\",\n",
    "\n",
    "        markersize=8,\n",
    "\n",
    "        label=(\n",
    "            \"Broader leading-edge-union membership\"\n",
    "        ),\n",
    "\n",
    "    ),\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "fig.legend(\n",
    "\n",
    "    handles=legend_handles,\n",
    "\n",
    "    loc=\"lower center\",\n",
    "\n",
    "    bbox_to_anchor=(\n",
    "        0.53,\n",
    "        0.057,\n",
    "    ),\n",
    "\n",
    "    ncol=2,\n",
    "\n",
    "    frameon=False,\n",
    "\n",
    "    fontsize=9,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 22. FOOTNOTES\n",
    "# ============================================================\n",
    "\n",
    "pathway_classes = (\n",
    "\n",
    "    selected_pathways_df[\n",
    "        \"priority_group\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .map(\n",
    "        compact_priority\n",
    "    )\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "if (\n",
    "    pathway_classes\n",
    "    ==\n",
    "    {\n",
    "        \"R3\": 9\n",
    "    }\n",
    "):\n",
    "\n",
    "    class_note = (\n",
    "        \"All nine connected pathway families in this \"\n",
    "        \"top-12 candidate view are R3 recurrent-directional \"\n",
    "        \"families; no R2 family is connected to these \"\n",
    "        \"candidates after the frozen redundancy mapping.\"\n",
    "    )\n",
    "\n",
    "else:\n",
    "\n",
    "    class_note = (\n",
    "        \"R2 denotes formal same-direction AD and PD \"\n",
    "        \"FDR<0.05 convergence in ≥1 glial cell class; \"\n",
    "        \"R3 denotes recurrent same-direction enrichment \"\n",
    "        \"across ≥3 glial cell classes.\"\n",
    "    )\n",
    "\n",    "\n",
    "fig.text(\n",
    "\n",
    "    0.08,\n",
    "    0.036,\n",
    "\n",
    "    class_note,\n",
    "\n",
    "    fontsize=8.4,\n",
    "\n",
    "    ha=\"left\",\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "fig.text(\n",
    "\n",
    "    0.08,\n",
    "    0.020,\n",
    "\n",
    "    (\n",
    "        \"R3 recurrence is supported globally by the \"\n",
    "        \"profile-preserving permutation null \"\n",
    "        \"(665 observed versus null 95% interval 411–476; \"\n",
    "        \"empirical P < 1×10⁻⁴), but individual R3 \"\n",
    "        \"pathways are not individually significant \"\n",
    "        \"cross-disease pathway calls.\"\n",
    "    ),\n",
    "\n",
    "    fontsize=8.4,\n",
    "\n",
    "    ha=\"left\",\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "fig.text(\n",
    "\n",
    "    0.08,\n",
    "    0.004,\n",
    "\n",
    "    (\n",
    "        \"† No displayed connection to the selected R2/R3 \"\n",
    "        \"nonredundant pathway families. \"\n",
    "        \"Absence of a matrix symbol does not imply absence \"\n",
    "        \"of other biological associations.\"\n",
    "    ),\n",
    "\n",
    "    fontsize=8.4,\n",
    "\n",
    "    ha=\"left\",\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 23. SAVE EXACT MATRIX DATA\n",
    "# ============================================================\n",
    "\n",
    "matrix_rows = []\n",
    "\n",
    "\n",
    "edge_lookup = {\n",
    "\n",
    "    (\n",
    "        row.gene_symbol,\n",
    "        row.pathway,\n",
    "    ):\n",
    "        row\n",
    "\n",
    "    for row in plot_edges.itertuples(\n",
    "        index=False\n",
    "    )\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "for pathway in selected_pathways:\n",
    "\n",
    "    pathway_meta = (\n",
    "        selected_pathways_df.loc[\n",
    "            selected_pathways_df[\n",
    "                \"pathway\"\n",
    "            ]\n",
    "            ==\n",
    "            pathway\n",
    "        ]\n",
    "        .iloc[\n",
    "            0\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    for gene in selected_genes:\n",
    "\n",
    "        key = (\n",
    "            gene,\n",
    "            pathway,\n",
    "        )\n",
    "\n",
    "\n",
    "        if key in edge_lookup:\n",
    "\n",
    "            edge = edge_lookup[\n",
    "                key\n",
    "            ]\n",
    "\n",
    "\n",
    "            shared = bool(\n",
    "                edge.shared_AD_PD_leading_edge\n",
    "            )\n",
    "\n",
    "\n",
    "            link_type = (\n",
    "                \"shared_AD_PD_leading_edge\"\n",
    "                if shared\n",
    "                else\n",
    "                \"broader_leading_edge_union\"\n",
    "            )\n",
    "\n",
    "\n",
    "            n_original = int(\n",
    "                edge.n_original_pathway_links\n",
    "            )\n",
    "\n",
    "\n",
    "        else:\n",
    "\n",
    "            shared = False\n",
    "\n",
    "            link_type = (\n",
    "                \"no_selected_R2_R3_link\"\n",
    "            )\n",
    "\n",
    "            n_original = 0\n",
    "\n",
    "\n",
    "        matrix_rows.append(\n",
    "            {\n",
    "\n",
    "                \"pathway\":\n",
    "                    pathway,\n",
    "\n",
    "                \"pathway_rank\":\n",
    "                    int(\n",
    "                        pathway_meta[\n",
    "                            \"pathway_rank\"\n",
    "                        ]\n",
    "                    ),\n",
    "\n",
    "                \"pathway_priority\":\n",
    "                    pathway_meta[\n",
    "                        \"priority_group\"\n",
    "                    ],\n",
    "\n",
    "                \"n_pathways_represented\":\n",
    "                    int(\n",
    "                        pathway_meta[\n",
    "                            \"n_pathways_represented\"\n",
    "                        ]\n",
    "                    ),\n",
    "\n",
    "                \"gene_symbol\":\n",
    "                    gene,\n",
    "\n",
    "                \"candidate_rank\":\n",
    "                    int(\n",
    "                        top_genes.loc[\n",
    "                            top_genes[\n",
    "                                \"gene_symbol\"\n",
    "                            ]\n",
    "                            ==\n",
    "                            gene,\n",
    "                            \"candidate_rank\",\n",
    "                        ]\n",
    "                        .iloc[\n",
    "                            0\n",
    "                        ]\n",
    "                    ),\n",
    "\n",
    "                \"candidate_priority\":\n",
    "                    top_genes.loc[\n",
    "                        top_genes[\n",
    "                            \"gene_symbol\"\n",
    "                        ]\n",
    "                        ==\n",
    "                        gene,\n",
    "                        \"priority_group\",\n",
    "                    ]\n",
    "                    .iloc[\n",
    "                        0\n",
    "                    ],\n",
    "\n",
    "                \"link_type\":\n",
    "                    link_type,\n",
    "\n",
    "                \"shared_AD_PD_leading_edge\":\n",
    "                    shared,\n",
    "\n",
    "                \"n_original_pathway_links\":\n",
    "                    n_original,\n",
    "\n",
    "            }\n",
    "        )\n",
    "\n",
    "\n",
    "matrix_data = pd.DataFrame(\n",
    "    matrix_rows\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 24. SAVE — NEW FILES ONLY\n",
    "# ============================================================\n",
    "\n",
    "PNG_PATH = (\n",
    "    FIG_DIR\n",
    "    /\n",
    "    \"Figure5_REVISED_candidate_pathway_matrix.png\"\n",
    ")\n",
    "\n",
    "\n",
    "PDF_PATH = (\n",
    "    FIG_DIR\n",
    "    /\n",
    "    \"Figure5_REVISED_candidate_pathway_matrix.pdf\"\n",
    ")\n",
    "\n",
    "\n",
    "SVG_PATH = (\n",
    "    FIG_DIR\n",
    "    /\n",
    "    \"Figure5_REVISED_candidate_pathway_matrix.svg\"\n",
    ")\n",
    "\n",
    "\n",
    "DATA_PATH = (\n",
    "    FIG_DIR\n",
    "    /\n",
    "    \"Figure5_REVISED_candidate_pathway_matrix_data.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "EDGE_PATH = (\n",
    "    FIG_DIR\n",
    "    /\n",
    "    \"Figure5_REVISED_candidate_pathway_edges.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "PATHWAY_PATH = (\n",
    "    FIG_DIR\n",
    "    /\n",
    "    \"Figure5_REVISED_pathway_families.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "matrix_data.to_csv(\n",
    "    DATA_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "plot_edges.to_csv(\n",
    "    EDGE_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "selected_pathways_df.to_csv(\n",
    "    PATHWAY_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "fig.subplots_adjust(\n",
    "\n",
    "    left=0.31,\n",
    "    right=0.91,\n",
    "\n",
    "    top=0.80,\n",
    "    bottom=0.12,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "fig.savefig(\n",
    "\n",
    "    PNG_PATH,\n",
    "\n",
    "    dpi=600,\n",
    "\n",
    "    bbox_inches=\"tight\",\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "fig.savefig(\n",
    "\n",
    "    PDF_PATH,\n",
    "\n",
    "    bbox_inches=\"tight\",\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "fig.savefig(\n",
    "\n",
    "    SVG_PATH,\n",
    "\n",
    "    bbox_inches=\"tight\",\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 25. REPORT\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    + \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"REVISED FIGURE 5 COMPLETE\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nCandidate genes:\",\n",
    "    len(\n",
    "        selected_genes\n",
    "    ),\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Pathway families:\",\n",
    "    len(\n",
    "        selected_pathways\n",
    "    ),\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Displayed candidate-pathway links:\",\n",
    "    len(\n",
    "        plot_edges\n",
    "    ),\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Shared AD-PD leading-edge links:\",\n",
    "    int(\n",
    "        plot_edges[\n",
    "            \"shared_AD_PD_leading_edge\"\n",
    "        ].sum()\n",
    "    ),\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Broader-union-only links:\",\n",
    "    int(\n",
    "        (\n",
    "            ~plot_edges[\n",
    "                \"shared_AD_PD_leading_edge\"\n",
    "            ]\n",
    "        ).sum()\n",
    "    ),\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPathway classes:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    pathway_classes\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nGenes without a selected R2/R3 family link:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    unconnected\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSelected pathway families:\"\n",
    ")\n",
    "\n",
    "display(\n",
    "    selected_pathways_df[\n",
    "        [\n",
    "            \"pathway_rank\",\n",
    "            \"pathway\",\n",
    "            \"priority_group\",\n",
    "            \"n_selected_genes\",\n",
    "            \"n_shared_AD_PD_genes\",\n",
    "            \"n_pathways_represented\",\n",
    "        ]\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSaved:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    PNG_PATH\n",
    ")\n",
    "\n",
    "print(\n",
    "    PDF_PATH\n",
    ")\n",
    "\n",
    "print(\n",
    "    SVG_PATH\n",
    ")\n",
    "\n",
    "print(\n",
    "    DATA_PATH\n",
    ")\n",
    "\n",
    "print(\n",
    "    EDGE_PATH\n",
    ")\n",
    "\n",
    "print(\n",
    "    PATHWAY_PATH\n",
    ")"
   ]
