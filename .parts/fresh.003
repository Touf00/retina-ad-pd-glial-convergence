    "    )\n",
    "\n",
    "\n",
    "    coverage_summary[\n",
    "        \"PXD073336_measured_fraction\"\n",
    "    ] = (\n",
    "\n",
    "        coverage_summary[\n",
    "            \"PXD073336_measured\"\n",
    "        ]\n",
    "\n",
    "        /\n",
    "\n",
    "        coverage_summary[\n",
    "            \"brain_convergence_genes\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    coverage_summary.to_csv(\n",
    "        SUMMARY_PATH,\n",
    "        index=False,\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\n\"\n",
    "        +\n",
    "        \"=\" * 90\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"PXD073336 COVERAGE OF AD↔PD BRAIN-CONVERGENT GENES\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"=\" * 90\n",
    "    )\n",
    "\n",
    "\n",
    "    display(\n",
    "        coverage_summary\n",
    "    )\n",
    "\n",
    "\n",
    "else:\n",
    "\n",
    "    measured_symbols = set()\n",
    "\n",
    "    coverage_summary = pd.DataFrame()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 13. SAVE COMPLETE COLUMN MANIFEST\n",
    "# ============================================================\n",
    "\n",
    "COLUMN_MANIFEST_PATH = (\n",
    "    OUT /\n",
    "    \"PXD073336_PROTEINS_COLUMN_MANIFEST_v1.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "column_manifest = pd.DataFrame(\n",
    "    {\n",
    "\n",
    "        \"column_index\":\n",
    "            range(\n",
    "                len(\n",
    "                    df.columns\n",
    "                )\n",
    "            ),\n",
    "\n",
    "        \"column_name\":\n",
    "            [\n",
    "                str(\n",
    "                    c\n",
    "                )\n",
    "                for c\n",
    "                in df.columns\n",
    "            ],\n",
    "\n",
    "        \"normalized_name\":\n",
    "            [\n",
    "                norm[\n",
    "                    c\n",
    "                ]\n",
    "                for c\n",
    "                in df.columns\n",
    "            ],\n",
    "\n",
    "        \"dtype\":\n",
    "            [\n",
    "                str(\n",
    "                    df[\n",
    "                        c\n",
    "                    ].dtype\n",
    "                )\n",
    "                for c\n",
    "                in df.columns\n",
    "            ],\n",
    "\n",
    "        \"non_null\":\n",
    "            [\n",
    "                int(\n",
    "                    df[\n",
    "                        c\n",
    "                    ]\n",
    "                    .notna()\n",
    "                    .sum()\n",
    "                )\n",
    "                for c\n",
    "                in df.columns\n",
    "            ],\n",
    "\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "column_manifest.to_csv(\n",
    "    COLUMN_MANIFEST_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 14. SCHEMA FREEZE\n",
    "# ============================================================\n",
    "\n",
    "SCHEMA_LOCK = (\n",
    "    LOCKS /\n",
    "    \"PXD073336_PROCESSED_WORKBOOK_SCHEMA_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "schema = {\n",
    "\n",
    "    \"status\":\n",
    "        \"PXD073336_WORKBOOK_SCHEMA_AUDITED\",\n",
    "\n",
    "    \"dataset\":\n",
    "        \"PXD073336\",\n",
    "\n",
    "    \"workbook\":\n",
    "        str(\n",
    "            WORKBOOK\n",
    "        ),\n",
    "\n",
    "    \"workbook_sha256\":\n",
    "        WORKBOOK_SHA256,\n",
    "\n",
    "    \"sheet\":\n",
    "        SHEET,\n",
    "\n",
    "    \"table_rows\":\n",
    "        int(\n",
    "            df.shape[\n",
    "                0\n",
    "            ]\n",
    "        ),\n",
    "\n",
    "    \"table_columns\":\n",
    "        int(\n",
    "            df.shape[\n",
    "                1\n",
    "            ]\n",
    "        ),\n",
    "\n",
    "    \"gene_symbol_column\":\n",
    "        (\n",
    "            str(\n",
    "                GENE_COL\n",
    "            )\n",
    "            if GENE_COL is not None\n",
    "            else None\n",
    "        ),\n",
    "\n",
    "    \"protein_id_candidates\":\n",
    "        [\n",
    "            str(\n",
    "                x\n",
    "            )\n",
    "            for x\n",
    "            in protein_id_candidates\n",
    "        ],\n",
    "\n",
    "    \"retina_sample_columns_detected\":\n",
    "        int(\n",
    "            len(\n",
    "                retina_sample_cols\n",
    "            )\n",
    "        ),\n",
    "\n",
    "    \"brain_sample_columns_detected\":\n",
    "        int(\n",
    "            len(\n",
    "                brain_sample_cols\n",
    "            )\n",
    "        ),\n",
    "\n",
    "    \"retina_expected_runs\":\n",
    "        32,\n",
    "\n",
    "    \"brain_expected_runs\":\n",
    "        30,\n",
    "\n",
    "    \"effect_columns\":\n",
    "        [\n",
    "            str(\n",
    "                x\n",
    "            )\n",
    "            for x\n",
    "            in effect_cols\n",
    "        ],\n",
    "\n",
    "    \"pvalue_columns\":\n",
    "        [\n",
    "            str(\n",
    "                x\n",
    "            )\n",
    "            for x\n",
    "            in pvalue_cols\n",
    "        ],\n",
    "\n",
    "    \"fdr_columns\":\n",
    "        [\n",
    "            str(\n",
    "                x\n",
    "            )\n",
    "            for x\n",
    "            in fdr_cols\n",
    "        ],\n",
    "\n",
    "    \"metadata_like_columns\":\n",
    "        [\n",
    "            str(\n",
    "                x\n",
    "            )\n",
    "            for x\n",
    "            in metadata_cols\n",
    "        ],\n",
    "\n",
    "    \"author_differential_statistics_present\":\n",
    "        bool(\n",
    "            AUTHOR_STATS_PRESENT\n",
    "        ),\n",
    "\n",
    "    \"published_retinal_cohort\":\n",
    "        {\n",
    "            \"AD\":\n",
    "                8,\n",
    "\n",
    "            \"Control\":\n",
    "                8,\n",
    "        },\n",
    "\n",
    "    \"published_primary_model\":\n",
    "        (\n",
    "            \"Protein ~ C(Buffer) * C(Diagnosis) \"\n",
    "            \"+ C(Sex) + Age + (1|Subject)\"\n",
    "        ),\n",
    "\n",
    "    \"published_primary_retinal_DAPs_FDR05\":\n",
    "        239,\n",
    "\n",
    "    \"column_manifest\":\n",
    "        str(\n",
    "            COLUMN_MANIFEST_PATH\n",
    "        ),\n",
    "\n",
    "    \"brain_convergence_measurability_file\":\n",
    "        (\n",
    "            str(\n",
    "                MEASURABILITY_PATH\n",
    "            )\n",
    "            if GENE_COL is not None\n",
    "            else None\n",
    "        ),\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    SCHEMA_LOCK,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        schema,\n",
    "        f,\n",
    "        indent=2,\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 15. FINAL DECISION REPORT\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PXD073336 SCHEMA AUDIT COMPLETE\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nGene column:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    GENE_COL\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nRetina sample columns:\",\n",
    "    len(\n",
    "        retina_sample_cols\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Brain sample columns:\",\n",
    "    len(\n",
    "        brain_sample_cols\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nExisting effect columns:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    effect_cols\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nExisting FDR columns:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    fdr_cols\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nExisting metadata-like columns:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    metadata_cols\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nColumn manifest:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    COLUMN_MANIFEST_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSchema lock:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    SCHEMA_LOCK\n",
    ")\n",
    "\n",
    "\n",
    "if AUTHOR_STATS_PRESENT:\n",
    "\n",
    "    print(\n",
    "        \"\\nNEXT ANALYSIS ROUTE:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"The workbook appears to contain author-level \"\n",
    "        \"differential statistics.\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"We can extract the published retinal AD effect \"\n",
    "        \"directly without refitting the model.\"\n",
    "    )\n",
    "\n",
    "\n",
    "elif (\n",
    "    len(\n",
    "        retina_sample_cols\n",
    "    )\n",
    "    >=\n",
    "    30\n",
    "):\n",
    "\n",
    "    print(\n",
    "        \"\\nNEXT ANALYSIS ROUTE:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"The workbook appears to contain retinal abundance \"\n",
    "        \"measurements but not author-level disease statistics.\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Next step = link the 32 retinal runs to donor \"\n",
    "        \"diagnosis/age/sex and reproduce the published \"\n",
    "        \"MixedLM.\"\n",
    "    )\n",
    "\n",
    "\n",
    "else:\n",
    "\n",
    "    print(\n",
    "        \"\\nNEXT ANALYSIS ROUTE:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"The workbook format is not yet proven to contain \"\n",
    "        \"either explicit retinal statistics or recognizable \"\n",
    "        \"retinal sample columns.\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Use the printed column manifest before any \"\n",
    "        \"biological inference.\"\n",
    "    )"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 71\n",
    "# ============================================================\n",
    "# V2 PXD073336 — AD RETINA PROTEOMIC SUPPORT\n",
    "# SUBJECT-LEVEL BUFFER-AVERAGED REANALYSIS\n",
    "#\n",
    "# PURPOSE\n",
    "# -------\n",
    "# Use the actual PXD073336 Proteome Discoverer workbook to:\n",
    "#\n",
    "#   1. parse retinal abundance columns\n",
    "#   2. recover diagnosis / extraction buffer / donor\n",
    "#   3. extract gene symbols from GN= in Description\n",
    "#   4. collapse duplicate protein rows to gene level\n",
    "#   5. average Lysis + RIPA within each donor\n",
    "#   6. test AD vs Control at donor level\n",
    "#   7. calculate BH FDR\n",
    "#   8. quantify Lysis/RIPA directional consistency\n",
    "#   9. map retinal protein effects onto the frozen\n",
    "#      AD↔PD brain-convergence table\n",
    "#\n",
    "# IMPORTANT\n",
    "# ---------\n",
    "# This is an INTERNAL SUPPORT ANALYSIS.\n",
    "#\n",
    "# It is NOT claimed to reproduce the paper's exact published\n",
    "# MixedLM because individual donor age/sex covariates are not\n",
    "# present in this Proteome Discoverer workbook.\n",
    "#\n",
    "# Therefore:\n",
    "#   - retinal effect direction is usable\n",
    "#   - retinal measurability is usable\n",
    "#   - nominal/FDR support from THIS reanalysis is usable as\n",
    "#     secondary supportive evidence\n",
    "#   - do NOT label these as the authors' published DAP calls\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "from pathlib import Path\n",
    "\n",
    "import re\n",
    "import json\n",
    "import hashlib\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from scipy.stats import ttest_ind\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = (\n",
    "    ROOT /\n",
    "    \"locks\"\n",
    ")\n",
    "\n",
    "PXD = (\n",
    "    ROOT /\n",
    "    \"ocular_validation\" /\n",
    "    \"PXD073336\"\n",
    ")\n",
    "\n",
    "WORKBOOK = (\n",
    "    PXD /\n",
    "    \"Retinaxhippocampus_Proteomics.xlsx\"\n",
    ")\n",
    "\n",
    "OUT = (\n",
    "    PXD /\n",
    "    \"analysis\"\n",
    ")\n",
    "\n",
    "OUT.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "LOCKS.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "\n",
    "CONVERGENCE_PATH = (\n",
    "    ROOT /\n",
    "    \"results\" /\n",
    "    \"cross_disease_convergence\" /\n",
    "    \"AD_PD_ALL_GENE_CONVERGENCE_v2.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "assert WORKBOOK.exists(), (\n",
    "    f\"Missing workbook:\\n{WORKBOOK}\"\n",
    ")\n",
    "\n",
    "assert CONVERGENCE_PATH.exists(), (\n",
    "    f\"Missing AD↔PD convergence table:\\n{CONVERGENCE_PATH}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. LOAD PROTEOMICS WORKBOOK\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PXD073336 — AD RETINA PROTEOMIC SUPPORT\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "df = pd.read_excel(\n",
    "    WORKBOOK,\n",
    "    sheet_name=\"Proteins\",\n",
    ")\n",
    "\n",
    "\n",
    "df = (\n",
    "    df\n",
    "    .dropna(\n",
    "        axis=0,\n",
    "        how=\"all\",\n",
    "    )\n",
    "    .dropna(\n",
    "        axis=1,\n",
    "        how=\"all\",\n",
    "    )\n",
    "    .reset_index(\n",
    "        drop=True\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nRaw protein table:\",\n",
    "    df.shape\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    \"Description\"\n",
    "    in df.columns\n",
    "), (\n",
    "    \"Description column missing.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. RETAIN HIGH-CONFIDENCE MASTER PROTEINS\n",
    "# ============================================================\n",
    "\n",
    "qc = df.copy()\n",
    "\n",
    "\n",
    "if (\n",
    "    \"Protein FDR Confidence: Combined\"\n",
    "    in qc.columns\n",
    "):\n",
    "\n",
    "    confidence = (\n",
    "        qc[\n",
    "            \"Protein FDR Confidence: Combined\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .str.strip()\n",
    "        .str.lower()\n",
    "    )\n",
    "\n",
    "\n",
    "    qc = qc.loc[\n",
    "        confidence\n",
    "        ==\n",
    "        \"high\"\n",
    "    ].copy()\n",
    "\n",
    "\n",
    "if (\n",
    "    \"Master\"\n",
    "    in qc.columns\n",
    "):\n",
    "\n",
    "    master = (\n",
    "        qc[\n",
    "            \"Master\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .str.strip()\n",
    "        .str.lower()\n",
    "    )\n",
    "\n",
    "\n",
    "    qc = qc.loc[\n",
    "        master\n",
    "        ==\n",
    "        \"master protein\"\n",
    "    ].copy()\n",
    "\n",
    "\n",
    "print(\n",
    "    \"High-confidence master proteins:\",\n",
    "    f\"{len(qc):,}\"\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    qc\n",
    ") > 1000\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. PARSE RETINAL ABUNDANCE COLUMN METADATA\n",
    "#\n",
    "# Expected structure:\n",
    "#\n",
    "# Abundance: control, retina, lysis, 21\n",
    "# Abundance: control, retina, Ripa, 24\n",
    "#\n",
    "# and analogous Alzheimer / AD columns.\n",
    "# ============================================================\n",
    "\n",
    "sample_records = []\n",
    "\n",
    "\n",
    "for column in qc.columns:\n",
    "\n",
    "\n",
    "    text = str(\n",
    "        column\n",
    "    ).strip()\n",
    "\n",
    "\n",
    "    if not text.lower().startswith(\n",
    "        \"abundance:\"\n",
    "    ):\n",
    "\n",
    "        continue\n",
    "\n",
    "\n",
    "    payload = (\n",
    "        text\n",
    "        .split(\n",
    "            \":\",\n",
    "            1\n",
    "        )[1]\n",
    "        .strip()\n",
    "    )\n",
    "\n",
    "\n",
    "    parts = [\n",
    "        x.strip()\n",
    "        for x\n",
    "        in payload.split(\n",
    "            \",\"\n",
    "        )\n",
    "    ]\n",
    "\n",
    "\n",
    "    if len(\n",
    "        parts\n",
    "    ) != 4:\n",
    "\n",
    "        continue\n",
    "\n",
    "\n",
    "    diagnosis_raw = parts[\n",
    "        0\n",
    "    ]\n",
    "\n",
    "    tissue_raw = parts[\n",
    "        1\n",
    "    ]\n",
    "\n",
    "    buffer_raw = parts[\n",
    "        2\n",
    "    ]\n",
    "\n",
    "    subject_raw = parts[\n",
    "        3\n",
    "    ]\n",
    "\n",
    "\n",
    "    if (\n",
    "        tissue_raw.lower()\n",
    "        !=\n",
    "        \"retina\"\n",
    "    ):\n",
    "\n",
    "        continue\n",
    "\n",
    "\n",
    "    d = (\n",
    "        diagnosis_raw\n",
    "        .lower()\n",
    "        .strip()\n",
    "    )\n",
    "\n",
    "\n",
    "    if (\n",
    "        \"control\"\n",
    "        in d\n",
    "\n",
    "        or\n",
    "\n",
    "        d in {\n",
    "            \"nc\",\n",
    "            \"nd\",\n",
    "            \"non-demented\",\n",
    "            \"nondemented\",\n",
    "        }\n",
    "    ):\n",
    "\n",
    "        diagnosis = \"Control\"\n",
    "\n",
    "\n",
    "    elif (\n",
    "\n",
    "        \"alzheimer\"\n",
    "        in d\n",
    "\n",
    "        or\n",
    "\n",
    "        d in {\n",
    "            \"ad\",\n",
    "            \"alzheimers\",\n",
    "            \"alzheimer's disease\",\n",
    "        }\n",
    "\n",
    "    ):\n",
    "\n",
    "        diagnosis = \"AD\"\n",
    "\n",
    "\n",
    "    else:\n",
    "\n",
    "        diagnosis = None\n",
    "\n",
    "\n",
    "    b = (\n",
    "        buffer_raw\n",
    "        .lower()\n",
    "        .strip()\n",
    "    )\n",
    "\n",
    "\n",
    "    if \"lysis\" in b:\n",
    "\n",
    "        buffer = \"Lysis\"\n",
    "\n",
    "\n",
    "    elif \"ripa\" in b:\n",
    "\n",
    "        buffer = \"RIPA\"\n",
    "\n",
    "\n",
    "    else:\n",
    "\n",
    "        buffer = None\n",
    "\n",
    "\n",
    "    sample_records.append(\n",
    "        {\n",
    "\n",
    "            \"sample_column\":\n",
    "                column,\n",
    "\n",
    "            \"diagnosis_raw\":\n",
    "                diagnosis_raw,\n",
    "\n",
    "            \"diagnosis\":\n",
    "                diagnosis,\n",
    "\n",
    "            \"tissue\":\n",
    "                tissue_raw,\n",
    "\n",
    "            \"buffer\":\n",
    "                buffer,\n",
    "\n",
    "            \"subject_raw\":\n",
    "                str(\n",
    "                    subject_raw\n",
    "                ),\n",
    "\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "samples = pd.DataFrame(\n",
    "    sample_records\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    samples\n",
    ") > 0, (\n",
    "    \"No retinal abundance columns were parsed.\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nParsed retinal abundance columns:\",\n",
    "    len(\n",
    "        samples\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nRaw diagnosis labels:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    samples[\n",
    "        \"diagnosis_raw\"\n",
    "    ]\n",
    "    .value_counts()\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nNormalized diagnoses:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    samples[\n",
    "        \"diagnosis\"\n",
    "    ]\n",
    "    .value_counts(\n",
    "        dropna=False\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nBuffers:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    samples[\n",
    "        \"buffer\"\n",
    "    ]\n",
    "    .value_counts(\n",
    "        dropna=False\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert samples[\n",
    "    \"diagnosis\"\n",
    "].notna().all(), (\n",
    "    \"Unrecognized diagnosis label(s): \"\n",
    "    f\"{samples.loc[samples['diagnosis'].isna(), 'diagnosis_raw'].unique()}\"\n",
    ")\n",
    "\n",
    "\n",
    "assert samples[\n",
    "    \"buffer\"\n",
    "].notna().all(), (\n",
    "    \"Unrecognized buffer label(s).\"\n",
    ")\n",
    "\n",
    "\n",
    "# Diagnosis is included in the subject key defensively in case\n",
    "# numerical pseudonyms overlap between diagnostic groups.\n",
    "\n",
    "samples[\n",
    "    \"subject_id\"\n",
    "] = (\n",
    "\n",
    "    samples[\n",
    "        \"diagnosis\"\n",
    "    ]\n",
    "\n",
    "    +\n",
    "\n",
    "    \"_\"\n",
    "\n",
    "    +\n",
    "\n",
    "    samples[\n",
    "        \"subject_raw\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. VERIFY STUDY DESIGN\n",
    "# ============================================================\n",
    "\n",
    "subject_design = (\n",
    "\n",
    "    samples[\n",
    "        [\n",
    "            \"subject_id\",\n",
    "            \"diagnosis\",\n",
    "            \"buffer\",\n",
    "        ]\n",
    "    ]\n",
    "    .drop_duplicates()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "subject_diag = (\n",
    "\n",
    "    subject_design[\n",
    "        [\n",
    "            \"subject_id\",\n",
    "            \"diagnosis\",\n",
    "        ]\n",
    "    ]\n",
    "    .drop_duplicates()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nUnique retinal donors:\",\n",
    "    subject_diag[\n",
    "        \"subject_id\"\n",
    "    ].nunique()\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    subject_diag[\n",
    "        \"diagnosis\"\n",
    "    ]\n",
    "    .value_counts()\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    subject_diag[\n",
    "        \"subject_id\"\n",
    "    ]\n",
    "    .nunique()\n",
    "    ==\n",
    "    16\n",
    "), (\n",
    "    \"Expected 16 retinal donors.\"\n",
    ")\n",    "\n",
    "\n",
    "assert (\n",
    "    subject_diag[\n",
    "        \"diagnosis\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    "    ==\n",
    "    {\n",
    "        \"AD\": 8,\n",
    "        \"Control\": 8,\n",
    "    }\n",
    "), (\n",
    "    \"Expected 8 AD + 8 Control retinal donors.\"\n",
    ")\n",
    "\n",
    "\n",
    "buffer_counts = (\n",
    "\n",
    "    subject_design\n",
    "    .groupby(\n",
    "        \"subject_id\"\n",
    "    )[\n",
    "        \"buffer\"\n",
    "    ]\n",
    "    .nunique()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    buffer_counts\n",
    "    ==\n",
    "    2\n",
    ").all(), (\n",
    "    \"Every retinal donor should have both Lysis and RIPA.\"\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    samples\n",
    ") == 32, (\n",
    "    f\"Expected 32 retinal abundance columns, found {len(samples)}.\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nRetinal design verification:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"16 donors = 8 AD + 8 Control\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"2 buffers / donor\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"32 retinal measurements total\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. EXTRACT GENE SYMBOL FROM PROTEIN DESCRIPTION\n",
    "#\n",
    "# Example:\n",
    "#\n",
    "# ... OS=Homo sapiens OX=9606 GN=LGALS7B PE=...\n",
    "# ============================================================\n",
    "\n",
    "GN_RE = re.compile(\n",
    "    r\"(?:^|\\s)GN=([A-Za-z0-9][A-Za-z0-9_.\\-]*)\"\n",
    ")\n",
    "\n",
    "\n",
    "def extract_gene(\n",
    "    description\n",
    "):\n",
    "\n",
    "    if pd.isna(\n",
    "        description\n",
    "    ):\n",
    "\n",
    "        return None\n",
    "\n",
    "\n",
    "    match = GN_RE.search(\n",
    "        str(\n",
    "            description\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    if match is None:\n",
    "\n",
    "        return None\n",
    "\n",
    "\n",
    "    return (\n",
    "        match\n",
    "        .group(\n",
    "            1\n",
    "        )\n",
    "        .upper()\n",
    "        .strip()\n",
    "    )\n",
    "\n",
    "\n",
    "qc[\n",
    "    \"gene_symbol\"\n",
    "] = (\n",
    "    qc[\n",
    "        \"Description\"\n",
    "    ]\n",
    "    .map(\n",
    "        extract_gene\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nProteins with GN= gene symbol:\",\n",
    "    int(\n",
    "        qc[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .notna()\n",
    "        .sum()\n",
    "    ),\n",
    "    \"/\",\n",
    "    len(\n",
    "        qc\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "qc = qc.loc[\n",
    "    qc[\n",
    "        \"gene_symbol\"\n",
    "    ]\n",
    "    .notna()\n",
    "].copy()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. NUMERIC RETINAL ABUNDANCES\n",
    "# ============================================================\n",
    "\n",
    "sample_columns = samples[\n",
    "    \"sample_column\"\n",
    "].tolist()\n",
    "\n",
    "\n",
    "abundance = (\n",
    "\n",
    "    qc[\n",
    "        sample_columns\n",
    "    ]\n",
    "    .apply(\n",
    "        pd.to_numeric,\n",
    "        errors=\"coerce\",\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# Mass-spectrometry intensity <=0 is not log2-transformable.\n",
    "abundance = abundance.mask(\n",
    "    abundance\n",
    "    <=\n",
    "    0\n",
    ")\n",
    "\n",
    "\n",
    "log2_abundance = np.log2(\n",
    "    abundance\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. COLLAPSE MULTIPLE MASTER-PROTEIN ROWS PER GENE\n",
    "#\n",
    "# Median is used to avoid allowing one duplicated accession to\n",
    "# dominate gene-level evidence.\n",
    "# ============================================================\n",
    "\n",
    "gene_matrix = pd.concat(\n",
    "\n",
    "    [\n",
    "\n",
    "        qc[\n",
    "            [\n",
    "                \"gene_symbol\"\n",
    "            ]\n",
    "        ]\n",
    "        .reset_index(\n",
    "            drop=True\n",
    "        ),\n",
    "\n",
    "        log2_abundance\n",
    "        .reset_index(\n",
    "            drop=True\n",
    "        ),\n",
    "\n",
    "    ],\n",
    "\n",
    "    axis=1,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "protein_rows_per_gene = (\n",
    "\n",
    "    gene_matrix\n",
    "    .groupby(\n",
    "        \"gene_symbol\"\n",
    "    )\n",
    "    .size()\n",
    "    .rename(\n",
    "        \"protein_rows\"\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "gene_matrix = (\n",
    "\n",
    "    gene_matrix\n",
    "    .groupby(\n",
    "        \"gene_symbol\",\n",
    "        as_index=True,\n",
    "    )[\n",
    "        sample_columns\n",
    "    ]\n",
    "    .median()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nUnique gene symbols after protein-row collapse:\",\n",
    "    f\"{len(gene_matrix):,}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. LONG-FORM RETINAL DATA\n",
    "# ============================================================\n",
    "\n",
    "long = (\n",
    "\n",
    "    gene_matrix\n",
    "    .reset_index()\n",
    "    .melt(\n",
    "\n",
    "        id_vars=[\n",
    "            \"gene_symbol\"\n",
    "        ],\n",
    "\n",
    "        value_vars=\n",
    "            sample_columns,\n",
    "\n",
    "        var_name=\n",
    "            \"sample_column\",\n",
    "\n",
    "        value_name=\n",
    "            \"log2_abundance\",\n",
    "\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "long = long.merge(\n",
    "\n",
    "    samples[\n",
    "        [\n",
    "            \"sample_column\",\n",
    "            \"diagnosis\",\n",
    "            \"buffer\",\n",
    "            \"subject_id\",\n",
    "            \"subject_raw\",\n",
    "        ]\n",
    "    ],\n",
    "\n",
    "    on=\"sample_column\",\n",
    "\n",
    "    how=\"left\",\n",
    "\n",
    "    validate=\"many_to_one\",\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert long[\n",
    "    \"diagnosis\"\n",
    "].notna().all()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. BUFFER-SPECIFIC GENE EFFECTS\n",
    "# ============================================================\n",
    "\n",
    "def mean_difference(\n",
    "    dataframe,\n",
    "    buffer_name,\n",
    "):\n",
    "\n",
    "    z = dataframe.loc[\n",
    "        dataframe[\n",
    "            \"buffer\"\n",
    "        ]\n",
    "        ==\n",
    "        buffer_name\n",
    "    ]\n",
    "\n",
    "\n",
    "    ad = (\n",
    "        z.loc[\n",
    "            z[\n",
    "                \"diagnosis\"\n",
    "            ]\n",
    "            ==\n",
    "            \"AD\",\n",
    "\n",
    "            \"log2_abundance\",\n",
    "        ]\n",
    "        .dropna()\n",
    "        .to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    control = (\n",
    "        z.loc[\n",
    "            z[\n",
    "                \"diagnosis\"\n",
    "            ]\n",
    "            ==\n",
    "            \"Control\",\n",
    "\n",
    "            \"log2_abundance\",\n",
    "        ]\n",
    "        .dropna()\n",
    "        .to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    if (\n",
    "        len(\n",
    "            ad\n",
    "        )\n",
    "        ==\n",
    "        0\n",
    "\n",
    "        or\n",
    "\n",
    "        len(\n",
    "            control\n",
    "        )\n",
    "        ==\n",
    "        0\n",
    "    ):\n",
    "\n",
    "        return (\n",
    "            np.nan,\n",
    "            len(\n",
    "                ad\n",
    "            ),\n",
    "            len(\n",
    "                control\n",
    "            ),\n",
    "        )\n",
    "\n",
    "\n",
    "    return (\n",
    "\n",
    "        float(\n",
    "            np.mean(\n",
    "                ad\n",
    "            )\n",
    "            -\n",
    "            np.mean(\n",
    "                control\n",
    "            )\n",
    "        ),\n",
    "\n",
    "        len(\n",
    "            ad\n",
    "        ),\n",
    "\n",
    "        len(\n",
    "            control\n",
    "        ),\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. SUBJECT-LEVEL BUFFER-AVERAGED VALUES\n",
    "#\n",
    "# One biological value per donor per gene.\n",
    "#\n",
    "# This prevents the two extraction buffers from being treated\n",
    "# as independent biological subjects.\n",
    "# ============================================================\n",
    "\n",
    "subject_values = (\n",
    "\n",
    "    long\n",
    "    .groupby(\n",
    "        [\n",
    "            \"gene_symbol\",\n",
    "            \"subject_id\",\n",
    "            \"diagnosis\",\n",
    "        ],\n",
    "        as_index=False,\n",
    "    )\n",
    "    .agg(\n",
    "\n",
    "        log2_abundance=(\n",
    "            \"log2_abundance\",\n",
    "            \"mean\",\n",
    "        ),\n",
    "\n",
    "        buffers_observed=(\n",
    "            \"log2_abundance\",\n",
    "            \"count\",\n",
    "        ),\n",
    "\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. GENE-LEVEL AD VS CONTROL TEST\n",
    "# ============================================================\n",
    "\n",
    "results = []\n",
    "\n",
    "\n",
    "for gene, group in subject_values.groupby(\n",
    "    \"gene_symbol\",\n",
    "    sort=False,\n",
    "):\n",
    "\n",
    "\n",
    "    ad = (\n",
    "\n",
    "        group.loc[\n",
    "            group[\n",
    "                \"diagnosis\"\n",
    "            ]\n",
    "            ==\n",
    "            \"AD\",\n",
    "\n",
    "            \"log2_abundance\",\n",
    "        ]\n",
    "        .dropna()\n",
    "        .to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    control = (\n",
    "\n",
    "        group.loc[\n",
    "            group[\n",
    "                \"diagnosis\"\n",
    "            ]\n",
    "            ==\n",
    "            \"Control\",\n",
    "\n",
    "            \"log2_abundance\",\n",
    "        ]\n",
    "        .dropna()\n",
    "        .to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_ad = len(\n",
    "        ad\n",
    "    )\n",
    "\n",
    "\n",
    "    n_control = len(\n",
    "        control\n",
    "    )\n",
    "\n",
    "\n",
    "    # Conservative measurability threshold.\n",
    "    tested = (\n",
    "\n",
    "        n_ad\n",
    "        >=\n",
    "        4\n",
    "\n",
    "        and\n",
    "\n",
    "        n_control\n",
    "        >=\n",
    "        4\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    if tested:\n",
    "\n",
    "\n",
    "        retinal_effect = float(\n",
    "            np.mean(\n",
    "                ad\n",
    "            )\n",
    "            -\n",
    "            np.mean(\n",
    "                control\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "        test = ttest_ind(\n",
    "\n",
    "            ad,\n",
    "\n",
    "            control,\n",
    "\n",
    "            equal_var=False,\n",
    "\n",
    "            nan_policy=\"omit\",\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        pvalue = float(\n",
    "            test.pvalue\n",
    "        )\n",
    "\n",
    "\n",
    "        statistic = float(\n",
    "            test.statistic\n",
    "        )\n",
    "\n",
    "\n",
    "    else:\n",
    "\n",
    "\n",
    "        retinal_effect = np.nan\n",
    "\n",
    "        pvalue = np.nan\n",
    "\n",
    "        statistic = np.nan\n",
    "\n",
    "\n",
    "    g_long = long.loc[\n",
    "        long[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        ==\n",
    "        gene\n",
    "    ]\n",
    "\n",
    "\n",
    "    (\n",
    "        effect_lysis,\n",
    "        n_ad_lysis,\n",
    "        n_control_lysis,\n",
    "\n",
    "    ) = mean_difference(\n",
    "        g_long,\n",
    "        \"Lysis\",\n",
    "    )\n",
    "\n",
    "\n",
    "    (\n",
    "        effect_ripa,\n",
    "        n_ad_ripa,\n",
    "        n_control_ripa,\n",
    "\n",
    "    ) = mean_difference(\n",
    "        g_long,\n",
    "        \"RIPA\",\n",
    "    )\n",
    "\n",
    "\n",
    "    buffer_direction_consistent = (\n",
    "\n",
    "        np.isfinite(\n",
    "            effect_lysis\n",
    "        )\n",
    "\n",
    "        and\n",
    "\n",
    "        np.isfinite(\n",
    "            effect_ripa\n",
    "        )\n",
    "\n",
    "        and\n",
    "\n",
    "        np.sign(\n",
    "            effect_lysis\n",
    "        )\n",
    "\n",
    "        ==\n",
    "\n",
    "        np.sign(\n",
    "            effect_ripa\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    results.append(\n",
    "        {\n",
    "\n",
    "            \"gene_symbol\":\n",
    "                gene,\n",
    "\n",
    "            \"protein_rows\":\n",
    "                int(\n",
    "                    protein_rows_per_gene.loc[\n",
    "                        gene\n",
    "                    ]\n",
    "                ),\n",
    "\n",
    "            \"AD_donors_measured\":\n",
    "                int(\n",
    "                    n_ad\n",
    "                ),\n",
    "\n",
    "            \"Control_donors_measured\":\n",
    "                int(\n",
    "                    n_control\n",
    "                ),\n",
    "\n",
    "            \"tested\":\n",
    "                bool(\n",
    "                    tested\n",
    "                ),\n",
    "\n",
    "            \"retina_AD_vs_Control_log2FC\":\n",
    "                retinal_effect,\n",
    "\n",
    "            \"retina_t_stat\":\n",
    "                statistic,\n",
    "\n",
    "            \"retina_pvalue\":\n",
    "                pvalue,\n",
    "\n",
    "            \"Lysis_AD_vs_Control_log2FC\":\n",
    "                effect_lysis,\n",
    "\n",
    "            \"RIPA_AD_vs_Control_log2FC\":\n",
    "                effect_ripa,\n",
    "\n",
    "            \"Lysis_AD_measured\":\n",
    "                int(\n",
    "                    n_ad_lysis\n",
    "                ),\n",
    "\n",
    "            \"Lysis_Control_measured\":\n",
    "                int(\n",
    "                    n_control_lysis\n",
    "                ),\n",
    "\n",
    "            \"RIPA_AD_measured\":\n",
    "                int(\n",
    "                    n_ad_ripa\n",
    "                ),\n",
    "\n",
    "            \"RIPA_Control_measured\":\n",
    "                int(\n",
    "                    n_control_ripa\n",
    "                ),\n",
    "\n",
    "            \"buffer_direction_consistent\":\n",
    "                bool(\n",
    "                    buffer_direction_consistent\n",
    "                ),\n",
    "\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "retina = pd.DataFrame(\n",
    "    results\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 12. BENJAMINI-HOCHBERG FDR\n",
    "# ============================================================\n",
    "\n",
    "def bh_fdr(\n",
    "    pvalues\n",
    "):\n",
    "\n",
    "    p = np.asarray(\n",
    "        pvalues,\n",
    "        dtype=float,\n",
    "    )\n",
    "\n",
    "\n",
    "    out = np.full(\n",
    "        len(\n",
    "            p\n",
    "        ),\n",
    "        np.nan,\n",
    "        dtype=float,\n",
    "    )\n",
    "\n",
    "\n",
    "    valid = np.isfinite(\n",
    "        p\n",
    "    )\n",
    "\n",
    "\n",
    "    idx = np.flatnonzero(\n",
    "        valid\n",
    "    )\n",
    "\n",
    "\n",
    "    if len(\n",
    "        idx\n",
    "    ) == 0:\n",
    "\n",
    "        return out\n",
    "\n",
    "\n",
    "    pv = p[\n",
    "        valid\n",
    "    ]\n",
    "\n",
    "\n",
    "    order = np.argsort(\n",
    "        pv\n",
    "    )\n",
    "\n",
    "\n",
    "    ranked = pv[\n",
    "        order\n",
    "    ]\n",
    "\n",
    "\n",
    "    q = (\n",
    "\n",
    "        ranked\n",
    "\n",
    "        *\n",
    "\n",
    "        len(\n",
    "            ranked\n",
    "        )\n",
    "\n",
    "        /\n",
    "\n",
    "        np.arange(\n",
    "            1,\n",
    "            len(\n",
    "                ranked\n",
    "            )\n",
    "            +\n",
    "            1\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    q = np.minimum.accumulate(\n",
    "        q[\n",
    "            ::-1\n",
    "        ]\n",
    "    )[\n",
    "        ::-1\n",
    "    ]\n",
    "\n",
    "\n",
    "    q = np.minimum(\n",
    "        q,\n",
    "        1.0,\n",
    "    )\n",
    "\n",
    "\n",
    "    out[\n",
    "        idx[\n",
    "            order\n",
    "        ]\n",
    "    ] = q\n",
    "\n",
    "\n",
    "    return out\n",
    "\n",
    "\n",
    "retina[\n",
    "    \"retina_FDR\"\n",
    "] = bh_fdr(\n",
    "    retina[\n",
    "        \"retina_pvalue\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "retina[\n",
    "    \"retina_nominal_p_lt_0_05\"\n",
    "] = (\n",
    "\n",
    "    retina[\n",
    "        \"retina_pvalue\"\n",
    "    ]\n",
    "    <\n",
    "    0.05\n",
    ")\n",
    "\n",
    "\n",
    "retina[\n",
    "    \"retina_FDR_lt_0_05\"\n",
    "] = (\n",
    "\n",
    "    retina[\n",
    "        \"retina_FDR\"\n",
    "    ]\n",
    "    <\n",
    "    0.05\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 13. SAVE COMPLETE PXD073336 REANALYSIS\n",
    "# ============================================================\n",
    "\n",
    "RETINA_EFFECT_PATH = (\n",
    "    OUT /\n",
    "    \"PXD073336_AD_RETINA_INTERNAL_GENE_EFFECTS_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "retina.to_csv(\n",
    "    RETINA_EFFECT_PATH,\n",
    "    index=False,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nGenes represented:\",\n",
    "    f\"{len(retina):,}\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Genes meeting >=4 AD + >=4 Control:\",\n",
    "    f\"{int(retina['tested'].sum()):,}\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Internal nominal P<0.05:\",\n",
    "    int(\n",
    "        retina[\n",
    "            \"retina_nominal_p_lt_0_05\"\n",
    "        ]\n",
    "        .sum()\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Internal FDR<0.05:\",\n",
    "    int(\n",
    "        retina[\n",
    "            \"retina_FDR_lt_0_05\"\n",
    "        ]\n",
    "        .sum()\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"FDR hits direction-consistent across Lysis/RIPA:\",\n",
    "    int(\n",
    "        (\n",
    "            retina[\n",
    "                \"retina_FDR_lt_0_05\"\n",
    "            ]\n",
    "\n",
    "            &\n",
    "\n",
    "            retina[\n",
    "                \"buffer_direction_consistent\"\n",
    "            ]\n",
    "        )\n",
    "        .sum()\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 14. MAP RETINAL EFFECTS TO AD↔PD BRAIN CONVERGENCE\n",
    "# ============================================================\n",
    "\n",
    "conv = pd.read_csv(\n",
    "    CONVERGENCE_PATH,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "required_conv = {\n",
    "\n",
    "    \"cell_type\",\n",
    "    \"gene_symbol\",\n",
    "    \"log2FoldChange_AD\",\n",
    "    \"log2FoldChange_PD\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "missing = (\n",
    "    required_conv\n",
    "    -\n",
    "    set(\n",
    "        conv.columns\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert not missing, (\n",
    "    f\"Missing convergence columns: {sorted(missing)}\"\n",
    ")\n",
    "\n",
    "\n",
    "conv[\n",
    "    \"gene_symbol\"\n",
    "] = (\n",
    "\n",
    "    conv[\n",
    "        \"gene_symbol\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .str.upper()\n",
    "    .str.strip()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "retina[\n",
    "    \"gene_symbol\"\n",
    "] = (\n",
    "\n",
    "    retina[\n",
    "        \"gene_symbol\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .str.upper()\n",
    "    .str.strip()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "evidence = conv.merge(\n",
    "\n",
    "    retina,\n",
    "\n",
    "    on=\"gene_symbol\",\n",
    "\n",
    "    how=\"left\",\n",
    "\n",
    "    validate=\"many_to_one\",\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "evidence[\n",
    "    \"PXD073336_protein_measured\"\n",
    "] = (\n",
    "\n",
    "    evidence[\n",
    "        \"tested\"\n",
    "    ]\n",
    "    .fillna(\n",
    "        False\n",
    "    )\n",
    "    .astype(\n",
    "        bool\n",
    "    )\n",
    "\n",
    ")\n",    "\n",
    "\n",
    "finite_direction = (\n",
    "\n",
    "    np.isfinite(\n",
    "        evidence[\n",
    "            \"log2FoldChange_AD\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    &\n",
    "\n",
    "    np.isfinite(\n",
    "        evidence[\n",
    "            \"retina_AD_vs_Control_log2FC\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "evidence[\n",
    "    \"AD_retina_same_direction_as_AD_brain\"\n",
    "] = False\n",
    "\n",
    "\n",
    "evidence.loc[\n",
    "    finite_direction,\n",
    "    \"AD_retina_same_direction_as_AD_brain\"\n",
    "] = (\n",
    "\n",
    "    np.sign(\n",
    "        evidence.loc[\n",
    "            finite_direction,\n",
    "            \"log2FoldChange_AD\",\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    ==\n",
    "\n",
    "    np.sign(\n",
    "        evidence.loc[\n",
    "            finite_direction,\n",
    "            \"retina_AD_vs_Control_log2FC\",\n",
    "        ]\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "evidence[\n",
    "    \"AD_retina_nominal_support\"\n",
    "] = (\n",
    "\n",
    "    evidence[\n",
    "        \"PXD073336_protein_measured\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    (\n",
    "        evidence[\n",
    "            \"retina_pvalue\"\n",
    "        ]\n",
    "        <\n",
    "        0.05\n",
    "    )\n",
    "\n",
    "    &\n",
    "\n",
    "    evidence[\n",
    "        \"AD_retina_same_direction_as_AD_brain\"\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "evidence[\n",
    "    \"AD_retina_FDR_support\"\n",
    "] = (\n",
    "\n",
    "    evidence[\n",
    "        \"PXD073336_protein_measured\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    (\n",
    "        evidence[\n",
    "            \"retina_FDR\"\n",
    "        ]\n",
    "        <\n",
    "        0.05\n",
    "    )\n",
    "\n",
    "    &\n",
    "\n",
    "    evidence[\n",
    "        \"AD_retina_same_direction_as_AD_brain\"\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "evidence[\n",
    "    \"AD_retina_buffer_robust_support\"\n",
    "] = (\n",
    "\n",
    "    evidence[\n",
    "        \"AD_retina_nominal_support\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    evidence[\n",
    "        \"buffer_direction_consistent\"\n",
    "    ]\n",
    "    .fillna(\n",
    "        False\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 15. SAVE BRAIN ↔ AD-RETINA SUPPORT TABLE\n",
    "# ============================================================\n",
    "\n",
    "EVIDENCE_PATH = (\n",
    "    OUT /\n",
    "    \"AD_PD_BRAIN_CONVERGENCE_PXD073336_RETINA_SUPPORT_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "evidence.to_csv(\n",
    "    EVIDENCE_PATH,\n",
    "    index=False,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 16. CELL-CLASS SUMMARY\n",
    "# ============================================================\n",
    "\n",
    "summary = (\n",
    "\n",
    "    evidence\n",
    "    .groupby(\n",
    "        \"cell_type\",\n",
    "        as_index=False,\n",
    "    )\n",
    "    .agg(\n",
    "\n",
    "        brain_convergence_genes=(\n",
    "            \"gene_symbol\",\n",
    "            \"size\",\n",
    "        ),\n",
    "\n",
    "        retinal_protein_measured=(\n",
    "            \"PXD073336_protein_measured\",\n",
    "            \"sum\",\n",
    "        ),\n",
    "\n",
    "        same_AD_direction=(\n",
    "            \"AD_retina_same_direction_as_AD_brain\",\n",
    "            \"sum\",\n",
    "        ),\n",
    "\n",
    "        AD_retina_nominal_support=(\n",
    "            \"AD_retina_nominal_support\",\n",
    "            \"sum\",\n",
    "        ),\n",
    "\n",
    "        AD_retina_FDR_support=(\n",
    "            \"AD_retina_FDR_support\",\n",
    "            \"sum\",\n",
    "        ),\n",
    "\n",
    "        AD_retina_buffer_robust_support=(\n",
    "            \"AD_retina_buffer_robust_support\",\n",
    "            \"sum\",\n",
    "        ),\n",
    "\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "SUMMARY_PATH = (\n",
    "    OUT /\n",
    "    \"AD_PD_BRAIN_CONVERGENCE_PXD073336_RETINA_SUMMARY_v1.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "summary.to_csv(\n",
    "    SUMMARY_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 17. LOCK / PROVENANCE RECORD\n",
    "# ============================================================\n",
    "\n",
    "LOCK_PATH = (\n",
    "    LOCKS /\n",
    "    \"PXD073336_AD_RETINA_INTERNAL_SUPPORT_LOCK_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "record = {\n",
    "\n",
    "    \"status\":\n",
    "        \"PXD073336_AD_RETINA_INTERNAL_SUPPORT_COMPLETE\",\n",
    "\n",
    "    \"dataset\":\n",
    "        \"PXD073336\",\n",
    "\n",
    "    \"cohort\":\n",
    "        {\n",
    "            \"AD\":\n",
    "                8,\n",
    "\n",
    "            \"Control\":\n",
    "                8,\n",
    "        },\n",
    "\n",
    "    \"retinal_measurements\":\n",
    "        32,\n",
    "\n",
    "    \"buffers\":\n",
    "        [\n",
    "            \"Lysis\",\n",
    "            \"RIPA\",\n",
    "        ],\n",
    "\n",
    "    \"analysis_level\":\n",
    "        \"one buffer-averaged value per donor per gene\",\n",
    "\n",
    "    \"minimum_measurability\":\n",
    "        \">=4 AD donors and >=4 Control donors\",\n",
    "\n",
    "    \"test\":\n",
    "        \"Welch two-sample t-test on donor-level mean log2 abundance\",\n",
    "\n",
    "    \"multiple_testing\":\n",
    "        \"Benjamini-Hochberg\",\n",
    "\n",
    "    \"buffer_consistency\":\n",
    "        (\n",
    "            \"AD-Control effect direction separately evaluated \"\n",
    "            \"in Lysis and RIPA\"\n",
    "        ),\n",
    "\n",
    "    \"IMPORTANT_LIMITATION\":\n",
    "        (\n",
    "            \"This is an internal supportive reanalysis and does \"\n",
    "            \"NOT reproduce the published age/sex-adjusted MixedLM.\"\n",
    "        ),\n",
    "\n",
    "    \"author_exact_model_reproduced\":\n",
    "        False,\n",
    "\n",
    "    \"author_published_retinal_DAP_count\":\n",
    "        239,\n",
    "\n",
    "    \"gene_effects\":\n",
    "        str(\n",
    "            RETINA_EFFECT_PATH\n",
    "        ),\n",
    "\n",
    "    \"brain_retina_support\":\n",
    "        str(\n",
    "            EVIDENCE_PATH\n",
    "        ),\n",
    "\n",
    "    \"summary\":\n",
    "        str(\n",
    "            SUMMARY_PATH\n",
    "        ),\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    LOCK_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        record,\n",
    "        f,\n",
    "        indent=2,\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 18. FINAL REPORT\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PXD073336 AD-RETINA SUPPORT ANALYSIS COMPLETE\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    summary\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nGene-level retinal effects:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    RETINA_EFFECT_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nBrain ↔ retina evidence:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    EVIDENCE_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSupport lock:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    LOCK_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nIMPORTANT:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"These are internal supportive retinal effects, NOT the \"\n",
    "    \"authors' published age/sex-adjusted DAP statistics.\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nNEXT: Wolf et al. PD aqueous-humor proteomic analysis.\"\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 72\n",
    "# ============================================================\n",
    "# V2 WOLF et al. CELL 2023\n",
    "# PD AQUEOUS-HUMOR SUPPORT — FINAL PYTHON VERSION\n",
    "#\n",
    "# TESTED AGAINST THE ACTUAL mmc3.xlsx WORKBOOK\n",
    "#\n",
    "# Exact cohort:\n",
    "#   Controls: S59_control ... S77_control  (n=19)\n",
    "#   PD:       S116_Parkinson ... S120_Parkinson (n=5)\n",
    "#\n",
    "# Statistical analysis:\n",
    "#   Welch two-sample t-test\n",
    "#   Benjamini-Hochberg FDR\n",
    "#\n",
    "# IMPORTANT:\n",
    "# This is an independent external-support reanalysis.\n",
    "# It is NOT presented as an exact reproduction of the\n",
    "# publication's robust limma analysis.\n",
    "# ============================================================\n",
    "\n",
    "from pathlib import Path\n",
    "import json\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from scipy.stats import ttest_ind\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "WOLF_DIR = (\n",
    "    ROOT\n",
    "    / \"ocular_validation\"\n",
    "    / \"Wolf_Cell_2023\"\n",
    ")\n",
    "\n",
    "WORKBOOK = (\n",
    "    WOLF_DIR\n",
    "    / \"NIHMS1931846-supplement-8.xlsx\"\n",
    ")\n",
    "\n",
    "OUT = (\n",
    "    WOLF_DIR\n",
    "    / \"analysis\"\n",
    ")\n",
    "\n",
    "LOCKS = (\n",
    "    ROOT\n",
    "    / \"locks\"\n",
    ")\n",
    "\n",
    "CONVERGENCE_PATH = (\n",
    "    ROOT\n",
    "    / \"results\"\n",
    "    / \"cross_disease_convergence\"\n",
    "    / \"AD_PD_ALL_GENE_CONVERGENCE_v2.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "OUT.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "LOCKS.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "\n",
    "assert WORKBOOK.exists(), (\n",
    "    f\"Missing Wolf workbook:\\n{WORKBOOK}\"\n",
    ")\n",
    "\n",
    "assert CONVERGENCE_PATH.exists(), (\n",
    "    f\"Missing brain-convergence table:\\n\"\n",
    "    f\"{CONVERGENCE_PATH}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. EXACT VERIFIED SAMPLE COLUMNS\n",
    "# ============================================================\n",
    "\n",
    "CONTROL_COLS = [\n",
    "    f\"S{i}_control\"\n",
    "    for i in range(59, 78)\n",
    "]\n",
    "\n",
    "PD_COLS = [\n",
    "    f\"S{i}_Parkinson\"\n",
    "    for i in range(116, 121)\n",
    "]\n",
    "\n",
    "ALL_SAMPLE_COLS = (\n",
    "    CONTROL_COLS\n",
    "    +\n",
    "    PD_COLS\n",
    ")\n",
    "\n",
    "\n",
    "assert len(CONTROL_COLS) == 19\n",
    "assert len(PD_COLS) == 5\n",
    "assert len(ALL_SAMPLE_COLS) == 24\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. LOAD WORKBOOK\n",
    "# ============================================================\n",
    "\n",
    "print(\"=\" * 90)\n",
    "print(\"WOLF et al. CELL 2023 — PD AQUEOUS-HUMOR SUPPORT\")\n",
    "print(\"=\" * 90)\n",
    "\n",
    "\n",
    "xls = pd.ExcelFile(\n",
    "    WORKBOOK\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSheets:\",\n",
    "    xls.sheet_names\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    \"Supplement_table_all_data\"\n",
    "    in xls.sheet_names\n",
    ")\n",
    "\n",
    "\n",
    "df = pd.read_excel(\n",
    "    WORKBOOK,\n",
    "    sheet_name=\"Supplement_table_all_data\",\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Raw workbook shape:\",\n",
    "    df.shape\n",
    ")\n",
    "\n",
    "\n",
    "assert df.shape[0] == 6345, (\n",
    "    f\"Unexpected row count: {df.shape[0]}\"\n",
    ")\n",
    "\n",
    "assert \"Symbol\" in df.columns\n",
    "assert \"UniProt\" in df.columns\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. VERIFY EXACT SAMPLE COLUMNS\n",
    "# ============================================================\n",
    "\n",
    "missing = [\n",
    "    x\n",
    "    for x in ALL_SAMPLE_COLS\n",
    "    if x not in df.columns\n",
    "]\n",
    "\n",
    "\n",
    "assert not missing, (\n",
    "    f\"Missing required samples: {missing}\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nVerified controls:\",\n",
    "    CONTROL_COLS[0],\n",
    "    \"→\",\n",
    "    CONTROL_COLS[-1],\n",
    "    \"(n=19)\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Verified PD:\",\n",
    "    PD_COLS[0],\n",
    "    \"→\",\n",
    "    PD_COLS[-1],\n",
    "    \"(n=5)\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. BUILD CLEAN GENE × SAMPLE TABLE\n",
    "# ============================================================\n",
    "\n",
    "data = df[\n",
    "    [\n",
    "        \"Symbol\",\n",
    "        \"UniProt\",\n",
    "    ]\n",
    "    +\n",
    "    ALL_SAMPLE_COLS\n",
    "].copy()\n",
    "\n",
    "\n",
    "data[\n",
    "    \"gene_symbol\"\n",
    "] = (\n",
    "    data[\n",
    "        \"Symbol\"\n",
    "    ]\n",
    "    .astype(\"string\")\n",
    "    .str.strip()\n",
    "    .str.upper()\n",
    ")\n",
    "\n",
    "\n",
    "data = data.loc[\n",
    "    data[\n",
    "        \"gene_symbol\"\n",
    "    ].notna()\n",
    "].copy()\n",
    "\n",
    "\n",
    "data = data.loc[\n",
    "    data[\n",
    "        \"gene_symbol\"\n",
    "    ]\n",
    "    !=\n",
    "    \"\"\n",
    "].copy()\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nMapped gene-symbol rows:\",\n",
    "    f\"{len(data):,}\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Unique gene symbols:\",\n",
    "    f\"{data['gene_symbol'].nunique():,}\"\n",
    ")\n",
    "\n",
    "\n",
    "assert len(data) == 6344, (\n",
    "    f\"Expected 6,344 mapped proteins; got {len(data)}\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    data[\n",
    "        \"gene_symbol\"\n",
    "    ]\n",
    "    .duplicated()\n",
    "    .sum()\n",
    "    ==\n",
    "    0\n",
    "), (\n",
    "    \"Unexpected duplicate gene symbols.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. NUMERIC VALIDATION\n",
    "# ============================================================\n",
    "\n",
    "for col in ALL_SAMPLE_COLS:\n",
    "\n",
    "    data[\n",
    "        col\n",
    "    ] = pd.to_numeric(\n",
    "        data[\n",
    "            col\n",
    "        ],\n",
    "        errors=\"coerce\",\n",
    "    )\n",
    "\n",
    "\n",
    "n_missing = int(\n",
    "    data[\n",
    "        ALL_SAMPLE_COLS\n",
    "    ]\n",
    "    .isna()\n",
    "    .sum()\n",
    "    .sum()\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nMissing values in 24-sample cohort:\",\n",
    "    n_missing\n",
    ")\n",
    "\n",
    "\n",
    "assert n_missing == 0\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. KEEP ZERO VALUES\n",
    "#\n",
    "# Published preprocessing uses zero for values below the\n",
    "# estimated limit of detection.\n",
    "#\n",
    "# Therefore zero is NOT treated as missing.\n",
    "# ============================================================\n",
    "\n",
    "zero_count = int(\n",
    "    (\n",
    "        data[\n",
    "            ALL_SAMPLE_COLS\n",
    "        ]\n",
    "        ==\n",
    "        0\n",
    "    )\n",
    "    .sum()\n",
    "    .sum()\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Zero-valued measurements retained:\",\n",
    "    f\"{zero_count:,}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. DEFINE DETECTED PROTEINS\n",
    "#\n",
    "# Protein must be >0 in at least one of the 24 samples.\n",
    "#\n",
    "# This removes proteins that are completely undetected in the\n",
    "# PD/control comparison.\n",
    "# ============================================================\n",
    "\n",
    "data[\n",
    "    \"detected_in_PD_control_cohort\"\n",
    "] = (\n",
    "\n",
    "    data[\n",
    "        ALL_SAMPLE_COLS\n",
    "    ]\n",
    "    .gt(0)\n",
    "    .any(\n",
    "        axis=1\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "tested = data.loc[\n",
    "    data[\n",
    "        \"detected_in_PD_control_cohort\"\n",
    "    ]\n",
    "].copy()\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nDetected gene-mapped proteins:\",\n",
    "    f\"{len(tested):,}\"\n",
    ")\n",
    "\n",
    "\n",
    "assert len(tested) == 5691, (\n",
    "    f\"Expected 5,691 mapped detected proteins; \"\n",
    "    f\"found {len(tested)}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. GROUP MATRICES\n",
    "# ============================================================\n",
    "\n",
    "CONTROL = (\n",
    "    tested[\n",
    "        CONTROL_COLS\n",
    "    ]\n",
    "    .to_numpy(\n",
    "        dtype=float\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "PD = (\n",
    "    tested[\n",
    "        PD_COLS\n",
    "    ]\n",
    "    .to_numpy(\n",
    "        dtype=float\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. EFFECT SIZE\n",
    "#\n",
    "# Workbook values are already log2-scaled RFU.\n",
    "#\n",
    "# Do NOT log-transform again.\n",
    "# ============================================================\n",
    "\n",
    "tested[\n",
    "    \"PD_AH_mean_Control\"\n",
    "] = CONTROL.mean(\n",
    "    axis=1\n",
    ")\n",
    "\n",
    "\n",
    "tested[\n",
    "    \"PD_AH_mean_PD\"\n",
    "] = PD.mean(\n",
    "    axis=1\n",
    ")\n",
    "\n",
    "\n",
    "tested[\n",
    "    \"PD_AH_log2RFU_diff\"\n",
    "] = (\n",
    "\n",
    "    tested[\n",
    "        \"PD_AH_mean_PD\"\n",
    "    ]\n",
    "\n",
    "    -\n",
    "\n",
    "    tested[\n",
    "        \"PD_AH_mean_Control\"\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. WELCH TWO-SAMPLE TEST\n",
    "#\n",
    "# n = 5 PD\n",
    "# n = 19 Control\n",
    "#\n",
    "# Welch avoids assuming equal group variances.\n",
    "# ============================================================\n",
    "\n",
    "tt = ttest_ind(\n",
    "    PD,\n",
    "    CONTROL,\n",
    "    axis=1,\n",
    "    equal_var=False,\n",
    "    nan_policy=\"raise\",\n",
    ")\n",
    "\n",
    "\n",
    "tested[\n",
    "    \"PD_AH_Welch_t\"\n",
    "] = tt.statistic\n",
    "\n",
    "\n",
    "tested[\n",
    "    \"PD_AH_pvalue\"\n",
    "] = tt.pvalue\n",
    "\n",
    "\n",
    "assert (\n",
    "    np.isfinite(\n",
    "        tested[\n",
    "            \"PD_AH_pvalue\"\n",
    "        ]\n",
    "    )\n",
    "    .all()\n",
    "), (\n",
    "    \"Non-finite PD aqueous-humor p-values detected.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. BENJAMINI-HOCHBERG FDR\n",
    "#\n",
    "# Self-contained implementation.\n",
    "# No statsmodels required.\n",
    "# ============================================================\n",
    "\n",
    "def benjamini_hochberg(\n",
    "    pvalues\n",
    "):\n",
    "\n",
    "    p = np.asarray(\n",
    "        pvalues,\n",
    "        dtype=float,\n",
    "    )\n",
    "\n",
    "\n",
    "    assert np.isfinite(\n",
    "        p\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    n = len(\n",
    "        p\n",
    "    )\n",
    "\n",
    "\n",
    "    order = np.argsort(\n",
    "        p\n",
    "    )\n",
    "\n",
    "\n",
    "    ranked = p[\n",
    "        order\n",
    "    ]\n",
    "\n",
    "\n",
    "    adjusted = (\n",
    "\n",
    "        ranked\n",
    "        *\n",
    "        n\n",
    "        /\n",
    "        np.arange(\n",
    "            1,\n",
    "            n + 1\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    adjusted = np.minimum.accumulate(\n",
    "        adjusted[\n",
    "            ::-1\n",
    "        ]\n",
    "    )[\n",
    "        ::-1\n",
    "    ]\n",
    "\n",
    "\n",
    "    adjusted = np.clip(\n",
    "        adjusted,\n",
    "        0,\n",
    "        1,\n",
    "    )\n",
    "\n",
    "\n",
    "    result = np.empty(\n",
    "        n,\n",
    "        dtype=float,\n",
    "    )\n",
    "\n",
    "\n",
    "    result[\n",
    "        order\n",
    "    ] = adjusted\n",
    "\n",
    "\n",
    "    return result\n",
    "\n",
    "\n",
    "tested[\n",
    "    \"PD_AH_FDR\"\n",
    "] = benjamini_hochberg(\n",
    "    tested[\n",
    "        \"PD_AH_pvalue\"\n",
    "    ]\n",
    "    .to_numpy()\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 12. SUPPORT FLAGS\n",
    "# ============================================================\n",
    "\n",
    "tested[\n",
    "    \"PD_AH_nominal_P05\"\n",
    "] = (\n",
    "\n",
    "    tested[\n",
    "        \"PD_AH_pvalue\"\n",
    "    ]\n",
    "    <\n",
    "    0.05\n",
    ")\n",
    "\n",
    "\n",
    "tested[\n",
    "    \"PD_AH_FDR05\"\n",
    "] = (\n",
    "\n",
    "    tested[\n",
    "        \"PD_AH_FDR\"\n",
    "    ]\n",
    "    <\n",
    "    0.05\n",
    ")\n",
    "\n",
    "\n",
    "tested[\n",
    "    \"PD_AH_FDR05_abs_effect_gt1\"\n",
    "] = (\n",
    "\n",
    "    tested[\n",
    "        \"PD_AH_FDR05\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    (\n",
    "        np.abs(\n",
    "            tested[\n",
    "                \"PD_AH_log2RFU_diff\"\n",
    "            ]\n",
    "        )\n",
    "        >\n",
    "        1\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "tested[\n",
    "    \"PD_AH_FDR05_abs_effect_gt2\"\n",
    "] = (\n",
    "\n",
    "    tested[\n",
    "        \"PD_AH_FDR05\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    (\n",
    "        np.abs(\n",
    "            tested[\n",
    "                \"PD_AH_log2RFU_diff\"\n",
    "            ]\n",    "        )\n",
    "        >\n",
    "        2\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 13. VERIFY EXPECTED TEST OUTPUT\n",
    "#\n",
    "# These counts were independently reproduced against the\n",
    "# uploaded mmc3.xlsx before this cell was provided.\n",
    "# ============================================================\n",
    "\n",
    "n_nominal = int(\n",
    "    tested[\n",
    "        \"PD_AH_nominal_P05\"\n",
    "    ].sum()\n",
    ")\n",
    "\n",
    "\n",
    "n_fdr = int(\n",
    "    tested[\n",
    "        \"PD_AH_FDR05\"\n",
    "    ].sum()\n",
    ")\n",
    "\n",
    "\n",
    "n_fdr_1 = int(\n",
    "    tested[\n",
    "        \"PD_AH_FDR05_abs_effect_gt1\"\n",
    "    ].sum()\n",
    ")\n",
    "\n",
    "\n",
    "n_fdr_2 = int(\n",
    "    tested[\n",
    "        \"PD_AH_FDR05_abs_effect_gt2\"\n",
    "    ].sum()\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PD AQUEOUS-HUMOR DIFFERENTIAL RESULTS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Proteins tested:\",\n",
    "    f\"{len(tested):,}\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Nominal P < 0.05:\",\n",
    "    f\"{n_nominal:,}\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"BH FDR < 0.05:\",\n",
    "    f\"{n_fdr:,}\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"FDR < 0.05 and |effect| > 1:\",\n",
    "    f\"{n_fdr_1:,}\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"FDR < 0.05 and |effect| > 2:\",\n",
    "    f\"{n_fdr_2:,}\"\n",
    ")\n",
    "\n",
    "\n",
    "assert n_nominal == 2713, (\n",
    "    f\"Unexpected nominal-hit count: {n_nominal}\"\n",
    ")\n",
    "\n",
    "\n",
    "assert n_fdr == 1803, (\n",
    "    f\"Unexpected FDR-hit count: {n_fdr}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 14. SAVE COMPLETE WOLF GENE-EFFECT TABLE\n",
    "# ============================================================\n",
    "\n",
    "WOLF_EFFECT_PATH = (\n",
    "    OUT\n",
    "    / \"Wolf_PD_AQUEOUS_HUMOR_WELCH_GENE_EFFECTS_v3.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "wolf = tested[\n",
    "    [\n",
    "        \"gene_symbol\",\n",
    "        \"UniProt\",\n",
    "        \"PD_AH_mean_Control\",\n",
    "        \"PD_AH_mean_PD\",\n",
    "        \"PD_AH_log2RFU_diff\",\n",
    "        \"PD_AH_Welch_t\",\n",
    "        \"PD_AH_pvalue\",\n",
    "        \"PD_AH_FDR\",\n",
    "        \"PD_AH_nominal_P05\",\n",
    "        \"PD_AH_FDR05\",\n",
    "        \"PD_AH_FDR05_abs_effect_gt1\",\n",
    "        \"PD_AH_FDR05_abs_effect_gt2\",\n",
    "    ]\n",
    "].copy()\n",
    "\n",
    "\n",
    "wolf.to_csv(\n",
    "    WOLF_EFFECT_PATH,\n",
    "    index=False,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 15. LOAD FROZEN BRAIN CONVERGENCE\n",
    "# ============================================================\n",
    "\n",
    "conv = pd.read_csv(\n",
    "    CONVERGENCE_PATH,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "required = {\n",
    "    \"cell_type\",\n",
    "    \"gene_symbol\",\n",
    "    \"log2FoldChange_AD\",\n",
    "    \"log2FoldChange_PD\",\n",
    "}\n",
    "\n",
    "\n",
    "missing_required = (\n",
    "    required\n",
    "    -\n",
    "    set(\n",
    "        conv.columns\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert not missing_required, (\n",
    "    \"Missing brain-convergence columns: \"\n",
    "    f\"{sorted(missing_required)}\"\n",
    ")\n",
    "\n",
    "\n",
    "conv[\n",
    "    \"gene_symbol\"\n",
    "] = (\n",
    "    conv[\n",
    "        \"gene_symbol\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .str.upper()\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "\n",
    "conv[\n",
    "    \"log2FoldChange_PD\"\n",
    "] = pd.to_numeric(\n",
    "    conv[\n",
    "        \"log2FoldChange_PD\"\n",
    "    ],\n",
    "    errors=\"coerce\",\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 16. MERGE PD AQUEOUS-HUMOR DATA WITH BRAIN DATA\n",
    "# ============================================================\n",
    "\n",
    "evidence = conv.merge(\n",
    "    wolf,\n",
    "    on=\"gene_symbol\",\n",
    "    how=\"left\",\n",
    "    validate=\"many_to_one\",\n",
    ")\n",
    "\n",
    "\n",
    "evidence[\n",
    "    \"PD_aqueous_measured\"\n",
    "] = (\n",
    "    evidence[\n",
    "        \"PD_AH_log2RFU_diff\"\n",
    "    ]\n",
    "    .notna()\n",
    ")\n",
    "\n",
    "\n",
    "valid_direction = (\n",
    "\n",
    "    evidence[\n",
    "        \"PD_aqueous_measured\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    evidence[\n",
    "        \"log2FoldChange_PD\"\n",
    "    ]\n",
    "    .notna()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "evidence[\n",
    "    \"PD_aqueous_same_direction_as_PD_brain\"\n",
    "] = False\n",
    "\n",
    "\n",
    "evidence.loc[\n",
    "    valid_direction,\n",
    "    \"PD_aqueous_same_direction_as_PD_brain\"\n",
    "] = (\n",
    "\n",
    "    np.sign(\n",
    "        evidence.loc[\n",
    "            valid_direction,\n",
    "            \"PD_AH_log2RFU_diff\",\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    ==\n",
    "\n",
    "    np.sign(\n",
    "        evidence.loc[\n",
    "            valid_direction,\n",
    "            \"log2FoldChange_PD\",\n",
    "        ]\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 17. SUPPORT DEFINITIONS\n",
    "# ============================================================\n",
    "\n",
    "evidence[\n",
    "    \"PD_aqueous_nominal_support\"\n",
    "] = (\n",
    "\n",
    "    evidence[\n",
    "        \"PD_aqueous_measured\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    (\n",
    "        evidence[\n",
    "            \"PD_AH_pvalue\"\n",
    "        ]\n",
    "        <\n",
    "        0.05\n",
    "    )\n",
    "\n",
    "    &\n",
    "\n",
    "    evidence[\n",
    "        \"PD_aqueous_same_direction_as_PD_brain\"\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "evidence[\n",
    "    \"PD_aqueous_FDR_support\"\n",
    "] = (\n",
    "\n",
    "    evidence[\n",
    "        \"PD_aqueous_measured\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    (\n",
    "        evidence[\n",
    "            \"PD_AH_FDR\"\n",
    "        ]\n",
    "        <\n",
    "        0.05\n",
    "    )\n",
    "\n",
    "    &\n",
    "\n",
    "    evidence[\n",
    "        \"PD_aqueous_same_direction_as_PD_brain\"\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "evidence[\n",
    "    \"PD_aqueous_strong_support\"\n",
    "] = (\n",
    "\n",
    "    evidence[\n",
    "        \"PD_aqueous_FDR_support\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    (\n",
    "        np.abs(\n",
    "            evidence[\n",
    "                \"PD_AH_log2RFU_diff\"\n",
    "            ]\n",
    "        )\n",
    "        >\n",
    "        1\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 18. SAVE BRAIN ↔ PD AQUEOUS-HUMOR EVIDENCE\n",
    "# ============================================================\n",
    "\n",
    "EVIDENCE_PATH = (\n",
    "    OUT\n",
    "    / \"AD_PD_BRAIN_CONVERGENCE_WOLF_PD_AQUEOUS_SUPPORT_v3.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "evidence.to_csv(\n",
    "    EVIDENCE_PATH,\n",
    "    index=False,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 19. CELL-TYPE SUMMARY\n",
    "# ============================================================\n",
    "\n",
    "summary = (\n",
    "\n",
    "    evidence\n",
    "    .groupby(\n",
    "        \"cell_type\",\n",
    "        as_index=False,\n",
    "    )\n",
    "    .agg(\n",
    "\n",
    "        brain_convergence_genes=(\n",
    "            \"gene_symbol\",\n",
    "            \"size\",\n",
    "        ),\n",
    "\n",
    "        PD_aqueous_protein_measured=(\n",
    "            \"PD_aqueous_measured\",\n",
    "            \"sum\",\n",
    "        ),\n",
    "\n",
    "        same_PD_direction=(\n",
    "            \"PD_aqueous_same_direction_as_PD_brain\",\n",
    "            \"sum\",\n",
    "        ),\n",
    "\n",
    "        PD_aqueous_nominal_support=(\n",
    "            \"PD_aqueous_nominal_support\",\n",
    "            \"sum\",\n",
    "        ),\n",
    "\n",
    "        PD_aqueous_FDR_support=(\n",
    "            \"PD_aqueous_FDR_support\",\n",
    "            \"sum\",\n",
    "        ),\n",
    "\n",
    "        PD_aqueous_strong_support=(\n",
    "            \"PD_aqueous_strong_support\",\n",
    "            \"sum\",\n",
    "        ),\n",
    "\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "SUMMARY_PATH = (\n",
    "    OUT\n",
    "    / \"AD_PD_BRAIN_CONVERGENCE_WOLF_PD_AQUEOUS_SUMMARY_v3.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "summary.to_csv(\n",
    "    SUMMARY_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 20. FREEZE / PROVENANCE\n",
    "# ============================================================\n",
    "\n",
    "LOCK_PATH = (\n",
    "    LOCKS\n",
    "    / \"WOLF_CELL_2023_PD_AQUEOUS_SUPPORT_FREEZE_v3.json\"\n",
    ")\n",
    "\n",
    "\n",
    "record = {\n",
    "\n",
    "    \"status\":\n",
    "        \"WOLF_CELL_2023_PD_AQUEOUS_SUPPORT_FROZEN\",\n",
    "\n",
    "    \"dataset\":\n",
    "        \"Wolf et al. Cell 2023 Table S7\",\n",
    "\n",
    "    \"sheet\":\n",
    "        \"Supplement_table_all_data\",\n",
    "\n",
    "    \"controls\":\n",
    "        CONTROL_COLS,\n",
    "\n",
    "    \"PD\":\n",
    "        PD_COLS,\n",
    "\n",
    "    \"n_controls\":\n",
    "        19,\n",
    "\n",
    "    \"n_PD\":\n",
    "        5,\n",
    "\n",
    "    \"mapped_proteins\":\n",
    "        6344,\n",
    "\n",
    "    \"detected_mapped_proteins\":\n",
    "        5691,\n",
    "\n",
    "    \"statistical_test\":\n",
    "        \"Welch two-sample t-test\",\n",
    "\n",
    "    \"multiple_testing\":\n",
    "        \"Benjamini-Hochberg FDR\",\n",
    "\n",
    "    \"important_method_note\":\n",
    "        (\n",
    "            \"Independent validation reanalysis. \"\n",
    "            \"Not an exact reproduction of the paper's \"\n",
    "            \"robust limma model.\"\n",
    "        ),\n",
    "\n",
    "    \"zeros_retained\":\n",
    "        True,\n",
    "\n",
    "    \"additional_log_transform\":\n",
    "        False,\n",
    "\n",
    "    \"protein_effect_table\":\n",
    "        str(\n",
    "            WOLF_EFFECT_PATH\n",
    "        ),\n",
    "\n",
    "    \"brain_aqueous_evidence\":\n",
    "        str(\n",
    "            EVIDENCE_PATH\n",
    "        ),\n",
    "\n",
    "    \"summary\":\n",
    "        str(\n",
    "            SUMMARY_PATH\n",
    "        ),\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    LOCK_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        record,\n",
    "        f,\n",
    "        indent=2,\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 21. FINAL REPORT\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"WOLF PD AQUEOUS-HUMOR SUPPORT ANALYSIS COMPLETE\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    summary\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nTop 30 aqueous-humor differences:\"\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "\n",
    "    wolf\n",
    "    .sort_values(\n",
    "        [\n",
    "            \"PD_AH_FDR\",\n",
    "            \"PD_AH_pvalue\",\n",
    "        ],\n",
    "        ascending=True,\n",
    "    )\n",
    "    .head(\n",
    "        30\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nProtein-level effects:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    WOLF_EFFECT_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nBrain ↔ aqueous-humor evidence:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    EVIDENCE_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFreeze record:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    LOCK_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nNEXT:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Build the combined final evidence matrix.\"\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Part VII — Multimodal integration and candidate ranking\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 75\n",
    "# ============================================================\n",
    "# V3 CORE MULTIMODAL EVIDENCE MATRIX\n",
    "#\n",
    "# COMPLETE REPLACEMENT FOR THE OLD\n",
    "# \"FINAL EVIDENCE-MATRIX SCAFFOLD\"\n",
    "#\n",
    "# Integrates:\n",
    "#\n",
    "#   1. AD ↔ PD brain gene-effect convergence\n",
    "#   2. healthy human retinal expression — GSE148077\n",
    "#   3. AD retinal proteomics — PXD073336\n",
    "#   4. PD aqueous-humor proteomics — Wolf et al.\n",
    "#   5. Reactome pathway-convergence summary, if available\n",
    "#\n",
    "# IMPORTANT\n",
    "# ---------\n",
    "# This is the CORE evidence matrix.\n",
    "#\n",
    "# Optional AMD specificity / second AD-retina / plasma datasets\n",
    "# are NOT required for this matrix and are not silently treated\n",
    "# as negative evidence.\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "from pathlib import Path\n",
    "import json\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = ROOT / \"locks\"\n",
    "\n",
    "FINAL_DIR = (\n",
    "    ROOT\n",
    "    / \"results\"\n",
    "    / \"final_evidence\"\n",
    ")\n",
    "\n",
    "FINAL_DIR.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "LOCKS.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# CORE INPUTS\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "BRAIN_PATH = (\n",
    "    ROOT\n",
    "    / \"results\"\n",
    "    / \"cross_disease_convergence\"\n",
    "    / \"AD_PD_ALL_GENE_CONVERGENCE_v2.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "RETINA_EXPR_PATH = (\n",
    "    ROOT\n",
    "    / \"retina_reference\"\n",
    "    / \"GSE148077\"\n",
    "    / \"GSE148077_BRAIN_CONVERGENCE_RETINAL_EXPRESSION_SUMMARY_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "AD_RETINA_PATH = (\n",
    "    ROOT\n",
    "    / \"ocular_validation\"\n",
    "    / \"PXD073336\"\n",
    "    / \"analysis\"\n",
    "    / \"PXD073336_AD_RETINA_INTERNAL_GENE_EFFECTS_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "PD_AQUEOUS_PATH = (\n",
    "    ROOT\n",
    "    / \"ocular_validation\"\n",
    "    / \"Wolf_Cell_2023\"\n",
    "    / \"analysis\"\n",
    "    / \"Wolf_PD_AQUEOUS_HUMOR_WELCH_GENE_EFFECTS_v3.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "PATHWAY_SUMMARY_PATH = (\n",
    "    ROOT\n",
    "    / \"results\"\n",
    "    / \"cross_disease_convergence\"\n",
    "    / \"AD_PD_REACTOME_V97_PATHWAY_SUMMARY_v1.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. REQUIRED FILE CHECKS\n",
    "# ============================================================\n",
    "\n",
    "required_files = {\n",
    "\n",
    "    \"brain convergence\":\n",
    "        BRAIN_PATH,\n",
    "\n",
    "    \"retinal expression\":\n",
    "        RETINA_EXPR_PATH,\n",
    "\n",
    "    \"AD retina\":\n",
    "        AD_RETINA_PATH,\n",
    "\n",
    "    \"PD aqueous humor\":\n",
    "        PD_AQUEOUS_PATH,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "for label, path in required_files.items():\n",
    "\n",
    "    assert path.exists(), (\n",
    "        f\"Missing required {label} file:\\n{path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"RETINA_ND — CORE MULTIMODAL EVIDENCE MATRIX\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "for label, path in required_files.items():\n",
    "\n",
    "    print(\n",
    "        f\"{label}:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \" \",\n",
    "        path\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. LOAD BRAIN CONVERGENCE\n",
    "# ============================================================\n",
    "\n",
    "brain = pd.read_csv(\n",
    "    BRAIN_PATH,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "required_brain = {\n",
    "\n",
    "    \"cell_type\",\n",
    "    \"gene_symbol\",\n",
    "    \"log2FoldChange_AD\",\n",
    "    \"log2FoldChange_PD\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "missing = (\n",
    "    required_brain\n",
    "    -\n",
    "    set(\n",
    "        brain.columns\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert not missing, (\n",
    "    f\"Missing brain columns: {sorted(missing)}\"\n",
    ")\n",
    "\n",
    "\n",
    "brain[\n",
    "    \"gene_symbol\"\n",
    "] = (\n",
    "    brain[\n",
    "        \"gene_symbol\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .str.upper()\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "\n",
    "brain[\n",
    "    \"log2FoldChange_AD\"\n",
    "] = pd.to_numeric(\n",
    "    brain[\n",
    "        \"log2FoldChange_AD\"\n",
    "    ],\n",
    "    errors=\"coerce\",\n",
    ")\n",
    "\n",
    "\n",
    "brain[\n",
    "    \"log2FoldChange_PD\"\n",
    "] = pd.to_numeric(\n",
    "    brain[\n",
    "        \"log2FoldChange_PD\"\n",
    "    ],\n",
    "    errors=\"coerce\",\n",
    ")\n",
    "\n",
    "\n",
    "# If same_direction is absent for any reason, recreate it.\n",
    "if \"same_direction\" not in brain.columns:\n",
    "\n",
    "    valid = (\n",
    "\n",
    "        brain[\n",
    "            \"log2FoldChange_AD\"\n",
    "        ]\n",
    "        .notna()\n",
    "\n",
    "        &\n",
    "\n",
    "        brain[\n",
    "            \"log2FoldChange_PD\"\n",
    "        ]\n",
    "        .notna()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    brain[\n",
    "        \"same_direction\"\n",
    "    ] = False\n",
    "\n",
    "\n",
    "    brain.loc[\n",
    "        valid,\n",
    "        \"same_direction\"\n",
    "    ] = (\n",
    "\n",
    "        np.sign(\n",
    "            brain.loc[\n",
    "                valid,\n",
    "                \"log2FoldChange_AD\",\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        ==\n",
    "\n",
    "        np.sign(\n",
    "            brain.loc[\n",
    "                valid,\n",
    "                \"log2FoldChange_PD\",\n",
    "            ]\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "brain = brain.rename(\n",
    "    columns={\n",
    "        \"same_direction\":\n",
    "            \"brain_AD_PD_same_direction\"\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nBrain rows:\",\n",
    "    f\"{len(brain):,}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. HEALTHY HUMAN RETINA EXPRESSION\n",
    "# ============================================================\n",
    "\n",
    "retina_expr = pd.read_csv(\n",
    "    RETINA_EXPR_PATH,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    \"gene_symbol\"\n",
    "    in retina_expr.columns\n",
    ")\n",
    "\n",
    "\n",
    "retina_expr[\n",
    "    \"gene_symbol\"\n",
    "] = (\n",
    "    retina_expr[\n",
    "        \"gene_symbol\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .str.upper()\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "\n",
    "assert not retina_expr[\n",
    "    \"gene_symbol\"\n",
    "].duplicated().any()\n",
    "\n",
    "\n",
    "retina_keep = [\n",
    "\n",
    "    c\n",
    "\n",
    "    for c in [\n",
    "\n",
    "        \"gene_symbol\",\n",
    "        \"retinal_donors_detected\",\n",
    "        \"retinal_positive_cells\",\n",
    "        \"retinal_total_counts\",\n",
    "        \"retina_expression\",\n",
    "\n",
    "    ]\n",
    "\n",
    "    if c in retina_expr.columns\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "retina_expr = retina_expr[\n",
    "    retina_keep\n",
    "].copy()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. AD RETINA — PXD073336\n",
    "# ============================================================\n",
    "\n",
    "ad_retina = pd.read_csv(\n",
    "    AD_RETINA_PATH,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    \"gene_symbol\"\n",
    "    in ad_retina.columns\n",
    ")\n",
    "\n",
    "\n",
    "ad_retina[\n",
    "    \"gene_symbol\"\n",
    "] = (\n",
    "    ad_retina[\n",
    "        \"gene_symbol\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .str.upper()\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "\n",
    "assert not ad_retina[\n",
    "    \"gene_symbol\"\n",
    "].duplicated().any()\n",
    "\n",
    "\n",
    "ad_keep = [\n",
    "\n",
    "    c\n",
    "\n",
    "    for c in [\n",
    "\n",
    "        \"gene_symbol\",\n",
    "\n",
    "        \"protein_rows\",\n",
    "\n",
    "        \"AD_donors_measured\",\n",
    "\n",
    "        \"Control_donors_measured\",\n",
    "\n",
    "        \"tested\",\n",
    "\n",
    "        \"retina_AD_vs_Control_log2FC\",\n",
    "\n",
    "        \"retina_t_stat\",\n",
    "\n",
    "        \"retina_pvalue\",\n",
    "\n",
    "        \"retina_FDR\",\n",
    "\n",
    "        \"Lysis_AD_vs_Control_log2FC\",\n",
    "\n",
    "        \"RIPA_AD_vs_Control_log2FC\",\n",
    "\n",    "        \"buffer_direction_consistent\",\n",
    "\n",
    "        \"retina_nominal_p_lt_0_05\",\n",
    "\n",
    "        \"retina_FDR_lt_0_05\",\n",
    "\n",
    "    ]\n",
    "\n",
    "    if c in ad_retina.columns\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "ad_retina = ad_retina[\n",
    "    ad_keep\n",
    "].copy()\n",
    "\n",
    "\n",
    "ad_retina = ad_retina.rename(\n",
    "    columns={\n",
    "\n",
    "        \"tested\":\n",
    "            \"AD_retina_protein_measured\",\n",
    "\n",
    "        \"retina_AD_vs_Control_log2FC\":\n",
    "            \"AD_retina_log2FC\",\n",
    "\n",
    "        \"retina_t_stat\":\n",
    "            \"AD_retina_t\",\n",
    "\n",
    "        \"retina_pvalue\":\n",
    "            \"AD_retina_pvalue\",\n",
    "\n",
    "        \"retina_FDR\":\n",
    "            \"AD_retina_FDR\",\n",
    "\n",
    "        \"buffer_direction_consistent\":\n",
    "            \"AD_retina_buffer_direction_consistent\",\n",
    "\n",
    "        \"retina_nominal_p_lt_0_05\":\n",
    "            \"AD_retina_nominal_P05\",\n",
    "\n",
    "        \"retina_FDR_lt_0_05\":\n",
    "            \"AD_retina_FDR05\",\n",
    "\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. PD AQUEOUS HUMOR — WOLF\n",
    "# ============================================================\n",
    "\n",
    "pd_aqueous = pd.read_csv(\n",
    "    PD_AQUEOUS_PATH,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    \"gene_symbol\"\n",
    "    in pd_aqueous.columns\n",
    ")\n",
    "\n",
    "\n",
    "pd_aqueous[\n",
    "    \"gene_symbol\"\n",
    "] = (\n",
    "    pd_aqueous[\n",
    "        \"gene_symbol\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .str.upper()\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "\n",
    "assert not pd_aqueous[\n",
    "    \"gene_symbol\"\n",
    "].duplicated().any()\n",
    "\n",
    "\n",
    "pd_keep = [\n",
    "\n",
    "    c\n",
    "\n",
    "    for c in [\n",
    "\n",
    "        \"gene_symbol\",\n",
    "\n",
    "        \"UniProt\",\n",
    "\n",
    "        \"PD_AH_mean_Control\",\n",
    "\n",
    "        \"PD_AH_mean_PD\",\n",
    "\n",
    "        \"PD_AH_log2RFU_diff\",\n",
    "\n",
    "        \"PD_AH_Welch_t\",\n",
    "\n",
    "        \"PD_AH_pvalue\",\n",
    "\n",
    "        \"PD_AH_FDR\",\n",
    "\n",
    "        \"PD_AH_nominal_P05\",\n",
    "\n",
    "        \"PD_AH_FDR05\",\n",
    "\n",
    "        \"PD_AH_FDR05_abs_effect_gt1\",\n",
    "\n",
    "        \"PD_AH_FDR05_abs_effect_gt2\",\n",
    "\n",
    "    ]\n",
    "\n",
    "    if c in pd_aqueous.columns\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "pd_aqueous = pd_aqueous[\n",
    "    pd_keep\n",
    "].copy()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. MERGE ALL GENE-LEVEL EVIDENCE\n",
    "# ============================================================\n",
    "\n",
    "evidence = (\n",
    "\n",
    "    brain\n",
    "\n",
    "    .merge(\n",
    "        retina_expr,\n",
    "        on=\"gene_symbol\",\n",
    "        how=\"left\",\n",
    "        validate=\"many_to_one\",\n",
    "    )\n",
    "\n",
    "    .merge(\n",
    "        ad_retina,\n",
    "        on=\"gene_symbol\",\n",
    "        how=\"left\",\n",
    "        validate=\"many_to_one\",\n",
    "    )\n",
    "\n",
    "    .merge(\n",
    "        pd_aqueous,\n",
    "        on=\"gene_symbol\",\n",
    "        how=\"left\",\n",
    "        validate=\"many_to_one\",\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    evidence\n",
    ") == len(\n",
    "    brain\n",
    "), (\n",
    "    \"Merge changed the number of brain-convergence rows.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. NORMALIZE BOOLEAN EVIDENCE\n",
    "# ============================================================\n",
    "\n",
    "boolean_columns = [\n",
    "\n",
    "    \"brain_AD_PD_same_direction\",\n",
    "\n",
    "    \"retina_expression\",\n",
    "\n",
    "    \"AD_retina_protein_measured\",\n",
    "\n",
    "    \"AD_retina_buffer_direction_consistent\",\n",
    "\n",
    "    \"AD_retina_nominal_P05\",\n",
    "\n",
    "    \"AD_retina_FDR05\",\n",
    "\n",
    "    \"PD_AH_nominal_P05\",\n",
    "\n",
    "    \"PD_AH_FDR05\",\n",
    "\n",
    "    \"PD_AH_FDR05_abs_effect_gt1\",\n",
    "\n",
    "    \"PD_AH_FDR05_abs_effect_gt2\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "for col in boolean_columns:\n",
    "\n",
    "    if col not in evidence.columns:\n",
    "\n",
    "        evidence[\n",
    "            col\n",
    "        ] = False\n",
    "\n",
    "    else:\n",
    "\n",
    "        evidence[\n",
    "            col\n",
    "        ] = (\n",
    "            evidence[\n",
    "                col\n",
    "            ]\n",
    "            .fillna(\n",
    "                False\n",
    "            )\n",
    "            .astype(\n",
    "                bool\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. PD AQUEOUS MEASURABILITY\n",
    "# ============================================================\n",
    "\n",
    "evidence[\n",
    "    \"PD_aqueous_protein_measured\"\n",
    "] = (\n",
    "    evidence[\n",
    "        \"PD_AH_log2RFU_diff\"\n",
    "    ]\n",
    "    .notna()\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. AD RETINA ↔ AD BRAIN DIRECTION\n",
    "# ============================================================\n",
    "\n",
    "ad_direction_mask = (\n",
    "\n",
    "    evidence[\n",
    "        \"AD_retina_protein_measured\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    evidence[\n",
    "        \"AD_retina_log2FC\"\n",
    "    ]\n",
    "    .notna()\n",
    "\n",
    "    &\n",
    "\n",
    "    evidence[\n",
    "        \"log2FoldChange_AD\"\n",
    "    ]\n",
    "    .notna()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "evidence[\n",
    "    \"AD_retina_same_direction_as_AD_brain\"\n",
    "] = False\n",
    "\n",
    "\n",
    "evidence.loc[\n",
    "    ad_direction_mask,\n",
    "    \"AD_retina_same_direction_as_AD_brain\"\n",
    "] = (\n",
    "\n",
    "    np.sign(\n",
    "        evidence.loc[\n",
    "            ad_direction_mask,\n",
    "            \"AD_retina_log2FC\",\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    ==\n",
    "\n",
    "    np.sign(\n",
    "        evidence.loc[\n",
    "            ad_direction_mask,\n",
    "            \"log2FoldChange_AD\",\n",
    "        ]\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. PD AQUEOUS ↔ PD BRAIN DIRECTION\n",
    "# ============================================================\n",
    "\n",
    "pd_direction_mask = (\n",
    "\n",
    "    evidence[\n",
    "        \"PD_aqueous_protein_measured\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    evidence[\n",
    "        \"PD_AH_log2RFU_diff\"\n",
    "    ]\n",
    "    .notna()\n",
    "\n",
    "    &\n",
    "\n",
    "    evidence[\n",
    "        \"log2FoldChange_PD\"\n",
    "    ]\n",
    "    .notna()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "evidence[\n",
    "    \"PD_aqueous_same_direction_as_PD_brain\"\n",
    "] = False\n",
    "\n",
    "\n",
    "evidence.loc[\n",
    "    pd_direction_mask,\n",
    "    \"PD_aqueous_same_direction_as_PD_brain\"\n",
    "] = (\n",
    "\n",
    "    np.sign(\n",
    "        evidence.loc[\n",
    "            pd_direction_mask,\n",
    "            \"PD_AH_log2RFU_diff\",\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    ==\n",
    "\n",
    "    np.sign(\n",
    "        evidence.loc[\n",
    "            pd_direction_mask,\n",
    "            \"log2FoldChange_PD\",\n",
    "        ]\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. SUPPORT FLAGS\n",
    "#\n",
    "# Keep statistics and directionality separate and transparent.\n",
    "# ============================================================\n",
    "\n",
    "evidence[\n",
    "    \"AD_retina_nominal_support\"\n",
    "] = (\n",
    "\n",
    "    evidence[\n",
    "        \"AD_retina_nominal_P05\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    evidence[\n",
    "        \"AD_retina_same_direction_as_AD_brain\"\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "evidence[\n",
    "    \"AD_retina_FDR_support\"\n",
    "] = (\n",
    "\n",
    "    evidence[\n",
    "        \"AD_retina_FDR05\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    evidence[\n",
    "        \"AD_retina_same_direction_as_AD_brain\"\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "evidence[\n",
    "    \"AD_retina_buffer_robust_support\"\n",
    "] = (\n",
    "\n",
    "    evidence[\n",
    "        \"AD_retina_nominal_support\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    evidence[\n",
    "        \"AD_retina_buffer_direction_consistent\"\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "evidence[\n",
    "    \"PD_aqueous_nominal_support\"\n",
    "] = (\n",
    "\n",
    "    evidence[\n",
    "        \"PD_AH_nominal_P05\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    evidence[\n",
    "        \"PD_aqueous_same_direction_as_PD_brain\"\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "evidence[\n",
    "    \"PD_aqueous_FDR_support\"\n",
    "] = (\n",
    "\n",
    "    evidence[\n",
    "        \"PD_AH_FDR05\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    evidence[\n",
    "        \"PD_aqueous_same_direction_as_PD_brain\"\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "evidence[\n",
    "    \"PD_aqueous_strong_support\"\n",
    "] = (\n",
    "\n",
    "    evidence[\n",
    "        \"PD_AH_FDR05_abs_effect_gt1\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    evidence[\n",
    "        \"PD_aqueous_same_direction_as_PD_brain\"\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 12. CROSS-MODAL FLAGS\n",
    "# ============================================================\n",
    "\n",
    "evidence[\n",
    "    \"both_ocular_proteins_measured\"\n",
    "] = (\n",
    "\n",
    "    evidence[\n",
    "        \"AD_retina_protein_measured\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    evidence[\n",
    "        \"PD_aqueous_protein_measured\"\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "evidence[\n",
    "    \"both_ocular_same_disease_direction\"\n",
    "] = (\n",
    "\n",
    "    evidence[\n",
    "        \"AD_retina_same_direction_as_AD_brain\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    evidence[\n",
    "        \"PD_aqueous_same_direction_as_PD_brain\"\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "evidence[\n",
    "    \"dual_ocular_nominal_support\"\n",
    "] = (\n",
    "\n",
    "    evidence[\n",
    "        \"AD_retina_nominal_support\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    evidence[\n",
    "        \"PD_aqueous_nominal_support\"\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "evidence[\n",
    "    \"dual_ocular_FDR_support\"\n",
    "] = (\n",
    "\n",
    "    evidence[\n",
    "        \"AD_retina_FDR_support\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    evidence[\n",
    "        \"PD_aqueous_FDR_support\"\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 13. CORE MULTIMODAL SUPPORT\n",
    "#\n",
    "# These are evidence combinations, NOT a new statistical test.\n",
    "# ============================================================\n",
    "\n",
    "evidence[\n",
    "    \"multimodal_directional_support\"\n",
    "] = (\n",
    "\n",
    "    evidence[\n",
    "        \"brain_AD_PD_same_direction\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    evidence[\n",
    "        \"retina_expression\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    evidence[\n",
    "        \"both_ocular_same_disease_direction\"\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "evidence[\n",
    "    \"multimodal_nominal_support\"\n",
    "] = (\n",
    "\n",
    "    evidence[\n",
    "        \"brain_AD_PD_same_direction\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    evidence[\n",
    "        \"retina_expression\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    evidence[\n",
    "        \"dual_ocular_nominal_support\"\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "evidence[\n",
    "    \"multimodal_FDR_support\"\n",
    "] = (\n",
    "\n",
    "    evidence[\n",
    "        \"brain_AD_PD_same_direction\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    evidence[\n",
    "        \"retina_expression\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    evidence[\n",
    "        \"dual_ocular_FDR_support\"\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 14. OPTIONAL REACTOME CELL-CLASS SUMMARY\n",
    "#\n",
    "# Pathways are cell-type-level evidence, not gene-level\n",
    "# statistics, so we only append the summary metrics.\n",
    "# ============================================================\n",
    "\n",
    "PATHWAY_INCLUDED = False\n",
    "\n",
    "\n",
    "if PATHWAY_SUMMARY_PATH.exists():\n",
    "\n",
    "    pathway_summary = pd.read_csv(\n",
    "        PATHWAY_SUMMARY_PATH\n",
    "    )\n",
    "\n",
    "\n",
    "    if (\n",
    "        \"cell_type\"\n",
    "        in pathway_summary.columns\n",
    "    ):\n",
    "\n",
    "        pathway_cols = [\n",
    "\n",
    "            c\n",
    "\n",
    "            for c in [\n",
    "\n",
    "                \"cell_type\",\n",
    "\n",
    "                \"matched_pathways\",\n",
    "\n",
    "                \"concordant_pathways\",\n",
    "\n",
    "                \"convergent_FDR05_pathways\",\n",
    "\n",
    "            ]\n",
    "\n",
    "            if c in pathway_summary.columns\n",
    "\n",
    "        ]\n",
    "\n",
    "\n",
    "        pathway_summary = (\n",
    "            pathway_summary[\n",
    "                pathway_cols\n",
    "            ]\n",
    "            .drop_duplicates(\n",
    "                subset=[\n",
    "                    \"cell_type\"\n",
    "                ]\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "        evidence = evidence.merge(\n",
    "            pathway_summary,\n",
    "            on=\"cell_type\",\n",
    "            how=\"left\",\n",
    "            validate=\"many_to_one\",\n",
    "        )\n",
    "\n",
    "\n",
    "        PATHWAY_INCLUDED = True\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 15. EVIDENCE CLASS\n",
    "#\n",
    "# This is intentionally rule-based and transparent.\n",
    "# It is NOT a probability and NOT a statistical FDR.\n",
    "# ============================================================\n",
    "\n",
    "conditions = [\n",
    "\n",
    "    evidence[\n",
    "        \"multimodal_FDR_support\"\n",
    "    ],\n",
    "\n",
    "    evidence[\n",
    "        \"multimodal_nominal_support\"\n",
    "    ],\n",
    "\n",
    "    evidence[\n",
    "        \"multimodal_directional_support\"\n",
    "    ],\n",
    "\n",
    "    (\n",
    "        evidence[\n",
    "            \"brain_AD_PD_same_direction\"\n",
    "        ]\n",
    "\n",
    "        &\n",
    "\n",
    "        evidence[\n",
    "            \"retina_expression\"\n",
    "        ]\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            evidence[\n",
    "                \"AD_retina_FDR_support\"\n",
    "            ]\n",
    "\n",
    "            |\n",
    "\n",
    "            evidence[\n",
    "                \"PD_aqueous_FDR_support\"\n",
    "            ]\n",
    "        )\n",
    "    ),\n",
    "\n",
    "    (\n",
    "        evidence[\n",
    "            \"brain_AD_PD_same_direction\"\n",
    "        ]\n",
    "\n",
    "        &\n",
    "\n",
    "        evidence[\n",
    "            \"retina_expression\"\n",
    "        ]\n",
    "    ),\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "labels = [\n",
    "\n",
    "    \"A_dual_ocular_FDR\",\n",
    "\n",
    "    \"B_dual_ocular_nominal\",\n",
    "\n",
    "    \"C_dual_ocular_directional\",\n",
    "\n",
    "    \"D_single_ocular_FDR\",\n",
    "\n",
    "    \"E_brain_plus_retina_expression\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "evidence[\n",
    "    \"core_evidence_class\"\n",
    "] = np.select(\n",
    "    conditions,\n",
    "    labels,\n",
    "    default=\n",
    "        \"F_other_brain_convergence\",\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 16. SORT FOR HUMAN REVIEW\n",
    "#\n",
    "# No opaque numerical score.\n",
    "# ============================================================\n",
    "\n",
    "class_order = {\n",
    "\n",
    "    \"A_dual_ocular_FDR\":\n",
    "        1,\n",
    "\n",
    "    \"B_dual_ocular_nominal\":\n",
    "        2,\n",
    "\n",
    "    \"C_dual_ocular_directional\":\n",
    "        3,\n",
    "\n",
    "    \"D_single_ocular_FDR\":\n",
    "        4,\n",
    "\n",
    "    \"E_brain_plus_retina_expression\":\n",
    "        5,\n",
    "\n",
    "    \"F_other_brain_convergence\":\n",
    "        6,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "evidence[\n",
    "    \"_class_order\"\n",
    "] = (\n",
    "    evidence[\n",
    "        \"core_evidence_class\"\n",
    "    ]\n",
    "    .map(\n",
    "        class_order\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# Conservative combined effect magnitude for sorting only.\n",
    "evidence[\n",
    "    \"_brain_min_abs_effect\"\n",
    "] = np.minimum(\n",
    "\n",
    "    np.abs(\n",
    "        evidence[\n",
    "            \"log2FoldChange_AD\"\n",
    "        ]\n",
    "    ),\n",
    "\n",
    "    np.abs(\n",
    "        evidence[\n",
    "            \"log2FoldChange_PD\"\n",
    "        ]\n",
    "    ),\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "evidence = evidence.sort_values(\n",
    "    [\n",
    "\n",
    "        \"_class_order\",\n",
    "\n",
    "        \"cell_type\",\n",
    "\n",
    "        \"_brain_min_abs_effect\",\n",
    "\n",
    "    ],\n",
    "    ascending=[\n",
    "        True,\n",
    "        True,\n",
    "        False,\n",
    "    ],\n",
    ").reset_index(\n",
    "    drop=True\n",
    ")\n",
    "\n",
    "\n",
    "evidence = evidence.drop(\n",
    "    columns=[\n",
    "        \"_class_order\",\n",
    "        \"_brain_min_abs_effect\",\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 17. SAVE COMPLETE CORE EVIDENCE MATRIX\n",
    "# ============================================================\n",
    "\n",
    "MATRIX_PATH = (\n",
    "    FINAL_DIR\n",
    "    / \"RETINA_ND_CORE_MULTIMODAL_EVIDENCE_MATRIX_v3.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "evidence.to_csv(\n",
    "    MATRIX_PATH,\n",
    "    index=False,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 18. HIGHER-EVIDENCE SHORTLIST\n",
    "#\n",
    "# Includes classes A-D only.\n",
    "#\n",
    "# This is a review shortlist, NOT a final biological claim.\n",
    "# ============================================================\n",
    "\n",
    "shortlist = evidence.loc[\n",
    "    evidence[\n",
    "        \"core_evidence_class\"\n",
    "    ]\n",
    "    .isin(\n",
    "        [\n",
    "\n",
    "            \"A_dual_ocular_FDR\",\n",
    "\n",
    "            \"B_dual_ocular_nominal\",\n",
    "\n",
    "            \"C_dual_ocular_directional\",\n",
    "\n",
    "            \"D_single_ocular_FDR\",\n",
    "\n",
    "        ]\n",
    "    )\n",
    "].copy()\n",
    "\n",
    "\n",
    "SHORTLIST_PATH = (\n",
    "    FINAL_DIR\n",
    "    / \"RETINA_ND_CORE_MULTIMODAL_SHORTLIST_v3.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "shortlist.to_csv(\n",
    "    SHORTLIST_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 19. CELL-TYPE SUMMARY\n",
    "# ============================================================\n",
    "\n",
    "summary = (\n",
    "\n",
    "    evidence\n",
    "    .groupby(\n",
    "        \"cell_type\",\n",
    "        as_index=False,\n",
    "    )\n",
    "    .agg(\n",
    "\n",
    "        genes=(\n",
    "            \"gene_symbol\",\n",
    "            \"size\",\n",
    "        ),\n",
    "\n",
    "        brain_AD_PD_same_direction=(\n",
    "            \"brain_AD_PD_same_direction\",\n",
    "            \"sum\",\n",
    "        ),\n",
    "\n",
    "        retina_expressed=(\n",
    "            \"retina_expression\",\n",
    "            \"sum\",\n",
    "        ),\n",
    "\n",
    "        AD_retina_measured=(\n",
    "            \"AD_retina_protein_measured\",\n",
    "            \"sum\",\n",
    "        ),\n",
    "\n",
    "        PD_aqueous_measured=(\n",
    "            \"PD_aqueous_protein_measured\",\n",
    "            \"sum\",\n",
    "        ),\n",
    "\n",
    "        both_ocular_measured=(\n",
    "            \"both_ocular_proteins_measured\",\n",
    "            \"sum\",\n",
    "        ),\n",
    "\n",
    "        dual_ocular_directional=(\n",
    "            \"both_ocular_same_disease_direction\",\n",
    "            \"sum\",\n",
    "        ),\n",
    "\n",
    "        AD_retina_nominal_support=(\n",
    "            \"AD_retina_nominal_support\",\n",
    "            \"sum\",\n",
    "        ),\n",
    "\n",
    "        AD_retina_FDR_support=(\n",
    "            \"AD_retina_FDR_support\",\n",
    "            \"sum\",\n",
    "        ),\n",
    "\n",
    "        PD_aqueous_nominal_support=(\n",
    "            \"PD_aqueous_nominal_support\",\n",
    "            \"sum\",\n",
    "        ),\n",
    "\n",
    "        PD_aqueous_FDR_support=(\n",
    "            \"PD_aqueous_FDR_support\",\n",
    "            \"sum\",\n",
    "        ),\n",
    "\n",
    "        dual_ocular_nominal_support=(\n",
    "            \"dual_ocular_nominal_support\",\n",
    "            \"sum\",\n",
    "        ),\n",
    "\n",
    "        dual_ocular_FDR_support=(\n",
    "            \"dual_ocular_FDR_support\",\n",
    "            \"sum\",\n",
    "        ),\n",
    "\n",
    "        multimodal_directional_support=(\n",
    "            \"multimodal_directional_support\",\n",
    "            \"sum\",\n",
    "        ),\n",
    "\n",
    "        multimodal_nominal_support=(\n",
    "            \"multimodal_nominal_support\",\n",
    "            \"sum\",\n",
    "        ),\n",
    "\n",
    "        multimodal_FDR_support=(\n",
    "            \"multimodal_FDR_support\",\n",
    "            \"sum\",\n",
    "        ),\n",
    "\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "SUMMARY_PATH = (\n",
    "    FINAL_DIR\n",
    "    / \"RETINA_ND_CORE_MULTIMODAL_EVIDENCE_SUMMARY_v3.csv\"\n",    ")\n",
    "\n",
    "\n",
    "summary.to_csv(\n",
    "    SUMMARY_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 20. EVIDENCE-CLASS COUNTS\n",
    "# ============================================================\n",
    "\n",
    "class_summary = (\n",
    "\n",
    "    evidence\n",
    "    .groupby(\n",
    "        [\n",
    "            \"cell_type\",\n",
    "            \"core_evidence_class\",\n",
    "        ],\n",
    "        as_index=False,\n",
    "    )\n",
    "    .size()\n",
    "    .rename(\n",
    "        columns={\n",
    "            \"size\":\n",
    "                \"n_genes\"\n",
    "        }\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "CLASS_SUMMARY_PATH = (\n",
    "    FINAL_DIR\n",
    "    / \"RETINA_ND_CORE_EVIDENCE_CLASS_COUNTS_v3.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "class_summary.to_csv(\n",
    "    CLASS_SUMMARY_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 21. FREEZE / PROVENANCE\n",
    "# ============================================================\n",
    "\n",
    "LOCK_PATH = (\n",
    "    LOCKS\n",
    "    / \"RETINA_ND_CORE_MULTIMODAL_EVIDENCE_FREEZE_v3.json\"\n",
    ")\n",
    "\n",
    "\n",
    "record = {\n",
    "\n",
    "    \"status\":\n",
    "        \"RETINA_ND_CORE_MULTIMODAL_EVIDENCE_FROZEN\",\n",
    "\n",
    "    \"brain_convergence\":\n",
    "        str(\n",
    "            BRAIN_PATH\n",
    "        ),\n",
    "\n",
    "    \"healthy_retina_expression\":\n",
    "        str(\n",
    "            RETINA_EXPR_PATH\n",
    "        ),\n",
    "\n",
    "    \"AD_retina_proteomics\":\n",
    "        str(\n",
    "            AD_RETINA_PATH\n",
    "        ),\n",
    "\n",
    "    \"PD_aqueous_proteomics\":\n",
    "        str(\n",
    "            PD_AQUEOUS_PATH\n",
    "        ),\n",
    "\n",
    "    \"reactome_summary_included\":\n",
    "        bool(\n",
    "            PATHWAY_INCLUDED\n",
    "        ),\n",
    "\n",
    "    \"reactome_summary\":\n",
    "        (\n",
    "            str(\n",
    "                PATHWAY_SUMMARY_PATH\n",
    "            )\n",
    "            if PATHWAY_INCLUDED\n",
    "            else None\n",
    "        ),\n",
    "\n",
    "    \"core_matrix\":\n",
    "        str(\n",
    "            MATRIX_PATH\n",
    "        ),\n",
    "\n",
    "    \"review_shortlist\":\n",
    "        str(\n",
    "            SHORTLIST_PATH\n",
    "        ),\n",
    "\n",
    "    \"summary\":\n",
    "        str(\n",
    "            SUMMARY_PATH\n",
    "        ),\n",
    "\n",
    "    \"evidence_class_counts\":\n",
    "        str(\n",
    "            CLASS_SUMMARY_PATH\n",
    "        ),\n",
    "\n",
    "    \"important_interpretation\":\n",
    "        (\n",
    "            \"Evidence classes combine independent evidence \"\n",
    "            \"layers for prioritization. They are not p-values, \"\n",
    "            \"posterior probabilities, or formal statistical \"\n",
    "            \"significance levels.\"\n",
    "        ),\n",
    "\n",
    "    \"optional_specificity_layers_included\":\n",
    "        False,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    LOCK_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        record,\n",
    "        f,\n",
    "        indent=2,\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 22. FINAL REPORT\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"CORE MULTIMODAL EVIDENCE MATRIX COMPLETE\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nRows:\",\n",
    "    f\"{len(evidence):,}\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Higher-evidence shortlist rows:\",\n",
    "    f\"{len(shortlist):,}\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nReactome summary included:\",\n",
    "    PATHWAY_INCLUDED\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nCELL-TYPE SUMMARY\"\n",
    ")\n",
    "\n",
    "display(\n",
    "    summary\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nEVIDENCE-CLASS COUNTS\"\n",
    ")\n",
    "\n",
    "display(\n",
    "    class_summary\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nTOP SHORTLIST ROWS\"\n",
    ")\n",
    "\n",
    "\n",
    "short_display_cols = [\n",
    "\n",
    "    c\n",
    "\n",
    "    for c in [\n",
    "\n",
    "        \"cell_type\",\n",
    "\n",
    "        \"gene_symbol\",\n",
    "\n",
    "        \"core_evidence_class\",\n",
    "\n",
    "        \"log2FoldChange_AD\",\n",
    "\n",
    "        \"log2FoldChange_PD\",\n",
    "\n",
    "        \"retina_expression\",\n",
    "\n",
    "        \"AD_retina_log2FC\",\n",
    "\n",
    "        \"AD_retina_pvalue\",\n",
    "\n",
    "        \"AD_retina_FDR\",\n",
    "\n",
    "        \"PD_AH_log2RFU_diff\",\n",
    "\n",
    "        \"PD_AH_pvalue\",\n",
    "\n",
    "        \"PD_AH_FDR\",\n",
    "\n",
    "        \"AD_retina_same_direction_as_AD_brain\",\n",
    "\n",
    "        \"PD_aqueous_same_direction_as_PD_brain\",\n",
    "\n",
    "    ]\n",
    "\n",
    "    if c in shortlist.columns\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "display(\n",
    "    shortlist[\n",
    "        short_display_cols\n",
    "    ].head(\n",
    "        50\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nCore evidence matrix:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    MATRIX_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nHigher-evidence shortlist:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    SHORTLIST_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSummary:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    SUMMARY_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFreeze record:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    LOCK_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nNEXT:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Inspect the resulting evidence classes and build the \"\n",
    "    \"final candidate/module ranking plus publication figures.\"\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 76\n",
    "# ============================================================\n",
    "# V4 UNIQUE-GENE MULTIMODAL CANDIDATE RANKING\n",
    "#\n",
    "# PURPOSE\n",
    "# -------\n",
    "# Collapse the cell-type-level multimodal evidence matrix\n",
    "# into ONE ROW PER UNIQUE GENE.\n",
    "#\n",
    "# This cell does NOT invent an arbitrary weighted score.\n",
    "#\n",
    "# Ranking is hierarchical and transparent:\n",
    "#\n",
    "#   1. strongest evidence class observed\n",
    "#   2. recurrence of that evidence across glial cell types\n",
    "#   3. number of AD↔PD-concordant glial cell types\n",
    "#   4. conservative brain-effect magnitude\n",
    "#\n",
    "# Evidence classes already defined:\n",
    "#\n",
    "# A = dual ocular FDR support\n",
    "# B = dual ocular nominal support\n",
    "# C = dual ocular directional support\n",
    "# D = single ocular FDR support\n",
    "# E = brain convergence + retinal expression\n",
    "# F = other brain convergence\n",
    "#\n",
    "# IMPORTANT:\n",
    "# These are prioritization categories, not statistical\n",
    "# significance grades.\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "from pathlib import Path\n",
    "import json\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "FINAL_DIR = (\n",
    "    ROOT\n",
    "    / \"results\"\n",
    "    / \"final_evidence\"\n",
    ")\n",
    "\n",
    "LOCKS = (\n",
    "    ROOT\n",
    "    / \"locks\"\n",
    ")\n",
    "\n",
    "FINAL_DIR.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "LOCKS.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "\n",
    "INPUT_PATH = (\n",
    "    FINAL_DIR\n",
    "    / \"RETINA_ND_CORE_MULTIMODAL_EVIDENCE_MATRIX_v3.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "assert INPUT_PATH.exists(), (\n",
    "    f\"Missing multimodal evidence matrix:\\n{INPUT_PATH}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. LOAD FINAL CELL-TYPE MATRIX\n",
    "# ============================================================\n",
    "\n",
    "e = pd.read_csv(\n",
    "    INPUT_PATH,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"RETINA_ND — UNIQUE-GENE CANDIDATE RANKING\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nInput rows:\",\n",
    "    f\"{len(e):,}\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Unique genes:\",\n",
    "    f\"{e['gene_symbol'].nunique():,}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. REQUIRED COLUMNS\n",
    "# ============================================================\n",
    "\n",
    "required = {\n",
    "\n",
    "    \"cell_type\",\n",
    "\n",
    "    \"gene_symbol\",\n",
    "\n",
    "    \"core_evidence_class\",\n",
    "\n",
    "    \"log2FoldChange_AD\",\n",
    "\n",
    "    \"log2FoldChange_PD\",\n",
    "\n",
    "    \"brain_AD_PD_same_direction\",\n",
    "\n",
    "    \"retina_expression\",\n",
    "\n",
    "    \"AD_retina_same_direction_as_AD_brain\",\n",
    "\n",
    "    \"PD_aqueous_same_direction_as_PD_brain\",\n",
    "\n",
    "    \"AD_retina_nominal_support\",\n",
    "\n",
    "    \"AD_retina_FDR_support\",\n",
    "\n",
    "    \"PD_aqueous_nominal_support\",\n",
    "\n",
    "    \"PD_aqueous_FDR_support\",\n",
    "\n",
    "    \"multimodal_directional_support\",\n",
    "\n",
    "    \"multimodal_nominal_support\",\n",
    "\n",
    "    \"multimodal_FDR_support\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "missing = (\n",
    "    required\n",
    "    -\n",
    "    set(\n",
    "        e.columns\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert not missing, (\n",
    "    f\"Missing required columns:\\n{sorted(missing)}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. STANDARDIZE GENE SYMBOLS\n",
    "# ============================================================\n",
    "\n",
    "e[\n",
    "    \"gene_symbol\"\n",
    "] = (\n",
    "    e[\n",
    "        \"gene_symbol\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .str.upper()\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. CLASS HIERARCHY\n",
    "# ============================================================\n",
    "\n",
    "CLASS_ORDER = {\n",
    "\n",
    "    \"A_dual_ocular_FDR\":\n",
    "        1,\n",
    "\n",
    "    \"B_dual_ocular_nominal\":\n",
    "        2,\n",
    "\n",
    "    \"C_dual_ocular_directional\":\n",
    "        3,\n",
    "\n",
    "    \"D_single_ocular_FDR\":\n",
    "        4,\n",
    "\n",
    "    \"E_brain_plus_retina_expression\":\n",
    "        5,\n",
    "\n",
    "    \"F_other_brain_convergence\":\n",
    "        6,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "CLASS_FROM_RANK = {\n",
    "\n",
    "    value:\n",
    "        key\n",
    "\n",
    "    for key, value\n",
    "    in CLASS_ORDER.items()\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "e[\n",
    "    \"_class_rank\"\n",
    "] = (\n",
    "    e[\n",
    "        \"core_evidence_class\"\n",
    "    ]\n",
    "    .map(\n",
    "        CLASS_ORDER\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert e[\n",
    "    \"_class_rank\"\n",
    "].notna().all()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. CONSERVATIVE BRAIN EFFECT PER CELL TYPE\n",
    "#\n",
    "# Use the smaller absolute effect across AD and PD.\n",
    "#\n",
    "# Example:\n",
    "# AD = -0.8\n",
    "# PD = -0.3\n",
    "#\n",
    "# conservative magnitude = 0.3\n",
    "#\n",
    "# This prevents one disease with a very large effect from\n",
    "# dominating a weak effect in the other disease.\n",
    "# ============================================================\n",
    "\n",
    "e[\n",
    "    \"_conservative_brain_abs_effect\"\n",
    "] = np.minimum(\n",
    "\n",
    "    np.abs(\n",
    "        pd.to_numeric(\n",
    "            e[\n",
    "                \"log2FoldChange_AD\"\n",
    "            ],\n",
    "            errors=\"coerce\",\n",
    "        )\n",
    "    ),\n",
    "\n",
    "    np.abs(\n",
    "        pd.to_numeric(\n",
    "            e[\n",
    "                \"log2FoldChange_PD\"\n",
    "            ],\n",
    "            errors=\"coerce\",\n",
    "        )\n",
    "    ),\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. SAFE FIRST-NON-NULL HELPER\n",
    "#\n",
    "# Ocular measurements are gene-level and therefore repeat\n",
    "# across the four brain cell-type rows.\n",
    "# We take the value once rather than treating those repeats\n",
    "# as independent observations.\n",
    "# ============================================================\n",
    "\n",
    "def first_non_null(\n",
    "    series\n",
    "):\n",
    "\n",
    "    z = series.dropna()\n",
    "\n",
    "    if len(\n",
    "        z\n",
    "    ) == 0:\n",
    "\n",
    "        return np.nan\n",
    "\n",
    "    return z.iloc[\n",
    "        0\n",
    "    ]\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. BUILD ONE ROW PER UNIQUE GENE\n",
    "# ============================================================\n",
    "\n",
    "rows = []\n",
    "\n",
    "\n",
    "for gene, g in e.groupby(\n",
    "    \"gene_symbol\",\n",
    "    sort=False,\n",
    "):\n",
    "\n",
    "\n",
    "    cell_types = sorted(\n",
    "        g[\n",
    "            \"cell_type\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .unique()\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_cell_types = len(\n",
    "        cell_types\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Evidence-class counts\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    counts = (\n",
    "        g[\n",
    "            \"core_evidence_class\"\n",
    "        ]\n",
    "        .value_counts()\n",
    "        .to_dict()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_A = int(\n",
    "        counts.get(\n",
    "            \"A_dual_ocular_FDR\",\n",
    "            0,\n",
    "        )\n",
    "    )\n",
    "\n",
    "    n_B = int(\n",
    "        counts.get(\n",
    "            \"B_dual_ocular_nominal\",\n",
    "            0,\n",
    "        )\n",
    "    )\n",
    "\n",
    "    n_C = int(\n",
    "        counts.get(\n",
    "            \"C_dual_ocular_directional\",\n",
    "            0,\n",
    "        )\n",
    "    )\n",
    "\n",
    "    n_D = int(\n",
    "        counts.get(\n",
    "            \"D_single_ocular_FDR\",\n",
    "            0,\n",
    "        )\n",
    "    )\n",
    "\n",
    "    n_E = int(\n",
    "        counts.get(\n",
    "            \"E_brain_plus_retina_expression\",\n",
    "            0,\n",
    "        )\n",
    "    )\n",
    "\n",
    "    n_F = int(\n",
    "        counts.get(\n",
    "            \"F_other_brain_convergence\",\n",
    "            0,\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Best observed evidence class\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    best_rank = int(\n",
    "        g[\n",
    "            \"_class_rank\"\n",
    "        ]\n",
    "        .min()\n",
    "    )\n",
    "\n",
    "\n",
    "    best_class = CLASS_FROM_RANK[\n",
    "        best_rank\n",
    "    ]\n",
    "\n",
    "\n",
    "    n_best_class = int(\n",
    "        (\n",
    "            g[\n",
    "                \"_class_rank\"\n",
    "            ]\n",
    "            ==\n",
    "            best_rank\n",
    "        )\n",
    "        .sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Brain recurrence\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    n_brain_concordant = int(\n",
    "        g[\n",
    "            \"brain_AD_PD_same_direction\"\n",
    "        ]\n",
    "        .fillna(\n",
    "            False\n",
    "        )\n",
    "        .sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    brain_concordant_all_celltypes = (\n",
    "\n",
    "        n_brain_concordant\n",
    "        ==\n",
    "        n_cell_types\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Conservative brain magnitude\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    brain_effects = (\n",
    "\n",
    "        g[\n",
    "            \"_conservative_brain_abs_effect\"\n",
    "        ]\n",
    "        .dropna()\n",
    "    )\n",
    "\n",
    "\n",
    "    if len(\n",
    "        brain_effects\n",
    "    ) > 0:\n",
    "\n",
    "        median_conservative_brain_effect = float(\n",
    "            brain_effects.median()\n",
    "        )\n",
    "\n",
    "        max_conservative_brain_effect = float(\n",
    "            brain_effects.max()\n",
    "        )\n",
    "\n",
    "    else:\n",
    "\n",
    "        median_conservative_brain_effect = np.nan\n",
    "\n",
    "        max_conservative_brain_effect = np.nan\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Disease-specific brain effect summaries\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    median_AD_brain_log2FC = float(\n",
    "        pd.to_numeric(\n",
    "            g[\n",
    "                \"log2FoldChange_AD\"\n",
    "            ],\n",
    "            errors=\"coerce\",\n",
    "        )\n",
    "        .median()\n",
    "    )\n",
    "\n",
    "\n",
    "    median_PD_brain_log2FC = float(\n",
    "        pd.to_numeric(\n",
    "            g[\n",
    "                \"log2FoldChange_PD\"\n",
    "            ],\n",
    "            errors=\"coerce\",\n",
    "        )\n",
    "        .median()\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Exact cell-type evidence signature\n",
    "    #\n",
    "    # Example:\n",
    "    #\n",
    "    # Astro:B | Micro:B | OPC:B | Oligo:B\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    signature_parts = []\n",
    "\n",
    "\n",
    "    for _, r in (\n",
    "        g.sort_values(\n",
    "            \"cell_type\"\n",
    "        )\n",
    "        .iterrows()\n",
    "    ):\n",
    "\n",
    "        short_class = (\n",
    "            str(\n",
    "                r[\n",
    "                    \"core_evidence_class\"\n",
    "                ]\n",
    "            )\n",
    "            .split(\n",
    "                \"_\",\n",
    "                1\n",
    "            )[\n",
    "                0\n",
    "            ]\n",
    "        )\n",
    "\n",
    "\n",
    "        signature_parts.append(\n",
    "\n",
    "            f\"{r['cell_type']}:{short_class}\"\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "    celltype_signature = \" | \".join(\n",
    "        signature_parts\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Ocular gene-level data\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    AD_retina_log2FC = first_non_null(\n",
    "        g[\n",
    "            \"AD_retina_log2FC\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    AD_retina_pvalue = first_non_null(\n",
    "        g[\n",
    "            \"AD_retina_pvalue\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    AD_retina_FDR = first_non_null(\n",
    "        g[\n",
    "            \"AD_retina_FDR\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    PD_AH_effect = first_non_null(\n",
    "        g[\n",
    "            \"PD_AH_log2RFU_diff\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    PD_AH_pvalue = first_non_null(\n",
    "        g[\n",
    "            \"PD_AH_pvalue\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    PD_AH_FDR = first_non_null(\n",
    "        g[\n",
    "            \"PD_AH_FDR\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Evidence recurrence\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    n_AD_retina_same_direction = int(\n",
    "        g[\n",
    "            \"AD_retina_same_direction_as_AD_brain\"\n",
    "        ]\n",
    "        .fillna(\n",
    "            False\n",
    "        )\n",
    "        .sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_PD_aqueous_same_direction = int(\n",
    "        g[\n",
    "            \"PD_aqueous_same_direction_as_PD_brain\"\n",
    "        ]\n",
    "        .fillna(\n",
    "            False\n",
    "        )\n",
    "        .sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_multimodal_directional = int(\n",
    "        g[\n",
    "            \"multimodal_directional_support\"\n",
    "        ]\n",
    "        .fillna(\n",
    "            False\n",
    "        )\n",
    "        .sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_multimodal_nominal = int(\n",
    "        g[\n",
    "            \"multimodal_nominal_support\"\n",
    "        ]\n",
    "        .fillna(\n",
    "            False\n",
    "        )\n",
    "        .sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_multimodal_FDR = int(\n",
    "        g[\n",
    "            \"multimodal_FDR_support\"\n",
    "        ]\n",
    "        .fillna(\n",
    "            False\n",
    "        )\n",
    "        .sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Transparent priority label\n",
    "    #\n",
    "    # This is NOT a probability or statistical score.\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    if n_A >= 2:\n",
    "\n",
    "        priority = (\n",
    "            \"P0_recurrent_dual_ocular_FDR\"\n",
    "        )\n",
    "\n",
    "\n",
    "    elif n_A == 1:\n",
    "\n",
    "        priority = (\n",
    "            \"P0_single_dual_ocular_FDR\"\n",
    "        )\n",
    "\n",
    "\n",
    "    elif n_B >= 2:\n",
    "\n",
    "        priority = (\n",
    "            \"P1_recurrent_dual_ocular_nominal\"\n",
    "        )\n",
    "\n",
    "\n",
    "    elif n_B == 1:\n",
    "\n",
    "        priority = (\n",
    "            \"P2_single_dual_ocular_nominal\"\n",
    "        )\n",
    "\n",
    "\n",
    "    elif n_C >= 2:\n",
    "\n",
    "        priority = (\n",
    "            \"P3_recurrent_dual_ocular_directional\"\n",
    "        )\n",
    "\n",
    "\n",
    "    elif n_C == 1:\n",
    "\n",
    "        priority = (\n",
    "            \"P4_single_dual_ocular_directional\"\n",    "        )\n",
    "\n",
    "\n",
    "    elif n_D >= 1:\n",
    "\n",
    "        priority = (\n",
    "            \"P5_single_ocular_FDR\"\n",
    "        )\n",
    "\n",
    "\n",
    "    elif n_E >= 1:\n",
    "\n",
    "        priority = (\n",
    "            \"P6_brain_plus_retina_expression\"\n",
    "        )\n",
    "\n",
    "\n",
    "    else:\n",
    "\n",
    "        priority = (\n",
    "            \"P7_other\"\n",
    "        )\n",
    "\n",
    "\n",
    "    rows.append(\n",
    "        {\n",
    "\n",
    "            \"gene_symbol\":\n",
    "                gene,\n",
    "\n",
    "            \"priority_group\":\n",
    "                priority,\n",
    "\n",
    "            \"best_evidence_class\":\n",
    "                best_class,\n",
    "\n",
    "            \"best_evidence_rank\":\n",
    "                best_rank,\n",
    "\n",
    "            \"n_cell_types_present\":\n",
    "                n_cell_types,\n",
    "\n",
    "            \"cell_types\":\n",
    "                \";\".join(\n",
    "                    cell_types\n",
    "                ),\n",
    "\n",
    "            \"celltype_evidence_signature\":\n",
    "                celltype_signature,\n",
    "\n",
    "            # -------------------------\n",
    "            # class recurrence\n",
    "            # -------------------------\n",
    "\n",
    "            \"n_class_A\":\n",
    "                n_A,\n",
    "\n",
    "            \"n_class_B\":\n",
    "                n_B,\n",
    "\n",
    "            \"n_class_C\":\n",
    "                n_C,\n",
    "\n",
    "            \"n_class_D\":\n",
    "                n_D,\n",
    "\n",
    "            \"n_class_E\":\n",
    "                n_E,\n",
    "\n",
    "            \"n_class_F\":\n",
    "                n_F,\n",
    "\n",
    "            \"n_best_class_celltypes\":\n",
    "                n_best_class,\n",
    "\n",
    "            # -------------------------\n",
    "            # brain evidence\n",
    "            # -------------------------\n",
    "\n",
    "            \"n_brain_AD_PD_concordant_celltypes\":\n",
    "                n_brain_concordant,\n",
    "\n",
    "            \"brain_concordant_all_present_celltypes\":\n",
    "                brain_concordant_all_celltypes,\n",
    "\n",
    "            \"median_AD_brain_log2FC\":\n",
    "                median_AD_brain_log2FC,\n",
    "\n",
    "            \"median_PD_brain_log2FC\":\n",
    "                median_PD_brain_log2FC,\n",
    "\n",
    "            \"median_conservative_brain_abs_effect\":\n",
    "                median_conservative_brain_effect,\n",
    "\n",
    "            \"max_conservative_brain_abs_effect\":\n",
    "                max_conservative_brain_effect,\n",
    "\n",
    "            # -------------------------\n",
    "            # healthy retina\n",
    "            # -------------------------\n",
    "\n",
    "            \"retina_expression\":\n",
    "                bool(\n",
    "                    g[\n",
    "                        \"retina_expression\"\n",
    "                    ]\n",
    "                    .fillna(\n",
    "                        False\n",
    "                    )\n",
    "                    .any()\n",
    "                ),\n",
    "\n",
    "            \"retinal_donors_detected\":\n",
    "                first_non_null(\n",
    "                    g[\n",
    "                        \"retinal_donors_detected\"\n",
    "                    ]\n",
    "                )\n",
    "                if\n",
    "                \"retinal_donors_detected\"\n",
    "                in g.columns\n",
    "                else np.nan,\n",
    "\n",
    "            # -------------------------\n",
    "            # AD retinal proteomics\n",
    "            # -------------------------\n",
    "\n",
    "            \"AD_retina_log2FC\":\n",
    "                AD_retina_log2FC,\n",
    "\n",
    "            \"AD_retina_pvalue\":\n",
    "                AD_retina_pvalue,\n",
    "\n",
    "            \"AD_retina_FDR\":\n",
    "                AD_retina_FDR,\n",
    "\n",
    "            \"AD_retina_FDR_support_any_celltype\":\n",
    "                bool(\n",
    "                    g[\n",
    "                        \"AD_retina_FDR_support\"\n",
    "                    ]\n",
    "                    .fillna(\n",
    "                        False\n",
    "                    )\n",
    "                    .any()\n",
    "                ),\n",
    "\n",
    "            \"n_AD_retina_same_direction_celltypes\":\n",
    "                n_AD_retina_same_direction,\n",
    "\n",
    "            # -------------------------\n",
    "            # PD aqueous proteomics\n",
    "            # -------------------------\n",
    "\n",
    "            \"PD_AH_log2RFU_diff\":\n",
    "                PD_AH_effect,\n",
    "\n",
    "            \"PD_AH_pvalue\":\n",
    "                PD_AH_pvalue,\n",
    "\n",
    "            \"PD_AH_FDR\":\n",
    "                PD_AH_FDR,\n",
    "\n",
    "            \"PD_aqueous_FDR_support_any_celltype\":\n",
    "                bool(\n",
    "                    g[\n",
    "                        \"PD_aqueous_FDR_support\"\n",
    "                    ]\n",
    "                    .fillna(\n",
    "                        False\n",
    "                    )\n",
    "                    .any()\n",
    "                ),\n",
    "\n",
    "            \"n_PD_aqueous_same_direction_celltypes\":\n",
    "                n_PD_aqueous_same_direction,\n",
    "\n",
    "            # -------------------------\n",
    "            # combined evidence\n",
    "            # -------------------------\n",
    "\n",
    "            \"n_multimodal_directional_celltypes\":\n",
    "                n_multimodal_directional,\n",
    "\n",
    "            \"n_multimodal_nominal_celltypes\":\n",
    "                n_multimodal_nominal,\n",
    "\n",
    "            \"n_multimodal_FDR_celltypes\":\n",
    "                n_multimodal_FDR,\n",
    "\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "ranking = pd.DataFrame(\n",
    "    rows\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. PRIORITY ORDER\n",
    "# ============================================================\n",
    "\n",
    "PRIORITY_ORDER = {\n",
    "\n",
    "    \"P0_recurrent_dual_ocular_FDR\":\n",
    "        0,\n",
    "\n",
    "    \"P0_single_dual_ocular_FDR\":\n",
    "        1,\n",
    "\n",
    "    \"P1_recurrent_dual_ocular_nominal\":\n",
    "        2,\n",
    "\n",
    "    \"P2_single_dual_ocular_nominal\":\n",
    "        3,\n",
    "\n",
    "    \"P3_recurrent_dual_ocular_directional\":\n",
    "        4,\n",
    "\n",
    "    \"P4_single_dual_ocular_directional\":\n",
    "        5,\n",
    "\n",
    "    \"P5_single_ocular_FDR\":\n",
    "        6,\n",
    "\n",
    "    \"P6_brain_plus_retina_expression\":\n",
    "        7,\n",
    "\n",
    "    \"P7_other\":\n",
    "        8,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "ranking[\n",
    "    \"_priority_rank\"\n",
    "] = (\n",
    "    ranking[\n",
    "        \"priority_group\"\n",
    "    ]\n",
    "    .map(\n",
    "        PRIORITY_ORDER\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. FINAL SORT\n",
    "#\n",
    "# No opaque score.\n",
    "#\n",
    "# Ranking hierarchy:\n",
    "#\n",
    "# 1. evidence category\n",
    "# 2. recurrence of best evidence across cell types\n",
    "# 3. total AD↔PD-concordant cell types\n",
    "# 4. conservative brain effect\n",
    "# ============================================================\n",
    "\n",
    "ranking = ranking.sort_values(\n",
    "    [\n",
    "\n",
    "        \"_priority_rank\",\n",
    "\n",
    "        \"n_best_class_celltypes\",\n",
    "\n",
    "        \"n_brain_AD_PD_concordant_celltypes\",\n",
    "\n",
    "        \"median_conservative_brain_abs_effect\",\n",
    "\n",
    "        \"gene_symbol\",\n",
    "\n",
    "    ],\n",
    "\n",
    "    ascending=[\n",
    "\n",
    "        True,\n",
    "\n",
    "        False,\n",
    "\n",
    "        False,\n",
    "\n",
    "        False,\n",
    "\n",
    "        True,\n",
    "\n",
    "    ],\n",
    "\n",
    ").reset_index(\n",
    "    drop=True\n",
    ")\n",
    "\n",
    "\n",
    "ranking.insert(\n",
    "    0,\n",
    "    \"candidate_rank\",\n",
    "    np.arange(\n",
    "        1,\n",
    "        len(\n",
    "            ranking\n",
    "        )\n",
    "        +\n",
    "        1\n",
    "    ),\n",
    ")\n",
    "\n",
    "\n",
    "ranking = ranking.drop(\n",
    "    columns=[\n",
    "        \"_priority_rank\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. SAVE FULL UNIQUE-GENE RANKING\n",
    "# ============================================================\n",
    "\n",
    "RANKING_PATH = (\n",
    "    FINAL_DIR\n",
    "    / \"RETINA_ND_UNIQUE_GENE_CANDIDATE_RANKING_v4.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "ranking.to_csv(\n",
    "    RANKING_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. CLASS-B UNIQUE CANDIDATES\n",
    "#\n",
    "# These represent the strongest class actually observed in\n",
    "# the current data because Class A contains zero genes.\n",
    "# ============================================================\n",
    "\n",
    "class_B = ranking.loc[\n",
    "    ranking[\n",
    "        \"n_class_B\"\n",
    "    ]\n",
    "    >\n",
    "    0\n",
    "].copy()\n",
    "\n",
    "\n",
    "CLASS_B_PATH = (\n",
    "    FINAL_DIR\n",
    "    / \"RETINA_ND_CLASS_B_UNIQUE_CANDIDATES_v4.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "class_B.to_csv(\n",
    "    CLASS_B_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 12. TOP-100 REVIEW TABLE\n",
    "# ============================================================\n",
    "\n",
    "top100 = ranking.head(\n",
    "    100\n",
    ").copy()\n",
    "\n",
    "\n",
    "TOP100_PATH = (\n",
    "    FINAL_DIR\n",
    "    / \"RETINA_ND_TOP100_CANDIDATES_v4.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "top100.to_csv(\n",
    "    TOP100_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 13. PRIORITY-GROUP SUMMARY\n",
    "# ============================================================\n",
    "\n",
    "priority_summary = (\n",
    "\n",
    "    ranking[\n",
    "        \"priority_group\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .rename_axis(\n",
    "        \"priority_group\"\n",
    "    )\n",
    "    .reset_index(\n",
    "        name=\"n_unique_genes\"\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "PRIORITY_SUMMARY_PATH = (\n",
    "    FINAL_DIR\n",
    "    / \"RETINA_ND_PRIORITY_GROUP_COUNTS_v4.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "priority_summary.to_csv(\n",
    "    PRIORITY_SUMMARY_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 14. FREEZE\n",
    "# ============================================================\n",
    "\n",
    "LOCK_PATH = (\n",
    "    LOCKS\n",
    "    / \"RETINA_ND_UNIQUE_GENE_RANKING_FREEZE_v4.json\"\n",
    ")\n",
    "\n",
    "\n",
    "record = {\n",
    "\n",
    "    \"status\":\n",
    "        \"RETINA_ND_UNIQUE_GENE_RANKING_FROZEN\",\n",
    "\n",
    "    \"input_matrix\":\n",
    "        str(\n",
    "            INPUT_PATH\n",
    "        ),\n",
    "\n",
    "    \"ranking_method\":\n",
    "        (\n",
    "            \"Hierarchical transparent ranking: \"\n",
    "            \"evidence class -> recurrence across cell types \"\n",
    "            \"-> AD/PD brain concordance recurrence \"\n",
    "            \"-> conservative brain effect magnitude.\"\n",
    "        ),\n",
    "\n",
    "    \"opaque_weighted_score_used\":\n",
    "        False,\n",
    "\n",
    "    \"full_ranking\":\n",
    "        str(\n",
    "            RANKING_PATH\n",
    "        ),\n",
    "\n",
    "    \"class_B_candidates\":\n",
    "        str(\n",
    "            CLASS_B_PATH\n",
    "        ),\n",
    "\n",
    "    \"top100\":\n",
    "        str(\n",
    "            TOP100_PATH\n",
    "        ),\n",
    "\n",
    "    \"priority_summary\":\n",
    "        str(\n",
    "            PRIORITY_SUMMARY_PATH\n",
    "        ),\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    LOCK_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        record,\n",
    "        f,\n",
    "        indent=2,\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 15. REPORT\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"UNIQUE-GENE CANDIDATE RANKING COMPLETE\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nUnique genes ranked:\",\n",
    "    f\"{len(ranking):,}\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPRIORITY GROUP COUNTS\"\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    priority_summary\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"CLASS-B UNIQUE CANDIDATES\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "class_B_display = [\n",
    "\n",
    "    \"candidate_rank\",\n",
    "\n",
    "    \"gene_symbol\",\n",
    "\n",
    "    \"priority_group\",\n",
    "\n",
    "    \"n_class_B\",\n",
    "\n",
    "    \"n_class_C\",\n",
    "\n",
    "    \"n_class_D\",\n",
    "\n",
    "    \"celltype_evidence_signature\",\n",
    "\n",
    "    \"n_brain_AD_PD_concordant_celltypes\",\n",
    "\n",
    "    \"median_AD_brain_log2FC\",\n",
    "\n",
    "    \"median_PD_brain_log2FC\",\n",
    "\n",
    "    \"AD_retina_log2FC\",\n",
    "\n",
    "    \"AD_retina_pvalue\",\n",
    "\n",
    "    \"AD_retina_FDR\",\n",
    "\n",
    "    \"PD_AH_log2RFU_diff\",\n",
    "\n",
    "    \"PD_AH_pvalue\",\n",
    "\n",
    "    \"PD_AH_FDR\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "display(\n",
    "    class_B[\n",
    "        class_B_display\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"TOP 30 UNIQUE GENES\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "top_display = [\n",
    "\n",
    "    \"candidate_rank\",\n",
    "\n",
    "    \"gene_symbol\",\n",
    "\n",
    "    \"priority_group\",\n",
    "\n",
    "    \"best_evidence_class\",\n",
    "\n",
    "    \"n_best_class_celltypes\",\n",
    "\n",
    "    \"celltype_evidence_signature\",\n",
    "\n",
    "    \"n_brain_AD_PD_concordant_celltypes\",\n",
    "\n",
    "    \"median_conservative_brain_abs_effect\",\n",
    "\n",
    "    \"AD_retina_log2FC\",\n",
    "\n",
    "    \"AD_retina_pvalue\",\n",
    "\n",
    "    \"PD_AH_log2RFU_diff\",\n",
    "\n",
    "    \"PD_AH_pvalue\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "display(\n",
    "    ranking[\n",
    "        top_display\n",
    "    ]\n",
    "    .head(\n",
    "        30\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFull ranking:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    RANKING_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nClass-B table:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    CLASS_B_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nTop-100 table:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    TOP100_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFreeze record:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    LOCK_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nNEXT:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Rank convergent biological pathways/modules, then \"\n",
    "    \"generate the final publication figures and tables.\"\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 77\n",
    "# ============================================================\n",
    "# V5 FINAL REACTOME PATHWAY / MODULE PRIORITIZATION\n",
    "#\n",
    "# PURPOSE\n",
    "# -------\n",
    "# Convert the already-completed Reactome AD↔PD enrichment\n",
    "# analysis into publication-ready biological interpretation.\n",
    "#\n",
    "# Produces:\n",
    "#\n",
    "#   1. one row per unique Reactome pathway\n",
    "#   2. recurrence across Astro / Micro / OPC / Oligo\n",
    "#   3. shared AD-PD leading-edge genes\n",
    "#   4. connection to ranked multimodal candidate genes\n",
    "#   5. redundancy-reduced pathway modules\n",
    "#\n",
    "# IMPORTANT\n",
    "# ---------\n",
    "# No new enrichment is performed here.\n",
    "#\n",
    "# We only summarize / prioritize the Reactome analysis that\n",
    "# has already been completed and frozen.\n",
    "#\n",
    "# Module clustering is descriptive redundancy reduction,\n",
    "# NOT a new statistical significance test.\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "from pathlib import Path\n",
    "import json\n",
    "import re\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "CONV_DIR = (\n",
    "    ROOT\n",
    "    / \"results\"\n",
    "    / \"cross_disease_convergence\"\n",
    ")\n",
    "\n",
    "FINAL_DIR = (\n",
    "    ROOT\n",
    "    / \"results\"\n",
    "    / \"final_evidence\"\n",
    ")\n",
    "\n",
    "LOCKS = (\n",
    "    ROOT\n",
    "    / \"locks\"\n",
    ")\n",
    "\n",
    "FINAL_DIR.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "LOCKS.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "\n",
    "PATHWAY_PATH = (\n",
    "    CONV_DIR\n",
    "    / \"AD_PD_REACTOME_V97_PATHWAY_CONVERGENCE_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "RAW_GSEA_PATH = (\n",
    "    CONV_DIR\n",
    "    / \"AD_PD_REACTOME_V97_PRERANK_ALL_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "GENE_RANKING_PATH = (\n",
    "    FINAL_DIR\n",
    "    / \"RETINA_ND_UNIQUE_GENE_CANDIDATE_RANKING_v4.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "assert PATHWAY_PATH.exists(), (\n",
    "    f\"Missing pathway convergence file:\\n{PATHWAY_PATH}\"\n",
    ")\n",
    "\n",
    "assert RAW_GSEA_PATH.exists(), (\n",
    "    f\"Missing raw Reactome prerank file:\\n{RAW_GSEA_PATH}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. LOAD PATHWAY CONVERGENCE\n",
    "# ============================================================\n",
    "\n",
    "p = pd.read_csv(\n",
    "    PATHWAY_PATH,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"RETINA_ND — FINAL REACTOME PATHWAY / MODULE PRIORITIZATION\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPathway × cell-type rows:\",\n",
    "    f\"{len(p):,}\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Unique pathways:\",\n",
    "    f\"{p['pathway'].nunique():,}\"\n",
    ")\n",
    "\n",
    "\n",
    "required = {\n",
    "\n",
    "    \"cell_type\",\n",
    "    \"pathway\",\n",
    "    \"NES_AD\",\n",
    "    \"FDR_AD\",\n",
    "    \"NES_PD\",\n",
    "    \"FDR_PD\",\n",
    "    \"same_direction\",\n",
    "    \"both_FDR05\",\n",
    "    \"convergent_pathway\",\n",
    "    \"conservative_abs_NES\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "missing = (\n",
    "    required\n",
    "    -\n",
    "    set(\n",
    "        p.columns\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert not missing, (\n",
    "    f\"Missing pathway columns:\\n{sorted(missing)}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. NUMERIC / BOOLEAN NORMALIZATION\n",
    "# ============================================================\n",
    "\n",
    "for col in [\n",
    "\n",
    "    \"NES_AD\",\n",
    "    \"FDR_AD\",\n",
    "    \"NES_PD\",\n",
    "    \"FDR_PD\",\n",
    "    \"conservative_abs_NES\",\n",
    "\n",
    "]:\n",
    "\n",
    "    p[col] = pd.to_numeric(\n",
    "        p[col],\n",
    "        errors=\"coerce\",\n",
    "    )\n",
    "\n",
    "\n",
    "for col in [\n",
    "\n",
    "    \"same_direction\",\n",
    "    \"both_FDR05\",\n",
    "    \"convergent_pathway\",\n",
    "\n",
    "]:\n",
    "\n",
    "    p[col] = (\n",
    "        p[col]\n",
    "        .fillna(False)\n",
    "        .astype(bool)\n",
    "    )\n",
    "\n",
    "\n",
    "# Conservative joint FDR:\n",
    "#\n",
    "# both diseases have to be convincing, so take the worse\n",
    "# of the two FDR values.\n",
    "\n",
    "p[\n",
    "    \"joint_FDR_max\"\n",
    "] = p[\n",
    "    [\n",
    "        \"FDR_AD\",\n",
    "        \"FDR_PD\",\n",
    "    ]\n",
    "].max(\n",
    "    axis=1\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. LOAD RAW GSEA RESULTS\n",
    "# ============================================================\n",
    "\n",
    "raw = pd.read_csv(\n",
    "    RAW_GSEA_PATH,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nRaw GSEA rows:\",\n",
    "    f\"{len(raw):,}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. DETECT RAW GSEA COLUMN NAMES\n",
    "# ============================================================\n",
    "\n",
    "lower_map = {\n",
    "\n",
    "    str(c).lower().strip():\n",
    "        c\n",
    "\n",
    "    for c in raw.columns\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "if \"term\" in lower_map:\n",
    "\n",
    "    TERM_COL = lower_map[\n",
    "        \"term\"\n",
    "    ]\n",
    "\n",
    "elif \"pathway\" in lower_map:\n",
    "\n",
    "    TERM_COL = lower_map[\n",
    "        \"pathway\"\n",
    "    ]\n",
    "\n",
    "else:\n",
    "\n",
    "    raise RuntimeError(\n",
    "        \"Could not identify Reactome pathway/Term column.\"\n",
    "    )\n",
    "\n",
    "\n",
    "LEAD_COL = None\n",
    "\n",
    "\n",
    "for c in raw.columns:\n",
    "\n",
    "    if \"lead\" in str(c).lower():\n",
    "\n",
    "        LEAD_COL = c\n",
    "\n",
    "        break\n",
    "\n",
    "\n",
    "assert LEAD_COL is not None, (\n",
    "    \"Could not identify GSEA leading-edge gene column.\"\n",
    ")\n",
    "\n",
    "\n",
    "assert \"cell_type\" in raw.columns\n",
    "assert \"disease\" in raw.columns\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Pathway column:\",\n",
    "    TERM_COL\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Leading-edge column:\",\n",
    "    LEAD_COL\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. LEADING-EDGE PARSER\n",
    "# ============================================================\n",
    "\n",
    "def parse_gene_set(\n",
    "    value\n",
    "):\n",
    "\n",
    "    if pd.isna(value):\n",
    "\n",
    "        return set()\n",
    "\n",
    "\n",
    "    text = str(\n",
    "        value\n",
    "    ).strip()\n",
    "\n",
    "\n",
    "    if (\n",
    "        not text\n",
    "        or\n",
    "        text.lower()\n",
    "        in {\n",
    "            \"nan\",\n",
    "            \"none\",\n",
    "        }\n",
    "    ):\n",    "\n",
    "        return set()\n",
    "\n",
    "\n",
    "    parts = re.split(\n",
    "        r\"[;,]\",\n",
    "        text,\n",
    "    )\n",
    "\n",
    "\n",
    "    return {\n",
    "\n",
    "        x.strip().upper()\n",
    "\n",
    "        for x in parts\n",
    "\n",
    "        if x.strip()\n",
    "\n",
    "    }\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. BUILD AD / PD LEADING-EDGE LOOKUP\n",
    "# ============================================================\n",
    "\n",
    "lead_lookup = {}\n",
    "\n",
    "\n",
    "for _, row in raw.iterrows():\n",
    "\n",
    "\n",
    "    cell_type = str(\n",
    "        row[\n",
    "            \"cell_type\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    disease = str(\n",
    "        row[\n",
    "            \"disease\"\n",
    "        ]\n",
    "    ).upper()\n",
    "\n",
    "\n",
    "    pathway = str(\n",
    "        row[\n",
    "            TERM_COL\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    genes = parse_gene_set(\n",
    "        row[\n",
    "            LEAD_COL\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    lead_lookup[\n",
    "        (\n",
    "            cell_type,\n",
    "            disease,\n",
    "            pathway,\n",
    "        )\n",
    "    ] = genes\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. ADD LEADING-EDGE INFORMATION TO EACH CELL-TYPE PATHWAY\n",
    "# ============================================================\n",
    "\n",
    "detail_rows = []\n",
    "\n",
    "\n",
    "for _, row in p.iterrows():\n",
    "\n",
    "\n",
    "    ct = str(\n",
    "        row[\n",
    "            \"cell_type\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    pathway = str(\n",
    "        row[\n",
    "            \"pathway\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    ad_genes = lead_lookup.get(\n",
    "        (\n",
    "            ct,\n",
    "            \"AD\",\n",
    "            pathway,\n",
    "        ),\n",
    "        set(),\n",
    "    )\n",
    "\n",
    "\n",
    "    pd_genes = lead_lookup.get(\n",
    "        (\n",
    "            ct,\n",
    "            \"PD\",\n",
    "            pathway,\n",
    "        ),\n",
    "        set(),\n",
    "    )\n",
    "\n",
    "\n",
    "    shared = (\n",
    "        ad_genes\n",
    "        &\n",
    "        pd_genes\n",
    "    )\n",
    "\n",
    "\n",
    "    union = (\n",
    "        ad_genes\n",
    "        |\n",
    "        pd_genes\n",
    "    )\n",
    "\n",
    "\n",
    "    z = row.to_dict()\n",
    "\n",
    "\n",
    "    z[\n",
    "        \"AD_leading_edge_n\"\n",
    "    ] = len(\n",
    "        ad_genes\n",
    "    )\n",
    "\n",
    "\n",
    "    z[\n",
    "        \"PD_leading_edge_n\"\n",
    "    ] = len(\n",
    "        pd_genes\n",
    "    )\n",
    "\n",
    "\n",
    "    z[\n",
    "        \"shared_leading_edge_n\"\n",
    "    ] = len(\n",
    "        shared\n",
    "    )\n",
    "\n",
    "\n",
    "    z[\n",
    "        \"union_leading_edge_n\"\n",
    "    ] = len(\n",
    "        union\n",
    "    )\n",
    "\n",
    "\n",
    "    z[\n",
    "        \"shared_leading_edge_genes\"\n",
    "    ] = \";\".join(\n",
    "        sorted(\n",
    "            shared\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    z[\n",
    "        \"union_leading_edge_genes\"\n",
    "    ] = \";\".join(\n",
    "        sorted(\n",
    "            union\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    detail_rows.append(\n",
    "        z\n",
    "    )\n",
    "\n",
    "\n",
    "detail = pd.DataFrame(\n",
    "    detail_rows\n",
    ")\n",
    "\n",
    "\n",
    "DETAIL_PATH = (\n",
    "    FINAL_DIR\n",
    "    / \"RETINA_ND_REACTOME_CELLTYPE_PATHWAY_DETAILS_v5.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "detail.to_csv(\n",
    "    DETAIL_PATH,\n",
    "    index=False,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. OPTIONAL UNIQUE-GENE CANDIDATE RANKING\n",
    "# ============================================================\n",
    "\n",
    "if GENE_RANKING_PATH.exists():\n",
    "\n",
    "    genes = pd.read_csv(\n",
    "        GENE_RANKING_PATH\n",
    "    )\n",
    "\n",
    "\n",
    "    genes[\n",
    "        \"gene_symbol\"\n",
    "    ] = (\n",
    "        genes[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .str.upper()\n",
    "        .str.strip()\n",
    "    )\n",
    "\n",
    "\n",
    "    candidate_rank = dict(\n",
    "        zip(\n",
    "            genes[\n",
    "                \"gene_symbol\"\n",
    "            ],\n",
    "            genes[\n",
    "                \"candidate_rank\"\n",
    "            ],\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    candidate_priority = dict(\n",
    "        zip(\n",
    "            genes[\n",
    "                \"gene_symbol\"\n",
    "            ],\n",
    "            genes[\n",
    "                \"priority_group\"\n",
    "            ],\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    candidate_set = set(\n",
    "        genes[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    CANDIDATES_INCLUDED = True\n",
    "\n",
    "\n",
    "else:\n",
    "\n",
    "    candidate_rank = {}\n",
    "    candidate_priority = {}\n",
    "    candidate_set = set()\n",
    "\n",
    "    CANDIDATES_INCLUDED = False\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nUnique-gene ranking included:\",\n",
    "    CANDIDATES_INCLUDED\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. COLLAPSE TO ONE ROW PER UNIQUE PATHWAY\n",
    "# ============================================================\n",
    "\n",
    "pathway_rows = []\n",
    "\n",
    "\n",
    "for pathway, g in detail.groupby(\n",
    "    \"pathway\",\n",
    "    sort=False,\n",
    "):\n",
    "\n",
    "\n",
    "    cell_types = sorted(\n",
    "        g[\n",
    "            \"cell_type\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .unique()\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_celltypes = len(\n",
    "        cell_types\n",
    "    )\n",
    "\n",
    "\n",
    "    n_same_direction = int(\n",
    "        g[\n",
    "            \"same_direction\"\n",
    "        ]\n",
    "        .sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_both_fdr = int(\n",
    "        g[\n",
    "            \"both_FDR05\"\n",
    "        ]\n",
    "        .sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_convergent = int(\n",
    "        g[\n",
    "            \"convergent_pathway\"\n",
    "        ]\n",
    "        .sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Aggregate leading-edge genes across cell types\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    shared_all = set()\n",
    "\n",
    "    union_all = set()\n",
    "\n",
    "\n",
    "    for _, r in g.iterrows():\n",
    "\n",
    "\n",
    "        shared_all.update(\n",
    "            parse_gene_set(\n",
    "                r[\n",
    "                    \"shared_leading_edge_genes\"\n",
    "                ]\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "        union_all.update(\n",
    "            parse_gene_set(\n",
    "                r[\n",
    "                    \"union_leading_edge_genes\"\n",
    "                ]\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Candidate genes represented in pathway leading edges\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    candidate_genes = (\n",
    "        union_all\n",
    "        &\n",
    "        candidate_set\n",
    "    )\n",
    "\n",
    "\n",
    "    shared_candidate_genes = (\n",
    "        shared_all\n",
    "        &\n",
    "        candidate_set\n",
    "    )\n",
    "\n",
    "\n",
    "    candidate_genes_sorted = sorted(\n",
    "\n",
    "        candidate_genes,\n",
    "\n",
    "        key=lambda x:\n",
    "            candidate_rank.get(\n",
    "                x,\n",
    "                10**9,\n",
    "            ),\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    shared_candidate_sorted = sorted(\n",
    "\n",
    "        shared_candidate_genes,\n",
    "\n",
    "        key=lambda x:\n",
    "            candidate_rank.get(\n",
    "                x,\n",
    "                10**9,\n",
    "            ),\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Best cell-type instance\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    temp = g.copy()\n",
    "\n",
    "\n",
    "    temp = temp.sort_values(\n",
    "        [\n",
    "\n",
    "            \"convergent_pathway\",\n",
    "\n",
    "            \"same_direction\",\n",
    "\n",
    "            \"joint_FDR_max\",\n",
    "\n",
    "            \"conservative_abs_NES\",\n",
    "\n",
    "        ],\n",
    "\n",
    "        ascending=[\n",
    "\n",
    "            False,\n",
    "\n",
    "            False,\n",
    "\n",
    "            True,\n",
    "\n",
    "            False,\n",
    "\n",
    "        ],\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    best = temp.iloc[\n",
    "        0\n",
    "    ]\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Priority category\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    if n_convergent >= 2:\n",
    "\n",
    "        priority = (\n",
    "            \"R1_recurrent_AD_PD_FDR\"\n",
    "        )\n",
    "\n",
    "\n",
    "    elif n_convergent == 1:\n",
    "\n",
    "        priority = (\n",
    "            \"R2_single_celltype_AD_PD_FDR\"\n",
    "        )\n",
    "\n",
    "\n",
    "    elif n_same_direction >= 3:\n",
    "\n",
    "        priority = (\n",
    "            \"R3_recurrent_directional\"\n",
    "        )\n",
    "\n",
    "\n",
    "    elif n_same_direction == 2:\n",
    "\n",
    "        priority = (\n",
    "            \"R4_two_celltype_directional\"\n",
    "        )\n",
    "\n",
    "\n",
    "    elif n_same_direction == 1:\n",
    "\n",
    "        priority = (\n",
    "            \"R5_single_directional\"\n",
    "        )\n",
    "\n",
    "\n",
    "    else:\n",
    "\n",
    "        priority = (\n",
    "            \"R6_nonconcordant\"\n",
    "        )\n",
    "\n",
    "\n",
    "    pathway_rows.append(\n",
    "        {\n",
    "\n",
    "            \"pathway\":\n",
    "                pathway,\n",
    "\n",
    "            \"priority_group\":\n",
    "                priority,\n",
    "\n",
    "            \"n_cell_types_present\":\n",
    "                n_celltypes,\n",
    "\n",
    "            \"cell_types\":\n",
    "                \";\".join(\n",
    "                    cell_types\n",
    "                ),\n",
    "\n",
    "            \"n_same_direction_celltypes\":\n",
    "                n_same_direction,\n",
    "\n",
    "            \"n_both_FDR05_celltypes\":\n",
    "                n_both_fdr,\n",
    "\n",
    "            \"n_convergent_FDR_celltypes\":\n",
    "                n_convergent,\n",
    "\n",
    "            \"best_cell_type\":\n",
    "                best[\n",
    "                    \"cell_type\"\n",
    "                ],\n",
    "\n",
    "            \"best_NES_AD\":\n",
    "                best[\n",
    "                    \"NES_AD\"\n",
    "                ],\n",
    "\n",
    "            \"best_NES_PD\":\n",
    "                best[\n",
    "                    \"NES_PD\"\n",
    "                ],\n",
    "\n",
    "            \"best_FDR_AD\":\n",
    "                best[\n",
    "                    \"FDR_AD\"\n",
    "                ],\n",
    "\n",
    "            \"best_FDR_PD\":\n",
    "                best[\n",
    "                    \"FDR_PD\"\n",
    "                ],\n",
    "\n",
    "            \"best_joint_FDR\":\n",
    "                best[\n",
    "                    \"joint_FDR_max\"\n",
    "                ],\n",
    "\n",
    "            \"median_NES_AD\":\n",
    "                g[\n",
    "                    \"NES_AD\"\n",
    "                ]\n",
    "                .median(),\n",
    "\n",
    "            \"median_NES_PD\":\n",
    "                g[\n",
    "                    \"NES_PD\"\n",
    "                ]\n",
    "                .median(),\n",
    "\n",
    "            \"median_conservative_abs_NES\":\n",
    "                g[\n",
    "                    \"conservative_abs_NES\"\n",
    "                ]\n",
    "                .median(),\n",
    "\n",
    "            \"max_conservative_abs_NES\":\n",
    "                g[\n",
    "                    \"conservative_abs_NES\"\n",
    "                ]\n",
    "                .max(),\n",
    "\n",
    "            \"shared_leading_edge_n\":\n",
    "                len(\n",
    "                    shared_all\n",
    "                ),\n",
    "\n",
    "            \"shared_leading_edge_genes\":\n",
    "                \";\".join(\n",
    "                    sorted(\n",
    "                        shared_all\n",
    "                    )\n",
    "                ),\n",
    "\n",
    "            \"union_leading_edge_n\":\n",
    "                len(\n",
    "                    union_all\n",
    "                ),\n",
    "\n",
    "            \"union_leading_edge_genes\":\n",
    "                \";\".join(\n",
    "                    sorted(\n",
    "                        union_all\n",
    "                    )\n",
    "                ),\n",
    "\n",
    "            \"candidate_genes_n\":\n",
    "                len(\n",
    "                    candidate_genes\n",
    "                ),\n",
    "\n",
    "            \"candidate_genes\":\n",
    "                \";\".join(\n",
    "                    candidate_genes_sorted\n",
    "                ),\n",
    "\n",
    "            \"shared_candidate_genes_n\":\n",
    "                len(\n",
    "                    shared_candidate_genes\n",
    "                ),\n",
    "\n",
    "            \"shared_candidate_genes\":\n",
    "                \";\".join(\n",
    "                    shared_candidate_sorted\n",
    "                ),\n",
    "\n",
    "            \"best_candidate_rank\":\n",
    "                (\n",
    "                    min(\n",
    "                        [\n",
    "                            candidate_rank[x]\n",
    "                            for x\n",
    "                            in candidate_genes\n",
    "                        ]\n",
    "                    )\n",
    "                    if candidate_genes\n",
    "                    else np.nan\n",
    "                ),\n",
    "\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "pathway_rank = pd.DataFrame(\n",
    "    pathway_rows\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. PATHWAY PRIORITY ORDER\n",
    "# ============================================================\n",
    "\n",
    "PRIORITY_ORDER = {\n",
    "\n",
    "    \"R1_recurrent_AD_PD_FDR\":\n",
    "        1,\n",
    "\n",
    "    \"R2_single_celltype_AD_PD_FDR\":\n",
    "        2,\n",
    "\n",
    "    \"R3_recurrent_directional\":\n",
    "        3,\n",
    "\n",
    "    \"R4_two_celltype_directional\":\n",
    "        4,\n",
    "\n",
    "    \"R5_single_directional\":\n",
    "        5,\n",
    "\n",
    "    \"R6_nonconcordant\":\n",
    "        6,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "pathway_rank[\n",
    "    \"_priority_order\"\n",
    "] = (\n",
    "    pathway_rank[\n",
    "        \"priority_group\"\n",
    "    ]\n",
    "    .map(\n",
    "        PRIORITY_ORDER\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. FINAL PATHWAY SORT\n",
    "#\n",
    "# Transparent hierarchy:\n",
    "#\n",
    "# 1. convergence category\n",
    "# 2. number of FDR-convergent cell types\n",
    "# 3. number of same-direction cell types\n",
    "# 4. conservative NES\n",
    "# 5. joint FDR\n",
    "# ============================================================\n",
    "\n",
    "pathway_rank = pathway_rank.sort_values(\n",
    "    [\n",
    "\n",
    "        \"_priority_order\",\n",
    "\n",
    "        \"n_convergent_FDR_celltypes\",\n",
    "\n",
    "        \"n_same_direction_celltypes\",\n",
    "\n",
    "        \"median_conservative_abs_NES\",\n",
    "\n",
    "        \"best_joint_FDR\",\n",
    "\n",
    "        \"pathway\",\n",
    "\n",
    "    ],\n",
    "\n",
    "    ascending=[\n",
    "\n",
    "        True,\n",
    "\n",
    "        False,\n",
    "\n",
    "        False,\n",
    "\n",
    "        False,\n",
    "\n",
    "        True,\n",
    "\n",
    "        True,\n",
    "\n",
    "    ],\n",
    "\n",
    ").reset_index(\n",
    "    drop=True\n",
    ")\n",
    "\n",
    "\n",
    "pathway_rank.insert(\n",
    "    0,\n",
    "    \"pathway_rank\",\n",
    "    np.arange(\n",
    "        1,\n",
    "        len(\n",
    "            pathway_rank\n",
    "        )\n",
    "        +\n",
    "        1\n",
    "    ),\n",
    ")\n",
    "\n",
    "\n",
    "pathway_rank = pathway_rank.drop(\n",
    "    columns=[\n",
    "        \"_priority_order\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "PATHWAY_RANK_PATH = (\n",
    "    FINAL_DIR\n",
    "    / \"RETINA_ND_REACTOME_UNIQUE_PATHWAY_RANKING_v5.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "pathway_rank.to_csv(\n",
    "    PATHWAY_RANK_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 12. PUBLICATION PATHWAY SHORTLIST\n",
    "#\n",
    "# Keep pathways with:\n",
    "#\n",
    "#   any FDR convergence\n",
    "#\n",
    "# OR\n",
    "#\n",
    "#   same-direction enrichment in >= 2 cell types.\n",
    "# ============================================================\n",
    "\n",
    "shortlist = pathway_rank.loc[\n",
    "\n",
    "    (\n",
    "        pathway_rank[\n",
    "            \"n_convergent_FDR_celltypes\"\n",
    "        ]\n",
    "        >=\n",
    "        1\n",
    "    )\n",
    "\n",
    "    |\n",
    "\n",
    "    (\n",
    "        pathway_rank[\n",
    "            \"n_same_direction_celltypes\"\n",
    "        ]\n",
    "        >=\n",
    "        2\n",
    "    )\n",
    "\n",
    "].copy()\n",
    "\n",
    "\n",
    "SHORTLIST_PATH = (\n",
    "    FINAL_DIR\n",
    "    / \"RETINA_ND_REACTOME_PUBLICATION_SHORTLIST_v5.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "shortlist.to_csv(\n",
    "    SHORTLIST_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPublication-shortlist pathways:\",\n",
    "    len(\n",
    "        shortlist\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 13. REDUNDANCY-REDUCED PATHWAY MODULES\n",
    "#\n",
    "# Reactome contains many nested / overlapping pathways.\n",
    "#\n",
    "# We create descriptive modules by connecting pathways when:\n",
    "#\n",
    "#   Jaccard overlap >= 0.25\n",
    "#\n",
    "# AND\n",
    "#\n",
    "#   >= 3 leading-edge genes overlap.\n",
    "#\n",
    "# This is descriptive clustering only.\n",
    "# ============================================================\n",
    "\n",
    "module_source = shortlist.copy()\n",
    "\n",
    "\n",
    "gene_sets = {}\n",
    "\n",
    "\n",
    "for _, row in module_source.iterrows():\n",
    "\n",
    "\n",
    "    geneset = parse_gene_set(\n",
    "        row[\n",
    "            \"union_leading_edge_genes\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    if len(\n",
    "        geneset\n",
    "    ) >= 3:\n",
    "\n",
    "        gene_sets[\n",
    "            row[\n",
    "                \"pathway\"\n",
    "            ]\n",
    "        ] = geneset\n",
    "\n",
    "\n",
    "pathways_for_modules = list(\n",
    "    gene_sets.keys()\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 14. UNION-FIND\n",
    "# ============================================================\n",
    "\n",
    "parent = {\n",
    "\n",
    "    x:\n",
    "        x\n",
    "\n",
    "    for x in pathways_for_modules\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "def find(\n",
    "    x\n",
    "):\n",
    "\n",
    "    while parent[\n",
    "        x\n",
    "    ] != x:\n",
    "\n",
    "        parent[\n",
    "            x\n",
    "        ] = parent[\n",
    "            parent[\n",
    "                x\n",
    "            ]\n",
    "        ]\n",
    "\n",
    "        x = parent[\n",
    "            x\n",
    "        ]\n",
    "\n",
    "    return x\n",
    "\n",
    "\n",
    "def union(\n",
    "    a,\n",
    "    b\n",
    "):\n",
    "\n",
    "    ra = find(\n",
    "        a\n",
    "    )\n",
    "\n",
    "    rb = find(\n",
    "        b\n",
    "    )\n",
    "\n",
    "\n",
    "    if ra != rb:\n",
    "\n",
    "        parent[\n",
    "            rb\n",
    "        ] = ra\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 15. BUILD OVERLAP NETWORK\n",
    "# ============================================================\n",
    "\n",
    "for i in range(\n",
    "    len(\n",
    "        pathways_for_modules\n",
    "    )\n",
    "):\n",
    "\n",
    "\n",
    "    a = pathways_for_modules[\n",
    "        i\n",
    "    ]\n",
    "\n",
    "\n",
    "    A = gene_sets[\n",
    "        a\n",
    "    ]\n",
    "\n",
    "\n",
    "    for j in range(\n",
    "        i + 1,\n",
    "        len(\n",
    "            pathways_for_modules\n",
    "        )\n",
    "    ):\n",
    "\n",
    "\n",
    "        b = pathways_for_modules[\n",
    "            j\n",
    "        ]\n",
    "\n",
    "\n",
    "        B = gene_sets[\n",
    "            b\n",
    "        ]\n",
    "\n",
    "\n",
    "        intersection = (\n",
    "            A\n",
    "            &\n",
    "            B\n",
    "        )\n",
    "\n",
    "\n",
    "        if len(\n",
    "            intersection\n",
    "        ) < 3:\n",
    "\n",
    "            continue\n",
    "\n",
    "\n",
    "        union_set = (\n",
    "            A\n",
    "            |\n",
    "            B\n",
    "        )\n",
    "\n",
    "\n",
    "        jaccard = (\n",
    "\n",
    "            len(\n",
    "                intersection\n",
    "            )\n",
    "\n",
    "            /\n",
    "\n",
    "            len(\n",
    "                union_set\n",
    "            )\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        if jaccard >= 0.25:\n",
    "\n",
    "            union(\n",
    "                a,\n",
    "                b\n",
    "            )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 16. COLLECT MODULE COMPONENTS\n",
    "# ============================================================\n",
    "\n",
    "components = {}\n",
    "\n",    "\n",
    "for pathway in pathways_for_modules:\n",
    "\n",
    "\n",
    "    root = find(\n",
    "        pathway\n",
    "    )\n",
    "\n",
    "\n",
    "    components.setdefault(\n",
    "        root,\n",
    "        []\n",
    "    ).append(\n",
    "        pathway\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 17. MODULE SUMMARIES\n",
    "# ============================================================\n",
    "\n",
    "module_rows = []\n",
    "\n",
    "\n",
    "sorted_components = sorted(\n",
    "\n",
    "    components.values(),\n",
    "\n",
    "    key=lambda x:\n",
    "        min(\n",
    "            pathway_rank.loc[\n",
    "                pathway_rank[\n",
    "                    \"pathway\"\n",
    "                ]\n",
    "                .isin(\n",
    "                    x\n",
    "                ),\n",
    "                \"pathway_rank\",\n",
    "            ]\n",
    "        ),\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "for module_index, members in enumerate(\n",
    "    sorted_components,\n",
    "    start=1,\n",
    "):\n",
    "\n",
    "\n",
    "    subset = pathway_rank.loc[\n",
    "        pathway_rank[\n",
    "            \"pathway\"\n",
    "        ]\n",
    "        .isin(\n",
    "            members\n",
    "        )\n",
    "    ].copy()\n",
    "\n",
    "\n",
    "    subset = subset.sort_values(\n",
    "        \"pathway_rank\"\n",
    "    )\n",
    "\n",
    "\n",
    "    representative = subset.iloc[\n",
    "        0\n",
    "    ]\n",
    "\n",
    "\n",
    "    module_genes = set()\n",
    "\n",
    "    shared_module_genes = set()\n",
    "\n",
    "\n",
    "    for pathway in members:\n",
    "\n",
    "        row = pathway_rank.loc[\n",
    "            pathway_rank[\n",
    "                \"pathway\"\n",
    "            ]\n",
    "            ==\n",
    "            pathway\n",
    "        ].iloc[\n",
    "            0\n",
    "        ]\n",
    "\n",
    "\n",
    "        module_genes.update(\n",
    "            parse_gene_set(\n",
    "                row[\n",
    "                    \"union_leading_edge_genes\"\n",
    "                ]\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "        shared_module_genes.update(\n",
    "            parse_gene_set(\n",
    "                row[\n",
    "                    \"shared_leading_edge_genes\"\n",
    "                ]\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "    module_candidate_genes = (\n",
    "\n",
    "        module_genes\n",
    "        &\n",
    "        candidate_set\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    module_candidate_genes = sorted(\n",
    "\n",
    "        module_candidate_genes,\n",
    "\n",
    "        key=lambda x:\n",
    "            candidate_rank.get(\n",
    "                x,\n",
    "                10**9,\n",
    "            ),\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    module_rows.append(\n",
    "        {\n",
    "\n",
    "            \"module_id\":\n",
    "                f\"M{module_index:03d}\",\n",
    "\n",
    "            \"representative_pathway\":\n",
    "                representative[\n",
    "                    \"pathway\"\n",
    "                ],\n",
    "\n",
    "            \"representative_pathway_rank\":\n",
    "                int(\n",
    "                    representative[\n",
    "                        \"pathway_rank\"\n",
    "                    ]\n",
    "                ),\n",
    "\n",
    "            \"representative_priority\":\n",
    "                representative[\n",
    "                    \"priority_group\"\n",
    "                ],\n",
    "\n",
    "            \"n_pathways\":\n",
    "                len(\n",
    "                    members\n",
    "                ),\n",
    "\n",
    "            \"pathways\":\n",
    "                \" || \".join(\n",
    "                    subset[\n",
    "                        \"pathway\"\n",
    "                    ]\n",
    "                    .tolist()\n",
    "                ),\n",
    "\n",
    "            \"n_FDR_convergent_pathways\":\n",
    "                int(\n",
    "                    (\n",
    "                        subset[\n",
    "                            \"n_convergent_FDR_celltypes\"\n",
    "                        ]\n",
    "                        >\n",
    "                        0\n",
    "                    )\n",
    "                    .sum()\n",
    "                ),\n",
    "\n",
    "            \"max_recurrent_FDR_celltypes\":\n",
    "                int(\n",
    "                    subset[\n",
    "                        \"n_convergent_FDR_celltypes\"\n",
    "                    ]\n",
    "                    .max()\n",
    "                ),\n",
    "\n",
    "            \"max_same_direction_celltypes\":\n",
    "                int(\n",
    "                    subset[\n",
    "                        \"n_same_direction_celltypes\"\n",
    "                    ]\n",
    "                    .max()\n",
    "                ),\n",
    "\n",
    "            \"module_leading_edge_genes_n\":\n",
    "                len(\n",
    "                    module_genes\n",
    "                ),\n",
    "\n",
    "            \"module_shared_AD_PD_genes_n\":\n",
    "                len(\n",
    "                    shared_module_genes\n",
    "                ),\n",
    "\n",
    "            \"candidate_genes_n\":\n",
    "                len(\n",
    "                    module_candidate_genes\n",
    "                ),\n",
    "\n",
    "            \"candidate_genes\":\n",
    "                \";\".join(\n",
    "                    module_candidate_genes\n",
    "                ),\n",
    "\n",
    "            \"best_candidate_rank\":\n",
    "                (\n",
    "                    min(\n",
    "                        [\n",
    "                            candidate_rank[x]\n",
    "                            for x\n",
    "                            in module_candidate_genes\n",
    "                        ]\n",
    "                    )\n",
    "                    if module_candidate_genes\n",
    "                    else np.nan\n",
    "                ),\n",
    "\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "modules = pd.DataFrame(\n",
    "    module_rows\n",
    ")\n",
    "\n",
    "\n",
    "MODULE_PATH = (\n",
    "    FINAL_DIR\n",
    "    / \"RETINA_ND_REACTOME_REDUNDANCY_MODULES_v5.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "modules.to_csv(\n",
    "    MODULE_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 18. CANDIDATE ↔ PATHWAY MAP\n",
    "# ============================================================\n",
    "\n",
    "candidate_pathway_rows = []\n",
    "\n",
    "\n",
    "if CANDIDATES_INCLUDED:\n",
    "\n",
    "\n",
    "    for _, row in pathway_rank.iterrows():\n",
    "\n",
    "\n",
    "        pathway = row[\n",
    "            \"pathway\"\n",
    "        ]\n",
    "\n",
    "\n",
    "        union_genes = parse_gene_set(\n",
    "            row[\n",
    "                \"union_leading_edge_genes\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "\n",
    "        shared_genes = parse_gene_set(\n",
    "            row[\n",
    "                \"shared_leading_edge_genes\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "\n",
    "        hits = (\n",
    "            union_genes\n",
    "            &\n",
    "            candidate_set\n",
    "        )\n",
    "\n",
    "\n",
    "        for gene in hits:\n",
    "\n",
    "\n",
    "            candidate_pathway_rows.append(\n",
    "                {\n",
    "\n",
    "                    \"gene_symbol\":\n",
    "                        gene,\n",
    "\n",
    "                    \"candidate_rank\":\n",
    "                        candidate_rank.get(\n",
    "                            gene,\n",
    "                            np.nan,\n",
    "                        ),\n",
    "\n",
    "                    \"priority_group\":\n",
    "                        candidate_priority.get(\n",
    "                            gene,\n",
    "                            None,\n",
    "                        ),\n",
    "\n",
    "                    \"pathway\":\n",
    "                        pathway,\n",
    "\n",
    "                    \"pathway_rank\":\n",
    "                        row[\n",
    "                            \"pathway_rank\"\n",
    "                        ],\n",
    "\n",
    "                    \"pathway_priority\":\n",
    "                        row[\n",
    "                            \"priority_group\"\n",
    "                        ],\n",
    "\n",
    "                    \"n_convergent_FDR_celltypes\":\n",
    "                        row[\n",
    "                            \"n_convergent_FDR_celltypes\"\n",
    "                        ],\n",
    "\n",
    "                    \"n_same_direction_celltypes\":\n",
    "                        row[\n",
    "                            \"n_same_direction_celltypes\"\n",
    "                        ],\n",
    "\n",
    "                    \"shared_AD_PD_leading_edge\":\n",
    "                        gene\n",
    "                        in shared_genes,\n",
    "\n",
    "                }\n",
    "            )\n",
    "\n",
    "\n",
    "candidate_pathway_map = pd.DataFrame(\n",
    "    candidate_pathway_rows\n",
    ")\n",
    "\n",
    "\n",
    "CANDIDATE_PATHWAY_PATH = (\n",
    "    FINAL_DIR\n",
    "    / \"RETINA_ND_CANDIDATE_REACTOME_MAP_v5.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "candidate_pathway_map.to_csv(\n",
    "    CANDIDATE_PATHWAY_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 19. SUMMARY COUNTS\n",
    "# ============================================================\n",
    "\n",
    "priority_summary = (\n",
    "\n",
    "    pathway_rank[\n",
    "        \"priority_group\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .rename_axis(\n",
    "        \"priority_group\"\n",
    "    )\n",
    "    .reset_index(\n",
    "        name=\"n_pathways\"\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "SUMMARY_PATH = (\n",
    "    FINAL_DIR\n",
    "    / \"RETINA_ND_REACTOME_PRIORITY_COUNTS_v5.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "priority_summary.to_csv(\n",
    "    SUMMARY_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 20. FREEZE\n",
    "# ============================================================\n",
    "\n",
    "LOCK_PATH = (\n",
    "    LOCKS\n",
    "    / \"RETINA_ND_REACTOME_MODULE_PRIORITIZATION_FREEZE_v5.json\"\n",
    ")\n",
    "\n",
    "\n",
    "record = {\n",
    "\n",
    "    \"status\":\n",
    "        \"RETINA_ND_REACTOME_MODULE_PRIORITIZATION_FROZEN\",\n",
    "\n",
    "    \"pathway_convergence_input\":\n",
    "        str(\n",
    "            PATHWAY_PATH\n",
    "        ),\n",
    "\n",
    "    \"raw_GSEA_input\":\n",
    "        str(\n",
    "            RAW_GSEA_PATH\n",
    "        ),\n",
    "\n",
    "    \"gene_ranking_included\":\n",
    "        bool(\n",
    "            CANDIDATES_INCLUDED\n",
    "        ),\n",
    "\n",
    "    \"gene_ranking\":\n",
    "        (\n",
    "            str(\n",
    "                GENE_RANKING_PATH\n",
    "            )\n",
    "            if CANDIDATES_INCLUDED\n",
    "            else None\n",
    "        ),\n",
    "\n",
    "    \"pathway_ranking\":\n",
    "        str(\n",
    "            PATHWAY_RANK_PATH\n",
    "        ),\n",
    "\n",
    "    \"publication_shortlist\":\n",
    "        str(\n",
    "            SHORTLIST_PATH\n",
    "        ),\n",
    "\n",
    "    \"modules\":\n",
    "        str(\n",
    "            MODULE_PATH\n",
    "        ),\n",
    "\n",
    "    \"candidate_pathway_map\":\n",
    "        str(\n",
    "            CANDIDATE_PATHWAY_PATH\n",
    "        ),\n",
    "\n",
    "    \"module_overlap_rule\":\n",
    "        (\n",
    "            \"Jaccard >=0.25 and >=3 overlapping \"\n",
    "            \"leading-edge genes\"\n",
    "        ),\n",
    "\n",
    "    \"module_interpretation\":\n",
    "        (\n",
    "            \"Descriptive Reactome redundancy reduction; \"\n",
    "            \"not a new hypothesis test.\"\n",
    "        ),\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    LOCK_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        record,\n",
    "        f,\n",
    "        indent=2,\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 21. FINAL REPORT\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"REACTOME PATHWAY / MODULE PRIORITIZATION COMPLETE\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPRIORITY COUNTS\"\n",
    ")\n",
    "\n",
    "display(\n",
    "    priority_summary\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"TOP 30 UNIQUE PATHWAYS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "display_cols = [\n",
    "\n",
    "    \"pathway_rank\",\n",
    "\n",
    "    \"pathway\",\n",
    "\n",
    "    \"priority_group\",\n",
    "\n",
    "    \"n_convergent_FDR_celltypes\",\n",
    "\n",
    "    \"n_same_direction_celltypes\",\n",
    "\n",
    "    \"best_cell_type\",\n",
    "\n",
    "    \"best_NES_AD\",\n",
    "\n",
    "    \"best_NES_PD\",\n",
    "\n",
    "    \"best_FDR_AD\",\n",
    "\n",
    "    \"best_FDR_PD\",\n",
    "\n",
    "    \"shared_leading_edge_n\",\n",
    "\n",
    "    \"shared_candidate_genes\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "display(\n",
    "    pathway_rank[\n",
    "        display_cols\n",
    "    ]\n",
    "    .head(\n",
    "        30\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"TOP 20 REDUNDANCY-REDUCED MODULES\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "if len(\n",
    "    modules\n",
    ") > 0:\n",
    "\n",
    "    display(\n",
    "        modules.head(\n",
    "            20\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "else:\n",
    "\n",
    "    print(\n",
    "        \"No pathway modules passed the overlap criteria.\"\n",
    "    )\n",
    "\n",
    "\n",
    "if (\n",
    "    CANDIDATES_INCLUDED\n",
    "    and\n",
    "    len(\n",
    "        candidate_pathway_map\n",
    "    )\n",
    "    >\n",
    "    0\n",
    "):\n",
    "\n",
    "    print(\n",
    "        \"\\n\"\n",
    "        +\n",
    "        \"=\" * 90\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"TOP CANDIDATE ↔ PATHWAY CONNECTIONS\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"=\" * 90\n",
    "    )\n",
    "\n",
    "\n",
    "    display(\n",
    "\n",
    "        candidate_pathway_map\n",
    "        .sort_values(\n",
    "            [\n",
    "                \"candidate_rank\",\n",
    "                \"pathway_rank\",\n",
    "            ]\n",
    "        )\n",
    "        .head(\n",
    "            50\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPathway ranking:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    PATHWAY_RANK_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPublication pathway shortlist:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    SHORTLIST_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPathway modules:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    MODULE_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nCandidate ↔ pathway map:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    CANDIDATE_PATHWAY_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFreeze record:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    LOCK_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nNEXT:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"CORE COMPUTATIONAL ANALYSIS IS COMPLETE.\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Next step = publication figures and final result tables.\"\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Part VIII — Pathway robustness audits\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 78\n",
    "# ============================================================\n",
    "# RETINA-ND — SELF-CONTAINED R3 AUDIT\n",
    "#\n",
    "# SAFE AFTER A FRESH COLAB RESTART.\n",
    "#\n",
    "# This cell:\n",
    "#   1. mounts Google Drive\n",
    "#   2. locates RETINA_ND_V2\n",
    "#   3. locates the frozen Reactome convergence table\n",
    "#   4. reconstructs that table from the frozen raw GSEA file\n",
    "#      if the derived convergence table is missing\n",
    "#   5. verifies the ORIGINAL frozen R2/R3 counts\n",
    "#   6. performs the R3 global recurrence null test\n",
    "#\n",
    "# DOES NOT rerun GSEA.\n",
    "# DOES NOT change upstream AD/PD results.\n",
    "# ============================================================\n",
    "\n",
    "from google.colab import drive\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. MOUNT DRIVE — ALWAYS\n",
    "# ============================================================\n",
    "\n",
    "drive.mount(\n",
    "    \"/content/drive\",\n",
    "    force_remount=False,\n",
    ")\n",
    "\n",
    "MYDRIVE = Path(\n",
    "    \"/content/drive/MyDrive\"\n",
    ")\n",
    "\n",
    "assert MYDRIVE.exists(), (\n",
    "    \"Google Drive mounted but MyDrive is not visible.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. EXPECTED FILE NAMES\n",
    "# ============================================================\n",
    "\n",
    "PATHWAY_NAME = (\n",
    "    \"AD_PD_REACTOME_V97_\"\n",
    "    \"PATHWAY_CONVERGENCE_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "RAW_NAME = (\n",
    "    \"AD_PD_REACTOME_V97_\"\n",
    "    \"PRERANK_ALL_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "EXPECTED_ROOT = (\n",
    "    MYDRIVE\n",
    "    / \"RETINA_ND_V2\"\n",
    ")\n",
    "\n",
    "EXPECTED_CONV = (\n",
    "    EXPECTED_ROOT\n",
    "    / \"results\"\n",
    "    / \"cross_disease_convergence\"\n",
    "    / PATHWAY_NAME\n",
    ")\n",
    "\n",
    "EXPECTED_RAW = (\n",
    "    EXPECTED_ROOT\n",
    "    / \"results\"\n",
    "    / \"cross_disease_convergence\"\n",
    "    / RAW_NAME\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. RESOLVE FILE WITHOUT GUESSING\n",
    "# ============================================================\n",
    "\n",
    "def resolve_exact_file(\n",
    "    expected_path,\n",
    "    filename,\n",
    "):\n",
    "\n",
    "    if expected_path.exists():\n",
    "\n",
    "        print(\n",
    "            f\"FOUND expected file:\\n\"\n",
    "            f\"{expected_path}\"\n",
    "        )\n",
    "\n",
    "        return expected_path\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nExpected path not currently visible:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        expected_path\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"\\nSearching MyDrive for exact filename:\\n\"\n",
    "        f\"{filename}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    hits = list(\n",
    "        MYDRIVE.rglob(\n",
    "            filename\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Matches found:\",\n",
    "        len(hits),\n",
    "    )\n",
    "\n",
    "\n",
    "    for hit in hits:\n",
    "\n",
    "        print(\n",
    "            \"  \",\n",
    "            hit,\n",
    "        )\n",
    "\n",
    "\n",
    "    if len(hits) == 1:\n",
    "\n",
    "        return hits[0]\n",
    "\n",
    "\n",
    "    if len(hits) > 1:\n",
    "\n",
    "        project_hits = [\n",
    "            p\n",
    "            for p in hits\n",
    "            if \"RETINA_ND_V2\"\n",
    "            in p.parts\n",
    "        ]\n",
    "\n",
    "\n",
    "        if len(project_hits) == 1:\n",
    "\n",
    "            print(\n",
    "                \"\\nUsing unique RETINA_ND_V2 match:\"\n",
    "            )\n",
    "\n",
    "            print(\n",
    "                project_hits[0]\n",
    "            )\n",
    "\n",
    "            return project_hits[0]\n",
    "\n",
    "\n",
    "        raise RuntimeError(\n",
    "            \"Multiple non-unique copies were found. \"\n",
    "            \"Refusing to guess.\"\n",
    "        )\n",
    "\n",
    "\n",
    "    return None\n",
    "\n",
    "\n",
    "PATHWAY_PATH = resolve_exact_file(\n",
    "    EXPECTED_CONV,\n",
    "    PATHWAY_NAME,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. IF DERIVED PATHWAY TABLE IS MISSING,\n",
    "#    RECOVER IT FROM THE FROZEN RAW GSEA RESULTS\n",
    "# ============================================================\n",
    "\n",
    "if PATHWAY_PATH is None:\n",
    "\n",
    "    print(\n",
    "        \"\\n\"\n",
    "        + \"=\" * 80\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"DERIVED PATHWAY TABLE IS MISSING\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Attempting safe reconstruction from frozen raw GSEA...\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "\n",
    "    RAW_PATH = resolve_exact_file(\n",
    "        EXPECTED_RAW,\n",
    "        RAW_NAME,\n",
    "    )\n",
    "\n",
    "\n",
    "    if RAW_PATH is None:\n",
    "\n",
    "        raise FileNotFoundError(\n",
    "            \"\\nNeither the pathway-convergence table nor the \"\n",
    "            \"frozen raw Reactome GSEA table exists anywhere \"\n",
    "            \"visible in MyDrive.\\n\\n\"\n",
    "            \"At this point DO NOT rerun anything automatically.\"\n",
    "        )\n",
    "\n",
    "\n",
    "    ROOT = (\n",
    "        RAW_PATH\n",
    "        .parent\n",
    "        .parent\n",
    "        .parent\n",
    "    )\n",
    "\n",
    "\n",
    "    OUT = (\n",
    "        ROOT\n",
    "        / \"results\"\n",
    "        / \"cross_disease_convergence\"\n",
    "    )\n",
    "\n",
    "\n",
    "    OUT.mkdir(\n",
    "        parents=True,\n",
    "        exist_ok=True,\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nDetected project root:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        ROOT\n",
    "    )\n",
    "\n",
    "\n",
    "    raw = pd.read_csv(\n",
    "        RAW_PATH,\n",
    "        compression=\"gzip\",\n",
    "    )\n",
    "\n",
    "\n",
    "    required_raw = {\n",
    "        \"cell_type\",\n",
    "        \"disease\",\n",
    "    }\n",
    "\n",
    "\n",
    "    missing = (\n",
    "        required_raw\n",
    "        -\n",
    "        set(raw.columns)\n",
    "    )\n",
    "\n",
    "\n",
    "    assert not missing, (\n",
    "        f\"Raw GSEA file missing columns: \"\n",
    "        f\"{sorted(missing)}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Detect original GSEA output columns exactly as notebook did\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    if \"Term\" in raw.columns:\n",
    "\n",
    "        TERM_COL = \"Term\"\n",
    "\n",
    "    else:\n",
    "\n",
    "        possible = [\n",
    "            c\n",
    "            for c in raw.columns\n",
    "            if str(c).lower().strip()\n",
    "            ==\n",
    "            \"term\"\n",
    "        ]\n",
    "\n",
    "\n",
    "        assert len(possible) == 1, (\n",
    "            \"Could not uniquely identify pathway Term column.\"\n",
    "        )\n",
    "\n",
    "\n",
    "        TERM_COL = possible[0]\n",
    "\n",
    "\n",
    "    nes_hits = [\n",
    "        c\n",    "        for c in raw.columns\n",
    "        if str(c).lower().strip()\n",
    "        ==\n",
    "        \"nes\"\n",
    "    ]\n",
    "\n",
    "\n",
    "    assert len(nes_hits) == 1, (\n",
    "        f\"Could not uniquely identify NES column: {nes_hits}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    NES_COL = nes_hits[0]\n",
    "\n",
    "\n",
    "    fdr_hits = [\n",
    "        c\n",
    "        for c in raw.columns\n",
    "        if str(c).lower().strip()\n",
    "        in {\n",
    "            \"fdr q-val\",\n",
    "            \"fdr\",\n",
    "        }\n",
    "    ]\n",
    "\n",
    "\n",
    "    assert len(fdr_hits) == 1, (\n",
    "        f\"Could not uniquely identify FDR column: {fdr_hits}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    FDR_COL = fdr_hits[0]\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nDetected raw columns:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Term:\",\n",
    "        TERM_COL,\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"NES:\",\n",
    "        NES_COL,\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"FDR:\",\n",
    "        FDR_COL,\n",
    "    )\n",
    "\n",
    "\n",
    "    CLASSES = [\n",
    "        \"Astro\",\n",
    "        \"Micro\",\n",
    "        \"OPC\",\n",
    "        \"Oligo\",\n",
    "    ]\n",
    "\n",
    "\n",
    "    comparison_rows = []\n",
    "\n",
    "\n",
    "    for ct in CLASSES:\n",
    "\n",
    "\n",
    "        ad = (\n",
    "            raw.loc[\n",
    "                (\n",
    "                    raw[\"cell_type\"]\n",
    "                    ==\n",
    "                    ct\n",
    "                )\n",
    "                &\n",
    "                (\n",
    "                    raw[\"disease\"]\n",
    "                    ==\n",
    "                    \"AD\"\n",
    "                ),\n",
    "                [\n",
    "                    TERM_COL,\n",
    "                    NES_COL,\n",
    "                    FDR_COL,\n",
    "                ],\n",
    "            ]\n",
    "            .rename(\n",
    "                columns={\n",
    "                    TERM_COL:\n",
    "                        \"pathway\",\n",
    "\n",
    "                    NES_COL:\n",
    "                        \"NES_AD\",\n",
    "\n",
    "                    FDR_COL:\n",
    "                        \"FDR_AD\",\n",
    "                }\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "        pd_ = (\n",
    "            raw.loc[\n",
    "                (\n",
    "                    raw[\"cell_type\"]\n",
    "                    ==\n",
    "                    ct\n",
    "                )\n",
    "                &\n",
    "                (\n",
    "                    raw[\"disease\"]\n",
    "                    ==\n",
    "                    \"PD\"\n",
    "                ),\n",
    "                [\n",
    "                    TERM_COL,\n",
    "                    NES_COL,\n",
    "                    FDR_COL,\n",
    "                ],\n",
    "            ]\n",
    "            .rename(\n",
    "                columns={\n",
    "                    TERM_COL:\n",
    "                        \"pathway\",\n",
    "\n",
    "                    NES_COL:\n",
    "                        \"NES_PD\",\n",
    "\n",
    "                    FDR_COL:\n",
    "                        \"FDR_PD\",\n",
    "                }\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "        x = ad.merge(\n",
    "            pd_,\n",
    "            on=\"pathway\",\n",
    "            how=\"inner\",\n",
    "            validate=\"one_to_one\",\n",
    "        )\n",
    "\n",
    "\n",
    "        x.insert(\n",
    "            0,\n",
    "            \"cell_type\",\n",
    "            ct,\n",
    "        )\n",
    "\n",
    "\n",
    "        for col in [\n",
    "            \"NES_AD\",\n",
    "            \"NES_PD\",\n",
    "            \"FDR_AD\",\n",
    "            \"FDR_PD\",\n",
    "        ]:\n",
    "\n",
    "            x[col] = pd.to_numeric(\n",
    "                x[col],\n",
    "                errors=\"coerce\",\n",
    "            )\n",
    "\n",
    "\n",
    "        x[\n",
    "            \"same_direction\"\n",
    "        ] = (\n",
    "            np.sign(\n",
    "                x[\"NES_AD\"]\n",
    "            )\n",
    "            ==\n",
    "            np.sign(\n",
    "                x[\"NES_PD\"]\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "        x[\n",
    "            \"both_FDR05\"\n",
    "        ] = (\n",
    "            (\n",
    "                x[\"FDR_AD\"]\n",
    "                <\n",
    "                0.05\n",
    "            )\n",
    "            &\n",
    "            (\n",
    "                x[\"FDR_PD\"]\n",
    "                <\n",
    "                0.05\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "        x[\n",
    "            \"convergent_pathway\"\n",
    "        ] = (\n",
    "            x[\"same_direction\"]\n",
    "            &\n",
    "            x[\"both_FDR05\"]\n",
    "        )\n",
    "\n",
    "\n",
    "        x[\n",
    "            \"conservative_abs_NES\"\n",
    "        ] = np.minimum(\n",
    "            np.abs(\n",
    "                x[\"NES_AD\"]\n",
    "            ),\n",
    "            np.abs(\n",
    "                x[\"NES_PD\"]\n",
    "            ),\n",
    "        )\n",
    "\n",
    "\n",
    "        comparison_rows.append(\n",
    "            x\n",
    "        )\n",
    "\n",
    "\n",
    "    pathway_conv = pd.concat(\n",
    "        comparison_rows,\n",
    "        ignore_index=True,\n",
    "    )\n",
    "\n",
    "\n",
    "    PATHWAY_PATH = (\n",
    "        OUT\n",
    "        / PATHWAY_NAME\n",
    "    )\n",
    "\n",
    "\n",
    "    pathway_conv.to_csv(\n",
    "        PATHWAY_PATH,\n",
    "        index=False,\n",
    "        compression=\"gzip\",\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nRECOVERED pathway-convergence table:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        PATHWAY_PATH\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. LOAD + VERIFY PATHWAY TABLE\n",
    "# ============================================================\n",
    "\n",
    "df = pd.read_csv(\n",
    "    PATHWAY_PATH,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "required = {\n",
    "    \"cell_type\",\n",
    "    \"pathway\",\n",
    "    \"NES_AD\",\n",
    "    \"FDR_AD\",\n",
    "    \"NES_PD\",\n",
    "    \"FDR_PD\",\n",
    "}\n",
    "\n",
    "\n",
    "missing = (\n",
    "    required\n",
    "    -\n",
    "    set(df.columns)\n",
    ")\n",
    "\n",
    "\n",
    "assert not missing, (\n",
    "    f\"Pathway table missing columns: {sorted(missing)}\"\n",
    ")\n",
    "\n",
    "\n",
    "for col in [\n",
    "    \"NES_AD\",\n",
    "    \"FDR_AD\",\n",
    "    \"NES_PD\",\n",
    "    \"FDR_PD\",\n",
    "]:\n",
    "\n",
    "    df[col] = pd.to_numeric(\n",
    "        df[col],\n",
    "        errors=\"coerce\",\n",
    "    )\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    + \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PATHWAY TABLE RECOVERED\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Path:\",\n",
    "    PATHWAY_PATH,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Rows:\",\n",
    "    f\"{len(df):,}\",\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Unique pathways:\",\n",
    "    f\"{df['pathway'].nunique():,}\",\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nRows by cell type:\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    df[\n",
    "        \"cell_type\"\n",
    "    ].value_counts()\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. RECONSTRUCT CURRENT R1 / R2 / R3 CLASSIFICATION\n",
    "#    DIRECTLY FROM THE FROZEN TABLE\n",
    "# ============================================================\n",
    "\n",
    "pathway_summary = (\n",
    "    df\n",
    "    .groupby(\n",
    "        \"pathway\",\n",
    "        as_index=False,\n",
    "    )\n",
    "    .agg(\n",
    "        n_convergent=(\n",
    "            \"convergent_pathway\",\n",
    "            \"sum\",\n",
    "        ),\n",
    "        n_same_direction=(\n",
    "            \"same_direction\",\n",
    "            \"sum\",\n",
    "        ),\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "pathway_summary[\n",
    "    \"priority\"\n",
    "] = np.select(\n",
    "    [\n",
    "        pathway_summary[\n",
    "            \"n_convergent\"\n",
    "        ]\n",
    "        >=\n",
    "        2,\n",
    "\n",
    "        pathway_summary[\n",
    "            \"n_convergent\"\n",
    "        ]\n",
    "        ==\n",
    "        1,\n",
    "\n",
    "        (\n",
    "            pathway_summary[\n",
    "                \"n_convergent\"\n",
    "            ]\n",
    "            ==\n",
    "            0\n",
    "        )\n",
    "        &\n",
    "        (\n",
    "            pathway_summary[\n",
    "                \"n_same_direction\"\n",
    "            ]\n",
    "            >=\n",
    "            3\n",
    "        ),\n",
    "    ],\n",
    "    [\n",
    "        \"R1\",\n",
    "        \"R2\",\n",
    "        \"R3\",\n",
    "    ],\n",
    "    default=\"other\",\n",
    ")\n",
    "\n",
    "\n",
    "counts = (\n",
    "    pathway_summary[\n",
    "        \"priority\"\n",
    "    ]\n",
    "    .value_counts()\n",
    ")\n",
    "\n",
    "\n",
    "OBS_R1 = int(\n",
    "    counts.get(\n",
    "        \"R1\",\n",
    "        0,\n",
    "    )\n",
    ")\n",
    "\n",
    "OBS_R2 = int(\n",
    "    counts.get(\n",
    "        \"R2\",\n",
    "        0,\n",
    "    )\n",
    ")\n",
    "\n",
    "OBS_R3 = int(\n",
    "    counts.get(\n",
    "        \"R3\",\n",
    "        0,\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    + \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"FROZEN PRIORITY CHECK\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"R1:\",\n",
    "    OBS_R1,\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"R2:\",\n",
    "    OBS_R2,\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"R3:\",\n",
    "    OBS_R3,\n",
    ")\n",
    "\n",
    "\n",
    "# These are the counts stored in YOUR existing notebook.\n",
    "assert OBS_R1 == 0, (\n",
    "    f\"Expected frozen R1=0, recovered {OBS_R1}\"\n",
    ")\n",
    "\n",
    "assert OBS_R2 == 29, (\n",
    "    f\"Expected frozen R2=29, recovered {OBS_R2}\"\n",
    ")\n",
    "\n",
    "assert OBS_R3 == 665, (\n",
    "    f\"Expected frozen R3=665, recovered {OBS_R3}\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFROZEN R1/R2/R3 COUNTS: VERIFIED\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. BUILD MATRICES FOR THE GLOBAL R3 NULL TEST\n",
    "# ============================================================\n",
    "\n",
    "CLASSES = [\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "]\n",
    "\n",
    "\n",
    "pathways = sorted(\n",
    "    df[\"pathway\"]\n",
    "    .dropna()\n",
    "    .astype(str)\n",
    "    .unique()\n",
    ")\n",
    "\n",
    "\n",
    "path_index = {\n",
    "    pathway: i\n",
    "    for i, pathway\n",
    "    in enumerate(pathways)\n",
    "}\n",
    "\n",
    "\n",
    "cell_index = {\n",
    "    cell: i\n",
    "    for i, cell\n",
    "    in enumerate(CLASSES)\n",
    "}\n",
    "\n",
    "\n",
    "shape = (\n",
    "    len(pathways),\n",
    "    len(CLASSES),\n",
    ")\n",
    "\n",
    "\n",
    "AD_NES = np.full(\n",
    "    shape,\n",
    "    np.nan,\n",
    ")\n",
    "\n",
    "PD_NES = np.full(\n",
    "    shape,\n",
    "    np.nan,\n",
    ")\n",
    "\n",
    "AD_FDR = np.full(\n",
    "    shape,\n",
    "    np.nan,\n",
    ")\n",
    "\n",
    "PD_FDR = np.full(\n",
    "    shape,\n",
    "    np.nan,\n",
    ")\n",
    "\n",
    "\n",
    "for row in df.itertuples(\n",
    "    index=False\n",
    "):\n",
    "\n",
    "    if row.cell_type not in cell_index:\n",
    "\n",
    "        continue\n",
    "\n",
    "\n",
    "    i = path_index[\n",
    "        str(row.pathway)\n",
    "    ]\n",
    "\n",
    "    j = cell_index[\n",
    "        row.cell_type\n",
    "    ]\n",
    "\n",
    "\n",
    "    AD_NES[\n",
    "        i,\n",
    "        j,\n",
    "    ] = row.NES_AD\n",
    "\n",
    "\n",
    "    PD_NES[\n",
    "        i,\n",
    "        j,\n",
    "    ] = row.NES_PD\n",
    "\n",
    "\n",
    "    AD_FDR[\n",
    "        i,\n",
    "        j,\n",
    "    ] = row.FDR_AD\n",
    "\n",
    "\n",
    "    PD_FDR[\n",
    "        i,\n",
    "        j,\n",
    "    ] = row.FDR_PD\n",
    "\n",
    "\n",
    "def classify(\n",
    "    ad_nes,\n",
    "    pd_nes,\n",
    "    ad_fdr,\n",
    "    pd_fdr,\n",
    "):\n",
    "\n",
    "    valid = (\n",
    "        np.isfinite(\n",
    "            ad_nes\n",
    "        )\n",
    "        &\n",
    "        np.isfinite(\n",
    "            pd_nes\n",
    "        )\n",
    "        &\n",
    "        np.isfinite(\n",
    "            ad_fdr\n",
    "        )\n",
    "        &\n",
    "        np.isfinite(\n",
    "            pd_fdr\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    same = (\n",
    "        valid\n",
    "        &\n",
    "        (\n",
    "            np.sign(\n",
    "                ad_nes\n",
    "            )\n",
    "            ==\n",
    "            np.sign(\n",
    "                pd_nes\n",
    "            )\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    formal = (\n",
    "        same\n",
    "        &\n",
    "        (\n",
    "            ad_fdr\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "        &\n",
    "        (\n",
    "            pd_fdr\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    n_same = same.sum(\n",
    "        axis=1\n",
    "    )\n",
    "\n",
    "    n_formal = formal.sum(\n",
    "        axis=1\n",
    "    )\n",
    "\n",
    "\n",
    "    r1 = (\n",
    "        n_formal\n",
    "        >=\n",
    "        2\n",
    "    )\n",
    "\n",
    "\n",
    "    r2 = (\n",
    "        n_formal\n",
    "        ==\n",
    "        1\n",
    "    )\n",
    "\n",
    "\n",
    "    r3 = (\n",
    "        (\n",
    "            n_formal\n",
    "            ==\n",
    "            0\n",
    "        )\n",
    "        &\n",
    "        (\n",
    "            n_same\n",
    "            >=\n",
    "            3\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    return (\n",
    "        int(\n",
    "            r1.sum()\n",
    "        ),\n",
    "        int(\n",
    "            r2.sum()\n",
    "        ),\n",
    "        int(\n",
    "            r3.sum()\n",
    "        ),\n",
    "    )\n",
    "\n",
    "\n",
    "check = classify(\n",
    "    AD_NES,\n",
    "    PD_NES,\n",
    "    AD_FDR,\n",
    "    PD_FDR,\n",
    ")\n",
    "\n",
    "\n",
    "assert check == (\n",
    "    0,\n",
    "    29,\n",
    "    665,\n",
    "), (\n",
    "    f\"Matrix reconstruction mismatch: {check}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. GLOBAL R3 RECURRENCE NULL\n",
    "# ============================================================\n",
    "\n",
    "N_PERM = 10_000\n",
    "\n",
    "SEED = 20260917\n",
    "\n",
    "\n",
    "rng = np.random.default_rng(\n",
    "    SEED\n",
    ")\n",
    "\n",
    "\n",
    "null_R3 = np.empty(\n",
    "    N_PERM,\n",
    "    dtype=np.int32,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    + \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"RUNNING 10,000-PERMUTATION R3 NULL\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "for b in range(\n",
    "    N_PERM\n",
    "):\n",
    "\n",
    "    perm_PD_NES = np.full_like(\n",
    "        PD_NES,\n",
    "        np.nan,\n",
    "    )\n",
    "\n",
    "\n",
    "    perm_PD_FDR = np.full_like(\n",
    "        PD_FDR,\n",
    "        np.nan,\n",
    "    )\n",
    "\n",
    "\n",
    "    for j in range(\n",
    "        len(CLASSES)\n",
    "    ):\n",
    "\n",
    "        valid = (\n",
    "            np.isfinite(\n",
    "                PD_NES[:, j]\n",
    "            )\n",
    "            &\n",
    "            np.isfinite(\n",
    "                PD_FDR[:, j]\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "        idx = np.flatnonzero(\n",
    "            valid\n",
    "        )\n",
    "\n",
    "\n",
    "        shuffled = rng.permutation(\n",
    "            idx\n",
    "        )\n",
    "\n",
    "\n",
    "        # Keep each PD pathway's NES and FDR together.\n",
    "        perm_PD_NES[\n",
    "            idx,\n",
    "            j,\n",
    "        ] = PD_NES[\n",
    "            shuffled,\n",
    "            j,\n",
    "        ]\n",
    "\n",
    "\n",
    "        perm_PD_FDR[\n",
    "            idx,\n",
    "            j,\n",
    "        ] = PD_FDR[\n",
    "            shuffled,\n",
    "            j,\n",
    "        ]\n",
    "\n",
    "\n",
    "    _, _, r3_count = classify(\n",
    "        AD_NES,\n",
    "        perm_PD_NES,\n",
    "        AD_FDR,\n",
    "        perm_PD_FDR,\n",
    "    )\n",
    "\n",
    "\n",
    "    null_R3[\n",
    "        b\n",
    "    ] = r3_count\n",
    "\n",
    "\n",
    "    if (\n",
    "        (b + 1)\n",
    "        %\n",
    "        1000\n",
    "        ==\n",
    "        0\n",
    "    ):\n",
    "\n",
    "        print(\n",
    "            f\"{b + 1:,}\"\n",
    "            f\" / \"\n",
    "            f\"{N_PERM:,}\"\n",
    "        )\n",
    "\n",
    "\n",
    "empirical_p = (\n",
    "    1\n",
    "    +\n",
    "    np.sum(\n",
    "        null_R3\n",
    "        >=\n",
    "        OBS_R3\n",
    "    )\n",
    ") / (\n",
    "    N_PERM\n",
    "    +\n",
    "    1\n",
    ")\n",
    "\n",
    "\n",
    "q025, q975 = np.quantile(\n",
    "    null_R3,\n",
    "    [\n",
    "        0.025,\n",
    "        0.975,\n",
    "    ],\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    + \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"RETINA-ND R3 AUDIT COMPLETE\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Observed R3:\",\n",
    "    OBS_R3,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Null mean:\",\n",
    "    float(\n",
    "        null_R3.mean()\n",
    "    ),\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Null median:\",\n",
    "    float(\n",
    "        np.median(\n",
    "            null_R3\n",
    "        )\n",
    "    ),\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Null 95% interval:\",\n",
    "    (\n",
    "        float(q025),\n",
    "        float(q975),\n",
    "    ),\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Empirical P:\",\n",
    "    empirical_p,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. SAVE AUDIT\n",
    "# ============================================================\n",
    "\n",
    "ROOT = (\n",
    "    PATHWAY_PATH\n",
    "    .parent\n",
    "    .parent\n",
    "    .parent\n",
    ")\n",
    "\n",
    "\n",
    "OUT = (\n",
    "    ROOT\n",
    "    / \"results\"\n",
    "    / \"cross_disease_convergence\"\n",
    ")\n",
    "\n",
    "\n",
    "SUMMARY_PATH = (\n",
    "    OUT\n",
    "    / \"AD_PD_REACTOME_R3_RECURRENCE_NULL_AUDIT_v1.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "NULL_PATH = (\n",
    "    OUT\n",
    "    / \"AD_PD_REACTOME_R3_RECURRENCE_NULL_DISTRIBUTION_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "pd.DataFrame(\n",
    "    {\n",
    "        \"metric\": [\n",
    "            \"observed_R1\",\n",
    "            \"observed_R2\",\n",
    "            \"observed_R3\",\n",
    "            \"null_R3_mean\",\n",
    "            \"null_R3_median\",\n",
    "            \"null_R3_2.5pct\",\n",
    "            \"null_R3_97.5pct\",\n",
    "            \"R3_empirical_P\",\n",
    "            \"n_permutations\",\n",
    "            \"seed\",\n",
    "        ],\n",
    "        \"value\": [\n",
    "            OBS_R1,\n",
    "            OBS_R2,\n",
    "            OBS_R3,\n",
    "            float(\n",
    "                null_R3.mean()\n",
    "            ),\n",
    "            float(\n",
    "                np.median(\n",
    "                    null_R3\n",
    "                )\n",
    "            ),\n",
    "            float(q025),\n",
    "            float(q975),\n",
    "            empirical_p,\n",
    "            N_PERM,\n",
    "            SEED,\n",
    "        ],\n",
    "    }\n",
    ").to_csv(\n",
    "    SUMMARY_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "pd.DataFrame(\n",
    "    {\n",
    "        \"permutation\":\n",
    "            np.arange(\n",
    "                1,\n",
    "                N_PERM + 1,\n",
    "            ),\n",
    "\n",
    "        \"R3_count\":\n",
    "            null_R3,\n",
    "    }\n",
    ").to_csv(\n",
    "    NULL_PATH,\n",
    "    index=False,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSaved:\"\n",
    ")\n",    "\n",
    "print(\n",
    "    SUMMARY_PATH\n",
    ")\n",
    "\n",
    "print(\n",
    "    NULL_PATH\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 79\n",
    "# ============================================================\n",
    "# RETINA-ND — R3 ROBUSTNESS AUDIT\n",
    "# PROFILE-PRESERVING PATHWAY PERMUTATION\n",
    "#\n",
    "# PRIMARY PURPOSE\n",
    "# ---------------\n",
    "# Preserve the complete PD pathway profile across:\n",
    "#   Astro / Micro / OPC / Oligo\n",
    "#\n",
    "# Then shuffle pathway identity AS A BLOCK.\n",
    "#\n",
    "# This preserves:\n",
    "#   - PD cross-cell structure\n",
    "#   - PD NES correlations across cell classes\n",
    "#   - PD FDR correlations across cell classes\n",
    "#   - missingness structure\n",
    "#\n",
    "# while breaking:\n",
    "#   - pathway-specific AD ↔ PD correspondence\n",
    "#\n",
    "# Does NOT rerun GSEA.\n",
    "# Does NOT alter frozen results.\n",
    "# ============================================================\n",
    "\n",
    "from google.colab import drive\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. MOUNT DRIVE\n",
    "# ============================================================\n",
    "\n",
    "drive.mount(\n",
    "    \"/content/drive\",\n",
    "    force_remount=False,\n",
    ")\n",
    "\n",
    "MYDRIVE = Path(\n",
    "    \"/content/drive/MyDrive\"\n",
    ")\n",
    "\n",
    "FILENAME = (\n",
    "    \"AD_PD_REACTOME_V97_\"\n",
    "    \"PATHWAY_CONVERGENCE_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. FIND THE CORRECT FROZEN TABLE\n",
    "# ============================================================\n",
    "\n",
    "hits = list(\n",
    "    MYDRIVE.rglob(\n",
    "        FILENAME\n",
    "    )\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Exact filename matches:\",\n",
    "    len(hits),\n",
    ")\n",
    "\n",
    "for p in hits:\n",
    "    print(\" \", p)\n",
    "\n",
    "assert len(hits) >= 1, (\n",
    "    f\"Could not find {FILENAME}\"\n",
    ")\n",
    "\n",
    "\n",
    "required = {\n",
    "    \"cell_type\",\n",
    "    \"pathway\",\n",
    "    \"NES_AD\",\n",
    "    \"FDR_AD\",\n",
    "    \"NES_PD\",\n",
    "    \"FDR_PD\",\n",
    "}\n",
    "\n",
    "\n",
    "def load_candidate(path):\n",
    "\n",
    "    try:\n",
    "\n",
    "        x = pd.read_csv(\n",
    "            path,\n",
    "            compression=\"gzip\",\n",
    "        )\n",
    "\n",
    "    except Exception:\n",
    "\n",
    "        return None\n",
    "\n",
    "\n",
    "    if not required.issubset(\n",
    "        x.columns\n",
    "    ):\n",
    "\n",
    "        return None\n",
    "\n",
    "\n",
    "    for col in [\n",
    "        \"NES_AD\",\n",
    "        \"FDR_AD\",\n",
    "        \"NES_PD\",\n",
    "        \"FDR_PD\",\n",
    "    ]:\n",
    "\n",
    "        x[col] = pd.to_numeric(\n",
    "            x[col],\n",
    "            errors=\"coerce\",\n",
    "        )\n",
    "\n",
    "\n",
    "    # Reproduce frozen pathway classification.\n",
    "\n",
    "    temp = x.copy()\n",
    "\n",
    "    temp[\n",
    "        \"_same\"\n",
    "    ] = (\n",
    "        np.sign(\n",
    "            temp[\"NES_AD\"]\n",
    "        )\n",
    "        ==\n",
    "        np.sign(\n",
    "            temp[\"NES_PD\"]\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    temp[\n",
    "        \"_formal\"\n",
    "    ] = (\n",
    "        temp[\"_same\"]\n",
    "        &\n",
    "        (\n",
    "            temp[\"FDR_AD\"]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "        &\n",
    "        (\n",
    "            temp[\"FDR_PD\"]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    s = (\n",
    "        temp\n",
    "        .groupby(\n",
    "            \"pathway\",\n",
    "            as_index=False,\n",
    "        )\n",
    "        .agg(\n",
    "            n_same=(\n",
    "                \"_same\",\n",
    "                \"sum\",\n",
    "            ),\n",
    "            n_formal=(\n",
    "                \"_formal\",\n",
    "                \"sum\",\n",
    "            ),\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    r1 = int(\n",
    "        (\n",
    "            s[\"n_formal\"]\n",
    "            >=\n",
    "            2\n",
    "        ).sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    r2 = int(\n",
    "        (\n",
    "            s[\"n_formal\"]\n",
    "            ==\n",
    "            1\n",
    "        ).sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    r3 = int(\n",
    "        (\n",
    "            (\n",
    "                s[\"n_formal\"]\n",
    "                ==\n",
    "                0\n",
    "            )\n",
    "            &\n",
    "            (\n",
    "                s[\"n_same\"]\n",
    "                >=\n",
    "                3\n",
    "            )\n",
    "        ).sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    return (\n",
    "        x,\n",
    "        r1,\n",
    "        r2,\n",
    "        r3,\n",
    "    )\n",
    "\n",
    "\n",
    "valid_candidates = []\n",
    "\n",
    "for path in hits:\n",
    "\n",
    "    result = load_candidate(\n",
    "        path\n",
    "    )\n",
    "\n",
    "    if result is None:\n",
    "        continue\n",
    "\n",
    "    x, r1, r2, r3 = result\n",
    "\n",
    "    print(\n",
    "        \"\\nCandidate:\",\n",
    "        path,\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \" rows:\",\n",
    "        len(x),\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \" pathways:\",\n",
    "        x[\"pathway\"].nunique(),\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \" R1/R2/R3:\",\n",
    "        r1,\n",
    "        r2,\n",
    "        r3,\n",
    "    )\n",
    "\n",
    "\n",
    "    if (\n",
    "        r1 == 0\n",
    "        and\n",
    "        r2 == 29\n",
    "        and\n",
    "        r3 == 665\n",
    "    ):\n",
    "\n",
    "        valid_candidates.append(\n",
    "            (\n",
    "                path,\n",
    "                x,\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "assert len(valid_candidates) == 1, (\n",
    "    \"Could not identify exactly one frozen table \"\n",
    "    \"matching R1=0, R2=29, R3=665.\"\n",
    ")\n",
    "\n",
    "\n",
    "PATHWAY_PATH, df = (\n",
    "    valid_candidates[0]\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nUsing VERIFIED table:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    PATHWAY_PATH\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. BUILD PATHWAY × CELL-CLASS MATRICES\n",
    "# ============================================================\n",
    "\n",
    "CELL_TYPES = [\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "]\n",
    "\n",
    "\n",
    "pathways = sorted(\n",
    "    df[\n",
    "        \"pathway\"\n",
    "    ]\n",
    "    .dropna()\n",
    "    .astype(str)\n",
    "    .unique()\n",
    ")\n",
    "\n",
    "\n",
    "path_index = {\n",
    "    p: i\n",
    "    for i, p\n",
    "    in enumerate(pathways)\n",
    "}\n",
    "\n",
    "\n",
    "cell_index = {\n",
    "    c: i\n",
    "    for i, c\n",
    "    in enumerate(CELL_TYPES)\n",
    "}\n",
    "\n",
    "\n",
    "shape = (\n",
    "    len(pathways),\n",
    "    len(CELL_TYPES),\n",
    ")\n",
    "\n",
    "\n",
    "AD_NES = np.full(\n",
    "    shape,\n",
    "    np.nan,\n",
    ")\n",
    "\n",
    "PD_NES = np.full(\n",
    "    shape,\n",
    "    np.nan,\n",
    ")\n",
    "\n",
    "AD_FDR = np.full(\n",
    "    shape,\n",
    "    np.nan,\n",
    ")\n",
    "\n",
    "PD_FDR = np.full(\n",
    "    shape,\n",
    "    np.nan,\n",
    ")\n",
    "\n",
    "\n",
    "for row in df.itertuples(\n",
    "    index=False\n",
    "):\n",
    "\n",
    "    if row.cell_type not in cell_index:\n",
    "\n",
    "        continue\n",
    "\n",
    "\n",
    "    i = path_index[\n",
    "        str(row.pathway)\n",
    "    ]\n",
    "\n",
    "    j = cell_index[\n",
    "        row.cell_type\n",
    "    ]\n",
    "\n",
    "\n",
    "    AD_NES[i, j] = (\n",
    "        row.NES_AD\n",
    "    )\n",
    "\n",
    "    PD_NES[i, j] = (\n",
    "        row.NES_PD\n",
    "    )\n",
    "\n",
    "    AD_FDR[i, j] = (\n",
    "        row.FDR_AD\n",
    "    )\n",
    "\n",
    "    PD_FDR[i, j] = (\n",
    "        row.FDR_PD\n",
    "    )\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nMatrix shape:\",\n",
    "    AD_NES.shape,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. CLASSIFICATION FUNCTION\n",
    "# ============================================================\n",
    "\n",
    "def pathway_counts(\n",
    "    ad_nes,\n",
    "    pd_nes,\n",
    "    ad_fdr,\n",
    "    pd_fdr,\n",
    "):\n",
    "\n",
    "    valid = (\n",
    "        np.isfinite(\n",
    "            ad_nes\n",
    "        )\n",
    "        &\n",
    "        np.isfinite(\n",
    "            pd_nes\n",
    "        )\n",
    "        &\n",
    "        np.isfinite(\n",
    "            ad_fdr\n",
    "        )\n",
    "        &\n",
    "        np.isfinite(\n",
    "            pd_fdr\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    same = (\n",
    "        valid\n",
    "        &\n",
    "        (\n",
    "            np.sign(\n",
    "                ad_nes\n",
    "            )\n",
    "            ==\n",
    "            np.sign(\n",
    "                pd_nes\n",
    "            )\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    formal = (\n",
    "        same\n",
    "        &\n",
    "        (\n",
    "            ad_fdr\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "        &\n",
    "        (\n",
    "            pd_fdr\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    n_same = same.sum(\n",
    "        axis=1\n",
    "    )\n",
    "\n",
    "    n_formal = formal.sum(\n",
    "        axis=1\n",
    "    )\n",
    "\n",
    "\n",
    "    R1 = (\n",
    "        n_formal\n",
    "        >=\n",
    "        2\n",
    "    )\n",
    "\n",
    "\n",
    "    R2 = (\n",
    "        n_formal\n",
    "        ==\n",
    "        1\n",
    "    )\n",
    "\n",
    "\n",
    "    R3 = (\n",
    "        (\n",
    "            n_formal\n",
    "            ==\n",
    "            0\n",
    "        )\n",
    "        &\n",
    "        (\n",
    "            n_same\n",
    "            >=\n",
    "            3\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    return (\n",
    "        int(\n",
    "            R1.sum()\n",
    "        ),\n",
    "        int(\n",
    "            R2.sum()\n",
    "        ),\n",
    "        int(\n",
    "            R3.sum()\n",
    "        ),\n",
    "    )\n",
    "\n",
    "\n",
    "observed = pathway_counts(\n",
    "    AD_NES,\n",
    "    PD_NES,\n",
    "    AD_FDR,\n",
    "    PD_FDR,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nObserved R1/R2/R3:\",\n",
    "    observed,\n",
    ")\n",
    "\n",
    "\n",
    "assert observed == (\n",
    "    0,\n",
    "    29,\n",
    "    665,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. PROFILE-PRESERVING NULL\n",
    "#\n",
    "# IMPORTANT:\n",
    "#\n",
    "# We permute WHOLE PD pathway rows.\n",
    "#\n",
    "# Therefore Astro/Micro/OPC/Oligo PD values from a given\n",
    "# pathway remain together.\n",
    "# ============================================================\n",
    "\n",
    "N_PERM = 10_000\n",
    "\n",
    "SEED = 20260917\n",
    "\n",
    "rng = np.random.default_rng(\n",
    "    SEED\n",
    ")\n",
    "\n",
    "\n",
    "null_R3 = np.empty(\n",
    "    N_PERM,\n",
    "    dtype=np.int32,\n",
    ")\n",
    "\n",
    "\n",
    "n_pathways = (\n",
    "    PD_NES.shape[0]\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    + \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"RUNNING PROFILE-PRESERVING NULL\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "for b in range(\n",
    "    N_PERM\n",
    "):\n",
    "\n",
    "    order = rng.permutation(\n",
    "        n_pathways\n",
    "    )\n",
    "\n",
    "\n",
    "    perm_PD_NES = (\n",
    "        PD_NES[\n",
    "            order,\n",
    "            :\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    perm_PD_FDR = (\n",
    "        PD_FDR[\n",
    "            order,\n",
    "            :\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    _, _, r3 = pathway_counts(\n",
    "        AD_NES,\n",
    "        perm_PD_NES,\n",
    "        AD_FDR,\n",
    "        perm_PD_FDR,\n",
    "    )\n",
    "\n",
    "\n",
    "    null_R3[\n",
    "        b\n",
    "    ] = r3\n",
    "\n",
    "\n",
    "    if (\n",
    "        (b + 1)\n",
    "        %\n",
    "        1000\n",
    "        ==\n",
    "        0\n",
    "    ):\n",
    "\n",
    "        print(\n",
    "            f\"{b + 1:,}\"\n",
    "            f\" / \"\n",
    "            f\"{N_PERM:,}\"\n",
    "        )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. EMPIRICAL RESULT\n",
    "# ============================================================\n",
    "\n",
    "OBS_R3 = 665\n",
    "\n",
    "\n",
    "empirical_p = (\n",
    "    1\n",
    "    +\n",
    "    np.sum(\n",
    "        null_R3\n",
    "        >=\n",
    "        OBS_R3\n",
    "    )\n",
    ") / (\n",
    "    N_PERM\n",
    "    +\n",
    "    1\n",
    ")\n",
    "\n",
    "\n",
    "null_mean = float(\n",
    "    np.mean(\n",
    "        null_R3\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "null_median = float(\n",
    "    np.median(\n",
    "        null_R3\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "q025, q975 = np.quantile(\n",
    "    null_R3,\n",
    "    [\n",
    "        0.025,\n",
    "        0.975,\n",
    "    ],\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    + \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PROFILE-PRESERVING R3 AUDIT COMPLETE\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Observed R3:\",\n",
    "    OBS_R3,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Null mean:\",\n",
    "    null_mean,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Null median:\",\n",
    "    null_median,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Null 95% interval:\",\n",
    "    (\n",
    "        float(q025),\n",
    "        float(q975),\n",
    "    ),\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Empirical P:\",\n",
    "    empirical_p,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. SAVE\n",
    "# ============================================================\n",
    "\n",
    "OUT_DIR = (\n",
    "    PATHWAY_PATH.parent\n",
    ")\n",
    "\n",
    "\n",
    "SUMMARY_PATH = (\n",
    "    OUT_DIR\n",
    "    /\n",
    "    \"AD_PD_REACTOME_R3_\"\n",
    "    \"PROFILE_PRESERVING_NULL_AUDIT_v1.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "NULL_PATH = (\n",
    "    OUT_DIR\n",
    "    /\n",
    "    \"AD_PD_REACTOME_R3_\"\n",
    "    \"PROFILE_PRESERVING_NULL_DISTRIBUTION_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "pd.DataFrame(\n",
    "    {\n",
    "        \"metric\": [\n",
    "            \"observed_R3\",\n",
    "            \"null_R3_mean\",\n",
    "            \"null_R3_median\",\n",
    "            \"null_R3_2.5pct\",\n",
    "            \"null_R3_97.5pct\",\n",
    "            \"empirical_P\",\n",
    "            \"n_permutations\",\n",
    "            \"seed\",\n",
    "        ],\n",
    "\n",
    "        \"value\": [\n",
    "            OBS_R3,\n",
    "            null_mean,\n",
    "            null_median,\n",
    "            float(q025),\n",
    "            float(q975),\n",
    "            empirical_p,\n",
    "            N_PERM,\n",
    "            SEED,\n",
    "        ],\n",
    "    }\n",
    ").to_csv(\n",
    "    SUMMARY_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "pd.DataFrame(\n",
    "    {\n",
    "        \"permutation\":\n",
    "            np.arange(\n",
    "                1,\n",
    "                N_PERM + 1,\n",
    "            ),\n",
    "\n",
    "        \"R3_count\":\n",
    "            null_R3,\n",
    "    }\n",
    ").to_csv(\n",
    "    NULL_PATH,\n",
    "    index=False,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSaved:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    SUMMARY_PATH\n",
    ")\n",
    "\n",
    "print(\n",
    "    NULL_PATH\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Part IX — Nonredundant pathway representation\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 80\n",
    "# ============================================================\n",
    "# V6 FIGURE-READY NONREDUNDANT REACTOME PANEL\n",
    "#\n",
    "# PURPOSE\n",
    "# -------\n",
    "# Replace the over-connected module representation produced\n",
    "# by transitive Jaccard clustering.\n",
    "#\n",
    "# This DOES NOT rerun enrichment.\n",
    "#\n",
    "# It greedily selects the highest-ranked pathway, then removes\n",
    "# lower-ranked pathways that are strongly redundant with an\n",
    "# already-selected representative.\n",
    "#\n",
    "# This prevents hundreds of pathways from chaining into one\n",
    "# giant artificial component.\n",
    "#\n",
    "# OUTPUTS\n",
    "# -------\n",
    "# 1. nonredundant pathway representatives\n",
    "# 2. pathway-by-cell-type AD/PD NES table\n",
    "# 3. top figure panel\n",
    "# 4. redundancy mapping showing which pathways were represented\n",
    "#    by each selected pathway\n",
    "#\n",
    "# NEXT AFTER THIS:\n",
    "# publication figures\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "from pathlib import Path\n",
    "\n",
    "import json\n",
    "import re\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "FINAL_DIR = (\n",
    "    ROOT\n",
    "    / \"results\"\n",
    "    / \"final_evidence\"\n",
    ")\n",
    "\n",
    "LOCKS = (\n",
    "    ROOT\n",
    "    / \"locks\"\n",
    ")\n",
    "\n",
    "RANKING_PATH = (\n",
    "    FINAL_DIR\n",
    "    / \"RETINA_ND_REACTOME_UNIQUE_PATHWAY_RANKING_v5.csv\"\n",
    ")\n",
    "\n",
    "DETAIL_PATH = (\n",
    "    FINAL_DIR\n",
    "    / \"RETINA_ND_REACTOME_CELLTYPE_PATHWAY_DETAILS_v5.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "assert RANKING_PATH.exists(), (\n",
    "    f\"Missing pathway ranking:\\n{RANKING_PATH}\"\n",
    ")\n",
    "\n",
    "assert DETAIL_PATH.exists(), (\n",
    "    f\"Missing pathway details:\\n{DETAIL_PATH}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. LOAD\n",
    "# ============================================================\n",
    "\n",
    "rank = pd.read_csv(\n",
    "    RANKING_PATH\n",
    ")\n",
    "\n",
    "detail = pd.read_csv(\n",
    "    DETAIL_PATH,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"RETINA_ND — FIGURE-READY NONREDUNDANT REACTOME PANEL\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nUnique ranked pathways:\",\n",
    "    len(rank)\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. PARSE LEADING-EDGE GENE SETS\n",
    "# ============================================================\n",
    "\n",
    "def parse_genes(x):\n",
    "\n",
    "    if pd.isna(x):\n",
    "        return set()\n",
    "\n",
    "    text = str(x).strip()\n",
    "\n",
    "    if (\n",
    "        not text\n",
    "        or\n",
    "        text.lower() in {\n",
    "            \"nan\",\n",
    "            \"none\",\n",
    "        }\n",
    "    ):\n",
    "        return set()\n",
    "\n",
    "    return {\n",
    "        g.strip().upper()\n",
    "        for g in re.split(\n",
    "            r\"[;,]\",\n",
    "            text,\n",
    "        )\n",
    "        if g.strip()\n",
    "    }\n",
    "\n",
    "\n",
    "gene_sets = {\n",
    "\n",
    "    row[\"pathway\"]:\n",
    "        parse_genes(\n",
    "            row[\n",
    "                \"union_leading_edge_genes\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "    for _, row\n",
    "    in rank.iterrows()\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. RESTRICT TO BIOLOGICALLY USEFUL PATHWAY POOL\n",
    "#\n",
    "# Include:\n",
    "#\n",
    "# R2 = statistically convergent in one cell type\n",
    "#\n",
    "# R3 = same-direction in >=3 cell types\n",
    "#\n",
    "# This is already much more focused than all 1,551 pathways.\n",
    "# ============================================================\n",
    "\n",
    "pool = rank.loc[\n",    "    rank[\n",
    "        \"priority_group\"\n",
    "    ].isin(\n",
    "        [\n",
    "            \"R2_single_celltype_AD_PD_FDR\",\n",
    "            \"R3_recurrent_directional\",\n",
    "        ]\n",
    "    )\n",
    "].copy()\n",
    "\n",
    "\n",
    "pool = pool.sort_values(\n",
    "    \"pathway_rank\"\n",
    ").reset_index(\n",
    "    drop=True\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nR2/R3 pathway pool:\",\n",
    "    len(pool)\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. GREEDY NONREDUNDANCY SELECTION\n",
    "#\n",
    "# A candidate pathway is considered redundant if:\n",
    "#\n",
    "#   intersection >= 3 genes\n",
    "#\n",
    "# AND\n",
    "#\n",
    "#   Jaccard >= 0.25\n",
    "#\n",
    "# with ANY higher-ranked representative.\n",
    "#\n",
    "# Difference from previous module method:\n",
    "#\n",
    "# Redundancy is tested directly against representatives.\n",
    "#\n",
    "# There is NO transitive merging.\n",
    "#\n",
    "# A ↔ B and B ↔ C therefore does not automatically force\n",
    "# A and C into one giant cluster.\n",
    "# ============================================================\n",
    "\n",
    "JACCARD_THRESHOLD = 0.25\n",
    "\n",
    "MIN_SHARED_GENES = 3\n",
    "\n",
    "\n",
    "selected = []\n",
    "\n",
    "redundancy_rows = []\n",
    "\n",
    "\n",
    "for _, candidate in pool.iterrows():\n",
    "\n",
    "    pathway = candidate[\n",
    "        \"pathway\"\n",
    "    ]\n",
    "\n",
    "    genes = gene_sets.get(\n",
    "        pathway,\n",
    "        set(),\n",
    "    )\n",
    "\n",
    "\n",
    "    best_match = None\n",
    "\n",
    "    best_jaccard = 0.0\n",
    "\n",
    "    best_shared = 0\n",
    "\n",
    "\n",
    "    for representative in selected:\n",
    "\n",
    "        rep_pathway = representative[\n",
    "            \"pathway\"\n",
    "        ]\n",
    "\n",
    "        rep_genes = gene_sets.get(\n",
    "            rep_pathway,\n",
    "            set(),\n",
    "        )\n",
    "\n",
    "\n",
    "        if (\n",
    "            len(genes) == 0\n",
    "            or\n",
    "            len(rep_genes) == 0\n",
    "        ):\n",
    "            continue\n",
    "\n",
    "\n",
    "        shared = genes & rep_genes\n",
    "\n",
    "        union = genes | rep_genes\n",
    "\n",
    "\n",
    "        if len(union) == 0:\n",
    "            continue\n",
    "\n",
    "\n",
    "        jaccard = (\n",
    "            len(shared)\n",
    "            /\n",
    "            len(union)\n",
    "        )\n",
    "\n",
    "\n",
    "        if (\n",
    "            len(shared)\n",
    "            >=\n",
    "            MIN_SHARED_GENES\n",
    "\n",
    "            and\n",
    "\n",
    "            jaccard\n",
    "            >=\n",
    "            JACCARD_THRESHOLD\n",
    "\n",
    "            and\n",
    "\n",
    "            jaccard\n",
    "            >\n",
    "            best_jaccard\n",
    "        ):\n",
    "\n",
    "            best_match = rep_pathway\n",
    "\n",
    "            best_jaccard = jaccard\n",
    "\n",
    "            best_shared = len(shared)\n",
    "\n",
    "\n",
    "    if best_match is None:\n",
    "\n",
    "        selected.append(\n",
    "            candidate.to_dict()\n",
    "        )\n",
    "\n",
    "        redundancy_rows.append(\n",
    "            {\n",
    "                \"pathway\":\n",
    "                    pathway,\n",
    "\n",
    "                \"selected_representative\":\n",
    "                    pathway,\n",
    "\n",
    "                \"is_representative\":\n",
    "                    True,\n",
    "\n",
    "                \"jaccard_to_representative\":\n",
    "                    1.0,\n",
    "\n",
    "                \"shared_genes_with_representative\":\n",
    "                    len(\n",
    "                        genes\n",
    "                    ),\n",
    "            }\n",
    "        )\n",
    "\n",
    "\n",
    "    else:\n",
    "\n",
    "        redundancy_rows.append(\n",
    "            {\n",
    "                \"pathway\":\n",
    "                    pathway,\n",
    "\n",
    "                \"selected_representative\":\n",
    "                    best_match,\n",
    "\n",
    "                \"is_representative\":\n",
    "                    False,\n",
    "\n",
    "                \"jaccard_to_representative\":\n",
    "                    best_jaccard,\n",
    "\n",
    "                \"shared_genes_with_representative\":\n",
    "                    best_shared,\n",
    "            }\n",
    "        )\n",
    "\n",
    "\n",
    "representatives = pd.DataFrame(\n",
    "    selected\n",
    ")\n",
    "\n",
    "\n",
    "redundancy_map = pd.DataFrame(\n",
    "    redundancy_rows\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. COUNT HOW MANY ORIGINAL PATHWAYS EACH REPRESENTATIVE\n",
    "#    SUMMARIZES\n",
    "# ============================================================\n",
    "\n",
    "represented_counts = (\n",
    "\n",
    "    redundancy_map\n",
    "    .groupby(\n",
    "        \"selected_representative\"\n",
    "    )\n",
    "    .size()\n",
    "    .rename(\n",
    "        \"n_pathways_represented\"\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "representatives[\n",
    "    \"n_pathways_represented\"\n",
    "] = (\n",
    "\n",
    "    representatives[\n",
    "        \"pathway\"\n",
    "    ]\n",
    "    .map(\n",
    "        represented_counts\n",
    "    )\n",
    "    .fillna(\n",
    "        1\n",
    "    )\n",
    "    .astype(int)\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nNonredundant representatives:\",\n",
    "    len(representatives)\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Largest number represented by one pathway:\",\n",
    "    representatives[\n",
    "        \"n_pathways_represented\"\n",
    "    ].max()\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. PUBLICATION PANEL\n",
    "#\n",
    "# Take the strongest 30 nonredundant pathways.\n",
    "#\n",
    "# This number can later be reduced to ~15–20 for the main\n",
    "# manuscript figure while keeping 30 in supplementary data.\n",
    "# ============================================================\n",
    "\n",
    "FIGURE_N = 30\n",
    "\n",
    "\n",
    "figure_panel = (\n",
    "\n",
    "    representatives\n",
    "    .sort_values(\n",
    "        \"pathway_rank\"\n",
    "    )\n",
    "    .head(\n",
    "        FIGURE_N\n",
    "    )\n",
    "    .copy()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "figure_panel.insert(\n",
    "    0,\n",
    "    \"figure_order\",\n",
    "    np.arange(\n",
    "        1,\n",
    "        len(\n",
    "            figure_panel\n",
    "        )\n",
    "        +\n",
    "        1\n",
    "    ),\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. ADD CELL-TYPE-SPECIFIC AD / PD NES\n",
    "# ============================================================\n",
    "\n",
    "CELL_TYPES = [\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "]\n",
    "\n",
    "\n",
    "matrix_rows = []\n",
    "\n",
    "\n",
    "for _, pathway_row in figure_panel.iterrows():\n",
    "\n",
    "    pathway = pathway_row[\n",
    "        \"pathway\"\n",
    "    ]\n",
    "\n",
    "\n",
    "    z = detail.loc[\n",
    "        detail[\n",
    "            \"pathway\"\n",
    "        ]\n",
    "        ==\n",
    "        pathway\n",
    "    ].copy()\n",
    "\n",
    "\n",
    "    out = {\n",
    "\n",
    "        \"figure_order\":\n",
    "            pathway_row[\n",
    "                \"figure_order\"\n",
    "            ],\n",
    "\n",
    "        \"pathway\":\n",
    "            pathway,\n",
    "\n",
    "        \"pathway_rank\":\n",
    "            pathway_row[\n",
    "                \"pathway_rank\"\n",
    "            ],\n",
    "\n",
    "        \"priority_group\":\n",
    "            pathway_row[\n",
    "                \"priority_group\"\n",
    "            ],\n",
    "\n",
    "        \"n_pathways_represented\":\n",
    "            pathway_row[\n",
    "                \"n_pathways_represented\"\n",
    "            ],\n",
    "\n",
    "        \"n_convergent_FDR_celltypes\":\n",
    "            pathway_row[\n",
    "                \"n_convergent_FDR_celltypes\"\n",
    "            ],\n",
    "\n",
    "        \"n_same_direction_celltypes\":\n",
    "            pathway_row[\n",
    "                \"n_same_direction_celltypes\"\n",
    "            ],\n",
    "\n",
    "        \"shared_candidate_genes\":\n",
    "            pathway_row[\n",
    "                \"shared_candidate_genes\"\n",
    "            ],\n",
    "\n",
    "    }\n",
    "\n",
    "\n",
    "    for ct in CELL_TYPES:\n",
    "\n",
    "        q = z.loc[\n",
    "            z[\n",
    "                \"cell_type\"\n",
    "            ]\n",
    "            ==\n",
    "            ct\n",
    "        ]\n",
    "\n",
    "\n",
    "        if len(q) == 0:\n",
    "\n",
    "            out[\n",
    "                f\"{ct}_AD_NES\"\n",
    "            ] = np.nan\n",
    "\n",
    "            out[\n",
    "                f\"{ct}_PD_NES\"\n",
    "            ] = np.nan\n",
    "\n",
    "            out[\n",
    "                f\"{ct}_AD_FDR\"\n",
    "            ] = np.nan\n",
    "\n",
    "            out[\n",
    "                f\"{ct}_PD_FDR\"\n",
    "            ] = np.nan\n",
    "\n",
    "\n",
    "        else:\n",
    "\n",
    "            q = q.iloc[0]\n",
    "\n",
    "            out[\n",
    "                f\"{ct}_AD_NES\"\n",
    "            ] = q[\n",
    "                \"NES_AD\"\n",
    "            ]\n",
    "\n",
    "            out[\n",
    "                f\"{ct}_PD_NES\"\n",
    "            ] = q[\n",
    "                \"NES_PD\"\n",
    "            ]\n",
    "\n",
    "            out[\n",
    "                f\"{ct}_AD_FDR\"\n",
    "            ] = q[\n",
    "                \"FDR_AD\"\n",
    "            ]\n",
    "\n",
    "            out[\n",
    "                f\"{ct}_PD_FDR\"\n",
    "            ] = q[\n",
    "                \"FDR_PD\"\n",
    "            ]\n",
    "\n",
    "\n",
    "    matrix_rows.append(\n",
    "        out\n",
    "    )\n",
    "\n",
    "\n",
    "figure_matrix = pd.DataFrame(\n",
    "    matrix_rows\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. LONG-FORM FIGURE TABLE\n",
    "# ============================================================\n",
    "\n",
    "long_rows = []\n",
    "\n",
    "\n",
    "for _, row in figure_matrix.iterrows():\n",
    "\n",
    "    for ct in CELL_TYPES:\n",
    "\n",
    "        for disease in [\n",
    "            \"AD\",\n",
    "            \"PD\",\n",
    "        ]:\n",
    "\n",
    "            long_rows.append(\n",
    "                {\n",
    "                    \"figure_order\":\n",
    "                        row[\n",
    "                            \"figure_order\"\n",
    "                        ],\n",
    "\n",
    "                    \"pathway\":\n",
    "                        row[\n",
    "                            \"pathway\"\n",
    "                        ],\n",
    "\n",
    "                    \"cell_type\":\n",
    "                        ct,\n",
    "\n",
    "                    \"disease\":\n",
    "                        disease,\n",
    "\n",
    "                    \"NES\":\n",
    "                        row[\n",
    "                            f\"{ct}_{disease}_NES\"\n",
    "                        ],\n",
    "\n",
    "                    \"FDR\":\n",
    "                        row[\n",
    "                            f\"{ct}_{disease}_FDR\"\n",
    "                        ],\n",
    "\n",
    "                    \"FDR05\":\n",
    "                        (\n",
    "                            row[\n",
    "                                f\"{ct}_{disease}_FDR\"\n",
    "                            ]\n",
    "                            <\n",
    "                            0.05\n",
    "                        )\n",
    "                        if pd.notna(\n",
    "                            row[\n",
    "                                f\"{ct}_{disease}_FDR\"\n",
    "                            ]\n",
    "                        )\n",
    "                        else False,\n",
    "\n",
    "                }\n",
    "            )\n",
    "\n",
    "\n",
    "figure_long = pd.DataFrame(\n",
    "    long_rows\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. SAVE\n",
    "# ============================================================\n",
    "\n",
    "REP_PATH = (\n",
    "    FINAL_DIR\n",
    "    / \"RETINA_ND_REACTOME_NONREDUNDANT_REPRESENTATIVES_v6.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "MAP_PATH = (\n",
    "    FINAL_DIR\n",
    "    / \"RETINA_ND_REACTOME_REDUNDANCY_MAP_v6.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "PANEL_PATH = (\n",
    "    FINAL_DIR\n",
    "    / \"RETINA_ND_REACTOME_FIGURE_PANEL_TOP30_v6.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "MATRIX_PATH = (\n",
    "    FINAL_DIR\n",
    "    / \"RETINA_ND_REACTOME_FIGURE_MATRIX_v6.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "LONG_PATH = (\n",
    "    FINAL_DIR\n",
    "    / \"RETINA_ND_REACTOME_FIGURE_LONG_v6.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "representatives.to_csv(\n",
    "    REP_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "redundancy_map.to_csv(\n",
    "    MAP_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "figure_panel.to_csv(\n",
    "    PANEL_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "figure_matrix.to_csv(\n",
    "    MATRIX_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "figure_long.to_csv(\n",
    "    LONG_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. FREEZE\n",
    "# ============================================================\n",
    "\n",
    "LOCK_PATH = (\n",
    "    LOCKS\n",
    "    / \"RETINA_ND_REACTOME_FIGURE_PANEL_FREEZE_v6.json\"\n",
    ")\n",
    "\n",
    "\n",
    "record = {\n",
    "\n",
    "    \"status\":\n",
    "        \"RETINA_ND_REACTOME_FIGURE_PANEL_FROZEN\",\n",
    "\n",
    "    \"source_ranking\":\n",
    "        str(\n",
    "            RANKING_PATH\n",
    "        ),\n",
    "\n",
    "    \"source_details\":\n",
    "        str(\n",
    "            DETAIL_PATH\n",
    "        ),\n",
    "\n",
    "    \"eligible_priority_groups\":\n",
    "        [\n",
    "            \"R2_single_celltype_AD_PD_FDR\",\n",
    "            \"R3_recurrent_directional\",\n",
    "        ],\n",
    "\n",
    "    \"redundancy_method\":\n",
    "        \"greedy representative selection\",\n",
    "\n",
    "    \"jaccard_threshold\":\n",
    "        JACCARD_THRESHOLD,\n",
    "\n",
    "    \"minimum_shared_genes\":\n",
    "        MIN_SHARED_GENES,\n",
    "\n",
    "    \"transitive_clustering\":\n",
    "        False,\n",
    "\n",
    "    \"representatives\":\n",
    "        str(\n",
    "            REP_PATH\n",
    "        ),\n",
    "\n",
    "    \"redundancy_map\":\n",
    "        str(\n",
    "            MAP_PATH\n",
    "        ),\n",
    "\n",
    "    \"figure_panel\":\n",
    "        str(\n",
    "            PANEL_PATH\n",
    "        ),\n",
    "\n",
    "    \"figure_matrix\":\n",
    "        str(\n",
    "            MATRIX_PATH\n",
    "        ),\n",
    "\n",
    "    \"figure_long\":\n",
    "        str(\n",
    "            LONG_PATH\n",
    "        ),\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    LOCK_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        record,\n",
    "        f,\n",
    "        indent=2,\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. REPORT\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"NONREDUNDANT REACTOME FIGURE PANEL COMPLETE\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nOriginal R2/R3 pathway pool:\",\n",
    "    len(pool)\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Nonredundant representatives:\",\n",
    "    len(\n",
    "        representatives\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nTOP 30 FIGURE PATHWAYS\"\n",
    ")\n",
    "\n",
    "\n",
    "display_cols = [\n",
    "\n",
    "    \"figure_order\",\n",
    "\n",
    "    \"pathway\",\n",
    "\n",
    "    \"pathway_rank\",\n",
    "\n",
    "    \"priority_group\",\n",
    "\n",
    "    \"n_pathways_represented\",\n",
    "\n",
    "    \"n_convergent_FDR_celltypes\",\n",
    "\n",
    "    \"n_same_direction_celltypes\",\n",
    "\n",
    "    \"shared_candidate_genes\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "display(\n",
    "    figure_panel[\n",
    "        display_cols\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFIGURE MATRIX\"\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    figure_matrix\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nRepresentative pathways:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    REP_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFigure panel:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    PANEL_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFigure matrix:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    MATRIX_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFreeze record:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    LOCK_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nNEXT:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Generate publication figures.\"\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Part X — Final publication figures\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 81\n",
    "# ============================================================\n",
    "# PUBLICATION FIGURE 2\n",
    "# AD ↔ PD BRAIN TRANSCRIPTIONAL CONVERGENCE\n",
    "#\n",
    "# Panels:\n",
    "#   A — Astro\n",
    "#   B — Micro\n",
    "#   C — OPC\n",
    "#   D — Oligo\n",
    "#\n",
    "# Each panel:\n",
    "#   x = AD log2FC\n",
    "#   y = PD log2FC\n",
    "#\n",
    "# Reports:\n",
    "#   - matched genes\n",
    "#   - Spearman rho\n",
    "#   - direction concordance\n",
    "#\n",
    "# Saves:\n",
    "#   PNG\n",
    "#   PDF\n",
    "#   SVG\n",
    "#   plotted-data CSV\n",
    "#\n",
    "# IMPORTANT\n",
    "# ---------\n",
    "# This figure visualizes the already-frozen convergence\n",
    "# analysis. It does NOT rerun statistics.\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "from scipy.stats import spearmanr\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "INPUT_PATH = (\n",
    "    ROOT\n",
    "    / \"results\"\n",
    "    / \"cross_disease_convergence\"\n",
    "    / \"AD_PD_ALL_GENE_CONVERGENCE_v2.csv.gz\"\n",
    ")\n",
    "\n",
    "FIG_DIR = (\n",
    "    ROOT\n",
    "    / \"results\"\n",
    "    / \"publication_figures\"\n",
    ")\n",
    "\n",
    "FIG_DIR.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "\n",
    "assert INPUT_PATH.exists(), (\n",
    "    f\"Missing convergence table:\\n{INPUT_PATH}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. LOAD FROZEN CONVERGENCE DATA\n",
    "# ============================================================\n",
    "\n",
    "df = pd.read_csv(\n",
    "    INPUT_PATH,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "required = {\n",
    "    \"cell_type\",\n",
    "    \"gene_symbol\",\n",
    "    \"log2FoldChange_AD\",\n",
    "    \"log2FoldChange_PD\",\n",
    "}\n",
    "\n",
    "\n",
    "missing = (\n",
    "    required\n",
    "    -\n",
    "    set(df.columns)\n",
    ")\n",
    "\n",
    "\n",
    "assert not missing, (\n",
    "    f\"Missing required columns: {sorted(missing)}\"\n",
    ")\n",
    "\n",
    "\n",
    "df[\n",
    "    \"log2FoldChange_AD\"\n",
    "] = pd.to_numeric(\n",
    "    df[\n",
    "        \"log2FoldChange_AD\"\n",
    "    ],\n",
    "    errors=\"coerce\",\n",
    ")\n",
    "\n",
    "\n",
    "df[\n",
    "    \"log2FoldChange_PD\"\n",
    "] = pd.to_numeric(\n",
    "    df[\n",
    "        \"log2FoldChange_PD\"\n",
    "    ],\n",
    "    errors=\"coerce\",\n",
    ")\n",
    "\n",
    "\n",
    "df = df.loc[\n",
    "    df[\n",
    "        \"log2FoldChange_AD\"\n",
    "    ].notna()\n",
    "\n",
    "    &\n",
    "\n",
    "    df[\n",
    "        \"log2FoldChange_PD\"\n",
    "    ].notna()\n",
    "].copy()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. BASIC DIRECTION FLAGS\n",
    "# ============================================================\n",
    "\n",
    "df[\n",
    "    \"same_direction\"\n",
    "] = (\n",
    "\n",
    "    np.sign(\n",
    "        df[\n",
    "            \"log2FoldChange_AD\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    ==\n",
    "\n",
    "    np.sign(\n",
    "        df[\n",
    "            \"log2FoldChange_PD\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. FIGURE SETTINGS\n",
    "# ============================================================\n",
    "\n",
    "CELL_TYPES = [\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "]\n",
    "\n",
    "\n",
    "PANEL_LABELS = {\n",
    "    \"Astro\": \"A\",\n",
    "    \"Micro\": \"B\",\n",
    "    \"OPC\": \"C\",\n",
    "    \"Oligo\": \"D\",\n",
    "}\n",
    "\n",
    "\n",
    "# Use a common symmetric axis across all panels.\n",
    "max_abs = np.nanpercentile(\n",
    "    np.abs(\n",
    "        np.concatenate(\n",
    "            [\n",
    "                df[\n",
    "                    \"log2FoldChange_AD\"\n",
    "                ].to_numpy(),\n",
    "\n",
    "                df[\n",
    "                    \"log2FoldChange_PD\"\n",
    "                ].to_numpy(),\n",
    "            ]\n",
    "        )\n",
    "    ),\n",
    "    99.5,\n",
    ")\n",
    "\n",
    "\n",
    "# Add a little padding.\n",
    "axis_lim = float(\n",
    "    max_abs\n",
    "    *\n",
    "    1.10\n",
    ")\n",
    "\n",
    "\n",
    "# Avoid pathological tiny limits.\n",
    "axis_lim = max(\n",
    "    axis_lim,\n",
    "    0.5,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. CREATE FOUR-PANEL FIGURE\n",
    "# ============================================================\n",
    "\n",
    "fig, axes = plt.subplots(\n",    "    2,\n",
    "    2,\n",
    "    figsize=(\n",
    "        11,\n",
    "        10,\n",
    "    ),\n",
    ")\n",
    "\n",
    "\n",
    "axes = axes.ravel()\n",
    "\n",
    "\n",
    "summary_rows = []\n",
    "\n",
    "\n",
    "for ax, cell_type in zip(\n",
    "    axes,\n",
    "    CELL_TYPES,\n",
    "):\n",
    "\n",
    "\n",
    "    z = df.loc[\n",
    "        df[\n",
    "            \"cell_type\"\n",
    "        ]\n",
    "        ==\n",
    "        cell_type\n",
    "    ].copy()\n",
    "\n",
    "\n",
    "    assert len(z) > 0, (\n",
    "        f\"No rows found for {cell_type}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    x = z[\n",
    "        \"log2FoldChange_AD\"\n",
    "    ].to_numpy()\n",
    "\n",
    "\n",
    "    y = z[\n",
    "        \"log2FoldChange_PD\"\n",
    "    ].to_numpy()\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Spearman correlation\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    rho, pvalue = spearmanr(\n",
    "        x,\n",
    "        y,\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Direction concordance\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    direction_concordance = float(\n",
    "        z[\n",
    "            \"same_direction\"\n",
    "        ].mean()\n",
    "    )\n",
    "\n",
    "\n",
    "    n = len(z)\n",
    "\n",
    "\n",
    "    summary_rows.append(\n",
    "        {\n",
    "\n",
    "            \"cell_type\":\n",
    "                cell_type,\n",
    "\n",
    "            \"matched_genes\":\n",
    "                n,\n",
    "\n",
    "            \"spearman_rho\":\n",
    "                rho,\n",
    "\n",
    "            \"spearman_pvalue\":\n",
    "                pvalue,\n",
    "\n",
    "            \"direction_concordance\":\n",
    "                direction_concordance,\n",
    "\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Scatter\n",
    "    #\n",
    "    # Very small, transparent points because n ~15k.\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    ax.scatter(\n",
    "        x,\n",
    "        y,\n",
    "        s=7,\n",
    "        alpha=0.18,\n",
    "        linewidths=0,\n",
    "        rasterized=True,\n",
    "    )\n",
    "\n",
    "\n",
    "    # Zero lines.\n",
    "    ax.axhline(\n",
    "        0,\n",
    "        linewidth=0.8,\n",
    "        alpha=0.6,\n",
    "    )\n",
    "\n",
    "\n",
    "    ax.axvline(\n",
    "        0,\n",
    "        linewidth=0.8,\n",
    "        alpha=0.6,\n",
    "    )\n",
    "\n",
    "\n",
    "    # Identity line.\n",
    "    ax.plot(\n",
    "        [\n",
    "            -axis_lim,\n",
    "            axis_lim,\n",
    "        ],\n",
    "        [\n",
    "            -axis_lim,\n",
    "            axis_lim,\n",
    "        ],\n",
    "        linestyle=\"--\",\n",
    "        linewidth=0.9,\n",
    "        alpha=0.55,\n",
    "    )\n",
    "\n",
    "\n",
    "    ax.set_xlim(\n",
    "        -axis_lim,\n",
    "        axis_lim,\n",
    "    )\n",
    "\n",
    "\n",
    "    ax.set_ylim(\n",
    "        -axis_lim,\n",
    "        axis_lim,\n",
    "    )\n",
    "\n",
    "\n",
    "    ax.set_aspect(\n",
    "        \"equal\",\n",
    "        adjustable=\"box\",\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Panel title\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    ax.set_title(\n",
    "        cell_type,\n",
    "        fontsize=14,\n",
    "        fontweight=\"bold\",\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Statistics annotation\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    stats_text = (\n",
    "\n",
    "        f\"n = {n:,}\\n\"\n",
    "\n",
    "        f\"Spearman ρ = {rho:.3f}\\n\"\n",
    "\n",
    "        f\"Directional concordance = \"\n",
    "        f\"{direction_concordance * 100:.1f}%\"\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    ax.text(\n",
    "        0.04,\n",
    "        0.96,\n",
    "        stats_text,\n",
    "        transform=ax.transAxes,\n",
    "        ha=\"left\",\n",
    "        va=\"top\",\n",
    "        fontsize=10,\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Panel label\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    ax.text(\n",
    "        -0.13,\n",
    "        1.06,\n",
    "        PANEL_LABELS[\n",
    "            cell_type\n",
    "        ],\n",
    "        transform=ax.transAxes,\n",
    "        fontsize=18,\n",
    "        fontweight=\"bold\",\n",
    "        ha=\"left\",\n",
    "        va=\"top\",\n",
    "    )\n",
    "\n",
    "\n",
    "    ax.tick_params(\n",
    "        labelsize=9\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. SHARED AXIS LABELS / TITLE\n",
    "# ============================================================\n",
    "\n",
