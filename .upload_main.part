    "        PRIMARY_CLASSES,\n",
    "\n",
    "    \"model\":\n",
    "        \"~ age + sex + diagnosis_binary\",\n",
    "\n",
    "    \"contrast\": [\n",
    "        \"diagnosis_binary\",\n",
    "        \"PD\",\n",
    "        \"Control\",\n",
    "    ],\n",
    "\n",
    "    \"reference_levels\": {\n",
    "\n",
    "        \"diagnosis_binary\":\n",
    "            \"Control\",\n",
    "\n",
    "        \"sex\":\n",
    "            \"Female\",\n",
    "    },\n",
    "\n",
    "    \"DE_engine\":\n",
    "        \"PyDESeq2\",\n",
    "\n",
