  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 14\n",
    "# ============================================================\n",
    "# STEP 8A — FULL HIGH-LEVEL ANNOTATION + DONOR ELIGIBILITY AUDIT\n",
    "#\n",
    "# NO expression analysis.\n",
    "# NO disease-gene results.\n",
    "# This freezes what cell classes are actually analyzable.\n",
    "# ============================================================\n",
    "\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import json\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "PD_DIR = ROOT / \"GSE243639_PD_discovery\"\n",
    "MANIFESTS = ROOT / \"manifests\"\n",
    "LOCKS = ROOT / \"locks\"\n",
    "\n",
    "MANIFESTS.mkdir(exist_ok=True)\n",
    "LOCKS.mkdir(exist_ok=True)\n",
    "\n",
    "donor_path = (\n",
    "    MANIFESTS /\n",
    "    \"GSE243639_donor_metadata_FROZEN_v1.csv\"\n",
    ")\n",
    "\n",
    "umap_path = (\n",
    "    PD_DIR /\n",
    "    \"GSE243639_UMAP_coordinates.xlsx\"\n",
    ")\n",
    "\n",
    "assert donor_path.exists(), f\"Missing: {donor_path}\"\n",
    "assert umap_path.exists(), f\"Missing: {umap_path}\"\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 1. Load frozen donor metadata\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "donors = pd.read_csv(donor_path)\n",
    "\n",
    "donors[\"donor_id\"] = (\n",
    "    donors[\"donor_id\"]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "assert len(donors) == 29\n",
    "assert donors[\"donor_id\"].nunique() == 29\n",
    "\n",
    "assert (\n",
    "    donors[\"diagnosis_binary\"]\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    "    ==\n",
    "    {\"PD\": 15, \"Control\": 14}\n",
    ")\n",
    "\n",
    "print(\"Frozen donor metadata OK:\")\n",
    "print(donors[\"diagnosis_binary\"].value_counts())\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 2. Load ALL author-QC high-level cell annotations\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "cells = pd.read_excel(\n",
    "    umap_path,\n",
    "    sheet_name=\"HighLevelCellTypes\"\n",
    ")\n",
    "\n",
    "required_cols = {\n",
    "    \"CELL_ID\",\n",
    "    \"CLUSTER\",\n",
    "    \"IDENT\"\n",
    "}\n",
    "\n",
    "missing = required_cols - set(cells.columns)\n",
    "\n",
    "assert not missing, (\n",
    "    f\"Missing expected cell-annotation columns: {missing}\"\n",
    ")\n",
    "\n",
    "cells[\"CELL_ID\"] = (\n",
    "    cells[\"CELL_ID\"]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "cells[\"IDENT\"] = (\n",
    "    cells[\"IDENT\"]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "print(\"\\nHigh-level annotation shape:\")\n",
    "print(cells.shape)\n",
    "\n",
    "print(\"\\nNumber of nuclei:\")\n",
    "print(f\"{len(cells):,}\")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 3. Integrity checks\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "assert cells[\"CELL_ID\"].is_unique, (\n",
    "    \"CELL_ID is not unique.\"\n",
    ")\n",
    "\n",
    "EXPECTED_NUCLEI = 83_484\n",
    "\n",
    "assert len(cells) == EXPECTED_NUCLEI, (\n",
    "    f\"Expected {EXPECTED_NUCLEI:,} final author-QC nuclei, \"\n",
    "    f\"found {len(cells):,}.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 4. Extract donor ID from CELL_ID\n",
    "#\n",
    "# Example:\n",
    "# s.0096_AAACCCAAGTACGAGC-1\n",
    "# ->\n",
    "# s.0096\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "cells[\"donor_id\"] = (\n",
    "    cells[\"CELL_ID\"]\n",
    "    .str.split(\"_\", n=1)\n",
    "    .str[0]\n",
    ")\n",
    "\n",
    "annotation_donors = set(\n",
    "    cells[\"donor_id\"].unique()\n",
    ")\n",
    "\n",
    "metadata_donors = set(\n",
    "    donors[\"donor_id\"].unique()\n",
    ")\n",
    "\n",
    "only_annotation = sorted(\n",
    "    annotation_donors - metadata_donors\n",
    ")\n",
    "\n",
    "only_metadata = sorted(\n",
    "    metadata_donors - annotation_donors\n",
    ")\n",
    "\n",
    "assert not only_annotation, (\n",
    "    f\"Donors present only in cell annotations: \"\n",
    "    f\"{only_annotation}\"\n",
    ")\n",
    "\n",
    "assert not only_metadata, (\n",
    "    f\"Donors present only in frozen metadata: \"\n",
    "    f\"{only_metadata}\"\n",
    ")\n",
    "\n",
    "assert len(annotation_donors) == 29\n",
    "\n",
    "print(\"\\nAll 29 donors match between:\")\n",
    "print(\" - frozen clinical metadata\")\n",
    "print(\" - author cell annotations\")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 5. Merge diagnosis/covariates onto each nucleus\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "cell_meta = cells.merge(\n",
    "    donors[\n",
    "        [\n",
    "            \"donor_id\",\n",
    "            \"diagnosis_binary\",\n",
    "            \"age\",\n",
    "            \"sex\",\n",
    "            \"PMI\",\n",
    "            \"RIN\",\n",
    "        ]\n",
    "    ],\n",
    "    on=\"donor_id\",\n",
    "    how=\"left\",\n",
    "    validate=\"many_to_one\",\n",
    ")\n",
    "\n",
    "assert cell_meta[\"diagnosis_binary\"].notna().all()\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 6. What cell classes actually exist?\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "celltype_summary = (\n",
    "    cell_meta\n",
    "    .groupby(\n",
    "        \"IDENT\",\n",
    "        observed=True\n",
    "    )\n",
    "    .agg(\n",
    "        n_nuclei=(\"CELL_ID\", \"size\"),\n",
    "        n_donors=(\"donor_id\", \"nunique\"),\n",
    "    )\n",
    "    .sort_values(\n",
    "        \"n_nuclei\",\n",
    "        ascending=False\n",
    "    )\n",
    ")\n",
    "\n",
    "celltype_summary[\"fraction\"] = (\n",
    "    celltype_summary[\"n_nuclei\"]\n",
    "    /\n",
    "    len(cell_meta)\n",
    ")\n",
    "\n",
    "print(\"\\n========================================\")\n",
    "print(\"AUTHOR HIGH-LEVEL CELL TYPES\")\n",
    "print(\"========================================\")\n",
    "\n",
    "display(celltype_summary)\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 7. Donor × cell-type nucleus counts\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "donor_cell_counts = pd.crosstab(\n",
    "    cell_meta[\"donor_id\"],\n",
    "    cell_meta[\"IDENT\"]\n",
    ")\n",
    "\n",
    "donor_cell_counts = (\n",
    "    donors[\n",
    "        [\n",
    "            \"donor_id\",\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "    ]\n",
    "    .merge(\n",
    "        donor_cell_counts.reset_index(),\n",
    "        on=\"donor_id\",\n",
    "        how=\"left\",\n",
    "        validate=\"one_to_one\"\n",
    "    )\n",
    ")\n",
    "\n",
    "cell_columns = [\n",
    "    c\n",
    "    for c in donor_cell_counts.columns\n",
    "    if c not in {\n",
    "        \"donor_id\",\n",
    "        \"diagnosis_binary\"\n",
    "    }\n",
    "]\n",
    "\n",
    "donor_cell_counts[cell_columns] = (\n",
    "    donor_cell_counts[cell_columns]\n",
    "    .fillna(0)\n",
    "    .astype(int)\n",
    ")\n",
    "\n",
    "print(\"\\n========================================\")\n",
    "print(\"DONOR × CELL-TYPE COUNTS\")\n",
    "print(\"========================================\")\n",
    "\n",
    "display(donor_cell_counts)\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 8. Freeze donor eligibility at BOTH thresholds\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "eligibility_rows = []\n",
    "\n",
    "for cell_type in cell_columns:\n",
    "\n",
    "    for threshold in [20, 50]:\n",
    "\n",
    "        eligible = donor_cell_counts[\n",
    "            donor_cell_counts[cell_type]\n",
    "            >= threshold\n",
    "        ]\n",
    "\n",
    "        counts = (\n",
    "            eligible[\"diagnosis_binary\"]\n",
    "            .value_counts()\n",
    "        )\n",
    "\n",
    "        eligibility_rows.append(\n",
    "            {\n",
    "                \"cell_type\": cell_type,\n",
    "                \"min_nuclei_per_donor\": threshold,\n",
    "                \"n_PD\": int(counts.get(\"PD\", 0)),\n",
    "                \"n_Control\": int(\n",
    "                    counts.get(\"Control\", 0)\n",
    "                ),\n",
    "                \"n_total\": int(len(eligible)),\n",
    "            }\n",
    "        )\n",
    "\n",
    "eligibility = pd.DataFrame(\n",
    "    eligibility_rows\n",
    ")\n",
    "\n",
    "eligibility = eligibility.sort_values(\n",
    "    [\n",
    "        \"min_nuclei_per_donor\",\n",
    "        \"cell_type\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "print(\"\\n========================================\")\n",
    "print(\"CELL-TYPE ELIGIBILITY\")\n",
    "print(\"========================================\")\n",
    "\n",
    "display(eligibility)\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 9. Verify pathology missingness\n",
    "# These variables are NOT candidate case-control covariates.\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "pathology_cols = [\n",
    "    \"lewy_midbrain\",\n",
    "    \"lewy_limbic\",\n",
    "    \"lewy_neocortex\",\n",
    "    \"CERAD\",\n",
    "    \"Braak_AD\",\n",
    "]\n",
    "\n",
    "print(\"\\n========================================\")\n",
    "print(\"PATHOLOGY NON-MISSING VALUES\")\n",
    "print(\"========================================\")\n",
    "\n",
    "display(\n",
    "    donors\n",
    "    .groupby(\"diagnosis_binary\")[\n",
    "        pathology_cols\n",
    "    ]\n",
    "    .count()\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 10. Save audit outputs\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "celltype_summary.to_csv(\n",
    "    MANIFESTS /\n",
    "    \"GSE243639_highlevel_celltype_summary_v1.csv\"\n",
    ")\n",
    "\n",
    "donor_cell_counts.to_csv(\n",
    "    MANIFESTS /\n",
    "    \"GSE243639_donor_x_celltype_counts_v1.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "eligibility.to_csv(\n",
    "    MANIFESTS /\n",
    "    \"GSE243639_celltype_eligibility_v1.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 11. Freeze annotation audit\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "annotation_lock = {\n",
    "    \"dataset\": \"GSE243639\",\n",
    "    \"n_final_author_qc_nuclei\": int(\n",
    "        len(cell_meta)\n",
    "    ),\n",
    "    \"n_donors\": int(\n",
    "        cell_meta[\"donor_id\"].nunique()\n",
    "    ),\n",
    "    \"observed_IDENT\": sorted(\n",
    "        cell_meta[\"IDENT\"]\n",
    "        .unique()\n",
    "        .tolist()\n",
    "    ),\n",
    "    \"primary_min_nuclei_per_donor\": 20,\n",
    "    \"sensitivity_min_nuclei_per_donor\": 50,\n",
    "}\n",
    "\n",
    "lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_ANNOTATION_AUDIT_LOCK_v1.json\"\n",
    ")\n",
    "\n",
    "with open(\n",
    "    lock_path,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        annotation_lock,\n",
    "        f,\n",
    "        indent=2\n",    "    )\n",
    "\n",
    "\n",
    "print(\"\\n========================================\")\n",
    "print(\"STEP 8A PASSED\")\n",
    "print(\"========================================\")\n",
    "\n",
    "print(json.dumps(\n",
    "    annotation_lock,\n",
    "    indent=2\n",
    "))\n",
    "\n",
    "print(\"\\nSaved:\")\n",
    "print(lock_path)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 15\n",
    "# ============================================================\n",
    "# STEP 8B — FREEZE PD CELL-CLASS ANALYSIS PLAN\n",
    "#\n",
    "# Based ONLY on cell representation, before gene-expression\n",
    "# disease results are inspected.\n",
    "# ============================================================\n",
    "\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "import json\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "LOCKS = ROOT / \"locks\"\n",
    "LOCKS.mkdir(exist_ok=True)\n",
    "\n",
    "PD_CELL_PLAN = {\n",
    "\n",
    "    \"dataset\": \"GSE243639\",\n",
    "\n",
    "    \"frozen_utc\":\n",
    "        datetime.now(timezone.utc).isoformat(),\n",
    "\n",
    "    \"primary_cell_classes\": {\n",
    "        \"Astro\": {\n",
    "            \"min_nuclei_per_donor\": 50,\n",
    "            \"expected_PD\": 15,\n",
    "            \"expected_Control\": 14\n",
    "        },\n",
    "        \"Micro\": {\n",
    "            \"min_nuclei_per_donor\": 50,\n",
    "            \"expected_PD\": 15,\n",
    "            \"expected_Control\": 14\n",
    "        },\n",
    "        \"OPC\": {\n",
    "            \"min_nuclei_per_donor\": 50,\n",
    "            \"expected_PD\": 15,\n",
    "            \"expected_Control\": 14\n",
    "        },\n",
    "        \"Oligo\": {\n",
    "            \"min_nuclei_per_donor\": 50,\n",
    "            \"expected_PD\": 15,\n",
    "            \"expected_Control\": 14\n",
    "        }\n",
    "    },\n",
    "\n",
    "    \"secondary_cell_classes\": {\n",
    "\n",
    "        \"VC\": {\n",
    "            \"primary_secondary_threshold\": 20,\n",
    "            \"expected_PD\": 11,\n",
    "            \"expected_Control\": 11,\n",
    "            \"reason\":\n",
    "                \"Rare vascular population; insufficient \"\n",
    "                \"coverage for primary cross-disease discovery.\"\n",
    "        },\n",
    "\n",
    "        \"Neurons\": {\n",
    "            \"primary_secondary_threshold\": 20,\n",
    "            \"expected_PD\": 11,\n",
    "            \"expected_Control\": 14,\n",
    "            \"reason\":\n",
    "                \"Region-dependent neuronal biology and \"\n",
    "                \"disease-associated neuronal depletion; \"\n",
    "                \"cross-AD/PD neuronal comparisons will be \"\n",
    "                \"pathway-level only.\"\n",
    "        }\n",
    "    },\n",
    "\n",
    "    \"excluded_cell_classes\": {\n",
    "\n",
    "        \"T cells\": {\n",
    "            \"reason\":\n",
    "                \"Insufficient donor representation for \"\n",
    "                \"case-control expression analysis.\"\n",
    "        }\n",
    "    },\n",
    "\n",
    "    \"primary_model\":\n",
    "        \"~ age + sex + diagnosis\",\n",
    "\n",
    "    \"sensitivity_model\":\n",
    "        \"~ age + sex + PMI + RIN + diagnosis\",\n",
    "\n",
    "    \"additional_sensitivity\":\n",
    "        \"restrict donors to overlapping age support\",\n",
    "\n",
    "    \"pathology_variables\":\n",
    "        \"descriptive_within_PD_only\",\n",
    "\n",
    "    \"notes\": [\n",
    "        \"Donor is biological replicate.\",\n",
    "        \"No cell-level disease inference.\",\n",
    "        \"No gene results inspected before this lock.\",\n",
    "        \"All primary cell classes retain all 29 donors \"\n",
    "        \"at >=50 nuclei/donor.\"\n",
    "    ]\n",
    "}\n",
    "\n",
    "lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_PD_CELL_ANALYSIS_PLAN_v1.json\"\n",
    ")\n",
    "\n",
    "with open(lock_path, \"w\") as f:\n",
    "    json.dump(\n",
    "        PD_CELL_PLAN,\n",
    "        f,\n",
    "        indent=2\n",
    "    )\n",
    "\n",
    "print(json.dumps(\n",
    "    PD_CELL_PLAN,\n",
    "    indent=2\n",
    "))\n",
    "\n",
    "print(\"\\nFROZEN:\")\n",
    "print(lock_path)"
   ]
