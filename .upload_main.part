    "#\n",
    "# PRIMARY CROSS-DATASET METRICS\n",
    "# -----------------------------\n",
    "# 1. All-gene log2FC Spearman concordance\n",
    "# 2. All-gene Wald-rank Spearman concordance\n",
    "# 3. One-sided gene-label permutation null for both metrics\n",
    "# 4. Directional enrichment of frozen discovery FDR hits\n",
    "# 5. Individual discovery-hit replication:\n",
    "#\n",
    "#       same direction\n",
    "#       +\n",
    "#       replication nominal p < 0.05\n",
    "#\n",
    "# 6. Replication FDR support reported separately\n",
    "# 7. PMI sensitivity used ONLY as robustness annotation\n",
    "#\n",
    "# IMPORTANT\n",
    "# ---------\n",
    "# - Discovery effects stay frozen.\n",
    "# - Replication effects stay frozen.\n",
    "# - No gene refiltering.\n",
    "# - No choosing genes because they look good.\n",
    "# - Replication duplicate-symbol mappings are excluded\n",
    "#   BEFORE cross-dataset matching.\n",
    "#\n",
    "# The permutation/null plan is written to disk BEFORE\n",
    "# either dataset's effect vectors are loaded below.\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "from scipy.stats import (\n",
    "    rankdata,\n",
    "    binomtest,\n",
    ")\n",
    "\n",
    "import hashlib\n",
    "import json\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = ROOT / \"locks\"\n",
    "\n",
    "OUT_ROOT = (\n",
    "    ROOT /\n",
    "    \"PD_discovery_replication_comparison\"\n",
    ")\n",
    "\n",
    "OUT_ROOT.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True\n",
    ")\n",
    "\n",
    "\n",
    "discovery_freeze_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_PD_DISCOVERY_EFFECT_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "replication_plan_path = (\n",
    "    LOCKS /\n",
    "    \"GSE157783_PD_REPLICATION_PLAN_v1.json\"\n",
    ")\n",
    "\n",
    "replication_freeze_path = (\n",
    "    LOCKS /\n",
    "    \"GSE157783_PD_REPLICATION_EFFECT_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "replication_audit_path = (\n",
    "    LOCKS /\n",
    "    \"GSE157783_PRIMARY_PD_REPLICATION_DE_AUDIT_v1.json\"\n",
    ")\n",
    "\n",
    "PMI_sensitivity_path = (\n",
    "    LOCKS /\n",
    "    \"GSE157783_PD_REPLICATION_PMI_SENSITIVITY_v1.json\"\n",
    ")\n",
    "\n",
    "PMI_support_freeze_path = (\n",
    "    LOCKS /\n",
    "    \"GSE157783_PD_REPLICATION_SENSITIVITY_SUPPORT_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "null_plan_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_GSE157783_PD_COMPARISON_NULL_PLAN_v1.json\"\n",
    ")\n",
    "\n",
    "comparison_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_GSE157783_PD_REPLICATION_COMPARISON_v1.json\"\n",
    ")\n",
    "\n",
    "summary_path = (\n",
    "    OUT_ROOT /\n",
    "    \"PD_DISCOVERY_REPLICATION_SUMMARY_v1.csv\"\n",
    ")\n",
    "\n",
    "hit_summary_path = (\n",
    "    OUT_ROOT /\n",
    "    \"PD_DISCOVERY_FDR_REPLICATION_SUMMARY_v1.csv\"\n",
    ")\n",
    "\n",
    "combined_matched_path = (\n",
    "    OUT_ROOT /\n",
    "    \"PD_DISCOVERY_REPLICATION_ALL_MATCHED_GENES_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "combined_hits_path = (\n",
    "    OUT_ROOT /\n",
    "    \"PD_DISCOVERY_FDR_GENE_REPLICATION_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "\n",
    "    discovery_freeze_path,\n",
    "    replication_plan_path,\n",
    "    replication_freeze_path,\n",
    "    replication_audit_path,\n",
    "    PMI_sensitivity_path,\n",
    "    PMI_support_freeze_path,\n",
    "\n",
    "]:\n",
    "\n",
    "    assert path.exists(), (\n",
    "        f\"Missing required lock: {path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. LOAD LOCK METADATA ONLY\n",
    "#\n",
    "# IMPORTANT:\n",
    "# No effect-vector CSV is read before Section 3 freezes\n",
    "# the null/comparison plan.\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    discovery_freeze_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    discovery_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    replication_plan_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    replication_plan = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    replication_freeze_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    replication_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    replication_audit_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    replication_audit = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    PMI_sensitivity_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    PMI_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    PMI_support_freeze_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    PMI_support_lock = json.load(f)\n",
    "\n",
    "\n",
    "assert (\n",
    "    discovery_lock[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"PD_DISCOVERY_EFFECTS_FROZEN\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    replication_plan[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"PD_REPLICATION_PLAN_FROZEN_BEFORE_ANALYSIS\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    replication_lock[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"PD_REPLICATION_EFFECTS_FROZEN\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    replication_audit[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"PRIMARY_REPLICATION_DE_AUDIT_COMPLETE\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    PMI_lock[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"PD_REPLICATION_PMI_SENSITIVITY_COMPLETE\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    PMI_support_lock[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"PD_REPLICATION_SENSITIVITY_SUPPORT_FROZEN\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    replication_lock[\n",
    "        \"effects_frozen_before_discovery_comparison\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    PMI_support_lock[\n",
    "        \"sensitivity_support_frozen_before_discovery_comparison\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"ALL DISCOVERY + REPLICATION EFFECTS FROZEN BEFORE COMPARISON\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. CELL CLASSES\n",
    "# ============================================================\n",
    "\n",
    "CELL_CLASSES = [\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "]\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. FREEZE CROSS-DATASET NULL / MULTIPLE-TESTING PLAN\n",
    "#\n",
    "# THIS OCCURS BEFORE EFFECT VECTOR FILES ARE READ.\n",
    "#\n",
    "# Permutation:\n",
    "#   random gene-label permutation within each matched\n",
    "#   cell-class gene universe\n",
    "#\n",
    "# Alternative:\n",
    "#   positive concordance\n",
    "#\n",
    "# 10,000 permutations:\n",
    "#   minimum empirical p = 1 / 10,001\n",
    "#\n",
    "# Multiplicity:\n",
    "#   BH separately across the four cell classes for:\n",
    "#\n",
    "#       - LFC correlation\n",
    "#       - Wald correlation\n",
    "#       - discovery-FDR direction enrichment\n",
    "# ============================================================\n",
    "\n",
    "N_PERMUTATIONS = 10_000\n",
    "\n",
    "\n",
    "PERMUTATION_SEEDS = {\n",
    "\n",
    "    \"Astro\":\n",
    "        2026091801,\n",
    "\n",
    "    \"Micro\":\n",
    "        2026091802,\n",
    "\n",
    "    \"OPC\":\n",
    "        2026091803,\n",
    "\n",
    "    \"Oligo\":\n",
    "        2026091804,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "NULL_PLAN = {\n",
    "\n",
    "    \"created_utc\":\n",
    "        datetime.now(\n",
    "            timezone.utc\n",
    "        ).isoformat(),\n",
    "\n",
    "    \"status\":\n",
    "        \"CROSS_DATASET_NULL_PLAN_FROZEN\",\n",
    "\n",
    "    \"written_before_effect_vectors_loaded\":\n",
    "        True,\n",
    "\n",
    "    \"cell_classes\":\n",
    "        CELL_CLASSES,\n",
    "\n",
    "    \"gene_matching\": (\n",
    "        \"exact frozen gene symbol; \"\n",
    "        \"replication feature must have \"\n",
    "        \"gene_symbol_unique_in_replication=True\"\n",
    "    ),\n",
    "\n",
    "    \"all_gene_effect_metric\":\n",
    "        \"Spearman correlation of primary PD-vs-Control log2FC\",\n",
    "\n",
    "    \"all_gene_rank_metric\":\n",
    "        \"Spearman correlation of primary signed Wald statistic\",\n",
    "\n",
    "    \"permutation_null\":\n",
    "        \"random permutation of replication gene labels\",\n",
    "\n",
    "    \"alternative\":\n",
    "        \"positive\",\n",
    "\n",
    "    \"n_permutations\":\n",
    "        N_PERMUTATIONS,\n",
    "\n",
    "    \"seeds\":\n",
    "        PERMUTATION_SEEDS,\n",
    "\n",
    "    \"empirical_p_formula\":\n",
    "        \"(1 + number(null >= observed)) / (1 + n_permutations)\",\n",
    "\n",
    "    \"discovery_FDR_direction_test\":\n",
    "        \"exact binomial test versus 0.5, alternative greater\",\n",
    "\n",
    "    \"individual_gene_replication_rule\":\n",
    "        (\n",
    "            \"same log2FC direction AND \"\n",
    "            \"replication primary nominal two-sided p<0.05\"\n",
    "        ),\n",
    "\n",
    "    \"replication_FDR_required_for_gene_level_replication\":\n",
    "        False,\n",
    "\n",
    "    \"PMI_role\":\n",
    "        (\n",
    "            \"robustness annotation only; \"\n",
    "            \"does not replace primary replication effect\"\n",
    "        ),\n",
    "\n",
    "    \"multiple_testing\": {\n",
    "\n",
    "        \"LFC_permutation_p\":\n",
    "            \"BH across four cell classes\",\n",
    "\n",
    "        \"Wald_permutation_p\":\n",
    "            \"BH across four cell classes\",\n",
    "\n",
    "        \"discovery_FDR_direction_binomial_p\":\n",
    "            \"BH across four cell classes\",\n",
    "\n",
    "    },\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    null_plan_path,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        NULL_PLAN,\n",
    "        f,\n",
    "        indent=2\n",
    "    )\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nCross-dataset null plan frozen BEFORE effect comparison:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    null_plan_path\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. HELPERS\n",
    "# ============================================================\n",
    "\n",
    "def sha256_file(\n",
    "    path,\n",
    "    block_size=1024 * 1024\n",
    "):\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\"\n",
    "    ) as f:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            block = f.read(\n",
    "                block_size\n",
    "            )\n",
    "\n",
    "            if not block:\n",
    "                break\n",
    "\n",
    "            h.update(\n",
    "                block\n",
    "            )\n",
    "\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "def as_bool(\n",
    "    series\n",
    "):\n",
    "\n",
    "    if pd.api.types.is_bool_dtype(\n",
    "        series\n",
    "    ):\n",
    "\n",
    "        return series.astype(\n",
    "            bool\n",
    "        )\n",
    "\n",
    "\n",
    "    return (\n",
    "        series\n",
    "        .astype(str)\n",
    "        .str.strip()\n",
    "        .str.lower()\n",
    "        .map(\n",
    "            {\n",
    "                \"true\":\n",
    "                    True,\n",
    "\n",
    "                \"false\":\n",
    "                    False,\n",
    "\n",
    "                \"1\":\n",
    "                    True,\n",
    "\n",
    "                \"0\":\n",
    "                    False,\n",
    "            }\n",
    "        )\n",
    "        .fillna(\n",
    "            False\n",
    "        )\n",
    "        .astype(\n",
    "            bool\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "def bh_adjust(\n",
    "    pvalues\n",
    "):\n",
    "\n",
    "    pvalues = np.asarray(\n",
    "        pvalues,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "\n",
    "    assert np.isfinite(\n",
    "        pvalues\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    m = len(\n",
    "        pvalues\n",
    "    )\n",
    "\n",
    "\n",
    "    order = np.argsort(\n",
    "        pvalues\n",
    "    )\n",
    "\n",
    "\n",
    "    ranked = pvalues[\n",
    "        order\n",
    "    ]\n",
    "\n",
    "\n",
    "    adjusted_ranked = (\n",
    "\n",
    "        ranked\n",
    "\n",
    "        *\n",
    "\n",
    "        m\n",
    "\n",
    "        /\n",
    "\n",
    "        np.arange(\n",
    "            1,\n",
    "            m + 1,\n",
    "            dtype=float\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    adjusted_ranked = np.minimum.accumulate(\n",
    "\n",
    "        adjusted_ranked[\n",
    "            ::-1\n",
    "        ]\n",
    "\n",
    "    )[\n",
    "        ::-1\n",
    "    ]\n",
    "\n",
    "\n",
    "    adjusted_ranked = np.minimum(\n",
    "        adjusted_ranked,\n",
    "        1.0\n",
    "    )\n",
    "\n",
    "\n",
    "    adjusted = np.empty(\n",
    "        m,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "\n",
    "    adjusted[\n",
    "        order\n",
    "    ] = adjusted_ranked\n",
    "\n",
    "\n",
    "    return adjusted\n",
    "\n",
    "\n",
    "def centered_rank_vector(\n",
    "    values\n",
    "):\n",
    "\n",
    "    values = np.asarray(\n",
    "        values,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "\n",
    "    ranks = rankdata(\n",
    "        values,\n",
    "        method=\"average\"\n",
    "    ).astype(\n",
    "        float\n",
    "    )\n",
    "\n",
    "\n",
    "    ranks -= ranks.mean()\n",
    "\n",
    "\n",
    "    return ranks\n",
    "\n",
    "\n",
    "def rank_correlation(\n",
    "    x,\n",
    "    y\n",
    "):\n",
    "\n",
    "    x = np.asarray(\n",
    "        x,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "    y = np.asarray(\n",
    "        y,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "\n",
    "    mask = (\n",
    "        np.isfinite(x)\n",
    "        &\n",
    "        np.isfinite(y)\n",
    "    )\n",
    "\n",
    "\n",
    "    assert mask.sum() >= 3\n",
    "\n",
    "\n",
    "    rx = centered_rank_vector(\n",
    "        x[\n",
    "            mask\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    ry = centered_rank_vector(\n",
    "        y[\n",    "            mask\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    denominator = (\n",
    "\n",
    "        np.linalg.norm(\n",
    "            rx\n",
    "        )\n",
    "\n",
    "        *\n",
    "\n",
    "        np.linalg.norm(\n",
    "            ry\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert denominator > 0\n",
    "\n",
    "\n",
    "    rho = float(\n",
    "\n",
    "        np.dot(\n",
    "            rx,\n",
    "            ry\n",
    "        )\n",
    "\n",
    "        /\n",
    "\n",
    "        denominator\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    return (\n",
    "        rho,\n",
    "        int(\n",
    "            mask.sum()\n",
    "        ),\n",
    "    )\n",
    "\n",
    "\n",
    "def joint_spearman_permutation_test(\n",
    "    discovery_lfc,\n",
    "    replication_lfc,\n",
    "    discovery_wald,\n",
    "    replication_wald,\n",
    "    n_permutations,\n",
    "    seed,\n",
    "):\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Use the same finite-gene set for both metrics.\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    arrays = [\n",
    "\n",
    "        np.asarray(\n",
    "            discovery_lfc,\n",
    "            dtype=float\n",
    "        ),\n",
    "\n",
    "        np.asarray(\n",
    "            replication_lfc,\n",
    "            dtype=float\n",
    "        ),\n",
    "\n",
    "        np.asarray(\n",
    "            discovery_wald,\n",
    "            dtype=float\n",
    "        ),\n",
    "\n",
    "        np.asarray(\n",
    "            replication_wald,\n",
    "            dtype=float\n",
    "        ),\n",
    "\n",
    "    ]\n",
    "\n",
    "\n",
    "    mask = np.ones(\n",
    "        len(\n",
    "            arrays[\n",
    "                0\n",
    "            ]\n",
    "        ),\n",
    "        dtype=bool\n",
    "    )\n",
    "\n",
    "\n",
    "    for array in arrays:\n",
    "\n",
    "        mask &= np.isfinite(\n",
    "            array\n",
    "        )\n",
    "\n",
    "\n",
    "    n = int(\n",
    "        mask.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert n >= 3\n",
    "\n",
    "\n",
    "    d_lfc = centered_rank_vector(\n",
    "        arrays[\n",
    "            0\n",
    "        ][\n",
    "            mask\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    r_lfc = centered_rank_vector(\n",
    "        arrays[\n",
    "            1\n",
    "        ][\n",
    "            mask\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    d_wald = centered_rank_vector(\n",
    "        arrays[\n",
    "            2\n",
    "        ][\n",
    "            mask\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    r_wald = centered_rank_vector(\n",
    "        arrays[\n",
    "            3\n",
    "        ][\n",
    "            mask\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    denom_lfc = (\n",
    "\n",
    "        np.linalg.norm(\n",
    "            d_lfc\n",
    "        )\n",
    "\n",
    "        *\n",
    "\n",
    "        np.linalg.norm(\n",
    "            r_lfc\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    denom_wald = (\n",
    "\n",
    "        np.linalg.norm(\n",
    "            d_wald\n",
    "        )\n",
    "\n",
    "        *\n",
    "\n",
    "        np.linalg.norm(\n",
    "            r_wald\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    observed_lfc = float(\n",
    "\n",
    "        np.dot(\n",
    "            d_lfc,\n",
    "            r_lfc\n",
    "        )\n",
    "\n",
    "        /\n",
    "\n",
    "        denom_lfc\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    observed_wald = float(\n",
    "\n",
    "        np.dot(\n",
    "            d_wald,\n",
    "            r_wald\n",
    "        )\n",
    "\n",
    "        /\n",
    "\n",
    "        denom_wald\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    rng = np.random.default_rng(\n",
    "        seed\n",
    "    )\n",
    "\n",
    "\n",
    "    ge_lfc = 0\n",
    "    ge_wald = 0\n",
    "\n",
    "\n",
    "    for permutation_number in range(\n",
    "        1,\n",
    "        n_permutations + 1\n",
    "    ):\n",
    "\n",
    "        permutation = rng.permutation(\n",
    "            n\n",
    "        )\n",
    "\n",
    "\n",
    "        permuted_lfc = float(\n",
    "\n",
    "            np.dot(\n",
    "                d_lfc,\n",
    "                r_lfc[\n",
    "                    permutation\n",
    "                ]\n",
    "            )\n",
    "\n",
    "            /\n",
    "\n",
    "            denom_lfc\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        permuted_wald = float(\n",
    "\n",
    "            np.dot(\n",
    "                d_wald,\n",
    "                r_wald[\n",
    "                    permutation\n",
    "                ]\n",
    "            )\n",
    "\n",
    "            /\n",
    "\n",
    "            denom_wald\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        if (\n",
    "            permuted_lfc\n",
    "            >=\n",
    "            observed_lfc\n",
    "        ):\n",
    "\n",
    "            ge_lfc += 1\n",
    "\n",
    "\n",
    "        if (\n",
    "            permuted_wald\n",
    "            >=\n",
    "            observed_wald\n",
    "        ):\n",
    "\n",
    "            ge_wald += 1\n",
    "\n",
    "\n",
    "        if (\n",
    "            permutation_number\n",
    "            % 2500\n",
    "            ==\n",
    "            0\n",
    "        ):\n",
    "\n",
    "            print(\n",
    "                \"    permutations:\",\n",
    "                f\"{permutation_number:,}\",\n",
    "                \"/\",\n",
    "                f\"{n_permutations:,}\"\n",
    "            )\n",
    "\n",
    "\n",
    "    p_lfc = float(\n",
    "\n",
    "        (\n",
    "            ge_lfc\n",
    "            +\n",
    "            1\n",
    "        )\n",
    "\n",
    "        /\n",
    "\n",
    "        (\n",
    "            n_permutations\n",
    "            +\n",
    "            1\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    p_wald = float(\n",
    "\n",
    "        (\n",
    "            ge_wald\n",
    "            +\n",
    "            1\n",
    "        )\n",
    "\n",
    "        /\n",
    "\n",
    "        (\n",
    "            n_permutations\n",
    "            +\n",
    "            1\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    return {\n",
    "\n",
    "        \"n_genes\":\n",
    "            n,\n",
    "\n",
    "        \"LFC_spearman\":\n",
    "            observed_lfc,\n",
    "\n",
    "        \"LFC_permutation_p\":\n",
    "            p_lfc,\n",
    "\n",
    "        \"Wald_spearman\":\n",
    "            observed_wald,\n",
    "\n",
    "        \"Wald_permutation_p\":\n",
    "            p_wald,\n",
    "\n",
    "    }\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. NOW LOAD FROZEN EFFECT VECTORS\n",
    "#\n",
    "# Null plan is already on disk.\n",
    "# ============================================================\n",
    "\n",
    "summary_rows = []\n",
    "\n",
    "hit_summary_rows = []\n",
    "\n",
    "matched_tables = []\n",
    "\n",
    "hit_tables = []\n",
    "\n",
    "comparison_records = {}\n",
    "\n",
    "\n",
    "for class_number, cell_type in enumerate(\n",
    "    CELL_CLASSES,\n",
    "    start=1\n",
    "):\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\n\"\n",
    "        +\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"[{class_number}/4] \"\n",
    "        f\"{cell_type} — DISCOVERY ↔ REPLICATION\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 5.1 DISCOVERY EFFECT VECTOR\n",
    "    # ========================================================\n",
    "\n",
    "    discovery_record = (\n",
    "\n",
    "        discovery_lock[\n",
    "            \"cell_class_effect_vectors\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    discovery_path = Path(\n",
    "        discovery_record[\n",
    "            \"effect_vector_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert discovery_path.exists()\n",
    "\n",
    "\n",
    "    assert (\n",
    "        sha256_file(\n",
    "            discovery_path\n",
    "        )\n",
    "        ==\n",
    "        discovery_record[\n",
    "            \"effect_vector_file_sha256\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    discovery = pd.read_csv(\n",
    "        discovery_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        discovery[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .is_unique\n",
    "    )\n",
    "\n",
    "\n",
    "    discovery[\n",
    "        \"discovery_primary_FDR05\"\n",
    "    ] = as_bool(\n",
    "        discovery[\n",
    "            \"discovery_primary_FDR05\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 5.2 REPLICATION EFFECT VECTOR\n",
    "    # ========================================================\n",
    "\n",
    "    replication_record = (\n",
    "\n",
    "        replication_lock[\n",
    "            \"cell_class_effect_vectors\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    replication_path = Path(\n",
    "        replication_record[\n",
    "            \"effect_vector_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert replication_path.exists()\n",
    "\n",
    "\n",
    "    assert (\n",
    "        sha256_file(\n",
    "            replication_path\n",
    "        )\n",
    "        ==\n",
    "        replication_record[\n",
    "            \"effect_vector_file_sha256\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    replication_all = pd.read_csv(\n",
    "        replication_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    replication_all[\n",
    "        \"gene_symbol_unique_in_replication\"\n",
    "    ] = as_bool(\n",
    "        replication_all[\n",
    "            \"gene_symbol_unique_in_replication\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Exact preregistered mapping rule:\n",
    "    # replication symbol must be unambiguous.\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    replication = (\n",
    "\n",
    "        replication_all[\n",
    "            replication_all[\n",
    "                \"gene_symbol_unique_in_replication\"\n",
    "            ]\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        replication[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .is_unique\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 5.3 PMI SENSITIVITY TABLE\n",
    "    # ========================================================\n",
    "\n",
    "    PMI_comparison_path = Path(\n",
    "\n",
    "        PMI_lock[\n",
    "            \"cell_class_results\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ][\n",
    "            \"primary_vs_PMI\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert PMI_comparison_path.exists()\n",
    "\n",
    "\n",
    "    PMI_comparison = pd.read_csv(\n",
    "        PMI_comparison_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    PMI_comparison[\n",
    "        \"gene_symbol_unique_in_replication\"\n",
    "    ] = as_bool(\n",
    "        PMI_comparison[\n",
    "            \"gene_symbol_unique_in_replication\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    PMI_unique = (\n",
    "\n",
    "        PMI_comparison[\n",
    "            PMI_comparison[\n",
    "                \"gene_symbol_unique_in_replication\"\n",
    "            ]\n",
    "        ]\n",
    "        [\n",
    "            [\n",
    "                \"gene_symbol\",\n",
    "                \"PMI_LFC\",\n",
    "                \"PMI_Wald\",\n",
    "                \"PMI_p\",\n",
    "                \"PMI_padj\",\n",
    "            ]\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        PMI_unique[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .is_unique\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 5.4 MATCH ALL GENES BY EXACT UNIQUE SYMBOL\n",
    "    # ========================================================\n",
    "\n",
    "    matched = (\n",
    "\n",
    "        discovery[\n",
    "            [\n",
    "                \"gene_symbol\",\n",
    "                \"baseMean\",\n",
    "                \"PD_vs_Control_log2FC\",\n",
    "                \"PD_vs_Control_Wald\",\n",
    "                \"PD_vs_Control_pvalue\",\n",
    "                \"PD_vs_Control_padj\",\n",
    "                \"discovery_primary_FDR05\",\n",
    "            ]\n",
    "        ]\n",
    "        .rename(\n",
    "            columns={\n",
    "\n",
    "                \"baseMean\":\n",
    "                    \"discovery_baseMean\",\n",
    "\n",
    "                \"PD_vs_Control_log2FC\":\n",
    "                    \"discovery_LFC\",\n",
    "\n",
    "                \"PD_vs_Control_Wald\":\n",
    "                    \"discovery_Wald\",\n",
    "\n",
    "                \"PD_vs_Control_pvalue\":\n",
    "                    \"discovery_p\",\n",
    "\n",
    "                \"PD_vs_Control_padj\":\n",
    "                    \"discovery_padj\",\n",
    "\n",
    "            }\n",
    "        )\n",
    "\n",
    "        .merge(\n",
    "\n",
    "            replication[\n",
    "                [\n",
    "                    \"gene_symbol\",\n",
    "                    \"gene_id\",\n",
    "                    \"baseMean\",\n",
    "                    \"PD_vs_Control_log2FC\",\n",
    "                    \"PD_vs_Control_Wald\",\n",
    "                    \"PD_vs_Control_pvalue\",\n",
    "                    \"PD_vs_Control_padj\",\n",
    "                    \"replication_FDR05\",\n",
    "                ]\n",
    "            ]\n",
    "            .rename(\n",
    "                columns={\n",
    "\n",
    "                    \"gene_id\":\n",
    "                        \"replication_gene_id\",\n",
    "\n",
    "                    \"baseMean\":\n",
    "                        \"replication_baseMean\",\n",
    "\n",
    "                    \"PD_vs_Control_log2FC\":\n",
    "                        \"replication_LFC\",\n",
    "\n",
    "                    \"PD_vs_Control_Wald\":\n",
    "                        \"replication_Wald\",\n",
    "\n",
    "                    \"PD_vs_Control_pvalue\":\n",
    "                        \"replication_p\",\n",
    "\n",
    "                    \"PD_vs_Control_padj\":\n",
    "                        \"replication_padj\",\n",
    "\n",
    "                    \"replication_FDR05\":\n",
    "                        \"replication_FDR05\",\n",
    "\n",
    "                }\n",
    "            ),\n",
    "\n",
    "            on=\"gene_symbol\",\n",
    "\n",
    "            how=\"inner\",\n",
    "\n",
    "            validate=\"one_to_one\",\n",
    "\n",
    "        )\n",
    "\n",
    "        .merge(\n",
    "\n",
    "            PMI_unique,\n",
    "\n",
    "            on=\"gene_symbol\",\n",
    "\n",
    "            how=\"left\",\n",
    "\n",
    "            validate=\"one_to_one\",\n",
    "\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        matched[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .is_unique\n",
    "    )\n",
    "\n",
    "\n",
    "    matched.insert(\n",
    "        0,\n",
    "        \"cell_type\",\n",
    "        cell_type\n",
    "    )\n",
    "\n",
    "\n",
    "    n_matched = len(\n",
    "        matched\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Discovery tested:\",\n",
    "        f\"{len(discovery):,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Replication tested:\",\n",
    "        f\"{len(replication_all):,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Replication unique-symbol features:\",\n",
    "        f\"{len(replication):,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Matched genes:\",\n",
    "        f\"{n_matched:,}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 5.5 ALL-GENE CONCORDANCE + PERMUTATION NULL\n",
    "    # ========================================================\n",
    "\n",
    "    print(\n",
    "        \"\\nRunning frozen gene-label permutation null...\"\n",
    "    )\n",
    "\n",
    "\n",
    "    permutation_result = (\n",
    "\n",
    "        joint_spearman_permutation_test(\n",
    "\n",
    "            discovery_lfc=\n",
    "                matched[\n",
    "                    \"discovery_LFC\"\n",
    "                ],\n",
    "\n",
    "            replication_lfc=\n",
    "                matched[\n",
    "                    \"replication_LFC\"\n",
    "                ],\n",
    "\n",
    "            discovery_wald=\n",
    "                matched[\n",
    "                    \"discovery_Wald\"\n",
    "                ],\n",
    "\n",
    "            replication_wald=\n",
    "                matched[\n",
    "                    \"replication_Wald\"\n",
    "                ],\n",
    "\n",
    "            n_permutations=\n",
    "                N_PERMUTATIONS,\n",
    "\n",
    "            seed=\n",
    "                PERMUTATION_SEEDS[\n",
    "                    cell_type\n",
    "                ],\n",
    "\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 5.6 ALL-GENE SIGN CONCORDANCE\n",
    "    # ========================================================\n",
    "\n",
    "    sign_mask = (\n",
    "\n",
    "        np.isfinite(\n",
    "            matched[\n",
    "                \"discovery_LFC\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        np.isfinite(\n",
    "            matched[\n",
    "                \"replication_LFC\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            matched[\n",
    "                \"discovery_LFC\"\n",
    "            ]\n",
    "            !=\n",
    "            0\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            matched[\n",
    "                \"replication_LFC\"\n",
    "            ]\n",
    "            !=\n",
    "            0\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    all_gene_same_direction = (\n",
    "\n",
    "        np.sign(\n",
    "            matched.loc[\n",
    "                sign_mask,\n",
    "                \"discovery_LFC\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        ==\n",
    "\n",
    "        np.sign(\n",
    "            matched.loc[\n",
    "                sign_mask,\n",
    "                \"replication_LFC\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    all_gene_direction_concordance = float(\n",
    "        all_gene_same_direction.mean()\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 5.7 DISCOVERY FDR HIT SET\n",
    "    # ========================================================\n",
    "\n",
    "    discovery_hits_all = (\n",
    "\n",
    "        discovery[\n",
    "            discovery[\n",
    "                \"discovery_primary_FDR05\"\n",
    "            ]\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_discovery_hits_total = int(\n",
    "        len(\n",
    "            discovery_hits_all\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    replication_unique_symbols = set(\n",
    "\n",
    "        replication[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    replication_all_symbols = set(\n",
    "\n",
    "        replication_all[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    duplicated_replication_symbols = set(\n",
    "\n",
    "        replication_all.loc[\n",
    "            ~replication_all[\n",
    "                \"gene_symbol_unique_in_replication\"\n",
    "            ],\n",
    "            \"gene_symbol\",\n",
    "        ]\n",
    "        .astype(str)\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    measurable_hit_symbols = (\n",
    "\n",
    "        set(\n",
    "            discovery_hits_all[\n",
    "                \"gene_symbol\"\n",
    "            ]\n",
    "            .astype(str)\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        replication_unique_symbols\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_measurable_hits = len(\n",
    "        measurable_hit_symbols\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 5.8 RECORD NON-MEASURABLE DISCOVERY HITS\n",
    "    # ========================================================\n",
    "\n",
    "    missing_hits = (\n",
    "\n",
    "        discovery_hits_all[\n",
    "            ~discovery_hits_all[\n",
    "                \"gene_symbol\"\n",
    "            ]\n",
    "            .isin(\n",
    "                measurable_hit_symbols\n",
    "            )\n",
    "        ]\n",
    "        [\n",
    "            [\n",
    "                \"gene_symbol\",\n",
    "                \"PD_vs_Control_log2FC\",\n",
    "                \"PD_vs_Control_pvalue\",\n",
    "                \"PD_vs_Control_padj\",\n",
    "            ]\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    def missing_reason(\n",
    "        symbol\n",
    "    ):\n",
    "\n",
    "        symbol = str(\n",
    "            symbol\n",
    "        )\n",
    "\n",
    "\n",
    "        if (\n",
    "            symbol\n",
    "            in\n",
    "            duplicated_replication_symbols\n",
    "        ):\n",
    "\n",
    "            return (\n",
    "                \"replication_symbol_duplicated\"\n",
    "            )\n",
    "\n",
    "\n",
    "        if (\n",
    "            symbol\n",
    "            in\n",
    "            replication_all_symbols\n",
    "        ):\n",
    "\n",
    "            return (\n",
    "                \"replication_feature_excluded_from_unique_symbol_matching\"\n",
    "            )\n",
    "\n",
    "\n",
    "        return (\n",
    "            \"not_in_replication_frozen_gene_universe\"\n",
    "        )\n",
    "\n",
    "\n",
    "    if len(\n",
    "        missing_hits\n",
    "    ) > 0:\n",
    "\n",
    "        missing_hits[\n",
    "            \"reason\"\n",
    "        ] = (\n",
    "\n",
    "            missing_hits[\n",
    "                \"gene_symbol\"\n",
    "            ]\n",
    "            .map(\n",
    "                missing_reason\n",
    "            )\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "    missing_hits_path = (\n",
    "\n",
    "        OUT_ROOT /\n",
    "        (\n",
    "            f\"{cell_type}_\"\n",    "            f\"DISCOVERY_FDR_NOT_MEASURABLE_IN_REPLICATION_v1.csv\"\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    missing_hits.to_csv(\n",
    "        missing_hits_path,\n",
    "        index=False\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 5.9 MEASURABLE DISCOVERY HITS\n",
    "    # ========================================================\n",
    "\n",
    "    hits = (\n",
    "\n",
    "        matched[\n",
    "            matched[\n",
    "                \"discovery_primary_FDR05\"\n",
    "            ]\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        hits\n",
    "    ) == n_measurable_hits\n",
    "\n",
    "\n",
    "    hits[\n",
    "        \"same_direction\"\n",
    "    ] = (\n",
    "\n",
    "        np.sign(\n",
    "            hits[\n",
    "                \"discovery_LFC\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        ==\n",
    "\n",
    "        np.sign(\n",
    "            hits[\n",
    "                \"replication_LFC\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    hits[\n",
    "        \"replication_nominal_p_lt_0.05\"\n",
    "    ] = (\n",
    "\n",
    "        np.isfinite(\n",
    "            hits[\n",
    "                \"replication_p\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            hits[\n",
    "                \"replication_p\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    hits[\n",
    "        \"gene_level_replication_success\"\n",
    "    ] = (\n",
    "\n",
    "        hits[\n",
    "            \"same_direction\"\n",
    "        ]\n",
    "\n",
    "        &\n",
    "\n",
    "        hits[\n",
    "            \"replication_nominal_p_lt_0.05\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    hits[\n",
    "        \"replication_FDR_same_direction\"\n",
    "    ] = (\n",
    "\n",
    "        hits[\n",
    "            \"same_direction\"\n",
    "        ]\n",
    "\n",
    "        &\n",
    "\n",
    "        np.isfinite(\n",
    "            hits[\n",
    "                \"replication_padj\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            hits[\n",
    "                \"replication_padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # PMI robustness annotation.\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    hits[\n",
    "        \"PMI_same_direction_as_discovery\"\n",
    "    ] = (\n",
    "\n",
    "        np.sign(\n",
    "            hits[\n",
    "                \"discovery_LFC\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        ==\n",
    "\n",
    "        np.sign(\n",
    "            hits[\n",
    "                \"PMI_LFC\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    hits[\n",
    "        \"PMI_nominal_p_lt_0.05\"\n",
    "    ] = (\n",
    "\n",
    "        np.isfinite(\n",
    "            hits[\n",
    "                \"PMI_p\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            hits[\n",
    "                \"PMI_p\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    hits[\n",
    "        \"gene_level_replication_success_PMI_supported\"\n",
    "    ] = (\n",
    "\n",
    "        hits[\n",
    "            \"gene_level_replication_success\"\n",
    "        ]\n",
    "\n",
    "        &\n",
    "\n",
    "        hits[\n",
    "            \"PMI_same_direction_as_discovery\"\n",
    "        ]\n",
    "\n",
    "        &\n",
    "\n",
    "        hits[\n",
    "            \"PMI_nominal_p_lt_0.05\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 5.10 DISCOVERY-HIT DIRECTIONAL ENRICHMENT\n",
    "    # ========================================================\n",
    "\n",
    "    n_same_direction_hits = int(\n",
    "        hits[\n",
    "            \"same_direction\"\n",
    "        ].sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    if n_measurable_hits > 0:\n",
    "\n",
    "        direction_test = binomtest(\n",
    "\n",
    "            k=\n",
    "                n_same_direction_hits,\n",
    "\n",
    "            n=\n",
    "                n_measurable_hits,\n",
    "\n",
    "            p=\n",
    "                0.5,\n",
    "\n",
    "            alternative=\n",
    "                \"greater\",\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        direction_binom_p = float(\n",
    "            direction_test.pvalue\n",
    "        )\n",
    "\n",
    "\n",
    "    else:\n",
    "\n",
    "        direction_binom_p = np.nan\n",
    "\n",
    "\n",
    "    n_gene_replication = int(\n",
    "\n",
    "        hits[\n",
    "            \"gene_level_replication_success\"\n",
    "        ].sum()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_replication_FDR_support = int(\n",
    "\n",
    "        hits[\n",
    "            \"replication_FDR_same_direction\"\n",
    "        ].sum()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_gene_replication_PMI_supported = int(\n",
    "\n",
    "        hits[\n",
    "            \"gene_level_replication_success_PMI_supported\"\n",
    "        ].sum()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 5.11 SAVE FULL MATCHED GENE TABLE\n",
    "    # ========================================================\n",
    "\n",
    "    matched_path = (\n",
    "\n",
    "        OUT_ROOT /\n",
    "        (\n",
    "            f\"{cell_type}_\"\n",
    "            f\"DISCOVERY_REPLICATION_ALL_MATCHED_GENES_v1.csv.gz\"\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    matched.to_csv(\n",
    "\n",
    "        matched_path,\n",
    "\n",
    "        index=False,\n",
    "\n",
    "        compression={\n",
    "            \"method\":\n",
    "                \"gzip\",\n",
    "\n",
    "            \"compresslevel\":\n",
    "                6,\n",
    "        }\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 5.12 SAVE DISCOVERY-HIT GENE TABLE\n",
    "    # ========================================================\n",
    "\n",
    "    hit_path = (\n",
    "\n",
    "        OUT_ROOT /\n",
    "        (\n",
    "            f\"{cell_type}_\"\n",
    "            f\"DISCOVERY_FDR_GENE_REPLICATION_v1.csv.gz\"\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    hits.to_csv(\n",
    "\n",
    "        hit_path,\n",
    "\n",
    "        index=False,\n",
    "\n",
    "        compression={\n",
    "            \"method\":\n",
    "                \"gzip\",\n",
    "\n",
    "            \"compresslevel\":\n",
    "                6,\n",
    "        }\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    matched_tables.append(\n",
    "        matched\n",
    "    )\n",
    "\n",
    "\n",
    "    hit_tables.append(\n",
    "        hits\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 5.13 SUMMARY ROW\n",
    "    # ========================================================\n",
    "\n",
    "    summary_rows.append({\n",
    "\n",
    "        \"cell_type\":\n",
    "            cell_type,\n",
    "\n",
    "        \"discovery_tested\":\n",
    "            int(\n",
    "                len(\n",
    "                    discovery\n",
    "                )\n",
    "            ),\n",
    "\n",
    "        \"replication_tested\":\n",
    "            int(\n",
    "                len(\n",
    "                    replication_all\n",
    "                )\n",
    "            ),\n",
    "\n",
    "        \"replication_unique_symbols\":\n",
    "            int(\n",
    "                len(\n",
    "                    replication\n",
    "                )\n",
    "            ),\n",
    "\n",
    "        \"matched_unique_genes\":\n",
    "            int(\n",
    "                n_matched\n",
    "            ),\n",
    "\n",
    "        \"correlation_test_genes\":\n",
    "            int(\n",
    "                permutation_result[\n",
    "                    \"n_genes\"\n",
    "                ]\n",
    "            ),\n",
    "\n",
    "        \"LFC_spearman\":\n",
    "            float(\n",
    "                permutation_result[\n",
    "                    \"LFC_spearman\"\n",
    "                ]\n",
    "            ),\n",
    "\n",
    "        \"LFC_permutation_p\":\n",
    "            float(\n",
    "                permutation_result[\n",
    "                    \"LFC_permutation_p\"\n",
    "                ]\n",
    "            ),\n",
    "\n",
    "        \"Wald_spearman\":\n",
    "            float(\n",
    "                permutation_result[\n",
    "                    \"Wald_spearman\"\n",
    "                ]\n",
    "            ),\n",
    "\n",
    "        \"Wald_permutation_p\":\n",
    "            float(\n",
    "                permutation_result[\n",
    "                    \"Wald_permutation_p\"\n",
    "                ]\n",
    "            ),\n",
    "\n",
    "        \"all_gene_direction_concordance\":\n",
    "            all_gene_direction_concordance,\n",
    "\n",
    "    })\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 5.14 DISCOVERY-HIT SUMMARY\n",
    "    # ========================================================\n",
    "\n",
    "    hit_summary_rows.append({\n",
    "\n",
    "        \"cell_type\":\n",
    "            cell_type,\n",
    "\n",
    "        \"discovery_FDR_total\":\n",
    "            n_discovery_hits_total,\n",
    "\n",
    "        \"discovery_FDR_measurable\":\n",
    "            n_measurable_hits,\n",
    "\n",
    "        \"discovery_FDR_not_measurable\":\n",
    "            int(\n",
    "                n_discovery_hits_total\n",
    "                -\n",
    "                n_measurable_hits\n",
    "            ),\n",
    "\n",
    "        \"same_direction\":\n",
    "            n_same_direction_hits,\n",
    "\n",
    "        \"same_direction_fraction\":\n",
    "            (\n",
    "                float(\n",
    "                    n_same_direction_hits\n",
    "                    /\n",
    "                    n_measurable_hits\n",
    "                )\n",
    "                if n_measurable_hits > 0\n",
    "                else np.nan\n",
    "            ),\n",
    "\n",
    "        \"direction_binomial_p\":\n",
    "            direction_binom_p,\n",
    "\n",
    "        \"gene_level_replication_success\":\n",
    "            n_gene_replication,\n",
    "\n",
    "        \"gene_level_replication_fraction\":\n",
    "            (\n",
    "                float(\n",
    "                    n_gene_replication\n",
    "                    /\n",
    "                    n_measurable_hits\n",
    "                )\n",
    "                if n_measurable_hits > 0\n",
    "                else np.nan\n",
    "            ),\n",
    "\n",
    "        \"replication_FDR_same_direction\":\n",
    "            n_replication_FDR_support,\n",
    "\n",
    "        \"gene_level_replication_success_PMI_supported\":\n",
    "            n_gene_replication_PMI_supported,\n",
    "\n",
    "    })\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 5.15 RECORD\n",
    "    # ========================================================\n",
    "\n",
    "    comparison_records[\n",
    "        cell_type\n",
    "    ] = {\n",
    "\n",
    "        \"matched_gene_table\":\n",
    "            str(\n",
    "                matched_path\n",
    "            ),\n",
    "\n",
    "        \"matched_gene_table_sha256\":\n",
    "            sha256_file(\n",
    "                matched_path\n",
    "            ),\n",
    "\n",
    "        \"discovery_FDR_replication_table\":\n",
    "            str(\n",
    "                hit_path\n",
    "            ),\n",
    "\n",
    "        \"discovery_FDR_replication_table_sha256\":\n",
    "            sha256_file(\n",
    "                hit_path\n",
    "            ),\n",
    "\n",
    "        \"nonmeasurable_discovery_hits\":\n",
    "            str(\n",
    "                missing_hits_path\n",
    "            ),\n",
    "\n",
    "        \"n_matched_genes\":\n",
    "            int(\n",
    "                n_matched\n",
    "            ),\n",
    "\n",
    "        \"n_discovery_FDR_total\":\n",
    "            int(\n",
    "                n_discovery_hits_total\n",
    "            ),\n",
    "\n",
    "        \"n_discovery_FDR_measurable\":\n",
    "            int(\n",
    "                n_measurable_hits\n",
    "            ),\n",
    "\n",
    "        \"n_same_direction_discovery_FDR\":\n",
    "            int(\n",
    "                n_same_direction_hits\n",
    "            ),\n",
    "\n",
    "        \"n_gene_level_replication_success\":\n",
    "            int(\n",
    "                n_gene_replication\n",
    "            ),\n",
    "\n",
    "        \"n_replication_FDR_same_direction\":\n",
    "            int(\n",
    "                n_replication_FDR_support\n",
    "            ),\n",
    "\n",
    "        \"n_gene_level_replication_PMI_supported\":\n",
    "            int(\n",
    "                n_gene_replication_PMI_supported\n",
    "            ),\n",
    "\n",
    "    }\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nCross-dataset result:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  LFC Spearman:\",\n",
    "        permutation_result[\n",
    "            \"LFC_spearman\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  LFC permutation p:\",\n",
    "        permutation_result[\n",
    "            \"LFC_permutation_p\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Wald Spearman:\",\n",
    "        permutation_result[\n",
    "            \"Wald_spearman\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Wald permutation p:\",\n",
    "        permutation_result[\n",
    "            \"Wald_permutation_p\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  All-gene direction concordance:\",\n",
    "        all_gene_direction_concordance\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"\\nDiscovery FDR hits:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Total:\",\n",
    "        n_discovery_hits_total\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Measurable:\",\n",
    "        n_measurable_hits\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Same direction:\",\n",
    "        (\n",
    "            f\"{n_same_direction_hits}\"\n",
    "            f\"/{n_measurable_hits}\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Direction enrichment p:\",\n",
    "        direction_binom_p\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Same direction + replication p<0.05:\",\n",
    "        (\n",
    "            f\"{n_gene_replication}\"\n",
    "            f\"/{n_measurable_hits}\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Same direction + replication FDR<0.05:\",\n",
    "        (\n",
    "            f\"{n_replication_FDR_support}\"\n",
    "            f\"/{n_measurable_hits}\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Primary replication successes also PMI-supported:\",\n",
    "        (\n",
    "            f\"{n_gene_replication_PMI_supported}\"\n",
    "            f\"/{n_gene_replication}\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. COMBINED SUMMARY TABLES\n",
    "# ============================================================\n",
    "\n",
    "summary = pd.DataFrame(\n",
    "    summary_rows\n",
    ")\n",
    "\n",
    "\n",
    "hit_summary = pd.DataFrame(\n",
    "    hit_summary_rows\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. BH MULTIPLE-TESTING CORRECTION ACROSS FOUR CELL CLASSES\n",
    "# ============================================================\n",
    "\n",
    "summary[\n",
    "    \"LFC_permutation_q_BH\"\n",
    "] = bh_adjust(\n",
    "    summary[\n",
    "        \"LFC_permutation_p\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "summary[\n",
    "    \"Wald_permutation_q_BH\"\n",
    "] = bh_adjust(\n",
    "    summary[\n",
    "        \"Wald_permutation_p\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "hit_summary[\n",
    "    \"direction_binomial_q_BH\"\n",
    "] = bh_adjust(\n",
    "    hit_summary[\n",
    "        \"direction_binomial_p\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. SAVE SUMMARIES\n",
    "# ============================================================\n",
    "\n",
    "summary.to_csv(\n",
    "    summary_path,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "hit_summary.to_csv(\n",
    "    hit_summary_path,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. SAVE COMBINED GENE-LEVEL TABLES\n",
    "# ============================================================\n",
    "\n",
    "combined_matched = pd.concat(\n",
    "    matched_tables,\n",
    "    axis=0,\n",
    "    ignore_index=True\n",
    ")\n",
    "\n",
    "\n",
    "combined_hits = pd.concat(\n",
    "    hit_tables,\n",
    "    axis=0,\n",
    "    ignore_index=True\n",
    ")\n",
    "\n",
    "\n",
    "combined_matched.to_csv(\n",
    "\n",
    "    combined_matched_path,\n",
    "\n",
    "    index=False,\n",
    "\n",
    "    compression={\n",
    "        \"method\":\n",
    "            \"gzip\",\n",
    "\n",
    "        \"compresslevel\":\n",
    "            6,\n",
    "    }\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "combined_hits.to_csv(\n",
    "\n",
    "    combined_hits_path,\n",
    "\n",
    "    index=False,\n",
    "\n",
    "    compression={\n",
    "        \"method\":\n",
    "            \"gzip\",\n",
    "\n",
    "        \"compresslevel\":\n",
    "            6,\n",
    "    }\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. FINAL CROSS-DATASET COMPARISON LOCK\n",
    "# ============================================================\n",
    "\n",
    "COMPARISON_LOCK = {\n",
    "\n",
    "    \"created_utc\":\n",
    "        datetime.now(\n",
    "            timezone.utc\n",
    "        ).isoformat(),\n",
    "\n",
    "    \"status\":\n",
    "        \"PD_DISCOVERY_REPLICATION_COMPARISON_COMPLETE\",\n",
    "\n",
    "    \"discovery_dataset\":\n",
