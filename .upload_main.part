    "        \"exact gene symbol with unique replication symbol mapping\"\n",
    "    ),\n",
    "\n",
    "    \"primary_effects_only_for_cross_dataset_inference\":\n",
    "        True,\n",
    "\n",
    "    \"PMI_used_only_as_robustness_annotation\":\n",
