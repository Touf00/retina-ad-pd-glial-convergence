   "source": [
    "# Source analysis cell: 29\n",
    "# ============================================================\n",
    "# STEP 15 — GSE157783 REPLICATION PSEUDOBULK\n",
    "#           + GENE UNIVERSE\n",
    "#           + FINAL PRE-DE LOCK\n",
    "#\n",
    "# NO DIFFERENTIAL EXPRESSION.\n",
    "# NO DISCOVERY-vs-REPLICATION EFFECT COMPARISON.\n",
    "#\n",
    "# PURPOSE\n",
    "# -------\n",
    "# 1. Verify STEP 14B replication data audit.\n",
    "# 2. Freeze >=50 nuclei/donor for:\n",
    "#       Astro\n",
    "#       Micro\n",
    "#       OPC\n",
    "#       Oligo\n",
    "#\n",
    "#    All 11 donors survive in every class.\n",
    "#\n",
    "# 3. Freeze Ensembl release 93 gene annotation.\n",
    "# 4. Stream the 2.2-GB genes × cells UMI TSV.\n",
    "# 5. Build donor × cell-class raw pseudobulk.\n",
    "# 6. Verify exact UMI conservation.\n",
    "# 7. Freeze disease-blind replication gene universes:\n",
    "#\n",
    "#       CPM >= 1 in >=5 of 11 donors\n",
    "#\n",
    "#    because 5 = size of smaller diagnosis group.\n",
    "#\n",
    "# 8. Exclude MT- genes AFTER expression filtering,\n",
    "#    matching discovery logic.\n",
    "#\n",
    "# 9. Audit/freeze replication models:\n",
    "#\n",
    "#    PRIMARY:\n",
    "#       ~ age + sex + diagnosis_binary\n",
    "#\n",
    "#    TECHNICAL SENSITIVITY:\n",
    "#       ~ age + sex + PMI + diagnosis_binary\n",
    "#\n",
    "# 10. Freeze all replication rules before any disease DE.\n",
    "#\n",
    "# IMPORTANT\n",
    "# ---------\n",
    "# Replication features remain indexed by original Ensembl ID.\n",
    "# Gene symbols are annotation only.\n",
    "#\n",
    "# Cross-dataset matching later will use only unambiguous\n",
    "# gene-symbol mappings after replication effects are frozen.\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "import urllib.request\n",
    "import shutil\n",
    "import hashlib\n",
    "import gzip\n",
    "import json\n",
    "import re\n",
    "import time\n",
    "import gc\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "REP_DIR = (\n",
    "    ROOT /\n",
    "    \"GSE157783_PD_replication\"\n",
    ")\n",
    "\n",
    "EXTRACT_DIR = (\n",
    "    REP_DIR /\n",
    "    \"extracted\"\n",
    ")\n",
    "\n",
    "RESULTS = (\n",
    "    ROOT /\n",
    "    \"results\"\n",
    ")\n",
    "\n",
    "MANIFESTS = (\n",
    "    ROOT /\n",
    "    \"manifests\"\n",
    ")\n",
    "\n",
    "LOCKS = (\n",
    "    ROOT /\n",
    "    \"locks\"\n",
    ")\n",
    "\n",
    "UNIVERSES = (\n",
    "    ROOT /\n",
    "    \"GSE157783_gene_universes\"\n",
    ")\n",
    "\n",
    "ANNOTATIONS = (\n",
    "    ROOT /\n",
    "    \"annotations\"\n",
    ")\n",
    "\n",
    "\n",
    "for directory in [\n",
    "\n",
    "    RESULTS,\n",
    "    MANIFESTS,\n",
    "    LOCKS,\n",
    "    UNIVERSES,\n",
    "    ANNOTATIONS,\n",
    "\n",
    "]:\n",
    "\n",
    "    directory.mkdir(\n",
    "        parents=True,\n",
    "        exist_ok=True\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Inputs\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "cell_metadata_path = (\n",
    "    MANIFESTS /\n",
    "    \"GSE157783_author_cell_metadata_AUDITED_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "donor_metadata_path = (\n",
    "    MANIFESTS /\n",
    "    \"GSE157783_donor_metadata_FROZEN_v1.csv\"\n",
    ")\n",
    "\n",
    "coverage_path = (\n",
    "    MANIFESTS /\n",
    "    \"GSE157783_replication_cellclass_coverage_v1.csv\"\n",
    ")\n",
    "\n",
    "audit_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE157783_REPLICATION_DATA_AUDIT_v1.json\"\n",
    ")\n",
    "\n",
    "replication_plan_path = (\n",
    "    LOCKS /\n",
    "    \"GSE157783_PD_REPLICATION_PLAN_v1.json\"\n",
    ")\n",
    "\n",
    "discovery_freeze_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_PD_DISCOVERY_EFFECT_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "genes_path = (\n",
    "    EXTRACT_DIR /\n",
    "    \"genes\" /\n",
    "    \"IPDCO_hg_midbrain_genes.tsv\"\n",
    ")\n",
    "\n",
    "umi_path = (\n",
    "    EXTRACT_DIR /\n",
    "    \"UMI\" /\n",
    "    \"IPDCO_hg_midbrain_UMI.tsv\"\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Outputs\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "pseudobulk_path = (\n",
    "    RESULTS /\n",
    "    \"GSE157783_donor_celltype_pseudobulk_RAW_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "group_metadata_path = (\n",
    "    MANIFESTS /\n",
    "    \"GSE157783_pseudobulk_group_metadata_v1.csv\"\n",
    ")\n",
    "\n",
    "gene_annotation_path = (\n",
    "    MANIFESTS /\n",
    "    \"GSE157783_Ensembl93_gene_annotation_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "design_metadata_path = (\n",
    "    MANIFESTS /\n",
    "    \"GSE157783_replication_design_metadata_v1.csv\"\n",
    ")\n",
    "\n",
    "pseudobulk_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE157783_PSEUDOBULK_BUILD_v1.json\"\n",
    ")\n",
    "\n",
    "pre_de_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE157783_REPLICATION_PRE_DE_LOCK_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "\n",
    "    cell_metadata_path,\n",
    "    donor_metadata_path,\n",
    "    coverage_path,\n",
    "    audit_lock_path,\n",
    "    replication_plan_path,\n",
    "    discovery_freeze_path,\n",
    "    genes_path,\n",
    "    umi_path,\n",
    "\n",
    "]:\n",
    "\n",
    "    assert path.exists(), (\n",
    "        f\"Missing required input: {path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. LOAD / VERIFY UPSTREAM LOCKS\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    audit_lock_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    audit_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    replication_plan_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    replication_plan = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    discovery_freeze_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    discovery_freeze = json.load(f)\n",
    "\n",
    "\n",
    "assert (\n",
    "    audit_lock[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"REPLICATION_DATA_AUDIT_COMPLETE\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    audit_lock[\n",
    "        \"differential_expression_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    audit_lock[\n",
    "        \"discovery_replication_effect_comparison_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    discovery_freeze[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"PD_DISCOVERY_EFFECTS_FROZEN\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    replication_plan[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"PD_REPLICATION_PLAN_FROZEN_BEFORE_ANALYSIS\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"UPSTREAM DISCOVERY + REPLICATION LOCKS VERIFIED\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. LOAD CELL + DONOR METADATA\n",
    "# ============================================================\n",    "\n",
    "cells = pd.read_csv(\n",
    "    cell_metadata_path,\n",
    "    compression=\"gzip\",\n",
    "    low_memory=False\n",
    ")\n",
    "\n",
    "\n",
    "donors = pd.read_csv(\n",
    "    donor_metadata_path\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2A. NORMALIZE SEX ENCODING\n",
    "#\n",
    "# STEP 14 recovery metadata may encode biological sex as M/F,\n",
    "# while the frozen replication design in this notebook uses the\n",
    "# canonical labels Female/Male.\n",
    "#\n",
    "# Normalize both donor-level and cell-level metadata here,\n",
    "# BEFORE any pseudobulk/group metadata are constructed.\n",
    "# ============================================================\n",
    "\n",
    "SEX_MAP = {\n",
    "    \"F\": \"Female\",\n",
    "    \"M\": \"Male\",\n",
    "    \"Female\": \"Female\",\n",
    "    \"Male\": \"Male\",\n",
    "    \"female\": \"Female\",\n",
    "    \"male\": \"Male\",\n",
    "}\n",
    "\n",
    "\n",
    "def normalize_sex_column(\n",
    "    series,\n",
    "    label,\n",
    "):\n",
    "\n",
    "    raw = (\n",
    "        series\n",
    "        .astype(str)\n",
    "        .str.strip()\n",
    "    )\n",
    "\n",
    "    normalized = raw.map(\n",
    "        SEX_MAP\n",
    "    )\n",
    "\n",
    "    if normalized.isna().any():\n",
    "\n",
    "        bad_values = sorted(\n",
    "            raw[\n",
    "                normalized.isna()\n",
    "            ]\n",
    "            .unique()\n",
    "            .tolist()\n",
    "        )\n",
    "\n",
    "        raise AssertionError(\n",
    "            f\"Unexpected sex encoding in {label}: {bad_values}\"\n",
    "        )\n",
    "\n",
    "    return normalized\n",
    "\n",
    "\n",
    "donors[\n",
    "    \"sex\"\n",
    "] = normalize_sex_column(\n",
    "    donors[\n",
    "        \"sex\"\n",
    "    ],\n",
    "    \"donor metadata\",\n",
    ")\n",
    "\n",
    "\n",
    "cells[\n",
    "    \"sex\"\n",
    "] = normalize_sex_column(\n",
    "    cells[\n",
    "        \"sex\"\n",
    "    ],\n",
    "    \"cell metadata\",\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    set(\n",
    "        donors[\n",
    "            \"sex\"\n",
    "        ]\n",
    "    )\n",
    "    ==\n",
    "    {\n",
    "        \"Female\",\n",
    "        \"Male\",\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    set(\n",
    "        cells[\n",
    "            \"sex\"\n",
    "        ]\n",
    "    )\n",
    "    <=\n",
    "    {\n",
    "        \"Female\",\n",
    "        \"Male\",\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Sex encoding normalized:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"  donors:\",\n",
    "    donors[\n",
    "        \"sex\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"  cells:\",\n",
    "    cells[\n",
    "        \"sex\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    ")\n",
    "\n",
    "\n",
    "\n",
    "coverage = pd.read_csv(\n",
    "    coverage_path\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    cells\n",
    ") == 41435\n",
    "\n",
    "\n",
    "assert len(\n",
    "    donors\n",
    ") == 11\n",
    "\n",
    "\n",
    "assert (\n",
    "    donors[\n",
    "        \"diagnosis_binary\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    "    ==\n",
    "    {\n",
    "        \"Control\": 6,\n",
    "        \"PD\": 5,\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "required_cell_columns = {\n",
    "\n",
    "    \"barcode\",\n",
    "    \"sample_id\",\n",
    "    \"diagnosis_binary\",\n",
    "    \"age\",\n",
    "    \"sex\",\n",
    "    \"PMI\",\n",
    "    \"canonical_cell_class\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "assert (\n",
    "    required_cell_columns\n",
    "    <=\n",
    "    set(\n",
    "        cells.columns\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    cells[\n",
    "        \"barcode\"\n",
    "    ]\n",
    "    .is_unique\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. FREEZE REPLICATION CELL-CLASS THRESHOLD\n",
    "#\n",
    "# >=50 nuclei per donor.\n",
    "#\n",
    "# All 11 donors must survive in all four classes.\n",
    "# ============================================================\n",
    "\n",
    "TARGET_CLASSES = [\n",
    "\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "MIN_NUCLEI_PER_DONOR = 50\n",
    "\n",
    "\n",
    "coverage_50 = (\n",
    "\n",
    "    coverage[\n",
    "        (\n",
    "            coverage[\n",
    "                \"cell_class\"\n",
    "            ]\n",
    "            .isin(\n",
    "                TARGET_CLASSES\n",
    "            )\n",
    "        )\n",
    "        &\n",
    "        (\n",
    "            coverage[\n",
    "                \"min_nuclei\"\n",
    "            ]\n",
    "            ==\n",
    "            MIN_NUCLEI_PER_DONOR\n",
    "        )\n",
    "    ]\n",
    "    .copy()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    coverage_50\n",
    ") == 4\n",
    "\n",
    "\n",
    "for cell_type in TARGET_CLASSES:\n",
    "\n",
    "    row = (\n",
    "\n",
    "        coverage_50[\n",
    "            coverage_50[\n",
    "                \"cell_class\"\n",
    "            ]\n",
    "            ==\n",
    "            cell_type\n",
    "        ]\n",
    "        .iloc[\n",
    "            0\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        row[\n",
    "            \"PD\"\n",
    "        ]\n",
    "    ) == 5\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        row[\n",
    "            \"Control\"\n",
    "        ]\n",
    "    ) == 6\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        row[\n",
    "            \"Total\"\n",
    "        ]\n",
    "    ) == 11\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFrozen replication threshold:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \">=50 nuclei/donor\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"All four target classes retain 5 PD + 6 Control.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. LOAD PROCESSED GENE TABLE\n",
    "# ============================================================\n",
    "\n",
    "genes_raw = pd.read_csv(\n",
    "    genes_path,\n",
    "    sep=\"\\t\",\n",
    "    low_memory=False\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nProcessed gene-table shape:\",\n",
    "    genes_raw.shape\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Gene-table columns:\",\n",
    "    genes_raw.columns.tolist()\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    \"gene\"\n",
    "    in genes_raw.columns\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    \"row\"\n",
    "    in genes_raw.columns\n",
    ")\n",
    "\n",
    "\n",
    "N_GENES = int(\n",
    "    len(\n",
    "        genes_raw\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert N_GENES == 26737, (\n",
    "    f\"Expected 26,737 genes; \"\n",
    "    f\"found {N_GENES:,}\"\n",
    ")\n",
    "\n",
    "\n",
    "gene_ids = (\n",
    "\n",
    "    genes_raw[\n",
    "        \"gene\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .tolist()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    gene_ids\n",
    ") == len(\n",
    "    set(\n",
    "        gene_ids\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "rows_numeric = pd.to_numeric(\n",
    "    genes_raw[\n",
    "        \"row\"\n",
    "    ],\n",
    "    errors=\"raise\"\n",
    ").to_numpy(\n",
    "    dtype=np.int64\n",
    ")\n",
    "\n",
    "\n",
    "assert np.array_equal(\n",
    "\n",
    "    rows_numeric,\n",
    "\n",
    "    np.arange(\n",
    "        1,\n",
    "        N_GENES + 1,\n",
    "        dtype=np.int64\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Processed gene ordering: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. DOWNLOAD / FREEZE ENSEMBL RELEASE 93 GTF\n",
    "#\n",
    "# Cell Ranger 3.0 GRCh38 reference uses Ensembl 93.\n",
    "# ============================================================\n",
    "\n",
    "GTF_URL = (\n",
    "    \"https://ftp.ensembl.org/\"\n",
    "    \"pub/release-93/gtf/homo_sapiens/\"\n",
    "    \"Homo_sapiens.GRCh38.93.gtf.gz\"\n",
    ")\n",
    "\n",
    "gtf_path = (\n",
    "    ANNOTATIONS /\n",
    "    \"Homo_sapiens.GRCh38.93.gtf.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "def download_file(\n",
    "    url,\n",
    "    destination,\n",
    "    retries=4,\n",
    "):\n",
    "\n",
    "    destination = Path(\n",
    "        destination\n",
    "    )\n",
    "\n",
    "\n",
    "    if (\n",
    "        destination.exists()\n",
    "        and\n",
    "        destination.stat().st_size > 0\n",
    "    ):\n",
    "\n",
    "        print(\n",
    "            \"Annotation already present:\",\n",
    "            destination\n",
    "        )\n",
    "\n",
    "        return\n",
    "\n",
    "\n",
    "    request = urllib.request.Request(\n",
    "\n",
    "        url,\n",
    "\n",
    "        headers={\n",
    "            \"User-Agent\":\n",
    "                \"RETINA-ND replication pipeline\"\n",
    "        }\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    last_error = None\n",
    "\n",
    "\n",
    "    for attempt in range(\n",
    "        1,\n",
    "        retries + 1\n",
    "    ):\n",
    "\n",
    "        try:\n",
    "\n",
    "            with urllib.request.urlopen(\n",
    "                request,\n",
    "                timeout=180\n",
    "            ) as response:\n",
    "\n",
    "                with open(\n",
    "                    destination,\n",
    "                    \"wb\"\n",
    "                ) as fout:\n",
    "\n",
    "                    shutil.copyfileobj(\n",
    "                        response,\n",
    "                        fout,\n",
    "                        length=1024 * 1024\n",
    "                    )\n",
    "\n",
    "\n",
    "            assert (\n",
    "                destination.exists()\n",
    "                and\n",
    "                destination.stat().st_size > 0\n",
    "            )\n",
    "\n",
    "\n",
    "            return\n",
    "\n",
    "\n",
    "        except Exception as exc:\n",
    "\n",
    "            last_error = exc\n",
    "\n",
    "\n",
    "            if destination.exists():\n",
    "\n",
    "                destination.unlink()\n",
    "\n",
    "\n",
    "            if attempt < retries:\n",
    "\n",
    "                time.sleep(\n",
    "                    attempt * 2\n",
    "                )\n",
    "\n",
    "\n",
    "    raise RuntimeError(\n",
    "        f\"Could not download Ensembl 93 GTF.\\n\"\n",
    "        f\"{last_error}\"\n",
    "    )\n",
    "\n",
    "\n",
    "download_file(\n",
    "    GTF_URL,\n",
    "    gtf_path\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. HASH HELPER\n",
    "# ============================================================\n",
    "\n",
    "def sha256_file(\n",
    "    path,\n",
    "    block_size=1024 * 1024\n",
    "):\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\"\n",
    "    ) as f:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            block = f.read(\n",
    "                block_size\n",
    "            )\n",
    "\n",
    "\n",
    "            if not block:\n",
    "\n",
    "                break\n",
    "\n",
    "\n",
    "            h.update(\n",
    "                block\n",
    "            )\n",
    "\n",
    "\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "gtf_sha256 = (\n",
    "    sha256_file(\n",
    "        gtf_path\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nEnsembl 93 GTF:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    gtf_path\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"SHA256:\",\n",
    "    gtf_sha256\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. PARSE ENSEMBL 93 GENE ANNOTATION\n",
    "# ============================================================\n",
    "\n",
    "gene_id_re = re.compile(\n",
    "    r'gene_id \"([^\"]+)\"'\n",
    ")\n",
    "\n",
    "gene_name_re = re.compile(\n",
    "    r'gene_name \"([^\"]+)\"'\n",
    ")\n",
    "\n",
    "gene_biotype_re = re.compile(\n",
    "    r'gene_biotype \"([^\"]+)\"'\n",
    ")\n",
    "\n",
    "\n",
    "annotation_rows = []\n",
    "\n",
    "\n",
    "with gzip.open(\n",
    "    gtf_path,\n",
    "    \"rt\",\n",
    "    encoding=\"utf-8\",\n",
    "    errors=\"replace\"\n",
    ") as f:\n",
    "\n",
    "    for line in f:\n",
    "\n",
    "        if (\n",
    "            not line\n",
    "            or\n",
    "            line.startswith(\n",
    "                \"#\"\n",
    "            )\n",
    "        ):\n",
    "\n",
    "            continue\n",
    "\n",
    "\n",
    "        fields = line.rstrip(\n",
    "            \"\\n\"\n",
    "        ).split(\n",
    "            \"\\t\"\n",
    "        )\n",
    "\n",
    "\n",
    "        if len(\n",
    "            fields\n",
    "        ) != 9:\n",
    "\n",
    "            continue\n",
    "\n",
    "\n",
    "        if fields[\n",
    "            2\n",
    "        ] != \"gene\":\n",
    "\n",
    "            continue\n",
    "\n",
    "\n",
    "        attributes = (\n",
    "            fields[\n",
    "                8\n",
    "            ]\n",
    "        )\n",
    "\n",
    "\n",
    "        gene_id_match = (\n",
    "            gene_id_re.search(\n",
    "                attributes\n",
    "            )\n",
    "        )\n",
    "\n",
    "        gene_name_match = (\n",
    "            gene_name_re.search(\n",
    "                attributes\n",
    "            )\n",
    "        )\n",
    "\n",
    "        biotype_match = (\n",
    "            gene_biotype_re.search(\n",
    "                attributes\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "        if gene_id_match is None:\n",
    "\n",
    "            continue\n",
    "\n",
    "\n",
    "        annotation_rows.append({\n",
    "\n",
    "            \"gene_id\":\n",
    "                gene_id_match.group(\n",
    "                    1\n",
    "                ),\n",
    "\n",
    "            \"gene_symbol\":\n",
    "                (\n",
    "                    gene_name_match.group(\n",
    "                        1\n",
    "                    )\n",
    "                    if gene_name_match\n",
    "                    else np.nan\n",
    "                ),\n",
    "\n",
    "            \"gene_biotype\":\n",
    "                (\n",
    "                    biotype_match.group(\n",
    "                        1\n",
    "                    )\n",
    "                    if biotype_match\n",
    "                    else np.nan\n",
    "                ),\n",
    "\n",
    "            \"chromosome\":\n",
    "                fields[\n",
    "                    0\n",
    "                ],\n",
    "        })\n",
    "\n",
    "\n",
    "gtf_annotation = pd.DataFrame(\n",
    "    annotation_rows\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    gtf_annotation[\n",
    "        \"gene_id\"\n",
    "    ]\n",
    "    .is_unique\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nEnsembl 93 genes parsed:\",\n",
    "    f\"{len(gtf_annotation):,}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. MAP THE 26,737 PROCESSED FEATURES\n",
    "# ============================================================\n",
    "\n",
    "processed_annotation = (\n",
    "\n",
    "    genes_raw[\n",
    "        [\n",
    "            \"gene\",\n",
    "            \"row\",\n",
    "        ]\n",
    "    ]\n",
    "    .rename(\n",
    "        columns={\n",
    "            \"gene\":\n",
    "                \"gene_id\",\n",
    "        }\n",
    "    )\n",
    "    .merge(\n",
    "\n",
    "        gtf_annotation,\n",
    "\n",
    "        on=\"gene_id\",\n",
    "\n",
    "        how=\"left\",\n",
    "\n",
    "        validate=\"one_to_one\",\n",
    "\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    processed_annotation\n",
    ") == N_GENES\n",
    "\n",
    "\n",
    "n_missing_symbols = int(\n",
    "\n",
    "    processed_annotation[\n",
    "        \"gene_symbol\"\n",
    "    ]\n",
    "    .isna()\n",
    "    .sum()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Processed genes without Ensembl-93 symbol:\",\n",
    "    n_missing_symbols\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Hard-stop rather than silently use another annotation source.\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "assert (\n",
    "    n_missing_symbols\n",
    "    ==\n",
    "    0\n",
    "), (\n",
    "    \"One or more processed Ensembl IDs did not map \"\n",
    "    \"to Ensembl release 93. Stop before DE.\"\n",
    ")\n",
    "\n",
    "\n",
    "processed_annotation[\n",
    "    \"gene_symbol\"\n",
    "] = (\n",
    "\n",
    "    processed_annotation[\n",
    "        \"gene_symbol\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "processed_annotation[\n",
    "    \"gene_symbol_unique_in_replication\"\n",
    "] = (\n",
    "\n",
    "    ~processed_annotation[\n",
    "        \"gene_symbol\"\n",
    "    ]\n",
    "    .duplicated(\n",
    "        keep=False\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "processed_annotation[\n",
    "    \"mitochondrial_MT_prefix\"\n",
    "] = (\n",
    "\n",
    "    processed_annotation[\n",
    "        \"gene_symbol\"\n",
    "    ]\n",
    "    .str.upper()\n",
    "    .str.startswith(\n",
    "        \"MT-\"\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "n_unique_symbols = int(\n",
    "\n",
    "    processed_annotation[\n",
    "        \"gene_symbol_unique_in_replication\"\n",
    "    ]\n",
    "    .sum()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "n_duplicate_symbol_features = int(\n",
    "\n",
    "    (\n",
    "        ~processed_annotation[\n",
    "            \"gene_symbol_unique_in_replication\"\n",
    "        ]\n",
    "    ).sum()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "n_mt_input = int(\n",
    "\n",
    "    processed_annotation[\n",
    "        \"mitochondrial_MT_prefix\"\n",
    "    ].sum()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Unique-symbol features:\",\n",
    "    f\"{n_unique_symbols:,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Features with duplicated symbols:\",\n",
    "    f\"{n_duplicate_symbol_features:,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Input MT- features:\",\n",
    "    n_mt_input\n",
    ")\n",
    "\n",
    "\n",
    "processed_annotation.to_csv(\n",
    "\n",
    "    gene_annotation_path,\n",
    "\n",
    "    index=False,\n",
    "\n",
    "    compression={\n",
    "        \"method\":\n",
    "            \"gzip\",\n",
    "\n",
    "        \"compresslevel\":\n",
    "            6,\n",
    "    }\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. VERIFY UMI HEADER ↔ CELL METADATA\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    umi_path,\n",
    "    \"rt\",\n",
    "    encoding=\"utf-8\",\n",
    "    errors=\"strict\",\n",
    "    buffering=1024 * 1024\n",
    ") as f:\n",
    "\n",
    "    header_line = (\n",
    "        f.readline()\n",
    "        .rstrip(\n",
    "            \"\\r\\n\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "umi_barcodes = (\n",
    "    header_line.split(\n",
    "        \"\\t\"\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "author_barcodes = (\n",
    "\n",
    "    cells[\n",
    "        \"barcode\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .tolist()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    umi_barcodes\n",
    ") == 41435\n",
    "\n",
    "\n",
    "assert (\n",
    "    umi_barcodes\n",
    "    ==\n",
    "    author_barcodes\n",
    "), (\n",
    "    \"UMI column order no longer matches \"\n",
    "    \"audited cell metadata.\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nUMI ↔ cell barcode exact-order alignment: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. DEFINE TARGET CELLS\n",
    "# ============================================================\n",
    "\n",
    "target_mask = (\n",
    "\n",
    "    cells[\n",
    "        \"canonical_cell_class\"\n",
    "    ]\n",
    "    .isin(\n",
    "        TARGET_CLASSES\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "target_indices = np.flatnonzero(\n",
    "    target_mask.to_numpy()\n",
    ")\n",
    "\n",
    "\n",
    "target_cells = (\n",
    "\n",
    "    cells.loc[\n",
    "        target_mask\n",
    "    ]\n",
    "    .copy()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "N_TARGET_CELLS = int(\n",
    "    len(\n",
    "        target_cells\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert N_TARGET_CELLS == (\n",
    "\n",
    "    4708\n",
    "    +\n",
    "    3903\n",
    "    +\n",
    "    2754\n",
    "    +\n",
    "    21268\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert N_TARGET_CELLS == 32633\n",    "\n",
    "\n",
    "print(\n",
    "    \"Target cells:\",\n",
    "    f\"{N_TARGET_CELLS:,}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. BUILD EXACT 44-GROUP METADATA\n",
    "# ============================================================\n",
    "\n",
    "donor_order = (\n",
    "\n",
    "    donors[\n",
    "        \"sample_id\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .tolist()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    donor_order\n",
    ") == 11\n",
    "\n",
    "\n",
    "group_rows = []\n",
    "\n",
    "\n",
    "for cell_type in TARGET_CLASSES:\n",
    "\n",
    "    for donor in donor_order:\n",
    "\n",
    "        donor_row = (\n",
    "\n",
    "            donors[\n",
    "                donors[\n",
    "                    \"sample_id\"\n",
    "                ]\n",
    "                .astype(str)\n",
    "                ==\n",
    "                donor\n",
    "            ]\n",
    "            .iloc[\n",
    "                0\n",
    "            ]\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        n_nuclei = int(\n",
    "\n",
    "            (\n",
    "                (\n",
    "                    target_cells[\n",
    "                        \"canonical_cell_class\"\n",
    "                    ]\n",
    "                    ==\n",
    "                    cell_type\n",
    "                )\n",
    "                &\n",
    "                (\n",
    "                    target_cells[\n",
    "                        \"sample_id\"\n",
    "                    ]\n",
    "                    .astype(str)\n",
    "                    ==\n",
    "                    donor\n",
    "                )\n",
    "            ).sum()\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        assert (\n",
    "            n_nuclei\n",
    "            >=\n",
    "            MIN_NUCLEI_PER_DONOR\n",
    "        )\n",
    "\n",
    "\n",
    "        group_rows.append({\n",
    "\n",
    "            \"pseudobulk_group\":\n",
    "                (\n",
    "                    f\"{donor}\"\n",
    "                    f\"__\"\n",
    "                    f\"{cell_type}\"\n",
    "                ),\n",
    "\n",
    "            \"sample_id\":\n",
    "                donor,\n",
    "\n",
    "            \"diagnosis_binary\":\n",
    "                donor_row[\n",
    "                    \"diagnosis_binary\"\n",
    "                ],\n",
    "\n",
    "            \"age\":\n",
    "                float(\n",
    "                    donor_row[\n",
    "                        \"age\"\n",
    "                    ]\n",
    "                ),\n",
    "\n",
    "            \"sex\":\n",
    "                donor_row[\n",
    "                    \"sex\"\n",
    "                ],\n",
    "\n",
    "            \"PMI\":\n",
    "                float(\n",
    "                    donor_row[\n",
    "                        \"PMI\"\n",
    "                    ]\n",
    "                ),\n",
    "\n",
    "            \"canonical_cell_class\":\n",
    "                cell_type,\n",
    "\n",
    "            \"n_nuclei\":\n",
    "                n_nuclei,\n",
    "        })\n",
    "\n",
    "\n",
    "group_meta = pd.DataFrame(\n",
    "    group_rows\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    group_meta\n",
    ") == 44\n",
    "\n",
    "\n",
    "assert (\n",
    "    group_meta[\n",
    "        \"pseudobulk_group\"\n",
    "    ]\n",
    "    .is_unique\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Check every class = 5 PD + 6 controls\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "for cell_type in TARGET_CLASSES:\n",
    "\n",
    "    class_meta = (\n",
    "\n",
    "        group_meta[\n",
    "            group_meta[\n",
    "                \"canonical_cell_class\"\n",
    "            ]\n",
    "            ==\n",
    "            cell_type\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        class_meta\n",
    "    ) == 11\n",
    "\n",
    "\n",
    "    assert (\n",
    "        class_meta[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        .value_counts()\n",
    "        .to_dict()\n",
    "        ==\n",
    "        {\n",
    "            \"Control\": 6,\n",
    "            \"PD\": 5,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 12. ASSIGN EACH TARGET CELL TO ONE GROUP\n",
    "# ============================================================\n",
    "\n",
    "group_to_code = {\n",
    "\n",
    "    group:\n",
    "        index\n",
    "\n",
    "    for index, group\n",
    "    in enumerate(\n",
    "        group_meta[\n",
    "            \"pseudobulk_group\"\n",
    "        ]\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "target_cells[\n",
    "    \"pseudobulk_group\"\n",
    "] = (\n",
    "\n",
    "    target_cells[\n",
    "        \"sample_id\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "\n",
    "    +\n",
    "\n",
    "    \"__\"\n",
    "\n",
    "    +\n",
    "\n",
    "    target_cells[\n",
    "        \"canonical_cell_class\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "target_group_codes = (\n",
    "\n",
    "    target_cells[\n",
    "        \"pseudobulk_group\"\n",
    "    ]\n",
    "    .map(\n",
    "        group_to_code\n",
    "    )\n",
    "    .to_numpy(\n",
    "        dtype=np.int64\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    target_group_codes\n",
    "    >=\n",
    "    0\n",
    ").all()\n",
    "\n",
    "\n",
    "observed_group_nuclei = np.bincount(\n",
    "\n",
    "    target_group_codes,\n",
    "\n",
    "    minlength=44,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "expected_group_nuclei = (\n",
    "\n",
    "    group_meta[\n",
    "        \"n_nuclei\"\n",
    "    ]\n",
    "    .to_numpy(\n",
    "        dtype=np.int64\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert np.array_equal(\n",
    "\n",
    "    observed_group_nuclei,\n",
    "\n",
    "    expected_group_nuclei,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Every target nucleus assigned exactly once: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 13. STREAM 2.2-GB UMI MATRIX → PSEUDOBULK\n",
    "#\n",
    "# UMI layout:\n",
    "#\n",
    "#   header:\n",
    "#       41,435 barcodes\n",
    "#\n",
    "#   rows:\n",
    "#       26,737 genes\n",
    "#\n",
    "# We parse one gene row at a time.\n",
    "# ============================================================\n",
    "\n",
    "N_GROUPS = 44\n",
    "\n",
    "\n",
    "pseudobulk = np.zeros(\n",
    "\n",
    "    (\n",
    "        N_GENES,\n",
    "        N_GROUPS,\n",
    "    ),\n",
    "\n",
    "    dtype=np.int64,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "total_target_input_umis = 0\n",
    "\n",
    "total_pseudobulk_output_umis = 0\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STREAMING UMI MATRIX → DONOR PSEUDOBULK\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "with open(\n",
    "    umi_path,\n",
    "    \"rt\",\n",
    "    encoding=\"utf-8\",\n",
    "    errors=\"strict\",\n",
    "    buffering=1024 * 1024\n",
    ") as f:\n",
    "\n",
    "\n",
    "    header = (\n",
    "\n",
    "        f.readline()\n",
    "        .rstrip(\n",
    "            \"\\r\\n\"\n",
    "        )\n",
    "        .split(\n",
    "            \"\\t\"\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        header\n",
    "        ==\n",
    "        author_barcodes\n",
    "    )\n",
    "\n",
    "\n",
    "    gene_row_counter = 0\n",
    "\n",
    "\n",
    "    for gene_row_counter, line in enumerate(\n",
    "        f,\n",
    "        start=1\n",
    "    ):\n",
    "\n",
    "\n",
    "        values = np.fromstring(\n",
    "\n",
    "            line.rstrip(\n",
    "                \"\\r\\n\"\n",
    "            ),\n",
    "\n",
    "            sep=\"\\t\",\n",
    "\n",
    "            dtype=np.int64,\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        assert values.size == 41435, (\n",
    "            f\"Gene row {gene_row_counter}: \"\n",
    "            f\"expected 41,435 counts; \"\n",
    "            f\"found {values.size:,}\"\n",
    "        )\n",
    "\n",
    "\n",
    "        assert (\n",
    "            values >= 0\n",
    "        ).all()\n",
    "\n",
    "\n",
    "        target_values = (\n",
    "            values[\n",
    "                target_indices\n",
    "            ]\n",
    "        )\n",
    "\n",
    "\n",
    "        # ----------------------------------------------------\n",
    "        # Fast group aggregation.\n",
    "        #\n",
    "        # np.bincount(weights=...) returns float64, but these\n",
    "        # integer pseudobulk sums are far below exact-integer\n",
    "        # limits for float64. We explicitly verify integerness.\n",
    "        # ----------------------------------------------------\n",
    "\n",
    "        aggregated_float = np.bincount(\n",
    "\n",
    "            target_group_codes,\n",
    "\n",
    "            weights=\n",
    "                target_values,\n",
    "\n",
    "            minlength=\n",
    "                N_GROUPS,\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        assert np.all(\n",
    "\n",
    "            aggregated_float\n",
    "            ==\n",
    "            np.floor(\n",
    "                aggregated_float\n",
    "            )\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        aggregated = (\n",
    "            aggregated_float\n",
    "            .astype(\n",
    "                np.int64\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "        input_sum = int(\n",
    "            target_values.sum(\n",
    "                dtype=np.int64\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "        output_sum = int(\n",
    "            aggregated.sum(\n",
    "                dtype=np.int64\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "        assert (\n",
    "            input_sum\n",
    "            ==\n",
    "            output_sum\n",
    "        ), (\n",
    "            f\"UMI conservation failure \"\n",
    "            f\"at gene row {gene_row_counter}\"\n",
    "        )\n",
    "\n",
    "\n",
    "        pseudobulk[\n",
    "            gene_row_counter - 1,\n",
    "            :\n",
    "        ] = aggregated\n",
    "\n",
    "\n",
    "        total_target_input_umis += (\n",
    "            input_sum\n",
    "        )\n",
    "\n",
    "\n",
    "        total_pseudobulk_output_umis += (\n",
    "            output_sum\n",
    "        )\n",
    "\n",
    "\n",
    "        if (\n",
    "            gene_row_counter\n",
    "            % 2500\n",
    "            ==\n",
    "            0\n",
    "        ):\n",
    "\n",
    "            print(\n",
    "                \"Processed genes:\",\n",
    "                f\"{gene_row_counter:,}\",\n",
    "                \"/\",\n",
    "                f\"{N_GENES:,}\"\n",
    "            )\n",
    "\n",
    "\n",
    "assert gene_row_counter == N_GENES\n",
    "\n",
    "\n",
    "assert (\n",
    "    total_target_input_umis\n",
    "    ==\n",
    "    total_pseudobulk_output_umis\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFull target-cell UMI conservation: PASS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Input target UMIs:\",\n",
    "    f\"{total_target_input_umis:,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Output pseudobulk UMIs:\",\n",
    "    f\"{total_pseudobulk_output_umis:,}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 14. BUILD / SAVE RAW PSEUDOBULK TABLE\n",
    "# ============================================================\n",
    "\n",
    "pb = pd.DataFrame(\n",
    "\n",
    "    pseudobulk,\n",
    "\n",
    "    index=pd.Index(\n",
    "        gene_ids,\n",
    "        name=\"gene_id\"\n",
    "    ),\n",
    "\n",
    "    columns=\n",
    "        group_meta[\n",
    "            \"pseudobulk_group\"\n",
    "        ].tolist(),\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert pb.shape == (\n",
    "    26737,\n",
    "    44\n",
    ")\n",
    "\n",
    "\n",
    "assert pb.index.is_unique\n",
    "\n",
    "\n",
    "assert (\n",
    "    pb.to_numpy(\n",
    "        dtype=np.int64\n",
    "    )\n",
    "    >=\n",
    "    0\n",
    ").all()\n",
    "\n",
    "\n",
    "pb.to_csv(\n",
    "\n",
    "    pseudobulk_path,\n",
    "\n",
    "    compression={\n",
    "        \"method\":\n",
    "            \"gzip\",\n",
    "\n",
    "        \"compresslevel\":\n",
    "            6,\n",
    "    }\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "group_meta.to_csv(\n",
    "    group_metadata_path,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "pseudobulk_sha256 = (\n",
    "    sha256_file(\n",
    "        pseudobulk_path\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nRaw pseudobulk saved:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    pseudobulk_path\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"SHA256:\",\n",
    "    pseudobulk_sha256\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 15. SAVE PSEUDOBULK BUILD LOCK\n",
    "# ============================================================\n",
    "\n",
    "PSEUDOBULK_LOCK = {\n",
    "\n",
    "    \"dataset\":\n",
    "        \"GSE157783\",\n",
    "\n",
    "    \"created_utc\":\n",
    "        datetime.now(\n",
    "            timezone.utc\n",
    "        ).isoformat(),\n",
    "\n",
    "    \"status\":\n",
    "        \"REPLICATION_PSEUDOBULK_BUILT\",\n",
    "\n",
    "    \"source_UMI_orientation\":\n",
    "        \"genes_by_cells\",\n",
    "\n",
    "    \"input_genes\":\n",
    "        26737,\n",
    "\n",
    "    \"input_cells\":\n",
    "        41435,\n",
    "\n",
    "    \"target_cells\":\n",
    "        int(\n",
    "            N_TARGET_CELLS\n",
    "        ),\n",
    "\n",
    "    \"target_cell_classes\":\n",
    "        TARGET_CLASSES,\n",
    "\n",
    "    \"minimum_nuclei_per_donor\":\n",
    "        50,\n",
    "\n",
    "    \"pseudobulk_groups\":\n",
    "        44,\n",
    "\n",
    "    \"n_donors\":\n",
    "        11,\n",
    "\n",
    "    \"n_PD\":\n",
    "        5,\n",
    "\n",
    "    \"n_Control\":\n",
    "        6,\n",
    "\n",
    "    \"every_target_cell_assigned_exactly_once\":\n",
    "        True,\n",
    "\n",
    "    \"UMI_conservation\":\n",
    "        True,\n",
    "\n",
    "    \"total_target_input_UMIs\":\n",
    "        int(\n",
    "            total_target_input_umis\n",
    "        ),\n",
    "\n",
    "    \"total_pseudobulk_output_UMIs\":\n",
    "        int(\n",
    "            total_pseudobulk_output_umis\n",
    "        ),\n",
    "\n",
    "    \"raw_pseudobulk_file\":\n",
    "        str(\n",
    "            pseudobulk_path\n",
    "        ),\n",
    "\n",
    "    \"raw_pseudobulk_sha256\":\n",
    "        pseudobulk_sha256,\n",
    "\n",
    "    \"group_metadata_file\":\n",
    "        str(\n",
    "            group_metadata_path\n",
    "        ),\n",
    "\n",
    "    \"differential_expression_performed\":\n",
    "        False,\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    pseudobulk_lock_path,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        PSEUDOBULK_LOCK,\n",
    "        f,\n",
    "        indent=2\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 16. DISEASE-BLIND GENE FILTER\n",
    "#\n",
    "# Replication:\n",
    "#\n",
    "#   CPM >= 1 in at least 5 of 11 donors\n",
    "#\n",
    "# because smaller diagnosis group = 5 PD.\n",
    "#\n",
    "# Library-size denominator:\n",
    "#   ALL 26,737 raw genes within donor/cell-class pseudobulk.\n",
    "#\n",
    "# Then remove expression-passing MT- genes.\n",
    "# ============================================================\n",
    "\n",
    "CPM_THRESHOLD = 1.0\n",
    "\n",
    "MIN_DONORS_CPM = 5\n",
    "\n",
    "\n",
    "gene_symbol_lookup = (\n",
    "\n",
    "    processed_annotation\n",
    "    .set_index(\n",
    "        \"gene_id\"\n",
    "    )[\n",
    "        \"gene_symbol\"\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "gene_biotype_lookup = (\n",
    "\n",
    "    processed_annotation\n",
    "    .set_index(\n",
    "        \"gene_id\"\n",
    "    )[\n",
    "        \"gene_biotype\"\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "symbol_unique_lookup = (\n",
    "\n",
    "    processed_annotation\n",
    "    .set_index(\n",
    "        \"gene_id\"\n",
    "    )[\n",
    "        \"gene_symbol_unique_in_replication\"\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "mt_lookup = (\n",
    "\n",
    "    processed_annotation\n",
    "    .set_index(\n",
    "        \"gene_id\"\n",
    "    )[\n",
    "        \"mitochondrial_MT_prefix\"\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "universe_records = {}\n",
    "\n",
    "universe_summary_rows = []\n",
    "\n",
    "\n",
    "def ordered_feature_hash(\n",
    "    feature_ids\n",
    "):\n",
    "\n",
    "    payload = (\n",
    "\n",
    "        \"\\n\".join(\n",
    "            map(\n",
    "                str,\n",
    "                feature_ids\n",
    "            )\n",
    "        )\n",
    "\n",
    "        +\n",
    "\n",
    "        \"\\n\"\n",
    "\n",
    "    ).encode(\n",
    "        \"utf-8\"\n",
    "    )\n",
    "\n",
    "\n",
    "    return hashlib.sha256(\n",
    "        payload\n",
    "    ).hexdigest()\n",
    "\n",
    "\n",
    "for cell_type in TARGET_CLASSES:\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\n\"\n",
    "        +\n",
    "        \"=\" * 72\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        cell_type\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"=\" * 72\n",
    "    )\n",
    "\n",
    "\n",
    "    class_meta = (\n",
    "\n",
    "        group_meta[\n",
    "            group_meta[\n",
    "                \"canonical_cell_class\"\n",
    "            ]\n",
    "            ==\n",
    "            cell_type\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        class_meta\n",
    "    ) == 11\n",
    "\n",
    "\n",
    "    assert (\n",
    "        class_meta[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        .value_counts()\n",
    "        .to_dict()\n",
    "        ==\n",
    "        {\n",
    "            \"Control\": 6,\n",
    "            \"PD\": 5,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    class_columns = (\n",
    "\n",
    "        class_meta[\n",
    "            \"pseudobulk_group\"\n",
    "        ]\n",
    "        .tolist()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    class_counts = (\n",
    "\n",
    "        pb[\n",
    "            class_columns\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    arr = (\n",
    "\n",
    "        class_counts\n",
    "        .to_numpy(\n",
    "            dtype=np.int64,\n",
    "            copy=False\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Library sizes across ALL 26,737 genes.\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    library_sizes = (\n",
    "\n",
    "        arr.sum(\n",
    "            axis=0,\n",
    "            dtype=np.int64\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        library_sizes > 0\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    # Verify against direct pseudobulk values.\n",
    "    class_meta[\n",
    "        \"library_size\"\n",
    "    ] = (\n",
    "        library_sizes\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # CPM\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    cpm = (\n",
    "\n",
    "        arr.astype(\n",
    "            np.float64\n",
    "        )\n",
    "\n",
    "        /\n",
    "\n",
    "        library_sizes[\n",
    "            None,\n",
    "            :\n",
    "        ]\n",
    "\n",
    "        *\n",
    "\n",
    "        1_000_000.0\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert np.isfinite(\n",
    "        cpm\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    n_donors_ge_1cpm = (\n",
    "\n",
    "        (\n",
    "            cpm\n",
    "            >=\n",
    "            CPM_THRESHOLD\n",
    "        )\n",
    "        .sum(\n",
    "            axis=1\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    expression_pass = (\n",
    "\n",
    "        n_donors_ge_1cpm\n",
    "        >=\n",
    "        MIN_DONORS_CPM\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    mt_mask = (\n",
    "\n",
    "        pd.Index(\n",
    "            gene_ids\n",
    "        )\n",
    "        .map(\n",
    "            mt_lookup\n",
    "        )\n",
    "        .to_numpy(\n",
    "            dtype=bool\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    final_mask = (\n",
    "\n",
    "        expression_pass\n",
    "\n",
    "        &\n",
    "\n",
    "        ~mt_mask\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    retained_indices = np.flatnonzero(\n",
    "        final_mask\n",
    "    )\n",
    "\n",
    "\n",
    "    retained_gene_ids = [\n",
    "\n",
    "        gene_ids[\n",
    "            i\n",
    "        ]\n",
    "\n",
    "        for i\n",
    "        in retained_indices\n",
    "\n",    "    ]\n",
    "\n",
    "\n",
    "    retained_symbols = (\n",
    "\n",
    "        pd.Index(\n",
    "            retained_gene_ids\n",
    "        )\n",
    "        .map(\n",
    "            gene_symbol_lookup\n",
    "        )\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_expression_pass = int(\n",
    "        expression_pass.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_mt_expression_pass = int(\n",
    "\n",
    "        (\n",
    "            expression_pass\n",
    "            &\n",
    "            mt_mask\n",
    "        ).sum()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_retained = int(\n",
    "        final_mask.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Expression passing:\",\n",
    "        f\"{n_expression_pass:,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Expression-passing MT- removed:\",\n",
    "        n_mt_expression_pass\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Frozen replication universe:\",\n",
    "        f\"{n_retained:,}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_retained\n",
    "        ==\n",
    "        n_expression_pass\n",
    "        -\n",
    "        n_mt_expression_pass\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 16.1 Universe manifest\n",
    "    # ========================================================\n",
    "\n",
    "    universe_table = pd.DataFrame({\n",
    "\n",
    "        \"original_gene_index\":\n",
    "            retained_indices,\n",
    "\n",
    "        \"replication_universe_index\":\n",
    "            np.arange(\n",
    "                n_retained,\n",
    "                dtype=np.int64\n",
    "            ),\n",
    "\n",
    "        \"gene_id\":\n",
    "            retained_gene_ids,\n",
    "\n",
    "        \"gene_symbol\":\n",
    "            retained_symbols,\n",
    "\n",
    "        \"gene_biotype\":\n",
    "            pd.Index(\n",
    "                retained_gene_ids\n",
    "            )\n",
    "            .map(\n",
    "                gene_biotype_lookup\n",
    "            )\n",
    "            .tolist(),\n",
    "\n",
    "        \"gene_symbol_unique_in_replication\":\n",
    "            pd.Index(\n",
    "                retained_gene_ids\n",
    "            )\n",
    "            .map(\n",
    "                symbol_unique_lookup\n",
    "            )\n",
    "            .astype(bool)\n",
    "            .tolist(),\n",
    "\n",
    "        \"n_donors_CPM_ge_1\":\n",
    "            n_donors_ge_1cpm[\n",
    "                retained_indices\n",
    "            ].astype(\n",
    "                np.int64\n",
    "            ),\n",
    "\n",
    "    })\n",
    "\n",
    "\n",
    "    assert (\n",
    "        universe_table[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .is_unique\n",
    "    )\n",
    "\n",
    "\n",
    "    assert not (\n",
    "\n",
    "        universe_table[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .str.upper()\n",
    "        .str.startswith(\n",
    "            \"MT-\"\n",
    "        )\n",
    "        .any()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    universe_path = (\n",
    "\n",
    "        UNIVERSES /\n",
    "        (\n",
    "            f\"GSE157783_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"REPLICATION_GENE_UNIVERSE_v1.csv.gz\"\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    universe_table.to_csv(\n",
    "\n",
    "        universe_path,\n",
    "\n",
    "        index=False,\n",
    "\n",
    "        compression={\n",
    "            \"method\":\n",
    "                \"gzip\",\n",
    "\n",
    "            \"compresslevel\":\n",
    "                6,\n",
    "        }\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 16.2 Frozen raw count matrix\n",
    "    # ========================================================\n",
    "\n",
    "    filtered_counts = (\n",
    "\n",
    "        class_counts\n",
    "        .iloc[\n",
    "            retained_indices,\n",
    "            :\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        filtered_counts\n",
    "        .index\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "        ==\n",
    "        retained_gene_ids\n",
    "    )\n",
    "\n",
    "\n",
    "    counts_output_path = (\n",
    "\n",
    "        UNIVERSES /\n",
    "        (\n",
    "            f\"GSE157783_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"RAW_COUNTS_FROZEN_v1.csv.gz\"\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    filtered_counts.to_csv(\n",
    "\n",
    "        counts_output_path,\n",
    "\n",
    "        compression={\n",
    "            \"method\":\n",
    "                \"gzip\",\n",
    "\n",
    "            \"compresslevel\":\n",
    "                6,\n",
    "        }\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 16.3 Exact donor metadata\n",
    "    # ========================================================\n",
    "\n",
    "    donor_output_path = (\n",
    "\n",
    "        MANIFESTS /\n",
    "        (\n",
    "            f\"GSE157783_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"REPLICATION_DONORS_v1.csv\"\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    class_meta[\n",
    "        [\n",
    "            \"pseudobulk_group\",\n",
    "            \"sample_id\",\n",
    "            \"diagnosis_binary\",\n",
    "            \"age\",\n",
    "            \"sex\",\n",
    "            \"PMI\",\n",
    "            \"n_nuclei\",\n",
    "            \"library_size\",\n",
    "        ]\n",
    "    ].to_csv(\n",
    "        donor_output_path,\n",
    "        index=False\n",
    "    )\n",
    "\n",
    "\n",
    "    universe_hash = (\n",
    "        ordered_feature_hash(\n",
    "            retained_gene_ids\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    n_unique_symbol_features = int(\n",
    "\n",
    "        universe_table[\n",
    "            \"gene_symbol_unique_in_replication\"\n",
    "        ]\n",
    "        .sum()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    universe_records[\n",
    "        cell_type\n",
    "    ] = {\n",
    "\n",
    "        \"minimum_nuclei_per_donor\":\n",
    "            50,\n",
    "\n",
    "        \"n_PD\":\n",
    "            5,\n",
    "\n",
    "        \"n_Control\":\n",
    "            6,\n",
    "\n",
    "        \"n_total_donors\":\n",
    "            11,\n",
    "\n",
    "        \"CPM_threshold\":\n",
    "            1.0,\n",
    "\n",
    "        \"minimum_donors_CPM\":\n",
    "            5,\n",
    "\n",
    "        \"input_features\":\n",
    "            26737,\n",
    "\n",
    "        \"features_passing_expression_rule\":\n",
    "            n_expression_pass,\n",
    "\n",
    "        \"expression_passing_MT_removed\":\n",
    "            n_mt_expression_pass,\n",
    "\n",
    "        \"frozen_replication_gene_universe\":\n",
    "            n_retained,\n",
    "\n",
    "        \"features_with_unique_gene_symbol\":\n",
    "            n_unique_symbol_features,\n",
    "\n",
    "        \"feature_identifier\":\n",
    "            \"Ensembl_gene_id\",\n",
    "\n",
    "        \"annotation\":\n",
    "            \"Ensembl_release_93\",\n",
    "\n",
    "        \"ordered_gene_id_sha256\":\n",
    "            universe_hash,\n",
    "\n",
    "        \"gene_universe_file\":\n",
    "            str(\n",
    "                universe_path\n",
    "            ),\n",
    "\n",
    "        \"raw_counts_file\":\n",
    "            str(\n",
    "                counts_output_path\n",
    "            ),\n",
    "\n",
    "        \"donor_metadata_file\":\n",
    "            str(\n",
    "                donor_output_path\n",
    "            ),\n",
    "    }\n",
    "\n",
    "\n",
    "    universe_summary_rows.append({\n",
    "\n",
    "        \"cell_type\":\n",
    "            cell_type,\n",
    "\n",
    "        \"PD\":\n",
    "            5,\n",
    "\n",
    "        \"Control\":\n",
    "            6,\n",
    "\n",
    "        \"min_nuclei\":\n",
    "            50,\n",
    "\n",
    "        \"CPM_min_donors\":\n",
    "            5,\n",
    "\n",
    "        \"expression_pass\":\n",
    "            n_expression_pass,\n",
    "\n",
    "        \"MT_removed\":\n",
    "            n_mt_expression_pass,\n",
    "\n",
    "        \"replication_universe\":\n",
    "            n_retained,\n",
    "\n",
    "        \"unique_symbol_features\":\n",
    "            n_unique_symbol_features,\n",
    "\n",
    "    })\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 17. REPLICATION DESIGN AUDIT\n",
    "# ============================================================\n",
    "\n",
    "design_meta = (\n",
    "\n",
    "    donors[\n",
    "        [\n",
    "            \"sample_id\",\n",
    "            \"diagnosis_binary\",\n",
    "            \"age\",\n",
    "            \"sex\",\n",
    "            \"PMI\",\n",
    "        ]\n",
    "    ]\n",
    "    .copy()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "design_meta[\n",
    "    \"age\"\n",
    "] = pd.to_numeric(\n",
    "    design_meta[\n",
    "        \"age\"\n",
    "    ],\n",
    "    errors=\"raise\"\n",
    ")\n",
    "\n",
    "\n",
    "design_meta[\n",
    "    \"PMI\"\n",
    "] = pd.to_numeric(\n",
    "    design_meta[\n",
    "        \"PMI\"\n",
    "    ],\n",
    "    errors=\"raise\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    design_meta[\n",
    "        [\n",
    "            \"diagnosis_binary\",\n",
    "            \"age\",\n",
    "            \"sex\",\n",
    "            \"PMI\",\n",
    "        ]\n",
    "    ]\n",
    "    .notna()\n",
    "    .all()\n",
    "    .all()\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    set(\n",
    "        design_meta[\n",
    "            \"sex\"\n",
    "        ]\n",
    "    )\n",
    "    ==\n",
    "    {\n",
    "        \"Female\",\n",
    "        \"Male\",\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    set(\n",
    "        design_meta[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "    )\n",
    "    ==\n",
    "    {\n",
    "        \"Control\",\n",
    "        \"PD\",\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "design_meta.to_csv(\n",
    "    design_metadata_path,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"REPLICATION DONOR COVARIATES\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nAge by diagnosis:\"\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "\n",
    "    design_meta\n",
    "    .groupby(\n",
    "        \"diagnosis_binary\"\n",
    "    )[\n",
    "        \"age\"\n",
    "    ]\n",
    "    .agg(\n",
    "        [\n",
    "            \"count\",\n",
    "            \"mean\",\n",
    "            \"std\",\n",
    "            \"min\",\n",
    "            \"max\",\n",
    "        ]\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPMI by diagnosis:\"\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "\n",
    "    design_meta\n",
    "    .groupby(\n",
    "        \"diagnosis_binary\"\n",
    "    )[\n",
    "        \"PMI\"\n",
    "    ]\n",
    "    .agg(\n",
    "        [\n",
    "            \"count\",\n",
    "            \"mean\",\n",
    "            \"std\",\n",
    "            \"min\",\n",
    "            \"max\",\n",
    "        ]\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSex × diagnosis:\"\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "\n",
    "    pd.crosstab(\n",
    "\n",
    "        design_meta[\n",
    "            \"sex\"\n",
    "        ],\n",
    "\n",
    "        design_meta[\n",
    "            \"diagnosis_binary\"\n",
    "        ],\n",
    "\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 18. MANUAL DESIGN MATRICES\n",
    "# ============================================================\n",
    "\n",
    "sex_male = (\n",
    "\n",
    "    design_meta[\n",
    "        \"sex\"\n",
    "    ]\n",
    "    .eq(\n",
    "        \"Male\"\n",
    "    )\n",
    "    .astype(\n",
    "        float\n",
    "    )\n",
    "    .to_numpy()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "diagnosis_pd = (\n",
    "\n",
    "    design_meta[\n",
    "        \"diagnosis_binary\"\n",
    "    ]\n",
    "    .eq(\n",
    "        \"PD\"\n",
    "    )\n",
    "    .astype(\n",
    "        float\n",
    "    )\n",
    "    .to_numpy()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "age = (\n",
    "\n",
    "    design_meta[\n",
    "        \"age\"\n",
    "    ]\n",
    "    .to_numpy(\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "pmi = (\n",
    "\n",
    "    design_meta[\n",
    "        \"PMI\"\n",
    "    ]\n",
    "    .to_numpy(\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "X_primary = np.column_stack(\n",
    "\n",
    "    [\n",
    "        np.ones(\n",
    "            len(\n",
    "                design_meta\n",
    "            )\n",
    "        ),\n",
    "\n",
    "        age,\n",
    "\n",
    "        sex_male,\n",
    "\n",
    "        diagnosis_pd,\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "X_technical = np.column_stack(\n",
    "\n",
    "    [\n",
    "        np.ones(\n",
    "            len(\n",
    "                design_meta\n",
    "            )\n",
    "        ),\n",
    "\n",
    "        age,\n",
    "\n",
    "        sex_male,\n",
    "\n",
    "        pmi,\n",
    "\n",
    "        diagnosis_pd,\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "primary_rank = int(\n",
    "    np.linalg.matrix_rank(\n",
    "        X_primary\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "technical_rank = int(\n",
    "    np.linalg.matrix_rank(\n",
    "        X_technical\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert primary_rank == 4\n",
    "\n",
    "assert technical_rank == 5\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 19. STANDARDIZED CONDITION NUMBERS\n",
    "#\n",
    "# Continuous variables standardized only for this diagnostic.\n",
    "# Actual DE retains original scales.\n",
    "# ============================================================\n",
    "\n",
    "def zscore(\n",
    "    x\n",
    "):\n",
    "\n",
    "    x = np.asarray(\n",
    "        x,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "\n",
    "    sd = x.std(\n",
    "        ddof=0\n",
    "    )\n",
    "\n",
    "\n",
    "    assert sd > 0\n",
    "\n",
    "\n",
    "    return (\n",
    "        x\n",
    "        -\n",
    "        x.mean()\n",
    "    ) / sd\n",
    "\n",
    "\n",
    "X_primary_std = np.column_stack(\n",
    "\n",
    "    [\n",
    "        np.ones(\n",
    "            len(\n",
    "                design_meta\n",
    "            )\n",
    "        ),\n",
    "\n",
    "        zscore(\n",
    "            age\n",
    "        ),\n",
    "\n",
    "        sex_male,\n",
    "\n",
    "        diagnosis_pd,\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "X_technical_std = np.column_stack(\n",
    "\n",
    "    [\n",
    "        np.ones(\n",
    "            len(\n",
    "                design_meta\n",
    "            )\n",
    "        ),\n",
    "\n",
    "        zscore(\n",
    "            age\n",
    "        ),\n",
    "\n",
    "        sex_male,\n",
    "\n",
    "        zscore(\n",
    "            pmi\n",
    "        ),\n",
    "\n",
    "        diagnosis_pd,\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "primary_condition = float(\n",
    "    np.linalg.cond(\n",
    "        X_primary_std\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "technical_condition = float(\n",
    "    np.linalg.cond(\n",
    "        X_technical_std\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPrimary design:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"~ age + sex + diagnosis_binary\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Rank:\",\n",
    "    primary_rank,\n",
    "    \"/ 4\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Standardized condition number:\",\n",
    "    primary_condition\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nTechnical sensitivity:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"~ age + sex + PMI + diagnosis_binary\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Rank:\",\n",
    "    technical_rank,\n",
    "    \"/ 5\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Standardized condition number:\",\n",
    "    technical_condition\n",
    ")\n",
    "\n",
    "\n",
    "if primary_condition > 30:\n",
    "\n",
    "    print(\n",
    "        \"WARNING: primary design condition number >30\"\n",
    "    )\n",
    "\n",
    "\n",
    "if technical_condition > 30:\n",
    "\n",
    "    print(\n",
    "        \"WARNING: technical design condition number >30\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 20. AGE-OVERLAP AUDIT\n",
    "#\n",
    "# Common observed age support:\n",
    "#\n",
    "#   max(group minima) ... min(group maxima)\n",
    "#\n",
    "# We do NOT automatically create an overlap sensitivity.\n",
    "# ============================================================\n",
    "\n",
    "pd_ages = (\n",
    "\n",
    "    design_meta.loc[\n",
    "        design_meta[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        ==\n",
    "        \"PD\",\n",
    "        \"age\",\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "control_ages = (\n",
    "\n",
    "    design_meta.loc[\n",
    "        design_meta[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        ==\n",
    "        \"Control\",\n",
    "        \"age\",\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "common_age_min = float(\n",
    "\n",
    "    max(\n",
    "        pd_ages.min(),\n",
    "        control_ages.min(),\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "common_age_max = float(\n",
    "\n",
    "    min(\n",
    "        pd_ages.max(),\n",
    "        control_ages.max(),\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "age_overlap = (\n",
    "\n",
    "    design_meta[\n",
    "        design_meta[\n",
    "            \"age\"\n",
    "        ]\n",
    "        .between(\n",
    "            common_age_min,\n",
    "            common_age_max,\n",
    "            inclusive=\"both\"\n",
    "        )\n",
    "    ]\n",
    "    .copy()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "age_overlap_counts = (\n",
    "\n",
    "    age_overlap[\n",
    "        \"diagnosis_binary\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nCommon age support:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    common_age_min,\n",
    "    \"to\",\n",
    "    common_age_max\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Age-overlap diagnosis counts:\",\n",
    "    age_overlap_counts\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 21. FREEZE REPLICATION INFERENCE POLICY\n",
    "# ============================================================\n",
    "\n",
    "REPLICATION_POLICY = {\n",
    "\n",
    "    \"biological_replicate\":\n",
    "        \"human donor\",\n",
    "\n",
    "    \"primary_cell_classes\": [\n",
    "        \"Astro\",\n",
    "        \"Micro\",\n",
    "        \"OPC\",\n",
    "        \"Oligo\",\n",
    "    ],\n",
    "\n",
    "    \"minimum_nuclei_per_donor\":\n",
    "        50,\n",
    "\n",
    "    \"donors_per_cell_class\": {\n",
    "\n",
    "        \"PD\":\n",
    "            5,\n",
    "\n",
    "        \"Control\":\n",
    "            6,\n",
    "\n",
    "        \"total\":\n",
    "            11,\n",
    "    },\n",
    "\n",
    "    \"primary_model\":\n",
    "        \"~ age + sex + diagnosis_binary\",\n",
    "\n",
    "    \"primary_reference_levels\": {\n",
    "\n",
    "        \"diagnosis_binary\":\n",
    "            \"Control\",\n",
    "\n",
    "        \"sex\":\n",
    "            \"Female\",\n",
    "    },\n",
    "\n",
    "    \"primary_contrast\":\n",
    "        \"PD_vs_Control\",\n",
    "\n",
    "    \"technical_sensitivity_model\":\n",
    "        \"~ age + sex + PMI + diagnosis_binary\",\n",
    "\n",
    "    \"technical_sensitivity_reason\":\n",
    "        (\n",
    "            \"PMI is available and differs across donors; \"\n",
    "            \"used as sensitivity rather than primary adjustment \"\n",
    "            \"because replication cohort has only 11 donors.\"\n",
    "        ),\n",
    "\n",
    "    \"RIN_adjustment\":\n",
    "        False,\n",
    "\n",
    "    \"RIN_reason\":\n",
    "        \"RIN is not provided in frozen GSE157783 GEO metadata.\",\n",
    "\n",
    "    \"age_overlap_sensitivity\":\n",
    "        False,\n",
    "\n",
    "    \"age_overlap_reason\": (\n",
    "        f\"Common age support is \"\n",
    "        f\"{common_age_min:g}-{common_age_max:g} years, \"\n",
    "        f\"but restriction would leave only \"\n",
    "        f\"{age_overlap_counts.get('Control', 0)} controls and \"\n",
    "        f\"{age_overlap_counts.get('PD', 0)} PD donors; \"\n",
    "        \"therefore no reduced-cohort age sensitivity is \"\n",
    "        \"predeclared for this small replication cohort.\"\n",
    "    ),\n",
    "\n",
    "    \"gene_filtering\": (\n",
    "        \"CPM >= 1 in at least 5 of 11 donors \"\n",
    "        \"within each cell class\"\n",
    "    ),\n",
    "\n",
    "    \"CPM_denominator\":\n",
    "        (\n",
    "            \"total raw pseudobulk UMI count across all \"\n",
    "            \"26,737 original processed features for that \"\n",
    "            \"donor/cell-class pseudobulk\"\n",
    "        ),\n",
    "\n",
    "    \"gene_filter_is_disease_blind\":\n",
    "        True,\n",
    "\n",
    "    \"mitochondrial_policy\":\n",
    "        (\n",
    "            \"remove expression-passing features whose \"\n",    "            \"Ensembl-93 gene symbol begins MT-\"\n",
    "        ),\n",
    "\n",
    "    \"gene_identifier_for_DE\":\n",
    "        \"Ensembl_gene_id\",\n",
    "\n",
    "    \"gene_annotation\":\n",
    "        \"Ensembl_release_93\",\n",
    "\n",
    "    \"gene_symbol_mapping_policy\": (\n",
    "        \"Preserve Ensembl IDs through replication DE. \"\n",
    "        \"For later direct discovery-replication gene matching, \"\n",
    "        \"use only unambiguous gene-symbol mappings; duplicated \"\n",
    "        \"replication symbols are not selected based on disease results.\"\n",
    "    ),\n",
    "\n",
    "    \"DE_engine\":\n",
    "        \"PyDESeq2_0.5.4\",\n",
    "\n",
    "    \"DE_method\":\n",
    "        \"negative_binomial_Wald\",\n",
    "\n",
    "    \"multiple_testing\":\n",
    "        \"Benjamini-Hochberg within each cell class\",\n",
    "\n",
    "    \"FDR_threshold\":\n",
    "        0.05,\n",
    "\n",
    "    \"all_tested_genes_retained\":\n",
    "        True,\n",
    "\n",
    "    \"primary_replication_inference\": [\n",
    "        \"all-gene log2FC concordance\",\n",
    "        \"all-gene Wald-rank concordance\",\n",
    "        \"directional concordance of frozen discovery FDR genes\",\n",
    "        \"same-direction replication nominal p<0.05 for prespecified discovery hits\",\n",
    "    ],\n",
    "\n",
