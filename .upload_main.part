    "    parents=True,\n",
    "    exist_ok=True\n",
    ")\n",
    "\n",
    "\n",
    "pre_de_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE174367_AD_DISCOVERY_PRE_DE_LOCK_v1.json\"\n",
    ")\n",
    "\n",
    "data_audit_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE174367_AD_DISCOVERY_DATA_AUDIT_v1.json\"\n",
    ")\n",
    "\n",
    "dataset_role_lock_path = (\n",
    "    LOCKS /\n",
    "    \"AD_BRAIN_DATASET_ROLES_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "de_run_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE174367_PRIMARY_AD_DISCOVERY_DE_RUN_v1.json\"\n",
    ")\n",
    "\n",
    "effect_freeze_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE174367_AD_DISCOVERY_EFFECT_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "combined_summary_path = (\n",
    "    DE_ROOT /\n",
    "    \"GSE174367_PRIMARY_AD_DISCOVERY_DE_SUMMARY_v1.csv\"\n",
    ")\n",
    "\n",
    "combined_effect_path = (\n",
    "    FREEZE_ROOT /\n",
    "    \"GSE174367_AD_DISCOVERY_ALL_EFFECTS_LONG_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "combined_fdr_path = (\n",
    "    FREEZE_ROOT /\n",
    "    \"GSE174367_AD_DISCOVERY_FDR05_HITS_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "\n",
    "    pre_de_lock_path,\n",
    "    data_audit_lock_path,\n",
    "    dataset_role_lock_path,\n",
    "\n",
    "]:\n",
    "\n",
    "    assert path.exists(), (\n",
    "        f\"Missing required lock: {path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# C. VERIFY FROZEN PRE-DE STATE\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    pre_de_lock_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    pre_de_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    data_audit_lock_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    data_audit = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    dataset_role_lock_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    role_lock = json.load(f)\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre_de_lock[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"AD_DISCOVERY_PRE_DE_LOCK\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre_de_lock[\n",
    "        \"differential_expression_performed\"\n",
