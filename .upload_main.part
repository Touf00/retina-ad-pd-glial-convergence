   "source": [
    "# Source analysis cell: 17\n",
    "# ============================================================\n",
    "# STEP 9 — STREAMED DONOR × CELL-TYPE PSEUDOBULK\n",
    "#\n",
    "# Input:\n",
    "#   genes × 83,484 nuclei raw integer counts\n",
    "#\n",
    "# Output:\n",
    "#   genes × donor/cell-type raw integer counts\n",
    "#\n",
    "# Critical safeguards:\n",
    "#   - exact cell-order alignment\n",
    "#   - reversible matrix-ID canonicalization\n",
    "#   - every nucleus assigned exactly once\n",
    "#   - UMI conservation checked for EVERY chunk\n",
    "#   - full-matrix UMI conservation checked\n",
    "#\n",
    "# NO PD-vs-control differential expression yet.\n",
    "# ============================================================\n",
    "\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from scipy import sparse\n",
    "import json\n",
    "import re\n",
    "import hashlib\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "PD_DIR = (\n",
    "    ROOT /\n",
    "    \"GSE243639_PD_discovery\"\n",
    ")\n",
    "\n",
    "RESULTS = ROOT / \"results\"\n",
    "LOCKS = ROOT / \"locks\"\n",
    "MANIFESTS = ROOT / \"manifests\"\n",
    "\n",
    "RESULTS.mkdir(exist_ok=True)\n",
    "LOCKS.mkdir(exist_ok=True)\n",
    "MANIFESTS.mkdir(exist_ok=True)\n",
    "\n",
    "count_path = (\n",
    "    PD_DIR /\n",
    "    \"GSE243639_Filtered_count_table.csv.gz\"\n",
    ")\n",
    "\n",
    "umap_path = (\n",
    "    PD_DIR /\n",
    "    \"GSE243639_UMAP_coordinates.xlsx\"\n",
    ")\n",
    "\n",
    "donor_path = (\n",
    "    MANIFESTS /\n",
    "    \"GSE243639_donor_metadata_FROZEN_v1.csv\"\n",
    ")\n",
    "\n",
    "plan_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_PD_CELL_ANALYSIS_PLAN_v1.json\"\n",
    ")\n",
    "\n",
    "matrix_audit_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_COUNT_MATRIX_AUDIT_v1.json\"\n",
    ")\n",
    "\n",
    "output_path = (\n",
    "    RESULTS /\n",
    "    \"GSE243639_donor_celltype_pseudobulk_RAW_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "group_metadata_path = (\n",
    "    MANIFESTS /\n",
    "    \"GSE243639_pseudobulk_group_metadata_v1.csv\"\n",
    ")\n",
    "\n",
    "audit_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_PSEUDOBULK_BUILD_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "    count_path,\n",
    "    umap_path,\n",
    "    donor_path,\n",
    "    plan_path,\n",
    "    matrix_audit_path,\n",
    "]:\n",
    "    assert path.exists(), f\"Missing required file: {path}\"\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. LOAD FROZEN ANALYSIS PLAN\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    plan_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    PD_PLAN = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    matrix_audit_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    MATRIX_AUDIT = json.load(f)\n",
    "\n",
    "\n",
    "assert (\n",
    "    MATRIX_AUDIT[\n",
    "        \"exact_cell_identity_after_canonicalization\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "assert (\n",
    "    MATRIX_AUDIT[\"n_cell_columns\"]\n",
    "    ==\n",
    "    83484\n",
    ")\n",
    "\n",
    "print(\"Frozen PD analysis plan loaded.\")\n",
    "print(\"Count-matrix identity lock loaded.\")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. LOAD DONOR METADATA\n",
    "# ============================================================\n",
    "\n",
    "donors = pd.read_csv(\n",
    "    donor_path\n",
    ")\n",
    "\n",
    "donors[\"donor_id\"] = (\n",
    "    donors[\"donor_id\"]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "assert len(donors) == 29\n",
    "assert donors[\"donor_id\"].nunique() == 29\n",
    "\n",
    "assert (\n",
    "    donors[\"diagnosis_binary\"]\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    "    ==\n",
    "    {\n",
    "        \"PD\": 15,\n",
    "        \"Control\": 14\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. LOAD AUTHOR HIGH-LEVEL CELL ANNOTATIONS\n",
    "# ============================================================\n",
    "\n",
    "cells = pd.read_excel(\n",
    "    umap_path,\n",
    "    sheet_name=\"HighLevelCellTypes\",\n",
    "    usecols=[\n",
    "        \"CELL_ID\",\n",
    "        \"IDENT\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "cells[\"CELL_ID\"] = (\n",
    "    cells[\"CELL_ID\"]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "cells[\"IDENT\"] = (\n",
    "    cells[\"IDENT\"]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "assert len(cells) == 83484\n",
    "assert cells[\"CELL_ID\"].is_unique\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# donor extraction\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "cells[\"donor_id\"] = (\n",
    "    cells[\"CELL_ID\"]\n",
    "    .str.split(\n",
    "        \"_\",\n",
    "        n=1\n",
    "    )\n",
    "    .str[0]\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    set(cells[\"donor_id\"])\n",
    "    ==\n",
    "    set(donors[\"donor_id\"])\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. BUILD PSEUDOBULK GROUP IDENTIFIERS\n",
    "# ============================================================\n",
    "\n",
    "# Keep all author high-level classes during aggregation.\n",
    "#\n",
    "# T cells remain in the raw pseudobulk object so that\n",
    "# total-count conservation is exact.\n",
    "#\n",
    "# Their presence here DOES NOT mean they will be analyzed.\n",
    "\n",
    "cells[\"pseudobulk_group\"] = (\n",
    "    cells[\"donor_id\"]\n",
    "    +\n",
    "    \"__\"\n",
    "    +\n",
    "    cells[\"IDENT\"]\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. READ RAW MATRIX HEADER\n",
    "# ============================================================\n",
    "\n",
    "header = pd.read_csv(\n",
    "    count_path,\n",
    "    compression=\"gzip\",\n",
    "    nrows=0\n",
    ")\n",
    "\n",
    "gene_column = (\n",
    "    header.columns[0]\n",
    ")\n",
    "\n",
    "cell_columns_raw = (\n",
    "    list(\n",
    "        header.columns[1:]\n",
    "    )\n",
    ")\n",
    "\n",
    "assert len(cell_columns_raw) == 83484\n",
    "\n",
    "assert len(\n",
    "    set(cell_columns_raw)\n",
    ") == 83484\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. CANONICALIZE MATRIX CELL IDS\n",
    "# ============================================================\n",
    "\n",
    "def canonicalize_matrix_cell_id(x):\n",
    "\n",
    "    x = str(x).strip()\n",
    "\n",
    "    return re.sub(\n",
    "        r\"\\.(\\d+)$\",\n",
    "        r\"-\\1\",\n",
    "        x\n",
    "    )\n",
    "\n",
    "\n",
    "cell_columns_canonical = [\n",
    "    canonicalize_matrix_cell_id(x)\n",
    "    for x in cell_columns_raw\n",
    "]\n",
    "\n",
    "\n",
    "assert len(\n",
    "    set(cell_columns_canonical)\n",
    ") == 83484\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. EXACT ALIGNMENT TO MATRIX COLUMN ORDER\n",
    "# ============================================================\n",
    "\n",
    "cell_lookup = (\n",
    "    cells\n",
    "    .set_index(\"CELL_ID\")\n",
    ")\n",
    "\n",
    "missing = (\n",
    "    set(cell_columns_canonical)\n",
    "    -\n",
    "    set(cell_lookup.index)\n",
    ")\n",
    "\n",
    "assert not missing, (\n",
    "    f\"{len(missing)} matrix cells \"\n",
    "    \"lack annotation.\"\n",
    ")\n",
    "\n",
    "\n",
    "aligned = (\n",
    "    cell_lookup\n",
    "    .loc[\n",
    "        cell_columns_canonical\n",
    "    ]\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    aligned.index.tolist()\n",
    "    ==\n",
    "    cell_columns_canonical\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\nExact matrix/annotation alignment confirmed.\")\n",
    "\n",
    "print(\n",
    "    \"Cells:\",\n",
    "    f\"{len(aligned):,}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. BUILD GROUP METADATA\n",
    "# ============================================================\n",
    "\n",
    "group_metadata = (\n",
    "    aligned\n",
    "    .reset_index()\n",
    "    .groupby(\n",
    "        [\n",
    "            \"pseudobulk_group\",\n",
    "            \"donor_id\",\n",
    "            \"IDENT\"\n",
    "        ],\n",
    "        observed=True\n",
    "    )\n",
    "    .size()\n",
    "    .reset_index(\n",
    "        name=\"n_nuclei\"\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "group_metadata = (\n",
    "    group_metadata\n",
    "    .merge(\n",
    "        donors[\n",
    "            [\n",
    "                \"donor_id\",\n",
    "                \"diagnosis_binary\",\n",
    "                \"age\",\n",
    "                \"sex\",\n",
    "                \"PMI\",\n",
    "                \"RIN\"\n",
    "            ]\n",
    "        ],\n",
    "        on=\"donor_id\",\n",
    "        how=\"left\",\n",
    "        validate=\"many_to_one\"\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    group_metadata[\n",
    "        \"diagnosis_binary\"\n",
    "    ]\n",
    "    .notna()\n",
    "    .all()\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. DEFINE FIXED OUTPUT GROUP ORDER\n",
    "# ============================================================\n",
    "\n",
    "groups = sorted(\n",
    "    group_metadata[\n",
    "        \"pseudobulk_group\"\n",
    "    ]\n",
    "    .unique()\n",
    ")\n",
    "\n",
    "group_to_index = {\n",
    "    group: i\n",
    "    for i, group\n",
    "    in enumerate(groups)\n",
    "}\n",
    "\n",
    "\n",
    "aligned_group_index = (\n",
    "    aligned[\n",
    "        \"pseudobulk_group\"\n",
    "    ]\n",
    "    .map(\n",
    "        group_to_index\n",
    "    )\n",
    "    .to_numpy()\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    pd.notna(\n",
    "        aligned_group_index\n",
    "    )\n",
    "    .all()\n",
    ")\n",
    "\n",
    "\n",
    "n_cells = len(aligned)\n",
    "\n",
    "n_groups = len(groups)\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Pseudobulk groups:\",\n",
    "    n_groups\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. BUILD SPARSE CELL -> GROUP MEMBERSHIP MATRIX\n",
    "# ============================================================\n",
    "\n",
    "membership = sparse.csr_matrix(\n",
    "    (\n",
    "        np.ones(\n",
    "            n_cells,\n",
    "            dtype=np.int8\n",
    "        ),\n",
    "        (\n",
    "            np.arange(\n",    "                n_cells\n",
    "            ),\n",
    "            aligned_group_index\n",
    "        )\n",
    "    ),\n",
    "    shape=(\n",
    "        n_cells,\n",
    "        n_groups\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert membership.shape == (\n",
    "    83484,\n",
    "    n_groups\n",
    ")\n",
    "\n",
    "assert membership.nnz == 83484\n",
    "\n",
    "\n",
    "# Every cell must map to EXACTLY one group\n",
    "cell_membership_sum = np.asarray(\n",
    "    membership.sum(\n",
    "        axis=1\n",
    "    )\n",
    ").ravel()\n",
    "\n",
    "assert np.all(\n",
    "    cell_membership_sum == 1\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Every nucleus maps to \"\n",
    "    \"exactly one pseudobulk group.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. VERIFY GROUP NUCLEUS COUNTS\n",
    "# ============================================================\n",
    "\n",
    "membership_group_counts = (\n",
    "    np.asarray(\n",
    "        membership.sum(\n",
    "            axis=0\n",
    "        )\n",
    "    )\n",
    "    .ravel()\n",
    "    .astype(int)\n",
    ")\n",
    "\n",
    "\n",
    "expected_group_counts = (\n",
    "    group_metadata\n",
    "    .set_index(\n",
    "        \"pseudobulk_group\"\n",
    "    )\n",
    "    .loc[\n",
    "        groups,\n",
    "        \"n_nuclei\"\n",
    "    ]\n",
    "    .to_numpy(\n",
    "        dtype=int\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert np.array_equal(\n",
    "    membership_group_counts,\n",
    "    expected_group_counts\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Group nucleus counts verified.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 12. STREAM RAW EXPRESSION MATRIX\n",
    "# ============================================================\n",
    "\n",
    "# 50 genes × 83,484 cells is modest enough for Colab\n",
    "# while avoiding ~600 MB+ giant DataFrames.\n",
    "\n",
    "CHUNK_GENES = 50\n",
    "\n",
    "pb_chunks = []\n",
    "gene_names = []\n",
    "\n",
    "n_genes_total = 0\n",
    "\n",
    "total_input_umis = 0\n",
    "total_output_umis = 0\n",
    "\n",
    "\n",
    "reader = pd.read_csv(\n",
    "    count_path,\n",
    "    compression=\"gzip\",\n",
    "    index_col=0,\n",
    "    chunksize=CHUNK_GENES\n",
    ")\n",
    "\n",
    "\n",
    "for chunk_number, chunk in enumerate(\n",
    "    reader,\n",
    "    start=1\n",
    "):\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Matrix column order MUST remain unchanged\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    assert (\n",
    "        chunk.columns.tolist()\n",
    "        ==\n",
    "        cell_columns_raw\n",
    "    ), (\n",
    "        \"Count-matrix column order \"\n",
    "        \"changed during streaming.\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Raw integer count conversion\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    X = chunk.to_numpy(\n",
    "        dtype=np.int64,\n",
    "        copy=False\n",
    "    )\n",
    "\n",
    "\n",
    "    assert np.isfinite(\n",
    "        X\n",
    "    ).all()\n",
    "\n",
    "    assert (\n",
    "        X >= 0\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Aggregate:\n",
    "    #\n",
    "    # groups × cells\n",
    "    #       @\n",
    "    # cells × genes\n",
    "    #\n",
    "    # =\n",
    "    #\n",
    "    # groups × genes\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    PB = (\n",
    "        membership.T\n",
    "        @\n",
    "        X.T\n",
    "    ).T\n",
    "\n",
    "\n",
    "    PB = np.asarray(\n",
    "        PB,\n",
    "        dtype=np.int64\n",
    "    )\n",
    "\n",
    "\n",
    "    assert PB.shape == (\n",
    "        len(chunk),\n",
    "        n_groups\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Exact UMI conservation for this chunk\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    input_umis = int(\n",
    "        X.sum(\n",
    "            dtype=np.int64\n",
    "        )\n",
    "    )\n",
    "\n",
    "    output_umis = int(\n",
    "        PB.sum(\n",
    "            dtype=np.int64\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        input_umis\n",
    "        ==\n",
    "        output_umis\n",
    "    ), (\n",
    "        f\"UMI conservation failed \"\n",
    "        f\"at chunk {chunk_number}: \"\n",
    "        f\"{input_umis} != \"\n",
    "        f\"{output_umis}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    total_input_umis += (\n",
    "        input_umis\n",
    "    )\n",
    "\n",
    "    total_output_umis += (\n",
    "        output_umis\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Store ONLY tiny pseudobulk chunk\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    pb_chunk = pd.DataFrame(\n",
    "        PB,\n",
    "        index=chunk.index.astype(str),\n",
    "        columns=groups\n",
    "    )\n",
    "\n",
    "    pb_chunks.append(\n",
    "        pb_chunk\n",
    "    )\n",
    "\n",
    "    gene_names.extend(\n",
    "        chunk.index.astype(str)\n",
    "    )\n",
    "\n",
    "    n_genes_total += len(\n",
    "        chunk\n",
    "    )\n",
    "\n",
    "\n",
    "    if (\n",
    "        chunk_number == 1\n",
    "        or\n",
    "        chunk_number % 50 == 0\n",
    "    ):\n",
    "\n",
    "        print(\n",
    "            f\"chunk {chunk_number:,}\"\n",
    "            f\" | genes processed: \"\n",
    "            f\"{n_genes_total:,}\"\n",
    "            f\" | UMI conservation: PASS\"\n",
    "        )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 13. FULL-MATRIX CONSERVATION CHECK\n",
    "# ============================================================\n",
    "\n",
    "assert (\n",
    "    total_input_umis\n",
    "    ==\n",
    "    total_output_umis\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"\\nFull-matrix UMI \"\n",
    "    \"conservation: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 14. CONCATENATE SMALL PSEUDOBULK CHUNKS\n",
    "# ============================================================\n",
    "\n",
    "pseudobulk = pd.concat(\n",
    "    pb_chunks,\n",
    "    axis=0\n",
    ")\n",
    "\n",
    "pseudobulk.index.name = (\n",
    "    str(gene_column)\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    pseudobulk\n",
    ") == n_genes_total\n",
    "\n",
    "assert (\n",
    "    pseudobulk.columns.tolist()\n",
    "    ==\n",
    "    groups\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPseudobulk shape:\",\n",
    "    pseudobulk.shape\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 15. GENE-ID AUDIT\n",
    "# ============================================================\n",
    "\n",
    "n_unique_gene_names = (\n",
    "    pseudobulk.index.nunique()\n",
    ")\n",
    "\n",
    "n_duplicate_gene_rows = (\n",
    "    len(pseudobulk)\n",
    "    -\n",
    "    n_unique_gene_names\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Gene rows:\",\n",
    "    f\"{len(pseudobulk):,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Unique gene names:\",\n",
    "    f\"{n_unique_gene_names:,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Duplicate gene rows:\",\n",
    "    f\"{n_duplicate_gene_rows:,}\"\n",
    ")\n",
    "\n",
    "\n",
    "# Do NOT silently collapse duplicates.\n",
    "# We only record them here.\n",
    "# If duplicates exist, they will be resolved explicitly\n",
    "# before the gene-universe lock.\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 16. INTEGER / NONNEGATIVE CHECK\n",
    "# ============================================================\n",
    "\n",
    "pb_array = (\n",
    "    pseudobulk\n",
    "    .to_numpy(\n",
    "        dtype=np.int64,\n",
    "        copy=False\n",
    "    )\n",
    ")\n",
    "\n",
    "assert (\n",
    "    pb_array >= 0\n",
    ").all()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 17. SAVE RAW PSEUDOBULK MATRIX\n",
    "# ============================================================\n",
    "\n",
    "pseudobulk.to_csv(\n",
    "    output_path,\n",
    "    compression=\"gzip\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 18. SAVE PSEUDOBULK GROUP METADATA\n",
    "# ============================================================\n",
    "\n",
    "group_metadata = (\n",
    "    group_metadata\n",
    "    .set_index(\n",
    "        \"pseudobulk_group\"\n",
    "    )\n",
    "    .loc[\n",
    "        groups\n",
    "    ]\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "\n",
    "group_metadata.to_csv(\n",
    "    group_metadata_path,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 19. SHA256 OUTPUT HASH\n",
    "# ============================================================\n",
    "\n",
    "def sha256_file(\n",
    "    path,\n",
    "    block_size=1024 * 1024\n",
    "):\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\"\n",
    "    ) as f:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            block = f.read(\n",
    "                block_size\n",
    "            )\n",
    "\n",
    "            if not block:\n",
    "                break\n",
    "\n",
    "            h.update(block)\n",
    "\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "output_sha256 = (\n",
    "    sha256_file(\n",
    "        output_path\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 20. BUILD / SAVE AUDIT LOCK\n",
    "# ============================================================\n",
    "\n",
    "build_audit = {\n",
    "\n",
    "    \"dataset\":\n",
    "        \"GSE243639\",\n",
    "\n",
    "    \"created_utc\":\n",
    "        datetime.now(\n",
    "            timezone.utc\n",
    "        ).isoformat(),\n",
    "\n",
    "    \"input_file\":\n",
    "        str(count_path),\n",
    "\n",
    "    \"input_orientation\":\n",
    "        \"genes_by_cells\",\n",
    "\n",
    "    \"matrix_cell_id_rule\":\n",
    "        \"terminal .digits -> -digits\",\n",
    "\n",
    "    \"n_input_cells\":\n",
    "        int(n_cells),\n",
    "\n",
    "    \"n_pseudobulk_groups\":\n",
    "        int(n_groups),\n",
    "\n",
    "    \"n_gene_rows\":\n",
    "        int(n_genes_total),\n",
    "\n",
    "    \"n_unique_gene_names\":\n",
    "        int(n_unique_gene_names),\n",
    "\n",
    "    \"n_duplicate_gene_rows\":\n",
    "        int(n_duplicate_gene_rows),\n",
    "\n",
    "    \"total_input_UMIs\":\n",
    "        int(total_input_umis),\n",
    "\n",
    "    \"total_output_UMIs\":\n",
    "        int(total_output_umis),\n",
    "\n",
    "    \"UMI_conservation\":\n",
    "        True,\n",
    "\n",
    "    \"every_cell_assigned_exactly_once\":\n",
    "        True,\n",
    "\n",
    "    \"output_matrix\":\n",
    "        str(output_path),\n",
    "\n",
    "    \"group_metadata\":\n",
    "        str(group_metadata_path),\n",
    "\n",
    "    \"output_sha256\":\n",
    "        output_sha256,\n",
    "\n",
    "    \"differential_expression_performed\":\n",
    "        False\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    audit_path,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        build_audit,\n",
    "        f,\n",
    "        indent=2\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 21. FINAL REPORT\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n========================================\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 9 PASSED\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"========================================\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    json.dumps(\n",
    "        build_audit,\n",
    "        indent=2\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nRaw pseudobulk matrix:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    output_path\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPseudobulk metadata:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    group_metadata_path\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nBuild lock:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    audit_path\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 18\n",
    "# ============================================================\n",
    "# STEP 10A/B — PSEUDOBULK INTEGRITY + DESIGN AUDIT\n",
    "#\n",
    "# PURPOSE:\n",
    "#   1. Verify the final donor-level pseudobulk object.\n",
    "#   2. Verify all four primary classes contain all 29 donors.\n",
    "#   3. Audit covariate completeness and balance.\n",
    "#   4. Prove primary and sensitivity designs are full rank.\n",
    "#   5. Freeze age-overlap sensitivity population.\n",
    "#\n",
    "# NO differential expression.\n",
    "# NO gene-by-gene disease comparison.\n",
    "# NO gene filtering yet.\n",
    "# ============================================================\n",
    "\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import json\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "RESULTS = ROOT / \"results\"\n",
    "MANIFESTS = ROOT / \"manifests\"\n",
    "LOCKS = ROOT / \"locks\"\n",
    "\n",
    "pb_path = (\n",
    "    RESULTS /\n",
    "    \"GSE243639_donor_celltype_pseudobulk_RAW_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "meta_path = (\n",
    "    MANIFESTS /\n",
    "    \"GSE243639_pseudobulk_group_metadata_v1.csv\"\n",
    ")\n",
    "\n",
    "donor_path = (\n",
    "    MANIFESTS /\n",
    "    \"GSE243639_donor_metadata_FROZEN_v1.csv\"\n",
    ")\n",
    "\n",
    "audit_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_DESIGN_AUDIT_v1.json\"\n",
    ")\n",
    "\n",
    "assert pb_path.exists(), pb_path\n",
    "assert meta_path.exists(), meta_path\n",
    "assert donor_path.exists(), donor_path\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. LOAD RAW PSEUDOBULK OBJECT\n",
    "# ============================================================\n",
    "\n",
    "pb = pd.read_csv(\n",
    "    pb_path,\n",
    "    compression=\"gzip\",\n",
    "    index_col=0\n",
    ")\n",
    "\n",
    "group_meta = pd.read_csv(\n",
    "    meta_path\n",
    ")\n",
    "\n",
    "donors = pd.read_csv(\n",
    "    donor_path\n",
    ")\n",
    "\n",
    "\n",
    "print(\"Pseudobulk shape:\", pb.shape)\n",
    "print(\"Group metadata shape:\", group_meta.shape)\n",
    "\n",
    "\n",
    "assert pb.shape == (33537, 200)\n",
    "assert len(group_meta) == 200\n",
    "\n",
    "assert pb.index.is_unique\n",
    "\n",
    "assert group_meta[\n",
    "    \"pseudobulk_group\"\n",
    "].is_unique\n",
    "\n",
    "\n",
    "# Columns and metadata MUST be in identical order\n",
    "assert (\n",
    "    pb.columns.tolist()\n",
    "    ==\n",
    "    group_meta[\n",
    "        \"pseudobulk_group\"\n",
    "    ].tolist()\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. RAW COUNT INTEGRITY\n",
    "# ============================================================\n",
    "\n",
    "X = pb.to_numpy()\n",
    "\n",
    "assert np.isfinite(X).all()\n",
    "assert (X >= 0).all()\n",
    "\n",
    "assert np.allclose(\n",
    "    X,\n",
    "    np.round(X)\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"\\nRaw pseudobulk counts:\"\n",
    "    \" nonnegative integer PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. LIBRARY SIZE AUDIT\n",
    "# ============================================================\n",
    "\n",
    "library_sizes = (\n",
    "    pb.sum(axis=0)\n",
    "    .astype(np.int64)\n",
    ")\n",
    "\n",
    "assert (\n",
    "    library_sizes > 0\n",
    ").all()\n",
    "\n",
    "group_meta[\n",
    "    \"library_size\"\n",
    "] = (\n",
    "    group_meta[\n",
    "        \"pseudobulk_group\"\n",
    "    ]\n",
    "    .map(library_sizes)\n",
    ")\n",
    "\n",
    "assert (\n",
    "    group_meta[\n",
    "        \"library_size\"\n",
    "    ]\n",
    "    .notna()\n",
    "    .all()\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\n========================================\")\n",
    "print(\"LIBRARY SIZE BY CELL CLASS\")\n",
    "print(\"========================================\")\n",
    "\n",
    "library_summary = (\n",
    "    group_meta\n",
    "    .groupby(\"IDENT\")[\n",
    "        \"library_size\"\n",
    "    ]\n",
    "    .describe()\n",
    ")\n",
    "\n",
    "display(library_summary)\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. PRIMARY CELL CLASSES\n",
    "# ============================================================\n",
    "\n",
    "PRIMARY_CLASSES = [\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "]\n",
    "\n",
    "for cell_type in PRIMARY_CLASSES:\n",
    "\n",
    "    m = (\n",
    "        group_meta[\n",
    "            group_meta[\"IDENT\"]\n",
    "            == cell_type\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "    assert len(m) == 29\n",
    "\n",
    "    assert (\n",
    "        m[\"donor_id\"]\n",
    "        .nunique()\n",
    "        ==\n",
    "        29\n",
    "    )\n",
    "\n",
    "    assert (\n",
    "        m[\"diagnosis_binary\"]\n",
    "        .value_counts()\n",
    "        .to_dict()\n",
    "        ==\n",
    "        {\n",
    "            \"PD\": 15,\n",
    "            \"Control\": 14,\n",
    "        }\n",
    "    )\n",
    "\n",
    "    assert (\n",
    "        m[\"n_nuclei\"]\n",
    "        >= 50\n",
    "    ).all()\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nAll four primary cell classes:\"\n",
    "    \" 29/29 donors at >=50 nuclei PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. CREATE ONE-ROW-PER-DONOR DESIGN METADATA\n",
    "#\n",
    "# Use Astro only as carrier because all four primary classes\n",
    "# contain the exact same 29 donors/covariates.\n",
    "# ============================================================\n",
    "\n",
    "design_meta = (\n",
    "    group_meta[\n",
    "        group_meta[\"IDENT\"]\n",
    "        == \"Astro\"\n",
    "    ][\n",
    "        [\n",
    "            \"donor_id\",\n",
    "            \"diagnosis_binary\",\n",
    "            \"age\",\n",
    "            \"sex\",\n",
    "            \"PMI\",\n",
    "            \"RIN\",\n",
    "        ]\n",
    "    ]\n",
    "    .copy()\n",
    "    .sort_values(\"donor_id\")\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "\n",
    "assert len(design_meta) == 29\n",
    "assert design_meta[\"donor_id\"].is_unique\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. COVARIATE COMPLETENESS\n",
    "# ============================================================\n",
    "\n",
    "required = [\n",
    "    \"diagnosis_binary\",\n",
    "    \"age\",\n",
    "    \"sex\",\n",
    "    \"PMI\",\n",
    "    \"RIN\",\n",
    "]\n",
    "\n",
    "missing_counts = (\n",
    "    design_meta[\n",
    "        required\n",
    "    ]\n",
    "    .isna()\n",
    "    .sum()\n",
    ")\n",
    "\n",
    "print(\"\\n========================================\")\n",
    "print(\"MISSING COVARIATES\")\n",
    "print(\"========================================\")\n",
    "\n",
    "print(missing_counts)\n",
    "\n",
    "\n",
    "assert (\n",
    "    missing_counts == 0\n",
    ").all()\n",
    "\n",
    "\n",
    "# exact expected categories\n",
    "assert set(\n",
    "    design_meta[\n",
    "        \"diagnosis_binary\"\n",
    "    ]\n",
    ") == {\n",
    "    \"Control\",\n",
    "    \"PD\",\n",
    "}\n",
    "\n",
    "assert set(\n",
    "    design_meta[\"sex\"]\n",
    ") == {\n",
    "    \"Female\",\n",
    "    \"Male\",\n",
    "}\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. BASELINE BALANCE\n",
    "# ============================================================\n",
    "\n",
    "print(\"\\n========================================\")\n",
    "print(\"CONTINUOUS COVARIATES BY DIAGNOSIS\")\n",
    "print(\"========================================\")\n",
    "\n",
    "balance_continuous = (\n",
    "    design_meta\n",
    "    .groupby(\n",
    "        \"diagnosis_binary\"\n",
    "    )[\n",
    "        [\n",
    "            \"age\",\n",
    "            \"PMI\",\n",
    "            \"RIN\",\n",
    "        ]\n",
    "    ]\n",
    "    .agg(\n",
    "        [\n",
    "            \"count\",\n",
    "            \"mean\",\n",
    "            \"std\",\n",
    "            \"min\",\n",
    "            \"median\",\n",
    "            \"max\",\n",
    "        ]\n",
    "    )\n",
    ")\n",
    "\n",
    "display(\n",
    "    balance_continuous\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\n========================================\")\n",
    "print(\"SEX × DIAGNOSIS\")\n",
    "print(\"========================================\")\n",
    "\n",
    "sex_table = pd.crosstab(\n",
    "    design_meta[\n",
    "        \"diagnosis_binary\"\n",
    "    ],\n",
    "    design_meta[\"sex\"]\n",
    ")\n",
    "\n",
    "display(sex_table)\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. NUMERIC COVARIATE CORRELATIONS\n",
    "# ============================================================\n",
    "\n",
    "print(\"\\n========================================\")\n",
    "print(\"NUMERIC COVARIATE CORRELATIONS\")\n",
    "print(\"========================================\")\n",
    "\n",
    "numeric_correlations = (\n",
    "    design_meta[\n",
    "        [\n",
    "            \"age\",\n",
    "            \"PMI\",\n",
    "            \"RIN\",\n",
    "        ]\n",
    "    ]\n",
    "    .corr()\n",
    ")\n",
    "\n",
    "display(\n",
    "    numeric_correlations\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. BUILD PRIMARY DESIGN MATRIX\n",
    "#\n",
    "# Frozen intended model:\n",
    "#\n",
    "#   ~ age + sex + diagnosis_binary\n",
    "#\n",
    "# References:\n",
    "#   sex       = Female\n",
    "#   diagnosis = Control\n",
    "# ============================================================\n",
    "\n",
    "design_meta[\n",
    "    \"sex_Male\"\n",
    "] = (\n",
    "    design_meta[\"sex\"]\n",
    "    .eq(\"Male\")\n",
    "    .astype(float)\n",
    ")\n",
    "\n",
    "design_meta[\n",
    "    \"diagnosis_PD\"\n",
    "] = (\n",
    "    design_meta[\n",
    "        \"diagnosis_binary\"\n",
    "    ]\n",
    "    .eq(\"PD\")\n",
    "    .astype(float)\n",
    ")\n",
    "\n",
    "\n",
    "X_primary = pd.DataFrame({\n",
    "\n",
    "    \"Intercept\":\n",
    "        np.ones(\n",
    "            len(design_meta),\n",
    "            dtype=float\n",
    "        ),\n",
    "\n",
    "    \"age\":\n",
    "        pd.to_numeric(\n",
    "            design_meta[\"age\"]\n",
    "        ).astype(float),\n",
    "\n",
    "    \"sex_Male\":\n",
    "        design_meta[\n",
    "            \"sex_Male\"\n",
    "        ],\n",
    "\n",
    "    \"diagnosis_PD\":\n",
    "        design_meta[\n",
    "            \"diagnosis_PD\"\n",
    "        ],\n",
    "})\n",
    "\n",
    "\n",
    "primary_rank = (\n",
    "    np.linalg.matrix_rank(\n",
    "        X_primary.to_numpy()\n",
    "    )\n",
    ")\n",
    "\n",
    "primary_columns = (\n",
    "    X_primary.shape[1]\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\n========================================\")\n",
    "print(\"PRIMARY DESIGN\")\n",
    "print(\"========================================\")\n",    "\n",
    "print(\n",
    "    \"Columns:\",\n",
    "    X_primary.columns.tolist()\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Rank:\",\n",
    "    primary_rank,\n",
    "    \"/\",\n",
    "    primary_columns\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    primary_rank\n",
    "    ==\n",
    "    primary_columns\n",
    "), (\n",
    "    \"Primary design is rank deficient.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. SENSITIVITY DESIGN\n",
    "#\n",
    "# Frozen intended model:\n",
    "#\n",
    "#   ~ age + sex + PMI + RIN + diagnosis_binary\n",
    "# ============================================================\n",
    "\n",
    "X_sensitivity = pd.DataFrame({\n",
    "\n",
    "    \"Intercept\":\n",
    "        np.ones(\n",
    "            len(design_meta),\n",
    "            dtype=float\n",
    "        ),\n",
    "\n",
    "    \"age\":\n",
    "        pd.to_numeric(\n",
    "            design_meta[\"age\"]\n",
    "        ).astype(float),\n",
    "\n",
    "    \"sex_Male\":\n",
    "        design_meta[\n",
    "            \"sex_Male\"\n",
    "        ],\n",
    "\n",
    "    \"PMI\":\n",
    "        pd.to_numeric(\n",
    "            design_meta[\"PMI\"]\n",
    "        ).astype(float),\n",
    "\n",
    "    \"RIN\":\n",
    "        pd.to_numeric(\n",
    "            design_meta[\"RIN\"]\n",
    "        ).astype(float),\n",
    "\n",
    "    \"diagnosis_PD\":\n",
    "        design_meta[\n",
    "            \"diagnosis_PD\"\n",
    "        ],\n",
    "})\n",
    "\n",
    "\n",
    "sensitivity_rank = (\n",
    "    np.linalg.matrix_rank(\n",
    "        X_sensitivity.to_numpy()\n",
    "    )\n",
    ")\n",
    "\n",
    "sensitivity_columns = (\n",
    "    X_sensitivity.shape[1]\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\n========================================\")\n",
    "print(\"SENSITIVITY DESIGN\")\n",
    "print(\"========================================\")\n",
    "\n",
    "print(\n",
    "    \"Columns:\",\n",
    "    X_sensitivity.columns.tolist()\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Rank:\",\n",
    "    sensitivity_rank,\n",
    "    \"/\",\n",
    "    sensitivity_columns\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    sensitivity_rank\n",
    "    ==\n",
    "    sensitivity_columns\n",
    "), (\n",
    "    \"Sensitivity design is rank deficient.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. STANDARDIZED CONDITION NUMBERS\n",
    "#\n",
    "# Continuous variables are standardized ONLY for this\n",
    "# diagnostic. Actual DE model remains on original scale.\n",
    "# ============================================================\n",
    "\n",
    "def standardized_condition_number(\n",
    "    df,\n",
    "    continuous_cols\n",
    "):\n",
    "\n",
    "    Z = df.copy().astype(float)\n",
    "\n",
    "    for col in continuous_cols:\n",
    "\n",
    "        sd = Z[col].std(\n",
    "            ddof=0\n",
    "        )\n",
    "\n",
    "        assert sd > 0\n",
    "\n",
    "        Z[col] = (\n",
    "            Z[col]\n",
    "            -\n",
    "            Z[col].mean()\n",
    "        ) / sd\n",
    "\n",
    "    return float(\n",
    "        np.linalg.cond(\n",
    "            Z.to_numpy()\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "primary_condition = (\n",
    "    standardized_condition_number(\n",
    "        X_primary,\n",
    "        [\"age\"]\n",
    "    )\n",
    ")\n",
    "\n",
    "sensitivity_condition = (\n",
    "    standardized_condition_number(\n",
    "        X_sensitivity,\n",
    "        [\n",
    "            \"age\",\n",
    "            \"PMI\",\n",
    "            \"RIN\",\n",
    "        ]\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\nStandardized primary condition number:\")\n",
    "print(primary_condition)\n",
    "\n",
    "print(\"\\nStandardized sensitivity condition number:\")\n",
    "print(sensitivity_condition)\n",
    "\n",
    "\n",
    "# Diagnostic warning only.\n",
    "# Do NOT alter model automatically.\n",
    "\n",
    "if primary_condition > 30:\n",
    "\n",
    "    print(\n",
    "        \"\\nWARNING: primary design \"\n",
    "        \"shows potentially problematic \"\n",
    "        \"conditioning.\"\n",
    "    )\n",
    "\n",
    "\n",
    "if sensitivity_condition > 30:\n",
    "\n",
    "    print(\n",
    "        \"\\nWARNING: sensitivity design \"\n",
    "        \"shows potentially problematic \"\n",
    "        \"conditioning.\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 12. AGE-OVERLAP SENSITIVITY POPULATION\n",
    "# ============================================================\n",
    "\n",
    "age_ranges = (\n",
    "    design_meta\n",
    "    .groupby(\n",
    "        \"diagnosis_binary\"\n",
    "    )[\"age\"]\n",
    "    .agg(\n",
    "        [\"min\", \"max\"]\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "overlap_low = float(\n",
    "    age_ranges[\"min\"].max()\n",
    ")\n",
    "\n",
    "overlap_high = float(\n",
    "    age_ranges[\"max\"].min()\n",
    ")\n",
    "\n",
    "\n",
    "age_overlap_meta = (\n",
    "    design_meta[\n",
    "        design_meta[\"age\"]\n",
    "        .between(\n",
    "            overlap_low,\n",
    "            overlap_high,\n",
    "            inclusive=\"both\"\n",
    "        )\n",
    "    ]\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "\n",
    "age_overlap_counts = (\n",
    "    age_overlap_meta[\n",
    "        \"diagnosis_binary\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\n========================================\")\n",
    "print(\"AGE-OVERLAP SENSITIVITY\")\n",
    "print(\"========================================\")\n",
    "\n",
    "print(\n",
    "    \"Common age support:\",\n",
    "    overlap_low,\n",
    "    \"to\",\n",
    "    overlap_high\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Remaining donors:\",\n",
    "    len(age_overlap_meta)\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Diagnosis counts:\",\n",
    "    age_overlap_counts\n",
    ")\n",
    "\n",
    "print(\"\\nExcluded donors:\")\n",
    "\n",
    "display(\n",
    "    design_meta[\n",
    "        ~design_meta[\n",
    "            \"donor_id\"\n",
    "        ].isin(\n",
    "            age_overlap_meta[\n",
    "                \"donor_id\"\n",
    "            ]\n",
    "        )\n",
    "    ][\n",
    "        [\n",
    "            \"donor_id\",\n",
    "            \"diagnosis_binary\",\n",
    "            \"age\",\n",
    "        ]\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "# Verify restricted design still full rank\n",
    "X_overlap = X_primary.loc[\n",
    "    age_overlap_meta.index\n",
    "].copy()\n",
    "\n",
    "overlap_rank = (\n",
    "    np.linalg.matrix_rank(\n",
    "        X_overlap.to_numpy()\n",
    "    )\n",
    ")\n",
    "\n",
    "assert (\n",
    "    overlap_rank\n",
    "    ==\n",
    "    X_overlap.shape[1]\n",
    "), (\n",
    "    \"Age-overlap design is \"\n",
    "    \"rank deficient.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 13. SAVE AGE-OVERLAP DONOR LIST\n",
    "# ============================================================\n",
    "\n",
    "age_overlap_path = (\n",
    "    MANIFESTS /\n",
    "    \"GSE243639_age_overlap_sensitivity_donors_v1.csv\"\n",
    ")\n",
    "\n",
    "age_overlap_meta[\n",
    "    [\n",
    "        \"donor_id\",\n",
    "        \"diagnosis_binary\",\n",
    "        \"age\",\n",
    "        \"sex\",\n",
    "        \"PMI\",\n",
    "        \"RIN\",\n",
    "    ]\n",
    "].to_csv(\n",
    "    age_overlap_path,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 14. SAVE DESIGN AUDIT LOCK\n",
    "# ============================================================\n",
    "\n",
    "design_audit = {\n",
    "\n",
    "    \"dataset\":\n",
    "        \"GSE243639\",\n",
    "\n",
    "    \"created_utc\":\n",
    "        datetime.now(\n",
    "            timezone.utc\n",
    "        ).isoformat(),\n",
    "\n",
    "    \"primary_cell_classes\":\n",
    "        PRIMARY_CLASSES,\n",
    "\n",
    "    \"all_primary_classes_have_29_donors\":\n",
    "        True,\n",
    "\n",
    "    \"all_primary_classes_min_50_nuclei\":\n",
    "        True,\n",
    "\n",
    "    \"reference_levels\": {\n",
    "        \"diagnosis_binary\":\n",
    "            \"Control\",\n",
    "\n",
    "        \"sex\":\n",
    "            \"Female\",\n",
    "    },\n",
    "\n",
    "    \"primary_design\":\n",
    "        \"~ age + sex + diagnosis_binary\",\n",
    "\n",
    "    \"primary_design_rank\":\n",
    "        int(primary_rank),\n",
    "\n",
    "    \"primary_design_columns\":\n",
    "        int(primary_columns),\n",
    "\n",
    "    \"primary_design_full_rank\":\n",
    "        bool(\n",
    "            primary_rank\n",
    "            ==\n",
    "            primary_columns\n",
    "        ),\n",
    "\n",
    "    \"primary_standardized_condition_number\":\n",
    "        primary_condition,\n",
    "\n",
    "    \"sensitivity_design\":\n",
    "        (\n",
    "            \"~ age + sex + PMI + RIN \"\n",
    "            \"+ diagnosis_binary\"\n",
    "        ),\n",
    "\n",
    "    \"sensitivity_design_rank\":\n",
    "        int(sensitivity_rank),\n",
    "\n",
    "    \"sensitivity_design_columns\":\n",
    "        int(sensitivity_columns),\n",
    "\n",
    "    \"sensitivity_design_full_rank\":\n",
    "        bool(\n",
    "            sensitivity_rank\n",
    "            ==\n",
    "            sensitivity_columns\n",
    "        ),\n",
    "\n",
    "    \"sensitivity_standardized_condition_number\":\n",
    "        sensitivity_condition,\n",
    "\n",
    "    \"age_overlap_low\":\n",
    "        overlap_low,\n",
    "\n",
    "    \"age_overlap_high\":\n",
    "        overlap_high,\n",
    "\n",
    "    \"age_overlap_n\":\n",
    "        int(\n",
    "            len(age_overlap_meta)\n",
    "        ),\n",
    "\n",
    "    \"age_overlap_diagnosis_counts\":\n",
    "        {\n",
    "            str(k): int(v)\n",
    "            for k, v\n",
    "            in age_overlap_counts.items()\n",
    "        },\n",
    "\n",
    "    \"age_overlap_design_full_rank\":\n",
    "        True,\n",
    "\n",
    "    \"differential_expression_performed\":\n",
    "        False,\n",
    "\n",
    "    \"gene_filtering_performed\":\n",
    "        False,\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    audit_path,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        design_audit,\n",
    "        f,\n",
    "        indent=2\n",
    "    )\n",
    "\n",
    "\n",
    "print(\"\\n========================================\")\n",
    "print(\"STEP 10A/B PASSED\")\n",
    "print(\"========================================\")\n",
    "\n",
    "print(\n",
    "    json.dumps(\n",
    "        design_audit,\n",
    "        indent=2\n",
    "    )\n",
    ")\n",
    "\n",
    "print(\"\\nAge-overlap donor list:\")\n",
    "print(age_overlap_path)\n",
    "\n",
    "print(\"\\nDesign audit:\")\n",
    "print(audit_path)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 19\n",
    "# ============================================================\n",
    "# STEP 10C — FINAL PRE-DE GENE-UNIVERSE + INFERENCE LOCK\n",
    "#\n",
    "# COMPLETE SELF-CONTAINED VERSION\n",
    "#\n",
    "# PURPOSE\n",
    "# -------\n",
    "# 1. Load frozen donor-level pseudobulk raw counts.\n",
    "# 2. Reconstruct library sizes.\n",
    "# 3. Freeze analyzable donors for each cell class.\n",
    "# 4. Calculate expression eligibility WITHOUT disease DE.\n",
    "# 5. Freeze a separate gene universe for each cell class.\n",
    "# 6. Exclude MT- genes from DE universes.\n",
    "# 7. Save exact raw-count matrices and donor metadata.\n",
    "# 8. Freeze all statistical inference rules.\n",
    "#\n",
    "# NO DIFFERENTIAL EXPRESSION IS PERFORMED HERE.\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import hashlib\n",
    "import json\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "RESULTS = ROOT / \"results\"\n",
    "MANIFESTS = ROOT / \"manifests\"\n",
    "LOCKS = ROOT / \"locks\"\n",
    "UNIVERSES = ROOT / \"gene_universes\"\n",
    "\n",
    "UNIVERSES.mkdir(\n",
    "    exist_ok=True\n",
    ")\n",
    "\n",
    "\n",
    "pb_path = (\n",
    "    RESULTS /\n",
    "    \"GSE243639_donor_celltype_pseudobulk_RAW_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "meta_path = (\n",
    "    MANIFESTS /\n",
    "    \"GSE243639_pseudobulk_group_metadata_v1.csv\"\n",
    ")\n",
    "\n",
    "design_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_DESIGN_AUDIT_v1.json\"\n",
    ")\n",
    "\n",
    "cell_plan_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_PD_CELL_ANALYSIS_PLAN_v1.json\"\n",
    ")\n",
    "\n",
    "pb_build_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_PSEUDOBULK_BUILD_v1.json\"\n",
    ")\n",
    "\n",
    "final_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_PRE_DE_ANALYSIS_LOCK_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "    pb_path,\n",
    "    meta_path,\n",
    "    design_lock_path,\n",
    "    cell_plan_path,\n",
    "    pb_build_lock_path,\n",
    "]:\n",
    "\n",
    "    assert path.exists(), (\n",
    "        f\"Missing required input: {path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "print(\n",
    "    \"All required frozen inputs found.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. LOAD FROZEN INPUTS\n",
    "# ============================================================\n",
    "\n",
    "pb = pd.read_csv(\n",
    "    pb_path,\n",
    "    compression=\"gzip\",\n",
    "    index_col=0\n",
    ")\n",
    "\n",
    "meta = pd.read_csv(\n",
    "    meta_path\n",
    ")\n",
    "\n",
    "\n",
    "with open(\n",
    "    design_lock_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    design_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    cell_plan_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    cell_plan = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    pb_build_lock_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    pb_build_lock = json.load(f)\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. UPSTREAM LOCK VERIFICATION\n",
    "# ============================================================\n",
    "\n",
    "assert (\n",
    "    pb_build_lock[\n",
    "        \"UMI_conservation\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "assert (\n",
    "    pb_build_lock[\n",
    "        \"every_cell_assigned_exactly_once\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "assert (\n",
    "    pb_build_lock[\n",
    "        \"differential_expression_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "assert (\n",
    "    design_lock[\n",
    "        \"primary_design_full_rank\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "assert (\n",
    "    design_lock[\n",
    "        \"sensitivity_design_full_rank\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "assert (\n",
    "    design_lock[\n",
    "        \"differential_expression_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Upstream pseudobulk and design locks verified.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. PSEUDOBULK MATRIX INTEGRITY\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\nPseudobulk shape:\",\n",
    "    pb.shape\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Metadata shape:\",\n",
    "    meta.shape\n",
    ")\n",
    "\n",
    "\n",
    "assert pb.shape == (\n",
    "    33537,\n",
    "    200\n",
    ")\n",
    "\n",
    "assert len(meta) == 200\n",
    "\n",
    "assert pb.index.is_unique\n",
    "\n",
    "assert meta[\n",
    "    \"pseudobulk_group\"\n",
    "].is_unique\n",
    "\n",
    "\n",
    "assert (\n",
    "    pb.columns.tolist()\n",
    "    ==\n",
    "    meta[\n",
    "        \"pseudobulk_group\"\n",
    "    ].tolist()\n",
    ")\n",
    "\n",
    "\n",
    "# Raw integer integrity\n",
    "pb_array = pb.to_numpy()\n",
    "\n",
    "assert np.isfinite(\n",
    "    pb_array\n",
    ").all()\n",
    "\n",
    "assert (\n",
    "    pb_array >= 0\n",
    ").all()\n",
    "\n",
    "assert np.allclose(\n",
    "    pb_array,\n",
    "    np.round(pb_array)\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Pseudobulk raw-count integrity: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. RECONSTRUCT LIBRARY SIZES\n",
    "#\n",
    "# STEP 10A/B calculated these in memory but did not persist\n",
    "# them to the original group metadata file.\n",
    "# Reconstruct directly from the frozen pseudobulk matrix.\n",
    "# ============================================================\n",
    "\n",
    "library_sizes = (\n",
    "    pb.sum(\n",
    "        axis=0\n",
    "    )\n",
    "    .astype(\n",
    "        np.int64\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    library_sizes > 0\n",
    ").all()\n",
    "\n",
    "\n",
    "meta[\n",
    "    \"library_size\"\n",
    "] = (\n",
    "    meta[\n",
    "        \"pseudobulk_group\"\n",
    "    ]\n",
    "    .map(\n",
    "        library_sizes\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    meta[\n",
    "        \"library_size\"\n",
    "    ]\n",
    "    .notna()\n",
    "    .all()\n",
    ")\n",
    "\n",
    "\n",
    "meta[\n",
    "    \"library_size\"\n",
    "] = (\n",
    "    meta[\n",
    "        \"library_size\"\n",
    "    ]\n",
    "    .astype(\n",
    "        np.int64\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Library sizes reconstructed: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. GLOBAL GENE IDENTIFIERS\n",
    "# ============================================================\n",
    "\n",
    "genes = pd.Index(\n",
    "    pb.index\n",
    "    .astype(str),\n",
    "    dtype=object\n",
    ")\n",
    "\n",
    "\n",
    "assert len(genes) == 33537\n",
    "\n",
    "assert genes.is_unique\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Robust mitochondrial mask\n",
    "#\n",
    "# IMPORTANT:\n",
    "# pandas may return either Index-like or ndarray depending\n",
    "# on version, so convert explicitly with np.asarray().\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "mitochondrial = np.asarray(\n",
    "    genes\n",
    "    .str.upper()\n",
    "    .str.startswith(\n",
    "        \"MT-\"\n",
    "    ),\n",
    "    dtype=bool\n",
    ")\n",
    "\n",
    "\n",
    "assert mitochondrial.shape == (\n",
    "    33537,\n",
    ")\n",
    "\n",
    "n_mt_global = int(\n",
    "    mitochondrial.sum()\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nGlobal genes:\",\n",
    "    f\"{len(genes):,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Global MT- genes:\",\n",
    "    n_mt_global\n",
    ")\n",
    "\n",
    "\n",
    "assert n_mt_global == 13, (\n",
    "    f\"Expected 13 MT- genes; \"\n",
    "    f\"found {n_mt_global}.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. FREEZE CELL-CLASS ANALYSIS PLAN\n",
    "# ============================================================\n",
    "\n",
    "CELL_CLASS_PLAN = {\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # PRIMARY\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    \"Astro\": {\n",
    "\n",
    "        \"role\":\n",
    "            \"primary\",\n",
    "\n",
    "        \"min_nuclei\":\n",
    "            50,\n",
    "\n",
    "        \"expected_PD\":\n",
    "            15,\n",
    "\n",
    "        \"expected_Control\":\n",
    "            14,\n",
    "\n",
    "        \"min_donors_CPM\":\n",
    "            14,\n",
    "    },\n",
    "\n",
    "\n",
    "    \"Micro\": {\n",
    "\n",
    "        \"role\":\n",
    "            \"primary\",\n",
    "\n",
    "        \"min_nuclei\":\n",
    "            50,\n",
    "\n",
    "        \"expected_PD\":\n",
    "            15,\n",
    "\n",
    "        \"expected_Control\":\n",
    "            14,\n",
    "\n",
    "        \"min_donors_CPM\":\n",
    "            14,\n",
    "    },\n",
    "\n",
    "\n",
    "    \"OPC\": {\n",
    "\n",
    "        \"role\":\n",
    "            \"primary\",\n",
    "\n",
    "        \"min_nuclei\":\n",
    "            50,\n",
    "\n",
    "        \"expected_PD\":\n",
    "            15,\n",
    "\n",
    "        \"expected_Control\":\n",
    "            14,\n",
    "\n",
    "        \"min_donors_CPM\":\n",
    "            14,\n",
    "    },\n",
    "\n",
    "\n",
    "    \"Oligo\": {\n",
    "\n",
    "        \"role\":\n",
    "            \"primary\",\n",
    "\n",
    "        \"min_nuclei\":\n",
    "            50,\n",
    "\n",
    "        \"expected_PD\":\n",
    "            15,\n",
    "\n",
    "        \"expected_Control\":\n",
    "            14,\n",
    "\n",
    "        \"min_donors_CPM\":\n",
    "            14,\n",
    "    },\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # SECONDARY\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    \"VC\": {\n",
    "\n",
    "        \"role\":\n",
    "            \"secondary\",\n",
    "\n",
    "        \"min_nuclei\":\n",
    "            20,\n",
    "\n",
    "        \"expected_PD\":\n",
    "            11,\n",
    "\n",
    "        \"expected_Control\":\n",
    "            11,\n",
    "\n",
    "        \"min_donors_CPM\":\n",
    "            11,\n",
    "    },\n",
    "\n",
    "\n",
    "    \"Neurons\": {\n",
    "\n",
    "        \"role\":\n",
    "            \"secondary\",\n",
    "\n",
    "        \"min_nuclei\":\n",
    "            20,\n",
    "\n",
    "        \"expected_PD\":\n",
    "            11,\n",
    "\n",
    "        \"expected_Control\":\n",
    "            14,\n",
    "\n",
    "        \"min_donors_CPM\":\n",
    "            11,\n",
    "    },\n",
    "}\n",
    "\n",
    "\n",
    "CPM_THRESHOLD = 1.0\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. CONSISTENCY WITH PREVIOUS CELL-CLASS LOCK\n",
    "# ============================================================\n",
    "\n",
    "expected_primary = {\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "}\n",
    "\n",
    "assert (\n",
    "    set(\n",
    "        cell_plan[\n",
    "            \"primary_cell_classes\"\n",
    "        ].keys()\n",
    "    )\n",
    "    ==\n",
    "    expected_primary\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    \"VC\"\n",
    "    in\n",
    "    cell_plan[\n",
    "        \"secondary_cell_classes\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "assert (\n",
    "    \"Neurons\"\n",
    "    in\n",
    "    cell_plan[\n",
    "        \"secondary_cell_classes\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Cell-class plan matches frozen upstream lock.\"\n",
    ")\n",    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. HASH FUNCTION\n",
    "# ============================================================\n",
    "\n",
    "def ordered_gene_hash(\n",
    "    ordered_genes\n",
    "):\n",
    "\n",
    "    payload = (\n",
    "        \"\\n\".join(\n",
    "            map(\n",
    "                str,\n",
    "                ordered_genes\n",
    "            )\n",
    "        )\n",
    "        +\n",
    "        \"\\n\"\n",
    "    ).encode(\n",
    "        \"utf-8\"\n",
    "    )\n",
    "\n",
    "    return (\n",
    "        hashlib.sha256(\n",
    "            payload\n",
    "        )\n",
    "        .hexdigest()\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. STORAGE FOR FINAL LOCK\n",
    "# ============================================================\n",
    "\n",
    "universe_records = {}\n",
    "\n",
    "summary_rows = []\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. BUILD ONE FROZEN UNIVERSE PER CELL CLASS\n",
    "# ============================================================\n",
    "\n",
    "for (\n",
    "    cell_type,\n",
    "    spec\n",
    ") in CELL_CLASS_PLAN.items():\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\n\"\n",
    "        +\n",
    "        \"=\" * 72\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        cell_type,\n",
    "        \"|\",\n",
    "        spec[\n",
    "            \"role\"\n",
    "        ].upper()\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"=\" * 72\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 10.1 Eligible donor pseudobulks\n",
    "    # ========================================================\n",
    "\n",
    "    m = (\n",
    "        meta[\n",
    "            (\n",
    "                meta[\n",
    "                    \"IDENT\"\n",
    "                ]\n",
    "                ==\n",
    "                cell_type\n",
    "            )\n",
    "            &\n",
    "            (\n",
    "                meta[\n",
    "                    \"n_nuclei\"\n",
    "                ]\n",
    "                >=\n",
    "                spec[\n",
    "                    \"min_nuclei\"\n",
    "                ]\n",
    "            )\n",
    "        ]\n",
    "        .copy()\n",
    "        .sort_values(\n",
    "            \"donor_id\"\n",
    "        )\n",
    "        .reset_index(\n",
    "            drop=True\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    diagnosis_counts = (\n",
    "        m[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        .value_counts()\n",
    "        .to_dict()\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Eligible donors:\",\n",
    "        len(m)\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Diagnosis counts:\",\n",
    "        diagnosis_counts\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        diagnosis_counts.get(\n",
    "            \"PD\",\n",
    "            0\n",
    "        )\n",
    "        ==\n",
    "        spec[\n",
    "            \"expected_PD\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        diagnosis_counts.get(\n",
    "            \"Control\",\n",
    "            0\n",
    "        )\n",
    "        ==\n",
    "        spec[\n",
    "            \"expected_Control\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        m[\n",
    "            \"donor_id\"\n",
    "        ]\n",
    "        .is_unique\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        m[\n",
    "            \"n_nuclei\"\n",
    "        ]\n",
    "        >=\n",
    "        spec[\n",
    "            \"min_nuclei\"\n",
    "        ]\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 10.2 Extract genes × eligible donors\n",
    "    # ========================================================\n",
    "\n",
    "    sample_columns = (\n",
    "        m[\n",
    "            \"pseudobulk_group\"\n",
    "        ]\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    counts = (\n",
    "        pb[\n",
    "            sample_columns\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert counts.shape == (\n",
    "        33537,\n",
    "        len(m)\n",
    "    )\n",
    "\n",
    "\n",
    "    arr = counts.to_numpy(\n",
    "        dtype=np.int64,\n",
    "        copy=False\n",
    "    )\n",
    "\n",
    "\n",
    "    assert np.isfinite(\n",
    "        arr\n",
    "    ).all()\n",
    "\n",
    "    assert (\n",
    "        arr >= 0\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 10.3 Library sizes\n",
    "    #\n",
    "    # Denominator uses ALL 33,537 genes.\n",
    "    # ========================================================\n",
    "\n",
    "    class_library_sizes = (\n",
    "        arr.sum(\n",
    "            axis=0,\n",
    "            dtype=np.int64\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        class_library_sizes > 0\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    # Verify these match metadata\n",
    "    metadata_library_sizes = (\n",
    "        m[\n",
    "            \"library_size\"\n",
    "        ]\n",
    "        .to_numpy(\n",
    "            dtype=np.int64\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert np.array_equal(\n",
    "        class_library_sizes,\n",
    "        metadata_library_sizes\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 10.4 CPM calculation\n",
    "    # ========================================================\n",
    "\n",
    "    cpm = (\n",
    "        arr.astype(\n",
    "            np.float64\n",
    "        )\n",
    "        /\n",
    "        class_library_sizes[\n",
    "            None,\n",
    "            :\n",
    "        ]\n",
    "        *\n",
    "        1_000_000.0\n",
    "    )\n",
    "\n",
    "\n",
    "    assert np.isfinite(\n",
    "        cpm\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 10.5 Expression eligibility\n",
    "    #\n",
    "    # CPM >= 1 in at least N donors,\n",
    "    # where N = size of smaller diagnosis group.\n",
    "    # ========================================================\n",
    "\n",
    "    n_donors_ge_1cpm = (\n",
    "        cpm\n",
    "        >=\n",
    "        CPM_THRESHOLD\n",
    "    ).sum(\n",
    "        axis=1\n",
    "    )\n",
    "\n",
    "\n",
    "    expression_pass = (\n",
    "        n_donors_ge_1cpm\n",
    "        >=\n",
    "        spec[\n",
    "            \"min_donors_CPM\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert expression_pass.shape == (\n",
    "        33537,\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 10.6 Exclude mitochondrial genes\n",
    "    # ========================================================\n",
    "\n",
    "    de_universe_mask = (\n",
    "        expression_pass\n",
    "        &\n",
    "        ~mitochondrial\n",
    "    )\n",
    "\n",
    "\n",
    "    retained_indices = np.flatnonzero(\n",
    "        de_universe_mask\n",
    "    )\n",
    "\n",
    "\n",
    "    retained_genes = (\n",
    "        genes[\n",
    "            retained_indices\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 10.7 Summary numbers\n",
    "    # ========================================================\n",
    "\n",
    "    n_expression_pass = int(\n",
    "        expression_pass.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_mt_expression_pass = int(\n",
    "        (\n",
    "            expression_pass\n",
    "            &\n",
    "            mitochondrial\n",
    "        ).sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_retained = int(\n",
    "        de_universe_mask.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Expression passing:\",\n",
    "        f\"{n_expression_pass:,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Expression-passing MT- removed:\",\n",
    "        n_mt_expression_pass\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Frozen DE universe:\",\n",
    "        f\"{n_retained:,}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    assert n_retained > 0\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_expression_pass\n",
    "        -\n",
    "        n_mt_expression_pass\n",
    "        ==\n",
    "        n_retained\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 10.8 Build exact gene-universe table\n",
    "    # ========================================================\n",
    "\n",
    "    universe_table = pd.DataFrame({\n",
    "\n",
    "        \"original_gene_index\":\n",
    "            retained_indices.astype(\n",
    "                np.int64\n",
    "            ),\n",
    "\n",
    "        \"DE_universe_index\":\n",
    "            np.arange(\n",
    "                n_retained,\n",
    "                dtype=np.int64\n",
    "            ),\n",
    "\n",
    "        \"gene_symbol\":\n",
    "            retained_genes,\n",
    "\n",
    "        \"n_donors_CPM_ge_1\":\n",
    "            n_donors_ge_1cpm[\n",
    "                retained_indices\n",
    "            ].astype(\n",
    "                np.int64\n",
    "            ),\n",
    "    })\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        universe_table\n",
    "    ) == n_retained\n",
    "\n",
    "\n",
    "    assert (\n",
    "        universe_table[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .is_unique\n",
    "    )\n",
    "\n",
    "\n",
    "    assert not (\n",
    "        universe_table[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .str.upper()\n",
    "        .str.startswith(\n",
    "            \"MT-\"\n",
    "        )\n",
    "        .any()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        universe_table[\n",
    "            \"n_donors_CPM_ge_1\"\n",
    "        ]\n",
    "        >=\n",
    "        spec[\n",
    "            \"min_donors_CPM\"\n",
    "        ]\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 10.9 Save exact ordered universe\n",
    "    # ========================================================\n",
    "\n",
    "    universe_path = (\n",
    "        UNIVERSES /\n",
    "        (\n",
    "            f\"GSE243639_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"DE_GENE_UNIVERSE_v1.csv.gz\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    universe_table.to_csv(\n",
    "        universe_path,\n",
    "        index=False,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 10.10 Save frozen RAW integer counts\n",
    "    #\n",
    "    # genes × donors\n",
    "    # ========================================================\n",
    "\n",
    "    filtered_counts = (\n",
    "        counts\n",
    "        .iloc[\n",
    "            retained_indices,\n",
    "            :\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert filtered_counts.shape == (\n",
    "        n_retained,\n",
    "        len(m)\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        filtered_counts\n",
    "        .index\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "        ==\n",
    "        retained_genes\n",
    "    )\n",
    "\n",
    "\n",
    "    filtered_array = (\n",
    "        filtered_counts\n",
    "        .to_numpy(\n",
    "            dtype=np.int64,\n",
    "            copy=False\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        filtered_array >= 0\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    filtered_count_path = (\n",
    "        UNIVERSES /\n",
    "        (\n",
    "            f\"GSE243639_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"RAW_COUNTS_FROZEN_v1.csv.gz\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    filtered_counts.to_csv(\n",
    "        filtered_count_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 10.11 Save exact donor metadata/order\n",
    "    # ========================================================\n",
    "\n",
    "    eligible_meta_path = (\n",
    "        MANIFESTS /\n",
    "        (\n",
    "            f\"GSE243639_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"DE_DONORS_v1.csv\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    exact_meta = (\n",
    "        m[\n",
    "            [\n",
    "                \"pseudobulk_group\",\n",
    "                \"donor_id\",\n",
    "                \"diagnosis_binary\",\n",
    "                \"age\",\n",
    "                \"sex\",\n",
    "                \"PMI\",\n",
    "                \"RIN\",\n",
    "                \"n_nuclei\",\n",
    "                \"library_size\",\n",
    "            ]\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        exact_meta[\n",
    "            \"pseudobulk_group\"\n",
    "        ]\n",
    "        .tolist()\n",
    "        ==\n",
    "        filtered_counts.columns.tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    exact_meta.to_csv(\n",
    "        eligible_meta_path,\n",
    "        index=False\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 10.12 Hash exact ordered gene universe\n",
    "    # ========================================================\n",
    "\n",
    "    gene_hash = (\n",
    "        ordered_gene_hash(\n",
    "            retained_genes\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 10.13 Store lock record\n",
    "    # ========================================================\n",
    "\n",
    "    universe_records[\n",
    "        cell_type\n",
    "    ] = {\n",
    "\n",
    "        \"role\":\n",
    "            spec[\n",
    "                \"role\"\n",
    "            ],\n",
    "\n",
    "        \"minimum_nuclei_per_donor\":\n",
    "            int(\n",
    "                spec[\n",
    "                    \"min_nuclei\"\n",
    "                ]\n",
    "            ),\n",
    "\n",
    "        \"n_PD\":\n",
    "            int(\n",
    "                spec[\n",
    "                    \"expected_PD\"\n",
    "                ]\n",
    "            ),\n",
    "\n",
    "        \"n_Control\":\n",
    "            int(\n",
    "                spec[\n",
    "                    \"expected_Control\"\n",
    "                ]\n",
    "            ),\n",
    "\n",
    "        \"n_total_donors\":\n",
    "            int(\n",
    "                len(m)\n",
    "            ),\n",
    "\n",
    "        \"CPM_threshold\":\n",
    "            float(\n",
    "                CPM_THRESHOLD\n",
    "            ),\n",
    "\n",
    "        \"minimum_donors_CPM\":\n",
    "            int(\n",
    "                spec[\n",
    "                    \"min_donors_CPM\"\n",
    "                ]\n",
    "            ),\n",
    "\n",
    "        \"features_before_filtering\":\n",
    "            int(\n",
    "                len(genes)\n",
    "            ),\n",
    "\n",
    "        \"features_passing_expression_rule\":\n",
    "            int(\n",
    "                n_expression_pass\n",
    "            ),\n",
    "\n",
    "        \"expression_passing_MT_removed\":\n",
    "            int(\n",
    "                n_mt_expression_pass\n",
    "            ),\n",
    "\n",
    "        \"frozen_DE_gene_universe\":\n",
    "            int(\n",
    "                n_retained\n",
    "            ),\n",
    "\n",
    "        \"gene_universe_sha256\":\n",
    "            gene_hash,\n",
    "\n",
    "        \"gene_universe_file\":\n",
    "            str(\n",
    "                universe_path\n",
    "            ),\n",
    "\n",
    "        \"raw_counts_file\":\n",
    "            str(\n",
    "                filtered_count_path\n",
    "            ),\n",
    "\n",
    "        \"eligible_donor_metadata\":\n",
    "            str(\n",
    "                eligible_meta_path\n",
    "            ),\n",
    "\n",
    "        \"differential_expression_performed\":\n",
    "            False,\n",
    "    }\n",
    "\n",
    "\n",
    "    summary_rows.append({\n",
    "\n",
    "        \"cell_type\":\n",
    "            cell_type,\n",
    "\n",
    "        \"role\":\n",
    "            spec[\n",
    "                \"role\"\n",
    "            ],\n",
    "\n",
    "        \"PD\":\n",
    "            spec[\n",
    "                \"expected_PD\"\n",
    "            ],\n",
    "\n",
    "        \"Control\":\n",
    "            spec[\n",
    "                \"expected_Control\"\n",
    "            ],\n",
    "\n",
    "        \"min_nuclei\":\n",
    "            spec[\n",
    "                \"min_nuclei\"\n",
    "            ],\n",
    "\n",
    "        \"CPM_min_donors\":\n",
    "            spec[\n",
    "                \"min_donors_CPM\"\n",
    "            ],\n",
    "\n",
    "        \"expression_pass\":\n",
    "            n_expression_pass,\n",
    "\n",
    "        \"MT_removed\":\n",
    "            n_mt_expression_pass,\n",
    "\n",
    "        \"DE_universe\":\n",
    "            n_retained,\n",
    "    })\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. FREEZE INFERENCE POLICY\n",
    "# ============================================================\n",
    "\n",
    "INFERENCE_POLICY = {\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Biological unit\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    \"biological_replicate\":\n",
    "        \"human donor\",\n",
    "\n",
    "    \"cell_level_inference\":\n",
    "        False,\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Primary DE\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    \"primary_cell_classes\": [\n",
    "        \"Astro\",\n",
    "        \"Micro\",\n",
    "        \"OPC\",\n",
    "        \"Oligo\",\n",
    "    ],\n",
    "\n",
    "    \"primary_model\":\n",
    "        \"~ age + sex + diagnosis_binary\",\n",
    "\n",
    "    \"reference_levels\": {\n",
    "\n",
    "        \"diagnosis_binary\":\n",
    "            \"Control\",\n",
    "\n",
    "        \"sex\":\n",
    "            \"Female\",\n",
    "    },\n",
    "\n",
    "    \"primary_contrast\":\n",
    "        \"PD_vs_Control\",\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Secondary analyses\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    \"secondary_cell_classes\": [\n",
    "        \"VC\",\n",
    "        \"Neurons\",\n",
    "    ],\n",
    "\n",
    "    \"excluded_cell_classes\": [\n",
    "        \"T cells\",\n",
    "    ],\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Sensitivity analyses\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    \"expanded_covariate_sensitivity\":\n",
    "        (\n",
    "            \"~ age + sex + PMI + RIN \"\n",
    "            \"+ diagnosis_binary\"\n",
    "        ),\n",
    "\n",
    "    \"age_overlap_sensitivity\": {\n",
    "\n",
    "        \"age_range\":\n",
    "            \"57_to_93_years\",\n",
    "\n",
    "        \"n_PD\":\n",
    "            13,\n",
    "\n",
    "        \"n_Control\":\n",
    "            13,\n",
    "\n",
    "        \"gene_universe\":\n",
    "            (\n",
    "                \"reuse full-cohort frozen \"\n",
    "                \"cell-class universe\"\n",
    "            ),\n",
    "\n",
    "        \"refilter_genes\":\n",
    "            False,\n",
    "    },\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Gene-universe rule\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    \"gene_filtering\":\n",
    "        (\n",
    "            \"CPM >= 1 in at least the size \"\n",
    "            \"of the smaller diagnosis group \"\n",
    "            \"within each prespecified cell class\"\n",
    "        ),\n",
    "\n",
    "    \"CPM_threshold\":\n",
    "        1.0,\n",
    "\n",
    "    \"CPM_denominator\":\n",
    "        (\n",
    "            \"total raw pseudobulk UMI count \"\n",
    "            \"for that donor/cell class across \"\n",
    "            \"all 33,537 input genes\"\n",
    "        ),\n",
    "\n",
    "    \"mitochondrial_policy\":\n",
    "        \"exclude gene symbols beginning MT-\",\n",
    "\n",
    "    \"refilter_after_any_sensitivity_exclusion\":\n",
    "        False,\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # DE engine and effect\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    \"DE_engine\":\n",
    "        \"PyDESeq2\",\n",
    "\n",
    "    \"DE_method\":\n",
    "        \"negative_binomial_Wald\",\n",
    "\n",
    "    \"effect_measure\":\n",
    "        (\n",
    "            \"log2FoldChange \"\n",
    "            \"PD relative to Control\"\n",
    "        ),\n",
    "\n",
    "    \"retain_all_tested_genes\":\n",
    "        True,\n",
    "\n",
    "    \"retain_nonsignificant_effect_sizes\":\n",
    "        True,\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Multiple testing\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    \"multiple_testing\":\n",
    "        \"Benjamini-Hochberg\",\n",
    "\n",
    "    \"FDR_threshold\":\n",
    "        0.05,\n",
    "\n",
    "    \"FDR_family\":\n",
    "        (\n",
    "            \"separate within each prespecified \"\n",
    "            \"cell-class DE analysis\"\n",
    "        ),\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Pathway ranking\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    \"pathway_ranking_statistic\":\n",
    "        \"signed_DESeq2_Wald_statistic\",\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Outlier policy\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    \"outlier_policy\":\n",
    "        (\n",
    "            \"Use standard PyDESeq2/DESeq2 \"\n",
    "            \"Cook's-distance diagnostics. \"\n",
    "            \"No manual donor or gene removal \"\n",
    "            \"after seeing disease-expression results.\"\n",
    "        ),\n",
    "\n",
    "\n",
