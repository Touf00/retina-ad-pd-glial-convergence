    "    print(\n",
    "        f\"[{class_number}/4] \"\n",
    "        f\"{cell_type} — PRIMARY AD DISCOVERY DE\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G1. FROZEN STEP-20 RECORD\n",
    "    # ========================================================\n",
    "\n",
    "    frozen_record = (\n",
    "        pre_de_lock[\n",
    "            \"cell_class_gene_universes\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    expected_n_genes = int(\n",
    "        frozen_record[\n",
    "            \"frozen_AD_discovery_gene_universe\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        frozen_record[\n",
    "            \"n_AD\"\n",
    "        ]\n",
    "    ) == 11\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        frozen_record[\n",
    "            \"n_Control\"\n",
    "        ]\n",
    "    ) == 7\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        frozen_record[\n",
    "            \"n_total_donors\"\n",
    "        ]\n",
    "    ) == 18\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        frozen_record[\n",
    "            \"minimum_nuclei_per_donor\"\n",
    "        ]\n",
    "    ) == 50\n",
    "\n",
    "\n",
    "    counts_path = Path(\n",
    "        frozen_record[\n",
    "            \"raw_counts_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    metadata_path = Path(\n",
    "        frozen_record[\n",
    "            \"donor_metadata_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    universe_path = Path(\n",
    "        frozen_record[\n",
    "            \"gene_universe_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    for path in [\n",
    "\n",
    "        counts_path,\n",
    "        metadata_path,\n",
    "        universe_path,\n",
    "\n",
    "    ]:\n",
    "\n",
    "        assert path.exists(), (\n",
    "            f\"Missing frozen input: {path}\"\n",
    "        )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G2. LOAD FROZEN GENE UNIVERSE\n",
    "    # ========================================================\n",
    "\n",
    "    universe = pd.read_csv(\n",
    "        universe_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    required_universe_columns = {\n",
    "\n",
    "        \"gene_id\",\n",
    "        \"gene_symbol\",\n",
    "        \"gene_symbol_unique_in_GSE174367\",\n",
    "        \"feature_type\",\n",
    "        \"n_donors_CPM_ge_1\",\n",
    "\n",
    "    }\n",
    "\n",
    "\n",
    "    assert (\n",
    "        required_universe_columns\n",
    "        <=\n",
    "        set(\n",
    "            universe.columns\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        universe\n",
    "    ) == expected_n_genes\n",
    "\n",
    "\n",
    "    assert (\n",
    "        universe[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .is_unique\n",
    "    )\n",
    "\n",
    "\n",
    "    expected_gene_ids = (\n",
    "        universe[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    observed_feature_hash = (\n",
    "        ordered_feature_hash(\n",
    "            expected_gene_ids\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    expected_feature_hash = (\n",    "        frozen_record[\n",
    "            \"ordered_gene_id_sha256\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        observed_feature_hash\n",
    "        ==\n",
    "        expected_feature_hash\n",
    "    ), (\n",
    "        f\"{cell_type}: frozen gene-universe hash mismatch.\"\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        universe[\n",
    "            \"feature_type\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .eq(\n",
    "            \"Gene Expression\"\n",
    "        )\n",
    "        .all()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert not (\n",
    "        universe[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .str.upper()\n",
    "        .str.startswith(\n",
    "            \"MT-\"\n",
    "        )\n",
    "        .any()\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Frozen genes:\",\n",
    "        f\"{expected_n_genes:,}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G3. LOAD FROZEN RAW COUNTS\n",
    "    #\n",
    "    # File:\n",
    "    #     genes × donors\n",
    "    #\n",
    "    # PyDESeq2:\n",
    "    #     donors × genes\n",
    "    # ========================================================\n",
    "\n",
    "    raw = pd.read_csv(\n",
    "        counts_path,\n",
    "        compression=\"gzip\",\n",
    "        index_col=0\n",
    "    )\n",
    "\n",
    "\n",
    "    raw.index = pd.Index(\n",
    "        raw.index\n",
    "        .astype(str)\n",
    "        .tolist(),\n",
    "        dtype=\"object\"\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        raw.index.tolist()\n",
    "        ==\n",
    "        expected_gene_ids\n",
    "    )\n",
    "\n",
    "\n",
    "    assert raw.shape == (\n",
    "        expected_n_genes,\n",
    "        18\n",
    "    )\n",
    "\n",
    "\n",
    "    raw_array = raw.to_numpy()\n",
    "\n",
    "\n",
    "    assert np.isfinite(\n",
    "        raw_array\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    assert (\n",
    "        raw_array\n",
    "        >=\n",
    "        0\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    assert np.allclose(\n",
    "        raw_array,\n",
    "        np.round(\n",
    "            raw_array\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G4. LOAD FROZEN DONOR METADATA\n",
    "    # ========================================================\n",
    "\n",
    "    metadata = pd.read_csv(\n",
    "        metadata_path\n",
    "    )\n",
    "\n",
    "\n",
    "    required_metadata_columns = {\n",
    "\n",
    "        \"pseudobulk_group\",\n",
    "        \"donor_id\",\n",
    "        \"diagnosis_binary\",\n",
    "        \"age\",\n",
    "        \"sex\",\n",
    "        \"batch\",\n",
    "        \"PMI\",\n",
    "        \"RIN\",\n",
    "        \"n_nuclei\",\n",
    "        \"library_size\",\n",
    "\n",
    "    }\n",
    "\n",
    "\n",
    "    assert (\n",
    "        required_metadata_columns\n",
    "        <=\n",
    "        set(\n",
    "            metadata.columns\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        metadata\n",
    "    ) == 18\n",
    "\n",
    "\n",
    "    assert (\n",
    "        metadata[\n",
    "            \"donor_id\"\n",
    "        ]\n",
    "        .nunique()\n",
    "        ==\n",
    "        18\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        metadata[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        .value_counts()\n",
    "        .to_dict()\n",
    "        ==\n",
    "        {\n",
    "            \"AD\": 11,\n",
    "            \"Control\": 7,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        metadata[\n",
    "            \"n_nuclei\"\n",
    "        ]\n",
    "        >=\n",
    "        50\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G5. EXACT SAMPLE ORDER\n",
    "    # ========================================================\n",
    "\n",
    "    sample_order = (\n",
    "        metadata[\n",
    "            \"pseudobulk_group\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        raw.columns\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "        ==\n",
    "        sample_order\n",
    "    )\n",
    "\n",
    "\n",
    "    counts = (\n",
    "        raw.T\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    counts.index = pd.Index(\n",
    "        counts.index\n",
    "        .astype(str)\n",
    "        .tolist(),\n",
    "        dtype=\"object\"\n",
    "    )\n",
    "\n",
    "\n",
    "    counts.columns = pd.Index(\n",
    "        counts.columns\n",
    "        .astype(str)\n",
    "        .tolist(),\n",
    "        dtype=\"object\"\n",
    "    )\n",
    "\n",
    "\n",
    "    counts = counts.astype(\n",
    "        np.int64\n",
    "    )\n",
    "\n",
    "\n",
    "    assert counts.shape == (\n",
    "        18,\n",
    "        expected_n_genes\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        counts.index.tolist()\n",
    "        ==\n",
    "        sample_order\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        counts.columns.tolist()\n",
    "        ==\n",
    "        expected_gene_ids\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Counts:\",\n",
    "        counts.shape\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G6. PRIMARY DESIGN METADATA\n",
    "    #\n",
    "    # PRIMARY:\n",
    "    #   ~ age + sex + batch + diagnosis_binary\n",
    "    #\n",
    "    # Reference:\n",
    "    #   Control\n",
    "    #   Female\n",
    "    #   batch 1\n",
    "    # ========================================================\n",
    "\n",
    "    de_meta = (\n",
    "        metadata[\n",
    "            [\n",
    "                \"pseudobulk_group\",\n",
    "                \"donor_id\",\n",
    "                \"age\",\n",
    "                \"sex\",\n",
    "                \"batch\",\n",
    "                \"diagnosis_binary\",\n",
    "            ]\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta.index = pd.Index(\n",
    "        de_meta[\n",
    "            \"pseudobulk_group\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist(),\n",
    "        dtype=\"object\"\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta = de_meta.drop(\n",
    "        columns=[\n",
    "            \"pseudobulk_group\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta[\n",
    "        \"donor_id\"\n",
    "    ] = (\n",
    "        de_meta[\n",
    "            \"donor_id\"\n",
    "        ]\n",
    "        .astype(\n",
    "            \"object\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta[\n",
    "        \"age\"\n",
    "    ] = pd.to_numeric(\n",
    "        de_meta[\n",
    "            \"age\"\n",
    "        ],\n",
    "        errors=\"raise\"\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta[\n",
    "        \"sex\"\n",
    "    ] = pd.Categorical(\n",
    "        de_meta[\n",
    "            \"sex\"\n",
    "        ]\n",
    "        .astype(str),\n",
    "        categories=[\n",
    "            \"Female\",\n",
    "            \"Male\",\n",
    "        ],\n",
    "        ordered=False\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta[\n",
    "        \"batch\"\n",
    "    ] = pd.Categorical(\n",
    "        de_meta[\n",
    "            \"batch\"\n",
    "        ]\n",
    "        .astype(str),\n",
    "        categories=[\n",
    "            \"1\",\n",
    "            \"2\",\n",
    "            \"3\",\n",
    "        ],\n",
    "        ordered=False\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta[\n",
    "        \"diagnosis_binary\"\n",
    "    ] = pd.Categorical(\n",
    "        de_meta[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        .astype(str),\n",
    "        categories=[\n",
    "            \"Control\",\n",
    "            \"AD\",\n",
    "        ],\n",
    "        ordered=False\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        counts.index.equals(\n",
    "            de_meta.index\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        de_meta[\n",
    "            [\n",
    "                \"age\",\n",
    "                \"sex\",\n",
    "                \"batch\",\n",
    "                \"diagnosis_binary\",\n",
    "            ]\n",
    "        ]\n",
    "        .notna()\n",
    "        .all()\n",
    "        .all()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        de_meta[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        .value_counts()\n",
    "        .to_dict()\n",
    "        ==\n",
    "        {\n",
    "            \"AD\": 11,\n",
    "            \"Control\": 7,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Metadata:\",\n",
    "        de_meta.shape\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"AD = 11 | Control = 7\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Donor ordering verified: YES\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G7. CONSTRUCT DESEQ DATASET\n",
    "    # ========================================================\n",
    "\n",
    "    dds = DeseqDataSet(\n",
    "\n",
    "        counts=counts,\n",
    "\n",
    "        metadata=de_meta,\n",
    "\n",
    "        design=(\n",
    "            \"~ age + sex + batch + diagnosis_binary\"\n",
    "        ),\n",
    "\n",
    "        refit_cooks=True,\n",
    "\n",
    "        n_cpus=2,\n",
    "\n",
    "        quiet=False,\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"DeseqDataSet construction: PASS\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G8. VERIFY ACTUAL PYDESEQ2 DESIGN\n",
    "    # ========================================================\n",
    "\n",
    "    design_matrix = (\n",
    "        dds.obsm[\n",
    "            \"design_matrix\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    design_rank = int(\n",
    "        np.linalg.matrix_rank(\n",
    "            design_matrix.to_numpy()\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    design_columns = int(\n",
    "        design_matrix.shape[\n",
    "            1\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nPyDESeq2 design columns:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        design_matrix.columns.tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Design rank:\",\n",
    "        design_rank,\n",
    "        \"/\",\n",
    "        design_columns\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        design_rank\n",
    "        ==\n",
    "        design_columns\n",
    "        ==\n",
    "        6\n",
    "    )\n",
    "\n",
    "\n",
    "    diagnosis_columns = [\n",
    "\n",
    "        str(column)\n",
    "\n",
    "        for column\n",
    "        in design_matrix.columns\n",
    "\n",
    "        if (\n",
    "            \"diagnosis_binary\"\n",
    "            in str(\n",
    "                column\n",
    "            )\n",
    "        )\n",
    "\n",
    "    ]\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        diagnosis_columns\n",
    "    ) == 1\n",
    "\n",
    "\n",
    "    assert (\n",
    "        \"AD\"\n",
    "        in diagnosis_columns[\n",
    "            0\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G9. OUTPUT DIRECTORY\n",
    "    # ========================================================\n",
    "\n",
    "    class_dir = (\n",
    "        DE_ROOT /\n",
    "        cell_type\n",
    "    )\n",
    "\n",
    "\n",
    "    class_dir.mkdir(\n",
    "        parents=True,\n",
    "        exist_ok=True\n",
    "    )\n",
    "\n",
    "\n",
    "    design_matrix_path = (\n",
    "        class_dir /\n",
    "        (\n",
    "            f\"GSE174367_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"PRIMARY_AD_DISCOVERY_DESIGN_MATRIX_v1.csv\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    design_matrix.to_csv(\n",
    "        design_matrix_path\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G10. RUN DESEQ2\n",
    "    # ========================================================\n",
    "\n",
    "    print(\n",
    "        \"\\nRunning primary AD discovery DESeq2 fit...\"\n",
    "    )\n",
    "\n",
    "\n",
    "    dds.deseq2()\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Primary AD discovery DESeq2 fit complete.\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G11. SAVE SIZE FACTORS\n",
    "    # ========================================================\n",
    "\n",
    "    assert (\n",
    "        \"size_factors\"\n",
    "        in\n",
    "        dds.obs.columns\n",
    "    )\n",
    "\n",
    "\n",
    "    size_factors = (\n",
    "        dds.obs[\n",
    "            \"size_factors\"\n",
    "        ]\n",
    "        .to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        size_factors\n",
    "    ) == 18\n",
    "\n",
    "\n",
    "    assert np.isfinite(\n",
    "        size_factors\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    assert (\n",
    "        size_factors > 0\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    size_factor_table = pd.DataFrame({\n",
    "\n",
    "        \"pseudobulk_group\":\n",
    "            counts.index.tolist(),\n",
    "\n",
    "        \"donor_id\":\n",
    "            metadata[\n",
    "                \"donor_id\"\n",
    "            ]\n",
    "            .astype(str)\n",
    "            .tolist(),\n",
    "\n",
    "        \"diagnosis_binary\":\n",
    "            metadata[\n",
    "                \"diagnosis_binary\"\n",
    "            ]\n",
    "            .astype(str)\n",
    "            .tolist(),\n",
    "\n",
    "        \"size_factor\":\n",
    "            size_factors,\n",
    "\n",
    "    })\n",
    "\n",
    "\n",
    "    size_factor_path = (\n",
    "        class_dir /\n",
    "        (\n",
    "            f\"GSE174367_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"DESEQ2_SIZE_FACTORS_v1.csv\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    size_factor_table.to_csv(\n",
    "        size_factor_path,\n",
    "        index=False\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G12. AD vs CONTROL WALD TEST\n",
    "    #\n",
    "    # Positive LFC:\n",
    "    #     higher in AD\n",
    "    #\n",
    "    # Negative LFC:\n",
    "    #     lower in AD\n",
    "    # ========================================================\n",
    "\n",
    "    stats = DeseqStats(\n",
    "\n",
    "        dds,\n",
    "\n",
    "        contrast=[\n",
    "            \"diagnosis_binary\",\n",
    "            \"AD\",\n",
    "            \"Control\",\n",
    "        ],\n",
    "\n",
    "        alpha=0.05,\n",
    "\n",
    "        cooks_filter=True,\n",
    "\n",
    "        independent_filter=True,\n",
    "\n",
    "        n_cpus=2,\n",
    "\n",
    "        quiet=False,\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    captured_summary = io.StringIO()\n",
    "\n",
    "\n",
    "    with contextlib.redirect_stdout(\n",
    "        captured_summary\n",
    "    ):\n",
    "\n",
    "        stats.summary()\n",
    "\n",
    "\n",
    "    results = (\n",
    "        stats.results_df\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G13. RESULT INTEGRITY\n",
    "    # ========================================================\n",
    "\n",
    "    results.index = pd.Index(\n",
    "        results.index\n",
    "        .astype(str)\n",
    "        .tolist(),\n",
    "        dtype=\"object\"\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        results.index.is_unique\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        set(\n",
    "            results.index\n",
    "        )\n",
    "        ==\n",
    "        set(\n",
    "            expected_gene_ids\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    # Restore exact frozen universe order.\n",
    "    results = (\n",
    "        results.loc[\n",
    "            expected_gene_ids\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        results.index.tolist()\n",
    "        ==\n",
    "        expected_gene_ids\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        results\n",
    "    ) == expected_n_genes\n",
    "\n",
    "\n",
    "    required_result_columns = [\n",
    "\n",
    "        \"baseMean\",\n",
    "        \"log2FoldChange\",\n",
    "        \"lfcSE\",\n",
    "        \"stat\",\n",
    "        \"pvalue\",\n",
    "        \"padj\",\n",
    "\n",
    "    ]\n",
    "\n",
    "\n",
    "    missing_result_columns = [\n",
    "\n",
    "        column\n",
    "\n",
    "        for column\n",
    "        in required_result_columns\n",
    "\n",
    "        if (\n",
    "            column\n",
    "            not in\n",
    "            results.columns\n",
    "        )\n",
    "\n",
    "    ]\n",
    "\n",
    "\n",
    "    assert not missing_result_columns, (\n",
    "        f\"{cell_type}: missing DE columns \"\n",
    "        f\"{missing_result_columns}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    results.index.name = (\n",
    "        \"gene_id\"\n",
    "    )\n",
    "\n",
    "\n",
    "    results = (\n",
    "        results[\n",
    "            required_result_columns\n",
    "        ]\n",
    "        .reset_index()\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G14. ADD FROZEN ANNOTATION\n",
    "    # ========================================================\n",
    "\n",
    "    annotation = (\n",
    "        universe[\n",
    "            [\n",
    "                \"gene_id\",\n",
    "                \"gene_symbol\",\n",
    "                \"gene_symbol_unique_in_GSE174367\",\n",
    "                \"feature_type\",\n",
    "            ]\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    results = results.merge(\n",
    "\n",
    "        annotation,\n",
    "\n",
    "        on=\"gene_id\",\n",
    "\n",
    "        how=\"left\",\n",
    "\n",
    "        validate=\"one_to_one\"\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        results[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .notna()\n",
    "        .all()\n",
    "    )\n",
    "\n",
    "\n",
    "    results = results[\n",
    "        [\n",
    "            \"gene_id\",\n",
    "            \"gene_symbol\",\n",
    "            \"gene_symbol_unique_in_GSE174367\",\n",
    "            \"feature_type\",\n",
    "\n",
    "            \"baseMean\",\n",
    "            \"log2FoldChange\",\n",
    "            \"lfcSE\",\n",
    "            \"stat\",\n",
    "            \"pvalue\",\n",
    "            \"padj\",\n",
    "        ]\n",
    "    ]\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G15. PREDECLARED RANK VECTOR\n",
    "    # ========================================================\n",
    "\n",
    "    results[\n",
    "        \"rank_stat\"\n",
    "    ] = results[\n",
    "        \"stat\"\n",
    "    ]\n",
    "\n",
    "\n",
    "    results[\n",
    "        \"cell_type\"\n",
    "    ] = cell_type\n",
    "\n",
    "\n",
    "    results[\n",
    "        \"contrast\"\n",
    "    ] = \"AD_vs_Control\"\n",
    "\n",
    "\n",
    "    results[\n",
    "        \"dataset\"\n",
    "    ] = \"GSE174367\"\n",
    "\n",
    "\n",
    "    results[\n",
    "        \"model\"\n",
    "    ] = (\n",
    "        \"age+sex+batch+diagnosis\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G16. SAVE ALL TESTED GENES FIRST\n",
    "    # ========================================================\n",
    "\n",
    "    all_gene_path = (\n",
    "        class_dir /\n",
    "        (\n",
    "            f\"GSE174367_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"AD_vs_Control_\"\n",
    "            f\"PRIMARY_DISCOVERY_ALL_GENES_v1.csv.gz\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    results.to_csv(\n",
    "\n",
    "        all_gene_path,\n",
    "\n",
    "        index=False,\n",
    "\n",
    "        compression={\n",
    "            \"method\":\n",
    "                \"gzip\",\n",
    "\n",
    "            \"compresslevel\":\n",
    "                6,\n",
    "        }\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert all_gene_path.exists()\n",
    "\n",
    "\n",
    "    all_gene_file_hash = (\n",
    "        sha256_file(\n",
    "            all_gene_path\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    effect_content_hash = (\n",
    "        ordered_effect_hash(\n",
    "            results\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nComplete all-gene AD discovery result saved.\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G17. FINITE / FDR COUNTS\n",
    "    # ========================================================\n",
    "\n",
    "    finite_lfc = np.isfinite(\n",
    "        results[\n",
    "            \"log2FoldChange\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    finite_stat = np.isfinite(\n",
    "        results[\n",
    "            \"stat\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    finite_p = np.isfinite(\n",
    "        results[\n",
    "            \"pvalue\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    finite_padj = np.isfinite(\n",
    "        results[\n",
    "            \"padj\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    sig_mask = (\n",
    "        finite_padj\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            results[\n",
    "                \"padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    significant = (\n",
    "        results.loc[\n",
    "            sig_mask\n",
    "        ]\n",
    "        .copy()\n",
    "        .sort_values(\n",
    "            [\n",
    "                \"padj\",\n",
    "                \"pvalue\",\n",
    "            ],\n",
    "            ascending=[\n",
    "                True,\n",
    "                True,\n",
    "            ]\n",
    "        )\n",    "    )\n",
    "\n",
    "\n",
    "    n_sig = int(\n",
    "        sig_mask.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_up = int(\n",
    "        (\n",
    "            significant[\n",
    "                \"log2FoldChange\"\n",
    "            ]\n",
    "            >\n",
    "            0\n",
    "        ).sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_down = int(\n",
    "        (\n",
    "            significant[\n",
    "                \"log2FoldChange\"\n",
    "            ]\n",
    "            <\n",
    "            0\n",
    "        ).sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G18. SAVE FDR TABLE\n",
    "    #\n",
    "    # Convenience output only.\n",
    "    # Primary inference is all tested genes + BH.\n",
    "    # ========================================================\n",
    "\n",
    "    fdr_path = (\n",
    "        class_dir /\n",
    "        (\n",
    "            f\"GSE174367_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"AD_vs_Control_\"\n",
    "            f\"PRIMARY_DISCOVERY_FDR05_v1.csv.gz\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    significant.to_csv(\n",
    "\n",
    "        fdr_path,\n",
    "\n",
    "        index=False,\n",
    "\n",
    "        compression={\n",
    "            \"method\":\n",
    "                \"gzip\",\n",
    "\n",
    "            \"compresslevel\":\n",
    "                6,\n",
    "        }\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G19. SAVE COMPLETE WALD RANK VECTOR\n",
    "    # ========================================================\n",
    "\n",
    "    rank_table = (\n",
    "        results[\n",
    "            [\n",
    "                \"gene_id\",\n",
    "                \"gene_symbol\",\n",
    "                \"gene_symbol_unique_in_GSE174367\",\n",
    "                \"rank_stat\",\n",
    "                \"log2FoldChange\",\n",
    "                \"pvalue\",\n",
    "                \"padj\",\n",
    "            ]\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    rank_path = (\n",
    "        class_dir /\n",
    "        (\n",
    "            f\"GSE174367_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"AD_vs_Control_\"\n",
    "            f\"WALD_RANK_VECTOR_v1.csv.gz\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    rank_table.to_csv(\n",
    "\n",
    "        rank_path,\n",
    "\n",
    "        index=False,\n",
    "\n",
    "        compression={\n",
    "            \"method\":\n",
    "                \"gzip\",\n",
    "\n",
    "            \"compresslevel\":\n",
    "                6,\n",
    "        }\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G20. SAVE DESEQ2 TEXT SUMMARY\n",
    "    # ========================================================\n",
    "\n",
    "    summary_text_path = (\n",
    "        class_dir /\n",
    "        (\n",
    "            f\"GSE174367_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"DESEQ2_SUMMARY_OUTPUT_v1.txt\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    with open(\n",
    "        summary_text_path,\n",
    "        \"w\",\n",
    "        encoding=\"utf-8\"\n",
    "    ) as f:\n",
    "\n",
    "        f.write(\n",
    "            captured_summary.getvalue()\n",
    "        )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G21. CREATE IMMUTABLE AD DISCOVERY EFFECT VECTOR\n",
    "    # ========================================================\n",
    "\n",
    "    frozen_effect = (\n",
    "        results[\n",
    "            [\n",
    "                \"gene_id\",\n",
    "                \"gene_symbol\",\n",
    "                \"gene_symbol_unique_in_GSE174367\",\n",
    "\n",
    "                \"baseMean\",\n",
    "                \"log2FoldChange\",\n",
    "                \"lfcSE\",\n",
    "                \"stat\",\n",
    "                \"pvalue\",\n",
    "                \"padj\",\n",
    "            ]\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    frozen_effect = frozen_effect.rename(\n",
    "        columns={\n",
    "\n",
    "            \"log2FoldChange\":\n",
    "                \"AD_vs_Control_log2FC\",\n",
    "\n",
    "            \"lfcSE\":\n",
    "                \"AD_vs_Control_lfcSE\",\n",
    "\n",
    "            \"stat\":\n",
    "                \"AD_vs_Control_Wald\",\n",
    "\n",
    "            \"pvalue\":\n",
    "                \"AD_vs_Control_pvalue\",\n",
    "\n",
    "            \"padj\":\n",
    "                \"AD_vs_Control_padj\",\n",
    "\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    frozen_effect.insert(\n",
    "        0,\n",
    "        \"cell_type\",\n",
    "        cell_type\n",
    "    )\n",
    "\n",
    "\n",
    "    frozen_effect[\n",
    "        \"discovery_primary_FDR05\"\n",
    "    ] = (\n",
    "        np.isfinite(\n",
    "            frozen_effect[\n",
    "                \"AD_vs_Control_padj\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            frozen_effect[\n",
    "                \"AD_vs_Control_padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    effect_path = (\n",
    "        FREEZE_ROOT /\n",
    "        (\n",
    "            f\"GSE174367_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"AD_DISCOVERY_EFFECT_VECTOR_v1.csv.gz\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    frozen_effect.to_csv(\n",
    "\n",
    "        effect_path,\n",
    "\n",
    "        index=False,\n",
    "\n",
    "        compression={\n",
    "            \"method\":\n",
    "                \"gzip\",\n",
    "\n",
    "            \"compresslevel\":\n",
    "                6,\n",
    "        }\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    effect_file_hash = (\n",
    "        sha256_file(\n",
    "            effect_path\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G22. RECORDS\n",
    "    # ========================================================\n",
    "\n",
    "    run_records[\n",
    "        cell_type\n",
    "    ] = {\n",
    "\n",
    "        \"dataset\":\n",
    "            \"GSE174367\",\n",
    "\n",
    "        \"cell_type\":\n",
    "            cell_type,\n",
    "\n",
    "        \"model\":\n",
    "            \"~ age + sex + batch + diagnosis_binary\",\n",
    "\n",
    "        \"contrast\":\n",
    "            \"AD_vs_Control\",\n",
    "\n",
    "        \"reference_diagnosis\":\n",
    "            \"Control\",\n",
    "\n",
    "        \"reference_sex\":\n",
    "            \"Female\",\n",
    "\n",
    "        \"reference_batch\":\n",
    "            \"1\",\n",
    "\n",
    "        \"n_AD\":\n",
    "            11,\n",
    "\n",
    "        \"n_Control\":\n",
    "            7,\n",
    "\n",
    "        \"n_total_donors\":\n",
    "            18,\n",
    "\n",
    "        \"n_tested_genes\":\n",
    "            int(\n",
    "                expected_n_genes\n",
    "            ),\n",
    "\n",
    "        \"frozen_gene_universe_sha256\":\n",
    "            expected_feature_hash,\n",
    "\n",
    "        \"raw_counts_file_sha256\":\n",
    "            sha256_file(\n",
    "                counts_path\n",
    "            ),\n",
    "\n",
    "        \"design_rank\":\n",
    "            int(\n",
    "                design_rank\n",
    "            ),\n",
    "\n",
    "        \"design_columns\":\n",
    "            int(\n",
    "                design_columns\n",
    "            ),\n",
    "\n",
    "        \"n_finite_log2FoldChange\":\n",
    "            int(\n",
    "                finite_lfc.sum()\n",
    "            ),\n",
    "\n",
    "        \"n_finite_Wald\":\n",
    "            int(\n",
    "                finite_stat.sum()\n",
    "            ),\n",
    "\n",
    "        \"n_finite_pvalue\":\n",
    "            int(\n",
    "                finite_p.sum()\n",
    "            ),\n",
    "\n",
    "        \"n_finite_padj\":\n",
    "            int(\n",
    "                finite_padj.sum()\n",
    "            ),\n",
    "\n",
    "        \"n_FDR_lt_0_05\":\n",
    "            n_sig,\n",
    "\n",
    "        \"n_FDR_lt_0_05_up_in_AD\":\n",
    "            n_up,\n",
    "\n",
    "        \"n_FDR_lt_0_05_down_in_AD\":\n",
    "            n_down,\n",
    "\n",
    "        \"all_gene_results\":\n",
    "            str(\n",
    "                all_gene_path\n",
    "            ),\n",
    "\n",
    "        \"all_gene_results_sha256\":\n",
    "            all_gene_file_hash,\n",
    "\n",
    "        \"effect_content_sha256\":\n",
    "            effect_content_hash,\n",
    "\n",
    "        \"FDR05_results\":\n",
    "            str(\n",
    "                fdr_path\n",
    "            ),\n",
    "\n",
    "        \"rank_vector\":\n",
    "            str(\n",
    "                rank_path\n",
    "            ),\n",
    "\n",
    "        \"size_factors\":\n",
    "            str(\n",
    "                size_factor_path\n",
    "            ),\n",
    "\n",
    "        \"design_matrix\":\n",
    "            str(\n",
    "                design_matrix_path\n",
    "            ),\n",
    "\n",
    "        \"DESeq2_summary_text\":\n",
    "            str(\n",
    "                summary_text_path\n",
    "            ),\n",
    "    }\n",
    "\n",
    "\n",
    "    freeze_records[\n",
    "        cell_type\n",
    "    ] = {\n",
    "\n",
    "        \"dataset\":\n",
    "            \"GSE174367\",\n",
    "\n",
    "        \"cell_type\":\n",
    "            cell_type,\n",
    "\n",
    "        \"n_tested_genes\":\n",
    "            int(\n",
    "                expected_n_genes\n",
    "            ),\n",
    "\n",
    "        \"n_discovery_FDR05\":\n",
    "            n_sig,\n",
    "\n",
    "        \"effect_vector_file\":\n",
    "            str(\n",
    "                effect_path\n",
    "            ),\n",
    "\n",
    "        \"effect_vector_file_sha256\":\n",
    "            effect_file_hash,\n",
    "\n",
    "        \"source_all_gene_result_sha256\":\n",
    "            all_gene_file_hash,\n",
    "\n",
    "        \"gene_universe_sha256\":\n",
    "            expected_feature_hash,\n",
    "    }\n",
    "\n",
    "\n",
    "    summary_rows.append({\n",
    "\n",
    "        \"cell_type\":\n",
    "            cell_type,\n",
    "\n",
    "        \"AD\":\n",
    "            11,\n",
    "\n",
    "        \"Control\":\n",
    "            7,\n",
    "\n",
    "        \"tested_genes\":\n",
    "            int(\n",
    "                expected_n_genes\n",
    "            ),\n",
    "\n",
    "        \"finite_pvalue\":\n",
    "            int(\n",
    "                finite_p.sum()\n",
    "            ),\n",
    "\n",
    "        \"finite_padj\":\n",
    "            int(\n",
    "                finite_padj.sum()\n",
    "            ),\n",
    "\n",
    "        \"FDR_lt_0.05\":\n",
    "            n_sig,\n",
    "\n",
    "        \"up_in_AD\":\n",
    "            n_up,\n",
    "\n",
    "        \"down_in_AD\":\n",
    "            n_down,\n",
    "    })\n",
    "\n",
    "\n",
    "    all_effect_tables.append(\n",
    "        frozen_effect\n",
    "    )\n",
    "\n",
    "\n",
    "    all_fdr_tables.append(\n",
    "        frozen_effect[\n",
    "            frozen_effect[\n",
    "                \"discovery_primary_FDR05\"\n",
    "            ]\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G23. PRINT AGGREGATES ONLY\n",
    "    #\n",
    "    # No top-gene inspection before final freeze.\n",
    "    # ========================================================\n",
    "\n",
    "    print(\n",
    "        \"\\nAD discovery result integrity:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Tested genes:\",\n",
    "        f\"{expected_n_genes:,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Finite p-values:\",\n",
    "        f\"{int(finite_p.sum()):,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Finite adjusted p-values:\",\n",
    "        f\"{int(finite_padj.sum()):,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  FDR < 0.05:\",\n",
    "        f\"{n_sig:,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Up in AD:\",\n",
    "        f\"{n_up:,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Down in AD:\",\n",
    "        f\"{n_down:,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Effect content SHA256:\",\n",
    "        effect_content_hash\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
