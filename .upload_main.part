    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. CROSS-CELL FDR OVERLAP — DESCRIPTIVE ONLY\n",
    "#\n",
    "# This does NOT define convergence yet.\n",
    "# It simply reports overlap among significant PD genes.\n",
    "# ============================================================\n",
    "\n",
    "sig_sets = {}\n",
    "\n",
    "\n",
    "for cell_type in PRIMARY_CLASSES:\n",
    "\n",
    "    result_path = Path(\n",
    "        run_lock[\n",
    "            \"cell_class_results\"\n",
    "        ][\n",
    "            cell_type\n",
