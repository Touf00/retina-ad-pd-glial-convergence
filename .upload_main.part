    "\n",
    "print(\n",
    "    \"Pandas StringDtype(na_value=...) compatibility: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# B. PROJECT PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = ROOT / \"locks\"\n",
    "MANIFESTS = ROOT / \"manifests\"\n",
