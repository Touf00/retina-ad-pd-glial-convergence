   "source": [
    "# Source analysis cell: 46\n",
    "# ============================================================\n",
    "# STEP 25 — GSE157827 REPLICATION DONOR METADATA\n",
    "#           + AUTHOR-QC REPRODUCTION\n",
    "#           + COVARIATE POLICY FREEZE\n",
    "#\n",
    "# INPUTS\n",
    "# ------\n",
    "# Official GEO:\n",
    "#   21 Cell Ranger filtered matrices\n",
    "#   179,392 raw filtered barcodes\n",
    "#   33,538 identical features/sample\n",
    "#\n",
    "# Published supplementary metadata:\n",
    "#   pnas.2008762117.sd01.xlsx\n",
    "#\n",
    "#   Patient_info:\n",
    "#       donor demographics / PMD / pathology\n",
    "#\n",
    "#   snRNAseq_QC:\n",
    "#       author's post-QC nuclei/sample\n",
    "#\n",
    "# AUTHOR'S WRITTEN SECOND-ROUND QC\n",
    "# --------------------------------\n",
    "# REMOVE nuclei with:\n",
    "#\n",
    "#     nFeature <= 200\n",
    "#     OR\n",
    "#     nUMI >= 20,000\n",
    "#     OR\n",
    "#     percent mitochondrial >= 20%\n",
    "#\n",
    "# Therefore KEEP:\n",
    "#\n",
    "#     nFeature > 200\n",
    "#     AND\n",
    "#     nUMI < 20,000\n",
    "#     AND\n",
    "#     percent mitochondrial < 20%\n",
    "#\n",
    "# AUTHOR REFERENCE:\n",
    "#     169,496 nuclei\n",
    "#     29,171 genes in final filtered matrix\n",
    "#\n",
    "# IMPORTANT\n",
    "# ---------\n",
    "# - No disease-dependent filtering.\n",
    "# - No clustering.\n",
    "# - No normalization.\n",
    "# - No HVG selection.\n",
    "# - No batch correction.\n",
    "# - No cell-type annotation.\n",
    "# - No OPC separation.\n",
    "# - No gene filtering for DE.\n",
    "# - No pseudobulk.\n",
    "# - No replication DE.\n",
    "# - No comparison to GSE174367.\n",
    "# - No PD data.\n",
    "# - No AD↔PD convergence.\n",
    "#\n",
    "# COVARIATE POLICY FROZEN HERE\n",
    "# ----------------------------\n",
    "# Primary replication covariates:\n",
    "#     age + sex\n",
    "#\n",
    "# Technical sensitivity:\n",
    "#     age + sex + PMD\n",
    "#\n",
    "# Diagnosis is the final coefficient/contrast later.\n",
    "#\n",
    "# Pathology/APOE are descriptive/supporting variables,\n",
    "# NOT AD-vs-Control adjustment covariates.\n",
    "#\n",
    "# Age-overlap sensitivity will NOT be used if common support\n",
    "# leaves too few AD donors; audited below.\n",
    "#\n",
    "# Final per-cell-class design feasibility will be rechecked\n",
    "# after disease-blind cell annotation and donor coverage.\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "from scipy.io import mmread\n",
    "\n",
    "import scipy\n",
    "import gzip\n",
    "import hashlib\n",
    "import json\n",
    "import gc\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = ROOT / \"locks\"\n",
    "MANIFESTS = ROOT / \"manifests\"\n",
    "\n",
    "REP_DIR = (\n",
    "    ROOT /\n",
    "    \"GSE157827_AD_replication\"\n",
    ")\n",
    "\n",
    "SUPP_DIR = (\n",
    "    REP_DIR /\n",
    "    \"Lau2020_supplementary\"\n",
    ")\n",
    "\n",
    "QC_DIR = (\n",
    "    REP_DIR /\n",
    "    \"QC\"\n",
    ")\n",
    "\n",
    "\n",
    "for directory in [\n",
    "    LOCKS,\n",
    "    MANIFESTS,\n",
    "    REP_DIR,\n",
    "    QC_DIR,\n",
    "]:\n",
    "\n",
    "    directory.mkdir(\n",
    "        parents=True,\n",
    "        exist_ok=True\n",
    "    )\n",
    "\n",
    "\n",
    "RAW_AUDIT_LOCK_PATH = (\n",
    "    LOCKS /\n",
    "    \"GSE157827_AD_REPLICATION_RAW_DATA_AUDIT_v1.json\"\n",
    ")\n",
    "\n",
    "ROLE_LOCK_PATH = (\n",
    "    LOCKS /\n",
    "    \"AD_BRAIN_DATASET_ROLES_v1.json\"\n",
    ")\n",
    "\n",
    "DISCOVERY_ROBUSTNESS_LOCK_PATH = (\n",
    "    LOCKS /\n",
    "    \"GSE174367_AD_DISCOVERY_FINAL_ROBUSTNESS_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "SAMPLE_MANIFEST_PATH = (\n",
    "    MANIFESTS /\n",
    "    \"GSE157827_OFFICIAL_RAW_SAMPLE_MANIFEST_v1.csv\"\n",
    ")\n",
    "\n",
    "SD01_PATH = (\n",
    "    SUPP_DIR /\n",
    "    \"pnas.2008762117.sd01.xlsx\"\n",
    ")\n",
    "\n",
    "\n",
    "DONOR_METADATA_PATH = (\n",
    "    MANIFESTS /\n",
    "    \"GSE157827_DONOR_METADATA_FROZEN_v1.csv\"\n",
    ")\n",
    "\n",
    "AUTHOR_QC_REFERENCE_PATH = (\n",
    "    MANIFESTS /\n",
    "    \"GSE157827_AUTHOR_POST_QC_SAMPLE_REFERENCE_v1.csv\"\n",
    ")\n",
    "\n",
    "FEATURE_METADATA_PATH = (\n",
    "    MANIFESTS /\n",
    "    \"GSE157827_FEATURE_METADATA_AUDITED_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "CELL_QC_MANIFEST_PATH = (\n",
    "    QC_DIR /\n",
    "    \"GSE157827_NUCLEUS_QC_MANIFEST_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "SAMPLE_QC_COMPARISON_PATH = (\n",
    "    QC_DIR /\n",
    "    \"GSE157827_AUTHOR_QC_REPRODUCTION_BY_SAMPLE_v1.csv\"\n",
    ")\n",
    "\n",
    "QC_PASS_BARCODES_PATH = (\n",
    "    QC_DIR /\n",
    "    \"GSE157827_QC_PASS_BARCODES_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "QC_FAILURE_REASON_PATH = (\n",
    "    QC_DIR /\n",
    "    \"GSE157827_QC_FAILURE_REASON_SUMMARY_v1.csv\"\n",
    ")\n",
    "\n",
    "DESIGN_AUDIT_PATH = (\n",
    "    MANIFESTS /\n",
    "    \"GSE157827_REPLICATION_COVARIATE_DESIGN_AUDIT_v1.csv\"\n",
    ")\n",
    "\n",
    "STEP25_LOCK_PATH = (\n",
    "    LOCKS /\n",
    "    \"GSE157827_AD_REPLICATION_DONOR_METADATA_AND_QC_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "    RAW_AUDIT_LOCK_PATH,\n",
    "    ROLE_LOCK_PATH,\n",
    "    DISCOVERY_ROBUSTNESS_LOCK_PATH,\n",
    "    SAMPLE_MANIFEST_PATH,\n",
    "    SD01_PATH,\n",
    "]:\n",
    "\n",
    "    assert path.exists(), (\n",
    "        f\"Missing required STEP-25 input: {path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. HELPERS\n",
    "# ============================================================\n",
    "\n",
    "def sha256_file(\n",
    "    path,\n",
    "    block_size=1024 * 1024\n",
    "):\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\"\n",
    "    ) as f:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            block = f.read(\n",
    "                block_size\n",
    "            )\n",
    "\n",
    "            if not block:\n",
    "                break\n",
    "\n",
    "            h.update(\n",
    "                block\n",
    "            )\n",
    "\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "def standardized_condition_number(\n",
    "    X,\n",
    "    continuous_column_indices\n",
    "):\n",
    "\n",
    "    Z = np.asarray(\n",
    "        X,\n",
    "        dtype=float\n",
    "    ).copy()\n",
    "\n",
    "\n",
    "    for column_index in continuous_column_indices:\n",
    "\n",
    "        values = Z[\n",
    "            :,\n",
    "            column_index\n",
    "        ]\n",
    "\n",
    "        sd = float(\n",
    "            values.std(\n",
    "                ddof=0\n",
    "            )\n",
    "        )\n",
    "\n",
    "        assert sd > 0\n",
    "\n",
    "        Z[\n",
    "            :,\n",
    "            column_index\n",
    "        ] = (\n",
    "            values\n",
    "            -\n",
    "            values.mean()\n",
    "        ) / sd\n",
    "\n",
    "\n",
    "    return float(\n",
    "        np.linalg.cond(\n",
    "            Z\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. VERIFY UPSTREAM LOCKS\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    RAW_AUDIT_LOCK_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    raw_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    ROLE_LOCK_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    role_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    DISCOVERY_ROBUSTNESS_LOCK_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    discovery_lock = json.load(f)\n",
    "\n",
    "\n",
    "assert (\n",
    "    raw_lock[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"AD_REPLICATION_RAW_DATA_AUDIT_COMPLETE\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    role_lock[\n",
    "        \"primary_replication\"\n",
    "    ][\n",
    "        \"dataset\"\n",
    "    ]\n",
    "    ==\n",
    "    \"GSE157827\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    discovery_lock[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"AD_DISCOVERY_FINAL_ROBUSTNESS_FROZEN\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    raw_lock[\n",
    "        \"replication_DE_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    raw_lock[\n",
    "        \"discovery_vs_replication_compared\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    raw_lock[\n",
    "        \"AD_PD_convergence_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"UPSTREAM REPLICATION LOCKS VERIFIED\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. LOAD OFFICIAL SAMPLE MANIFEST\n",
    "# ============================================================\n",
    "\n",
    "sample_manifest = pd.read_csv(\n",
    "    SAMPLE_MANIFEST_PATH\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    sample_manifest\n",
    ") == 21\n",
    "\n",
    "\n",
    "assert (\n",
    "    sample_manifest[\n",
    "        \"sample_id\"\n",
    "    ]\n",
    "    .is_unique\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    sample_manifest[\n",
    "        \"GSM\"\n",
    "    ]\n",
    "    .is_unique\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    sample_manifest[\n",
    "        \"diagnosis_binary\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    "    ==\n",
    "    {\n",
    "        \"AD\": 12,\n",
    "        \"Control\": 9,\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "assert int(\n",
    "    sample_manifest[\n",
    "        \"raw_filtered_barcodes\"\n",
    "    ]\n",
    "    .sum()\n",
    ") == 179392\n",
    "\n",
    "\n",
    "EXPECTED_SAMPLE_IDS = (\n",
    "    sample_manifest[\n",
    "        \"sample_id\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .tolist()\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. LOAD ACTUAL SUPPLEMENTARY PATIENT METADATA\n",
    "# ============================================================\n",
    "\n",
    "patient_info = pd.read_excel(\n",
    "    SD01_PATH,\n",
    "    sheet_name=\"Patient_info\",\n",
    "    header=0,\n",
    "    dtype=object,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPatient_info columns:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    patient_info.columns.tolist()\n",
    ")\n",
    "\n",
    "\n",
    "EXPECTED_PATIENT_COLUMNS = [\n",
    "\n",
    "    \"ID\",\n",
    "    \"CONDITION\",\n",
    "    \"AGE\",\n",
    "    \"SEX\",\n",
    "    \"PMD\",\n",
    "    \"HIST DIAGNOSIS\",\n",
    "    \"DIAG 1\",\n",
    "    \"DIAG 2\",\n",
    "    \"DIAG 3\",\n",
    "    \"AGE-RELATED PLAQUE SCORE\",\n",
    "    \"Braak tangle stage\",\n",
    "    \"APOE\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "assert (\n",
    "    patient_info.columns.tolist()\n",
    "    ==\n",
    "    EXPECTED_PATIENT_COLUMNS\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    patient_info\n",
    ") == 21\n",
    "\n",
    "\n",
    "patient_info[\n",
    "    \"ID\"\n",
    "] = (\n",
    "    patient_info[\n",
    "        \"ID\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    set(\n",
    "        patient_info[\n",
    "            \"ID\"\n",
    "        ]\n",
    "    )\n",
    "    ==\n",
    "    set(\n",
    "        EXPECTED_SAMPLE_IDS\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    patient_info[\n",
    "        \"ID\"\n",
    "    ]\n",
    "    .is_unique\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. CANONICAL DONOR METADATA\n",
    "# ============================================================\n",
    "\n",
    "CONDITION_MAP = {\n",
    "\n",
    "    \"AD\":\n",
    "        \"AD\",\n",
    "\n",
    "    \"NC\":\n",
    "        \"Control\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "SEX_MAP = {\n",
    "\n",
    "    \"M\":\n",
    "        \"Male\",\n",
    "\n",
    "    \"F\":\n",
    "        \"Female\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "donor_meta = pd.DataFrame({\n",
    "\n",
    "    \"donor_id\":\n",
    "        patient_info[\n",
    "            \"ID\"\n",
    "        ]\n",
    "        .astype(str),\n",
    "\n",
    "    \"diagnosis_binary\":\n",
    "        patient_info[\n",
    "            \"CONDITION\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .str.strip()\n",
    "        .map(\n",
    "            CONDITION_MAP\n",
    "        ),\n",
    "\n",
    "    \"age\":\n",
    "        pd.to_numeric(\n",
    "            patient_info[\n",
    "                \"AGE\"\n",
    "            ],\n",
    "            errors=\"raise\"\n",
    "        ),\n",
    "\n",
    "    \"sex\":\n",
    "        patient_info[\n",
    "            \"SEX\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .str.strip()\n",
    "        .map(\n",
    "            SEX_MAP\n",
    "        ),\n",
    "\n",
    "    \"PMD_hours\":\n",
    "        pd.to_numeric(\n",
    "            patient_info[\n",
    "                \"PMD\"\n",
    "            ],\n",
    "            errors=\"raise\"\n",
    "        ),\n",
    "\n",
    "    \"hist_diagnosis\":\n",
    "        patient_info[\n",
    "            \"HIST DIAGNOSIS\"\n",
    "        ],\n",
    "\n",
    "    \"diag_1\":\n",
    "        patient_info[\n",
    "            \"DIAG 1\"\n",
    "        ],\n",
    "\n",
    "    \"diag_2\":\n",
    "        patient_info[\n",
    "            \"DIAG 2\"\n",
    "        ],\n",
    "\n",
    "    \"diag_3\":\n",
    "        patient_info[\n",
    "            \"DIAG 3\"\n",
    "        ],\n",
    "\n",
    "    \"age_related_plaque_score\":\n",
    "        patient_info[\n",
    "            \"AGE-RELATED PLAQUE SCORE\"\n",
    "        ],\n",
    "\n",
    "    \"braak_tangle_stage\":\n",
    "        pd.to_numeric(\n",
    "            patient_info[\n",
    "                \"Braak tangle stage\"\n",
    "            ],\n",
    "            errors=\"coerce\"\n",
    "        ),\n",
    "\n",
    "    \"APOE\":\n",
    "        patient_info[\n",
    "            \"APOE\"\n",
    "        ],\n",
    "\n",
    "})\n",
    "\n",
    "\n",
    "assert (\n",
    "    donor_meta[\n",
    "        [\n",
    "            \"donor_id\",\n",
    "            \"diagnosis_binary\",\n",
    "            \"age\",\n",
    "            \"sex\",\n",
    "            \"PMD_hours\",\n",
    "        ]\n",
    "    ]\n",
    "    .notna()\n",
    "    .all()\n",
    "    .all()\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    donor_meta[\n",
    "        \"diagnosis_binary\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    "    ==\n",
    "    {\n",
    "        \"AD\": 12,\n",
    "        \"Control\": 9,\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. ADD GSM + RAW BARCODE COUNTS\n",
    "# ============================================================\n",
    "\n",
    "donor_meta = (\n",
    "\n",
    "    donor_meta\n",
    "    .merge(\n",
    "\n",
    "        sample_manifest[\n",
    "            [\n",
    "                \"GSM\",\n",
    "                \"sample_id\",\n",
    "                \"raw_filtered_barcodes\",\n",
    "            ]\n",
    "        ]\n",
    "        .rename(\n",
    "            columns={\n",
    "                \"sample_id\":\n",
    "                    \"donor_id\"\n",
    "            }\n",
    "        ),\n",
    "\n",    "        on=\"donor_id\",\n",
    "\n",
    "        how=\"left\",\n",
    "\n",
    "        validate=\"one_to_one\",\n",
    "\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    donor_meta[\n",
    "        \"GSM\"\n",
    "    ]\n",
    "    .notna()\n",
    "    .all()\n",
    ")\n",
    "\n",
    "\n",
    "# Preserve official sample-manifest order.\n",
    "sample_order_map = {\n",
    "\n",
    "    sample:\n",
    "        index\n",
    "\n",
    "    for index, sample\n",
    "    in enumerate(\n",
    "        EXPECTED_SAMPLE_IDS\n",
    "    )\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "donor_meta[\n",
    "    \"_order\"\n",
    "] = (\n",
    "    donor_meta[\n",
    "        \"donor_id\"\n",
    "    ]\n",
    "    .map(\n",
    "        sample_order_map\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "donor_meta = (\n",
    "\n",
    "    donor_meta\n",
    "    .sort_values(\n",
    "        \"_order\"\n",
    "    )\n",
    "    .drop(\n",
    "        columns=[\n",
    "            \"_order\"\n",
    "        ]\n",
    "    )\n",
    "    .reset_index(\n",
    "        drop=True\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    donor_meta[\n",
    "        \"donor_id\"\n",
    "    ]\n",
    "    .tolist()\n",
    "    ==\n",
    "    EXPECTED_SAMPLE_IDS\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. DONOR METADATA MISSINGNESS + DISTRIBUTION\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"FROZEN DONOR METADATA\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    donor_meta\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nCore covariate missingness:\"\n",
    ")\n",
    "\n",
    "\n",
    "core_missingness = (\n",
    "\n",
    "    donor_meta[\n",
    "        [\n",
    "            \"age\",\n",
    "            \"sex\",\n",
    "            \"PMD_hours\",\n",
    "        ]\n",
    "    ]\n",
    "    .isna()\n",
    "    .sum()\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    core_missingness\n",
    "    .rename(\n",
    "        \"missing_donors\"\n",
    "    )\n",
    "    .reset_index()\n",
    "    .rename(\n",
    "        columns={\n",
    "            \"index\":\n",
    "                \"covariate\"\n",
    "        }\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert int(\n",
    "    core_missingness.sum()\n",
    ") == 0\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nAge / PMD by diagnosis:\"\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "\n",
    "    donor_meta\n",
    "    .groupby(\n",
    "        \"diagnosis_binary\"\n",
    "    )[\n",
    "        [\n",
    "            \"age\",\n",
    "            \"PMD_hours\",\n",
    "        ]\n",
    "    ]\n",
    "    .agg(\n",
    "        [\n",
    "            \"count\",\n",
    "            \"mean\",\n",
    "            \"std\",\n",
    "            \"min\",\n",
    "            \"median\",\n",
    "            \"max\",\n",
    "        ]\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSex × diagnosis:\"\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "\n",
    "    pd.crosstab(\n",
    "        donor_meta[\n",
    "            \"sex\"\n",
    "        ],\n",
    "        donor_meta[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. AGE-OVERLAP AUDIT\n",
    "# ============================================================\n",
    "\n",
    "AD_age = (\n",
    "\n",
    "    donor_meta.loc[\n",
    "        donor_meta[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        ==\n",
    "        \"AD\",\n",
    "        \"age\"\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "Control_age = (\n",
    "\n",
    "    donor_meta.loc[\n",
    "        donor_meta[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        ==\n",
    "        \"Control\",\n",
    "        \"age\"\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "common_age_min = float(\n",
    "\n",
    "    max(\n",
    "        AD_age.min(),\n",
    "        Control_age.min()\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "common_age_max = float(\n",
    "\n",
    "    min(\n",
    "        AD_age.max(),\n",
    "        Control_age.max()\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "age_overlap = (\n",
    "\n",
    "    donor_meta[\n",
    "        donor_meta[\n",
    "            \"age\"\n",
    "        ]\n",
    "        .between(\n",
    "            common_age_min,\n",
    "            common_age_max,\n",
    "            inclusive=\"both\"\n",
    "        )\n",
    "    ]\n",
    "    .copy()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "age_overlap_counts = (\n",
    "\n",
    "    age_overlap[\n",
    "        \"diagnosis_binary\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nCommon observed age support:\",\n",
    "    common_age_min,\n",
    "    \"to\",\n",
    "    common_age_max\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Age-overlap cohort:\",\n",
    "    age_overlap_counts\n",
    ")\n",
    "\n",
    "\n",
    "# Expected from actual Table S1:\n",
    "# common support = 74 to 94\n",
    "# only four AD donors remain.\n",
    "assert (\n",
    "    common_age_min\n",
    "    ==\n",
    "    74.0\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    common_age_max\n",
    "    ==\n",
    "    94.0\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    age_overlap_counts\n",
    "    ==\n",
    "    {\n",
    "        \"Control\": 9,\n",
    "        \"AD\": 4,\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "AGE_OVERLAP_SENSITIVITY = False\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Age-overlap sensitivity frozen: NO\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Reason: only 4 AD donors remain.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. COVARIATE DESIGN FEASIBILITY — ALL 21 DONORS\n",
    "#\n",
    "# This does NOT run expression analysis.\n",
    "# Final per-class rank will be checked later.\n",
    "# ============================================================\n",
    "\n",
    "diagnosis_AD = (\n",
    "\n",
    "    donor_meta[\n",
    "        \"diagnosis_binary\"\n",
    "    ]\n",
    "    .eq(\n",
    "        \"AD\"\n",
    "    )\n",
    "    .astype(float)\n",
    "    .to_numpy()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "sex_Male = (\n",
    "\n",
    "    donor_meta[\n",
    "        \"sex\"\n",
    "    ]\n",
    "    .eq(\n",
    "        \"Male\"\n",
    "    )\n",
    "    .astype(float)\n",
    "    .to_numpy()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "age = (\n",
    "\n",
    "    donor_meta[\n",
    "        \"age\"\n",
    "    ]\n",
    "    .to_numpy(\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "PMD = (\n",
    "\n",
    "    donor_meta[\n",
    "        \"PMD_hours\"\n",
    "    ]\n",
    "    .to_numpy(\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# Primary:\n",
    "# ~ age + sex + diagnosis\n",
    "X_primary = np.column_stack(\n",
    "    [\n",
    "        np.ones(\n",
    "            len(\n",
    "                donor_meta\n",
    "            )\n",
    "        ),\n",
    "        age,\n",
    "        sex_Male,\n",
    "        diagnosis_AD,\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "# Technical:\n",
    "# ~ age + sex + PMD + diagnosis\n",
    "X_PMD = np.column_stack(\n",
    "    [\n",
    "        np.ones(\n",
    "            len(\n",
    "                donor_meta\n",
    "            )\n",
    "        ),\n",
    "        age,\n",
    "        sex_Male,\n",
    "        PMD,\n",
    "        diagnosis_AD,\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "primary_rank = int(\n",
    "    np.linalg.matrix_rank(\n",
    "        X_primary\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "PMD_rank = int(\n",
    "    np.linalg.matrix_rank(\n",
    "        X_PMD\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    primary_rank\n",
    "    ==\n",
    "    X_primary.shape[\n",
    "        1\n",
    "    ]\n",
    "    ==\n",
    "    4\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    PMD_rank\n",
    "    ==\n",
    "    X_PMD.shape[\n",
    "        1\n",
    "    ]\n",
    "    ==\n",
    "    5\n",
    ")\n",
    "\n",
    "\n",
    "primary_condition = (\n",
    "    standardized_condition_number(\n",
    "        X_primary,\n",
    "        continuous_column_indices=[\n",
    "            1,\n",
    "        ],\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "PMD_condition = (\n",
    "    standardized_condition_number(\n",
    "        X_PMD,\n",
    "        continuous_column_indices=[\n",
    "            1,\n",
    "            3,\n",
    "        ],\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    primary_condition\n",
    "    <\n",
    "    30\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    PMD_condition\n",
    "    <\n",
    "    30\n",
    ")\n",
    "\n",
    "\n",
    "design_audit = pd.DataFrame([\n",
    "\n",
    "    {\n",
    "        \"analysis\":\n",
    "            \"primary_candidate\",\n",
    "\n",
    "        \"model\":\n",
    "            \"~ age + sex + diagnosis_binary\",\n",
    "\n",
    "        \"n_donors\":\n",
    "            21,\n",
    "\n",
    "        \"AD\":\n",
    "            12,\n",
    "\n",
    "        \"Control\":\n",
    "            9,\n",
    "\n",
    "        \"rank\":\n",
    "            primary_rank,\n",
    "\n",
    "        \"columns\":\n",
    "            int(\n",
    "                X_primary.shape[\n",
    "                    1\n",
    "                ]\n",
    "            ),\n",
    "\n",
    "        \"standardized_condition_number\":\n",
    "            primary_condition,\n",
    "    },\n",
    "\n",
    "    {\n",
    "        \"analysis\":\n",
    "            \"PMD_technical_sensitivity_candidate\",\n",
    "\n",
    "        \"model\":\n",
    "            \"~ age + sex + PMD_hours + diagnosis_binary\",\n",
    "\n",
    "        \"n_donors\":\n",
    "            21,\n",
    "\n",
    "        \"AD\":\n",
    "            12,\n",
    "\n",
    "        \"Control\":\n",
    "            9,\n",
    "\n",
    "        \"rank\":\n",
    "            PMD_rank,\n",
    "\n",
    "        \"columns\":\n",
    "            int(\n",
    "                X_PMD.shape[\n",
    "                    1\n",
    "                ]\n",
    "            ),\n",
    "\n",
    "        \"standardized_condition_number\":\n",
    "            PMD_condition,\n",
    "    },\n",
    "\n",
    "])\n",
    "\n",
    "\n",
    "design_audit.to_csv(\n",
    "    DESIGN_AUDIT_PATH,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"DONOR-LEVEL COVARIATE DESIGN FEASIBILITY\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    design_audit\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. LOAD AUTHOR snRNAseq_QC REFERENCE\n",
    "# ============================================================\n",
    "\n",
    "author_qc = pd.read_excel(\n",
    "    SD01_PATH,\n",
    "    sheet_name=\"snRNAseq_QC\",\n",
    "    header=0,\n",
    "    dtype=object,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nsnRNAseq_QC columns:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    author_qc.columns.tolist()\n",
    ")\n",
    "\n",
    "\n",
    "EXPECTED_QC_COLUMNS = [\n",
    "\n",
    "    \"ID\",\n",
    "    \"Number of transcript per nucleus\",\n",
    "    \"Number of genes per nucleus\",\n",
    "    \"Percentage of mito genes per nucleus (%)\",\n",
    "    \"Number of nucleus\",\n",
    "    \"Proportion of Astro (%)\",\n",
    "    \"Proportion of Endo (%)\",\n",
    "    \"Proportion of Excit (%)\",\n",
    "    \"Proportion of Inhibit (%)\",\n",
    "    \"Proportion of Mic (%)\",\n",
    "    \"Proportion of Oligo (%)\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "assert (\n",
    "    author_qc.columns.tolist()\n",
    "    ==\n",
    "    EXPECTED_QC_COLUMNS\n",
    ")\n",
    "\n",
    "\n",
    "# Remove summary \"Mean\" row.\n",
    "author_qc[\n",
    "    \"ID\"\n",
    "] = (\n",
    "    author_qc[\n",
    "        \"ID\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "\n",
    "author_qc_samples = (\n",
    "\n",
    "    author_qc[\n",
    "        author_qc[\n",
    "            \"ID\"\n",
    "        ]\n",
    "        .isin(\n",
    "            EXPECTED_SAMPLE_IDS\n",
    "        )\n",
    "    ]\n",
    "    .copy()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    author_qc_samples\n",
    ") == 21\n",
    "\n",
    "\n",
    "assert (\n",
    "    set(\n",
    "        author_qc_samples[\n",
    "            \"ID\"\n",
    "        ]\n",
    "    )\n",
    "    ==\n",
    "    set(\n",
    "        EXPECTED_SAMPLE_IDS\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "author_qc_reference = pd.DataFrame({\n",
    "\n",
    "    \"donor_id\":\n",
    "        author_qc_samples[\n",
    "            \"ID\"\n",
    "        ]\n",
    "        .astype(str),\n",
    "\n",
    "    \"author_mean_UMI_per_nucleus\":\n",
    "        pd.to_numeric(\n",
    "            author_qc_samples[\n",
    "                \"Number of transcript per nucleus\"\n",
    "            ],\n",
    "            errors=\"raise\"\n",
    "        ),\n",
    "\n",
    "    \"author_mean_genes_per_nucleus\":\n",
    "        pd.to_numeric(\n",
    "            author_qc_samples[\n",
    "                \"Number of genes per nucleus\"\n",
    "            ],\n",
    "            errors=\"raise\"\n",
    "        ),\n",
    "\n",
    "    \"author_mean_mito_percent\":\n",
    "        pd.to_numeric(\n",
    "            author_qc_samples[\n",
    "                \"Percentage of mito genes per nucleus (%)\"\n",
    "            ],\n",
    "            errors=\"raise\"\n",
    "        ),\n",
    "\n",
    "    \"author_post_QC_nuclei\":\n",
    "        pd.to_numeric(\n",
    "            author_qc_samples[\n",
    "                \"Number of nucleus\"\n",
    "            ],\n",
    "            errors=\"raise\"\n",
    "        ).astype(\n",
    "            int\n",
    "        ),\n",
    "\n",
    "})\n",
    "\n",
    "\n",
    "author_qc_reference = (\n",
    "\n",
    "    donor_meta[\n",
    "        [\n",
    "            \"donor_id\",\n",
    "            \"diagnosis_binary\",\n",
    "        ]\n",
    "    ]\n",
    "    .merge(\n",
    "        author_qc_reference,\n",
    "        on=\"donor_id\",\n",
    "        how=\"left\",\n",
    "        validate=\"one_to_one\",\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    author_qc_reference[\n",
    "        \"author_post_QC_nuclei\"\n",
    "    ]\n",
    "    .notna()\n",
    "    .all()\n",
    ")\n",
    "\n",
    "\n",
    "AUTHOR_POST_QC_TOTAL = int(\n",
    "\n",
    "    author_qc_reference[\n",
    "        \"author_post_QC_nuclei\"\n",
    "    ]\n",
    "    .sum()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    AUTHOR_POST_QC_TOTAL\n",
    "    ==\n",
    "    169496\n",
    ")\n",
    "\n",
    "\n",
    "author_qc_reference.to_csv(\n",
    "    AUTHOR_QC_REFERENCE_PATH,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nAuthor post-QC total:\",\n",
    "    f\"{AUTHOR_POST_QC_TOTAL:,}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. FEATURE TABLE\n",
    "#\n",
    "# All 21 decompressed feature tables were already proven\n",
    "# identical, so inspect one canonical file.\n",
    "# ============================================================\n",
    "\n",
    "canonical_feature_path = Path(\n",
    "\n",
    "    sample_manifest[\n",
    "        \"feature_file\"\n",
    "    ]\n",
    "    .iloc[\n",
    "        0\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "feature_table = pd.read_csv(\n",
    "    canonical_feature_path,\n",
    "    sep=\"\\t\",\n",
    "    header=None,\n",
    "    compression=\"gzip\",\n",
    "    dtype=str,\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    feature_table\n",
    ") == 33538\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nCanonical feature table shape:\",\n",
    "    feature_table.shape\n",
    ")\n",
    "\n",
    "\n",
    "if (\n",
    "    feature_table.shape[\n",
    "        1\n",
    "    ]\n",
    "    ==\n",
    "    2\n",
    "):\n",
    "\n",
    "    feature_table.columns = [\n",
    "        \"gene_id\",\n",
    "        \"gene_symbol\",\n",
    "    ]\n",
    "\n",
    "    feature_table[\n",
    "        \"feature_type\"\n",
    "    ] = \"Gene Expression\"\n",
    "\n",
    "\n",
    "elif (\n",
    "    feature_table.shape[\n",
    "        1\n",
    "    ]\n",
    "    >=\n",
    "    3\n",
    "):\n",
    "\n",
    "    feature_table = (\n",
    "        feature_table\n",
    "        .iloc[\n",
    "            :,\n",
    "            :3\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "    feature_table.columns = [\n",
    "        \"gene_id\",\n",
    "        \"gene_symbol\",\n",
    "        \"feature_type\",\n",
    "    ]\n",
    "\n",
    "\n",
    "else:\n",
    "\n",
    "    raise RuntimeError(\n",
    "        \"Unexpected features.tsv schema.\"\n",
    "    )\n",
    "\n",
    "\n",
    "feature_table[\n",
    "    \"original_feature_index\"\n",
    "] = np.arange(\n",
    "    len(\n",
    "        feature_table\n",
    "    ),\n",
    "    dtype=np.int64\n",
    ")\n",
    "\n",
    "\n",
    "feature_table[\n",
    "    \"MT_prefix\"\n",
    "] = (\n",
    "\n",
    "    feature_table[\n",
    "        \"gene_symbol\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .str.upper()\n",
    "    .str.startswith(\n",
    "        \"MT-\"\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "N_MT_FEATURES = int(\n",
    "    feature_table[\n",
    "        \"MT_prefix\"\n",
    "    ].sum()\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    N_MT_FEATURES\n",
    "    >\n",
    "    0\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"MT-prefix features:\",\n",
    "    N_MT_FEATURES\n",
    ")\n",
    "\n",
    "\n",
    "feature_table.to_csv(\n",
    "    FEATURE_METADATA_PATH,\n",
    "    index=False,\n",
    "    compression={\n",
    "        \"method\":\n",
    "            \"gzip\",\n",
    "        \"compresslevel\":\n",
    "            6,\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "mt_mask = (\n",
    "    feature_table[\n",
    "        \"MT_prefix\"\n",
    "    ]\n",
    "    .to_numpy(\n",
    "        dtype=bool\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 12. AUTHOR QC RULE — FREEZE BEFORE CALCULATION\n",
    "# ============================================================\n",
    "\n",
    "QC_RULE = {\n",
    "\n",
    "    \"detected_genes\":\n",
    "        \"> 200\",\n",
    "\n",
    "    \"total_UMI\":\n",
    "        \"< 20000\",\n",
    "\n",
    "    \"mitochondrial_percent\":\n",
    "        \"< 20\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"FROZEN AUTHOR QC RULE\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"KEEP nFeature > 200\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"KEEP nUMI < 20,000\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"KEEP mitochondrial % < 20\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 13. REPRODUCE NUCLEUS QC SAMPLE-BY-SAMPLE\n",
    "#\n",
    "# Disease label is NOT used in the filtering decision.\n",
    "# ============================================================\n",
    "\n",
    "cell_qc_tables = []\n",
    "sample_qc_rows = []\n",
    "failure_rows = []\n",
    "\n",
    "\n",
    "for sample_index, row in sample_manifest.iterrows():\n",
    "\n",
    "\n",
    "    sample_id = str(\n",
    "        row[\n",
    "            \"sample_id\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    diagnosis = str(\n",
    "        row[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    matrix_path = Path(\n",
    "        row[\n",
    "            \"matrix_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",    "\n",
    "    barcode_path = Path(\n",
    "        row[\n",
    "            \"barcode_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    feature_path = Path(\n",
    "        row[\n",
    "            \"feature_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\n\"\n",
    "        +\n",
    "        \"=\" * 72\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"[{sample_index + 1}/21] {sample_id}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"=\" * 72\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Verify feature payload identity again at use time.\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    current_features = pd.read_csv(\n",
    "        feature_path,\n",
    "        sep=\"\\t\",\n",
    "        header=None,\n",
    "        compression=\"gzip\",\n",
    "        dtype=str,\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        current_features\n",
    "    ) == 33538\n",
    "\n",
    "\n",
    "    assert (\n",
    "        current_features.iloc[\n",
    "            :,\n",
    "            0\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "        ==\n",
    "        feature_table[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        current_features.iloc[\n",
    "            :,\n",
    "            1\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "        ==\n",
    "        feature_table[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    del current_features\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Load barcodes.\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    barcodes = pd.read_csv(\n",
    "        barcode_path,\n",
    "        sep=\"\\t\",\n",
    "        header=None,\n",
    "        compression=\"gzip\",\n",
    "        dtype=str,\n",
    "    )[\n",
    "        0\n",
    "    ]\n",
    "\n",
    "\n",
    "    barcodes = (\n",
    "        barcodes\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    expected_raw_cells = int(\n",
    "        row[\n",
    "            \"raw_filtered_barcodes\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        barcodes\n",
    "    ) == expected_raw_cells\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        barcodes\n",
    "    ) == len(\n",
    "        set(\n",
    "            barcodes\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Load sparse Matrix Market.\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    with gzip.open(\n",
    "        matrix_path,\n",
    "        \"rb\"\n",
    "    ) as f:\n",
    "\n",
    "        matrix = mmread(\n",
    "            f\n",
    "        )\n",
    "\n",
    "\n",
    "    matrix = matrix.tocsc()\n",
    "\n",
    "\n",
    "    assert matrix.shape == (\n",
    "        33538,\n",
    "        expected_raw_cells,\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        matrix.data\n",
    "        >=\n",
    "        0\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    assert np.allclose(\n",
    "        matrix.data,\n",
    "        np.round(\n",
    "            matrix.data\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Per-nucleus QC metrics.\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    n_UMI = np.asarray(\n",
    "        matrix.sum(\n",
    "            axis=0\n",
    "        )\n",
    "    ).ravel()\n",
    "\n",
    "\n",
    "    n_genes = np.diff(\n",
    "        matrix.indptr\n",
    "    )\n",
    "\n",
    "\n",
    "    mito_UMI = np.asarray(\n",
    "        matrix[\n",
    "            mt_mask,\n",
    "            :\n",
    "        ]\n",
    "        .sum(\n",
    "            axis=0\n",
    "        )\n",
    "    ).ravel()\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_UMI\n",
    "        >\n",
    "        0\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    mito_percent = (\n",
    "\n",
    "        mito_UMI\n",
    "\n",
    "        /\n",
    "\n",
    "        n_UMI\n",
    "\n",
    "        *\n",
    "\n",
    "        100.0\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert np.isfinite(\n",
    "        mito_percent\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Exact written author thresholds.\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    fail_low_genes = (\n",
    "        n_genes\n",
    "        <=\n",
    "        200\n",
    "    )\n",
    "\n",
    "\n",
    "    fail_high_UMI = (\n",
    "        n_UMI\n",
    "        >=\n",
    "        20000\n",
    "    )\n",
    "\n",
    "\n",
    "    fail_high_mito = (\n",
    "        mito_percent\n",
    "        >=\n",
    "        20.0\n",
    "    )\n",
    "\n",
    "\n",
    "    QC_pass = (\n",
    "\n",
    "        ~fail_low_genes\n",
    "\n",
    "        &\n",
    "\n",
    "        ~fail_high_UMI\n",
    "\n",
    "        &\n",
    "\n",
    "        ~fail_high_mito\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    reproduced_post_QC = int(\n",
    "        QC_pass.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Author reference.\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    author_row = (\n",
    "\n",
    "        author_qc_reference[\n",
    "            author_qc_reference[\n",
    "                \"donor_id\"\n",
    "            ]\n",
    "            ==\n",
    "            sample_id\n",
    "        ]\n",
    "        .iloc[\n",
    "            0\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    author_post_QC = int(\n",
    "        author_row[\n",
    "            \"author_post_QC_nuclei\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    difference = (\n",
    "        reproduced_post_QC\n",
    "        -\n",
    "        author_post_QC\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Boundary-value diagnostics.\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    n_exact_200_genes = int(\n",
    "        (\n",
    "            n_genes\n",
    "            ==\n",
    "            200\n",
    "        ).sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_exact_20000_UMI = int(\n",
    "        (\n",
    "            n_UMI\n",
    "            ==\n",
    "            20000\n",
    "        ).sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_exact_20pct_mito = int(\n",
    "        np.isclose(\n",
    "            mito_percent,\n",
    "            20.0,\n",
    "            rtol=0,\n",
    "            atol=1e-12,\n",
    "        ).sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # QC cell table.\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    cell_qc = pd.DataFrame({\n",
    "\n",
    "        \"donor_id\":\n",
    "            sample_id,\n",
    "\n",
    "        \"diagnosis_binary\":\n",
    "            diagnosis,\n",
    "\n",
    "        \"barcode\":\n",
    "            barcodes,\n",
    "\n",
    "        \"cell_uid\":\n",
    "            [\n",
    "                (\n",
    "                    f\"{sample_id}\"\n",
    "                    f\"__\"\n",
    "                    f\"{barcode}\"\n",
    "                )\n",
    "                for barcode\n",
    "                in barcodes\n",
    "            ],\n",
    "\n",
    "        \"n_UMI\":\n",
    "            n_UMI.astype(\n",
    "                np.int64\n",
    "            ),\n",
    "\n",
    "        \"n_detected_genes\":\n",
    "            n_genes.astype(\n",
    "                np.int32\n",
    "            ),\n",
    "\n",
    "        \"mitochondrial_UMI\":\n",
    "            mito_UMI.astype(\n",
    "                np.int64\n",
    "            ),\n",
    "\n",
    "        \"mitochondrial_percent\":\n",
    "            mito_percent.astype(\n",
    "                np.float64\n",
    "            ),\n",
    "\n",
    "        \"fail_nFeature_le_200\":\n",
    "            fail_low_genes,\n",
    "\n",
    "        \"fail_nUMI_ge_20000\":\n",
    "            fail_high_UMI,\n",
    "\n",
    "        \"fail_mito_ge_20pct\":\n",
    "            fail_high_mito,\n",
    "\n",
    "        \"QC_pass\":\n",
    "            QC_pass,\n",
    "\n",
    "    })\n",
    "\n",
    "\n",
    "    assert (\n",
    "        cell_qc[\n",
    "            \"cell_uid\"\n",
    "        ]\n",
    "        .is_unique\n",
    "    )\n",
    "\n",
    "\n",
    "    cell_qc_tables.append(\n",
    "        cell_qc\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Failure-reason summary.\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    failure_rows.append({\n",
    "\n",
    "        \"donor_id\":\n",
    "            sample_id,\n",
    "\n",
    "        \"raw_nuclei\":\n",
    "            expected_raw_cells,\n",
    "\n",
    "        \"fail_nFeature_le_200\":\n",
    "            int(\n",
    "                fail_low_genes.sum()\n",
    "            ),\n",
    "\n",
    "        \"fail_nUMI_ge_20000\":\n",
    "            int(\n",
    "                fail_high_UMI.sum()\n",
    "            ),\n",
    "\n",
    "        \"fail_mito_ge_20pct\":\n",
    "            int(\n",
    "                fail_high_mito.sum()\n",
    "            ),\n",
    "\n",
    "        \"fail_any_QC\":\n",
    "            int(\n",
    "                (\n",
    "                    ~QC_pass\n",
    "                ).sum()\n",
    "            ),\n",
    "\n",
    "        \"n_exactly_200_genes\":\n",
    "            n_exact_200_genes,\n",
    "\n",
    "        \"n_exactly_20000_UMI\":\n",
    "            n_exact_20000_UMI,\n",
    "\n",
    "        \"n_exactly_20pct_mito\":\n",
    "            n_exact_20pct_mito,\n",
    "\n",
    "    })\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Sample comparison.\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    sample_qc_rows.append({\n",
    "\n",
    "        \"donor_id\":\n",
    "            sample_id,\n",
    "\n",
    "        \"diagnosis_binary\":\n",
    "            diagnosis,\n",
    "\n",
    "        \"raw_nuclei\":\n",
    "            expected_raw_cells,\n",
    "\n",
    "        \"author_post_QC_nuclei\":\n",
    "            author_post_QC,\n",
    "\n",
    "        \"reproduced_post_QC_nuclei\":\n",
    "            reproduced_post_QC,\n",
    "\n",
    "        \"reproduced_minus_author\":\n",
    "            difference,\n",
    "\n",
    "        \"reproduced_mean_UMI\":\n",
    "            float(\n",
    "                n_UMI[\n",
    "                    QC_pass\n",
    "                ].mean()\n",
    "            ),\n",
    "\n",
    "        \"author_mean_UMI\":\n",
    "            float(\n",
    "                author_row[\n",
    "                    \"author_mean_UMI_per_nucleus\"\n",
    "                ]\n",
    "            ),\n",
    "\n",
    "        \"reproduced_mean_genes\":\n",
    "            float(\n",
    "                n_genes[\n",
    "                    QC_pass\n",
    "                ].mean()\n",
    "            ),\n",
    "\n",
    "        \"author_mean_genes\":\n",
    "            float(\n",
    "                author_row[\n",
    "                    \"author_mean_genes_per_nucleus\"\n",
    "                ]\n",
    "            ),\n",
    "\n",
    "        \"reproduced_mean_mito_percent\":\n",
    "            float(\n",
    "                mito_percent[\n",
    "                    QC_pass\n",
    "                ].mean()\n",
    "            ),\n",
    "\n",
    "        \"author_mean_mito_percent\":\n",
    "            float(\n",
    "                author_row[\n",
    "                    \"author_mean_mito_percent\"\n",
    "                ]\n",
    "            ),\n",
    "\n",
    "    })\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Raw nuclei:\",\n",
    "        f\"{expected_raw_cells:,}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Author post-QC:\",\n",
    "        f\"{author_post_QC:,}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Reproduced post-QC:\",\n",
    "        f\"{reproduced_post_QC:,}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Difference:\",\n",
    "        difference\n",
    "    )\n",
    "\n",
    "\n",
    "    del matrix\n",
    "    del cell_qc\n",
    "    del n_UMI\n",
    "    del n_genes\n",
    "    del mito_UMI\n",
    "    del mito_percent\n",
    "    del QC_pass\n",
    "    del fail_low_genes\n",
    "    del fail_high_UMI\n",
    "    del fail_high_mito\n",
    "\n",
    "    gc.collect()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 14. COMBINE NUCLEUS QC\n",
    "# ============================================================\n",
    "\n",
    "cell_qc_all = pd.concat(\n",
    "    cell_qc_tables,\n",
    "    axis=0,\n",
    "    ignore_index=True,\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    cell_qc_all\n",
    ") == 179392\n",
    "\n",
    "\n",
    "assert (\n",
    "    cell_qc_all[\n",
    "        \"cell_uid\"\n",
    "    ]\n",
    "    .is_unique\n",
    ")\n",
    "\n",
    "\n",
    "REPRODUCED_POST_QC_TOTAL = int(\n",
    "    cell_qc_all[\n",
    "        \"QC_pass\"\n",
    "    ].sum()\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"AUTHOR QC REPRODUCTION\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Raw nuclei:\",\n",
    "    f\"{len(cell_qc_all):,}\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Author post-QC:\",\n",
    "    f\"{AUTHOR_POST_QC_TOTAL:,}\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Reproduced post-QC:\",\n",
    "    f\"{REPRODUCED_POST_QC_TOTAL:,}\"\n",
    ")\n",
    "\n",
    "\n",
    "TOTAL_QC_DIFFERENCE = (\n",
    "\n",
    "    REPRODUCED_POST_QC_TOTAL\n",
    "    -\n",
    "    AUTHOR_POST_QC_TOTAL\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Difference:\",\n",
    "    TOTAL_QC_DIFFERENCE\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 15. EXPECTED REPRODUCTION CHECK\n",
    "#\n",
    "# Published independent reconstruction from the same GEO\n",
    "# matrices reported 169,506 nuclei under the written rules,\n",
    "# ten more than the author's 169,496.\n",
    "#\n",
    "# Accept either exact author recovery or that documented\n",
    "# +10 reconstruction.\n",
    "# ============================================================\n",
    "\n",
    "assert (\n",
    "    REPRODUCED_POST_QC_TOTAL\n",
    "    in\n",
    "    {\n",
    "        169496,\n",
    "        169506,\n",
    "    }\n",
    "), (\n",
    "    \"QC total does not reproduce either the author's \"\n",
    "    \"169,496 or the independently documented 169,506. \"\n",
    "    \"Stop before cell annotation.\"\n",
    ")\n",
    "\n",
    "\n",
    "if (\n",
    "    REPRODUCED_POST_QC_TOTAL\n",
    "    ==\n",
    "    169496\n",
    "):\n",
    "\n",
    "    QC_REPRODUCTION_STATUS = (\n",
    "        \"EXACT_AUTHOR_TOTAL\"\n",
    "    )\n",
    "\n",
    "\n",
    "else:\n",
    "\n",
    "    QC_REPRODUCTION_STATUS = (\n",
    "        \"WRITTEN_RULES_REPRODUCED_WITH_DOCUMENTED_PLUS_10\"\n",
    "    )\n",
    "\n",
    "\n",
    "print(\n",
    "    \"QC reproduction status:\",\n",
    "    QC_REPRODUCTION_STATUS\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 16. SAMPLE-LEVEL QC COMPARISON\n",
    "# ============================================================\n",
    "\n",
    "sample_qc_comparison = pd.DataFrame(\n",
    "    sample_qc_rows\n",
    ")\n",
    "\n",
    "\n",
    "sample_qc_comparison = (\n",
    "\n",
    "    donor_meta[\n",
    "        [\n",
    "            \"donor_id\",\n",
    "        ]\n",
    "    ]\n",
    "    .merge(\n",
    "        sample_qc_comparison,\n",
    "        on=\"donor_id\",\n",
    "        how=\"left\",\n",
    "        validate=\"one_to_one\",\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    sample_qc_comparison\n",
    ") == 21\n",
    "\n",
    "\n",
    "assert int(\n",
    "    sample_qc_comparison[\n",
    "        \"raw_nuclei\"\n",
    "    ].sum()\n",
    ") == 179392\n",
    "\n",
    "\n",
    "assert int(\n",
    "    sample_qc_comparison[\n",
    "        \"author_post_QC_nuclei\"\n",
    "    ].sum()\n",
    ") == 169496\n",
    "\n",
    "\n",
    "assert int(\n",
    "    sample_qc_comparison[\n",
    "        \"reproduced_post_QC_nuclei\"\n",
    "    ].sum()\n",
    ") == REPRODUCED_POST_QC_TOTAL\n",
    "\n",
    "\n",
    "sample_qc_comparison.to_csv(\n",
    "    SAMPLE_QC_COMPARISON_PATH,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSample-level author vs reproduced QC:\"\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    sample_qc_comparison[\n",
    "        [\n",
    "            \"donor_id\",\n",
    "            \"diagnosis_binary\",\n",
    "            \"raw_nuclei\",\n",
    "            \"author_post_QC_nuclei\",\n",
    "            \"reproduced_post_QC_nuclei\",\n",
    "            \"reproduced_minus_author\",\n",
    "        ]\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 17. FAILURE REASON SUMMARY\n",
    "# ============================================================\n",
    "\n",
    "failure_summary = pd.DataFrame(\n",
    "    failure_rows\n",
    ")\n",
    "\n",
    "\n",
    "failure_summary = (\n",
    "\n",
    "    donor_meta[\n",
    "        [\n",
    "            \"donor_id\",\n",
    "        ]\n",
    "    ]\n",
    "    .merge(\n",
    "        failure_summary,\n",
    "        on=\"donor_id\",\n",
    "        how=\"left\",\n",
    "        validate=\"one_to_one\",\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "failure_summary.to_csv(\n",
    "    QC_FAILURE_REASON_PATH,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nQC failure reasons:\"\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    failure_summary\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 18. SAVE NUCLEUS-LEVEL QC MANIFEST\n",
    "# ============================================================\n",
    "\n",
    "cell_qc_all.to_csv(\n",
    "\n",
    "    CELL_QC_MANIFEST_PATH,\n",
    "\n",
    "    index=False,\n",
    "\n",
    "    compression={\n",
    "        \"method\":\n",
    "            \"gzip\",\n",
    "\n",
    "        \"compresslevel\":\n",
    "            6,\n",
    "    }\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "QC_pass_barcodes = (\n",
    "\n",
    "    cell_qc_all[\n",
    "        cell_qc_all[\n",
    "            \"QC_pass\"\n",
    "        ]\n",
    "    ][\n",
    "        [\n",
    "            \"donor_id\",\n",
    "            \"diagnosis_binary\",\n",
    "            \"barcode\",\n",
    "            \"cell_uid\",\n",
    "        ]\n",
    "    ]\n",
    "    .copy()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    QC_pass_barcodes\n",
    ") == REPRODUCED_POST_QC_TOTAL\n",
    "\n",
    "\n",
    "QC_pass_barcodes.to_csv(\n",
    "\n",
    "    QC_PASS_BARCODES_PATH,\n",
    "\n",
    "    index=False,\n",
    "\n",
    "    compression={\n",
    "        \"method\":\n",
    "            \"gzip\",\n",
    "\n",
    "        \"compresslevel\":\n",
    "            6,\n",
    "    }\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 19. ADD REPRODUCED QC COUNTS TO DONOR METADATA\n",
    "# ============================================================\n",
    "\n",
    "reproduced_counts = (\n",
    "\n",
    "    QC_pass_barcodes\n",
    "    .groupby(\n",
    "        \"donor_id\",\n",
    "        observed=True\n",
    "    )\n",
    "    .size()\n",
    "    .rename(\n",
    "        \"reproduced_post_QC_nuclei\"\n",
    "    )\n",
    "    .reset_index()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "donor_meta = donor_meta.merge(\n",
    "\n",
    "    reproduced_counts,\n",
    "\n",
    "    on=\"donor_id\",\n",
    "\n",
    "    how=\"left\",\n",
    "\n",
    "    validate=\"one_to_one\",\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "donor_meta = donor_meta.merge(\n",
    "\n",
    "    author_qc_reference[\n",
    "        [\n",
    "            \"donor_id\",\n",
    "            \"author_post_QC_nuclei\",\n",
    "        ]\n",
    "    ],\n",
    "\n",
    "    on=\"donor_id\",\n",
    "\n",
    "    how=\"left\",\n",
    "\n",
    "    validate=\"one_to_one\",\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    donor_meta[\n",
    "        \"reproduced_post_QC_nuclei\"\n",
    "    ]\n",
    "    .notna()\n",
    "    .all()\n",
    ")\n",
    "\n",
    "\n",
    "donor_meta.to_csv(\n",
    "    DONOR_METADATA_PATH,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 20. FINAL HASHES\n",
    "# ============================================================\n",
    "\n",
    "DONOR_META_SHA = sha256_file(\n",
    "    DONOR_METADATA_PATH\n",
    ")\n",
    "\n",
    "\n",
    "CELL_QC_SHA = sha256_file(\n",
    "    CELL_QC_MANIFEST_PATH\n",
    ")\n",
    "\n",
    "\n",
    "PASS_BARCODES_SHA = sha256_file(\n",
    "    QC_PASS_BARCODES_PATH\n",
    ")\n",
    "\n",
    "\n",
    "FEATURE_META_SHA = sha256_file(\n",
    "    FEATURE_METADATA_PATH\n",
    ")\n",
    "\n",
    "\n",
    "SAMPLE_QC_SHA = sha256_file(\n",
    "    SAMPLE_QC_COMPARISON_PATH\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 21. FREEZE COVARIATE + QC POLICY\n",
    "# ============================================================\n",
    "\n",
    "STEP25_LOCK = {\n",
    "\n",
    "    \"dataset\":\n",
    "        \"GSE157827\",\n",
    "\n",
    "    \"created_utc\":\n",
    "        datetime.now(\n",
    "            timezone.utc\n",
    "        ).isoformat(),\n",
    "\n",
