    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. VERIFY NEW SUBPROCESS ENVIRONMENT BEFORE DE\n",
    "# ============================================================\n",
    "\n",
    "environment_check = r'''\n",
    "import sys\n",
    "import pandas\n",
    "import anndata\n",
    "import pydeseq2\n",
    "import importlib.metadata\n",
    "\n",
    "print(\"Fresh subprocess versions:\")\n",
    "print(\"Python:\", sys.version.split()[0])\n",
    "print(\"pandas:\", pandas.__version__)\n",
    "print(\"anndata:\", anndata.__version__)\n",
    "print(\n",
    "    \"pydeseq2:\",\n",
    "    importlib.metadata.version(\"pydeseq2\")\n",
    ")\n",
    "\n",
    "# This is the API that failed in the notebook process.\n",
    "x = pandas.StringDtype(na_value=pandas.NA)\n",
    "\n",
    "print(\n",
    "    \"StringDtype na_value API: PASS\"\n",
    ")\n",
    "'''\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nTesting fresh subprocess environment...\"\n",
    ")\n",
    "\n",
    "\n",
    "subprocess.run(\n",
    "    [\n",
    "        sys.executable,\n",
    "        \"-c\",\n",
    "        environment_check,\n",
    "    ],\n",
    "    check=True\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. RUN STEP 11 IN FRESH PYTHON PROCESS\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"LAUNCHING PRIMARY PD DIFFERENTIAL EXPRESSION\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "completed = subprocess.run(\n",
    "    [\n",
    "        sys.executable,\n",
    "        str(\n",
    "            runner_path\n",
    "        ),\n",
    "    ],\n",
    "    check=False\n",
    ")\n",
    "\n",
    "\n",
    "if completed.returncode != 0:\n",
    "\n",
    "    raise RuntimeError(\n",
    "        \"\\nSTEP 11 subprocess failed. \"\n",
    "        f\"Exit code: {completed.returncode}\\n\"\n",
    "        \"Paste the traceback/output exactly as shown.\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. VERIFY FINAL OUTPUT FILES FROM NOTEBOOK PROCESS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "summary_path = (\n",
    "    ROOT /\n",
    "    \"PD_primary_DE\" /\n",
    "    \"GSE243639_PRIMARY_PD_DE_SUMMARY_v1.csv\"\n",
    ")\n",
    "\n",
    "run_lock_path = (\n",
    "    ROOT /\n",
    "    \"locks\" /\n",
    "    \"GSE243639_PRIMARY_PD_DE_RUN_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "assert summary_path.exists(), (\n",
    "    f\"Missing summary: {summary_path}\"\n",
    ")\n",
    "\n",
    "assert run_lock_path.exists(), (\n",
    "    f\"Missing run lock: {run_lock_path}\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"NOTEBOOK-SIDE FINAL VERIFICATION: PASS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Summary:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    summary_path\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nRun lock:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    run_lock_path\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSTEP 11 COMPLETE.\"\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 21\n",
    "# ============================================================\n",
    "# STEP 11A — PRIMARY DE OUTPUT AUDIT + FIRST BIOLOGICAL REVEAL\n",
    "#\n",
    "# PURPOSE\n",
    "# -------\n",
    "# 1. Verify STEP 11 run lock.\n",
    "# 2. Verify hashes of all four complete DE result files.\n",
    "# 3. Verify exact frozen gene counts.\n",
    "# 4. Verify no duplicated/missing genes.\n",
    "# 5. Recalculate FDR<0.05 counts independently.\n",
    "# 6. Compare recalculated counts with STEP 11 summary.\n",
    "# 7. Display the first controlled biological results.\n",
    "#\n",
    "# NO sensitivity analysis yet.\n",
    "# NO secondary VC / Neuron DE yet.\n",
    "# ============================================================\n",
    "\n",
    "from pathlib import Path\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import json\n",
    "import hashlib\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = ROOT / \"locks\"\n",
    "\n",
    "DE_ROOT = (\n",
    "    ROOT /\n",
    "    \"PD_primary_DE\"\n",
    ")\n",
    "\n",
    "summary_path = (\n",
    "    DE_ROOT /\n",
    "    \"GSE243639_PRIMARY_PD_DE_SUMMARY_v1.csv\"\n",
    ")\n",
    "\n",
    "run_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_PRIMARY_PD_DE_RUN_v1.json\"\n",
    ")\n",
    "\n",
    "pre_de_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_PRE_DE_ANALYSIS_LOCK_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "    summary_path,\n",
    "    run_lock_path,\n",
    "    pre_de_lock_path,\n",
    "]:\n",
    "\n",
    "    assert path.exists(), (\n",
    "        f\"Missing required file: {path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. LOAD LOCKS + SUMMARY\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    run_lock_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    run_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    pre_de_lock_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    pre_de_lock = json.load(f)\n",
    "\n",
    "\n",
    "summary = pd.read_csv(\n",
    "    summary_path\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. RUN-LOCK INTEGRITY\n",
    "# ============================================================\n",
    "\n",
    "assert (\n",
    "    run_lock[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"PRIMARY_DE_COMPLETE\"\n",
    ")\n",
    "\n",
    "assert (\n",
    "    run_lock[\n",
    "        \"differential_expression_performed\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "assert (\n",
    "    run_lock[\n",
    "        \"all_tested_gene_results_saved\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "assert (\n",
    "    run_lock[\n",
    "        \"gene_universes_refiltered\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "assert (\n",
    "    run_lock[\n",
    "        \"secondary_cell_classes_analyzed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "assert (\n",
    "    run_lock[\n",
    "        \"sensitivity_analyses_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "PRIMARY_CLASSES = [\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "]\n",
    "\n",
    "\n",
    "EXPECTED_UNIVERSES = {\n",
    "\n",
    "    \"Astro\":\n",
    "        16942,\n",
    "\n",
    "    \"Micro\":\n",
    "        16050,\n",
    "\n",
    "    \"OPC\":\n",
    "        16268,\n",
    "\n",
    "    \"Oligo\":\n",
    "        15957,\n",
    "}\n",
    "\n",
    "\n",
    "assert (\n",
    "    summary[\n",
    "        \"cell_type\"\n",
    "    ].tolist()\n",
    "    ==\n",
    "    PRIMARY_CLASSES\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 11 RUN LOCK: PASS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nDE environment:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    json.dumps(\n",
    "        run_lock[\n",
    "            \"environment\"\n",
    "        ],\n",
    "        indent=2\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. FILE HASH HELPER\n",
    "# ============================================================\n",
    "\n",
    "def sha256_file(\n",
    "    path,\n",
    "    block_size=1024 * 1024\n",
    "):\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\"\n",
    "    ) as f:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            block = f.read(\n",
    "                block_size\n",
    "            )\n",
    "\n",
    "            if not block:\n",
    "                break\n",
    "\n",
    "            h.update(\n",
    "                block\n",
    "            )\n",
    "\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. AUDIT EACH COMPLETE ALL-GENE RESULT\n",
    "# ============================================================\n",
    "\n",
    "audit_rows = []\n",
    "\n",
    "top_tables = {}\n",
    "\n",
    "\n",
    "for cell_type in PRIMARY_CLASSES:\n",
    "\n",
    "    print(\n",
    "        \"\\n\"\n",
    "        +\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        cell_type\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "\n",
    "    record = (\n",
    "        run_lock[\n",
    "            \"cell_class_results\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Result path\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    result_path = Path(\n",
    "        record[\n",
    "            \"all_gene_results\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert result_path.exists(), (\n",
    "        f\"Missing result file: {result_path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # SHA256 verification\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    observed_hash = (\n",
    "        sha256_file(\n",
    "            result_path\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    expected_hash = (\n",
    "        record[\n",
    "            \"all_gene_results_sha256\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        observed_hash\n",
    "        ==\n",
    "        expected_hash\n",
    "    ), (\n",
    "        f\"{cell_type}: \"\n",
    "        \"all-gene DE result hash mismatch.\"\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"SHA256: PASS\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Load complete result\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    res = pd.read_csv(\n",
    "        result_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    required_columns = [\n",
    "\n",
    "        \"gene_symbol\",\n",
    "        \"baseMean\",\n",
    "        \"log2FoldChange\",\n",
    "        \"lfcSE\",\n",
    "        \"stat\",\n",
    "        \"pvalue\",\n",
    "        \"padj\",\n",
    "        \"rank_stat\",\n",
    "        \"cell_type\",\n",
    "        \"contrast\",\n",
    "    ]\n",
    "\n",
    "\n",
    "    missing = [\n",
    "        col\n",
    "        for col in required_columns\n",
    "        if col not in res.columns\n",
    "    ]\n",
    "\n",
    "\n",
    "    assert not missing, (\n",
    "        f\"{cell_type}: missing columns {missing}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Exact gene count\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    expected_n = (\n",
    "        EXPECTED_UNIVERSES[\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        res\n",
    "    ) == expected_n\n",
    "\n",
    "\n",
    "    assert (\n",
    "        res[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .is_unique\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        res[\n",
    "            \"cell_type\"\n",
    "        ]\n",
    "        .eq(\n",
    "            cell_type\n",
    "        )\n",
    "        .all()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        res[\n",
    "            \"contrast\"\n",
    "        ]\n",
    "        .eq(\n",
    "            \"PD_vs_Control\"\n",
    "        )\n",
    "        .all()\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Verify exact frozen gene universe\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    frozen_universe_path = Path(\n",
    "        pre_de_lock[\n",
    "            \"cell_class_universes\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ][\n",
    "            \"gene_universe_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    universe = pd.read_csv(\n",
    "        frozen_universe_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    frozen_genes = (\n",
    "        universe[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    result_genes = (\n",
    "        res[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        result_genes\n",
    "        ==\n",
    "        frozen_genes\n",
    "    ), (\n",
    "        f\"{cell_type}: \"\n",
    "        \"DE output gene order differs \"\n",
    "        \"from frozen universe.\"\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Frozen universe identity: PASS\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Rank statistic must equal Wald statistic\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    both_finite = (\n",
    "        np.isfinite(\n",
    "            res[\n",
    "                \"stat\"\n",
    "            ]\n",
    "        )\n",
    "        &\n",
    "        np.isfinite(\n",
    "            res[\n",
    "                \"rank_stat\"\n",
    "            ]\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert np.allclose(\n",
    "\n",
    "        res.loc[\n",
    "            both_finite,\n",
    "            \"stat\"\n",
    "        ],\n",
    "\n",
    "        res.loc[\n",
    "            both_finite,\n",
    "            \"rank_stat\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Result finite-value audit\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    finite_lfc = np.isfinite(\n",
    "        res[\n",
    "            \"log2FoldChange\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    finite_stat = np.isfinite(\n",
    "        res[\n",
    "            \"stat\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    finite_p = np.isfinite(\n",
    "        res[\n",
    "            \"pvalue\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    finite_padj = np.isfinite(\n",
    "        res[\n",
    "            \"padj\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    fdr_mask = (\n",
    "        finite_padj\n",
    "        &\n",
    "        (\n",
    "            res[\n",
    "                \"padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    sig = (\n",
    "        res.loc[\n",
    "            fdr_mask\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_sig = int(\n",
    "        len(\n",
    "            sig\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    n_up = int(\n",
    "        (\n",
    "            sig[\n",
    "                \"log2FoldChange\"\n",
    "            ]\n",
    "            >\n",
    "            0\n",
    "        ).sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_down = int(\n",
    "        (\n",
    "            sig[\n",
    "                \"log2FoldChange\"\n",
    "            ]\n",
    "            <\n",
    "            0\n",
    "        ).sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Compare independently recalculated counts to run lock\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    assert (\n",
    "        n_sig\n",
    "        ==\n",
    "        record[\n",
    "            \"n_FDR_lt_0_05\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_up\n",
    "        ==\n",
    "        record[\n",
    "            \"n_FDR_lt_0_05_up_in_PD\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_down\n",
    "        ==\n",
    "        record[\n",
    "            \"n_FDR_lt_0_05_down_in_PD\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Compare with combined summary\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    summary_row = (\n",
    "        summary.loc[\n",
    "            summary[\n",
    "                \"cell_type\"\n",
    "            ]\n",
    "            ==\n",
    "            cell_type\n",
    "        ]\n",
    "        .iloc[\n",
    "            0\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        int(\n",
    "            summary_row[\n",
    "                \"tested_genes\"\n",
    "            ]\n",
    "        )\n",
    "        ==\n",
    "        expected_n\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        int(\n",
    "            summary_row[\n",
    "                \"FDR_lt_0.05\"\n",
    "            ]\n",
    "        )\n",
    "        ==\n",
    "        n_sig\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        int(\n",
    "            summary_row[\n",
    "                \"up_in_PD\"\n",
    "            ]\n",
    "        )\n",
    "        ==\n",
    "        n_up\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        int(\n",
    "            summary_row[\n",
    "                \"down_in_PD\"\n",
    "            ]\n",
    "        )\n",
    "        ==\n",
    "        n_down\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Minimum p / padj\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    finite_p_values = (\n",
    "        res.loc[\n",
    "            finite_p,\n",
    "            \"pvalue\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    finite_padj_values = (\n",
    "        res.loc[\n",    "            finite_padj,\n",
    "            \"padj\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    min_p = (\n",
    "        float(\n",
    "            finite_p_values.min()\n",
    "        )\n",
    "        if len(\n",
    "            finite_p_values\n",
    "        )\n",
    "        else np.nan\n",
    "    )\n",
    "\n",
    "\n",
    "    min_padj = (\n",
    "        float(\n",
    "            finite_padj_values.min()\n",
    "        )\n",
    "        if len(\n",
    "            finite_padj_values\n",
    "        )\n",
    "        else np.nan\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Top genes for FIRST biological reveal\n",
    "    #\n",
    "    # If there are FDR-significant genes:\n",
    "    #   show strongest FDR results.\n",
    "    #\n",
    "    # Otherwise:\n",
    "    #   show lowest nominal p-values,\n",
    "    #   explicitly NOT as significant genes.\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    if n_sig > 0:\n",
    "\n",
    "        reveal = (\n",
    "            sig\n",
    "            .sort_values(\n",
    "                [\n",
    "                    \"padj\",\n",
    "                    \"pvalue\",\n",
    "                ]\n",
    "            )\n",
    "            [\n",
    "                [\n",
    "                    \"gene_symbol\",\n",
    "                    \"baseMean\",\n",
    "                    \"log2FoldChange\",\n",
    "                    \"stat\",\n",
    "                    \"pvalue\",\n",
    "                    \"padj\",\n",
    "                ]\n",
    "            ]\n",
    "            .head(\n",
    "                15\n",
    "            )\n",
    "            .copy()\n",
    "        )\n",
    "\n",
    "\n",
    "        reveal[\n",
    "            \"status\"\n",
    "        ] = (\n",
    "            \"FDR<0.05\"\n",
    "        )\n",
    "\n",
    "    else:\n",
    "\n",
    "        reveal = (\n",
    "            res.loc[\n",
    "                finite_p\n",
    "            ]\n",
    "            .sort_values(\n",
    "                \"pvalue\"\n",
    "            )\n",
    "            [\n",
    "                [\n",
    "                    \"gene_symbol\",\n",
    "                    \"baseMean\",\n",
    "                    \"log2FoldChange\",\n",
    "                    \"stat\",\n",
    "                    \"pvalue\",\n",
    "                    \"padj\",\n",
    "                ]\n",
    "            ]\n",
    "            .head(\n",
    "                15\n",
    "            )\n",
    "            .copy()\n",
    "        )\n",
    "\n",
    "\n",
    "        reveal[\n",
    "            \"status\"\n",
    "        ] = (\n",
    "            \"NOT_FDR_SIGNIFICANT\"\n",
    "        )\n",
    "\n",
    "\n",
    "    top_tables[\n",
    "        cell_type\n",
    "    ] = reveal\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Audit record\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    audit_rows.append({\n",
    "\n",
    "        \"cell_type\":\n",
    "            cell_type,\n",
    "\n",
    "        \"tested_genes\":\n",
    "            expected_n,\n",
    "\n",
    "        \"finite_LFC\":\n",
    "            int(\n",
    "                finite_lfc.sum()\n",
    "            ),\n",
    "\n",
    "        \"finite_Wald\":\n",
    "            int(\n",
    "                finite_stat.sum()\n",
    "            ),\n",
    "\n",
    "        \"finite_p\":\n",
    "            int(\n",
    "                finite_p.sum()\n",
    "            ),\n",
    "\n",
    "        \"finite_padj\":\n",
    "            int(\n",
