   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 45\n",
    "# ============================================================\n",
    "# STEP 24C — COMPLETE GSE157827 RAW REPLICATION AUDIT\n",
    "#            USING CURRENT PMC AWS CLOUD SERVICE\n",
    "#\n",
    "# WHY THIS RECOVERY EXISTS\n",
    "# ------------------------\n",
    "# PMC retired the legacy OA API / FTP distribution workflow\n",
    "# in August 2026.\n",
    "#\n",
    "# Current official source:\n",
    "#\n",
    "#     AWS public bucket:\n",
    "#     s3://pmc-oa-opendata\n",
    "#\n",
    "# Article datasets are organized by:\n",
    "#\n",
    "#     PMC7568283.<version>/\n",
    "#\n",
    "# and include:\n",
    "#     JSON metadata\n",
    "#     XML\n",
    "#     text\n",
    "#     PDF\n",
    "#     supplementary files\n",
    "#\n",
    "# THIS CELL:\n",
    "#   - reuses existing GEO files\n",
    "#   - does NOT redownload GSE157827_RAW.tar\n",
    "#   - verifies the already-completed raw audit\n",
    "#   - verifies identical decompressed feature payloads\n",
    "#   - discovers the CURRENT PMC article-version prefix\n",
    "#   - reads official PMC JSON metadata\n",
    "#   - lists official AWS article objects\n",
    "#   - downloads supplementary PDF/XLSX files directly\n",
    "#   - validates file magic bytes\n",
    "#   - searches XLSX sheets for the 21 sample IDs\n",
    "#   - searches SI appendix text for Table S1/sample IDs\n",
    "#   - freezes the completed RAW DATA AUDIT\n",
    "#\n",
    "# NO QC FILTERING.\n",
    "# NO CELL-TYPE ANNOTATION.\n",
    "# NO OPC SPLITTING.\n",
    "# NO GENE FILTERING.\n",
    "# NO PSEUDOBULK.\n",
    "# NO DE.\n",
    "# NO DISCOVERY↔REPLICATION COMPARISON.\n",
    "# NO PD DATA.\n",
    "# NO AD↔PD CONVERGENCE.\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "from urllib.parse import quote\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "import requests\n",
    "import hashlib\n",
    "import gzip\n",
    "import json\n",
    "import re\n",
    "import subprocess\n",
    "import sys\n",
    "import xml.etree.ElementTree as ET\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = ROOT / \"locks\"\n",
    "MANIFESTS = ROOT / \"manifests\"\n",
    "\n",
    "REP_DIR = (\n",
    "    ROOT /\n",
    "    \"GSE157827_AD_replication\"\n",
    ")\n",
    "\n",
    "DOWNLOAD_DIR = (\n",
    "    REP_DIR /\n",
    "    \"downloads\"\n",
    ")\n",
    "\n",
    "SUPP_DIR = (\n",
    "    REP_DIR /\n",
    "    \"Lau2020_supplementary\"\n",
    ")\n",
    "\n",
    "\n",
    "for directory in [\n",
    "    LOCKS,\n",
    "    MANIFESTS,\n",
    "    REP_DIR,\n",
    "    DOWNLOAD_DIR,\n",
    "    SUPP_DIR,\n",
    "]:\n",
    "\n",
    "    directory.mkdir(\n",
    "        parents=True,\n",
    "        exist_ok=True\n",
    "    )\n",
    "\n",
    "\n",
    "DATASET_ROLE_LOCK = (\n",
    "    LOCKS /\n",
    "    \"AD_BRAIN_DATASET_ROLES_v1.json\"\n",
    ")\n",
    "\n",
    "DISCOVERY_ROBUSTNESS_LOCK = (\n",
    "    LOCKS /\n",
    "    \"GSE174367_AD_DISCOVERY_FINAL_ROBUSTNESS_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "RAW_TAR_PATH = (\n",
    "    DOWNLOAD_DIR /\n",
    "    \"GSE157827_RAW.tar\"\n",
    ")\n",
    "\n",
    "SERIES_MATRIX_PATH = (\n",
    "    DOWNLOAD_DIR /\n",
    "    \"GSE157827_series_matrix.txt.gz\"\n",
    ")\n",
    "\n",
    "SAMPLE_MANIFEST_PATH = (\n",
    "    MANIFESTS /\n",
    "    \"GSE157827_OFFICIAL_RAW_SAMPLE_MANIFEST_v1.csv\"\n",
    ")\n",
    "\n",
    "FEATURE_AUDIT_PATH = (\n",
    "    MANIFESTS /\n",
    "    \"GSE157827_RAW_FEATURE_FILE_AUDIT_v3.csv\"\n",
    ")\n",
    "\n",
    "PMC_OBJECT_MANIFEST_PATH = (\n",
    "    MANIFESTS /\n",
    "    \"GSE157827_PMC7568283_AWS_OBJECT_MANIFEST_v1.csv\"\n",
    ")\n",
    "\n",
    "SUPPLEMENT_MANIFEST_PATH = (\n",
    "    MANIFESTS /\n",
    "    \"GSE157827_LAU2020_SUPPLEMENTARY_FILE_MANIFEST_v1.csv\"\n",
    ")\n",
    "\n",
    "XLSX_CANDIDATE_PATH = (\n",
    "    MANIFESTS /\n",
    "    \"GSE157827_LAU2020_XLSX_SAMPLE_METADATA_CANDIDATES_v1.csv\"\n",
    ")\n",
    "\n",
    "PDF_CANDIDATE_PATH = (\n",
    "    MANIFESTS /\n",
    "    \"GSE157827_LAU2020_SI_APPENDIX_PAGE_CANDIDATES_v1.csv\"\n",
    ")\n",
    "\n",
    "RAW_AUDIT_LOCK_PATH = (\n",
    "    LOCKS /\n",
    "    \"GSE157827_AD_REPLICATION_RAW_DATA_AUDIT_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "    DATASET_ROLE_LOCK,\n",
    "    DISCOVERY_ROBUSTNESS_LOCK,\n",
    "    RAW_TAR_PATH,\n",
    "    SERIES_MATRIX_PATH,\n",
    "    SAMPLE_MANIFEST_PATH,\n",
    "]:\n",
    "\n",
    "    assert path.exists(), (\n",
    "        f\"Missing existing STEP-24 input: {path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. VERIFY FROZEN ANALYSIS ROLES\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    DATASET_ROLE_LOCK,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    role_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    DISCOVERY_ROBUSTNESS_LOCK,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    discovery_lock = json.load(f)\n",
    "\n",
    "\n",
    "assert (\n",
    "    role_lock[\"status\"]\n",
    "    ==\n",
    "    \"AD_DATASET_ROLES_FROZEN_BEFORE_DISEASE_EXPRESSION\"\n",
    ")\n",
    "\n",
    "assert (\n",
    "    role_lock[\"primary_discovery\"][\"dataset\"]\n",
    "    ==\n",
    "    \"GSE174367\"\n",
    ")\n",
    "\n",
    "assert (\n",
    "    role_lock[\"primary_replication\"][\"dataset\"]\n",
    "    ==\n",
    "    \"GSE157827\"\n",
    ")\n",
    "\n",
    "assert (\n",
    "    discovery_lock[\"status\"]\n",
    "    ==\n",
    "    \"AD_DISCOVERY_FINAL_ROBUSTNESS_FROZEN\"\n",
    ")\n",
    "\n",
    "assert (\n",
    "    discovery_lock[\"AD_replication_performed\"]\n",
    "    is False\n",
    ")\n",
    "\n",
    "assert (\n",
    "    discovery_lock[\"AD_PD_convergence_performed\"]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "print(\"=\" * 80)\n",
    "print(\"AD REPLICATION ROLE VERIFIED\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "print(\"Discovery:           GSE174367\")\n",
    "print(\"Primary replication: GSE157827\")\n",
    "print(\"Replication disease-expression inspected: NO\")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. HELPERS\n",
    "# ============================================================\n",
    "\n",
    "def sha256_file(\n",
    "    path,\n",
    "    block_size=1024 * 1024\n",
    "):\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\"\n",
    "    ) as f:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            block = f.read(\n",
    "                block_size\n",
    "            )\n",
    "\n",
    "            if not block:\n",
    "                break\n",
    "\n",
    "            h.update(\n",
    "                block\n",
    "            )\n",
    "\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "def sha256_gzip_payload(\n",
    "    path,\n",
    "    block_size=1024 * 1024\n",
    "):\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "    with gzip.open(\n",
    "        path,\n",
    "        \"rb\"\n",
    "    ) as f:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            block = f.read(\n",
    "                block_size\n",
    "            )\n",
    "\n",
    "            if not block:\n",
    "                break\n",
    "\n",
    "            h.update(\n",
    "                block\n",
    "            )\n",
    "\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. REVERIFY EXISTING GEO RAW AUDIT\n",
    "# ============================================================\n",
    "\n",
    "sample_manifest = pd.read_csv(\n",
    "    SAMPLE_MANIFEST_PATH\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    sample_manifest\n",
    ") == 21\n",
    "\n",
    "\n",
    "assert (\n",
    "    sample_manifest[\n",
    "        \"diagnosis_binary\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    "    ==\n",
    "    {\n",
    "        \"AD\": 12,\n",
    "        \"Control\": 9,\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    sample_manifest[\n",
    "        \"matrix_features\"\n",
    "    ]\n",
    "    .eq(\n",
    "        33538\n",
    "    )\n",
    "    .all()\n",
    ")\n",
    "\n",
    "\n",
    "raw_total_barcodes = int(\n",
    "    sample_manifest[\n",
    "        \"raw_filtered_barcodes\"\n",
    "    ]\n",
    "    .sum()\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    raw_total_barcodes\n",
    "    ==\n",
    "    179392\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nExisting GEO raw-data audit: PASS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Samples:\",\n",
    "    len(\n",
    "        sample_manifest\n",
    "    )\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"AD:\",\n",
    "    12\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Control:\",\n",
    "    9\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Raw barcodes:\",\n",
    "    f\"{raw_total_barcodes:,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Features/sample:\",\n",
    "    \"33,538\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. DECOMPRESSED FEATURE PAYLOAD AUDIT\n",
    "# ============================================================\n",
    "\n",
    "feature_rows = []\n",
    "\n",
    "\n",
    "for _, row in sample_manifest.iterrows():\n",
    "\n",
    "\n",
    "    feature_path = Path(\n",
    "        row[\n",
    "            \"feature_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert feature_path.exists()\n",
    "\n",
    "\n",
    "    feature_rows.append({\n",
    "\n",
    "        \"GSM\":\n",
    "            row[\n",
    "                \"GSM\"\n",
    "            ],\n",
    "\n",
    "        \"sample_id\":\n",
    "            row[\n",
    "                \"sample_id\"\n",
    "            ],\n",
    "\n",
    "        \"n_features\":\n",
    "            int(\n",
    "                row[\n",
    "                    \"feature_rows\"\n",
    "                ]\n",
    "            ),\n",
    "\n",
    "        \"compressed_sha256\":\n",
    "            sha256_file(\n",
    "                feature_path\n",
    "            ),\n",
    "\n",
    "        \"decompressed_payload_sha256\":\n",
    "            sha256_gzip_payload(\n",
    "                feature_path\n",
    "            ),\n",
    "\n",
    "        \"feature_file\":\n",
    "            str(\n",
    "                feature_path\n",
    "            ),\n",
    "\n",
    "    })\n",
    "\n",
    "\n",
    "feature_audit = pd.DataFrame(\n",
    "    feature_rows\n",
    ")\n",
    "\n",
    "\n",
    "n_compressed_hashes = int(\n",
    "    feature_audit[\n",
    "        \"compressed_sha256\"\n",
    "    ]\n",
    "    .nunique()\n",
    ")\n",
    "\n",
    "\n",
    "n_payload_hashes = int(\n",
    "    feature_audit[\n",
    "        \"decompressed_payload_sha256\"\n",
    "    ]\n",
    "    .nunique()\n",
    ")\n",
    "\n",    "\n",
    "assert (\n",
    "    n_compressed_hashes\n",
    "    ==\n",
    "    21\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    n_payload_hashes\n",
    "    ==\n",
    "    1\n",
    ")\n",
    "\n",
    "\n",
    "feature_audit.to_csv(\n",
    "    FEATURE_AUDIT_PATH,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"FEATURE TABLE CONTENT AUDIT\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Unique compressed .gz hashes:\",\n",
    "    n_compressed_hashes\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Unique DECOMPRESSED TSV hashes:\",\n",
    "    n_payload_hashes\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Decompressed feature tables identical: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. CURRENT PMC AWS SERVICE\n",
    "# ============================================================\n",
    "\n",
    "S3_BUCKET = (\n",
    "    \"pmc-oa-opendata\"\n",
    ")\n",
    "\n",
    "S3_HTTPS_ROOT = (\n",
    "    \"https://pmc-oa-opendata.s3.amazonaws.com\"\n",
    ")\n",
    "\n",
    "PMCID = (\n",
    "    \"PMC7568283\"\n",
    ")\n",
    "\n",
    "EXPECTED_DOI = (\n",
    "    \"10.1073/pnas.2008762117\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. S3 LIST-OBJECTS HELPER\n",
    "# ============================================================\n",
    "\n",
    "def s3_list_objects(\n",
    "    prefix,\n",
    "    delimiter=None\n",
    "):\n",
    "\n",
    "    all_keys = []\n",
    "    all_prefixes = []\n",
    "\n",
    "    continuation_token = None\n",
    "\n",
    "\n",
    "    while True:\n",
    "\n",
    "\n",
    "        params = {\n",
    "            \"list-type\":\n",
    "                \"2\",\n",
    "\n",
    "            \"prefix\":\n",
    "                prefix,\n",
    "        }\n",
    "\n",
    "\n",
    "        if delimiter is not None:\n",
    "\n",
    "            params[\n",
    "                \"delimiter\"\n",
    "            ] = delimiter\n",
    "\n",
    "\n",
    "        if continuation_token is not None:\n",
    "\n",
    "            params[\n",
    "                \"continuation-token\"\n",
    "            ] = continuation_token\n",
    "\n",
    "\n",
    "        response = requests.get(\n",
    "            S3_HTTPS_ROOT + \"/\",\n",
    "            params=params,\n",
    "            timeout=120,\n",
    "        )\n",
    "\n",
    "\n",
    "        response.raise_for_status()\n",
    "\n",
    "\n",
    "        root = ET.fromstring(\n",
    "            response.content\n",
    "        )\n",
    "\n",
    "\n",
    "        for item in root.findall(\n",
    "            \".//{*}Contents\"\n",
    "        ):\n",
    "\n",
    "\n",
    "            key_node = item.find(\n",
    "                \"{*}Key\"\n",
    "            )\n",
    "\n",
    "\n",
    "            if key_node is not None:\n",
    "\n",
    "                all_keys.append(\n",
    "                    key_node.text\n",
    "                )\n",
    "\n",
    "\n",
    "        for item in root.findall(\n",
    "            \".//{*}CommonPrefixes\"\n",
    "        ):\n",
    "\n",
    "\n",
    "            prefix_node = item.find(\n",
    "                \"{*}Prefix\"\n",
    "            )\n",
    "\n",
    "\n",
    "            if prefix_node is not None:\n",
    "\n",
    "                all_prefixes.append(\n",
    "                    prefix_node.text\n",
    "                )\n",
    "\n",
    "\n",
    "        truncated_text = root.findtext(\n",
    "            \".//{*}IsTruncated\"\n",
    "        )\n",
    "\n",
    "\n",
    "        is_truncated = (\n",
    "            str(\n",
    "                truncated_text\n",
    "            )\n",
    "            .lower()\n",
    "            ==\n",
    "            \"true\"\n",
    "        )\n",
    "\n",
    "\n",
    "        if not is_truncated:\n",
    "\n",
    "            break\n",
    "\n",
    "\n",
    "        continuation_token = root.findtext(\n",
    "            \".//{*}NextContinuationToken\"\n",
    "        )\n",
    "\n",
    "\n",
    "        assert continuation_token is not None\n",
    "\n",
    "\n",
    "    return {\n",
    "        \"keys\":\n",
    "            sorted(\n",
    "                set(\n",
    "                    all_keys\n",
    "                )\n",
    "            ),\n",
    "\n",
    "        \"prefixes\":\n",
    "            sorted(\n",
    "                set(\n",
    "                    all_prefixes\n",
    "                )\n",
    "            ),\n",
    "    }\n",
    "\n",
    "\n",
    "def s3_https_url(\n",
    "    key\n",
    "):\n",
    "\n",
    "    return (\n",
    "        S3_HTTPS_ROOT\n",
    "        +\n",
    "        \"/\"\n",
    "        +\n",
    "        quote(\n",
    "            key,\n",
    "            safe=\"/\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. DISCOVER ALL PMC7568283 ARTICLE VERSIONS\n",
    "#\n",
    "# Current bucket layout:\n",
    "#\n",
    "#     PMC7568283.1/\n",
    "#     PMC7568283.2/\n",
    "#     ...\n",
    "#\n",
    "# Do NOT assume version number.\n",
    "# ============================================================\n",
    "\n",
    "version_listing = s3_list_objects(\n",
    "\n",
    "    prefix=(\n",
    "        PMCID\n",
    "        +\n",
    "        \".\"\n",
    "    ),\n",
    "\n",
    "    delimiter=\"/\",\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "version_prefixes = [\n",
    "\n",
    "    prefix\n",
    "\n",
    "    for prefix\n",
    "    in version_listing[\n",
    "        \"prefixes\"\n",
    "    ]\n",
    "\n",
    "    if re.fullmatch(\n",
    "        rf\"{re.escape(PMCID)}\\.\\d+/\",\n",
    "        prefix\n",
    "    )\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PMC AWS ARTICLE VERSION DISCOVERY\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Discovered article-version prefixes:\"\n",
    ")\n",
    "\n",
    "\n",
    "for prefix in version_prefixes:\n",
    "\n",
    "    print(\n",
    "        \" \",\n",
    "        prefix\n",
    "    )\n",
    "\n",
    "\n",
    "assert len(\n",
    "    version_prefixes\n",
    ") >= 1, (\n",
    "    \"PMC AWS bucket contains no version prefix \"\n",
    "    f\"for {PMCID}.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. READ METADATA FOR EVERY VERSION\n",
    "# ============================================================\n",
    "\n",
    "version_records = []\n",
    "\n",
    "\n",
    "for version_prefix in version_prefixes:\n",
    "\n",
    "\n",
    "    article_objects = s3_list_objects(\n",
    "        prefix=version_prefix\n",
    "    )\n",
    "\n",
    "\n",
    "    object_keys = article_objects[\n",
    "        \"keys\"\n",
    "    ]\n",
    "\n",
    "\n",
    "    version_name = (\n",
    "        version_prefix\n",
    "        .rstrip(\"/\")\n",
    "    )\n",
    "\n",
    "\n",
    "    expected_json_name = (\n",
    "        version_name\n",
    "        +\n",
    "        \".json\"\n",
    "    )\n",
    "\n",
    "\n",
    "    json_keys = [\n",
    "\n",
    "        key\n",
    "\n",
    "        for key\n",
    "        in object_keys\n",
    "\n",
    "        if Path(\n",
    "            key\n",
    "        ).name\n",
    "        ==\n",
    "        expected_json_name\n",
    "\n",
    "    ]\n",
    "\n",
    "\n",
    "    if len(\n",
    "        json_keys\n",
    "    ) == 0:\n",
    "\n",
    "\n",
    "        json_keys = [\n",
    "\n",
    "            key\n",
    "\n",
    "            for key\n",
    "            in object_keys\n",
    "\n",
    "            if key.endswith(\n",
    "                \".json\"\n",
    "            )\n",
    "\n",
    "        ]\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        json_keys\n",
    "    ) >= 1, (\n",
    "        f\"No metadata JSON found for {version_prefix}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    json_key = json_keys[\n",
    "        0\n",
    "    ]\n",
    "\n",
    "\n",
    "    json_url = s3_https_url(\n",
    "        json_key\n",
    "    )\n",
    "\n",
    "\n",
    "    response = requests.get(\n",
    "        json_url,\n",
    "        timeout=120,\n",
    "    )\n",
    "\n",
    "\n",
    "    response.raise_for_status()\n",
    "\n",
    "\n",
    "    metadata = response.json()\n",
    "\n",
    "\n",
    "    version_records.append({\n",
    "\n",
    "        \"version_prefix\":\n",
    "            version_prefix,\n",
    "\n",
    "        \"version_name\":\n",
    "            version_name,\n",
    "\n",
    "        \"metadata_key\":\n",
    "            json_key,\n",
    "\n",
    "        \"metadata_url\":\n",
    "            json_url,\n",
    "\n",
    "        \"metadata\":\n",
    "            metadata,\n",
    "\n",
    "        \"object_keys\":\n",
    "            object_keys,\n",
    "\n",
    "    })\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. DISPLAY VERSION METADATA\n",
    "# ============================================================\n",
    "\n",
    "version_summary_rows = []\n",
    "\n",
    "\n",
    "for record in version_records:\n",
    "\n",
    "\n",
    "    metadata = record[\n",
    "        \"metadata\"\n",
    "    ]\n",
    "\n",
    "\n",
    "    version_summary_rows.append({\n",
    "\n",
    "        \"version_prefix\":\n",
    "            record[\n",
    "                \"version_prefix\"\n",
    "            ],\n",
    "\n",
    "        \"pmcid\":\n",
    "            metadata.get(\n",
    "                \"pmcid\"\n",
    "            ),\n",
    "\n",
    "        \"version\":\n",
    "            metadata.get(\n",
    "                \"version\"\n",
    "            ),\n",
    "\n",
    "        \"pmid\":\n",
    "            metadata.get(\n",
    "                \"pmid\"\n",
    "            ),\n",
    "\n",
    "        \"doi\":\n",
    "            metadata.get(\n",
    "                \"doi\"\n",
    "            ),\n",
    "\n",
    "        \"is_pmc_openaccess\":\n",
    "            metadata.get(\n",
    "                \"is_pmc_openaccess\"\n",
    "            ),\n",
    "\n",
    "        \"is_manuscript\":\n",
    "            metadata.get(\n",
    "                \"is_manuscript\"\n",
    "            ),\n",
    "\n",
    "        \"is_retracted\":\n",
    "            metadata.get(\n",
    "                \"is_retracted\"\n",
    "            ),\n",
    "\n",
    "        \"license_code\":\n",
    "            metadata.get(\n",
    "                \"license_code\"\n",
    "            ),\n",
    "\n",
    "        \"n_objects\":\n",
    "            len(\n",
    "                record[\n",
    "                    \"object_keys\"\n",
    "                ]\n",
    "            ),\n",
    "\n",
    "    })\n",
    "\n",
    "\n",
    "version_summary = pd.DataFrame(\n",
    "    version_summary_rows\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPMC ARTICLE VERSION METADATA:\"\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    version_summary\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. SELECT PUBLISHED VERSION\n",
    "#\n",
    "# Prefer:\n",
    "#   exact PMCID\n",
    "#   exact DOI\n",
    "#   not retracted\n",
    "#   not manuscript\n",
    "#   PMC open-access version\n",
    "#\n",
    "# No version number is hard-coded.\n",
    "# ============================================================\n",
    "\n",
    "def truthy(\n",
    "    value\n",
    "):\n",
    "\n",
    "    if isinstance(\n",
    "        value,\n",
    "        bool\n",
    "    ):\n",
    "\n",
    "        return value\n",
    "\n",
    "\n",
    "    return (\n",
    "        str(\n",
    "            value\n",
    "        )\n",
    "        .strip()\n",
    "        .lower()\n",
    "        in {\n",
    "            \"true\",\n",
    "            \"yes\",\n",
    "            \"1\",\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "candidate_records = []\n",
    "\n",
    "\n",
    "for record in version_records:\n",
    "\n",
    "\n",
    "    metadata = record[\n",
    "        \"metadata\"\n",
    "    ]\n",
    "\n",
    "\n",
    "    pmcid_ok = (\n",
    "        str(\n",
    "            metadata.get(\n",
    "                \"pmcid\"\n",
    "            )\n",
    "        )\n",
    "        ==\n",
    "        PMCID\n",
    "    )\n",
    "\n",
    "\n",
    "    doi_ok = (\n",
    "        str(\n",
    "            metadata.get(\n",
    "                \"doi\",\n",
    "                \"\"\n",
    "            )\n",
    "        )\n",
    "        .lower()\n",
    "        ==\n",
    "        EXPECTED_DOI.lower()\n",
    "    )\n",
    "\n",
    "\n",
    "    not_retracted = (\n",
    "        not truthy(\n",
    "            metadata.get(\n",
    "                \"is_retracted\",\n",
    "                False\n",
    "            )\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    not_manuscript = (\n",
    "        not truthy(\n",
    "            metadata.get(\n",
    "                \"is_manuscript\",\n",
    "                False\n",
    "            )\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    open_access = truthy(\n",
    "        metadata.get(\n",
    "            \"is_pmc_openaccess\",\n",
    "            False\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    score = (\n",
    "        int(\n",
    "            pmcid_ok\n",
    "        )\n",
    "        +\n",
    "        int(\n",
    "            doi_ok\n",
    "        )\n",
    "        +\n",
    "        int(\n",
    "            not_retracted\n",
    "        )\n",
    "        +\n",
    "        int(\n",
    "            not_manuscript\n",
    "        )\n",
    "        +\n",
    "        int(\n",
    "            open_access\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    candidate_records.append(\n",
    "        (\n",
    "            score,\n",
    "            record,\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "candidate_records.sort(\n",
    "    key=lambda x:\n",
    "        x[\n",
    "            0\n",
    "        ],\n",
    "    reverse=True\n",
    ")\n",
    "\n",
    "\n",
    "best_score, selected_record = (\n",
    "    candidate_records[\n",
    "        0\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    best_score\n",
    "    >=\n",
    "    4\n",
    "), (\n",
    "    \"Could not identify a safe published article version.\"\n",
    ")\n",
    "\n",
    "\n",
    "selected_metadata = (\n",
    "    selected_record[\n",
    "        \"metadata\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "selected_prefix = (\n",
    "    selected_record[\n",
    "        \"version_prefix\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "selected_objects = (\n",
    "    selected_record[\n",
    "        \"object_keys\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSelected PMC article version:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    selected_prefix\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"DOI:\",\n",
    "    selected_metadata.get(\n",
    "        \"doi\"\n",
    "    )\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"License:\",\n",
    "    selected_metadata.get(\n",
    "        \"license_code\"\n",
    "    )\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Open access:\",\n",
    "    selected_metadata.get(\n",
    "        \"is_pmc_openaccess\"\n",
    "    )\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Manuscript:\",\n",
    "    selected_metadata.get(\n",
    "        \"is_manuscript\"\n",
    "    )\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Retracted:\",\n",
    "    selected_metadata.get(\n",
    "        \"is_retracted\"\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. ARTICLE OBJECT MANIFEST\n",
    "# ============================================================\n",
    "\n",
    "object_manifest = pd.DataFrame({\n",
    "\n",
    "    \"object_key\":\n",
    "        selected_objects,\n",
    "\n",
    "})\n",
    "\n",
    "\n",
    "object_manifest[\n",
    "    \"basename\"\n",
    "] = (\n",
    "\n",
    "    object_manifest[\n",
    "        \"object_key\"\n",
    "    ]\n",
    "    .map(\n",
    "        lambda x:\n",
    "            Path(\n",
    "                x\n",
    "            ).name\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "object_manifest[\n",
    "    \"url\"\n",
    "] = (\n",
    "\n",
    "    object_manifest[\n",
    "        \"object_key\"\n",
    "    ]\n",
    "    .map(\n",
    "        s3_https_url\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "object_manifest[\n",
    "    \"extension\"\n",
    "] = (\n",
    "\n",
    "    object_manifest[\n",
    "        \"basename\"\n",
    "    ]\n",
    "    .map(\n",
    "        lambda x:\n",
    "            Path(\n",
    "                x\n",
    "            ).suffix.lower()\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "object_manifest.to_csv(\n",
    "    PMC_OBJECT_MANIFEST_PATH,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PMC AWS ARTICLE OBJECTS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    object_manifest\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 12. EXPECTED PUBLISHED SUPPLEMENT FILES\n",
    "# ============================================================\n",
    "\n",
    "SUPPLEMENT_BASENAMES = [\n",
    "\n",
    "    \"pnas.2008762117.sapp.pdf\",\n",
    "\n",
    "    \"pnas.2008762117.sd01.xlsx\",\n",
    "    \"pnas.2008762117.sd02.xlsx\",\n",
    "    \"pnas.2008762117.sd03.xlsx\",\n",
    "    \"pnas.2008762117.sd04.xlsx\",\n",
    "    \"pnas.2008762117.sd05.xlsx\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 13. MATCH SUPPLEMENTS AGAINST ACTUAL S3 OBJECTS\n",
    "# ============================================================\n",
    "\n",
    "object_by_basename = {\n",
    "\n",
    "    Path(\n",
    "        key\n",
    "    ).name:\n",
    "        key\n",
    "\n",
    "    for key\n",
    "    in selected_objects\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "missing_supplements = [\n",
    "\n",
    "    filename\n",
    "\n",
    "    for filename\n",
    "    in SUPPLEMENT_BASENAMES\n",
    "\n",
    "    if filename\n",
    "    not in\n",
    "    object_by_basename\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "if missing_supplements:\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nExact expected filenames missing:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        missing_supplements\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nAvailable PDF/XLSX objects:\"\n",
    "    )\n",
    "\n",
    "\n",
    "    available_binary_objects = [\n",
    "\n",
    "        key\n",
    "\n",
    "        for key\n",
    "        in selected_objects\n",
    "\n",
    "        if (\n",
    "            key.lower().endswith(\n",
    "                \".pdf\"\n",
    "            )\n",
    "            or\n",
    "            key.lower().endswith(\n",
    "                \".xlsx\"\n",
    "            )\n",
    "        )\n",
    "\n",
    "    ]\n",
    "\n",
    "\n",
    "    for key in available_binary_objects:\n",
    "\n",
    "        print(\n",
    "            key\n",
    "        )\n",
    "\n",
    "\n",
    "assert not missing_supplements, (\n",
    "    \"One or more published supplementary files are \"\n",
    "    \"not present under the selected PMC AWS version.\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nAll six expected supplementary objects found in AWS: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 14. DOWNLOAD VALIDATION\n",
    "# ============================================================\n",
    "\n",
    "def valid_file_magic(\n",
    "    filename,\n",
    "    path\n",
    "):\n",
    "\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\"\n",
    "    ) as f:\n",
    "\n",
    "        first_bytes = f.read(\n",
    "            8\n",
    "        )\n",
    "\n",
    "\n",
    "    if filename.lower().endswith(\n",
    "        \".pdf\"\n",
    "    ):\n",
    "\n",
    "        return first_bytes.startswith(\n",
    "            b\"%PDF\"\n",
    "        )\n",
    "\n",
    "\n",
    "    if filename.lower().endswith(\n",
    "        \".xlsx\"\n",
    "    ):\n",
    "\n",
    "        # XLSX is a ZIP container.\n",
    "        return first_bytes.startswith(\n",
    "            b\"PK\"\n",
    "        )\n",
    "\n",
    "\n",
    "    return False\n",
    "\n",
    "\n",
    "def download_s3_object(\n",
    "    key,\n",
    "    destination\n",
    "):\n",
    "\n",
    "\n",
    "    destination = Path(\n",
    "        destination\n",
    "    )\n",
    "\n",
    "\n",
    "    url = s3_https_url(\n",
    "        key\n",
    "    )\n",
    "\n",
    "\n",
    "    # Reuse only if already valid.\n",
    "    if destination.exists():\n",
    "\n",
    "\n",
    "        if valid_file_magic(\n",
    "            destination.name,\n",
    "            destination\n",
    "        ):\n",
    "\n",
    "            return {\n",
    "                \"object_key\":\n",
    "                    key,\n",
    "\n",
    "                \"url\":\n",
    "                    url,\n",
    "\n",
    "                \"path\":\n",
    "                    str(\n",
    "                        destination\n",
    "                    ),\n",
    "\n",
    "                \"bytes\":\n",
    "                    int(\n",    "                        destination.stat().st_size\n",
    "                    ),\n",
    "\n",
    "                \"sha256\":\n",
    "                    sha256_file(\n",
    "                        destination\n",
    "                    ),\n",
    "\n",
    "                \"reused\":\n",
    "                    True,\n",
    "            }\n",
    "\n",
    "\n",
    "        destination.unlink()\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nDownloading:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        url\n",
    "    )\n",
    "\n",
    "\n",
    "    with requests.get(\n",
    "        url,\n",
    "        stream=True,\n",
    "        timeout=(30, 300),\n",
    "    ) as response:\n",
    "\n",
    "\n",
    "        response.raise_for_status()\n",
    "\n",
    "\n",
    "        content_type = (\n",
    "            response.headers.get(\n",
    "                \"Content-Type\",\n",
    "                \"\"\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "        print(\n",
    "            \"Content-Type:\",\n",
    "            content_type\n",
    "        )\n",
    "\n",
    "\n",
    "        with open(\n",
    "            destination,\n",
    "            \"wb\"\n",
    "        ) as f:\n",
    "\n",
    "\n",
    "            for chunk in response.iter_content(\n",
    "                chunk_size=1024 * 1024\n",
    "            ):\n",
    "\n",
    "\n",
    "                if chunk:\n",
    "\n",
    "                    f.write(\n",
    "                        chunk\n",
    "                    )\n",
    "\n",
    "\n",
    "    assert valid_file_magic(\n",
    "        destination.name,\n",
    "        destination\n",
    "    ), (\n",
    "        f\"Downloaded object is not a valid \"\n",
    "        f\"{destination.suffix}: {destination}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    return {\n",
    "        \"object_key\":\n",
    "            key,\n",
    "\n",
    "        \"url\":\n",
    "            url,\n",
    "\n",
    "        \"path\":\n",
    "            str(\n",
    "                destination\n",
    "            ),\n",
    "\n",
    "        \"bytes\":\n",
    "            int(\n",
    "                destination.stat().st_size\n",
    "            ),\n",
    "\n",
    "        \"sha256\":\n",
    "            sha256_file(\n",
    "                destination\n",
    "            ),\n",
    "\n",
    "        \"reused\":\n",
    "            False,\n",
    "    }\n",
    "\n",
    "\n",
    "supplement_records = []\n",
    "\n",
    "\n",
    "for filename in SUPPLEMENT_BASENAMES:\n",
    "\n",
    "\n",
    "    key = object_by_basename[\n",
    "        filename\n",
    "    ]\n",
    "\n",
    "\n",
    "    destination = (\n",
    "        SUPP_DIR /\n",
    "        filename\n",
    "    )\n",
    "\n",
    "\n",
    "    record = download_s3_object(\n",
    "        key,\n",
    "        destination\n",
    "    )\n",
    "\n",
    "\n",
    "    record[\n",
    "        \"filename\"\n",
    "    ] = filename\n",
    "\n",
    "\n",
    "    supplement_records.append(\n",
    "        record\n",
    "    )\n",
    "\n",
    "\n",
    "supplement_manifest = pd.DataFrame(\n",
    "    supplement_records\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    supplement_manifest\n",
    ") == 6\n",
    "\n",
    "\n",
    "supplement_manifest.to_csv(\n",
    "    SUPPLEMENT_MANIFEST_PATH,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PMC AWS SUPPLEMENT DOWNLOAD: PASS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    supplement_manifest[\n",
    "        [\n",
    "            \"filename\",\n",
    "            \"bytes\",\n",
    "            \"sha256\",\n",
    "            \"reused\",\n",
    "        ]\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 15. OFFICIAL SAMPLE TOKENS\n",
    "# ============================================================\n",
    "\n",
    "SAMPLE_TOKENS = [\n",
    "\n",
    "    \"AD1\",\n",
    "    \"AD2\",\n",
    "    \"AD4\",\n",
    "    \"AD5\",\n",
    "    \"AD6\",\n",
    "    \"AD8\",\n",
    "    \"AD9\",\n",
    "    \"AD10\",\n",
    "    \"AD13\",\n",
    "    \"AD19\",\n",
    "    \"AD20\",\n",
    "    \"AD21\",\n",
    "\n",
    "    \"NC3\",\n",
    "    \"NC7\",\n",
    "    \"NC11\",\n",
    "    \"NC12\",\n",
    "    \"NC14\",\n",
    "    \"NC15\",\n",
    "    \"NC16\",\n",
    "    \"NC17\",\n",
    "    \"NC18\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "assert len(\n",
    "    SAMPLE_TOKENS\n",
    ") == 21\n",
    "\n",
    "\n",
    "def find_sample_tokens_in_text(\n",
    "    text\n",
    "):\n",
    "\n",
    "\n",
    "    found = []\n",
    "\n",
    "\n",
    "    for token in SAMPLE_TOKENS:\n",
    "\n",
    "\n",
    "        if re.search(\n",
    "            rf\"(?<![A-Za-z0-9])\"\n",
    "            rf\"{re.escape(token)}\"\n",
    "            rf\"(?![A-Za-z0-9])\",\n",
    "            str(\n",
    "                text\n",
    "            ),\n",
    "            flags=re.IGNORECASE,\n",
    "        ):\n",
    "\n",
    "            found.append(\n",
    "                token\n",
    "            )\n",
    "\n",
    "\n",
    "    return found\n",
    "\n",
    "\n",
    "def find_sample_tokens_in_dataframe(\n",
    "    df\n",
    "):\n",
    "\n",
    "\n",
    "    flattened_text = \"\\n\".join(\n",
    "\n",
    "        df\n",
    "        .astype(str)\n",
    "        .to_numpy()\n",
    "        .ravel()\n",
    "        .tolist()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    return find_sample_tokens_in_text(\n",
    "        flattened_text\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 16. XLSX AUDIT\n",
    "#\n",
    "# We DO NOT assume which workbook contains Table S1.\n",
    "# ============================================================\n",
    "\n",
    "xlsx_candidate_rows = []\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"SUPPLEMENTARY XLSX AUDIT\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "for filename in SUPPLEMENT_BASENAMES:\n",
    "\n",
    "\n",
    "    if not filename.endswith(\n",
    "        \".xlsx\"\n",
    "    ):\n",
    "\n",
    "        continue\n",
    "\n",
    "\n",
    "    workbook_path = (\n",
    "        SUPP_DIR /\n",
    "        filename\n",
    "    )\n",
    "\n",
    "\n",
    "    workbook = pd.ExcelFile(\n",
    "        workbook_path\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nWORKBOOK:\",\n",
    "        filename\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Sheets:\",\n",
    "        workbook.sheet_names\n",
    "    )\n",
    "\n",
    "\n",
    "    for sheet in workbook.sheet_names:\n",
    "\n",
    "\n",
    "        df = pd.read_excel(\n",
    "            workbook_path,\n",
    "            sheet_name=sheet,\n",
    "            header=None,\n",
    "            dtype=object,\n",
    "        )\n",
    "\n",
    "\n",
    "        matches = (\n",
    "            find_sample_tokens_in_dataframe(\n",
    "                df\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "        xlsx_candidate_rows.append({\n",
    "\n",
    "            \"workbook\":\n",
    "                filename,\n",
    "\n",
    "            \"sheet\":\n",
    "                str(\n",
    "                    sheet\n",
    "                ),\n",
    "\n",
    "            \"n_rows\":\n",
    "                int(\n",
    "                    df.shape[\n",
    "                        0\n",
    "                    ]\n",
    "                ),\n",
    "\n",
    "            \"n_columns\":\n",
    "                int(\n",
    "                    df.shape[\n",
    "                        1\n",
    "                    ]\n",
    "                ),\n",
    "\n",
    "            \"n_matching_sample_IDs\":\n",
    "                int(\n",
    "                    len(\n",
    "                        matches\n",
    "                    )\n",
    "                ),\n",
    "\n",
    "            \"matched_sample_IDs\":\n",
    "                \";\".join(\n",
    "                    matches\n",
    "                ),\n",
    "\n",
    "        })\n",
    "\n",
    "\n",
    "        if len(\n",
    "            matches\n",
    "        ) > 0:\n",
    "\n",
    "\n",
    "            print(\n",
    "                \"\\n\"\n",
    "                +\n",
    "                \"-\" * 80\n",
    "            )\n",
    "\n",
    "            print(\n",
    "                \"SAMPLE-MATCHING SHEET:\"\n",
    "            )\n",
    "\n",
    "            print(\n",
    "                filename,\n",
    "                \"/\",\n",
    "                sheet\n",
    "            )\n",
    "\n",
    "            print(\n",
    "                \"Matched:\",\n",
    "                len(\n",
    "                    matches\n",
    "                ),\n",
    "                \"/21\"\n",
    "            )\n",
    "\n",
    "            print(\n",
    "                matches\n",
    "            )\n",
    "\n",
    "\n",
    "            display(\n",
    "                df.head(\n",
    "                    50\n",
    "                )\n",
    "            )\n",
    "\n",
    "\n",
    "xlsx_candidates = pd.DataFrame(\n",
    "    xlsx_candidate_rows\n",
    ")\n",
    "\n",
    "\n",
    "xlsx_candidates = (\n",
    "\n",
    "    xlsx_candidates\n",
    "    .sort_values(\n",
    "        \"n_matching_sample_IDs\",\n",
    "        ascending=False\n",
    "    )\n",
    "    .reset_index(\n",
    "        drop=True\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "xlsx_candidates.to_csv(\n",
    "    XLSX_CANDIDATE_PATH,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nXLSX SAMPLE-METADATA CANDIDATES:\"\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    xlsx_candidates\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 17. PDF TEXT EXTRACTION\n",
    "#\n",
    "# Text extraction only.\n",
    "# NO OCR.\n",
    "# ============================================================\n",
    "\n",
    "try:\n",
    "\n",
    "    from pypdf import PdfReader\n",
    "\n",
    "except ImportError:\n",
    "\n",
    "\n",
    "    subprocess.check_call(\n",
    "        [\n",
    "            sys.executable,\n",
    "            \"-m\",\n",
    "            \"pip\",\n",
    "            \"install\",\n",
    "            \"-q\",\n",
    "            \"pypdf\",\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    from pypdf import PdfReader\n",
    "\n",
    "\n",
    "SI_PDF_PATH = (\n",
    "    SUPP_DIR /\n",
    "    \"pnas.2008762117.sapp.pdf\"\n",
    ")\n",
    "\n",
    "\n",
    "assert SI_PDF_PATH.exists()\n",
    "\n",
    "\n",
    "reader = PdfReader(\n",
    "    str(\n",
    "        SI_PDF_PATH\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "pdf_candidate_rows = []\n",
    "\n",
    "pdf_page_texts = []\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"SI APPENDIX PDF TEXT AUDIT\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Pages:\",\n",
    "    len(\n",
    "        reader.pages\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "for page_number, page in enumerate(\n",
    "    reader.pages,\n",
    "    start=1\n",
    "):\n",
    "\n",
    "\n",
    "    text = (\n",
    "        page.extract_text()\n",
    "        or\n",
    "        \"\"\n",
    "    )\n",
    "\n",
    "\n",
    "    pdf_page_texts.append(\n",
    "        text\n",
    "    )\n",
    "\n",
    "\n",
    "    matches = (\n",
    "        find_sample_tokens_in_text(\n",
    "            text\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    table_s1 = bool(\n",
    "\n",
    "        re.search(\n",
    "            r\"\\bTable\\s+S1\\b\",\n",
    "            text,\n",
    "            flags=re.IGNORECASE,\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    sequencing_characteristics = bool(\n",
    "\n",
    "        re.search(\n",
    "            r\"sequencing\\s+characteristics\",\n",
    "            text,\n",
    "            flags=re.IGNORECASE,\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    pdf_candidate_rows.append({\n",
    "\n",
    "        \"page\":\n",
    "            int(\n",
    "                page_number\n",
    "            ),\n",
    "\n",
    "        \"contains_Table_S1\":\n",
    "            table_s1,\n",
    "\n",
    "        \"contains_sequencing_characteristics\":\n",
    "            sequencing_characteristics,\n",
    "\n",
    "        \"n_matching_sample_IDs\":\n",
    "            int(\n",
    "                len(\n",
    "                    matches\n",
    "                )\n",
    "            ),\n",
    "\n",
    "        \"matched_sample_IDs\":\n",
    "            \";\".join(\n",
    "                matches\n",
    "            ),\n",
    "\n",
    "        \"text_characters\":\n",
    "            int(\n",
    "                len(\n",
    "                    text\n",
    "                )\n",
    "            ),\n",
    "\n",
    "    })\n",
    "\n",
    "\n",
    "    if (\n",
    "        table_s1\n",
    "        or\n",
    "        sequencing_characteristics\n",
    "        or\n",
    "        len(\n",
    "            matches\n",
    "        ) >= 3\n",
    "    ):\n",
    "\n",
    "\n",
    "        print(\n",
    "            \"\\n\"\n",
    "            +\n",
    "            \"-\" * 80\n",
    "        )\n",
    "\n",
    "        print(\n",
    "            \"SI PAGE:\",\n",
    "            page_number\n",
    "        )\n",
    "\n",
    "        print(\n",
    "            \"Table S1:\",\n",
    "            table_s1\n",
    "        )\n",
    "\n",
    "        print(\n",
    "            \"Sequencing characteristics:\",\n",
    "            sequencing_characteristics\n",
    "        )\n",
    "\n",
    "        print(\n",
    "            \"Matched sample IDs:\",\n",
    "            len(\n",
    "                matches\n",
    "            )\n",
    "        )\n",
    "\n",
    "        print(\n",
    "            matches\n",
    "        )\n",
    "\n",
    "\n",
    "        print(\n",
    "            \"\\nTEXT PREVIEW:\"\n",
    "        )\n",
    "\n",
    "\n",
    "        print(\n",
    "            text[\n",
    "                :8000\n",
    "            ]\n",
    "        )\n",
    "\n",
    "\n",
    "pdf_candidates = pd.DataFrame(\n",
    "    pdf_candidate_rows\n",
    ")\n",
    "\n",
    "\n",
    "pdf_candidates.to_csv(\n",
    "    PDF_CANDIDATE_PATH,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 18. GLOBAL PDF SAMPLE-ID COVERAGE\n",
    "# ============================================================\n",
    "\n",
    "all_pdf_text = \"\\n\".join(\n",
    "    pdf_page_texts\n",
    ")\n",
    "\n",
    "\n",
    "global_pdf_matches = (\n",
    "    find_sample_tokens_in_text(\n",
    "        all_pdf_text\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "table_s1_pages = (\n",
    "\n",
    "    pdf_candidates.loc[\n",
    "        pdf_candidates[\n",
    "            \"contains_Table_S1\"\n",
    "        ],\n",
    "        \"page\"\n",
    "    ]\n",
    "    .astype(int)\n",
    "    .tolist()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "sequence_characteristics_pages = (\n",
    "\n",
    "    pdf_candidates.loc[\n",
    "        pdf_candidates[\n",
    "            \"contains_sequencing_characteristics\"\n",
    "        ],\n",
    "        \"page\"\n",
    "    ]\n",
    "    .astype(int)\n",
    "    .tolist()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"SI APPENDIX SAMPLE-METADATA SEARCH\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Sample IDs found anywhere in PDF:\",\n",
    "    len(\n",
    "        global_pdf_matches\n",
    "    ),\n",
    "    \"/21\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    global_pdf_matches\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Pages containing 'Table S1':\",\n",
    "    table_s1_pages\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Pages containing 'sequencing characteristics':\",\n",
    "    sequence_characteristics_pages\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 19. IDENTIFY BEST AVAILABLE METADATA LOCATION\n",
    "#\n",
    "# This does NOT freeze covariates yet.\n",
    "# ============================================================\n",
    "\n",
    "best_xlsx_match = (\n",
    "\n",
    "    int(\n",
    "        xlsx_candidates[\n",
    "            \"n_matching_sample_IDs\"\n",
    "        ].max()\n",
    "    )\n",
    "\n",
    "    if len(\n",
