 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# RETINA-ND — bioRxiv code release\n",
    "\n",
    "This is the submission-facing, code-only release notebook for the analyses reported in:\n",
    "\n",
    "**Cross-disease glial transcriptomic convergence in Alzheimer’s and Parkinson’s disease with independent retinal and ocular proteomic support**\n",
    "\n",
    "### What was cleaned\n",
    "- removed embedded execution outputs;\n",
    "- removed obsolete/duplicate figure-generation cells;\n",
    "- retained the final Figure 1–5 and Supplementary Figure S1–S3 code paths;\n",
    "- centralized the project root through `RETINA_ND_ROOT`;\n",
    "- replaced the interactive Wolf Table S7 upload with a deterministic file check;\n",
    "- made the PXD073336 download cell self-contained;\n",
    "- requires the exact frozen Reactome V97 GMT rather than silently using a future Reactome release.\n",
    "\n",
    "### Important\n",
    "The original recovery notebook is historical provenance. This release notebook is the version intended for sharing and fresh testing. The statistical code and frozen analysis rules are preserved; cosmetic/recovery-only notebook material was removed.\n",
    "\n",
    "Run this notebook in a **fresh Google Colab runtime from top to bottom** before public release.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# 00 — RELEASE SETUP\n",
    "# ============================================================\n",
    "\n",
    "import os\n",
    "import sys\n",
    "import json\n",
    "import platform\n",
    "import subprocess\n",
    "import importlib.metadata\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "# Mount Google Drive when running in Colab.\n",
    "try:\n",
    "    from google.colab import drive\n",
    "    mount = Path(\"/content/drive\")\n",
    "    if not (mount / \"MyDrive\").exists():\n",
    "        drive.mount(str(mount), force_remount=False)\n",
    "except Exception:\n",
    "    pass\n",
    "\n",
    "# Prefer the user's completed project when it exists; otherwise use the\n",
    "# standard release folder name. The environment variable can override both.\n",
    "candidate_existing = Path(\"/content/drive/MyDrive/RETINA_ND_V2 (1)\")\n",
    "candidate_standard = Path(\"/content/drive/MyDrive/RETINA_ND_V2\")\n",
    "\n",
    "if \"RETINA_ND_ROOT\" in os.environ:\n",
    "    PROJECT_ROOT = Path(os.environ[\"RETINA_ND_ROOT\"])\n",
    "elif candidate_existing.exists():\n",
    "    PROJECT_ROOT = candidate_existing\n",
    "else:\n",
    "    PROJECT_ROOT = candidate_standard\n",
    "\n",
    "PROJECT_ROOT = PROJECT_ROOT.resolve()\n",
    "PROJECT_ROOT.mkdir(parents=True, exist_ok=True)\n",
    "os.environ[\"RETINA_ND_ROOT\"] = str(PROJECT_ROOT)\n",
    "\n",
    "ROOT = PROJECT_ROOT\n",
    "LOCKS = ROOT / \"locks\"\n",
    "MANIFESTS = ROOT / \"manifests\"\n",
    "RESULTS = ROOT / \"results\"\n",
    "\n",
    "for p in [\n",
    "    LOCKS,\n",
    "    MANIFESTS,\n",
    "    RESULTS,\n",
    "    ROOT / \"downloads\",\n",
    "    ROOT / \"scripts\",\n",
    "    ROOT / \"logs\",\n",
    "    ROOT / \"resources\",\n",
    "]:\n",
    "    p.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "STRICT_REFERENCE_CHECKS = True\n",
    "PROJECT_VERSION = \"2.0-biorxiv-release\"\n",
    "\n",
    "print(\"RETINA-ND project root:\", ROOT)\n",
    "print(\"UTC:\", datetime.now(timezone.utc).isoformat())\n",
    "print(\"Python:\", platform.python_version())\n",
    "print(\"STRICT_REFERENCE_CHECKS:\", STRICT_REFERENCE_CHECKS)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# 01 — ENVIRONMENT SNAPSHOT\n",
    "# Critical versions recorded in the executed analysis are checked here.\n",
    "# ============================================================\n",
    "\n",
    "import importlib.metadata\n",
    "\n",
    "expected = {\n",
    "    \"pandas\": \"2.3.3\",\n",
    "    \"pydeseq2\": \"0.5.4\",\n",
    "    \"numpy\": \"2.1.3\",\n",
    "    \"scipy\": \"1.16.3\",\n",
    "    \"anndata\": \"0.13.3.post0\",\n",
    "}\n",
    "\n",
    "optional_expected = {\n",
    "    \"scanpy\": \"1.12.4\",\n",
    "    \"harmonypy\": \"2.0.0\",\n",
    "    \"leidenalg\": \"0.12.0\",\n",
    "    \"igraph\": \"1.0.0\",\n",
    "    \"scikit-misc\": \"0.5.2\",\n",
    "}\n",
    "\n",
    "def version_of(pkg):\n",
    "    try:\n",
    "        return importlib.metadata.version(pkg)\n",
    "    except importlib.metadata.PackageNotFoundError:\n",
    "        return None\n",
    "\n",
    "print(\"Critical environment:\")\n",
    "for pkg, expected_version in expected.items():\n",
    "    current = version_of(pkg)\n",
    "    print(f\"  {pkg}: current={current}, expected={expected_version}\")\n",
    "\n",
    "print(\"\\nAnnotation environment:\")\n",
    "for pkg, expected_version in optional_expected.items():\n",
    "    current = version_of(pkg)\n",
    "    print(f\"  {pkg}: current={current}, expected={expected_version}\")\n",
    "\n",
    "print(\"\\nOther packages used:\")\n",
    "for pkg in [\"gseapy\", \"matplotlib\", \"requests\", \"openpyxl\", \"h5py\", \"pypdf\"]:\n",
    "    print(f\"  {pkg}: {version_of(pkg)}\")\n",
    "\n",
    "snapshot = {\n",
    "    pkg: version_of(pkg)\n",
    "    for pkg in sorted(set(expected) | set(optional_expected) |\n",
    "                      {\"gseapy\", \"matplotlib\", \"requests\", \"openpyxl\", \"h5py\", \"pypdf\"})\n",
    "}\n",
    "\n",
    "with open(ROOT / \"release_environment_snapshot.json\", \"w\", encoding=\"utf-8\") as f:\n",
    "    json.dump(snapshot, f, indent=2)\n",
    "\n",
    "print(\"\\nEnvironment snapshot written to:\")\n",
    "print(ROOT / \"release_environment_snapshot.json\")\n"
   ]
  },
