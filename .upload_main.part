    "# Source analysis cell: 33\n",
    "# ============================================================\n",
    "# STEP 18 — FIRST FROZEN PD DISCOVERY ↔ REPLICATION COMPARISON\n",
    "#\n",
    "# GSE243639 = discovery\n",
