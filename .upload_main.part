   "source": [
    "# Source analysis cell: 31\n",
    "# ============================================================\n",
    "# STEP 16A — GSE157783 PRIMARY REPLICATION DE AUDIT\n",
    "#\n",
    "# NO NEW DIFFERENTIAL EXPRESSION.\n",
    "# NO PMI SENSITIVITY.\n",
    "# NO GSE243639 ↔ GSE157783 COMPARISON.\n",
    "#\n",
    "# PURPOSE\n",
    "# -------\n",
    "# 1. Verify STEP 16 run + effect-freeze locks.\n",
    "# 2. Verify every all-gene result hash.\n",
    "# 3. Verify every frozen effect-vector hash.\n",
    "# 4. Verify exact STEP-15 gene universes.\n",
    "# 5. Independently recalculate:\n",
    "#       finite LFC\n",
    "#       finite Wald\n",
    "#       finite p\n",
    "#       finite padj\n",
    "#       FDR < 0.05\n",
    "#       up/down counts\n",
    "# 6. Confirm FDR summary agrees with STEP 16.\n",
    "# 7. Reveal the strongest replication-only genes.\n",
    "# 8. Save a replication audit lock.\n",
    "#\n",
    "# IMPORTANT\n",
    "# ---------\n",
    "# Discovery dataset GSE243639 is NOT read anywhere here.\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import hashlib\n",
    "import json\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = ROOT / \"locks\"\n",
    "\n",
    "DE_ROOT = (\n",
    "    ROOT /\n",
    "    \"PD_replication_DE\"\n",
    ")\n",
    "\n",
    "FREEZE_ROOT = (\n",
    "    ROOT /\n",
    "    \"PD_replication_frozen\"\n",
    ")\n",
    "\n",
    "\n",
    "pre_de_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE157783_REPLICATION_PRE_DE_LOCK_v1.json\"\n",
    ")\n",
    "\n",
    "de_run_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE157783_PRIMARY_PD_REPLICATION_DE_RUN_v1.json\"\n",
    ")\n",
    "\n",
    "effect_freeze_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE157783_PD_REPLICATION_EFFECT_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "summary_path = (\n",
    "    DE_ROOT /\n",
    "    \"GSE157783_PRIMARY_PD_REPLICATION_DE_SUMMARY_v1.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "audit_output_path = (\n",
    "    DE_ROOT /\n",
    "    \"GSE157783_PRIMARY_PD_REPLICATION_DE_AUDIT_v1.csv\"\n",
    ")\n",
    "\n",
    "audit_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE157783_PRIMARY_PD_REPLICATION_DE_AUDIT_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "\n",
    "    pre_de_lock_path,\n",
    "    de_run_lock_path,\n",
    "    effect_freeze_lock_path,\n",
    "    summary_path,\n",
    "\n",
    "]:\n",
    "\n",
    "    assert path.exists(), (\n",
    "        f\"Missing required file: {path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. LOAD LOCKS\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    pre_de_lock_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    pre_de_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    de_run_lock_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    de_run_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    effect_freeze_lock_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    effect_freeze = json.load(f)\n",
    "\n",
    "\n",
    "summary = pd.read_csv(\n",
    "    summary_path\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. LOCK INTEGRITY\n",
    "# ============================================================\n",
    "\n",
    "assert (\n",
    "    pre_de_lock[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"REPLICATION_PRE_DE_LOCK\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    de_run_lock[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"PRIMARY_REPLICATION_DE_COMPLETE\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    effect_freeze[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"PD_REPLICATION_EFFECTS_FROZEN\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    de_run_lock[\n",
    "        \"gene_universes_refiltered\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    de_run_lock[\n",
    "        \"technical_PMI_sensitivity_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    de_run_lock[\n",
    "        \"discovery_replication_effect_comparison_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    effect_freeze[\n",
    "        \"effects_frozen_before_discovery_comparison\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    effect_freeze[\n",
    "        \"discovery_replication_effect_comparison_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 16 LOCK INTEGRITY: PASS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. EXPECTED CLASSES\n",
    "# ============================================================\n",
    "\n",
    "PRIMARY_CLASSES = [\n",
    "\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "EXPECTED_UNIVERSES = {\n",
    "\n",
    "    \"Astro\":\n",
    "        17387,\n",
    "\n",
    "    \"Micro\":\n",
    "        15905,\n",
    "\n",
    "    \"OPC\":\n",
    "        16409,\n",
    "\n",
    "    \"Oligo\":\n",
    "        15346,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "EXPECTED_FDR = {\n",
    "\n",
    "    \"Astro\":\n",
    "        198,\n",
    "\n",
    "    \"Micro\":\n",
    "        6,\n",
    "\n",
    "    \"OPC\":\n",
    "        4,\n",
    "\n",
    "    \"Oligo\":\n",
    "        177,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "EXPECTED_UP = {\n",
    "\n",
    "    \"Astro\":\n",
    "        123,\n",
    "\n",
    "    \"Micro\":\n",
    "        5,\n",
    "\n",
    "    \"OPC\":\n",
    "        1,\n",
    "\n",
    "    \"Oligo\":\n",
    "        98,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "EXPECTED_DOWN = {\n",
    "\n",
    "    \"Astro\":\n",
    "        75,\n",
    "\n",
    "    \"Micro\":\n",
    "        1,\n",
    "\n",
    "    \"OPC\":\n",
    "        3,\n",
    "\n",
    "    \"Oligo\":\n",
    "        79,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "assert (\n",
    "    summary[\n",
    "        \"cell_type\"\n",
    "    ].tolist()\n",
    "    ==\n",
    "    PRIMARY_CLASSES\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. HELPERS\n",
    "# ============================================================\n",
    "\n",
    "def sha256_file(\n",
    "    path,\n",
    "    block_size=1024 * 1024\n",
    "):\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\"\n",
    "    ) as f:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            block = f.read(\n",
    "                block_size\n",
    "            )\n",
    "\n",
    "\n",
    "            if not block:\n",
    "\n",
    "                break\n",
    "\n",
    "\n",
    "            h.update(\n",
    "                block\n",
    "            )\n",
    "\n",
    "\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "def ordered_gene_hash(\n",
    "    genes\n",
    "):\n",
    "\n",
    "    payload = (\n",
    "\n",
    "        \"\\n\".join(\n",
    "            map(\n",
    "                str,\n",
    "                genes\n",
    "            )\n",
    "        )\n",
    "\n",
    "        +\n",
    "\n",
    "        \"\\n\"\n",
    "\n",
    "    ).encode(\n",
    "        \"utf-8\"\n",
    "    )\n",
    "\n",
    "\n",
    "    return hashlib.sha256(\n",
    "        payload\n",
    "    ).hexdigest()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. AUDIT STORAGE\n",
    "# ============================================================\n",
    "\n",
    "audit_rows = []\n",
    "\n",
    "top_tables = {}\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. AUDIT FOUR REPLICATION CELL CLASSES\n",
    "# ============================================================\n",
    "\n",
    "for cell_type in PRIMARY_CLASSES:\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\n\"\n",
    "        +\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        cell_type\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.1 LOCK RECORDS\n",
    "    # ========================================================\n",
    "\n",
    "    de_record = (\n",
    "\n",
    "        de_run_lock[\n",
    "            \"cell_class_results\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    freeze_record = (\n",
    "\n",
    "        effect_freeze[\n",
    "            \"cell_class_effect_vectors\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    universe_record = (\n",
    "\n",
    "        pre_de_lock[\n",
    "            \"cell_class_gene_universes\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.2 PATHS\n",
    "    # ========================================================\n",
    "\n",
    "    result_path = Path(\n",
    "        de_record[\n",
    "            \"all_gene_results\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    effect_path = Path(\n",
    "        freeze_record[\n",
    "            \"effect_vector_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    universe_path = Path(\n",
    "        universe_record[\n",
    "            \"gene_universe_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    for path in [\n",
    "\n",
    "        result_path,\n",
    "        effect_path,\n",
    "        universe_path,\n",
    "\n",
    "    ]:\n",
    "\n",
    "        assert path.exists(), (\n",
    "            f\"Missing file: {path}\"\n",
    "        )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.3 HASH VERIFICATION\n",
    "    # ========================================================\n",
    "\n",
    "    observed_result_hash = (\n",
    "        sha256_file(\n",
    "            result_path\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        observed_result_hash\n",
    "        ==\n",
    "        de_record[\n",
    "            \"all_gene_results_sha256\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    observed_effect_hash = (\n",
    "        sha256_file(\n",
    "            effect_path\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        observed_effect_hash\n",
    "        ==\n",
    "        freeze_record[\n",
    "            \"effect_vector_file_sha256\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Result file SHA256: PASS\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Frozen effect SHA256: PASS\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.4 LOAD RESULT + UNIVERSE\n",
    "    # ========================================================\n",
    "\n",
    "    result = pd.read_csv(\n",
    "        result_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    universe = pd.read_csv(\n",
    "        universe_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    frozen_effect = pd.read_csv(\n",
    "        effect_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    expected_n = (\n",
    "        EXPECTED_UNIVERSES[\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        result\n",
    "    ) == expected_n\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        universe\n",
    "    ) == expected_n\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        frozen_effect\n",
    "    ) == expected_n\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.5 EXACT GENE-UNIVERSE IDENTITY\n",
    "    # ========================================================\n",
    "\n",
    "    result_gene_ids = (\n",
    "\n",
    "        result[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    universe_gene_ids = (\n",
    "\n",
    "        universe[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    effect_gene_ids = (\n",
    "\n",
    "        frozen_effect[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        result_gene_ids\n",
    "        ==\n",
    "        universe_gene_ids\n",
    "        ==\n",
    "        effect_gene_ids\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        result_gene_ids\n",
    "    ) == len(\n",
    "        set(\n",
    "            result_gene_ids\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    observed_universe_hash = (\n",
    "        ordered_gene_hash(\n",
    "            result_gene_ids\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        observed_universe_hash\n",
    "        ==\n",
    "        universe_record[\n",
    "            \"ordered_gene_id_sha256\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Exact frozen gene universe: PASS\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.6 EFFECT-VECTOR CONTENT IDENTITY\n",
    "    #\n",
    "    # Confirm the frozen vector really contains the same\n",
    "    # disease estimates as the all-gene DE result.\n",
    "    # ========================================================\n",
    "\n",
    "    assert np.allclose(\n",
    "\n",
    "        result[\n",
    "            \"log2FoldChange\"\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        ),\n",
    "\n",
    "        frozen_effect[\n",
    "            \"PD_vs_Control_log2FC\"\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        ),\n",
    "\n",
    "        equal_nan=True\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert np.allclose(\n",
    "\n",
    "        result[\n",
    "            \"stat\"\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        ),\n",
    "\n",
    "        frozen_effect[\n",
    "            \"PD_vs_Control_Wald\"\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        ),\n",
    "\n",
    "        equal_nan=True\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert np.allclose(\n",
    "\n",
    "        result[\n",
    "            \"pvalue\"\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        ),\n",
    "\n",
    "        frozen_effect[\n",
    "            \"PD_vs_Control_pvalue\"\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        ),\n",
    "\n",
    "        equal_nan=True\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert np.allclose(\n",
    "\n",
    "        result[\n",
    "            \"padj\"\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        ),\n",
    "\n",
    "        frozen_effect[\n",
    "            \"PD_vs_Control_padj\"\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        ),\n",
    "\n",
    "        equal_nan=True\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Frozen effect-vector identity: PASS\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.7 FINITE-VALUE AUDIT\n",    "    # ========================================================\n",
    "\n",
    "    finite_lfc = np.isfinite(\n",
    "\n",
    "        result[\n",
    "            \"log2FoldChange\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    finite_stat = np.isfinite(\n",
    "\n",
    "        result[\n",
    "            \"stat\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    finite_p = np.isfinite(\n",
    "\n",
    "        result[\n",
    "            \"pvalue\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    finite_padj = np.isfinite(\n",
    "\n",
    "        result[\n",
    "            \"padj\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_finite_lfc = int(\n",
    "        finite_lfc.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_finite_stat = int(\n",
    "        finite_stat.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_finite_p = int(\n",
    "        finite_p.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_finite_padj = int(\n",
    "        finite_padj.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.8 FDR RECALCULATION\n",
    "    # ========================================================\n",
    "\n",
    "    sig_mask = (\n",
    "\n",
    "        finite_padj\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            result[\n",
    "                \"padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    sig = (\n",
    "\n",
    "        result.loc[\n",
    "            sig_mask\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_sig = int(\n",
    "        sig_mask.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_up = int(\n",
    "\n",
    "        (\n",
    "            sig[\n",
    "                \"log2FoldChange\"\n",
    "            ]\n",
    "            >\n",
    "            0\n",
    "        ).sum()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_down = int(\n",
    "\n",
    "        (\n",
    "            sig[\n",
    "                \"log2FoldChange\"\n",
    "            ]\n",
    "            <\n",
    "            0\n",
    "        ).sum()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_zero = int(\n",
    "\n",
    "        (\n",
    "            sig[\n",
    "                \"log2FoldChange\"\n",
    "            ]\n",
    "            ==\n",
    "            0\n",
    "        ).sum()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.9 VERIFY LOCK COUNTS\n",
    "    # ========================================================\n",
    "\n",
    "    assert (\n",
    "        n_finite_lfc\n",
    "        ==\n",
    "        de_record[\n",
    "            \"n_finite_log2FoldChange\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_finite_stat\n",
    "        ==\n",
    "        de_record[\n",
    "            \"n_finite_Wald\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_finite_p\n",
    "        ==\n",
    "        de_record[\n",
    "            \"n_finite_pvalue\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_finite_padj\n",
    "        ==\n",
    "        de_record[\n",
    "            \"n_finite_padj\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_sig\n",
    "        ==\n",
    "        de_record[\n",
    "            \"n_FDR_lt_0_05\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_up\n",
    "        ==\n",
    "        de_record[\n",
    "            \"n_FDR_lt_0_05_up_in_PD\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_down\n",
    "        ==\n",
    "        de_record[\n",
    "            \"n_FDR_lt_0_05_down_in_PD\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.10 VERIFY USER-VISIBLE STEP-16 SUMMARY\n",
    "    # ========================================================\n",
    "\n",
    "    summary_row = (\n",
    "\n",
    "        summary[\n",
    "            summary[\n",
    "                \"cell_type\"\n",
    "            ]\n",
    "            ==\n",
    "            cell_type\n",
    "        ]\n",
    "        .iloc[\n",
    "            0\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        summary_row[\n",
    "            \"tested_genes\"\n",
    "        ]\n",
    "    ) == expected_n\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        summary_row[\n",
    "            \"finite_pvalue\"\n",
    "        ]\n",
    "    ) == n_finite_p\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        summary_row[\n",
    "            \"finite_padj\"\n",
    "        ]\n",
    "    ) == n_finite_padj\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        summary_row[\n",
    "            \"FDR_lt_0.05\"\n",
    "        ]\n",
    "    ) == n_sig\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        summary_row[\n",
    "            \"up_in_PD\"\n",
    "        ]\n",
    "    ) == n_up\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        summary_row[\n",
    "            \"down_in_PD\"\n",
    "        ]\n",
    "    ) == n_down\n",
    "\n",
    "\n",
    "    # Hard check against pasted STEP-16 output.\n",
    "    assert n_sig == EXPECTED_FDR[\n",
    "        cell_type\n",
    "    ]\n",
    "\n",
    "\n",
    "    assert n_up == EXPECTED_UP[\n",
    "        cell_type\n",
    "    ]\n",
    "\n",
    "\n",
    "    assert n_down == EXPECTED_DOWN[\n",
    "        cell_type\n",
    "    ]\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"STEP-16 aggregate counts: PASS\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.11 INDEPENDENT-FILTERING SUMMARY\n",
    "    # ========================================================\n",
    "\n",
    "    n_padj_na = int(\n",
    "        expected_n\n",
    "        -\n",
    "        n_finite_padj\n",
    "    )\n",
    "\n",
    "\n",
    "    padj_retained_fraction = float(\n",
    "        n_finite_padj\n",
    "        /\n",
    "        expected_n\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.12 MINIMUM P VALUES\n",
    "    # ========================================================\n",
    "\n",
    "    min_p = float(\n",
    "\n",
    "        result.loc[\n",
    "            finite_p,\n",
    "            \"pvalue\"\n",
    "        ].min()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    min_padj = float(\n",
    "\n",
    "        result.loc[\n",
    "            finite_padj,\n",
    "            \"padj\"\n",
    "        ].min()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.13 FIRST REPLICATION-ONLY BIOLOGICAL REVEAL\n",
    "    #\n",
    "    # This does NOT compare against discovery.\n",
    "    # ========================================================\n",
    "\n",
    "    if n_sig > 0:\n",
    "\n",
    "        reveal = (\n",
    "\n",
    "            result.loc[\n",
    "                sig_mask,\n",
    "                [\n",
    "                    \"gene_id\",\n",
    "                    \"gene_symbol\",\n",
    "                    \"gene_biotype\",\n",
    "                    \"gene_symbol_unique_in_replication\",\n",
    "                    \"baseMean\",\n",
    "                    \"log2FoldChange\",\n",
    "                    \"stat\",\n",
    "                    \"pvalue\",\n",
    "                    \"padj\",\n",
    "                ]\n",
    "            ]\n",
    "            .sort_values(\n",
    "                [\n",
    "                    \"padj\",\n",
    "                    \"pvalue\",\n",
    "                ],\n",
    "                ascending=[\n",
    "                    True,\n",
    "                    True,\n",
    "                ]\n",
    "            )\n",
    "            .head(\n",
    "                15\n",
    "            )\n",
    "            .copy()\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        reveal[\n",
    "            \"status\"\n",
    "        ] = \"FDR<0.05\"\n",
    "\n",
    "\n",
    "    else:\n",
    "\n",
    "        reveal = (\n",
    "\n",
    "            result.loc[\n",
    "                finite_p,\n",
    "                [\n",
    "                    \"gene_id\",\n",
    "                    \"gene_symbol\",\n",
    "                    \"gene_biotype\",\n",
    "                    \"gene_symbol_unique_in_replication\",\n",
    "                    \"baseMean\",\n",
    "                    \"log2FoldChange\",\n",
    "                    \"stat\",\n",
    "                    \"pvalue\",\n",
    "                    \"padj\",\n",
    "                ]\n",
    "            ]\n",
    "            .sort_values(\n",
    "                \"pvalue\"\n",
    "            )\n",
    "            .head(\n",
    "                15\n",
    "            )\n",
    "            .copy()\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        reveal[\n",
    "            \"status\"\n",
    "        ] = \"NOT_FDR_SIGNIFICANT\"\n",
    "\n",
    "\n",
    "    top_tables[\n",
    "        cell_type\n",
    "    ] = reveal\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.14 AUDIT ROW\n",
    "    # ========================================================\n",
    "\n",
    "    audit_rows.append({\n",
    "\n",
    "        \"cell_type\":\n",
    "            cell_type,\n",
    "\n",
    "        \"tested_genes\":\n",
    "            expected_n,\n",
    "\n",
    "        \"finite_LFC\":\n",
    "            n_finite_lfc,\n",
    "\n",
    "        \"finite_Wald\":\n",
    "            n_finite_stat,\n",
    "\n",
    "        \"finite_p\":\n",
    "            n_finite_p,\n",
    "\n",
    "        \"finite_padj\":\n",
    "            n_finite_padj,\n",
    "\n",
    "        \"padj_NA\":\n",
    "            n_padj_na,\n",
    "\n",
    "        \"padj_retained_fraction\":\n",
    "            padj_retained_fraction,\n",
    "\n",
    "        \"FDR_lt_0.05\":\n",
    "            n_sig,\n",
    "\n",
    "        \"up_in_PD\":\n",
    "            n_up,\n",
    "\n",
    "        \"down_in_PD\":\n",
    "            n_down,\n",
    "\n",
    "        \"zero_LFC_FDR\":\n",
    "            n_zero,\n",
    "\n",
    "        \"min_pvalue\":\n",
    "            min_p,\n",
    "\n",
    "        \"min_padj\":\n",
    "            min_padj,\n",
    "\n",
    "        \"result_hash_verified\":\n",
    "            True,\n",
    "\n",
    "        \"effect_freeze_hash_verified\":\n",
    "            True,\n",
    "\n",
    "        \"gene_universe_verified\":\n",
    "            True,\n",
    "\n",
    "        \"effect_vector_identity_verified\":\n",
    "            True,\n",
    "\n",
    "    })\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nResult audit:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Tested genes:\",\n",
    "        f\"{expected_n:,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Finite p:\",\n",
    "        f\"{n_finite_p:,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Finite padj:\",\n",
    "        f\"{n_finite_padj:,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  padj NA from independent filtering:\",\n",
    "        f\"{n_padj_na:,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  FDR <0.05:\",\n",
    "        f\"{n_sig:,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Up:\",\n",
    "        f\"{n_up:,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Down:\",\n",
    "        f\"{n_down:,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Min p:\",\n",
    "        min_p\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Min padj:\",\n",
    "        min_padj\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. COMBINED AUDIT TABLE\n",
    "# ============================================================\n",
    "\n",
    "audit = pd.DataFrame(\n",
    "    audit_rows\n",
    ")\n",
    "\n",
    "\n",
    "audit[\n",
    "    \"cell_type\"\n",
    "] = pd.Categorical(\n",
    "\n",
    "    audit[\n",
    "        \"cell_type\"\n",
    "    ],\n",
    "\n",
    "    categories=\n",
    "        PRIMARY_CLASSES,\n",
    "\n",
    "    ordered=True\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "audit = (\n",
    "\n",
    "    audit\n",
    "    .sort_values(\n",
    "        \"cell_type\"\n",
    "    )\n",
    "    .reset_index(\n",
    "        drop=True\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "audit[\n",
    "    \"cell_type\"\n",
    "] = (\n",
    "\n",
    "    audit[\n",
    "        \"cell_type\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "audit.to_csv(\n",
    "    audit_output_path,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. DISPLAY AUDIT\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PRIMARY REPLICATION DE AUDIT\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    audit\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. FIRST REPLICATION-ONLY BIOLOGICAL REVEAL\n",
    "#\n",
    "# Still NO discovery comparison.\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"REPLICATION-ONLY TOP RESULTS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "for cell_type in PRIMARY_CLASSES:\n",
    "\n",
    "    print(\n",
    "        \"\\n\"\n",
    "        +\n",
    "        \"-\" * 80\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        cell_type\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"-\" * 80\n",
    "    )\n",
    "\n",
    "\n",
    "    display(\n",
    "        top_tables[\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. DESCRIPTIVE FDR OVERLAP ACROSS REPLICATION CLASSES\n",
    "#\n",
    "# NOT the cross-dataset replication test.\n",
    "# ============================================================\n",
    "\n",
    "sig_sets = {}\n",
    "\n",
    "\n",
    "for cell_type in PRIMARY_CLASSES:\n",
    "\n",
    "    result_path = Path(\n",
    "\n",
    "        de_run_lock[\n",
    "            \"cell_class_results\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ][\n",
    "            \"all_gene_results\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    result = pd.read_csv(\n",
    "        result_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    mask = (\n",
    "\n",
    "        np.isfinite(\n",
    "            result[\n",
    "                \"padj\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            result[\n",
    "                \"padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # Only unique symbol mappings for descriptive overlap.\n",
    "    result_sig = (\n",
    "\n",
    "        result.loc[\n",
    "            mask\n",
    "            &\n",
    "            result[\n",
    "                \"gene_symbol_unique_in_replication\"\n",
    "            ].astype(bool)\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    sig_sets[\n",
    "        cell_type\n",
    "    ] = set(\n",
    "\n",
    "        result_sig[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "shared_all_four = (\n",
    "\n",
    "    sig_sets[\n",
    "        \"Astro\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    sig_sets[\n",
    "        \"Micro\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    sig_sets[\n",
    "        \"OPC\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    sig_sets[\n",
    "        \"Oligo\"\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nReplication FDR genes shared \"\n",
    "    \"across all four classes:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    len(\n",
    "        shared_all_four\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "if len(\n",
    "    shared_all_four\n",
    ") <= 50:\n",
    "\n",
    "    print(\n",
    "        sorted(\n",
    "            shared_all_four\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. SAVE AUDIT LOCK\n",
    "# ============================================================\n",
    "\n",
    "AUDIT_LOCK = {\n",
    "\n",
    "    \"dataset\":\n",
    "        \"GSE157783\",\n",
    "\n",
    "    \"created_utc\":\n",
    "        datetime.now(\n",
    "            timezone.utc\n",
    "        ).isoformat(),\n",
    "\n",
    "    \"status\":\n",
    "        \"PRIMARY_REPLICATION_DE_AUDIT_COMPLETE\",\n",
    "\n",
    "    \"cell_classes\":\n",
    "        PRIMARY_CLASSES,\n",
    "\n",
    "    \"all_result_hashes_verified\":\n",
    "        True,\n",
    "\n",
    "    \"all_effect_freeze_hashes_verified\":\n",
    "        True,\n",
    "\n",
    "    \"all_gene_universes_verified\":\n",
    "        True,\n",
    "\n",
    "    \"all_frozen_effect_vectors_match_source_DE\":\n",
    "        True,\n",
    "\n",
    "    \"DE_rerun\":\n",
    "        False,\n",
    "\n",
    "    \"PMI_sensitivity_performed\":\n",
    "        False,\n",
    "\n",
    "    \"discovery_dataset_loaded\":\n",
    "        False,\n",
    "\n",
    "    \"discovery_replication_comparison_performed\":\n",
    "        False,\n",
    "\n",
    "    \"audit_table\":\n",
    "        str(\n",
    "            audit_output_path\n",
    "        ),\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    audit_lock_path,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        AUDIT_LOCK,\n",
    "        f,\n",
    "        indent=2\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 12. FINAL\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 16A PASSED — REPLICATION DE VERIFIED\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nAudit table:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    audit_output_path\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nAudit lock:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    audit_lock_path\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nNO NEW DE WAS RUN.\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"GSE243639 WAS NOT LOADED.\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"DISCOVERY/REPLICATION COMPARISON: NO\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nNEXT:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 17 — frozen PMI-adjusted replication sensitivity, \"\n",
    "    \"then freeze sensitivity support before the first \"\n",
    "    \"GSE243639 ↔ GSE157783 comparison.\"\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 32\n",
    "# ============================================================\n",
    "# STEP 17 — GSE157783 PMI-ADJUSTED REPLICATION SENSITIVITY\n",
    "#           + SENSITIVITY SUPPORT FREEZE\n",
    "#\n",
    "# NO DISCOVERY DATA ARE LOADED.\n",
    "# NO GSE243639 ↔ GSE157783 COMPARISON.\n",
    "#\n",
    "# PRIMARY REPLICATION MODEL ALREADY FROZEN:\n",
    "#   ~ age + sex + diagnosis_binary\n",
    "#\n",
    "# TECHNICAL SENSITIVITY MODEL:\n",
    "#   ~ age + sex + PMI + diagnosis_binary\n",
    "#\n",
    "# CONTRAST:\n",
    "#   PD vs Control\n",
    "#\n",
    "# PURPOSE\n",
    "# -------\n",
    "# 1. Reuse EXACT STEP-15 frozen gene universes.\n",
    "# 2. Reuse EXACT same 11 donors.\n",
    "# 3. Run the predeclared PMI-adjusted sensitivity.\n",
    "# 4. Save ALL tested genes.\n",
    "# 5. Compare PRIMARY replication effects vs PMI sensitivity.\n",
    "# 6. Freeze sensitivity-support annotations.\n",
    "#\n",
    "# IMPORTANT\n",
    "# ---------\n",
    "# - NO refiltering.\n",
    "# - NO donor exclusion.\n",
    "# - NO age-overlap sensitivity.\n",
    "# - NO discovery dataset loaded.\n",
    "# - NO cross-dataset replication conclusion yet.\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "import sys\n",
    "import subprocess\n",
    "from pathlib import Path\n",
    "import textwrap\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. ENVIRONMENT\n",
    "# ============================================================\n",
    "\n",
    "TARGET_PANDAS = \"2.3.3\"\n",
    "TARGET_PYDESEQ2 = \"0.5.4\"\n",
    "\n",
    "\n",
    "print(\"=\" * 80)\n",
    "print(\"STEP 17 ENVIRONMENT PREPARATION\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "\n",
    "subprocess.check_call(\n",
    "    [\n",
    "        sys.executable,\n",
    "        \"-m\",\n",
    "        \"pip\",\n",
    "        \"install\",\n",
    "        \"-q\",\n",
    "        \"--upgrade\",\n",
    "        f\"pandas=={TARGET_PANDAS}\",\n",
    "        f\"pydeseq2=={TARGET_PYDESEQ2}\",\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. WRITE FRESH RUNNER\n",
    "# ============================================================\n",
    "\n",
    "runner_path = Path(\n",
    "    \"/content/RETINA_ND_STEP17_GSE157783_PMI_SENSITIVITY.py\"\n",
    ")\n",
    "\n",
    "\n",
    "RUNNER = r'''\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "import platform\n",
    "import hashlib\n",
    "import json\n",
    "import gc\n",
    "import io\n",
    "import contextlib\n",
    "import importlib.metadata\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",    "\n",
    "from packaging.version import Version\n",
    "from scipy.stats import pearsonr, spearmanr\n",
    "\n",
    "from pydeseq2.dds import DeseqDataSet\n",
    "from pydeseq2.ds import DeseqStats\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# A. ENVIRONMENT\n",
    "# ============================================================\n",
    "\n",
    "REQUIRED_PYDESEQ2 = \"0.5.4\"\n",
    "MINIMUM_PANDAS = Version(\"2.3.0\")\n",
    "\n",
    "\n",
    "def package_version(name):\n",
    "\n",
    "    try:\n",
    "        return importlib.metadata.version(name)\n",
    "\n",
    "    except importlib.metadata.PackageNotFoundError:\n",
    "        return None\n",
    "\n",
    "\n",
    "PYDESEQ2_VERSION = package_version(\"pydeseq2\")\n",
    "PANDAS_VERSION = package_version(\"pandas\")\n",
    "ANNDATA_VERSION = package_version(\"anndata\")\n",
    "\n",
    "\n",
    "assert PYDESEQ2_VERSION == REQUIRED_PYDESEQ2\n",
    "\n",
    "assert Version(PANDAS_VERSION) >= MINIMUM_PANDAS\n",
    "\n",
    "\n",
    "# Previous compatibility failure guard\n",
    "_ = pd.StringDtype(\n",
    "    na_value=pd.NA\n",
    ")\n",
    "\n",
    "\n",
    "print(\"=\" * 80)\n",
    "print(\"STEP 17 FRESH SUBPROCESS ENVIRONMENT\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "print(\"Python:\", platform.python_version())\n",
    "print(\"PyDESeq2:\", PYDESEQ2_VERSION)\n",
    "print(\"AnnData:\", ANNDATA_VERSION)\n",
    "print(\"Pandas:\", PANDAS_VERSION)\n",
    "print(\"NumPy:\", np.__version__)\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# B. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = ROOT / \"locks\"\n",
    "\n",
    "SENS_ROOT = (\n",
    "    ROOT /\n",
    "    \"PD_replication_sensitivity\"\n",
    ")\n",
    "\n",
    "SENS_ROOT.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True\n",
    ")\n",
    "\n",
    "\n",
    "pre_de_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE157783_REPLICATION_PRE_DE_LOCK_v1.json\"\n",
    ")\n",
    "\n",
    "primary_de_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE157783_PRIMARY_PD_REPLICATION_DE_RUN_v1.json\"\n",
    ")\n",
    "\n",
    "primary_audit_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE157783_PRIMARY_PD_REPLICATION_DE_AUDIT_v1.json\"\n",
    ")\n",
    "\n",
    "primary_effect_freeze_path = (\n",
    "    LOCKS /\n",
    "    \"GSE157783_PD_REPLICATION_EFFECT_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "sensitivity_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE157783_PD_REPLICATION_PMI_SENSITIVITY_v1.json\"\n",
    ")\n",
    "\n",
    "sensitivity_support_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE157783_PD_REPLICATION_SENSITIVITY_SUPPORT_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "summary_path = (\n",
    "    SENS_ROOT /\n",
    "    \"GSE157783_PD_REPLICATION_PMI_SENSITIVITY_SUMMARY_v1.csv\"\n",
    ")\n",
    "\n",
    "concordance_path = (\n",
    "    SENS_ROOT /\n",
    "    \"GSE157783_PD_REPLICATION_PMI_CONCORDANCE_v1.csv\"\n",
    ")\n",
    "\n",
    "combined_comparison_path = (\n",
    "    SENS_ROOT /\n",
    "    \"GSE157783_PRIMARY_vs_PMI_ALL_CLASSES_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "\n",
    "    pre_de_lock_path,\n",
    "    primary_de_lock_path,\n",
    "    primary_audit_lock_path,\n",
    "    primary_effect_freeze_path,\n",
    "\n",
    "]:\n",
    "\n",
    "    assert path.exists(), (\n",
    "        f\"Missing required lock: {path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# C. LOAD / VERIFY LOCKS\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    pre_de_lock_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    pre_de_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    primary_de_lock_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    primary_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    primary_audit_lock_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    audit_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    primary_effect_freeze_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    effect_freeze = json.load(f)\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre_de_lock[\"status\"]\n",
    "    ==\n",
    "    \"REPLICATION_PRE_DE_LOCK\"\n",
    ")\n",
    "\n",
    "assert (\n",
    "    primary_lock[\"status\"]\n",
    "    ==\n",
    "    \"PRIMARY_REPLICATION_DE_COMPLETE\"\n",
    ")\n",
    "\n",
    "assert (\n",
    "    audit_lock[\"status\"]\n",
    "    ==\n",
    "    \"PRIMARY_REPLICATION_DE_AUDIT_COMPLETE\"\n",
    ")\n",
    "\n",
    "assert (\n",
    "    effect_freeze[\"status\"]\n",
    "    ==\n",
    "    \"PD_REPLICATION_EFFECTS_FROZEN\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    primary_lock[\n",
    "        \"technical_PMI_sensitivity_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "assert (\n",
    "    primary_lock[\n",
    "        \"discovery_replication_effect_comparison_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "assert (\n",
    "    audit_lock[\n",
    "        \"discovery_dataset_loaded\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "assert (\n",
    "    pre_de_lock[\n",
    "        \"design_audit\"\n",
    "    ][\n",
    "        \"technical_rank\"\n",
    "    ]\n",
    "    ==\n",
    "    5\n",
    ")\n",
    "\n",
    "assert (\n",
    "    pre_de_lock[\n",
    "        \"design_audit\"\n",
    "    ][\n",
    "        \"technical_columns\"\n",
    "    ]\n",
    "    ==\n",
    "    5\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFrozen primary replication outputs verified.\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Discovery dataset loaded: NO\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# D. CELL CLASSES\n",
    "# ============================================================\n",
    "\n",
    "PRIMARY_CLASSES = [\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "]\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# E. HELPERS\n",
    "# ============================================================\n",
    "\n",
    "def sha256_file(\n",
    "    path,\n",
    "    block_size=1024 * 1024\n",
    "):\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\"\n",
    "    ) as f:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            block = f.read(\n",
    "                block_size\n",
    "            )\n",
    "\n",
    "            if not block:\n",
    "                break\n",
    "\n",
    "            h.update(\n",
    "                block\n",
    "            )\n",
    "\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "def safe_pearson(\n",
    "    x,\n",
    "    y\n",
    "):\n",
    "\n",
    "    x = np.asarray(\n",
    "        x,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "    y = np.asarray(\n",
    "        y,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "    mask = (\n",
    "        np.isfinite(x)\n",
    "        &\n",
    "        np.isfinite(y)\n",
    "    )\n",
    "\n",
    "    if mask.sum() < 3:\n",
    "        return np.nan\n",
    "\n",
    "    return float(\n",
    "        pearsonr(\n",
    "            x[mask],\n",
    "            y[mask]\n",
    "        ).statistic\n",
    "    )\n",
    "\n",
    "\n",
    "def safe_spearman(\n",
    "    x,\n",
    "    y\n",
    "):\n",
    "\n",
    "    x = np.asarray(\n",
    "        x,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "    y = np.asarray(\n",
    "        y,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "    mask = (\n",
    "        np.isfinite(x)\n",
    "        &\n",
    "        np.isfinite(y)\n",
    "    )\n",
    "\n",
    "    if mask.sum() < 3:\n",
    "        return np.nan\n",
    "\n",
    "    return float(\n",
    "        spearmanr(\n",
    "            x[mask],\n",
    "            y[mask]\n",
    "        ).statistic\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# F. STORAGE\n",
    "# ============================================================\n",
    "\n",
    "summary_rows = []\n",
    "concordance_rows = []\n",
    "\n",
    "run_records = {}\n",
    "\n",
    "comparison_tables = []\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# G. FOUR CELL CLASSES\n",
    "# ============================================================\n",
    "\n",
    "for class_number, cell_type in enumerate(\n",
    "    PRIMARY_CLASSES,\n",
    "    start=1\n",
    "):\n",
    "\n",
    "    print(\n",
    "        \"\\n\"\n",
    "        +\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"[{class_number}/4] \"\n",
    "        f\"{cell_type} — PMI SENSITIVITY\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G1. FROZEN INPUTS\n",
    "    # ========================================================\n",
    "\n",
    "    universe_record = (\n",
    "        pre_de_lock[\n",
    "            \"cell_class_gene_universes\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    counts_path = Path(\n",
    "        universe_record[\n",
    "            \"raw_counts_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    metadata_path = Path(\n",
    "        universe_record[\n",
    "            \"donor_metadata_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    universe_path = Path(\n",
    "        universe_record[\n",
    "            \"gene_universe_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    primary_result_path = Path(\n",
    "        primary_lock[\n",
    "            \"cell_class_results\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ][\n",
    "            \"all_gene_results\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    for path in [\n",
    "\n",
    "        counts_path,\n",
    "        metadata_path,\n",
    "        universe_path,\n",
    "        primary_result_path,\n",
    "\n",
    "    ]:\n",
    "\n",
    "        assert path.exists(), (\n",
    "            f\"Missing file: {path}\"\n",
    "        )\n",
    "\n",
    "\n",
    "    # Verify primary result was not changed.\n",
    "    assert (\n",
    "        sha256_file(\n",
    "            primary_result_path\n",
    "        )\n",
    "        ==\n",
    "        primary_lock[\n",
    "            \"cell_class_results\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ][\n",
    "            \"all_gene_results_sha256\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G2. FROZEN UNIVERSE\n",
    "    # ========================================================\n",
    "\n",
    "    universe = pd.read_csv(\n",
    "        universe_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    gene_ids = (\n",
    "        universe[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_genes = len(\n",
    "        gene_ids\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        universe[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .is_unique\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Frozen genes:\",\n",
    "        f\"{n_genes:,}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G3. RAW COUNTS\n",
    "    # ========================================================\n",
    "\n",
    "    raw = pd.read_csv(\n",
    "        counts_path,\n",
    "        compression=\"gzip\",\n",
    "        index_col=0\n",
    "    )\n",
    "\n",
    "\n",
    "    raw.index = pd.Index(\n",
    "        raw.index\n",
    "        .astype(str)\n",
    "        .tolist(),\n",
    "        dtype=\"object\"\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        raw.index.tolist()\n",
    "        ==\n",
    "        gene_ids\n",
    "    )\n",
    "\n",
    "\n",
    "    assert raw.shape == (\n",
    "        n_genes,\n",
    "        11\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G4. DONOR METADATA\n",
    "    # ========================================================\n",
    "\n",
    "    metadata = pd.read_csv(\n",
    "        metadata_path\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        metadata\n",
    "    ) == 11\n",
    "\n",
    "\n",
    "    assert (\n",
    "        metadata[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        .value_counts()\n",
    "        .to_dict()\n",
    "        ==\n",
    "        {\n",
    "            \"Control\": 6,\n",
    "            \"PD\": 5,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        metadata[\n",
    "            [\n",
    "                \"age\",\n",
    "                \"sex\",\n",
    "                \"PMI\",\n",
    "                \"diagnosis_binary\",\n",
    "            ]\n",
    "        ]\n",
    "        .notna()\n",
    "        .all()\n",
    "        .all()\n",
    "    )\n",
    "\n",
    "\n",
    "    sample_order = (\n",
    "        metadata[\n",
    "            \"pseudobulk_group\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        raw.columns\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "        ==\n",
    "        sample_order\n",
    "    )\n",
    "\n",
    "\n",
    "    counts = (\n",
    "        raw.T\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    counts.index = pd.Index(\n",
    "        counts.index\n",
    "        .astype(str)\n",
    "        .tolist(),\n",
    "        dtype=\"object\"\n",
    "    )\n",
    "\n",
    "\n",
    "    counts.columns = pd.Index(\n",
    "        counts.columns\n",
    "        .astype(str)\n",
    "        .tolist(),\n",
    "        dtype=\"object\"\n",
    "    )\n",
    "\n",
    "\n",
    "    counts = counts.astype(\n",
    "        np.int64\n",
    "    )\n",
    "\n",
    "\n",
    "    assert counts.shape == (\n",
    "        11,\n",
    "        n_genes\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G5. TECHNICAL-SENSITIVITY METADATA\n",
    "    # ========================================================\n",
    "\n",
    "    de_meta = (\n",
    "        metadata[\n",
    "            [\n",
    "                \"pseudobulk_group\",\n",
    "                \"sample_id\",\n",
    "                \"age\",\n",
    "                \"sex\",\n",
    "                \"PMI\",\n",
    "                \"diagnosis_binary\",\n",
    "            ]\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta.index = pd.Index(\n",
    "        de_meta[\n",
    "            \"pseudobulk_group\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist(),\n",
    "        dtype=\"object\"\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta = de_meta.drop(\n",
    "        columns=[\n",
    "            \"pseudobulk_group\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta[\n",
    "        \"sample_id\"\n",
    "    ] = (\n",
    "        de_meta[\n",
    "            \"sample_id\"\n",
    "        ]\n",
    "        .astype(\n",
    "            \"object\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta[\n",
    "        \"age\"\n",
    "    ] = pd.to_numeric(\n",
    "        de_meta[\n",
    "            \"age\"\n",
    "        ],\n",
    "        errors=\"raise\"\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta[\n",
    "        \"PMI\"\n",
    "    ] = pd.to_numeric(\n",
    "        de_meta[\n",
    "            \"PMI\"\n",
    "        ],\n",
    "        errors=\"raise\"\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta[\n",
    "        \"sex\"\n",
    "    ] = pd.Categorical(\n",
    "        de_meta[\n",
    "            \"sex\"\n",
    "        ].astype(str),\n",
    "        categories=[\n",
    "            \"Female\",\n",
    "            \"Male\",\n",
    "        ],\n",
    "        ordered=False\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta[\n",
    "        \"diagnosis_binary\"\n",
    "    ] = pd.Categorical(\n",
    "        de_meta[\n",
    "            \"diagnosis_binary\"\n",
    "        ].astype(str),\n",
    "        categories=[\n",
    "            \"Control\",\n",
    "            \"PD\",\n",
    "        ],\n",
    "        ordered=False\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        counts.index.equals(\n",
    "            de_meta.index\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G6. CONSTRUCT TECHNICAL MODEL\n",
    "    # ========================================================\n",
    "\n",
    "    dds = DeseqDataSet(\n",
    "\n",
    "        counts=counts,\n",
    "\n",
    "        metadata=de_meta,\n",
    "\n",
    "        design=(\n",
    "            \"~ age + sex + PMI + \"\n",
    "            \"diagnosis_binary\"\n",
    "        ),\n",
    "\n",
    "        refit_cooks=True,\n",
    "\n",
    "        n_cpus=2,\n",
    "\n",
    "        quiet=False,\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    design_matrix = (\n",
    "        dds.obsm[\n",
    "            \"design_matrix\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    design_rank = int(\n",
    "        np.linalg.matrix_rank(\n",
    "            design_matrix.to_numpy()\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    design_columns = int(\n",
    "        design_matrix.shape[\n",
    "            1\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Design columns:\",\n",
    "        design_matrix.columns.tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Design rank:\",\n",
    "        design_rank,\n",
    "        \"/\",\n",
    "        design_columns\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        design_rank\n",
    "        ==\n",
    "        design_columns\n",
    "        ==\n",
    "        5\n",
    "    )\n",
    "\n",
    "\n",
    "    diagnosis_columns = [\n",
    "\n",
    "        str(column)\n",
    "\n",
    "        for column\n",
    "        in design_matrix.columns\n",
    "\n",
    "        if (\n",
    "            \"diagnosis_binary\"\n",
    "            in\n",
    "            str(column)\n",
    "        )\n",
    "\n",
    "    ]\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        diagnosis_columns\n",
    "    ) == 1\n",
    "\n",
    "\n",
    "    assert (\n",
    "        \"PD\"\n",
    "        in\n",
    "        diagnosis_columns[\n",
    "            0\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G7. OUTPUT DIRECTORY\n",
    "    # ========================================================\n",
    "\n",
    "    class_dir = (\n",
    "        SENS_ROOT /\n",
    "        cell_type\n",
    "    )\n",
    "\n",
    "\n",
    "    class_dir.mkdir(\n",
    "        parents=True,\n",
    "        exist_ok=True\n",
    "    )\n",
    "\n",
    "\n",
    "    design_path = (\n",
    "        class_dir /\n",
    "        (\n",
    "            f\"GSE157783_{cell_type}_\"\n",
    "            f\"PMI_SENSITIVITY_DESIGN_MATRIX_v1.csv\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    design_matrix.to_csv(\n",
    "        design_path\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G8. FIT DESEQ2\n",
    "    # ========================================================\n",
    "\n",
    "    print(\n",
    "        \"\\nRunning PMI-adjusted DESeq2 fit...\"\n",
    "    )\n",
    "\n",
    "\n",
    "    dds.deseq2()\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"PMI-adjusted DESeq2 fit complete.\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G9. STATISTICS\n",
    "    # ========================================================\n",
    "\n",
    "    stats = DeseqStats(\n",
    "\n",
    "        dds,\n",
    "\n",
    "        contrast=[\n",
    "            \"diagnosis_binary\",\n",
    "            \"PD\",\n",
    "            \"Control\",\n",
    "        ],\n",
    "\n",
    "        alpha=0.05,\n",
    "\n",
    "        cooks_filter=True,\n",
    "\n",
    "        independent_filter=True,\n",
    "\n",
    "        n_cpus=2,\n",
    "\n",
    "        quiet=False,\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    buffer = io.StringIO()\n",
    "\n",
    "\n",
    "    with contextlib.redirect_stdout(\n",
    "        buffer\n",
    "    ):\n",
    "\n",
    "        stats.summary()\n",
    "\n",
    "\n",
    "    result = (\n",
    "        stats.results_df\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G10. RESULT INTEGRITY\n",
    "    # ========================================================\n",
    "\n",
    "    result.index = pd.Index(\n",
    "        result.index\n",
    "        .astype(str)\n",
    "        .tolist(),\n",
    "        dtype=\"object\"\n",
    "    )\n",
    "\n",
    "\n",
    "    assert result.index.is_unique\n",
    "\n",
    "\n",
    "    assert (\n",
    "        set(\n",
    "            result.index\n",
    "        )\n",
    "        ==\n",
    "        set(\n",
    "            gene_ids\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    result = (\n",
    "        result.loc[\n",
    "            gene_ids\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        result.index.tolist()\n",
    "        ==\n",
    "        gene_ids\n",
    "    )\n",
    "\n",
    "\n",
    "    result.index.name = (\n",
    "        \"gene_id\"\n",
    "    )\n",
    "\n",
    "\n",
    "    result = (\n",
    "        result[\n",
    "            [\n",
    "                \"baseMean\",\n",
    "                \"log2FoldChange\",\n",
    "                \"lfcSE\",\n",
    "                \"stat\",\n",
    "                \"pvalue\",\n",
    "                \"padj\",\n",
    "            ]\n",
    "        ]\n",
    "        .reset_index()\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G11. ADD FROZEN ANNOTATION\n",
    "    # ========================================================\n",
    "\n",
    "    annotation = (\n",
    "        universe[\n",
    "            [\n",
    "                \"gene_id\",\n",
    "                \"gene_symbol\",\n",
    "                \"gene_biotype\",\n",
    "                \"gene_symbol_unique_in_replication\",\n",
    "            ]\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",    "\n",
    "\n",
    "    result = result.merge(\n",
    "        annotation,\n",
    "        on=\"gene_id\",\n",
    "        how=\"left\",\n",
    "        validate=\"one_to_one\"\n",
    "    )\n",
    "\n",
    "\n",
    "    result = result[\n",
    "        [\n",
    "            \"gene_id\",\n",
    "            \"gene_symbol\",\n",
    "            \"gene_biotype\",\n",
    "            \"gene_symbol_unique_in_replication\",\n",
    "\n",
    "            \"baseMean\",\n",
    "            \"log2FoldChange\",\n",
    "            \"lfcSE\",\n",
    "            \"stat\",\n",
    "            \"pvalue\",\n",
    "            \"padj\",\n",
    "        ]\n",
    "    ]\n",
    "\n",
    "\n",
    "    result[\n",
    "        \"rank_stat\"\n",
    "    ] = result[\n",
    "        \"stat\"\n",
    "    ]\n",
    "\n",
    "\n",
    "    result[\n",
    "        \"cell_type\"\n",
    "    ] = cell_type\n",
    "\n",
    "\n",
    "    result[\n",
    "        \"contrast\"\n",
    "    ] = \"PD_vs_Control\"\n",
    "\n",
    "\n",
    "    result[\n",
    "        \"model\"\n",
    "    ] = (\n",
    "        \"age+sex+PMI+diagnosis\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G12. SAVE ALL TESTED GENES\n",
    "    # ========================================================\n",
    "\n",
    "    result_path = (\n",
    "        class_dir /\n",
    "        (\n",
    "            f\"GSE157783_{cell_type}_\"\n",
    "            f\"PD_vs_Control_\"\n",
    "            f\"PMI_SENSITIVITY_ALL_GENES_v1.csv.gz\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    result.to_csv(\n",
    "        result_path,\n",
    "        index=False,\n",
    "        compression={\n",
    "            \"method\":\n",
    "                \"gzip\",\n",
    "\n",
    "            \"compresslevel\":\n",
    "                6,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    result_hash = (\n",
    "        sha256_file(\n",
    "            result_path\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G13. LOAD PRIMARY REPLICATION RESULT\n",
    "    # ========================================================\n",
    "\n",
    "    primary = pd.read_csv(\n",
    "        primary_result_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        primary[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "        ==\n",
    "        gene_ids\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G14. MERGE PRIMARY + PMI SENSITIVITY\n",
    "    # ========================================================\n",
    "\n",
    "    comparison = (\n",
    "\n",
    "        primary[\n",
    "            [\n",
    "                \"gene_id\",\n",
    "                \"gene_symbol\",\n",
    "                \"gene_symbol_unique_in_replication\",\n",
    "\n",
    "                \"log2FoldChange\",\n",
    "                \"stat\",\n",
    "                \"pvalue\",\n",
    "                \"padj\",\n",
    "            ]\n",
    "        ]\n",
    "        .rename(\n",
    "            columns={\n",
    "\n",
    "                \"log2FoldChange\":\n",
    "                    \"primary_LFC\",\n",
    "\n",
    "                \"stat\":\n",
    "                    \"primary_Wald\",\n",
    "\n",
    "                \"pvalue\":\n",
    "                    \"primary_p\",\n",
    "\n",
    "                \"padj\":\n",
    "                    \"primary_padj\",\n",
    "\n",
    "            }\n",
    "        )\n",
    "        .merge(\n",
    "\n",
    "            result[\n",
    "                [\n",
    "                    \"gene_id\",\n",
    "                    \"log2FoldChange\",\n",
    "                    \"stat\",\n",
    "                    \"pvalue\",\n",
    "                    \"padj\",\n",
    "                ]\n",
    "            ]\n",
    "            .rename(\n",
    "                columns={\n",
    "\n",
    "                    \"log2FoldChange\":\n",
    "                        \"PMI_LFC\",\n",
    "\n",
    "                    \"stat\":\n",
    "                        \"PMI_Wald\",\n",
    "\n",
    "                    \"pvalue\":\n",
    "                        \"PMI_p\",\n",
    "\n",
    "                    \"padj\":\n",
    "                        \"PMI_padj\",\n",
    "\n",
    "                }\n",
    "            ),\n",
    "\n",
    "            on=\"gene_id\",\n",
    "\n",
    "            how=\"inner\",\n",
    "\n",
    "            validate=\"one_to_one\"\n",
    "\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        comparison\n",
    "    ) == n_genes\n",
    "\n",
    "\n",
    "    comparison.insert(\n",
    "        0,\n",
    "        \"cell_type\",\n",
    "        cell_type\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G15. ALL-GENE CONCORDANCE\n",
    "    # ========================================================\n",
    "\n",
    "    lfc_pearson = safe_pearson(\n",
    "        comparison[\n",
    "            \"primary_LFC\"\n",
    "        ],\n",
    "        comparison[\n",
    "            \"PMI_LFC\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    lfc_spearman = safe_spearman(\n",
    "        comparison[\n",
    "            \"primary_LFC\"\n",
    "        ],\n",
    "        comparison[\n",
    "            \"PMI_LFC\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    wald_spearman = safe_spearman(\n",
    "        comparison[\n",
    "            \"primary_Wald\"\n",
    "        ],\n",
    "        comparison[\n",
    "            \"PMI_Wald\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    direction_mask = (\n",
    "\n",
    "        np.isfinite(\n",
    "            comparison[\n",
    "                \"primary_LFC\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        np.isfinite(\n",
    "            comparison[\n",
    "                \"PMI_LFC\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            comparison[\n",
    "                \"primary_LFC\"\n",
    "            ]\n",
    "            !=\n",
    "            0\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            comparison[\n",
    "                \"PMI_LFC\"\n",
    "            ]\n",
    "            !=\n",
    "            0\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    direction_concordance = float(\n",
    "\n",
    "        (\n",
    "            np.sign(\n",
    "                comparison.loc[\n",
    "                    direction_mask,\n",
    "                    \"primary_LFC\"\n",
    "                ]\n",
    "            )\n",
    "\n",
    "            ==\n",
    "\n",
    "            np.sign(\n",
    "                comparison.loc[\n",
    "                    direction_mask,\n",
    "                    \"PMI_LFC\"\n",
    "                ]\n",
    "            )\n",
    "        ).mean()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G16. PRIMARY REPLICATION FDR HIT ROBUSTNESS\n",
    "    # ========================================================\n",
    "\n",
    "    primary_sig_mask = (\n",
    "\n",
    "        np.isfinite(\n",
    "            comparison[\n",
    "                \"primary_padj\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            comparison[\n",
    "                \"primary_padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    primary_hits = (\n",
    "        comparison.loc[\n",
    "            primary_sig_mask\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_primary_sig = int(\n",
    "        len(\n",
    "            primary_hits\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    primary_hits[\n",
    "        \"PMI_same_direction\"\n",
    "    ] = (\n",
    "\n",
    "        np.sign(\n",
    "            primary_hits[\n",
    "                \"primary_LFC\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        ==\n",
    "\n",
    "        np.sign(\n",
    "            primary_hits[\n",
    "                \"PMI_LFC\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    primary_hits[\n",
    "        \"PMI_nominal_p_lt_0_05\"\n",
    "    ] = (\n",
    "\n",
    "        np.isfinite(\n",
    "            primary_hits[\n",
    "                \"PMI_p\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            primary_hits[\n",
    "                \"PMI_p\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    primary_hits[\n",
    "        \"PMI_FDR_lt_0_05\"\n",
    "    ] = (\n",
    "\n",
    "        np.isfinite(\n",
    "            primary_hits[\n",
    "                \"PMI_padj\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            primary_hits[\n",
    "                \"PMI_padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    primary_hits[\n",
    "        \"PMI_supported\"\n",
    "    ] = (\n",
    "\n",
    "        primary_hits[\n",
    "            \"PMI_same_direction\"\n",
    "        ]\n",
    "\n",
    "        &\n",
    "\n",
    "        primary_hits[\n",
    "            \"PMI_nominal_p_lt_0_05\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_same_direction = int(\n",
    "        primary_hits[\n",
    "            \"PMI_same_direction\"\n",
    "        ].sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_nominal = int(\n",
    "        primary_hits[\n",
    "            \"PMI_nominal_p_lt_0_05\"\n",
    "        ].sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_still_fdr = int(\n",
    "        primary_hits[\n",
    "            \"PMI_FDR_lt_0_05\"\n",
    "        ].sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_supported = int(\n",
    "        primary_hits[\n",
    "            \"PMI_supported\"\n",
    "        ].sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G17. TECHNICAL MODEL FDR COUNTS\n",
    "    # ========================================================\n",
    "\n",
    "    technical_sig = (\n",
    "\n",
    "        np.isfinite(\n",
    "            result[\n",
    "                \"padj\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            result[\n",
    "                \"padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_technical_sig = int(\n",
    "        technical_sig.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    technical_up = int(\n",
    "\n",
    "        (\n",
    "            result.loc[\n",
    "                technical_sig,\n",
    "                \"log2FoldChange\"\n",
    "            ]\n",
    "            >\n",
    "            0\n",
    "        ).sum()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    technical_down = int(\n",
    "\n",
    "        (\n",
    "            result.loc[\n",
    "                technical_sig,\n",
    "                \"log2FoldChange\"\n",
    "            ]\n",
    "            <\n",
    "            0\n",
    "        ).sum()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G18. SAVE COMPARISON TABLE\n",
    "    # ========================================================\n",
    "\n",
    "    comparison_path = (\n",
    "        class_dir /\n",
    "        (\n",
    "            f\"GSE157783_{cell_type}_\"\n",
    "            f\"PRIMARY_vs_PMI_v1.csv.gz\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    comparison.to_csv(\n",
    "        comparison_path,\n",
    "        index=False,\n",
    "        compression={\n",
    "            \"method\":\n",
    "                \"gzip\",\n",
    "\n",
    "            \"compresslevel\":\n",
    "                6,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    comparison_tables.append(\n",
    "        comparison\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G19. SAVE PRIMARY-HIT SUPPORT TABLE\n",
    "    # ========================================================\n",
    "\n",
    "    primary_hit_support_path = (\n",
    "        class_dir /\n",
    "        (\n",
    "            f\"GSE157783_{cell_type}_\"\n",
    "            f\"PRIMARY_FDR_PMI_SUPPORT_v1.csv.gz\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    primary_hits.to_csv(\n",
    "        primary_hit_support_path,\n",
    "        index=False,\n",
    "        compression={\n",
    "            \"method\":\n",
    "                \"gzip\",\n",
    "\n",
    "            \"compresslevel\":\n",
    "                6,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G20. SAVE SUMMARY TEXT\n",
    "    # ========================================================\n",
    "\n",
