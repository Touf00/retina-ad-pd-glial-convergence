    "\n",
    "    required_universe_columns = {\n",
    "\n",
    "        \"original_gene_index\",\n",
    "        \"DE_universe_index\",\n",
    "        \"gene_symbol\",\n",
    "        \"n_donors_CPM_ge_1\",\n",
    "    }\n",
    "\n",
    "\n",
    "    assert (\n",
    "        required_universe_columns\n",
