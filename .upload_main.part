    "# Source analysis cell: 56\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 57\n",
    "# ============================================================\n",
    "# V2 GSE138852 PUBLIC ACQUISITION + PRE-DE AUDIT\n",
    "# ============================================================\n",
    "from pathlib import Path\n",
    "import requests, pandas as pd, json, gzip, hashlib, re\n",
    "SEC=ROOT/'GSE138852_AD_secondary'; SEC.mkdir(parents=True,exist_ok=True); DL=SEC/'downloads'; DL.mkdir(exist_ok=True)\n",
    "urls={\n",
    " 'counts':'https://ftp.ncbi.nlm.nih.gov/geo/series/GSE138nnn/GSE138852/suppl/GSE138852_counts.csv.gz',\n",
    " 'covariates':'https://ftp.ncbi.nlm.nih.gov/geo/series/GSE138nnn/GSE138852/suppl/GSE138852_covariates.csv.gz',\n",
    "}\n",
    "def get(url,p):\n",
    " if p.exists() and p.stat().st_size>0:return\n",
    " with requests.get(url,stream=True,timeout=180) as r:\n",
    "  r.raise_for_status();\n",
    "  with open(p,'wb') as f:\n",
    "   for ch in r.iter_content(4*1024*1024):\n",
    "    if ch:f.write(ch)\n",
    "for k,u in urls.items(): get(u,DL/u.split('/')[-1])\n",
    "# Zenodo author metadata; find adsn_metadata.txt dynamically.\n",
    "z=requests.get('https://zenodo.org/api/records/17302976',timeout=120); z.raise_for_status(); meta=z.json(); cand=[x for x in meta.get('files',[]) if x.get('key')=='adsn_metadata.txt']; assert len(cand)==1\n",
    "url=cand[0]['links']['self']; p=DL/'adsn_metadata.txt'; get(url,p)\n",
    "author=pd.read_csv(p,sep='\\t'); geo=pd.read_csv(DL/'GSE138852_covariates.csv.gz')\n",
    "assert len(author)==13214 and len(geo)==13214,(len(author),len(geo))\n",
    "# Verified linkage fields from the original audit.\n",
    "checks=[('batchCond','oupSample.batchCond'),('cellType','oupSample.cellType'),('subclustCond','oupSample.subclustCond')]\n",
    "for a,g in checks:\n",
    " assert (author[a].astype(str).str.strip().to_numpy()==geo[g].astype(str).str.strip().to_numpy()).all(),(a,g)\n",
    "# Exclude donor-unassigned nuclei; these are not biological donors.\n",
    "assigned=author[~author.patient.astype(str).isin(['AD-un','Ct-un'])].copy(); assert len(assigned)==12770; assert assigned.patient.nunique()==12\n",
    "mapct={'astro':'Astro','mg':'Micro','OPC':'OPC','oligo':'Oligo'}; assigned['target_cell_type']=assigned.cellType.astype(str).map(mapct)\n",
    "coverage=assigned.dropna(subset=['target_cell_type']).groupby(['patient','target_cell_type']).size().unstack(fill_value=0).reindex(columns=['Astro','Micro','OPC','Oligo'],fill_value=0)\n",
    "# Clinical metadata from the published supplementary table, frozen in the prior RETINA-ND audit.\n",
    "clinical=pd.DataFrame([\n",
    "['AD1','AD',91,'Male',8],['AD2','AD',83.8,'Male',10],['AD3','AD',67.8,'Female',21],['AD4','AD',83,'Female',34],['AD5','AD',73,'Male',9.5],['AD6','AD',74.6,'Male',30],\n",
    "['Ct1','Control',67.3,'Female',24],['Ct2','Control',82.7,'Female',28.5],['Ct3','Control',72.6,'Male',42.5],['Ct4','Control',75.6,'Male',46],['Ct5','Control',77.5,'Male',53.5],['Ct6','Control',82.7,'Male',27]],columns=['donor_id','diagnosis_binary','age','sex','PMI_hours'])\n",
    "assert set(clinical.donor_id)==set(coverage.index)\n",
    "elig=[]\n",
    "for ct in ['Astro','Micro','OPC','Oligo']:\n",
    " for thr in [10,20]:\n",
    "  ds=coverage.index[coverage[ct]>=thr].tolist(); c=clinical[clinical.donor_id.isin(ds)]; elig.append({'cell_type':ct,'threshold':thr,'donors':len(c),'AD':int((c.diagnosis_binary=='AD').sum()),'Control':int((c.diagnosis_binary=='Control').sum())})\n",
    "elig=pd.DataFrame(elig); display(elig)\n",
    "expected10={'Astro':(12,6,6),'Micro':(10,5,5),'OPC':(12,6,6),'Oligo':(12,6,6)}\n",
    "for ct,t in expected10.items():\n",
    " r=elig[(elig.cell_type==ct)&(elig.threshold==10)].iloc[0]; assert (r.donors,r.AD,r.Control)==t\n",
    "coverage.to_csv(SEC/'GSE138852_DONOR_TARGET_CELL_COVERAGE_v1.csv'); clinical.to_csv(SEC/'GSE138852_CLINICAL_METADATA_FROZEN_v1.csv',index=False); assigned[['cell','patient','sex','cellType','target_cell_type']].to_csv(SEC/'GSE138852_ASSIGNED_NUCLEUS_METADATA_v1.csv.gz',index=False,compression='gzip')\n",
    "lock={'status':'GSE138852_PRE_DE_AUDIT_FROZEN','primary_threshold':10,'primary_model':'~ age + sex + diagnosis_binary','PMI_sensitivity_model':'~ age + sex + PMI_hours + diagnosis_binary','batch_adjustment':False,'batch_reason':'pooled-library batch is nested/confounded with diagnosis','age_overlap_sensitivity':False,'disease_DE_performed':False,'eligibility':elig.to_dict('records')}\n",
    "with open(LOCKS/'GSE138852_RETINA_ND_PRE_DE_FREEZE_v1.json','w') as f: json.dump(lock,f,indent=2)\n",
    "print('GSE138852 PRE-DE AUDIT PASS — disease expression still untouched')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 58\n",
    "# ============================================================\n",
    "# V2 GSE138852 SECONDARY EXTERNAL REPLICATION DE — FIXED\n",
    "# COMPLETE DROP-IN REPLACEMENT\n",
    "#\n",
    "# FIXES\n",
    "# -----\n",
    "# 1. Correct count-column ↔ author-metadata linkage.\n",
    "# 2. Verifies linkage one-to-one before pseudobulk.\n",
    "# 3. Includes GEO-covariate bridge fallback.\n",
    "# 4. Runs PyDESeq2 in a fresh Python process to avoid the\n",
    "#    pandas/AnnData incompatibility encountered previously.\n",
    "#\n",
    "# SCIENTIFIC MODELS ARE UNCHANGED:\n",
    "#\n",
    "# Primary:\n",
    "#     ~ age + sex + diagnosis_binary\n",
    "#\n",
    "# PMI sensitivity:\n",
    "#     ~ age + sex + PMI_hours + diagnosis_binary\n",
    "#\n",
    "# Batch is NOT adjusted because pooled-library batch is\n",
    "# nested/confounded with diagnosis.\n",
    "# ============================================================\n",
    "\n",
    "import os\n",
    "import sys\n",
    "import json\n",
    "import subprocess\n",
    "import importlib.metadata\n",
    "\n",
    "from pathlib import Path\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = ROOT / \"locks\"\n",
    "\n",
    "SEC = (\n",
    "    ROOT /\n",
    "    \"GSE138852_AD_secondary\"\n",
    ")\n",
    "\n",
    "DL = (\n",
    "    SEC /\n",
    "    \"downloads\"\n",
    ")\n",
    "\n",
    "OUT = (\n",
    "    SEC /\n",
    "    \"DE\"\n",
    ")\n",
    "\n",
    "SCRIPTS = (\n",
    "    ROOT /\n",
    "    \"scripts\"\n",
    ")\n",
    "\n",
    "LOGS = (\n",
    "    ROOT /\n",
    "    \"logs\"\n",
    ")\n",
    "\n",
    "\n",
    "for directory in [\n",
    "    OUT,\n",
    "    SCRIPTS,\n",
    "    LOGS,\n",
    "]:\n",
    "\n",
    "    directory.mkdir(\n",
    "        parents=True,\n",
    "        exist_ok=True,\n",
    "    )\n",
    "\n",
    "\n",
    "assert ROOT.exists()\n",
    "\n",
    "assert LOCKS.exists()\n",
    "\n",
    "assert DL.exists()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. REQUIRED UPSTREAM LOCKS\n",
    "# ============================================================\n",
    "\n",
    "PRIMARY_LOCK = (\n",
    "    LOCKS /\n",
    "    \"AD_PRIMARY_REPLICATION_EVIDENCE_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "PRE138_LOCK = (\n",
    "    LOCKS /\n",
    "    \"GSE138852_RETINA_ND_PRE_DE_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "FINAL138_LOCK = (\n",
    "    LOCKS /\n",
    "    \"GSE138852_SECONDARY_AD_EFFECTS_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "assert PRIMARY_LOCK.exists(), (\n",
    "    \"STEP 30 output lock is missing:\\n\"\n",
    "    f\"{PRIMARY_LOCK}\"\n",
    ")\n",
    "\n",
    "\n",
    "assert PRE138_LOCK.exists(), (\n",
    "    \"GSE138852 pre-DE lock is missing:\\n\"\n",
    "    f\"{PRE138_LOCK}\"\n",
    ")\n",
    "\n",
    "\n",
    "with open(\n",
    "    PRE138_LOCK,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    pre138 = json.load(\n",
    "        f\n",
    "    )\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre138[\n",
    "        \"disease_DE_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. INPUT FILES\n",
    "# ============================================================\n",
    "\n",
    "COUNTS_PATH = (\n",
    "    DL /\n",
    "    \"GSE138852_counts.csv.gz\"\n",
    ")\n",
    "\n",
    "AUTHOR_PATH = (\n",
    "    DL /\n",
    "    \"adsn_metadata.txt\"\n",
    ")\n",
    "\n",
    "GEO_COVARIATES_PATH = (\n",
    "    DL /\n",
    "    \"GSE138852_covariates.csv.gz\"\n",
    ")\n",
    "\n",
    "CLINICAL_PATH = (\n",
    "    SEC /\n",
    "    \"GSE138852_CLINICAL_METADATA_FROZEN_v1.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "    COUNTS_PATH,\n",
    "    AUTHOR_PATH,\n",
    "    GEO_COVARIATES_PATH,\n",
    "    CLINICAL_PATH,\n",
    "]:\n",
    "\n",
    "    assert (\n",
    "        path.exists()\n",
    "        and\n",
    "        path.stat().st_size > 0\n",
    "    ), (\n",
    "        f\"Missing required file:\\n{path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. PACKAGE VERSIONS\n",
    "#\n",
    "# Run DESeq2 in a NEW Python process, just like fixed STEP 29.\n",
    "# ============================================================\n",
    "\n",
    "TARGET_PACKAGES = {\n",
    "\n",
    "    \"pandas\":\n",
    "        \"2.3.3\",\n",
    "\n",
    "    \"pydeseq2\":\n",
    "        \"0.5.4\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "for package, version in TARGET_PACKAGES.items():\n",
    "\n",
    "    try:\n",
    "\n",
    "        current = (\n",
    "            importlib.metadata.version(\n",
    "                package\n",
    "            )\n",
    "        )\n",
    "\n",
    "    except Exception:\n",
    "\n",
    "        current = None\n",
    "\n",
    "\n",
    "    if current != version:\n",
    "\n",
    "        print(\n",
    "            f\"Installing {package}=={version} \"\n",
    "            f\"(current={current})\"\n",
    "        )\n",
    "\n",
    "\n",
    "        subprocess.check_call(\n",
    "            [\n",
    "                sys.executable,\n",
    "                \"-m\",\n",
    "                \"pip\",\n",
    "                \"install\",\n",
    "                \"-q\",\n",
    "                \"--upgrade\",\n",
    "                f\"{package}=={version}\",\n",
    "            ]\n",
    "        )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. CHILD-PROCESS SCRIPT\n",
    "# ============================================================\n",
    "\n",
    "RUNNER_PATH = (\n",
    "    SCRIPTS /\n",
    "    \"GSE138852_SECONDARY_DE_FIXED.py\"\n",
    ")\n",
    "\n",
    "LOG_PATH = (\n",
    "    LOGS /\n",
    "    \"GSE138852_SECONDARY_DE_FIXED.log\"\n",
    ")\n",
    "\n",
    "\n",
    "RUNNER = r'''\n",
    "import os\n",
    "import re\n",
    "import json\n",
    "import importlib.metadata\n",
    "\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from pydeseq2.dds import DeseqDataSet\n",
    "from pydeseq2.ds import DeseqStats\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# A. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(\n",
    "    os.environ[\n",
    "        \"RETINA_ND_ROOT\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "LOCKS = (\n",
    "    ROOT /\n",
    "    \"locks\"\n",
    ")\n",
    "\n",
    "SEC = (\n",
    "    ROOT /\n",
    "    \"GSE138852_AD_secondary\"\n",
    ")\n",
    "\n",
    "DL = (\n",
    "    SEC /\n",
    "    \"downloads\"\n",
    ")\n",
    "\n",
    "OUT = (\n",
    "    SEC /\n",
    "    \"DE\"\n",
    ")\n",
    "\n",
    "OUT.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "\n",
    "COUNTS_PATH = (\n",
    "    DL /\n",
    "    \"GSE138852_counts.csv.gz\"\n",
    ")\n",
    "\n",
    "AUTHOR_PATH = (\n",
    "    DL /\n",
    "    \"adsn_metadata.txt\"\n",
    ")\n",
    "\n",
    "GEO_PATH = (\n",
    "    DL /\n",
    "    \"GSE138852_covariates.csv.gz\"\n",
    ")\n",
    "\n",
    "CLINICAL_PATH = (\n",
    "    SEC /\n",
    "    \"GSE138852_CLINICAL_METADATA_FROZEN_v1.csv\"\n",
    ")\n",
    "\n",
    "PRE_LOCK = (\n",
    "    LOCKS /\n",
    "    \"GSE138852_RETINA_ND_PRE_DE_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "FINAL_LOCK = (\n",
    "    LOCKS /\n",
    "    \"GSE138852_SECONDARY_AD_EFFECTS_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# B. ENVIRONMENT\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"GSE138852 SECONDARY EXTERNAL REPLICATION DE\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"pandas:\",\n",
    "    pd.__version__\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"pydeseq2:\",\n",
    "    importlib.metadata.version(\n",
    "        \"pydeseq2\"\n",
    "    )\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"anndata:\",\n",
    "    importlib.metadata.version(\n",
    "        \"anndata\"\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# Confirm the API required by current AnnData.\n",
    "pd.StringDtype(\n",
    "    na_value=np.nan\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# C. PRE-DE LOCK\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    PRE_LOCK,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    pre = json.load(\n",
    "        f\n",
    "    )\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre[\n",
    "        \"disease_DE_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre[\n",
    "        \"primary_threshold\"\n",
    "    ]\n",
    "    ==\n",
    "    10\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# D. LOAD AUTHOR + GEO METADATA\n",
    "# ============================================================\n",
    "\n",
    "author = pd.read_csv(\n",
    "    AUTHOR_PATH,\n",
    "    sep=\"\\t\",\n",
    "    low_memory=False,\n",
    ")\n",
    "\n",
    "\n",
    "geo = pd.read_csv(\n",
    "    GEO_PATH,\n",
    "    low_memory=False,\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    author\n",
    ") == 13214\n",
    "\n",
    "\n",
    "assert len(\n",
    "    geo\n",
    ") == 13214\n",
    "\n",
    "\n",
    "required_author = {\n",
    "\n",
    "    \"cell\",\n",
    "    \"batch\",\n",
    "    \"patient\",\n",
    "    \"sex\",\n",
    "    \"cellType\",\n",
    "    \"batchCond\",\n",
    "    \"subclustCond\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "missing = (\n",
    "    required_author\n",
    "    -\n",
    "    set(\n",
    "        author.columns\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert not missing, (\n",
    "    f\"Missing author metadata columns: {sorted(missing)}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# E. REVERIFY AUTHOR ↔ GEO ROW ALIGNMENT\n",
    "# ============================================================\n",
    "\n",
    "checks = [\n",
    "\n",
    "    (\n",
    "        \"batchCond\",\n",
    "        \"oupSample.batchCond\",\n",
    "    ),\n",
    "\n",
    "    (\n",
    "        \"cellType\",\n",
    "        \"oupSample.cellType\",\n",
    "    ),\n",
    "\n",
    "    (\n",
    "        \"subclustCond\",\n",
    "        \"oupSample.subclustCond\",\n",
    "    ),\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "for author_col, geo_col in checks:\n",
    "\n",
    "    assert geo_col in geo.columns\n",
    "\n",
    "\n",
    "    a = (\n",
    "        author[\n",
    "            author_col\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .str.strip()\n",
    "        .to_numpy()\n",
    "    )\n",
    "\n",
    "\n",
    "    g = (\n",
    "        geo[\n",
    "            geo_col\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .str.strip()\n",
    "        .to_numpy()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        a\n",
    "        ==\n",
    "        g\n",
    "    ).all(), (\n",
    "        f\"Author/GEO row mismatch: \"\n",
    "        f\"{author_col} ↔ {geo_col}\"\n",
    "    )\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nAuthor ↔ GEO row alignment: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# F. LOAD COUNTS\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\nLoading GSE138852 processed count matrix...\"\n",
    ")\n",
    "\n",
    "\n",
    "C = pd.read_csv(\n",
    "    COUNTS_PATH,\n",
    "    index_col=0,\n",
    "    low_memory=False,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Raw processed matrix shape:\",\n",
    "    C.shape\n",
    ")\n",
    "\n",
    "\n",
    "if C.shape[\n",
    "    1\n",
    "] == 13214:\n",
    "\n",
    "    genes_by_cells = C\n",
    "\n",
    "\n",
    "elif C.shape[\n",
    "    0\n",
    "] == 13214:\n",
    "\n",
    "    genes_by_cells = C.T\n",
    "\n",
    "\n",
    "else:\n",
    "\n",
    "    raise RuntimeError(\n",
    "        \"Neither count dimension equals 13,214 nuclei: \"\n",
    "        f\"{C.shape}\"\n",
    "    )\n",
    "\n",
    "\n",
    "count_cells = (\n",
    "\n",
    "    pd.Index(\n",
    "        genes_by_cells.columns\n",
    "    )\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    "    .tolist()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    count_cells\n",
    ") == 13214\n",
    "\n",
    "\n",
    "assert len(\n",
    "    set(\n",
    "        count_cells\n",
    "    )\n",
    ") == 13214\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Count-matrix nuclei:\",\n",
    "    len(\n",
    "        count_cells\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFirst count IDs:\"\n",
    ")\n",
    "\n",
    "\n",
    "for value in count_cells[\n",
    "    :5\n",
    "]:\n",
    "\n",
    "    print(\n",
    "        \" \",\n",
    "        value\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# G. CORRECT COUNT ↔ METADATA LINKAGE\n",
    "#\n",
    "# Count matrix example:\n",
    "#\n",
    "#     ACTATCTTCATTATCC_AD3_AD4\n",
    "#\n",
    "# Author metadata example:\n",
    "#\n",
    "#     AAACCTGGTAGAAAGG_AD_09241_09006\n",
    "#\n",
    "# Author metadata separately contains:\n",
    "#\n",
    "#     batch = AD5_AD6\n",
    "#\n",
    "# Therefore construct:\n",
    "#\n",
    "#     barcode + \"_\" + batch\n",
    "# ============================================================\n",
    "\n",
    "def barcode(\n",
    "    value\n",
    "):\n",
    "\n",
    "    value = str(\n",
    "        value\n",
    "    ).strip().upper()\n",
    "\n",
    "\n",
    "    match = re.match(\n",
    "        r\"^([ACGTN]{16})(?:_|-|$)\",\n",
    "        value,\n",
    "    )\n",
    "\n",
    "\n",
    "    if match is None:\n",
    "\n",
    "        return None\n",
    "\n",
    "\n",
    "    return match.group(\n",
    "        1\n",
    "    )\n",
    "\n",
    "\n",
    "author_barcode = (\n",
    "    author[\n",
    "        \"cell\"\n",
    "    ]\n",
    "    .map(\n",
    "        barcode\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert author_barcode.notna().all(), (\n",
    "    \"Could not extract a 16-base barcode from every \"\n",
    "    \"author metadata cell identifier.\"\n",
    ")\n",
    "\n",
    "\n",
    "author_batch = (\n",
    "\n",
    "    author[\n",
    "        \"batch\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "author_key = (\n",
    "\n",
    "    author_barcode\n",
    "    +\n",
    "    \"_\"\n",
    "    +\n",
    "    author_batch\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "meta = None\n",
    "\n",
    "linkage = None\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Primary linkage:\n",
    "# barcode + biological batch\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "if (\n",
    "    author_key.nunique()\n",
    "    ==\n",
    "    len(\n",
    "        author_key\n",
    "    )\n",
    "    and\n",
    "    set(\n",
    "        author_key\n",
    "    )\n",
    "    ==\n",
    "    set(\n",
    "        count_cells\n",
    "    )\n",
    "):\n",
    "\n",
    "\n",
    "    lookup = dict(\n",
    "        zip(\n",
    "            author_key,\n",
    "            range(\n",
    "                len(\n",
    "                    author\n",
    "                )\n",
    "            ),\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    order = [\n",
    "        lookup[\n",
    "            cell_id\n",
    "        ]\n",
    "        for cell_id\n",
    "        in count_cells\n",
    "    ]\n",
    "\n",
    "\n",
    "    meta = (\n",
    "\n",
    "        author\n",
    "        .iloc[\n",
    "            order\n",
    "        ]\n",
    "        .reset_index(\n",
    "            drop=True\n",
    "        )\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    reconstructed = (\n",
    "\n",
    "        meta[\n",
    "            \"cell\"\n",
    "        ]\n",
    "        .map(\n",
    "            barcode\n",
    "        )\n",
    "\n",
    "        +\n",
    "\n",
    "        \"_\"\n",
    "\n",
    "        +\n",
    "\n",
    "        meta[\n",
    "            \"batch\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .str.strip()\n",    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        reconstructed.tolist()\n",
    "        ==\n",
    "        count_cells\n",
    "    )\n",
    "\n",
    "\n",
    "    linkage = (\n",
    "        \"author_barcode_plus_batch\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# H. FALLBACK:\n",
    "# SEARCH GEO COVARIATES FOR A UNIQUE COUNT-ID COLUMN\n",
    "#\n",
    "# Author and GEO rows were already independently verified\n",
    "# aligned above.\n",
    "# ============================================================\n",
    "\n",
    "if meta is None:\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nDirect barcode+batch linkage not exact.\"\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Searching verified GEO covariates for ID bridge...\"\n",
    "    )\n",
    "\n",
    "\n",
    "    bridge = None\n",
    "\n",
    "\n",
    "    for column in geo.columns:\n",
    "\n",
    "\n",
    "        values = (\n",
    "\n",
    "            geo[\n",
    "                column\n",
    "            ]\n",
    "            .astype(str)\n",
    "            .str.strip()\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        if (\n",
    "\n",
    "            values.nunique()\n",
    "            ==\n",
    "            len(\n",
    "                values\n",
    "            )\n",
    "\n",
    "            and\n",
    "\n",
    "            set(\n",
    "                values\n",
    "            )\n",
    "            ==\n",
    "            set(\n",
    "                count_cells\n",
    "            )\n",
    "\n",
    "        ):\n",
    "\n",
    "\n",
    "            bridge = column\n",
    "\n",
    "            break\n",
    "\n",
    "\n",
    "    if bridge is not None:\n",
    "\n",
    "\n",
    "        values = (\n",
    "\n",
    "            geo[\n",
    "                bridge\n",
    "            ]\n",
    "            .astype(str)\n",
    "            .str.strip()\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        lookup = dict(\n",
    "            zip(\n",
    "                values,\n",
    "                range(\n",
    "                    len(\n",
    "                        values\n",
    "                    )\n",
    "                ),\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "        order = [\n",
    "            lookup[\n",
    "                cell_id\n",
    "            ]\n",
    "            for cell_id\n",
    "            in count_cells\n",
    "        ]\n",
    "\n",
    "\n",
    "        # author and GEO have the same verified row order\n",
    "        meta = (\n",
    "\n",
    "            author\n",
    "            .iloc[\n",
    "                order\n",
    "            ]\n",
    "            .reset_index(\n",
    "                drop=True\n",
    "            )\n",
    "            .copy()\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        linkage = (\n",
    "            \"verified_GEO_bridge:\"\n",
    "            +\n",
    "            str(\n",
    "                bridge\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# I. HARD STOP WITH DIAGNOSTICS IF LINKAGE CANNOT BE PROVEN\n",
    "# ============================================================\n",
    "\n",
    "if meta is None:\n",
    "\n",
    "\n",
    "    missing_author = list(\n",
    "\n",
    "        set(\n",
    "            count_cells\n",
    "        )\n",
    "\n",
    "        -\n",
    "\n",
    "        set(\n",
    "            author_key\n",
    "        )\n",
    "\n",
    "    )[\n",
    "        :20\n",
    "    ]\n",
    "\n",
    "\n",
    "    missing_counts = list(\n",
    "\n",
    "        set(\n",
    "            author_key\n",
    "        )\n",
    "\n",
    "        -\n",
    "\n",
    "        set(\n",
    "            count_cells\n",
    "        )\n",
    "\n",
    "    )[\n",
    "        :20\n",
    "    ]\n",
    "\n",
    "\n",
    "    raise RuntimeError(\n",
    "\n",
    "        \"Could not prove count-column ↔ author-metadata \"\n",
    "        \"linkage.\\n\\n\"\n",
    "\n",
    "        f\"First count IDs:\\n{count_cells[:10]}\\n\\n\"\n",
    "\n",
    "        f\"First reconstructed metadata keys:\\n\"\n",
    "        f\"{author_key.head(10).tolist()}\\n\\n\"\n",
    "\n",
    "        f\"Count IDs missing from reconstructed metadata \"\n",
    "        f\"(first 20):\\n{missing_author}\\n\\n\"\n",
    "\n",
    "        f\"Metadata keys missing from counts \"\n",
    "        f\"(first 20):\\n{missing_counts}\"\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "assert len(\n",
    "    meta\n",
    ") == 13214\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nCount/metadata linkage:\",\n",
    "    linkage\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Count ↔ metadata linkage: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# J. ASSIGNED DONORS + TARGET CELL TYPES\n",
    "# ============================================================\n",
    "\n",
    "assigned_mask = (\n",
    "\n",
    "    ~meta[\n",
    "        \"patient\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .isin(\n",
    "        [\n",
    "            \"AD-un\",\n",
    "            \"Ct-un\",\n",
    "        ]\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "celltype = (\n",
    "\n",
    "    meta[\n",
    "        \"cellType\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    "    .str.lower()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "cell_map = {\n",
    "\n",
    "    \"astro\":\n",
    "        \"Astro\",\n",
    "\n",
    "    \"mg\":\n",
    "        \"Micro\",\n",
    "\n",
    "    \"opc\":\n",
    "        \"OPC\",\n",
    "\n",
    "    \"oligo\":\n",
    "        \"Oligo\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "meta = meta.copy()\n",
    "\n",
    "\n",
    "meta[\n",
    "    \"target_cell_type\"\n",
    "] = celltype.map(\n",
    "    cell_map\n",
    ")\n",
    "\n",
    "\n",
    "clinical = pd.read_csv(\n",
    "    CLINICAL_PATH\n",
    ")\n",
    "\n",
    "\n",
    "required_clinical = {\n",
    "\n",
    "    \"donor_id\",\n",
    "    \"diagnosis_binary\",\n",
    "    \"age\",\n",
    "    \"sex\",\n",
    "    \"PMI_hours\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "assert required_clinical.issubset(\n",
    "    clinical.columns\n",
    ")\n",
    "\n",
    "\n",
    "assert clinical[\n",
    "    \"donor_id\"\n",
    "].is_unique\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# K. DESEQ2 HELPER\n",
    "# ============================================================\n",
    "\n",
    "def fit(\n",
    "    counts,\n",
    "    metadata,\n",
    "    formula,\n",
    "):\n",
    "\n",
    "\n",
    "    assert (\n",
    "        counts.index.tolist()\n",
    "        ==\n",
    "        metadata.index.tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        counts.columns.is_unique\n",
    "    )\n",
    "\n",
    "\n",
    "    dds = DeseqDataSet(\n",
    "\n",
    "        counts=counts,\n",
    "\n",
    "        metadata=metadata,\n",
    "\n",
    "        design=formula,\n",
    "\n",
    "        refit_cooks=True,\n",
    "\n",
    "        n_cpus=2,\n",
    "\n",
    "        quiet=False,\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    dds.deseq2()\n",
    "\n",
    "\n",
    "    stats = DeseqStats(\n",
    "\n",
    "        dds,\n",
    "\n",
    "        contrast=[\n",
    "            \"diagnosis_binary\",\n",
    "            \"AD\",\n",
    "            \"Control\",\n",
    "        ],\n",
    "\n",
    "        alpha=0.05,\n",
    "\n",
    "        cooks_filter=True,\n",
    "\n",
    "        independent_filter=True,\n",
    "\n",
    "        n_cpus=2,\n",
    "\n",
    "        quiet=False,\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    stats.summary()\n",
    "\n",
    "\n",
    "    result = (\n",
    "        stats\n",
    "        .results_df\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    result.index = (\n",
    "        result.index\n",
    "        .astype(str)\n",
    "    )\n",
    "\n",
    "\n",
    "    result.index.name = (\n",
    "        \"gene_id\"\n",
    "    )\n",
    "\n",
    "\n",
    "    return result.reset_index()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# L. PSEUDOBULK + DE\n",
    "# ============================================================\n",
    "\n",
    "classes = [\n",
    "\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "primary_results = []\n",
    "\n",
    "pmi_results = []\n",
    "\n",
    "summary_rows = []\n",
    "\n",
    "\n",
    "for ct in classes:\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\n\"\n",
    "        +\n",
    "        \"=\" * 90\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        ct\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"=\" * 90\n",
    "    )\n",
    "\n",
    "\n",
    "    target = (\n",
    "\n",
    "        assigned_mask\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            meta[\n",
    "                \"target_cell_type\"\n",
    "            ]\n",
    "            ==\n",
    "            ct\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    idx = np.flatnonzero(\n",
    "        target.to_numpy()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        idx\n",
    "    ) > 0\n",
    "\n",
    "\n",
    "    cell_meta = (\n",
    "\n",
    "        meta\n",
    "        .iloc[\n",
    "            idx\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    donors = (\n",
    "\n",
    "        cell_meta[\n",
    "            \"patient\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    coverage = (\n",
    "        donors\n",
    "        .value_counts()\n",
    "    )\n",
    "\n",
    "\n",
    "    eligible = (\n",
    "\n",
    "        coverage[\n",
    "            coverage\n",
    "            >=\n",
    "            10\n",
    "        ]\n",
    "        .index\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    eligible = sorted(\n",
    "        eligible\n",
    "    )\n",
    "\n",
    "\n",
    "    cell_keep = (\n",
    "\n",
    "        donors\n",
    "        .isin(\n",
    "            eligible\n",
    "        )\n",
    "        .to_numpy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    idx = idx[\n",
    "        cell_keep\n",
    "    ]\n",
    "\n",
    "\n",
    "    cell_meta = (\n",
    "\n",
    "        cell_meta\n",
    "        .iloc[\n",
    "            np.flatnonzero(\n",
    "                cell_keep\n",
    "            )\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    cmeta = (\n",
    "\n",
    "        clinical.loc[\n",
    "            clinical[\n",
    "                \"donor_id\"\n",
    "            ]\n",
    "            .astype(str)\n",
    "            .isin(\n",
    "                eligible\n",
    "            )\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    nAD = int(\n",
    "        (\n",
    "            cmeta[\n",
    "                \"diagnosis_binary\"\n",
    "            ]\n",
    "            ==\n",
    "            \"AD\"\n",
    "        )\n",
    "        .sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    nControl = int(\n",
    "        (\n",
    "            cmeta[\n",
    "                \"diagnosis_binary\"\n",
    "            ]\n",
    "            ==\n",
    "            \"Control\"\n",
    "        )\n",
    "        .sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert min(\n",
    "        nAD,\n",
    "        nControl,\n",
    "    ) >= 5, (\n",
    "        f\"{ct}: insufficient donor support \"\n",
    "        f\"(AD={nAD}, Control={nControl})\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Pseudobulk\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    sub = genes_by_cells.iloc[\n",
    "        :,\n",
    "        idx,\n",
    "    ]\n",
    "\n",
    "\n",
    "    patient_vector = (\n",
    "\n",
    "        cell_meta[\n",
    "            \"patient\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .to_numpy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    pb = pd.DataFrame(\n",
    "        {\n",
    "\n",
    "            donor:\n",
    "                sub.loc[\n",
    "                    :,\n",
    "                    patient_vector\n",
    "                    ==\n",
    "                    donor\n",
    "                ]\n",
    "                .sum(\n",
    "                    axis=1\n",
    "                )\n",
    "\n",
    "            for donor\n",
    "            in eligible\n",
    "\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    pb = pb.apply(\n",
    "        pd.to_numeric,\n",
    "        errors=\"raise\",\n",
    "    )\n",
    "\n",
    "\n",
    "    arr = pb.to_numpy(\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "\n",
    "    assert np.isfinite(\n",
    "        arr\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    assert (\n",
    "        arr\n",
    "        >=\n",
    "        0\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    assert np.allclose(\n",
    "        arr,\n",
    "        np.rint(\n",
    "            arr\n",
    "        ),\n",
    "    )\n",
    "\n",
    "\n",
    "    pb = pd.DataFrame(\n",
    "\n",
    "        np.rint(\n",
    "            arr\n",
    "        ).astype(\n",
    "            np.int64\n",
    "        ),\n",
    "\n",
    "        index=pd.Index(\n",
    "            pb.index.astype(str),\n",
    "            dtype=object,\n",
    "        ),\n",
    "\n",
    "        columns=pb.columns,\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # CPM gene filter\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    library_size = (\n",
    "\n",
    "        pb\n",
    "        .sum(\n",
    "            axis=0\n",
    "        )\n",
    "        .to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        library_size\n",
    "        >\n",
    "        0\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    cpm = (\n",
    "\n",
    "        pb.to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "\n",
    "        /\n",
    "\n",
    "        library_size[\n",
    "            None,\n",
    "            :\n",
    "        ]\n",
    "\n",
    "        *\n",
    "\n",
    "        1e6\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    keep = (\n",
    "\n",
    "        (\n",
    "            cpm\n",
    "            >=\n",
    "            1\n",
    "        )\n",
    "        .sum(\n",
    "            axis=1\n",
    "        )\n",
    "\n",
    "        >=\n",
    "\n",
    "        min(\n",
    "            nAD,\n",
    "            nControl,\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    symbols = (\n",
    "        pb.index\n",
    "        .astype(str)\n",
    "    )\n",
    "\n",
    "\n",
    "    mitochondrial = np.asarray(\n",
    "\n",
    "        pd.Index(\n",
    "            symbols\n",
    "        )\n",
    "        .str.upper()\n",
    "        .str.startswith(\n",
    "            \"MT-\"\n",
    "        ),\n",
    "\n",
    "        dtype=bool,\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    keep = (\n",
    "        keep\n",
    "        &\n",
    "        ~mitochondrial\n",
    "    )\n",
    "\n",
    "\n",
    "    pb = (\n",
    "        pb.loc[\n",
    "            keep\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert pb.shape[\n",
    "        0\n",
    "    ] > 3000\n",
    "\n",
    "\n",
    "    assert pb.index.is_unique, (\n",
    "        f\"{ct}: gene identifiers are not unique.\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # DESeq2 donor × gene count matrix\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    counts = (\n",
    "        pb\n",
    "        .T\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    counts.index = pd.Index(\n",
    "        eligible,\n",
    "        dtype=object,\n",
    "    )\n",
    "\n",
    "\n",
    "    counts.columns = pd.Index(\n",
    "        pb.index.astype(str),\n",
    "        dtype=object,\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Donor metadata\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    md = (\n",
    "\n",
    "        cmeta\n",
    "        .assign(\n",
    "            donor_id=lambda x:\n",
    "                x[\n",
    "                    \"donor_id\"\n",
    "                ]\n",
    "                .astype(str)\n",
    "        )\n",
    "        .set_index(\n",
    "            \"donor_id\"\n",
    "        )\n",
    "        .loc[\n",
    "            eligible,\n",
    "            [\n",
    "                \"age\",\n",
    "                \"sex\",\n",
    "                \"PMI_hours\",\n",
    "                \"diagnosis_binary\",\n",
    "            ],\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    md[\n",
    "        \"age\"\n",
    "    ] = pd.to_numeric(\n",
    "        md[\n",
    "            \"age\"\n",
    "        ],\n",
    "        errors=\"raise\",\n",
    "    )\n",
    "\n",
    "\n",
    "    md[\n",
    "        \"PMI_hours\"\n",
    "    ] = pd.to_numeric(\n",
    "        md[\n",
    "            \"PMI_hours\"\n",
    "        ],\n",
    "        errors=\"raise\",\n",
    "    )\n",
    "\n",
    "\n",
    "    sex_map = {\n",
    "\n",
    "        \"F\":\n",
    "            \"Female\",\n",
    "\n",
    "        \"M\":\n",
    "            \"Male\",\n",
    "\n",
    "        \"Female\":\n",
    "            \"Female\",\n",
    "\n",
    "        \"Male\":\n",
    "            \"Male\",\n",
    "\n",
    "        \"female\":\n",
    "            \"Female\",\n",
    "\n",
    "        \"male\":\n",
    "            \"Male\",\n",
    "\n",
    "    }\n",
    "\n",
    "\n",
    "    sex_raw = (\n",
    "\n",
    "        md[\n",
    "            \"sex\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .str.strip()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    md[\n",
    "        \"sex\"\n",
    "    ] = sex_raw.map(\n",
    "        sex_map\n",
    "    )\n",
    "\n",
    "\n",
    "    assert md[\n",
    "        \"sex\"\n",
    "    ].notna().all()\n",
    "\n",
    "\n",
    "    md[\n",
    "        \"sex\"\n",
    "    ] = pd.Categorical(\n",
    "\n",
    "        md[\n",
    "            \"sex\"\n",
    "        ],\n",
    "\n",
    "        categories=[\n",
    "            \"Female\",\n",
    "            \"Male\",\n",
    "        ],\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    md[\n",
    "        \"diagnosis_binary\"\n",
    "    ] = pd.Categorical(\n",
    "\n",
    "        md[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .str.strip(),\n",
    "\n",
    "        categories=[\n",
    "            \"Control\",\n",
    "            \"AD\",\n",
    "        ],\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert md[\n",
    "        \"diagnosis_binary\"\n",
    "    ].notna().all()\n",
    "\n",
    "\n",
    "    assert (\n",
    "        counts.index.tolist()\n",
    "        ==\n",
    "        md.index.tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Eligible nuclei:\",\n",
    "        len(\n",
    "            idx\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Eligible donors:\",\n",
    "        len(\n",
    "            eligible\n",
    "        ),\n",
    "        f\"(AD={nAD}, Control={nControl})\"\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Genes after filter:\",\n",
    "        counts.shape[\n",
    "            1\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # PRIMARY MODEL\n",
    "    # ========================================================\n",
    "\n",
    "    primary = fit(\n",
    "\n",
    "        counts,\n",
    "\n",
    "        md[\n",
    "            [\n",
    "                \"age\",\n",
    "                \"sex\",\n",
    "                \"diagnosis_binary\",\n",
    "            ]\n",
    "        ],\n",
    "\n",
    "        \"~ age + sex + diagnosis_binary\",\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # PMI SENSITIVITY MODEL\n",
    "    # ========================================================\n",
    "\n",    "    pmi = fit(\n",
    "\n",
    "        counts,\n",
    "\n",
    "        md[\n",
    "            [\n",
    "                \"age\",\n",
    "                \"sex\",\n",
    "                \"PMI_hours\",\n",
    "                \"diagnosis_binary\",\n",
    "            ]\n",
    "        ],\n",
    "\n",
    "        \"~ age + sex + PMI_hours + diagnosis_binary\",\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # ANNOTATE RESULTS\n",
    "    # ========================================================\n",
    "\n",
    "    for table, label, store in [\n",
    "\n",
    "        (\n",
    "            primary,\n",
    "            \"PRIMARY\",\n",
    "            primary_results,\n",
    "        ),\n",
    "\n",
    "        (\n",
    "            pmi,\n",
    "            \"PMI\",\n",
    "            pmi_results,\n",
    "        ),\n",
    "\n",
    "    ]:\n",
    "\n",
    "\n",
    "        table.insert(\n",
    "\n",
    "            1,\n",
    "\n",
    "            \"gene_symbol\",\n",
    "\n",
    "            table[\n",
    "                \"gene_id\"\n",
    "            ]\n",
    "            .astype(str),\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        table[\n",
    "            \"cell_type\"\n",
    "        ] = ct\n",
    "\n",
    "\n",
    "        table[\n",
    "            \"analysis_model\"\n",
    "        ] = label\n",
    "\n",
    "\n",
    "        store.append(\n",
    "            table\n",
    "        )\n",
    "\n",
    "\n",
    "    summary_rows.append(\n",
    "        {\n",
    "\n",
    "            \"cell_type\":\n",
    "                ct,\n",
    "\n",
    "            \"donors\":\n",
    "                len(\n",
    "                    eligible\n",
    "                ),\n",
    "\n",
    "            \"AD\":\n",
    "                nAD,\n",
    "\n",
    "            \"Control\":\n",
    "                nControl,\n",
    "\n",
    "            \"eligible_nuclei\":\n",
    "                int(\n",
    "                    len(\n",
    "                        idx\n",
    "                    )\n",
    "                ),\n",
    "\n",
    "            \"tested_genes\":\n",
    "                int(\n",
    "                    len(\n",
    "                        primary\n",
    "                    )\n",
    "                ),\n",
    "\n",
    "            \"primary_FDR\":\n",
    "                int(\n",
    "                    (\n",
    "                        primary[\n",
    "                            \"padj\"\n",
    "                        ]\n",
    "                        <\n",
    "                        0.05\n",
    "                    )\n",
    "                    .fillna(\n",
    "                        False\n",
    "                    )\n",
    "                    .sum()\n",
    "                ),\n",
    "\n",
    "            \"PMI_FDR\":\n",
    "                int(\n",
    "                    (\n",
    "                        pmi[\n",
    "                            \"padj\"\n",
    "                        ]\n",
    "                        <\n",
    "                        0.05\n",
    "                    )\n",
    "                    .fillna(\n",
    "                        False\n",
    "                    )\n",
    "                    .sum()\n",
    "                ),\n",
    "\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# M. COMBINE RESULTS\n",
    "# ============================================================\n",
    "\n",
    "P138 = pd.concat(\n",
    "    primary_results,\n",
    "    ignore_index=True,\n",
    ")\n",
    "\n",
    "\n",
    "Q138 = pd.concat(\n",
    "    pmi_results,\n",
    "    ignore_index=True,\n",
    ")\n",
    "\n",
    "\n",
    "summary = pd.DataFrame(\n",
    "    summary_rows\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# N. SAVE\n",
    "# ============================================================\n",
    "\n",
    "PRIMARY_EFFECTS = (\n",
    "    OUT /\n",
    "    \"GSE138852_AD_SECONDARY_PRIMARY_ALL_EFFECTS_LONG_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "PMI_EFFECTS = (\n",
    "    OUT /\n",
    "    \"GSE138852_AD_SECONDARY_PMI_ALL_EFFECTS_LONG_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "SUMMARY_PATH = (\n",
    "    OUT /\n",
    "    \"GSE138852_AD_SECONDARY_DE_SUMMARY_v1.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "P138.to_csv(\n",
    "    PRIMARY_EFFECTS,\n",
    "    index=False,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "Q138.to_csv(\n",
    "    PMI_EFFECTS,\n",
    "    index=False,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "summary.to_csv(\n",
    "    SUMMARY_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "    PRIMARY_EFFECTS,\n",
    "    PMI_EFFECTS,\n",
    "    SUMMARY_PATH,\n",
    "]:\n",
    "\n",
    "    assert (\n",
    "        path.exists()\n",
    "        and\n",
    "        path.stat().st_size > 0\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# O. FINAL LOCK\n",
    "# ============================================================\n",
    "\n",
    "lock = {\n",
    "\n",
    "    \"status\":\n",
    "        \"GSE138852_SECONDARY_AD_EFFECTS_FROZEN\",\n",
    "\n",
    "    \"count_metadata_linkage\":\n",
    "        linkage,\n",
    "\n",
    "    \"primary_threshold\":\n",
    "        10,\n",
    "\n",
    "    \"primary_model\":\n",
    "        \"~ age + sex + diagnosis_binary\",\n",
    "\n",
    "    \"PMI_model\":\n",
    "        \"~ age + sex + PMI_hours + diagnosis_binary\",\n",
    "\n",
    "    \"batch_adjustment\":\n",
    "        False,\n",
    "\n",
    "    \"batch_reason\":\n",
    "        (\n",
    "            \"pooled-library batch is nested/confounded \"\n",
    "            \"with diagnosis\"\n",
    "        ),\n",
    "\n",
    "    \"primary_effects\":\n",
    "        str(\n",
    "            PRIMARY_EFFECTS\n",
    "        ),\n",
    "\n",
    "    \"PMI_effects\":\n",
    "        str(\n",
    "            PMI_EFFECTS\n",
    "        ),\n",
    "\n",
    "    \"summary\":\n",
    "        summary.to_dict(\n",
    "            \"records\"\n",
    "        ),\n",
    "\n",
    "    \"AD_PD_convergence_performed\":\n",
    "        False,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    FINAL_LOCK,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        lock,\n",
    "        f,\n",
    "        indent=2,\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# P. REPORT\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"GSE138852 SECONDARY AD EFFECTS FROZEN\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Verified count/metadata linkage:\",\n",
    "    linkage\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nDE summary:\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    summary.to_string(\n",
    "        index=False\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPrimary effects:\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    PRIMARY_EFFECTS\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPMI effects:\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    PMI_EFFECTS\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFinal lock:\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    FINAL_LOCK\n",
    ")\n",
    "'''\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. VERIFY CHILD SCRIPT SYNTAX\n",
    "# ============================================================\n",
    "\n",
    "compile(\n",
    "    RUNNER,\n",
    "    \"<GSE138852_SECONDARY_DE_FIXED>\",\n",
    "    \"exec\",\n",
    ")\n",
    "\n",
    "\n",
    "RUNNER_PATH.write_text(\n",
    "    RUNNER,\n",
    "    encoding=\"utf-8\",\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"GSE138852 SECONDARY DE — FIXED REPLACEMENT\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Runner syntax check: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nLaunching fresh Python process...\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. RUN CHILD PROCESS\n",
    "# ============================================================\n",
    "\n",
    "env = os.environ.copy()\n",
    "\n",
    "\n",
    "env[\n",
    "    \"RETINA_ND_ROOT\"\n",
    "] = str(\n",
    "    ROOT\n",
    ")\n",
    "\n",
    "\n",
    "env[\n",
    "    \"PYTHONUNBUFFERED\"\n",
    "] = \"1\"\n",
    "\n",
    "\n",
    "with open(\n",
    "    LOG_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as log_file:\n",
    "\n",
    "\n",
    "    proc = subprocess.Popen(\n",
    "\n",
    "        [\n",
    "            sys.executable,\n",
    "            \"-u\",\n",
    "            str(\n",
    "                RUNNER_PATH\n",
    "            ),\n",
    "        ],\n",
    "\n",
    "        stdout=subprocess.PIPE,\n",
    "\n",
    "        stderr=subprocess.STDOUT,\n",
    "\n",
    "        text=True,\n",
    "\n",
    "        env=env,\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    for line in proc.stdout:\n",
    "\n",
    "\n",
    "        print(\n",
    "            line,\n",
    "            end=\"\",\n",
    "        )\n",
    "\n",
    "\n",
    "        log_file.write(\n",
    "            line\n",
    "        )\n",
    "\n",
    "\n",
    "    return_code = proc.wait()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. FAILURE REPORT\n",
    "# ============================================================\n",
    "\n",
    "if return_code != 0:\n",
    "\n",
    "\n",
    "    raise RuntimeError(\n",
    "\n",
    "        \"GSE138852 secondary DE failed inside the fresh \"\n",
    "        f\"process (exit code {return_code}).\\n\\n\"\n",
    "\n",
    "        \"The complete underlying traceback is printed above \"\n",
    "        \"and saved here:\\n\"\n",
    "\n",
    "        f\"{LOG_PATH}\"\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. VERIFY FINAL LOCK\n",
    "# ============================================================\n",
    "\n",
    "assert FINAL138_LOCK.exists(), (\n",
    "    \"Fresh process completed but final GSE138852 lock \"\n",
    "    f\"is missing:\\n{FINAL138_LOCK}\"\n",
    ")\n",
    "\n",
    "\n",
    "with open(\n",
    "    FINAL138_LOCK,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    result = json.load(\n",
    "        f\n",
    "    )\n",
    "\n",
    "\n",
    "assert (\n",
    "    result[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"GSE138852_SECONDARY_AD_EFFECTS_FROZEN\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. FINAL NOTEBOOK REPORT\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"GSE138852 SECONDARY REPLICATION COMPLETED SUCCESSFULLY\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Count/metadata linkage:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    result[\n",
    "        \"count_metadata_linkage\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nNEXT: FINAL AD EVIDENCE FREEZE\"\n",
    ")"
   ]
