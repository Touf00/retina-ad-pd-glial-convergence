    "    design_lock = json.load(f)\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre_de_lock[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"FINAL_PRE_DE_LOCK\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre_de_lock[\n",
    "        \"differential_expression_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre_de_lock[\n",
    "        \"disease_gene_results_inspected\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    design_lock[\n",
    "        \"primary_design_full_rank\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    design_lock[\n",
    "        \"primary_design_rank\"\n",
    "    ]\n",
    "    ==\n",
    "    4\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    design_lock[\n",
    "        \"primary_design_columns\"\n",
    "    ]\n",
    "    ==\n",
    "    4\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFrozen pre-DE locks verified.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# D. PRIMARY CLASSES / EXPECTED UNIVERSES\n",
    "# ============================================================\n",
    "\n",
    "PRIMARY_CLASSES = [\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "]\n",
    "\n",
    "\n",
    "EXPECTED_UNIVERSES = {\n",
    "\n",
    "    \"Astro\":\n",
    "        16942,\n",
    "\n",
    "    \"Micro\":\n",
    "        16050,\n",
    "\n",
    "    \"OPC\":\n",
    "        16268,\n",
    "\n",
    "    \"Oligo\":\n",
    "        15957,\n",
    "}\n",
    "\n",
    "\n",
    "for cell_type in PRIMARY_CLASSES:\n",
    "\n",
    "    rec = (\n",
    "        pre_de_lock[\n",
    "            \"cell_class_universes\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        rec[\n",
    "            \"role\"\n",
    "        ]\n",
    "        ==\n",
    "        \"primary\"\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        rec[\n",
    "            \"frozen_DE_gene_universe\"\n",
    "        ]\n",
    "        ==\n",
    "        EXPECTED_UNIVERSES[\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Frozen primary classes verified:\",\n",
    "    PRIMARY_CLASSES\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# E. HASH HELPERS\n",
    "# ============================================================\n",
    "\n",
    "def sha256_file(\n",
    "    path,\n",
    "    block_size=1024 * 1024\n",
    "):\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\"\n",
    "    ) as f:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            block = f.read(\n",
    "                block_size\n",
    "            )\n",
    "\n",
    "            if not block:\n",
    "                break\n",
    "\n",
    "            h.update(\n",
    "                block\n",
    "            )\n",
    "\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "def ordered_gene_hash(\n",
    "    ordered_genes\n",
    "):\n",
    "\n",
    "    payload = (\n",
    "        \"\\n\".join(\n",
    "            map(\n",
    "                str,\n",
    "                ordered_genes\n",
    "            )\n",
    "        )\n",
    "        +\n",
    "        \"\\n\"\n",
    "    ).encode(\n",
    "        \"utf-8\"\n",
    "    )\n",
    "\n",
    "    return hashlib.sha256(\n",
    "        payload\n",
    "    ).hexdigest()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# F. RESULT STORAGE\n",
    "# ============================================================\n",
    "\n",
    "run_records = {}\n",
    "\n",
    "summary_rows = []\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# G. RUN FOUR PRIMARY CELL CLASSES\n",
    "# ============================================================\n",
    "\n",
    "for class_number, cell_type in enumerate(\n",
    "    PRIMARY_CLASSES,\n",
    "    start=1\n",
    "):\n",
    "\n",
    "    print(\n",
    "        \"\\n\"\n",
    "        +\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"[{class_number}/4] \"\n",
    "        f\"{cell_type} — PRIMARY PD vs CONTROL DE\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G1. Frozen input record\n",
    "    # ========================================================\n",
    "\n",
    "    frozen_record = (\n",
    "        pre_de_lock[\n",
    "            \"cell_class_universes\"\n",
