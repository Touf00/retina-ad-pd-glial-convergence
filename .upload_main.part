    "    ]\n",
    "    ==\n",
    "    \"GSE174367\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre_de_lock[\n",
    "        \"design_audit\"\n",
    "    ][\n",
    "        \"primary_rank\"\n",
    "    ]\n",
    "    ==\n",
    "    6\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre_de_lock[\n",
    "        \"design_audit\"\n",
    "    ][\n",
    "        \"primary_columns\"\n",
    "    ]\n",
    "    ==\n",
    "    6\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFrozen GSE174367 pre-DE state verified.\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Primary model:\",\n",
    "    pre_de_lock[\n",
    "        \"design_audit\"\n",
    "    ][\n",
    "        \"primary_model\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"AD disease effects previously inspected: NO\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"AD↔PD convergence previously performed: NO\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# D. CELL CLASSES\n",
    "# ============================================================\n",
    "\n",
    "PRIMARY_CLASSES = [\n",
    "\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "for cell_type in PRIMARY_CLASSES:\n",
    "\n",
    "    assert (\n",
    "        cell_type\n",
    "        in\n",
    "        pre_de_lock[\n",
    "            \"cell_class_gene_universes\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# E. HELPERS\n",
    "# ============================================================\n",
    "\n",
    "def sha256_file(\n",
    "    path,\n",
    "    block_size=1024 * 1024\n",
    "):\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\"\n",
    "    ) as f:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            block = f.read(\n",
    "                block_size\n",
    "            )\n",
    "\n",
    "            if not block:\n",
    "                break\n",
    "\n",
    "            h.update(\n",
    "                block\n",
    "            )\n",
    "\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "def ordered_feature_hash(\n",
    "    features\n",
    "):\n",
    "\n",
    "    payload = (\n",
    "        \"\\n\".join(\n",
    "            map(\n",
    "                str,\n",
    "                features\n",
    "            )\n",
    "        )\n",
    "        +\n",
    "        \"\\n\"\n",
    "    ).encode(\n",
    "        \"utf-8\"\n",
    "    )\n",
    "\n",
    "    return hashlib.sha256(\n",
    "        payload\n",
    "    ).hexdigest()\n",
    "\n",
    "\n",
    "def ordered_effect_hash(\n",
    "    df\n",
    "):\n",
    "\n",
    "    columns = [\n",
    "\n",
    "        \"gene_id\",\n",
    "        \"log2FoldChange\",\n",
    "        \"stat\",\n",
    "        \"pvalue\",\n",
    "        \"padj\",\n",
    "\n",
    "    ]\n",
    "\n",
    "\n",
    "    payload = (\n",
    "        df[\n",
    "            columns\n",
    "        ]\n",
    "        .to_csv(\n",
    "            index=False,\n",
    "            lineterminator=\"\\n\"\n",
    "        )\n",
    "        .encode(\n",
    "            \"utf-8\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    return hashlib.sha256(\n",
    "        payload\n",
    "    ).hexdigest()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# F. STORAGE\n",
    "# ============================================================\n",
    "\n",
    "run_records = {}\n",
    "freeze_records = {}\n",
    "\n",
