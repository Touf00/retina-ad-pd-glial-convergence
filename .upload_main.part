    "\n",
    "    gc.collect()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# H. COMBINED PRIMARY DE SUMMARY\n",
    "# ============================================================\n",
    "\n",
    "summary = pd.DataFrame(\n",
    "    summary_rows\n",
    ")\n",
    "\n",
    "\n",
    "summary[\n",
    "    \"cell_type\"\n",
    "] = pd.Categorical(\n",
    "    summary[\n",
    "        \"cell_type\"\n",
    "    ],\n",
    "    categories=PRIMARY_CLASSES,\n",
    "    ordered=True\n",
    ")\n",
    "\n",
    "\n",
    "summary = (\n",
    "    summary\n",
    "    .sort_values(\n",
    "        \"cell_type\"\n",
    "    )\n",
    "    .reset_index(\n",
    "        drop=True\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "summary[\n",
    "    \"cell_type\"\n",
    "] = (\n",
    "    summary[\n",
    "        \"cell_type\"\n",
    "    ]\n",
    "    .astype(str)\n",
    ")\n",
    "\n",
    "\n",
    "summary.to_csv(\n",
    "    summary_path,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# I. ENVIRONMENT RECORD\n",
    "# ============================================================\n",
    "\n",
    "environment_record = {\n",
    "\n",
    "    \"python\":\n",
    "        platform.python_version(),\n",
    "\n",
    "    \"pydeseq2\":\n",
    "        PYDESEQ2_VERSION,\n",
    "\n",
    "    \"anndata\":\n",
    "        ANNDATA_VERSION,\n",
    "\n",
    "    \"pandas\":\n",
    "        PANDAS_VERSION,\n",
    "\n",
    "    \"numpy\":\n",
    "        np.__version__,\n",
    "}\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# J. FINAL DE RUN LOCK\n",
    "# ============================================================\n",
    "\n",
    "DE_RUN_LOCK = {\n",
    "\n",
    "    \"dataset\":\n",
    "        \"GSE243639\",\n",
    "\n",
    "    \"created_utc\":\n",    "        datetime.now(\n",
    "            timezone.utc\n",
    "        ).isoformat(),\n",
    "\n",
    "    \"analysis\":\n",
    "        \"PRIMARY_PD_vs_Control_DE\",\n",
    "\n",
