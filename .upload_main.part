   "source": [
    "# Source analysis cell: 38\n",
    "# ============================================================\n",
    "# STEP 20 — GSE174367 AD DISCOVERY PSEUDOBULK\n",
    "#           + GENE UNIVERSES\n",
    "#           + FINAL PRE-DE LOCK\n",
    "#\n",
    "# NO DIFFERENTIAL EXPRESSION.\n",
    "# NO AD↔PD CONVERGENCE.\n",
    "#\n",
    "# FROZEN PRIMARY ANALYSIS\n",
    "# -----------------------\n",
    "# Biological replicate:\n",
    "#     donor\n",
    "#\n",
    "# Primary cell classes:\n",
    "#     Astro\n",
    "#     Micro\n",
    "#     OPC\n",
    "#     Oligo\n",
    "#\n",
    "# Minimum nuclei / donor / class:\n",
    "#     >=50\n",
    "#\n",
    "# All 18 donors survive in all four classes.\n",
    "#\n",
    "# Primary model:\n",
    "#     ~ age + sex + batch + diagnosis_binary\n",
    "#\n",
    "# Technical sensitivity 1:\n",
    "#     ~ age + sex + batch + RIN + diagnosis_binary\n",
    "#     all 18 donors\n",
    "#\n",
    "# Technical sensitivity 2:\n",
    "#     ~ age + sex + batch + PMI + diagnosis_binary\n",
    "#     complete-case donors only\n",
    "#     expected 17 donors = 11 AD + 6 Control\n",
    "#\n",
    "# No age-overlap sensitivity:\n",
    "#     overlap restriction would retain only 3 controls.\n",
    "#\n",
    "# Gene filtering per cell class:\n",
    "#     CPM >= 1 in >=7 of 18 donors\n",
    "#\n",
    "# where 7 = smaller diagnosis group.\n",
    "#\n",
    "# Filtering is disease-blind.\n",
    "#\n",
    "# MT- genes removed AFTER expression filtering.\n",
    "#\n",
    "# Ensembl gene IDs remain the DE feature identifier.\n",
    "# Gene symbols are annotation only.\n",
    "#\n",
    "# Duplicate gene symbols are NOT collapsed.\n",
    "# Later cross-dataset matching will use unambiguous symbols.\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import h5py\n",
    "\n",
    "import hashlib\n",
    "import json\n",
    "import gc\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = ROOT / \"locks\"\n",
    "MANIFESTS = ROOT / \"manifests\"\n",
    "\n",
    "AD_DIR = (\n",
    "    ROOT /\n",
    "    \"GSE174367_AD_discovery\"\n",
    ")\n",
    "\n",
    "DOWNLOAD_DIR = (\n",
    "    AD_DIR /\n",
    "    \"downloads\"\n",
    ")\n",
    "\n",
    "UNIVERSES = (\n",
    "    ROOT /\n",
    "    \"GSE174367_gene_universes\"\n",
    ")\n",
    "\n",
    "RESULTS = (\n",
    "    ROOT /\n",
    "    \"results\"\n",
    ")\n",
    "\n",
    "\n",
    "for directory in [\n",
    "\n",
    "    LOCKS,\n",
    "    MANIFESTS,\n",
    "    UNIVERSES,\n",
    "    RESULTS,\n",
    "\n",
    "]:\n",
    "\n",
    "    directory.mkdir(\n",
    "        parents=True,\n",
    "        exist_ok=True\n",
    "    )\n",
    "\n",
    "\n",
    "AUDIT_LOCK_PATH = (\n",
    "    LOCKS /\n",
    "    \"GSE174367_AD_DISCOVERY_DATA_AUDIT_v1.json\"\n",
    ")\n",
    "\n",
    "ROLE_LOCK_PATH = (\n",
    "    LOCKS /\n",
    "    \"AD_BRAIN_DATASET_ROLES_v1.json\"\n",
    ")\n",
    "\n",
    "CELL_META_PATH = (\n",
    "    MANIFESTS /\n",
    "    \"GSE174367_author_cell_metadata_AUDITED_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "DONOR_META_PATH = (\n",
    "    MANIFESTS /\n",
    "    \"GSE174367_donor_metadata_FROZEN_v1.csv\"\n",
    ")\n",
    "\n",
    "FEATURE_META_PATH = (\n",
    "    MANIFESTS /\n",
    "    \"GSE174367_H5_feature_metadata_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "H5_PATH = (\n",
    "    DOWNLOAD_DIR /\n",
    "    \"GSE174367_snRNA-seq_filtered_feature_bc_matrix.h5\"\n",
    ")\n",
    "\n",
    "\n",
    "PSEUDOBULK_PATH = (\n",
    "    RESULTS /\n",
    "    \"GSE174367_donor_celltype_pseudobulk_RAW_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "GROUP_META_PATH = (\n",
    "    MANIFESTS /\n",
    "    \"GSE174367_pseudobulk_group_metadata_v1.csv\"\n",
    ")\n",
    "\n",
    "DESIGN_META_PATH = (\n",
    "    MANIFESTS /\n",
    "    \"GSE174367_AD_discovery_design_metadata_v1.csv\"\n",
    ")\n",
    "\n",
    "PSEUDOBULK_LOCK_PATH = (\n",
    "    LOCKS /\n",
    "    \"GSE174367_AD_DISCOVERY_PSEUDOBULK_BUILD_v1.json\"\n",
    ")\n",
    "\n",
    "PRE_DE_LOCK_PATH = (\n",
    "    LOCKS /\n",
    "    \"GSE174367_AD_DISCOVERY_PRE_DE_LOCK_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "\n",
    "    AUDIT_LOCK_PATH,\n",
    "    ROLE_LOCK_PATH,\n",
    "    CELL_META_PATH,\n",
    "    DONOR_META_PATH,\n",
    "    FEATURE_META_PATH,\n",
    "    H5_PATH,\n",
    "\n",
    "]:\n",
    "\n",
    "    assert path.exists(), (\n",
    "        f\"Missing required input: {path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. VERIFY UPSTREAM LOCKS\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    AUDIT_LOCK_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    audit_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    ROLE_LOCK_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    role_lock = json.load(f)\n",
    "\n",
    "\n",
    "assert (\n",
    "    audit_lock[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"AD_DISCOVERY_DATA_AUDIT_COMPLETE\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    audit_lock[\n",
    "        \"differential_expression_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    audit_lock[\n",
    "        \"disease_gene_results_inspected\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    audit_lock[\n",
    "        \"AD_PD_convergence_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    role_lock[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"AD_DATASET_ROLES_FROZEN_BEFORE_DISEASE_EXPRESSION\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    role_lock[\n",
    "        \"primary_discovery\"\n",
    "    ][\n",
    "        \"dataset\"\n",
    "    ]\n",
    "    ==\n",
    "    \"GSE174367\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"UPSTREAM AD DISCOVERY LOCKS VERIFIED\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",    "# 2. LOAD AUDITED METADATA\n",
    "# ============================================================\n",
    "\n",
    "cells = pd.read_csv(\n",
    "    CELL_META_PATH,\n",
    "    compression=\"gzip\",\n",
    "    low_memory=False\n",
    ")\n",
    "\n",
    "\n",
    "donors = pd.read_csv(\n",
    "    DONOR_META_PATH\n",
    ")\n",
    "\n",
    "\n",
    "feature_meta = pd.read_csv(\n",
    "    FEATURE_META_PATH,\n",
    "    compression=\"gzip\",\n",
    "    low_memory=False\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    cells\n",
    ") == 61472\n",
    "\n",
    "\n",
    "assert len(\n",
    "    donors\n",
    ") == 18\n",
    "\n",
    "\n",
    "assert len(\n",
    "    feature_meta\n",
    ") == 58721\n",
    "\n",
    "\n",
    "assert (\n",
    "    cells[\n",
    "        \"Barcode\"\n",
    "    ]\n",
    "    .is_unique\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    cells[\n",
    "        \"H5_column_index\"\n",
    "    ]\n",
    "    .is_unique\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    feature_meta[\n",
    "        \"gene_id\"\n",
    "    ]\n",
    "    .is_unique\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    donors[\n",
    "        \"diagnosis_binary\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    "    ==\n",
    "    {\n",
    "        \"AD\": 11,\n",
    "        \"Control\": 7,\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. FREEZE PRIMARY CELL THRESHOLD\n",
    "# ============================================================\n",
    "\n",
    "TARGET_CLASSES = [\n",
    "\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "MIN_NUCLEI_PER_DONOR = 50\n",
    "\n",
    "\n",
    "donor_cell_counts = (\n",
    "\n",
    "    cells\n",
    "    .groupby(\n",
    "        [\n",
    "            \"donor_id\",\n",
    "            \"diagnosis_binary\",\n",
    "            \"canonical_cell_class\",\n",
    "        ],\n",
    "        observed=True\n",
    "    )\n",
    "    .size()\n",
    "    .reset_index(\n",
    "        name=\"n_nuclei\"\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "coverage_check_rows = []\n",
    "\n",
    "\n",
    "for cell_type in TARGET_CLASSES:\n",
    "\n",
    "\n",
    "    class_counts = (\n",
    "\n",
    "        donor_cell_counts[\n",
    "            donor_cell_counts[\n",
    "                \"canonical_cell_class\"\n",
    "            ]\n",
    "            ==\n",
    "            cell_type\n",
    "        ]\n",
    "        [\n",
    "            [\n",
    "                \"donor_id\",\n",
    "                \"n_nuclei\",\n",
    "            ]\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    complete = (\n",
    "\n",
    "        donors[\n",
    "            [\n",
    "                \"donor_id\",\n",
    "                \"diagnosis_binary\",\n",
    "            ]\n",
    "        ]\n",
    "        .merge(\n",
    "            class_counts,\n",
    "            on=\"donor_id\",\n",
    "            how=\"left\",\n",
    "            validate=\"one_to_one\"\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    complete[\n",
    "        \"n_nuclei\"\n",
    "    ] = (\n",
    "\n",
    "        complete[\n",
    "            \"n_nuclei\"\n",
    "        ]\n",
    "        .fillna(\n",
    "            0\n",
    "        )\n",
    "        .astype(\n",
    "            int\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    eligible = (\n",
    "\n",
    "        complete[\n",
    "            complete[\n",
    "                \"n_nuclei\"\n",
    "            ]\n",
    "            >=\n",
    "            MIN_NUCLEI_PER_DONOR\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    dx = (\n",
    "\n",
    "        eligible[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        .value_counts()\n",
    "        .to_dict()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    coverage_check_rows.append({\n",
    "\n",
    "        \"cell_type\":\n",
    "            cell_type,\n",
    "\n",
    "        \"min_nuclei\":\n",
    "            int(\n",
    "                complete[\n",
    "                    \"n_nuclei\"\n",
    "                ].min()\n",
    "            ),\n",
    "\n",
    "        \"AD\":\n",
    "            int(\n",
    "                dx.get(\n",
    "                    \"AD\",\n",
    "                    0\n",
    "                )\n",
    "            ),\n",
    "\n",
    "        \"Control\":\n",
    "            int(\n",
    "                dx.get(\n",
    "                    \"Control\",\n",
    "                    0\n",
    "                )\n",
    "            ),\n",
    "\n",
    "        \"Total\":\n",
    "            int(\n",
    "                len(\n",
    "                    eligible\n",
    "                )\n",
    "            ),\n",
    "    })\n",
    "\n",
    "\n",
    "coverage_check = pd.DataFrame(\n",
    "    coverage_check_rows\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFrozen >=50 nuclei coverage:\"\n",
    ")\n",
    "\n",
    "display(\n",
    "    coverage_check\n",
    ")\n",
    "\n",
    "\n",
    "for cell_type in TARGET_CLASSES:\n",
    "\n",
    "    row = (\n",
    "\n",
    "        coverage_check[\n",
    "            coverage_check[\n",
    "                \"cell_type\"\n",
    "            ]\n",
    "            ==\n",
    "            cell_type\n",
    "        ]\n",
    "        .iloc[\n",
    "            0\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        row[\n",
    "            \"AD\"\n",
    "        ]\n",
    "    ) == 11\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        row[\n",
    "            \"Control\"\n",
    "        ]\n",
    "    ) == 7\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        row[\n",
    "            \"Total\"\n",
    "        ]\n",
    "    ) == 18\n",
    "\n",
    "\n",
    "print(\n",
    "    \"All four target classes retain all 18 donors: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. VERIFY FEATURE TYPES\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\nFeature-type counts:\"\n",
    ")\n",
    "\n",
    "display(\n",
    "\n",
    "    feature_meta[\n",
    "        \"feature_type\"\n",
    "    ]\n",
    "    .value_counts(\n",
    "        dropna=False\n",
    "    )\n",
    "    .rename_axis(\n",
    "        \"feature_type\"\n",
    "    )\n",
    "    .reset_index(\n",
    "        name=\"n_features\"\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "GEX_MASK = (\n",
    "\n",
    "    feature_meta[\n",
    "        \"feature_type\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .eq(\n",
    "        \"Gene Expression\"\n",
    "    )\n",
    "    .to_numpy(\n",
    "        dtype=bool\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "N_GEX = int(\n",
    "    GEX_MASK.sum()\n",
    ")\n",
    "\n",
    "\n",
    "assert N_GEX > 0\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Gene Expression features:\",\n",
    "    f\"{N_GEX:,}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. TARGET ANALYSIS CELLS\n",
    "# ============================================================\n",
    "\n",
    "target_cells = (\n",
    "\n",
    "    cells[\n",
    "        cells[\n",
    "            \"canonical_cell_class\"\n",
    "        ]\n",
    "        .isin(\n",
    "            TARGET_CLASSES\n",
    "        )\n",
    "    ]\n",
    "    .copy()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "EXPECTED_TARGET_COUNTS = {\n",
    "\n",
    "    \"Astro\":\n",
    "        4756,\n",
    "\n",
    "    \"Micro\":\n",
    "        4126,\n",
    "\n",
    "    \"OPC\":\n",
    "        2740,\n",
    "\n",
    "    \"Oligo\":\n",
    "        37052,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "observed_target_counts = (\n",
    "\n",
    "    target_cells[\n",
    "        \"canonical_cell_class\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    observed_target_counts\n",
    "    ==\n",
    "    EXPECTED_TARGET_COUNTS\n",
    ")\n",
    "\n",
    "\n",
    "N_TARGET_CELLS = int(\n",
    "    len(\n",
    "        target_cells\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    N_TARGET_CELLS\n",
    "    ==\n",
    "    48674\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nTarget analysis nuclei:\",\n",
    "    f\"{N_TARGET_CELLS:,}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. BUILD EXACT 72-GROUP METADATA\n",
    "#\n",
    "# 18 donors × 4 classes\n",
    "# ============================================================\n",
    "\n",
    "donor_order = (\n",
    "\n",
    "    donors[\n",
    "        \"donor_id\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .tolist()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    donor_order\n",
    ") == 18\n",
    "\n",
    "\n",
    "group_rows = []\n",
    "\n",
    "\n",
    "for cell_type in TARGET_CLASSES:\n",
    "\n",
    "    for donor_id in donor_order:\n",
    "\n",
    "\n",
    "        donor_row = (\n",
    "\n",
    "            donors[\n",
    "                donors[\n",
    "                    \"donor_id\"\n",
    "                ]\n",
    "                .astype(str)\n",
    "                ==\n",
    "                donor_id\n",
    "            ]\n",
    "            .iloc[\n",
    "                0\n",
    "            ]\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        n_nuclei = int(\n",
    "\n",
    "            (\n",
    "                (\n",
    "                    target_cells[\n",
    "                        \"donor_id\"\n",
    "                    ]\n",
    "                    .astype(str)\n",
    "                    ==\n",
    "                    donor_id\n",
    "                )\n",
    "                &\n",
    "                (\n",
    "                    target_cells[\n",
    "                        \"canonical_cell_class\"\n",
    "                    ]\n",
    "                    ==\n",
    "                    cell_type\n",
    "                )\n",
    "            ).sum()\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        assert (\n",
    "            n_nuclei\n",
    "            >=\n",
    "            MIN_NUCLEI_PER_DONOR\n",
    "        )\n",
    "\n",
    "\n",
    "        group_rows.append({\n",
    "\n",
    "            \"pseudobulk_group\":\n",
    "                (\n",
    "                    f\"{donor_id}\"\n",
    "                    f\"__\"\n",
    "                    f\"{cell_type}\"\n",
    "                ),\n",
    "\n",
    "            \"donor_id\":\n",
    "                donor_id,\n",
    "\n",
    "            \"diagnosis_binary\":\n",
    "                donor_row[\n",
    "                    \"diagnosis_binary\"\n",
    "                ],\n",
    "\n",
    "            \"age\":\n",
    "                float(\n",
    "                    donor_row[\n",
    "                        \"age\"\n",
    "                    ]\n",
    "                ),\n",
    "\n",
    "            \"sex\":\n",
    "                donor_row[\n",
    "                    \"sex\"\n",
    "                ],\n",
    "\n",
    "            \"batch\":\n",
    "                str(\n",
    "                    donor_row[\n",
    "                        \"batch\"\n",
    "                    ]\n",
    "                ),\n",
    "\n",
    "            \"PMI\":\n",
    "                (\n",
    "                    float(\n",
    "                        donor_row[\n",
    "                            \"PMI\"\n",
    "                        ]\n",
    "                    )\n",
    "                    if pd.notna(\n",
    "                        donor_row[\n",
    "                            \"PMI\"\n",
    "                        ]\n",
    "                    )\n",
    "                    else np.nan\n",
    "                ),\n",
    "\n",
    "            \"RIN\":\n",
    "                float(\n",
    "                    donor_row[\n",
    "                        \"RIN\"\n",
    "                    ]\n",
    "                ),\n",
    "\n",
    "            \"canonical_cell_class\":\n",
    "                cell_type,\n",
    "\n",
    "            \"n_nuclei\":\n",
    "                n_nuclei,\n",
    "        })\n",
    "\n",
    "\n",
    "group_meta = pd.DataFrame(\n",
    "    group_rows\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    group_meta\n",
    ") == 72\n",
    "\n",
    "\n",
    "assert (\n",
    "    group_meta[\n",
    "        \"pseudobulk_group\"\n",
    "    ]\n",
    "    .is_unique\n",
    ")\n",
    "\n",
    "\n",
    "for cell_type in TARGET_CLASSES:\n",
    "\n",
    "    check = (\n",
    "\n",
    "        group_meta[\n",
    "            group_meta[\n",
    "                \"canonical_cell_class\"\n",
    "            ]\n",
    "            ==\n",
    "            cell_type\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        check\n",
    "    ) == 18\n",
    "\n",
    "\n",
    "    assert (\n",
    "        check[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        .value_counts()\n",
    "        .to_dict()\n",
    "        ==\n",
    "        {\n",
    "            \"AD\": 11,\n",
    "            \"Control\": 7,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "group_meta.to_csv(\n",
    "    GROUP_META_PATH,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. ASSIGN TARGET CELLS TO PSEUDOBULK GROUPS\n",
    "# ============================================================\n",
    "\n",
    "group_to_code = {\n",
    "\n",
    "    group:\n",
    "        index\n",
    "\n",
    "    for index, group\n",
    "    in enumerate(\n",
    "        group_meta[\n",
    "            \"pseudobulk_group\"\n",
    "        ].tolist()\n",
    "    )\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "target_cells[\n",
    "    \"pseudobulk_group\"\n",
    "] = (\n",
    "\n",
    "    target_cells[\n",
    "        \"donor_id\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "\n",
    "    +\n",
    "\n",
    "    \"__\"\n",
    "\n",
    "    +\n",
    "\n",
    "    target_cells[\n",
    "        \"canonical_cell_class\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "target_cells[\n",
    "    \"group_code\"\n",
    "] = (\n",
    "\n",
    "    target_cells[\n",
    "        \"pseudobulk_group\"\n",
    "    ]\n",
    "    .map(\n",
    "        group_to_code\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    target_cells[\n",
    "        \"group_code\"\n",
    "    ]\n",
    "    .notna()\n",
    "    .all()\n",
    ")\n",
    "\n",
    "\n",
    "target_cells[\n",
    "    \"group_code\"\n",
    "] = (\n",
    "\n",
    "    target_cells[\n",
    "        \"group_code\"\n",
    "    ]\n",
    "    .astype(\n",
    "        np.int16\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "N_GROUPS = int(\n",
    "    len(\n",
    "        group_meta\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "observed_nuclei_by_group = np.bincount(\n",
    "\n",
    "    target_cells[\n",
    "        \"group_code\"\n",
    "    ]\n",
    "    .to_numpy(\n",
    "        dtype=np.int64\n",
    "    ),\n",
    "\n",
    "    minlength=N_GROUPS\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "expected_nuclei_by_group = (\n",
    "\n",
    "    group_meta[\n",
    "        \"n_nuclei\"\n",
    "    ]\n",
    "    .to_numpy(\n",
    "        dtype=np.int64\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert np.array_equal(\n",
    "\n",
    "    observed_nuclei_by_group,\n",
    "\n",
    "    expected_nuclei_by_group\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. BUILD H5-COLUMN → GROUP-CODE VECTOR\n",
    "# ============================================================\n",
    "\n",
    "N_H5_CELLS = 61770\n",
    "N_FEATURES = 58721\n",
    "\n",
    "\n",
    "group_code_by_h5_column = np.full(\n",
    "\n",
    "    N_H5_CELLS,\n",
    "\n",
    "    -1,\n",
    "\n",
    "    dtype=np.int16\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "h5_indices = (\n",
    "\n",
    "    target_cells[\n",
    "        \"H5_column_index\"\n",
    "    ]\n",
    "    .to_numpy(\n",
    "        dtype=np.int64\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "target_group_codes = (\n",
    "\n",
    "    target_cells[\n",
    "        \"group_code\"\n",
    "    ]\n",
    "    .to_numpy(\n",
    "        dtype=np.int16\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    h5_indices\n",
    ") == N_TARGET_CELLS\n",
    "\n",
    "\n",
    "assert len(\n",
    "    np.unique(\n",
    "        h5_indices\n",
    "    )\n",
    ") == N_TARGET_CELLS\n",
    "\n",
    "\n",
    "group_code_by_h5_column[\n",
    "    h5_indices\n",
    "] = target_group_codes\n",
    "\n",
    "\n",
    "assert int(\n",
    "\n",
    "    (\n",
    "        group_code_by_h5_column\n",
    "        >=\n",
    "        0\n",
    "    ).sum()\n",
    "\n",
    ") == N_TARGET_CELLS\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. STREAM H5 → RAW DONOR PSEUDOBULK\n",
    "#\n",
    "# H5 is CSC:\n",
    "#\n",
    "#   features × cells\n",
    "#\n",
    "# We process contiguous cell-column blocks and aggregate\n",
    "# non-zero counts directly into feature × group pseudobulk.\n",
    "#\n",
    "# No dense single-cell matrix is created.\n",
    "# ============================================================\n",
    "\n",
    "pseudobulk = np.zeros(\n",
    "\n",
    "    (\n",
    "        N_FEATURES,\n",
    "        N_GROUPS\n",
    "    ),\n",
    "\n",
    "    dtype=np.int64\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "BLOCK_COLUMNS = 512\n",
    "\n",
    "\n",
    "total_target_input_UMIs = 0\n",
    "total_pseudobulk_output_UMIs = 0\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STREAMING OFFICIAL H5 → DONOR PSEUDOBULK\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "with h5py.File(\n",
    "    H5_PATH,\n",
    "    \"r\"\n",
    ") as h5:\n",
    "\n",
    "\n",
    "    matrix = h5[\n",
    "        \"matrix\"\n",
    "    ]\n",
    "\n",
    "\n",
    "    data_ds = matrix[\n",
    "        \"data\"\n",
    "    ]\n",
    "\n",
    "\n",
    "    indices_ds = matrix[\n",
    "        \"indices\"\n",
    "    ]\n",
    "\n",
    "\n",
    "    indptr = (\n",
    "\n",
    "        matrix[\n",
    "            \"indptr\"\n",
    "        ][:]\n",
    "        .astype(\n",
    "            np.int64\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        indptr\n",
    "    ) == (\n",
    "        N_H5_CELLS\n",
    "        +\n",
    "        1\n",
    "    )\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        indptr[\n",
    "            -1\n",
    "        ]\n",
    "    ) == int(\n",
    "        data_ds.shape[\n",
    "            0\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    for col_start in range(\n",
    "        0,\n",
    "        N_H5_CELLS,\n",
    "        BLOCK_COLUMNS\n",
    "    ):\n",
    "\n",
    "\n",
    "        col_end = min(\n",
    "            col_start\n",
    "            +\n",
    "            BLOCK_COLUMNS,\n",
    "            N_H5_CELLS\n",
    "        )\n",
    "\n",
    "\n",
    "        block_group_codes = (\n",
    "\n",
    "            group_code_by_h5_column[\n",
    "                col_start:\n",
    "                col_end\n",
    "            ]\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        # Skip blocks containing no target cells.\n",
    "        if not np.any(\n",
    "            block_group_codes\n",
    "            >=\n",
    "            0\n",
    "        ):\n",
    "\n",
    "            continue\n",
    "\n",
    "\n",
    "        data_start = int(\n",
    "            indptr[\n",
    "                col_start\n",
    "            ]\n",
    "        )\n",
    "\n",
    "\n",
    "        data_end = int(\n",
    "            indptr[\n",
    "                col_end\n",
    "            ]\n",
    "        )\n",
    "\n",
    "\n",
    "        if (\n",
    "            data_end\n",
    "            ==\n",
    "            data_start\n",
    "        ):\n",
    "\n",
    "            continue\n",
    "\n",
    "\n",
    "        feature_indices = (\n",
    "\n",
    "            indices_ds[\n",
    "                data_start:\n",
    "                data_end\n",
    "            ]\n",
    "            .astype(\n",
    "                np.int64,\n",
    "                copy=False\n",
    "            )\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        values = (\n",
    "\n",
    "            data_ds[\n",
    "                data_start:\n",
    "                data_end\n",
    "            ]\n",
    "            .astype(\n",
    "                np.int64,\n",
    "                copy=False\n",
    "            )\n",
    "\n",
    "        )\n",
    "\n",
    "\n",    "        assert (\n",
    "            values\n",
    "            >=\n",
    "            0\n",
    "        ).all()\n",
    "\n",
    "\n",
    "        nnz_per_column = np.diff(\n",
    "\n",
    "            indptr[\n",
    "                col_start:\n",
    "                col_end\n",
    "                +\n",
    "                1\n",
    "            ]\n",
    "\n",
    "        ).astype(\n",
    "            np.int64\n",
    "        )\n",
    "\n",
    "\n",
    "        expanded_group_codes = np.repeat(\n",
    "\n",
    "            block_group_codes,\n",
    "\n",
    "            nnz_per_column\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        assert len(\n",
    "            expanded_group_codes\n",
    "        ) == len(\n",
    "            values\n",
    "        )\n",
    "\n",
    "\n",
    "        keep = (\n",
    "\n",
    "            expanded_group_codes\n",
    "            >=\n",
    "            0\n",
    "        )\n",
    "\n",
    "\n",
    "        if not np.any(\n",
    "            keep\n",
    "        ):\n",
    "\n",
    "            continue\n",
    "\n",
    "\n",
    "        kept_features = (\n",
    "\n",
    "            feature_indices[\n",
    "                keep\n",
    "            ]\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        kept_values = (\n",
    "\n",
    "            values[\n",
    "                keep\n",
    "            ]\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        kept_groups = (\n",
    "\n",
    "            expanded_group_codes[\n",
    "                keep\n",
    "            ]\n",
    "            .astype(\n",
    "                np.int64,\n",
    "                copy=False\n",
    "            )\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        # ----------------------------------------------------\n",
    "        # Encode feature × group into one integer index.\n",
    "        # ----------------------------------------------------\n",
    "\n",
    "        flat_indices = (\n",
    "\n",
    "            kept_features\n",
    "            *\n",
    "            N_GROUPS\n",
    "\n",
    "            +\n",
    "\n",
    "            kept_groups\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        block_sum_float = np.bincount(\n",
    "\n",
    "            flat_indices,\n",
    "\n",
    "            weights=\n",
    "                kept_values.astype(\n",
    "                    np.float64,\n",
    "                    copy=False\n",
    "                ),\n",
    "\n",
    "            minlength=\n",
    "                N_FEATURES\n",
    "                *\n",
    "                N_GROUPS\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        # Counts are integer and far below float64 exactness limit.\n",
    "        assert np.all(\n",
    "\n",
    "            block_sum_float\n",
    "            ==\n",
    "            np.floor(\n",
    "                block_sum_float\n",
    "            )\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        block_sum = (\n",
    "\n",
    "            block_sum_float\n",
    "            .reshape(\n",
    "                N_FEATURES,\n",
    "                N_GROUPS\n",
    "            )\n",
    "            .astype(\n",
    "                np.int64\n",
    "            )\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        block_input = int(\n",
    "\n",
    "            kept_values.sum(\n",
    "                dtype=np.int64\n",
    "            )\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        block_output = int(\n",
    "\n",
    "            block_sum.sum(\n",
    "                dtype=np.int64\n",
    "            )\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        assert (\n",
    "            block_input\n",
    "            ==\n",
    "            block_output\n",
    "        )\n",
    "\n",
    "\n",
    "        pseudobulk += block_sum\n",
    "\n",
    "\n",
    "        total_target_input_UMIs += (\n",
    "            block_input\n",
    "        )\n",
    "\n",
    "\n",
    "        total_pseudobulk_output_UMIs += (\n",
    "            block_output\n",
    "        )\n",
    "\n",
    "\n",
    "        del (\n",
    "            feature_indices,\n",
    "            values,\n",
    "            expanded_group_codes,\n",
    "            kept_features,\n",
    "            kept_values,\n",
    "            kept_groups,\n",
    "            flat_indices,\n",
    "            block_sum_float,\n",
    "            block_sum\n",
    "        )\n",
    "\n",
    "\n",
    "        gc.collect()\n",
    "\n",
    "\n",
    "        if (\n",
    "            col_end\n",
    "            % 5120\n",
    "            <\n",
    "            BLOCK_COLUMNS\n",
    "        ):\n",
    "\n",
    "            print(\n",
    "                \"Processed H5 columns:\",\n",
    "                f\"{col_end:,}\",\n",
    "                \"/\",\n",
    "                f\"{N_H5_CELLS:,}\"\n",
    "            )\n",
    "\n",
    "\n",
    "assert (\n",
    "    total_target_input_UMIs\n",
    "    ==\n",
    "    total_pseudobulk_output_UMIs\n",
    ")\n",
    "\n",
    "\n",
    "assert int(\n",
    "\n",
    "    pseudobulk.sum(\n",
    "        dtype=np.int64\n",
    "    )\n",
    "\n",
    ") == total_target_input_UMIs\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nUMI conservation: PASS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Target-cell input UMIs:\",\n",
    "    f\"{total_target_input_UMIs:,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Pseudobulk output UMIs:\",\n",
    "    f\"{total_pseudobulk_output_UMIs:,}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. RAW PSEUDOBULK DATAFRAME\n",
    "# ============================================================\n",
    "\n",
    "gene_ids = (\n",
    "\n",
    "    feature_meta[\n",
    "        \"gene_id\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .tolist()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    gene_ids\n",
    ") == N_FEATURES\n",
    "\n",
    "\n",
    "pb = pd.DataFrame(\n",
    "\n",
    "    pseudobulk,\n",
    "\n",
    "    index=pd.Index(\n",
    "        gene_ids,\n",
    "        name=\"gene_id\"\n",
    "    ),\n",
    "\n",
    "    columns=\n",
    "        group_meta[\n",
    "            \"pseudobulk_group\"\n",
    "        ].tolist()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert pb.shape == (\n",
    "    58721,\n",
    "    72\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    pb.index\n",
    "    .is_unique\n",
    ")\n",
    "\n",
    "\n",
    "pb.to_csv(\n",
    "\n",
    "    PSEUDOBULK_PATH,\n",
    "\n",
    "    compression={\n",
    "        \"method\":\n",
    "            \"gzip\",\n",
    "\n",
    "        \"compresslevel\":\n",
    "            6\n",
    "    }\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. HASH HELPERS\n",
    "# ============================================================\n",
    "\n",
    "def sha256_file(\n",
    "    path,\n",
    "    block_size=1024 * 1024\n",
    "):\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\"\n",
    "    ) as f:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            block = f.read(\n",
    "                block_size\n",
    "            )\n",
    "\n",
    "\n",
    "            if not block:\n",
    "\n",
    "                break\n",
    "\n",
    "\n",
    "            h.update(\n",
    "                block\n",
    "            )\n",
    "\n",
    "\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "def ordered_feature_hash(\n",
    "    feature_ids\n",
    "):\n",
    "\n",
    "    payload = (\n",
    "\n",
    "        \"\\n\".join(\n",
    "            map(\n",
    "                str,\n",
    "                feature_ids\n",
    "            )\n",
    "        )\n",
    "\n",
    "        +\n",
    "\n",
    "        \"\\n\"\n",
    "\n",
    "    ).encode(\n",
    "        \"utf-8\"\n",
    "    )\n",
    "\n",
    "\n",
    "    return hashlib.sha256(\n",
    "        payload\n",
    "    ).hexdigest()\n",
    "\n",
    "\n",
    "pseudobulk_sha256 = sha256_file(\n",
    "    PSEUDOBULK_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nRaw pseudobulk:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    PSEUDOBULK_PATH\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"SHA256:\",\n",
    "    pseudobulk_sha256\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 12. FEATURE ANNOTATION VECTORS\n",
    "# ============================================================\n",
    "\n",
    "gene_symbols = (\n",
    "\n",
    "    feature_meta[\n",
    "        \"gene_symbol\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .to_numpy()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "symbol_unique = (\n",
    "\n",
    "    feature_meta[\n",
    "        \"gene_symbol_unique\"\n",
    "    ]\n",
    "    .astype(bool)\n",
    "    .to_numpy()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "mt_mask = (\n",
    "\n",
    "    feature_meta[\n",
    "        \"MT_prefix\"\n",
    "    ]\n",
    "    .astype(bool)\n",
    "    .to_numpy()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "gex_mask = (\n",
    "\n",
    "    feature_meta[\n",
    "        \"feature_type\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .eq(\n",
    "        \"Gene Expression\"\n",
    "    )\n",
    "    .to_numpy(\n",
    "        dtype=bool\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 13. FREEZE GENE FILTER\n",
    "#\n",
    "# CPM >= 1 in >=7 of 18 donors.\n",
    "#\n",
    "# 7 = smaller diagnosis group.\n",
    "#\n",
    "# CPM denominator:\n",
    "# total Gene Expression UMI count in each donor×class\n",
    "# pseudobulk before expression filtering.\n",
    "#\n",
    "# MT- removed after expression threshold.\n",
    "# ============================================================\n",
    "\n",
    "CPM_THRESHOLD = 1.0\n",
    "MIN_DONORS_CPM = 7\n",
    "\n",
    "\n",
    "universe_records = {}\n",
    "universe_summary_rows = []\n",
    "\n",
    "\n",
    "for cell_type in TARGET_CLASSES:\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\n\"\n",
    "        +\n",
    "        \"=\" * 72\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        cell_type\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"=\" * 72\n",
    "    )\n",
    "\n",
    "\n",
    "    class_meta = (\n",
    "\n",
    "        group_meta[\n",
    "            group_meta[\n",
    "                \"canonical_cell_class\"\n",
    "            ]\n",
    "            ==\n",
    "            cell_type\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        class_meta\n",
    "    ) == 18\n",
    "\n",
    "\n",
    "    class_columns = (\n",
    "\n",
    "        class_meta[\n",
    "            \"pseudobulk_group\"\n",
    "        ]\n",
    "        .tolist()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    class_counts = (\n",
    "\n",
    "        pb[\n",
    "            class_columns\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    arr = (\n",
    "\n",
    "        class_counts\n",
    "        .to_numpy(\n",
    "            dtype=np.int64,\n",
    "            copy=False\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Library size from Gene Expression features only.\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    library_sizes = (\n",
    "\n",
    "        arr[\n",
    "            gex_mask,\n",
    "            :\n",
    "        ]\n",
    "        .sum(\n",
    "            axis=0,\n",
    "            dtype=np.int64\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        library_sizes\n",
    "        >\n",
    "        0\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    class_meta[\n",
    "        \"library_size\"\n",
    "    ] = (\n",
    "        library_sizes\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # CPM for every feature using frozen library denominator.\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    cpm = (\n",
    "\n",
    "        arr.astype(\n",
    "            np.float64\n",
    "        )\n",
    "\n",
    "        /\n",
    "\n",
    "        library_sizes[\n",
    "            None,\n",
    "            :\n",
    "        ]\n",
    "\n",
    "        *\n",
    "\n",
    "        1_000_000.0\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert np.isfinite(\n",
    "        cpm\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    n_donors_ge_1cpm = (\n",
    "\n",
    "        (\n",
    "            cpm\n",
    "            >=\n",
    "            CPM_THRESHOLD\n",
    "        )\n",
    "        .sum(\n",
    "            axis=1\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    expression_pass = (\n",
    "\n",
    "        n_donors_ge_1cpm\n",
    "        >=\n",
    "        MIN_DONORS_CPM\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    final_mask = (\n",
    "\n",
    "        expression_pass\n",
    "\n",
    "        &\n",
    "\n",
    "        gex_mask\n",
    "\n",
    "        &\n",
    "\n",
    "        ~mt_mask\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    retained_indices = np.flatnonzero(\n",
    "        final_mask\n",
    "    )\n",
    "\n",
    "\n",
    "    retained_gene_ids = [\n",
    "\n",
    "        gene_ids[\n",
    "            i\n",
    "        ]\n",
    "\n",
    "        for i\n",
    "        in retained_indices\n",
    "\n",
    "    ]\n",
    "\n",
    "\n",
    "    n_expression_pass_GEX = int(\n",
    "\n",
    "        (\n",
    "            expression_pass\n",
    "            &\n",
    "            gex_mask\n",
    "        ).sum()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_MT_expression_pass = int(\n",
    "\n",
    "        (\n",
    "            expression_pass\n",
    "            &\n",
    "            gex_mask\n",
    "            &\n",
    "            mt_mask\n",
    "        ).sum()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_retained = int(\n",
    "        final_mask.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "\n",
    "        n_retained\n",
    "\n",
    "        ==\n",
    "\n",
    "        n_expression_pass_GEX\n",
    "        -\n",
    "        n_MT_expression_pass\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Expression-passing Gene Expression features:\",\n",
    "        f\"{n_expression_pass_GEX:,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Expression-passing MT- removed:\",\n",
    "        n_MT_expression_pass\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Frozen AD discovery universe:\",\n",
    "        f\"{n_retained:,}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 13A. GENE UNIVERSE TABLE\n",
    "    # ========================================================\n",
    "\n",
    "    universe_table = pd.DataFrame({\n",
    "\n",
    "        \"original_feature_index\":\n",
    "            retained_indices,\n",
    "\n",
    "        \"AD_discovery_universe_index\":\n",
    "            np.arange(\n",
    "                n_retained,\n",
    "                dtype=np.int64\n",
    "            ),\n",
    "\n",
    "        \"gene_id\":\n",
    "            np.asarray(\n",
    "                gene_ids,\n",
    "                dtype=object\n",
    "            )[\n",
    "                retained_indices\n",
    "            ],\n",
    "\n",
    "        \"gene_symbol\":\n",
    "            gene_symbols[\n",
    "                retained_indices\n",
    "            ],\n",
    "\n",
    "        \"gene_symbol_unique_in_GSE174367\":\n",
    "            symbol_unique[\n",
    "                retained_indices\n",
    "            ],\n",
    "\n",
    "        \"feature_type\":\n",
    "            feature_meta[\n",
    "                \"feature_type\"\n",
    "            ]\n",
    "            .astype(str)\n",
    "            .to_numpy()[\n",
    "                retained_indices\n",
    "            ],\n",
    "\n",
    "        \"n_donors_CPM_ge_1\":\n",
    "            n_donors_ge_1cpm[\n",
    "                retained_indices\n",
    "            ].astype(\n",
    "                np.int64\n",
    "            ),\n",
    "    })\n",
    "\n",
    "\n",
    "    assert (\n",
    "        universe_table[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .is_unique\n",
    "    )\n",
    "\n",
    "\n",
    "    assert not (\n",
    "\n",
    "        universe_table[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .str.upper()\n",
    "        .str.startswith(\n",
    "            \"MT-\"\n",
    "        )\n",
    "        .any()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    universe_path = (\n",
    "\n",
    "        UNIVERSES /\n",
    "        (\n",
    "            f\"GSE174367_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"AD_DISCOVERY_GENE_UNIVERSE_v1.csv.gz\"\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    universe_table.to_csv(\n",
    "\n",
    "        universe_path,\n",
    "\n",
    "        index=False,\n",
    "\n",
    "        compression={\n",
    "            \"method\":\n",
    "                \"gzip\",\n",
    "\n",
    "            \"compresslevel\":\n",
    "                6\n",
    "        }\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 13B. FROZEN RAW COUNTS\n",
    "    # ========================================================\n",
    "\n",
    "    filtered_counts = (\n",
    "\n",
    "        class_counts\n",
    "        .iloc[\n",
    "            retained_indices,\n",
    "            :\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "\n",
    "        filtered_counts\n",
    "        .index\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "\n",
    "        ==\n",
    "\n",
    "        retained_gene_ids\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    counts_path = (\n",
    "\n",
    "        UNIVERSES /\n",
    "        (\n",
    "            f\"GSE174367_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"RAW_COUNTS_FROZEN_v1.csv.gz\"\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    filtered_counts.to_csv(\n",
    "\n",
    "        counts_path,\n",
    "\n",
    "        compression={\n",
    "            \"method\":\n",
    "                \"gzip\",\n",
    "\n",
    "            \"compresslevel\":\n",
    "                6\n",
    "        }\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 13C. DONOR METADATA FOR THIS CLASS\n",
    "    # ========================================================\n",
    "\n",
    "    donor_path = (\n",
    "\n",
    "        MANIFESTS /\n",
    "        (\n",
    "            f\"GSE174367_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"AD_DISCOVERY_DONORS_v1.csv\"\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    class_meta[\n",
    "        [\n",
    "            \"pseudobulk_group\",\n",
    "            \"donor_id\",\n",
    "            \"diagnosis_binary\",\n",
    "            \"age\",\n",
    "            \"sex\",\n",
    "            \"batch\",\n",
    "            \"PMI\",\n",
    "            \"RIN\",\n",
    "            \"n_nuclei\",\n",
    "            \"library_size\",\n",
    "        ]\n",
    "    ].to_csv(\n",
    "        donor_path,\n",
    "        index=False\n",
    "    )\n",
    "\n",
    "\n",
    "    feature_hash = ordered_feature_hash(\n",
    "        retained_gene_ids\n",
    "    )\n",
    "\n",
    "\n",
    "    universe_records[\n",
    "        cell_type\n",
    "    ] = {\n",
    "\n",
    "        \"minimum_nuclei_per_donor\":\n",
    "            50,\n",
    "\n",
    "        \"n_AD\":\n",
    "            11,\n",
    "\n",
    "        \"n_Control\":\n",
    "            7,\n",
    "\n",
    "        \"n_total_donors\":\n",
    "            18,\n",
    "\n",
    "        \"CPM_threshold\":\n",
    "            1.0,\n",
    "\n",
    "        \"minimum_donors_CPM\":\n",
    "            7,\n",
    "\n",
    "        \"input_features\":\n",
    "            58721,\n",
    "\n",
    "        \"input_Gene_Expression_features\":\n",
    "            int(\n",
    "                N_GEX\n",
    "            ),\n",
    "\n",
    "        \"Gene_Expression_features_passing_expression_rule\":\n",
    "            n_expression_pass_GEX,\n",
    "\n",
    "        \"expression_passing_MT_removed\":\n",
    "            n_MT_expression_pass,\n",
    "\n",
    "        \"frozen_AD_discovery_gene_universe\":\n",
    "            n_retained,\n",
    "\n",
    "        \"feature_identifier\":\n",
    "            \"Ensembl_gene_id\",\n",
    "\n",
    "        \"gene_symbol_policy\":\n",
    "            (\n",
    "                \"annotation only; duplicate symbols retained \"\n",
    "                \"for DE and later excluded from direct \"\n",
    "                \"cross-dataset symbol matching\"\n",
    "            ),\n",
    "\n",
    "        \"ordered_gene_id_sha256\":\n",
    "            feature_hash,\n",
    "\n",
    "        \"gene_universe_file\":\n",
    "            str(\n",
    "                universe_path\n",
    "            ),\n",
    "\n",
    "        \"raw_counts_file\":\n",
    "            str(\n",
    "                counts_path\n",
    "            ),\n",
    "\n",
    "        \"donor_metadata_file\":\n",
    "            str(\n",
    "                donor_path\n",
    "            ),\n",
    "    }\n",
    "\n",
    "\n",
    "    universe_summary_rows.append({\n",
    "\n",
    "        \"cell_type\":\n",
    "            cell_type,\n",
    "\n",
    "        \"AD\":\n",
    "            11,\n",
    "\n",
    "        \"Control\":\n",
    "            7,\n",
    "\n",
    "        \"min_nuclei\":\n",
    "            50,\n",
    "\n",
    "        \"CPM_min_donors\":\n",
    "            7,\n",
    "\n",
    "        \"expression_pass_GEX\":\n",
    "            n_expression_pass_GEX,\n",
    "\n",
    "        \"MT_removed\":\n",
    "            n_MT_expression_pass,\n",
    "\n",
    "        \"frozen_universe\":\n",    "            n_retained,\n",
    "\n",
    "        \"unique_symbol_features\":\n",
    "            int(\n",
    "                universe_table[\n",
    "                    \"gene_symbol_unique_in_GSE174367\"\n",
    "                ].sum()\n",
    "            ),\n",
    "    })\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 14. DESIGN METADATA\n",
    "# ============================================================\n",
    "\n",
    "design_meta = (\n",
    "\n",
    "    donors[\n",
    "        [\n",
    "            \"donor_id\",\n",
    "            \"diagnosis_binary\",\n",
    "            \"age\",\n",
    "            \"sex\",\n",
    "            \"batch\",\n",
    "            \"PMI\",\n",
    "            \"RIN\",\n",
    "        ]\n",
    "    ]\n",
    "    .copy()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "design_meta[\n",
    "    \"age\"\n",
    "] = pd.to_numeric(\n",
    "    design_meta[\n",
    "        \"age\"\n",
    "    ],\n",
    "    errors=\"raise\"\n",
    ")\n",
    "\n",
    "\n",
    "design_meta[\n",
    "    \"RIN\"\n",
    "] = pd.to_numeric(\n",
    "    design_meta[\n",
    "        \"RIN\"\n",
    "    ],\n",
    "    errors=\"raise\"\n",
    ")\n",
    "\n",
    "\n",
    "design_meta[\n",
    "    \"PMI\"\n",
    "] = pd.to_numeric(\n",
    "    design_meta[\n",
    "        \"PMI\"\n",
    "    ],\n",
    "    errors=\"coerce\"\n",
    ")\n",
    "\n",
    "\n",
    "design_meta[\n",
    "    \"batch\"\n",
    "] = (\n",
    "\n",
    "    design_meta[\n",
    "        \"batch\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    design_meta[\n",
    "        [\n",
    "            \"diagnosis_binary\",\n",
    "            \"age\",\n",
    "            \"sex\",\n",
    "            \"batch\",\n",
    "            \"RIN\",\n",
    "        ]\n",
    "    ]\n",
    "    .notna()\n",
    "    .all()\n",
    "    .all()\n",
    ")\n",
    "\n",
    "\n",
    "assert int(\n",
    "\n",
    "    design_meta[\n",
    "        \"PMI\"\n",
    "    ]\n",
    "    .isna()\n",
    "    .sum()\n",
    "\n",
    ") == 1\n",
    "\n",
    "\n",
    "design_meta.to_csv(\n",
    "    DESIGN_META_PATH,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 15. DESIGN CODING\n",
    "#\n",
    "# References:\n",
    "#     diagnosis = Control\n",
    "#     sex       = Female\n",
    "#     batch     = 1\n",
    "# ============================================================\n",
    "\n",
    "assert (\n",
    "    set(\n",
    "        design_meta[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "    )\n",
    "    ==\n",
    "    {\n",
    "        \"AD\",\n",
    "        \"Control\",\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    set(\n",
    "        design_meta[\n",
    "            \"sex\"\n",
    "        ]\n",
    "    )\n",
    "    ==\n",
    "    {\n",
    "        \"Female\",\n",
    "        \"Male\",\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    set(\n",
    "        design_meta[\n",
    "            \"batch\"\n",
    "        ]\n",
    "    )\n",
    "    ==\n",
    "    {\n",
    "        \"1\",\n",
    "        \"2\",\n",
    "        \"3\",\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "def make_design_matrix(\n",
    "    df,\n",
    "    include_RIN=False,\n",
    "    include_PMI=False\n",
    "):\n",
    "\n",
    "\n",
    "    columns = [\n",
    "\n",
    "        np.ones(\n",
    "            len(\n",
    "                df\n",
    "            )\n",
    "        ),\n",
    "\n",
    "        df[\n",
    "            \"age\"\n",
    "        ]\n",
    "        .to_numpy(\n",
    "            dtype=float\n",
    "        ),\n",
    "\n",
    "        df[\n",
    "            \"sex\"\n",
    "        ]\n",
    "        .eq(\n",
    "            \"Male\"\n",
    "        )\n",
    "        .astype(float)\n",
    "        .to_numpy(),\n",
    "\n",
    "        df[\n",
    "            \"batch\"\n",
    "        ]\n",
    "        .eq(\n",
    "            \"2\"\n",
    "        )\n",
    "        .astype(float)\n",
    "        .to_numpy(),\n",
    "\n",
    "        df[\n",
    "            \"batch\"\n",
    "        ]\n",
    "        .eq(\n",
    "            \"3\"\n",
    "        )\n",
    "        .astype(float)\n",
    "        .to_numpy(),\n",
    "\n",
    "    ]\n",
    "\n",
    "\n",
    "    names = [\n",
    "\n",
    "        \"Intercept\",\n",
    "        \"age\",\n",
    "        \"sex_Male\",\n",
    "        \"batch_2\",\n",
    "        \"batch_3\",\n",
    "\n",
    "    ]\n",
    "\n",
    "\n",
    "    if include_RIN:\n",
    "\n",
    "        columns.append(\n",
    "\n",
    "            df[\n",
    "                \"RIN\"\n",
    "            ]\n",
    "            .to_numpy(\n",
    "                dtype=float\n",
    "            )\n",
    "\n",
    "        )\n",
    "\n",
    "        names.append(\n",
    "            \"RIN\"\n",
    "        )\n",
    "\n",
    "\n",
    "    if include_PMI:\n",
    "\n",
    "        columns.append(\n",
    "\n",
    "            df[\n",
    "                \"PMI\"\n",
    "            ]\n",
    "            .to_numpy(\n",
    "                dtype=float\n",
    "            )\n",
    "\n",
    "        )\n",
    "\n",
    "        names.append(\n",
    "            \"PMI\"\n",
    "        )\n",
    "\n",
    "\n",
    "    columns.append(\n",
    "\n",
    "        df[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        .eq(\n",
    "            \"AD\"\n",
    "        )\n",
    "        .astype(float)\n",
    "        .to_numpy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    names.append(\n",
    "        \"diagnosis_AD\"\n",
    "    )\n",
    "\n",
    "\n",
    "    X = np.column_stack(\n",
    "        columns\n",
    "    )\n",
    "\n",
    "\n",
    "    return (\n",
    "        X,\n",
    "        names\n",
    "    )\n",
    "\n",
    "\n",
    "X_primary, primary_names = (\n",
    "    make_design_matrix(\n",
    "        design_meta,\n",
    "        include_RIN=False,\n",
    "        include_PMI=False\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "X_RIN, RIN_names = (\n",
    "    make_design_matrix(\n",
    "        design_meta,\n",
    "        include_RIN=True,\n",
    "        include_PMI=False\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "PMI_meta = (\n",
    "\n",
    "    design_meta[\n",
    "        design_meta[\n",
    "            \"PMI\"\n",
    "        ]\n",
    "        .notna()\n",
    "    ]\n",
    "    .copy()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    PMI_meta\n",
    ") == 17\n",
    "\n",
    "\n",
    "assert (\n",
    "    PMI_meta[\n",
    "        \"diagnosis_binary\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    "    ==\n",
    "    {\n",
    "        \"AD\": 11,\n",
    "        \"Control\": 6,\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "X_PMI, PMI_names = (\n",
    "    make_design_matrix(\n",
    "        PMI_meta,\n",
    "        include_RIN=False,\n",
    "        include_PMI=True\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "primary_rank = int(\n",
    "    np.linalg.matrix_rank(\n",
    "        X_primary\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "RIN_rank = int(\n",
    "    np.linalg.matrix_rank(\n",
    "        X_RIN\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "PMI_rank = int(\n",
    "    np.linalg.matrix_rank(\n",
    "        X_PMI\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    primary_rank\n",
    "    ==\n",
    "    X_primary.shape[\n",
    "        1\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    RIN_rank\n",
    "    ==\n",
    "    X_RIN.shape[\n",
    "        1\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    PMI_rank\n",
    "    ==\n",
    "    X_PMI.shape[\n",
    "        1\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 16. STANDARDIZED CONDITION NUMBERS\n",
    "#\n",
    "# Diagnostic only.\n",
    "# Actual DE keeps original covariate scales.\n",
    "# ============================================================\n",
    "\n",
    "def zscore(\n",
    "    values\n",
    "):\n",
    "\n",
    "    values = np.asarray(\n",
    "        values,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "\n",
    "    sd = values.std(\n",
    "        ddof=0\n",
    "    )\n",
    "\n",
    "\n",
    "    assert sd > 0\n",
    "\n",
    "\n",
    "    return (\n",
    "\n",
    "        values\n",
    "        -\n",
    "        values.mean()\n",
    "\n",
    "    ) / sd\n",
    "\n",
    "\n",
    "def make_standardized_design(\n",
    "    df,\n",
    "    include_RIN=False,\n",
    "    include_PMI=False\n",
    "):\n",
    "\n",
    "\n",
    "    columns = [\n",
    "\n",
    "        np.ones(\n",
    "            len(\n",
    "                df\n",
    "            )\n",
    "        ),\n",
    "\n",
    "        zscore(\n",
    "            df[\n",
    "                \"age\"\n",
    "            ]\n",
    "        ),\n",
    "\n",
    "        df[\n",
    "            \"sex\"\n",
    "        ]\n",
    "        .eq(\n",
    "            \"Male\"\n",
    "        )\n",
    "        .astype(float)\n",
    "        .to_numpy(),\n",
    "\n",
    "        df[\n",
    "            \"batch\"\n",
    "        ]\n",
    "        .eq(\n",
    "            \"2\"\n",
    "        )\n",
    "        .astype(float)\n",
    "        .to_numpy(),\n",
    "\n",
    "        df[\n",
    "            \"batch\"\n",
    "        ]\n",
    "        .eq(\n",
    "            \"3\"\n",
    "        )\n",
    "        .astype(float)\n",
    "        .to_numpy(),\n",
    "\n",
    "    ]\n",
    "\n",
    "\n",
    "    if include_RIN:\n",
    "\n",
    "        columns.append(\n",
    "\n",
    "            zscore(\n",
    "                df[\n",
    "                    \"RIN\"\n",
    "                ]\n",
    "            )\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "    if include_PMI:\n",
    "\n",
    "        columns.append(\n",
    "\n",
    "            zscore(\n",
    "                df[\n",
    "                    \"PMI\"\n",
    "                ]\n",
    "            )\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "    columns.append(\n",
    "\n",
    "        df[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        .eq(\n",
    "            \"AD\"\n",
    "        )\n",
    "        .astype(float)\n",
    "        .to_numpy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    return np.column_stack(\n",
    "        columns\n",
    "    )\n",
    "\n",
    "\n",
    "primary_condition = float(\n",
    "\n",
    "    np.linalg.cond(\n",
    "\n",
    "        make_standardized_design(\n",
    "            design_meta\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "RIN_condition = float(\n",
    "\n",
    "    np.linalg.cond(\n",
    "\n",
    "        make_standardized_design(\n",
    "            design_meta,\n",
    "            include_RIN=True\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "PMI_condition = float(\n",
    "\n",
    "    np.linalg.cond(\n",
    "\n",
    "        make_standardized_design(\n",
    "            PMI_meta,\n",
    "            include_PMI=True\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"DESIGN AUDIT\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPRIMARY:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"~ age + sex + batch + diagnosis_binary\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Columns:\",\n",
    "    primary_names\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Rank:\",\n",
    "    primary_rank,\n",
    "    \"/\",\n",
    "    X_primary.shape[\n",
    "        1\n",
    "    ]\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Standardized condition number:\",\n",
    "    primary_condition\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nRIN SENSITIVITY:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"~ age + sex + batch + RIN + diagnosis_binary\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Rank:\",\n",
    "    RIN_rank,\n",
    "    \"/\",\n",
    "    X_RIN.shape[\n",
    "        1\n",
    "    ]\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Standardized condition number:\",\n",
    "    RIN_condition\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPMI COMPLETE-CASE SENSITIVITY:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"~ age + sex + batch + PMI + diagnosis_binary\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Donors:\",\n",
    "    len(\n",
    "        PMI_meta\n",
    "    ),\n",
    "    \"(11 AD / 6 Control)\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Rank:\",\n",
    "    PMI_rank,\n",
    "    \"/\",\n",
    "    X_PMI.shape[\n",
    "        1\n",
    "    ]\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Standardized condition number:\",\n",
    "    PMI_condition\n",
    ")\n",
    "\n",
    "\n",
    "# Hard-stop only for severe numerical instability.\n",
    "assert (\n",
    "    primary_condition\n",
    "    <\n",
    "    30\n",
    "), (\n",
    "    \"Primary design is poorly conditioned.\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    RIN_condition\n",
    "    <\n",
    "    30\n",
    "), (\n",
    "    \"RIN sensitivity design is poorly conditioned.\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    PMI_condition\n",
    "    <\n",
    "    30\n",
    "), (\n",
    "    \"PMI sensitivity design is poorly conditioned.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 17. AGE OVERLAP AUDIT\n",
    "# ============================================================\n",
    "\n",
    "AD_age = (\n",
    "\n",
    "    design_meta.loc[\n",
    "        design_meta[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        ==\n",
    "        \"AD\",\n",
    "        \"age\"\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "Control_age = (\n",
    "\n",
    "    design_meta.loc[\n",
    "        design_meta[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        ==\n",
    "        \"Control\",\n",
    "        \"age\"\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "common_age_min = float(\n",
    "\n",
    "    max(\n",
    "        AD_age.min(),\n",
    "        Control_age.min()\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "common_age_max = float(\n",
    "\n",
    "    min(\n",
    "        AD_age.max(),\n",
    "        Control_age.max()\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "age_overlap_meta = (\n",
    "\n",
    "    design_meta[\n",
    "        design_meta[\n",
    "            \"age\"\n",
    "        ]\n",
    "        .between(\n",
    "            common_age_min,\n",
    "            common_age_max,\n",
    "            inclusive=\"both\"\n",
    "        )\n",
    "    ]\n",
    "    .copy()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "age_overlap_counts = (\n",
    "\n",
    "    age_overlap_meta[\n",
    "        \"diagnosis_binary\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nCommon age support:\",\n",
    "    common_age_min,\n",
    "    \"to\",\n",
    "    common_age_max\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Age-overlap counts:\",\n",
    "    age_overlap_counts\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    age_overlap_counts\n",
    "    ==\n",
    "    {\n",
    "        \"AD\": 11,\n",
    "        \"Control\": 3,\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 18. SAVE PSEUDOBULK BUILD LOCK\n",
    "# ============================================================\n",
    "\n",
    "PSEUDOBULK_LOCK = {\n",
    "\n",
    "    \"dataset\":\n",
    "        \"GSE174367\",\n",
    "\n",
    "    \"created_utc\":\n",
    "        datetime.now(\n",
    "            timezone.utc\n",
    "        ).isoformat(),\n",
    "\n",
    "    \"status\":\n",
    "        \"AD_DISCOVERY_PSEUDOBULK_BUILT\",\n",
    "\n",
    "    \"biological_replicate\":\n",
    "        \"human_donor\",\n",
    "\n",
    "    \"source_matrix\":\n",
    "        \"official_10x_filtered_feature_bc_matrix_H5\",\n",
    "\n",
    "    \"matrix_orientation\":\n",
    "        \"features_by_cells_CSC\",\n",
    "\n",
    "    \"input_H5_cells\":\n",
    "        61770,\n",
    "\n",
    "    \"author_annotated_analysis_cells\":\n",
    "        61472,\n",
    "\n",
    "    \"target_primary_class_cells\":\n",
    "        int(\n",
    "            N_TARGET_CELLS\n",
    "        ),\n",
    "\n",
    "    \"target_cell_classes\":\n",
    "        TARGET_CLASSES,\n",
    "\n",
    "    \"minimum_nuclei_per_donor\":\n",
    "        50,\n",
    "\n",
    "    \"n_donors\":\n",
    "        18,\n",
    "\n",
    "    \"n_AD\":\n",
    "        11,\n",
    "\n",
    "    \"n_Control\":\n",
    "        7,\n",
    "\n",
    "    \"n_pseudobulk_groups\":\n",
    "        72,\n",
    "\n",
    "    \"UMI_conservation\":\n",
    "        True,\n",
    "\n",
    "    \"total_target_input_UMIs\":\n",
    "        int(\n",
    "            total_target_input_UMIs\n",
    "        ),\n",
    "\n",
    "    \"total_pseudobulk_output_UMIs\":\n",
    "        int(\n",
    "            total_pseudobulk_output_UMIs\n",
    "        ),\n",
    "\n",
    "    \"raw_pseudobulk_file\":\n",
    "        str(\n",
    "            PSEUDOBULK_PATH\n",
    "        ),\n",
    "\n",
    "    \"raw_pseudobulk_sha256\":\n",
    "        pseudobulk_sha256,\n",
    "\n",
    "    \"group_metadata\":\n",
    "        str(\n",
    "            GROUP_META_PATH\n",
    "        ),\n",
    "\n",
    "    \"differential_expression_performed\":\n",
    "        False,\n",
    "\n",
    "    \"AD_PD_convergence_performed\":\n",
    "        False,\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    PSEUDOBULK_LOCK_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        PSEUDOBULK_LOCK,\n",
    "        f,\n",
    "        indent=2\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 19. FREEZE FINAL AD DISCOVERY INFERENCE POLICY\n",
    "# ============================================================\n",
    "\n",
    "AD_DISCOVERY_POLICY = {\n",
    "\n",
    "    \"biological_replicate\":\n",
    "        \"human donor\",\n",
    "\n",
    "    \"primary_cell_classes\":\n",
    "        TARGET_CLASSES,\n",
    "\n",
    "    \"minimum_nuclei_per_donor\":\n",
    "        50,\n",
    "\n",
    "    \"primary_donor_cohort\": {\n",
    "\n",
    "        \"AD\":\n",
    "            11,\n",
    "\n",
    "        \"Control\":\n",
    "            7,\n",
    "\n",
    "        \"total\":\n",
    "            18,\n",
    "    },\n",
    "\n",
    "    \"primary_model\":\n",
    "        \"~ age + sex + batch + diagnosis_binary\",\n",
    "\n",
    "    \"primary_reference_levels\": {\n",
    "\n",
    "        \"diagnosis_binary\":\n",
    "            \"Control\",\n",
    "\n",
    "        \"sex\":\n",
    "            \"Female\",\n",
    "\n",
    "        \"batch\":\n",
    "            \"1\",\n",
    "    },\n",
    "\n",
    "    \"primary_contrast\":\n",
    "        \"AD_vs_Control\",\n",
    "\n",
    "    \"technical_sensitivity_RIN\": {\n",
    "\n",
    "        \"model\":\n",
    "            \"~ age + sex + batch + RIN + diagnosis_binary\",\n",
    "\n",
    "        \"donors\":\n",
    "            18,\n",
    "\n",
    "        \"reason\":\n",
    "            (\n",
    "                \"RIN is fully observed and is tested \"\n",
    "                \"as a technical robustness covariate.\"\n",
    "            ),\n",
    "    },\n",
    "\n",
    "    \"technical_sensitivity_PMI\": {\n",
    "\n",
    "        \"model\":\n",
    "            \"~ age + sex + batch + PMI + diagnosis_binary\",\n",
    "\n",
    "        \"complete_case_only\":\n",
    "            True,\n",
    "\n",
    "        \"donors\":\n",
    "            17,\n",
    "\n",
    "        \"AD\":\n",
    "            11,\n",
    "\n",
    "        \"Control\":\n",
    "            6,\n",
    "\n",
    "        \"reason\":\n",
    "            (\n",
    "                \"PMI is missing for one control donor; \"\n",
    "                \"therefore PMI is not used in the primary model.\"\n",
    "            ),\n",
    "    },\n",
    "\n",
    "    \"age_overlap_sensitivity\":\n",
    "        False,\n",
    "\n",
    "    \"age_overlap_reason\":\n",
    "        (\n",
    "            \"Common observed age support retains \"\n",
    "            \"11 AD but only 3 controls, so an \"\n",
    "            \"age-restricted cohort is not predeclared.\"\n",
    "        ),\n",
    "\n",
    "    \"pathology_covariates_in_case_control_DE\":\n",
    "        False,\n",
    "\n",
    "    \"pathology_reason\":\n",
    "        (\n",
    "            \"Tangle.Stage and Plaque.Stage are disease/pathology \"\n",
    "            \"variables and are not adjusted in AD-vs-Control DE.\"\n",
    "        ),\n",    "\n",
    "    \"gene_filter\":\n",
    "        (\n",
    "            \"CPM >= 1 in at least 7 of 18 donors \"\n",
    "            \"within each cell class\"\n",
    "        ),\n",
    "\n",
    "    \"gene_filter_is_disease_blind\":\n",
    "        True,\n",
    "\n",
    "    \"CPM_denominator\":\n",
    "        (\n",
    "            \"raw Gene Expression UMI library size \"\n",
    "            \"within each donor×cell-class pseudobulk\"\n",
    "        ),\n",
    "\n",
    "    \"mitochondrial_policy\":\n",
    "        (\n",
    "            \"remove expression-passing Gene Expression \"\n",
    "            \"features whose gene symbol begins MT-\"\n",
    "        ),\n",
    "\n",
    "    \"feature_identifier_for_DE\":\n",
    "        \"Ensembl_gene_id\",\n",
    "\n",
    "    \"duplicate_gene_symbol_policy\":\n",
    "        (\n",
    "            \"retain duplicate-symbol Ensembl features in DE; \"\n",
    "            \"direct cross-dataset symbol matching later uses \"\n",
    "            \"unambiguous symbols only\"\n",
    "        ),\n",
    "\n",
    "    \"multiple_testing\":\n",
    "        \"Benjamini-Hochberg within each cell class\",\n",
    "\n",
    "    \"FDR_threshold\":\n",
    "        0.05,\n",
    "\n",
    "    \"all_tested_genes_retained\":\n",
    "        True,\n",
    "\n",
    "    \"AD_PD_convergence_allowed\":\n",
    "        False,\n",
    "\n",
    "    \"AD_PD_convergence_unlock_condition\":\n",
    "        (\n",
    "            \"AD discovery effects and independent AD replication \"\n",
    "            \"effects must both be frozen first\"\n",
    "        ),\n",
    "}\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 20. FINAL PRE-DE LOCK\n",
    "# ============================================================\n",
    "\n",
    "PRE_DE_LOCK = {\n",
    "\n",
    "    \"dataset\":\n",
    "        \"GSE174367\",\n",
    "\n",
    "    \"created_utc\":\n",
    "        datetime.now(\n",
    "            timezone.utc\n",
    "        ).isoformat(),\n",
    "\n",
    "    \"status\":\n",
    "        \"AD_DISCOVERY_PRE_DE_LOCK\",\n",
    "\n",
    "    \"role\":\n",
    "        \"AD_brain_discovery\",\n",
    "\n",
    "    \"upstream_data_audit\":\n",
    "        str(\n",
    "            AUDIT_LOCK_PATH\n",
    "        ),\n",
    "\n",
    "    \"pseudobulk_build_lock\":\n",
    "        str(\n",
    "            PSEUDOBULK_LOCK_PATH\n",
    "        ),\n",
    "\n",
    "    \"analysis_population\": {\n",
    "\n",
    "        \"annotated_nuclei\":\n",
    "            61472,\n",
    "\n",
    "        \"target_class_nuclei\":\n",
