   "source": [
    "# Source analysis cell: 23\n",
    "# ============================================================\n",
    "# STEP 12A — SENSITIVITY OUTPUT AUDIT + ROBUSTNESS FREEZE PREVIEW\n",
    "#\n",
    "# NO DIFFERENTIAL EXPRESSION IS RUN HERE.\n",
    "#\n",
    "# PURPOSE\n",
    "# -------\n",
    "# 1. Load the completed STEP 12 outputs from Drive.\n",
    "# 2. Verify the STEP 12 run lock.\n",
    "# 3. Verify hashes of every sensitivity result file.\n",
    "# 4. Verify frozen gene universes were unchanged.\n",
    "# 5. Recalculate FDR counts independently.\n",
    "# 6. Recalculate primary-vs-sensitivity effect concordance.\n",
    "# 7. Determine how the PRIMARY FDR genes behave in:\n",
    "#\n",
    "#       A. technical model:\n",
    "#          ~ age + sex + PMI + RIN + diagnosis\n",
    "#\n",
    "#       B. age-overlap model:\n",
    "#          57–93 y, 13 PD / 13 Control\n",
    "#\n",
    "# 8. Save a gene-level robustness table.\n",
    "#\n",
    "# IMPORTANT\n",
    "# ---------\n",
    "# Primary DE remains the primary analysis.\n",
    "#\n",
    "# Sensitivities are SUPPORTING analyses.\n",
    "#\n",
    "# We do NOT redefine significance after seeing these results.\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import json\n",
    "import hashlib\n",
    "\n",
    "from scipy.stats import (\n",
    "    pearsonr,\n",
    "    spearmanr,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = ROOT / \"locks\"\n",
    "\n",
    "PRIMARY_ROOT = (\n",
    "    ROOT /\n",
    "    \"PD_primary_DE\"\n",
    ")\n",
    "\n",
    "SENS_ROOT = (\n",
    "    ROOT /\n",
    "    \"PD_primary_sensitivity\"\n",
    ")\n",
    "\n",
    "\n",
    "primary_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_PRIMARY_PD_DE_RUN_v1.json\"\n",
    ")\n",
    "\n",
    "sensitivity_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_PRIMARY_PD_SENSITIVITY_RUN_v1.json\"\n",
    ")\n",
    "\n",
    "pre_de_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_PRE_DE_ANALYSIS_LOCK_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "summary_path = (\n",
    "    SENS_ROOT /\n",
    "    \"GSE243639_PRIMARY_PD_SENSITIVITY_SUMMARY_v1.csv\"\n",
    ")\n",
    "\n",
    "concordance_path = (\n",
    "    SENS_ROOT /\n",
    "    \"GSE243639_PRIMARY_PD_SENSITIVITY_CONCORDANCE_v1.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "audit_output_path = (\n",
    "    SENS_ROOT /\n",
    "    \"GSE243639_PRIMARY_PD_SENSITIVITY_AUDIT_v1.csv\"\n",
    ")\n",
    "\n",
    "robustness_output_path = (\n",
    "    SENS_ROOT /\n",
    "    \"GSE243639_PRIMARY_FDR_GENE_ROBUSTNESS_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "final_audit_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_PRIMARY_PD_SENSITIVITY_AUDIT_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "\n",
    "    primary_lock_path,\n",
    "    sensitivity_lock_path,\n",
    "    pre_de_lock_path,\n",
    "    summary_path,\n",
    "    concordance_path,\n",
    "\n",
    "]:\n",
    "\n",
    "    assert path.exists(), (\n",
    "        f\"Missing required file: {path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. LOAD LOCKS\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    primary_lock_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    primary_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    sensitivity_lock_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    sensitivity_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    pre_de_lock_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    pre_de_lock = json.load(f)\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. VERIFY LOCK STATES\n",
    "# ============================================================\n",
    "\n",
    "assert (\n",
    "    primary_lock[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"PRIMARY_DE_COMPLETE\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    sensitivity_lock[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"PRIMARY_SENSITIVITY_COMPLETE\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    sensitivity_lock[\n",
    "        \"gene_universes_refiltered\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    sensitivity_lock[\n",
    "        \"sensitivity_analyses_performed\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    primary_lock[\n",
    "        \"secondary_cell_classes_analyzed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 12 RUN LOCK: PASS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. PRIMARY CLASSES\n",
    "# ============================================================\n",
    "\n",
    "PRIMARY_CLASSES = [\n",
    "\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "EXPECTED_UNIVERSES = {\n",
    "\n",
    "    \"Astro\":\n",
    "        16942,\n",
    "\n",
    "    \"Micro\":\n",
    "        16050,\n",
    "\n",
    "    \"OPC\":\n",
    "        16268,\n",
    "\n",
    "    \"Oligo\":\n",
    "        15957,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. LOAD SAVED STEP 12 TABLES\n",
    "# ============================================================\n",
    "\n",
    "saved_summary = pd.read_csv(\n",
    "    summary_path\n",
    ")\n",
    "\n",
    "saved_concordance = pd.read_csv(\n",
    "    concordance_path\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    saved_summary[\n",
    "        \"cell_type\"\n",
    "    ].tolist()\n",
    "    ==\n",
    "    PRIMARY_CLASSES\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    saved_concordance[\n",
    "        \"cell_type\"\n",
    "    ].tolist()\n",
    "    ==\n",
    "    PRIMARY_CLASSES\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSaved STEP 12 FDR summary:\"\n",
    ")\n",
    "\n",
    "display(\n",
    "    saved_summary\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSaved STEP 12 concordance summary:\"\n",
    ")\n",
    "\n",
    "display(\n",
    "    saved_concordance\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. HELPERS\n",
    "# ============================================================\n",
    "\n",
    "def sha256_file(\n",
    "    path,\n",
    "    block_size=1024 * 1024\n",
    "):\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\"\n",
    "    ) as f:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            block = f.read(\n",
    "                block_size\n",
    "            )\n",
    "\n",
    "            if not block:\n",
    "\n",
    "                break\n",
    "\n",
    "            h.update(\n",
    "                block\n",
    "            )\n",
    "\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "def safe_pearson(\n",
    "    x,\n",
    "    y\n",
    "):\n",
    "\n",
    "    x = np.asarray(\n",
    "        x,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "    y = np.asarray(\n",
    "        y,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "    mask = (\n",
    "        np.isfinite(x)\n",
    "        &\n",
    "        np.isfinite(y)\n",
    "    )\n",
    "\n",
    "\n",
    "    if mask.sum() < 3:\n",
    "\n",
    "        return np.nan\n",
    "\n",
    "\n",
    "    return float(\n",
    "        pearsonr(\n",
    "            x[\n",
    "                mask\n",
    "            ],\n",
    "            y[\n",
    "                mask\n",
    "            ]\n",
    "        ).statistic\n",
    "    )\n",
    "\n",
    "\n",
    "def safe_spearman(\n",
    "    x,\n",
    "    y\n",
    "):\n",
    "\n",
    "    x = np.asarray(\n",
    "        x,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "    y = np.asarray(\n",
    "        y,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "    mask = (\n",
    "        np.isfinite(x)\n",
    "        &\n",
    "        np.isfinite(y)\n",
    "    )\n",
    "\n",
    "\n",
    "    if mask.sum() < 3:\n",
    "\n",
    "        return np.nan\n",
    "\n",
    "\n",
    "    return float(\n",
    "        spearmanr(\n",
    "            x[\n",
    "                mask\n",
    "            ],\n",
    "            y[\n",
    "                mask\n",
    "            ]\n",
    "        ).statistic\n",
    "    )\n",
    "\n",
    "\n",
    "def fdr_mask(\n",
    "    df\n",
    "):\n",
    "\n",
    "    return (\n",
    "\n",
    "        np.isfinite(\n",
    "            df[\n",
    "                \"padj\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            df[\n",
    "                \"padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. RESULT STORAGE\n",
    "# ============================================================\n",
    "\n",
    "audit_rows = []\n",
    "\n",
    "robustness_tables = []\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. AUDIT EACH PRIMARY CELL CLASS\n",
    "# ============================================================\n",
    "\n",
    "for cell_type in PRIMARY_CLASSES:\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\n\"\n",
    "        +\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        cell_type\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 7.1 LOCK RECORDS\n",
    "    # ========================================================\n",
    "\n",
    "    primary_record = (\n",
    "\n",
    "        primary_lock[\n",
    "            \"cell_class_results\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    sensitivity_record = (\n",
    "\n",
    "        sensitivity_lock[\n",
    "            \"cell_class_results\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    technical_record = (\n",
    "\n",
    "        sensitivity_record[\n",
    "            \"technical_sensitivity\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    overlap_record = (\n",
    "\n",
    "        sensitivity_record[\n",
    "            \"age_overlap_sensitivity\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 7.2 RESULT PATHS\n",
    "    # ========================================================\n",
    "\n",
    "    primary_path = Path(\n",
    "        primary_record[\n",
    "            \"all_gene_results\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    technical_path = Path(\n",
    "        technical_record[\n",
    "            \"all_gene_results\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    overlap_path = Path(\n",
    "        overlap_record[\n",
    "            \"all_gene_results\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    for path in [\n",
    "\n",
    "        primary_path,\n",
    "        technical_path,\n",
    "        overlap_path,\n",
    "\n",
    "    ]:\n",
    "\n",
    "        assert path.exists(), (\n",
    "            f\"Missing result: {path}\"\n",
    "        )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 7.3 HASH VERIFICATION\n",
    "    # ========================================================\n",
    "\n",
    "    assert (\n",
    "        sha256_file(\n",
    "            primary_path\n",
    "        )\n",
    "        ==\n",
    "        primary_record[\n",
    "            \"all_gene_results_sha256\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        sha256_file(\n",
    "            technical_path\n",
    "        )\n",
    "        ==\n",
    "        technical_record[\n",
    "            \"all_gene_results_sha256\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        sha256_file(\n",
    "            overlap_path\n",
    "        )\n",
    "        ==\n",
    "        overlap_record[\n",
    "            \"all_gene_results_sha256\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"All three result hashes: PASS\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 7.4 LOAD RESULTS\n",
    "    # ========================================================\n",
    "\n",
    "    primary = pd.read_csv(\n",
    "        primary_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    technical = pd.read_csv(\n",
    "        technical_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    overlap = pd.read_csv(\n",
    "        overlap_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    expected_n = (\n",
    "        EXPECTED_UNIVERSES[\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        primary\n",
    "    ) == expected_n\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        technical\n",
    "    ) == expected_n\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        overlap\n",
    "    ) == expected_n\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 7.5 GENE-ID INTEGRITY\n",
    "    # ========================================================\n",
    "\n",
    "    assert (\n",
    "        primary[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .is_unique\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        technical[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .is_unique\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        overlap[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .is_unique\n",
    "    )\n",
    "\n",
    "\n",
    "    primary_genes = (\n",
    "\n",
    "        primary[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    technical_genes = (\n",
    "\n",
    "        technical[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    overlap_genes = (\n",
    "\n",
    "        overlap[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        primary_genes\n",
    "        ==\n",
    "        technical_genes\n",
    "        ==\n",
    "        overlap_genes\n",
    "    )\n",
    "\n",
    "\n",
    "    # Verify against STEP 10C universe\n",
    "    universe_path = Path(\n",
    "\n",
    "        pre_de_lock[\n",
    "            \"cell_class_universes\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ][\n",
    "            \"gene_universe_file\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    universe = pd.read_csv(\n",
    "        universe_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    frozen_genes = (\n",
    "\n",
    "        universe[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        primary_genes\n",
    "        ==\n",
    "        frozen_genes\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Frozen gene universe identity: PASS\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 7.6 MERGE EFFECT VECTORS\n",
    "    # ========================================================\n",
    "\n",
    "    merged = (\n",
    "\n",
    "        primary[\n",
    "            [\n",
    "                \"gene_symbol\",\n",
    "                \"baseMean\",\n",
    "                \"log2FoldChange\",\n",
    "                \"stat\",\n",
    "                \"pvalue\",\n",
    "                \"padj\",\n",
    "            ]\n",
    "        ]\n",
    "        .rename(\n",
    "            columns={\n",
    "\n",
    "                \"baseMean\":\n",
    "                    \"primary_baseMean\",\n",
    "\n",
    "                \"log2FoldChange\":\n",
    "                    \"primary_LFC\",\n",
    "\n",
    "                \"stat\":\n",
    "                    \"primary_Wald\",\n",
    "\n",
    "                \"pvalue\":\n",
    "                    \"primary_p\",\n",
    "\n",
    "                \"padj\":\n",
    "                    \"primary_padj\",\n",
    "\n",
    "            }\n",
    "        )\n",
    "\n",
    "        .merge(\n",
    "\n",
    "            technical[\n",
    "                [\n",
    "                    \"gene_symbol\",\n",
    "                    \"baseMean\",\n",
    "                    \"log2FoldChange\",\n",
    "                    \"stat\",\n",
    "                    \"pvalue\",\n",
    "                    \"padj\",\n",
    "                ]\n",
    "            ]\n",
    "            .rename(\n",
    "                columns={\n",
    "\n",
    "                    \"baseMean\":\n",
    "                        \"technical_baseMean\",\n",
    "\n",
    "                    \"log2FoldChange\":\n",
    "                        \"technical_LFC\",\n",
    "\n",
    "                    \"stat\":\n",
    "                        \"technical_Wald\",\n",
    "\n",
    "                    \"pvalue\":\n",
    "                        \"technical_p\",\n",
    "\n",
    "                    \"padj\":\n",
    "                        \"technical_padj\",\n",
    "\n",
    "                }\n",
    "            ),\n",
    "\n",
    "            on=\"gene_symbol\",\n",
    "\n",
    "            validate=\"one_to_one\",\n",
    "\n",
    "        )\n",
    "\n",
    "        .merge(\n",
    "\n",
    "            overlap[\n",
    "                [\n",
    "                    \"gene_symbol\",\n",
    "                    \"baseMean\",\n",
    "                    \"log2FoldChange\",\n",
    "                    \"stat\",\n",
    "                    \"pvalue\",\n",
    "                    \"padj\",\n",
    "                ]\n",    "            ]\n",
    "            .rename(\n",
    "                columns={\n",
    "\n",
    "                    \"baseMean\":\n",
    "                        \"overlap_baseMean\",\n",
    "\n",
    "                    \"log2FoldChange\":\n",
    "                        \"overlap_LFC\",\n",
    "\n",
    "                    \"stat\":\n",
    "                        \"overlap_Wald\",\n",
    "\n",
    "                    \"pvalue\":\n",
    "                        \"overlap_p\",\n",
    "\n",
    "                    \"padj\":\n",
    "                        \"overlap_padj\",\n",
    "\n",
    "                }\n",
    "            ),\n",
    "\n",
    "            on=\"gene_symbol\",\n",
    "\n",
    "            validate=\"one_to_one\",\n",
    "\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        merged\n",
    "    ) == expected_n\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 7.7 INDEPENDENT FDR COUNTS\n",
    "    # ========================================================\n",
    "\n",
    "    primary_sig = (\n",
    "\n",
    "        np.isfinite(\n",
    "            merged[\n",
    "                \"primary_padj\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            merged[\n",
    "                \"primary_padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    technical_sig = (\n",
    "\n",
    "        np.isfinite(\n",
    "            merged[\n",
    "                \"technical_padj\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            merged[\n",
    "                \"technical_padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    overlap_sig = (\n",
    "\n",
    "        np.isfinite(\n",
    "            merged[\n",
    "                \"overlap_padj\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            merged[\n",
    "                \"overlap_padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_primary = int(\n",
    "        primary_sig.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_technical = int(\n",
    "        technical_sig.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_overlap = int(\n",
    "        overlap_sig.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 7.8 VERIFY AGAINST SAVED SUMMARY\n",
    "    # ========================================================\n",
    "\n",
    "    saved_row = (\n",
    "\n",
    "        saved_summary[\n",
    "            saved_summary[\n",
    "                \"cell_type\"\n",
    "            ]\n",
    "            ==\n",
    "            cell_type\n",
    "        ]\n",
    "        .iloc[\n",
    "            0\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_primary\n",
    "        ==\n",
    "        int(\n",
    "            saved_row[\n",
    "                \"primary_FDR\"\n",
    "            ]\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_technical\n",
    "        ==\n",
    "        int(\n",
    "            saved_row[\n",
    "                \"technical_FDR\"\n",
    "            ]\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_overlap\n",
    "        ==\n",
    "        int(\n",
    "            saved_row[\n",
    "                \"age_overlap_FDR\"\n",
    "            ]\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Saved FDR counts independently verified: PASS\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 7.9 ALL-GENE EFFECT CONCORDANCE\n",
    "    # ========================================================\n",
    "\n",
    "    technical_lfc_pearson = (\n",
    "        safe_pearson(\n",
    "\n",
    "            merged[\n",
    "                \"primary_LFC\"\n",
    "            ],\n",
    "\n",
    "            merged[\n",
    "                \"technical_LFC\"\n",
    "            ],\n",
    "\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    technical_lfc_spearman = (\n",
    "        safe_spearman(\n",
    "\n",
    "            merged[\n",
    "                \"primary_LFC\"\n",
    "            ],\n",
    "\n",
    "            merged[\n",
    "                \"technical_LFC\"\n",
    "            ],\n",
    "\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    technical_wald_spearman = (\n",
    "        safe_spearman(\n",
    "\n",
    "            merged[\n",
    "                \"primary_Wald\"\n",
    "            ],\n",
    "\n",
    "            merged[\n",
    "                \"technical_Wald\"\n",
    "            ],\n",
    "\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    overlap_lfc_pearson = (\n",
    "        safe_pearson(\n",
    "\n",
    "            merged[\n",
    "                \"primary_LFC\"\n",
    "            ],\n",
    "\n",
    "            merged[\n",
    "                \"overlap_LFC\"\n",
    "            ],\n",
    "\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    overlap_lfc_spearman = (\n",
    "        safe_spearman(\n",
    "\n",
    "            merged[\n",
    "                \"primary_LFC\"\n",
    "            ],\n",
    "\n",
    "            merged[\n",
    "                \"overlap_LFC\"\n",
    "            ],\n",
    "\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    overlap_wald_spearman = (\n",
    "        safe_spearman(\n",
    "\n",
    "            merged[\n",
    "                \"primary_Wald\"\n",
    "            ],\n",
    "\n",
    "            merged[\n",
    "                \"overlap_Wald\"\n",
    "            ],\n",
    "\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 7.10 PRIMARY-FDR GENE ROBUSTNESS\n",
    "    # ========================================================\n",
    "\n",
    "    primary_hits = (\n",
    "\n",
    "        merged.loc[\n",
    "            primary_sig\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        primary_hits\n",
    "    ) == n_primary\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Same direction\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    primary_hits[\n",
    "        \"technical_same_direction\"\n",
    "    ] = (\n",
    "\n",
    "        np.sign(\n",
    "            primary_hits[\n",
    "                \"primary_LFC\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        ==\n",
    "\n",
    "        np.sign(\n",
    "            primary_hits[\n",
    "                \"technical_LFC\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    primary_hits[\n",
    "        \"overlap_same_direction\"\n",
    "    ] = (\n",
    "\n",
    "        np.sign(\n",
    "            primary_hits[\n",
    "                \"primary_LFC\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        ==\n",
    "\n",
    "        np.sign(\n",
    "            primary_hits[\n",
    "                \"overlap_LFC\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    primary_hits[\n",
    "        \"same_direction_both_sensitivities\"\n",
    "    ] = (\n",
    "\n",
    "        primary_hits[\n",
    "            \"technical_same_direction\"\n",
    "        ]\n",
    "\n",
    "        &\n",
    "\n",
    "        primary_hits[\n",
    "            \"overlap_same_direction\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Nominal support\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    primary_hits[\n",
    "        \"technical_nominal_p_lt_0_05\"\n",
    "    ] = (\n",
    "\n",
    "        np.isfinite(\n",
    "            primary_hits[\n",
    "                \"technical_p\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            primary_hits[\n",
    "                \"technical_p\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    primary_hits[\n",
    "        \"overlap_nominal_p_lt_0_05\"\n",
    "    ] = (\n",
    "\n",
    "        np.isfinite(\n",
    "            primary_hits[\n",
    "                \"overlap_p\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            primary_hits[\n",
    "                \"overlap_p\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    primary_hits[\n",
    "        \"nominal_support_both_sensitivities\"\n",
    "    ] = (\n",
    "\n",
    "        primary_hits[\n",
    "            \"technical_nominal_p_lt_0_05\"\n",
    "        ]\n",
    "\n",
    "        &\n",
    "\n",
    "        primary_hits[\n",
    "            \"overlap_nominal_p_lt_0_05\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # FDR support\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    primary_hits[\n",
    "        \"technical_FDR_lt_0_05\"\n",
    "    ] = (\n",
    "\n",
    "        np.isfinite(\n",
    "            primary_hits[\n",
    "                \"technical_padj\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            primary_hits[\n",
    "                \"technical_padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    primary_hits[\n",
    "        \"overlap_FDR_lt_0_05\"\n",
    "    ] = (\n",
    "\n",
    "        np.isfinite(\n",
    "            primary_hits[\n",
    "                \"overlap_padj\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            primary_hits[\n",
    "                \"overlap_padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    primary_hits[\n",
    "        \"FDR_support_both_sensitivities\"\n",
    "    ] = (\n",
    "\n",
    "        primary_hits[\n",
    "            \"technical_FDR_lt_0_05\"\n",
    "        ]\n",
    "\n",
    "        &\n",
    "\n",
    "        primary_hits[\n",
    "            \"overlap_FDR_lt_0_05\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Useful descriptive robustness category\n",
    "    #\n",
    "    # NOT a new significance definition.\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    primary_hits[\n",
    "        \"dual_sensitivity_supported\"\n",
    "    ] = (\n",
    "\n",
    "        primary_hits[\n",
    "            \"same_direction_both_sensitivities\"\n",
    "        ]\n",
    "\n",
    "        &\n",
    "\n",
    "        primary_hits[\n",
    "            \"nominal_support_both_sensitivities\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    primary_hits.insert(\n",
    "        0,\n",
    "        \"cell_type\",\n",
    "        cell_type\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 7.11 ROBUSTNESS COUNTS\n",
    "    # ========================================================\n",
    "\n",
    "    n_same_direction_both = int(\n",
    "\n",
    "        primary_hits[\n",
    "            \"same_direction_both_sensitivities\"\n",
    "        ].sum()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_nominal_both = int(\n",
    "\n",
    "        primary_hits[\n",
    "            \"nominal_support_both_sensitivities\"\n",
    "        ].sum()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_fdr_both = int(\n",
    "\n",
    "        primary_hits[\n",
    "            \"FDR_support_both_sensitivities\"\n",
    "        ].sum()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_dual_supported = int(\n",
    "\n",
    "        primary_hits[\n",
    "            \"dual_sensitivity_supported\"\n",
    "        ].sum()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 7.12 SAVE GENE-LEVEL TABLE\n",
    "    # ========================================================\n",
    "\n",
    "    robustness_tables.append(\n",
    "        primary_hits\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 7.13 AUDIT ROW\n",
    "    # ========================================================\n",
    "\n",
    "    audit_rows.append({\n",
    "\n",
    "        \"cell_type\":\n",
    "            cell_type,\n",
    "\n",
    "        \"frozen_genes\":\n",
    "            expected_n,\n",
    "\n",
    "        \"primary_FDR\":\n",
    "            n_primary,\n",
    "\n",
    "        \"technical_FDR\":\n",
    "            n_technical,\n",
    "\n",
    "        \"age_overlap_FDR\":\n",
    "            n_overlap,\n",
    "\n",
    "        \"technical_LFC_pearson\":\n",
    "            technical_lfc_pearson,\n",
    "\n",
    "        \"technical_LFC_spearman\":\n",
    "            technical_lfc_spearman,\n",
    "\n",
    "        \"technical_Wald_spearman\":\n",
    "            technical_wald_spearman,\n",
    "\n",
    "        \"age_overlap_LFC_pearson\":\n",
    "            overlap_lfc_pearson,\n",
    "\n",
    "        \"age_overlap_LFC_spearman\":\n",
    "            overlap_lfc_spearman,\n",
    "\n",
    "        \"age_overlap_Wald_spearman\":\n",
    "            overlap_wald_spearman,\n",
    "\n",
    "        \"primary_hits_same_direction_both\":\n",
    "            n_same_direction_both,\n",
    "\n",
    "        \"primary_hits_nominal_p_lt_0.05_both\":\n",
    "            n_nominal_both,\n",
    "\n",
    "        \"primary_hits_FDR_lt_0.05_both\":\n",
    "            n_fdr_both,\n",
    "\n",
    "        \"primary_hits_dual_sensitivity_supported\":\n",
    "            n_dual_supported,\n",
    "\n",
    "        \"hashes_verified\":\n",
    "            True,\n",
    "\n",
    "        \"gene_universe_verified\":\n",
    "            True,\n",
    "\n",
    "    })\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 7.14 CELL-CLASS REPORT\n",
    "    # ========================================================\n",
    "\n",
    "    print(\n",
    "        \"\\nFDR COUNTS\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Primary:\",\n",
    "        n_primary\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  + PMI/RIN:\",\n",
    "        n_technical\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Age-overlap:\",\n",
    "        n_overlap\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nALL-GENE EFFECT CONCORDANCE\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Technical LFC Pearson:\",\n",
    "        technical_lfc_pearson\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Technical LFC Spearman:\",\n",
    "        technical_lfc_spearman\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Technical Wald Spearman:\",\n",
    "        technical_wald_spearman\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Age-overlap LFC Pearson:\",\n",
    "        overlap_lfc_pearson\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Age-overlap LFC Spearman:\",\n",
    "        overlap_lfc_spearman\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Age-overlap Wald Spearman:\",\n",
    "        overlap_wald_spearman\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nPRIMARY FDR HIT ROBUSTNESS\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Same direction in BOTH sensitivities:\",\n",
    "        f\"{n_same_direction_both}/{n_primary}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Nominal p<0.05 in BOTH sensitivities:\",\n",
    "        f\"{n_nominal_both}/{n_primary}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  FDR<0.05 in BOTH sensitivities:\",\n",
    "        f\"{n_fdr_both}/{n_primary}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Same direction + nominal support in BOTH:\",\n",
    "        f\"{n_dual_supported}/{n_primary}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    if n_primary > 0:\n",
    "\n",
    "        print(\n",
    "            \"\\nPRIMARY FDR GENE ROBUSTNESS TABLE\"\n",
    "        )\n",
    "\n",
    "        display(\n",
    "\n",
    "            primary_hits[\n",
    "                [\n",
    "                    \"gene_symbol\",\n",
    "\n",
    "                    \"primary_LFC\",\n",
    "                    \"primary_padj\",\n",
    "\n",
    "                    \"technical_LFC\",\n",
    "                    \"technical_p\",\n",
    "                    \"technical_padj\",\n",
    "\n",
    "                    \"overlap_LFC\",\n",
    "                    \"overlap_p\",\n",
    "                    \"overlap_padj\",\n",
    "\n",
    "                    \"same_direction_both_sensitivities\",\n",
    "\n",
    "                    \"nominal_support_both_sensitivities\",\n",
    "\n",
    "                    \"FDR_support_both_sensitivities\",\n",
    "\n",
    "                    \"dual_sensitivity_supported\",\n",
    "                ]\n",
    "            ]\n",
    "            .sort_values(\n",
    "                [\n",
    "                    \"dual_sensitivity_supported\",\n",
    "                    \"primary_padj\",\n",
    "                ],\n",
    "                ascending=[\n",
    "                    False,\n",
    "                    True,\n",
    "                ]\n",
    "            )\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. COMBINE / SAVE AUDIT\n",
    "# ============================================================\n",
    "\n",
    "audit = pd.DataFrame(\n",
    "    audit_rows\n",
    ")\n",
    "\n",
    "\n",
    "audit[\n",
    "    \"cell_type\"\n",
    "] = pd.Categorical(\n",
    "\n",
    "    audit[\n",
    "        \"cell_type\"\n",
    "    ],\n",
    "\n",
    "    categories=\n",
    "        PRIMARY_CLASSES,\n",
    "\n",
    "    ordered=True,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "audit = (\n",
    "\n",
    "    audit\n",
    "    .sort_values(\n",
    "        \"cell_type\"\n",
    "    )\n",
    "    .reset_index(\n",
    "        drop=True\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "audit[\n",
    "    \"cell_type\"\n",
    "] = (\n",
    "    audit[\n",
    "        \"cell_type\"\n",
    "    ]\n",
    "    .astype(str)\n",
    ")\n",
    "\n",
    "\n",
    "audit.to_csv(\n",
    "    audit_output_path,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. COMBINE GENE-LEVEL ROBUSTNESS TABLE\n",
    "# ============================================================\n",
    "\n",
    "if len(\n",
    "    robustness_tables\n",
    ") > 0:\n",
    "\n",
    "    robustness = pd.concat(\n",
    "        robustness_tables,\n",
    "        axis=0,\n",
    "        ignore_index=True\n",
    "    )\n",
    "\n",
    "else:\n",
    "\n",
    "    robustness = pd.DataFrame()\n",
    "\n",
    "\n",
    "robustness.to_csv(\n",
    "    robustness_output_path,\n",
    "    index=False,\n",
    "    compression={\n",
    "        \"method\":\n",
    "            \"gzip\",\n",
    "\n",
    "        \"compresslevel\":\n",
    "            6,\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. FINAL AUDIT LOCK\n",
    "# ============================================================\n",
    "\n",
    "AUDIT_LOCK = {\n",
    "\n",
    "    \"dataset\":\n",
    "        \"GSE243639\",\n",
    "\n",
    "    \"created_utc\":\n",
    "        datetime.now(\n",
    "            timezone.utc\n",
    "        ).isoformat(),\n",
    "\n",
    "    \"status\":\n",
    "        \"PRIMARY_SENSITIVITY_AUDIT_COMPLETE\",\n",
    "\n",
    "    \"primary_cell_classes\":\n",
    "        PRIMARY_CLASSES,\n",
    "\n",
    "    \"primary_analysis\":\n",
    "        \"~ age + sex + diagnosis_binary\",\n",
    "\n",
    "    \"technical_sensitivity\":\n",
    "        (\n",
    "            \"~ age + sex + PMI + RIN \"\n",
    "            \"+ diagnosis_binary\"\n",
    "        ),\n",
    "\n",
    "    \"age_overlap_sensitivity\": {\n",
    "\n",
    "        \"ages\":\n",
    "            \"57_to_93\",\n",
    "\n",
    "        \"n_PD\":\n",
    "            13,\n",
    "\n",
    "        \"n_Control\":\n",
    "            13,\n",
    "\n",
    "    },\n",
    "\n",
    "    \"frozen_gene_universes_reused\":\n",
    "        True,\n",
    "\n",
    "    \"gene_refiltering\":\n",
    "        False,\n",
    "\n",
    "    \"result_hashes_verified\":\n",
    "        True,\n",
    "\n",
    "    \"audit_table\":\n",
    "        str(\n",
    "            audit_output_path\n",
    "        ),\n",
    "\n",
    "    \"primary_FDR_gene_robustness_table\":\n",
    "        str(\n",
    "            robustness_output_path\n",
    "        ),\n",
    "\n",
    "    \"note\": (\n",
    "        \"dual_sensitivity_supported is descriptive only: \"\n",
    "        \"primary FDR significance remains the primary inference.\"\n",
    "    ),\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    final_audit_lock_path,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        AUDIT_LOCK,\n",
    "        f,\n",
    "        indent=2\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. FINAL REPORT\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 12A PASSED — SENSITIVITY RESULTS VERIFIED\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nROBUSTNESS SUMMARY\"\n",
    ")\n",
    "\n",
    "display(\n",
    "    audit\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nAudit table:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    audit_output_path\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPrimary FDR gene robustness table:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    robustness_output_path\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nAudit lock:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    final_audit_lock_path\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nNO NEW DIFFERENTIAL EXPRESSION WAS RUN.\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nNEXT:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Freeze the primary PD discovery effect vectors, \"\n",
    "    \"then move to independent PD replication.\"\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 24\n",    "# ============================================================\n",
    "# STEP 13 — FREEZE PD DISCOVERY EFFECT VECTORS\n",
    "#           + PREDECLARE PD REPLICATION RULES\n",
    "#\n",
    "# NO NEW DIFFERENTIAL EXPRESSION.\n",
    "# NO GSE157783 DATA ARE INSPECTED HERE.\n",
    "#\n",
    "# PURPOSE\n",
    "# -------\n",
    "# 1. Freeze the PRIMARY PD discovery effect vectors.\n",
    "# 2. Preserve ALL tested genes, not only FDR hits.\n",
    "# 3. Attach sensitivity-support annotations descriptively.\n",
    "# 4. Hash every frozen effect vector.\n",
    "# 5. Create a combined long-format discovery table.\n",
    "# 6. Freeze independent-replication rules BEFORE looking at\n",
    "#    GSE157783 disease-expression results.\n",
    "#\n",
    "# PRIMARY DISCOVERY REMAINS:\n",
    "#\n",
    "#   model:\n",
    "#       ~ age + sex + diagnosis_binary\n",
    "#\n",
    "#   contrast:\n",
    "#       PD vs Control\n",
    "#\n",
    "# Sensitivity results DO NOT replace primary effects.\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import hashlib\n",
    "import json\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = ROOT / \"locks\"\n",
    "\n",
    "PRIMARY_ROOT = (\n",
    "    ROOT /\n",
    "    \"PD_primary_DE\"\n",
    ")\n",
    "\n",
    "SENS_ROOT = (\n",
    "    ROOT /\n",
    "    \"PD_primary_sensitivity\"\n",
    ")\n",
    "\n",
    "FREEZE_ROOT = (\n",
    "    ROOT /\n",
    "    \"PD_discovery_frozen\"\n",
    ")\n",
    "\n",
    "FREEZE_ROOT.mkdir(\n",
    "    exist_ok=True\n",
    ")\n",
    "\n",
    "\n",
    "primary_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_PRIMARY_PD_DE_RUN_v1.json\"\n",
    ")\n",
    "\n",
    "pre_de_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_PRE_DE_ANALYSIS_LOCK_v1.json\"\n",
    ")\n",
    "\n",
    "sensitivity_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_PRIMARY_PD_SENSITIVITY_RUN_v1.json\"\n",
    ")\n",
    "\n",
    "sensitivity_audit_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_PRIMARY_PD_SENSITIVITY_AUDIT_v1.json\"\n",
    ")\n",
    "\n",
    "robustness_path = (\n",
    "    SENS_ROOT /\n",
    "    \"GSE243639_PRIMARY_FDR_GENE_ROBUSTNESS_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "discovery_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_PD_DISCOVERY_EFFECT_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "replication_plan_path = (\n",
    "    LOCKS /\n",
    "    \"GSE157783_PD_REPLICATION_PLAN_v1.json\"\n",
    ")\n",
    "\n",
    "combined_long_path = (\n",
    "    FREEZE_ROOT /\n",
    "    \"GSE243639_PD_DISCOVERY_ALL_EFFECTS_LONG_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "combined_fdr_path = (\n",
    "    FREEZE_ROOT /\n",
    "    \"GSE243639_PD_DISCOVERY_PRIMARY_FDR_HITS_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "\n",
    "    primary_lock_path,\n",
    "    pre_de_lock_path,\n",
    "    sensitivity_lock_path,\n",
    "    sensitivity_audit_lock_path,\n",
    "    robustness_path,\n",
    "\n",
    "]:\n",
    "\n",
    "    assert path.exists(), (\n",
    "        f\"Missing required file: {path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. LOAD LOCKS\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    primary_lock_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    primary_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    pre_de_lock_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    pre_de_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    sensitivity_lock_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    sensitivity_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    sensitivity_audit_lock_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    sensitivity_audit_lock = json.load(f)\n",
    "\n",
    "\n",
    "assert (\n",
    "    primary_lock[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"PRIMARY_DE_COMPLETE\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    sensitivity_lock[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"PRIMARY_SENSITIVITY_COMPLETE\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    sensitivity_audit_lock[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"PRIMARY_SENSITIVITY_AUDIT_COMPLETE\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    sensitivity_lock[\n",
    "        \"gene_universes_refiltered\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    primary_lock[\n",
    "        \"secondary_cell_classes_analyzed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"UPSTREAM PD DISCOVERY LOCKS VERIFIED\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. PRIMARY CLASSES\n",
    "# ============================================================\n",
    "\n",
    "PRIMARY_CLASSES = [\n",
    "\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "EXPECTED_UNIVERSES = {\n",
    "\n",
    "    \"Astro\":\n",
    "        16942,\n",
    "\n",
    "    \"Micro\":\n",
    "        16050,\n",
    "\n",
    "    \"OPC\":\n",
    "        16268,\n",
    "\n",
    "    \"Oligo\":\n",
    "        15957,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "EXPECTED_PRIMARY_FDR = {\n",
    "\n",
    "    \"Astro\":\n",
    "        18,\n",
    "\n",
    "    \"Micro\":\n",
    "        144,\n",
    "\n",
    "    \"OPC\":\n",
    "        1,\n",
    "\n",
    "    \"Oligo\":\n",
    "        2,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. HELPERS\n",
    "# ============================================================\n",
    "\n",
    "def sha256_file(\n",
    "    path,\n",
    "    block_size=1024 * 1024\n",
    "):\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\"\n",
    "    ) as f:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            block = f.read(\n",
    "                block_size\n",
    "            )\n",
    "\n",
    "            if not block:\n",
    "\n",
    "                break\n",
    "\n",
    "            h.update(\n",
    "                block\n",
    "            )\n",
    "\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "def ordered_table_hash(\n",
    "    df,\n",
    "    columns\n",
    "):\n",
    "\n",
    "    temp = (\n",
    "        df[\n",
    "            columns\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    payload = (\n",
    "        temp\n",
    "        .to_csv(\n",
    "            index=False,\n",
    "            lineterminator=\"\\n\"\n",
    "        )\n",
    "        .encode(\n",
    "            \"utf-8\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    return hashlib.sha256(\n",
    "        payload\n",
    "    ).hexdigest()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. LOAD GENE-LEVEL SENSITIVITY SUPPORT TABLE\n",
    "# ============================================================\n",
    "\n",
    "robustness = pd.read_csv(\n",
    "    robustness_path,\n",
    "    compression=\"gzip\"\n",
    ")\n",
    "\n",
    "\n",
    "required_robustness_columns = {\n",
    "\n",
    "    \"cell_type\",\n",
    "    \"gene_symbol\",\n",
    "\n",
    "    \"primary_LFC\",\n",
    "    \"primary_padj\",\n",
    "\n",
    "    \"technical_LFC\",\n",
    "    \"technical_p\",\n",
    "    \"technical_padj\",\n",
    "\n",
    "    \"overlap_LFC\",\n",
    "    \"overlap_p\",\n",
    "    \"overlap_padj\",\n",
    "\n",
    "    \"same_direction_both_sensitivities\",\n",
    "    \"nominal_support_both_sensitivities\",\n",
    "    \"FDR_support_both_sensitivities\",\n",
    "    \"dual_sensitivity_supported\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "assert (\n",
    "    required_robustness_columns\n",
    "    <=\n",
    "    set(\n",
    "        robustness.columns\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# This table contains PRIMARY FDR genes only.\n",
    "assert len(\n",
    "    robustness\n",
    ") == (\n",
    "    18\n",
    "    +\n",
    "    144\n",
    "    +\n",
    "    1\n",
    "    +\n",
    "    2\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Primary-FDR sensitivity annotation table:\",\n",
    "    len(\n",
    "        robustness\n",
    "    ),\n",
    "    \"rows\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. STORAGE\n",
    "# ============================================================\n",
    "\n",
    "discovery_records = {}\n",
    "\n",
    "all_effect_tables = []\n",
    "\n",
    "all_fdr_tables = []\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. FREEZE EACH PRIMARY CELL-CLASS EFFECT VECTOR\n",
    "# ============================================================\n",
    "\n",
    "for cell_type in PRIMARY_CLASSES:\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\n\"\n",
    "        +\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        cell_type\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.1 PRIMARY RESULT PATH\n",
    "    # ========================================================\n",
    "\n",
    "    primary_record = (\n",
    "\n",
    "        primary_lock[\n",
    "            \"cell_class_results\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    primary_path = Path(\n",
    "        primary_record[\n",
    "            \"all_gene_results\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert primary_path.exists()\n",
    "\n",
    "\n",
    "    # Verify original result hash\n",
    "    assert (\n",
    "        sha256_file(\n",
    "            primary_path\n",
    "        )\n",
    "        ==\n",
    "        primary_record[\n",
    "            \"all_gene_results_sha256\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.2 LOAD PRIMARY RESULTS\n",
    "    # ========================================================\n",
    "\n",
    "    primary = pd.read_csv(\n",
    "        primary_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    expected_n = (\n",
    "        EXPECTED_UNIVERSES[\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        primary\n",
    "    ) == expected_n\n",
    "\n",
    "\n",
    "    assert (\n",
    "        primary[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .is_unique\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.3 VERIFY EXACT STEP-10C UNIVERSE\n",
    "    # ========================================================\n",
    "\n",
    "    universe_path = Path(\n",
    "\n",
    "        pre_de_lock[\n",
    "            \"cell_class_universes\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ][\n",
    "            \"gene_universe_file\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    universe = pd.read_csv(\n",
    "        universe_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    frozen_genes = (\n",
    "\n",
    "        universe[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    observed_genes = (\n",
    "\n",
    "        primary[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        observed_genes\n",
    "        ==\n",
    "        frozen_genes\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.4 BUILD THE FROZEN EFFECT VECTOR\n",
    "    #\n",
    "    # The core vector is PRIMARY analysis only.\n",
    "    # ========================================================\n",
    "\n",
    "    frozen = (\n",
    "\n",
    "        primary[\n",
    "            [\n",
    "                \"gene_symbol\",\n",
    "                \"baseMean\",\n",
    "                \"log2FoldChange\",\n",
    "                \"lfcSE\",\n",
    "                \"stat\",\n",
    "                \"pvalue\",\n",
    "                \"padj\",\n",
    "            ]\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    frozen = frozen.rename(\n",
    "        columns={\n",
    "\n",
    "            \"log2FoldChange\":\n",
    "                \"PD_vs_Control_log2FC\",\n",
    "\n",
    "            \"lfcSE\":\n",
    "                \"PD_vs_Control_lfcSE\",\n",
    "\n",
    "            \"stat\":\n",
    "                \"PD_vs_Control_Wald\",\n",
    "\n",
    "            \"pvalue\":\n",
    "                \"PD_vs_Control_pvalue\",\n",
    "\n",
    "            \"padj\":\n",
    "                \"PD_vs_Control_padj\",\n",
    "\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    frozen.insert(\n",
    "        0,\n",
    "        \"cell_type\",\n",
    "        cell_type\n",
    "    )\n",
    "\n",
    "\n",
    "    frozen[\n",
    "        \"discovery_primary_FDR05\"\n",
    "    ] = (\n",
    "\n",
    "        np.isfinite(\n",
    "            frozen[\n",
    "                \"PD_vs_Control_padj\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            frozen[\n",
    "                \"PD_vs_Control_padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.5 ADD DESCRIPTIVE SENSITIVITY SUPPORT\n",
    "    #\n",
    "    # False for genes that were not primary FDR hits.\n",
    "    #\n",
    "    # IMPORTANT:\n",
    "    # These columns do not alter primary DE significance.\n",
    "    # ========================================================\n",
    "\n",
    "    robust_class = (\n",
    "\n",
    "        robustness[\n",
    "            robustness[\n",
    "                \"cell_type\"\n",
    "            ]\n",
    "            ==\n",
    "            cell_type\n",
    "        ]\n",
    "        [\n",
    "            [\n",
    "                \"gene_symbol\",\n",
    "\n",
    "                \"same_direction_both_sensitivities\",\n",
    "\n",
    "                \"nominal_support_both_sensitivities\",\n",
    "\n",
    "                \"FDR_support_both_sensitivities\",\n",
    "\n",
    "                \"dual_sensitivity_supported\",\n",
    "            ]\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    frozen = frozen.merge(\n",
    "\n",
    "        robust_class,\n",
    "\n",
    "        on=\"gene_symbol\",\n",
    "\n",
    "        how=\"left\",\n",
    "\n",
    "        validate=\"one_to_one\",\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    support_columns = [\n",
    "\n",
    "        \"same_direction_both_sensitivities\",\n",
    "\n",
    "        \"nominal_support_both_sensitivities\",\n",
    "\n",
    "        \"FDR_support_both_sensitivities\",\n",
    "\n",
    "        \"dual_sensitivity_supported\",\n",
    "\n",
    "    ]\n",
    "\n",
    "\n",
    "    for column in support_columns:\n",
    "\n",
    "        frozen[\n",
    "            column\n",
    "        ] = (\n",
    "\n",
    "            frozen[\n",
    "                column\n",
    "            ]\n",
    "            .fillna(\n",
    "                False\n",
    "            )\n",
    "            .astype(\n",
    "                bool\n",
    "            )\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.6 ASSERT PRIMARY HIT COUNTS\n",
    "    # ========================================================\n",
    "\n",
    "    n_fdr = int(\n",
    "\n",
    "        frozen[\n",
    "            \"discovery_primary_FDR05\"\n",
    "        ].sum()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_fdr\n",
    "        ==\n",
    "        EXPECTED_PRIMARY_FDR[\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    # Every primary FDR gene had same direction and\n",
    "    # nominal support in both frozen sensitivities.\n",
    "    primary_hits = (\n",
    "\n",
    "        frozen[\n",
    "            frozen[\n",
    "                \"discovery_primary_FDR05\"\n",
    "            ]\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        primary_hits[\n",
    "            \"same_direction_both_sensitivities\"\n",
    "        ]\n",
    "        .all()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        primary_hits[\n",
    "            \"nominal_support_both_sensitivities\"\n",
    "        ]\n",
    "        .all()\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.7 EXACT FROZEN OUTPUT ORDER\n",
    "    # ========================================================\n",
    "\n",
    "    frozen = frozen[\n",
    "        [\n",
    "            \"cell_type\",\n",
    "\n",
    "            \"gene_symbol\",\n",
    "\n",
    "            \"baseMean\",\n",
    "\n",
    "            \"PD_vs_Control_log2FC\",\n",
    "\n",
    "            \"PD_vs_Control_lfcSE\",\n",
    "\n",
    "            \"PD_vs_Control_Wald\",\n",
    "\n",
    "            \"PD_vs_Control_pvalue\",\n",
    "\n",
    "            \"PD_vs_Control_padj\",\n",
    "\n",
    "            \"discovery_primary_FDR05\",\n",
    "\n",
    "            \"same_direction_both_sensitivities\",\n",
    "\n",
    "            \"nominal_support_both_sensitivities\",\n",
    "\n",
    "            \"FDR_support_both_sensitivities\",\n",
    "\n",
    "            \"dual_sensitivity_supported\",\n",
    "        ]\n",
    "    ]\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.8 SAVE PER-CLASS FROZEN VECTOR\n",
    "    # ========================================================\n",
    "\n",
    "    vector_path = (\n",
    "\n",
    "        FREEZE_ROOT /\n",
    "        (\n",
    "            f\"GSE243639_{cell_type}_\"\n",
    "            f\"PD_DISCOVERY_EFFECT_VECTOR_v1.csv.gz\"\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    frozen.to_csv(\n",
    "        vector_path,\n",
    "        index=False,\n",
    "        compression={\n",
    "            \"method\":\n",
    "                \"gzip\",\n",
    "\n",
    "            \"compresslevel\":\n",
    "                6,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.9 HASH FROZEN VECTOR\n",
    "    # ========================================================\n",
    "\n",
    "    vector_file_sha256 = (\n",
    "        sha256_file(\n",
    "            vector_path\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    vector_content_sha256 = (\n",
    "        ordered_table_hash(\n",
    "\n",
    "            frozen,\n",
    "\n",
    "            [\n",
    "                \"gene_symbol\",\n",
    "\n",
    "                \"PD_vs_Control_log2FC\",\n",
    "\n",
    "                \"PD_vs_Control_Wald\",\n",
    "\n",
    "                \"PD_vs_Control_pvalue\",\n",
    "\n",
    "                \"PD_vs_Control_padj\",\n",
    "            ],\n",
    "\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.10 RECORD\n",
    "    # ========================================================\n",
    "\n",
    "    discovery_records[\n",
    "        cell_type\n",
    "    ] = {\n",
    "\n",
    "        \"role\":\n",
    "            \"primary\",\n",
    "\n",
    "        \"source_dataset\":\n",
    "            \"GSE243639\",\n",
    "\n",
    "        \"source_region\":\n",
    "            \"substantia_nigra\",\n",
    "\n",
    "        \"n_PD\":\n",
    "            15,\n",
    "\n",
    "        \"n_Control\":\n",
    "            14,\n",
    "\n",
    "        \"n_donors\":\n",
    "            29,\n",
    "\n",
    "        \"model\":\n",
    "            \"~ age + sex + diagnosis_binary\",\n",
    "\n",
    "        \"contrast\":\n",
    "            \"PD_vs_Control\",\n",
    "\n",
    "        \"n_tested_genes\":\n",
    "            int(\n",
    "                len(\n",
    "                    frozen\n",
    "                )\n",
    "            ),\n",
    "\n",
    "        \"n_primary_FDR05\":\n",
    "            int(\n",
    "                n_fdr\n",
    "            ),\n",
    "\n",
    "        \"all_primary_hits_same_direction_both_sensitivities\":\n",
    "            True,\n",
    "\n",
    "        \"all_primary_hits_nominal_support_both_sensitivities\":\n",
    "            True,\n",
    "\n",
    "        \"effect_vector_file\":\n",
    "            str(\n",
    "                vector_path\n",
    "            ),\n",
    "\n",
    "        \"effect_vector_file_sha256\":\n",
    "            vector_file_sha256,\n",
    "\n",
    "        \"effect_vector_content_sha256\":\n",
    "            vector_content_sha256,\n",
    "\n",
    "    }\n",
    "\n",
    "\n",
    "    all_effect_tables.append(\n",
    "        frozen\n",
    "    )\n",
    "\n",
    "\n",
    "    all_fdr_tables.append(\n",
    "\n",
    "        frozen[\n",
    "            frozen[\n",
    "                \"discovery_primary_FDR05\"\n",
    "            ]\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Frozen tested genes:\",\n",
    "        f\"{len(frozen):,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Primary FDR hits:\",\n",
    "        n_fdr\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Effect vector hash:\",\n",
    "        vector_content_sha256\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. COMBINED LONG-FORM DISCOVERY TABLE\n",
    "# ============================================================\n",
    "\n",
    "combined_long = pd.concat(\n",
    "    all_effect_tables,\n",
    "    axis=0,\n",
    "    ignore_index=True\n",
    ")\n",
    "\n",
    "\n",
    "expected_total_rows = (\n",
    "\n",
    "    EXPECTED_UNIVERSES[\n",
    "        \"Astro\"\n",
    "    ]\n",
    "    +\n",
    "    EXPECTED_UNIVERSES[\n",
    "        \"Micro\"\n",
    "    ]\n",
    "    +\n",
    "    EXPECTED_UNIVERSES[\n",
    "        \"OPC\"\n",
    "    ]\n",
    "    +\n",
    "    EXPECTED_UNIVERSES[\n",
    "        \"Oligo\"\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    combined_long\n",
    ") == expected_total_rows\n",
    "\n",
    "\n",
    "combined_long.to_csv(\n",
    "    combined_long_path,\n",
    "    index=False,\n",
    "    compression={\n",
    "        \"method\":\n",
    "            \"gzip\",\n",
    "\n",
    "        \"compresslevel\":\n",
    "            6,\n",
    "    }\n",    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. COMBINED PRIMARY FDR TABLE\n",
    "# ============================================================\n",
    "\n",
    "combined_fdr = pd.concat(\n",
    "    all_fdr_tables,\n",
    "    axis=0,\n",
    "    ignore_index=True\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    combined_fdr\n",
    ") == (\n",
    "    18\n",
    "    +\n",
    "    144\n",
    "    +\n",
    "    1\n",
    "    +\n",
    "    2\n",
    ")\n",
    "\n",
    "\n",
    "combined_fdr.to_csv(\n",
    "    combined_fdr_path,\n",
    "    index=False,\n",
    "    compression={\n",
    "        \"method\":\n",
    "            \"gzip\",\n",
    "\n",
    "        \"compresslevel\":\n",
    "            6,\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nCombined frozen effect rows:\",\n",
    "    f\"{len(combined_long):,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Combined primary FDR rows:\",\n",
    "    f\"{len(combined_fdr):,}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. FREEZE DISCOVERY EFFECT LOCK\n",
    "# ============================================================\n",
    "\n",
    "DISCOVERY_LOCK = {\n",
    "\n",
    "    \"dataset\":\n",
    "        \"GSE243639\",\n",
    "\n",
    "    \"created_utc\":\n",
    "        datetime.now(\n",
    "            timezone.utc\n",
    "        ).isoformat(),\n",
    "\n",
    "    \"status\":\n",
    "        \"PD_DISCOVERY_EFFECTS_FROZEN\",\n",
    "\n",
    "    \"biological_replicate\":\n",
    "        \"human donor\",\n",
    "\n",
    "    \"primary_cell_classes\":\n",
    "        PRIMARY_CLASSES,\n",
    "\n",
    "    \"primary_model\":\n",
    "        \"~ age + sex + diagnosis_binary\",\n",
    "\n",
    "    \"contrast\":\n",
    "        \"PD_vs_Control\",\n",
    "\n",
    "    \"primary_effect_source\":\n",
    "        (\n",
    "            \"STEP 11 primary analysis only; \"\n",
    "            \"sensitivity estimates do not \"\n",
    "            \"replace discovery effect sizes\"\n",
    "        ),\n",
    "\n",
    "    \"gene_universes_refiltered\":\n",
    "        False,\n",
    "\n",
    "    \"all_tested_genes_retained\":\n",
    "        True,\n",
    "\n",
    "    \"pathway_rank_statistic\":\n",
    "        \"signed_DESeq2_Wald\",\n",
    "\n",
    "    \"cell_class_effect_vectors\":\n",
    "        discovery_records,\n",
    "\n",
    "    \"combined_all_effects\":\n",
    "        str(\n",
    "            combined_long_path\n",
    "        ),\n",
    "\n",
    "    \"combined_all_effects_sha256\":\n",
    "        sha256_file(\n",
    "            combined_long_path\n",
    "        ),\n",
    "\n",
    "    \"combined_primary_FDR_hits\":\n",
    "        str(\n",
    "            combined_fdr_path\n",
    "        ),\n",
    "\n",
    "    \"combined_primary_FDR_hits_sha256\":\n",
    "        sha256_file(\n",
    "            combined_fdr_path\n",
    "        ),\n",
    "\n",
    "    \"discovery_results_frozen_before_replication\":\n",
    "        True,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    discovery_lock_path,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        DISCOVERY_LOCK,\n",
    "        f,\n",
    "        indent=2\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. PREDECLARE INDEPENDENT PD REPLICATION PLAN\n",
    "#\n",
    "# DATASET:\n",
    "#   GSE157783\n",
    "#\n",
    "# IMPORTANT:\n",
    "# We freeze the interpretation rules BEFORE inspecting\n",
    "# disease-expression results from this replication cohort.\n",
    "# ============================================================\n",
    "\n",
    "REPLICATION_PLAN = {\n",
    "\n",
    "    \"dataset\":\n",
    "        \"GSE157783\",\n",
    "\n",
    "    \"created_utc\":\n",
    "        datetime.now(\n",
    "            timezone.utc\n",
    "        ).isoformat(),\n",
    "\n",
    "    \"status\":\n",
    "        \"PD_REPLICATION_PLAN_FROZEN_BEFORE_ANALYSIS\",\n",
    "\n",
    "    \"relationship_to_discovery\":\n",
    "        \"independent_replication\",\n",
    "\n",
    "    \"discovery_dataset\":\n",
    "        \"GSE243639\",\n",
    "\n",
    "    \"discovery_effect_lock\":\n",
    "        str(\n",
    "            discovery_lock_path\n",
    "        ),\n",
    "\n",
    "    \"biological_replicate\":\n",
    "        \"human donor\",\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Cell classes\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    \"target_cell_classes_in_priority_order\": [\n",
    "\n",
    "        \"Astro\",\n",
    "        \"Micro\",\n",
    "        \"OPC\",\n",
    "        \"Oligo\",\n",
    "\n",
    "    ],\n",
    "\n",
    "    \"cell_type_mapping_rule\":\n",
    "        (\n",
    "            \"Use homologous author-provided high-level \"\n",
    "            \"cell classes where available. \"\n",
    "            \"Do not invent or pool classes after viewing \"\n",
    "            \"replication disease results.\"\n",
    "        ),\n",
    "\n",
    "    \"missing_cell_class_rule\":\n",
    "        (\n",
    "            \"If a discovery cell class cannot be \"\n",
    "            \"unambiguously represented in GSE157783, \"\n",
    "            \"report replication unavailable for that \"\n",
    "            \"class rather than forcing a mapping.\"\n",
    "        ),\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Replication expression analysis\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    \"replication_expression_filter\":\n",
    "        (\n",
    "            \"Disease-blind filter defined within \"\n",
    "            \"GSE157783 before replication DE results.\"\n",
    "        ),\n",
    "\n",
    "    \"replication_gene_universe\":\n",
    "        (\n",
    "            \"Frozen independently in GSE157783; \"\n",
    "            \"discovery and replication vectors are \"\n",
    "            \"intersected only AFTER both are frozen.\"\n",
    "        ),\n",
    "\n",
    "    \"replication_DE_unit\":\n",
    "        \"donor_level_pseudobulk\",\n",
    "\n",
    "    \"replication_primary_contrast\":\n",
    "        \"PD_vs_Control\",\n",
    "\n",
    "    \"replication_covariates\":\n",
    "        (\n",
    "            \"Use only identifiable donor-level covariates \"\n",
    "            \"available in GSE157783; freeze model before \"\n",
    "            \"examining disease effects.\"\n",
    "        ),\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # PRIMARY replication evidence\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    \"all_gene_effect_replication\": {\n",
    "\n",
    "        \"metric\":\n",
    "            \"Spearman correlation\",\n",
    "\n",
    "        \"vectors\":\n",
    "            (\n",
    "                \"discovery primary log2FC versus \"\n",
    "                \"replication log2FC across all genes \"\n",
    "                \"tested in both datasets\"\n",
    "            ),\n",
    "\n",
    "        \"direction_expected\":\n",
    "            \"positive\",\n",
    "\n",
    "        \"significance_test\":\n",
    "            (\n",
    "                \"permutation/null test to be specified \"\n",
    "                \"before effect inspection\"\n",
    "            ),\n",
    "\n",
    "        \"no_FDR_DEG_prefilter\":\n",
    "            True,\n",
    "    },\n",
    "\n",
    "    \"all_gene_rank_replication\": {\n",
    "\n",
    "        \"metric\":\n",
    "            \"Spearman correlation\",\n",
    "\n",
    "        \"vectors\":\n",
    "            (\n",
    "                \"discovery signed Wald statistic versus \"\n",
    "                \"replication signed Wald statistic across \"\n",
    "                \"all genes tested in both datasets\"\n",
    "            ),\n",
    "\n",
    "        \"direction_expected\":\n",
    "            \"positive\",\n",
    "\n",
    "        \"no_FDR_DEG_prefilter\":\n",
    "            True,\n",
    "    },\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Gene-level replication of discovery FDR hits\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    \"discovery_FDR_gene_replication_rule\": {\n",
    "\n",
    "        \"discovery_set\":\n",
    "            \"GSE243639 primary FDR<0.05 genes\",\n",
    "\n",
    "        \"replication_success_per_gene\":\n",
    "            (\n",
    "                \"same log2FC direction AND \"\n",
    "                \"replication two-sided nominal p<0.05\"\n",
    "            ),\n",
    "\n",
    "        \"replication_padj_required\":\n",
    "            False,\n",
    "\n",
    "        \"reason\":\n",
    "            (\n",
    "                \"Independent confirmatory replication \"\n",
    "                \"of a prespecified discovery set; \"\n",
    "                \"replication FDR will also be reported \"\n",
    "                \"but is not required for directional \"\n",
    "                \"gene-level replication.\"\n",
    "            ),\n",
    "    },\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Directional enrichment\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    \"discovery_hit_directional_enrichment\": {\n",
    "\n",
    "        \"population\":\n",
    "            (\n",
    "                \"discovery primary FDR genes measurable \"\n",
    "                \"and tested in replication\"\n",
    "            ),\n",
    "\n",
    "        \"test\":\n",
    "            (\n",
    "                \"direction concordance versus 50% null; \"\n",
    "                \"exact/binomial or permutation test\"\n",
    "            ),\n",
    "\n",
    "        \"predeclared\":\n",
    "            True,\n",
    "    },\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Important prohibitions\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    \"prohibited_posthoc_changes\": [\n",
    "\n",
    "        \"No changing discovery gene universes.\",\n",
    "\n",
    "        \"No changing discovery effect vectors.\",\n",
    "\n",
    "        \"No selecting replication genes because they look good.\",\n",
    "\n",
    "        \"No redefining cell classes based on replication DE results.\",\n",
    "\n",
    "        \"No requiring exact FDR DEG overlap as the sole replication metric.\",\n",
    "\n",
    "        \"No dropping donors because they weaken replication \"\n",
    "        \"unless a QC rule was frozen before disease effects.\",\n",
    "\n",
    "    ],\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Interpretation\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    \"interpretation_hierarchy\": [\n",
    "\n",
    "        \"all-gene effect-vector concordance\",\n",
    "\n",
    "        \"all-gene Wald-rank concordance\",\n",
    "\n",
    "        \"directional enrichment of discovery FDR genes\",\n",
    "\n",
    "        \"same-direction nominal replication of individual \"\n",
    "        \"discovery FDR genes\",\n",
    "\n",
    "        \"replication FDR significance as stronger supporting evidence\",\n",
    "\n",
    "    ],\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    replication_plan_path,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        REPLICATION_PLAN,\n",
    "        f,\n",
    "        indent=2\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. FINAL REPORT\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 13 PASSED — PD DISCOVERY EFFECTS FROZEN\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "summary_rows = []\n",
    "\n",
    "\n",
    "for cell_type in PRIMARY_CLASSES:\n",
    "\n",
    "    record = (\n",
    "        discovery_records[\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    summary_rows.append({\n",
    "\n",
    "        \"cell_type\":\n",
    "            cell_type,\n",
    "\n",
    "        \"tested_genes\":\n",
    "            record[\n",
    "                \"n_tested_genes\"\n",
    "            ],\n",
    "\n",
    "        \"primary_FDR\":\n",
    "            record[\n",
    "                \"n_primary_FDR05\"\n",
    "            ],\n",
    "\n",
    "        \"all_hits_same_direction_both_sens\":\n",
    "            record[\n",
    "                \"all_primary_hits_same_direction_both_sensitivities\"\n",
    "            ],\n",
    "\n",
    "        \"all_hits_nominal_both_sens\":\n",
    "            record[\n",
    "                \"all_primary_hits_nominal_support_both_sensitivities\"\n",
    "            ],\n",
    "\n",
    "        \"effect_vector_sha256\":\n",
    "            record[\n",
    "                \"effect_vector_content_sha256\"\n",
    "            ],\n",
    "\n",
    "    })\n",
    "\n",
    "\n",
    "summary = pd.DataFrame(\n",
    "    summary_rows\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    summary\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nDiscovery freeze lock:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    discovery_lock_path\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nReplication plan lock:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    replication_plan_path\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nCombined all-gene effect table:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    combined_long_path\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nCombined primary-FDR table:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    combined_fdr_path\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nNO REPLICATION DATA INSPECTED: YES\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nNEXT:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 14 — audit GSE157783 raw files, \"\n",
    "    \"donor metadata, author cell annotations, \"\n",
    "    \"and analyzable cell classes BEFORE replication DE.\"\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 25\n",
    "# ============================================================\n",
    "# STEP 14A-RECOVERY — GSE157783 DOWNLOAD + EXTRACTION REPAIR\n",
    "#\n",
    "# PURPOSE\n",
    "# -------\n",
    "# Recover the official GEO processed files required by STEP 14B.\n",
    "#\n",
    "# - Does NOT perform differential expression.\n",
    "# - Does NOT alter discovery results.\n",
    "# - Does NOT change the replication dataset.\n",
    "# - Uses only official GSE157783 GEO files.\n",
    "# ============================================================\n",
    "\n",
    "from pathlib import Path\n",
    "import requests\n",
    "import tarfile\n",
    "import shutil\n",
    "import gzip\n",
    "import os\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "REP_DIR = (\n",
    "    ROOT /\n",
    "    \"GSE157783_PD_replication\"\n",
    ")\n",
    "\n",
    "DOWNLOAD_DIR = (\n",
    "    REP_DIR /\n",
    "    \"downloads\"\n",
    ")\n",
    "\n",
    "EXTRACT_DIR = (\n",
    "    REP_DIR /\n",
    "    \"extracted\"\n",
    ")\n",
    "\n",
    "\n",
    "DOWNLOAD_DIR.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True\n",
    ")\n",
    "\n",
    "EXTRACT_DIR.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. OFFICIAL NCBI GEO URLS\n",
    "# ============================================================\n",
    "\n",
    "SUPPL_BASE = (\n",
    "    \"https://ftp.ncbi.nlm.nih.gov/geo/\"\n",
    "    \"series/GSE157nnn/GSE157783/suppl\"\n",
    ")\n",
    "\n",
    "MATRIX_BASE = (\n",
    "    \"https://ftp.ncbi.nlm.nih.gov/geo/\"\n",
    "    \"series/GSE157nnn/GSE157783/matrix\"\n",
    ")\n",
    "\n",
    "\n",
    "FILES = {\n",
    "\n",
    "    \"cell\": {\n",
    "        \"url\":\n",
    "            f\"{SUPPL_BASE}/\"\n",
    "            \"GSE157783_IPDCO_hg_midbrain_cell.tar.gz\",\n",
    "\n",
    "        \"archive\":\n",
    "            DOWNLOAD_DIR /\n",
    "            \"GSE157783_IPDCO_hg_midbrain_cell.tar.gz\",\n",
    "\n",
    "        \"target\":\n",
    "            EXTRACT_DIR /\n",
    "            \"cell\" /\n",
    "            \"IPDCO_hg_midbrain_cell.tsv\",\n",
    "\n",
    "        \"hint\":\n",
    "            \"midbrain_cell\",\n",
    "    },\n",
    "\n",
    "    \"genes\": {\n",
    "        \"url\":\n",
    "            f\"{SUPPL_BASE}/\"\n",
    "            \"GSE157783_IPDCO_hg_midbrain_genes.tar.gz\",\n",
    "\n",
    "        \"archive\":\n",
    "            DOWNLOAD_DIR /\n",
    "            \"GSE157783_IPDCO_hg_midbrain_genes.tar.gz\",\n",
    "\n",
    "        \"target\":\n",
    "            EXTRACT_DIR /\n",
    "            \"genes\" /\n",
    "            \"IPDCO_hg_midbrain_genes.tsv\",\n",
    "\n",
    "        \"hint\":\n",
    "            \"midbrain_genes\",\n",
    "    },\n",
    "\n",
    "    \"UMI\": {\n",
    "        \"url\":\n",
    "            f\"{SUPPL_BASE}/\"\n",
    "            \"GSE157783_IPDCO_hg_midbrain_UMI.tar.gz\",\n",
    "\n",
    "        \"archive\":\n",
    "            DOWNLOAD_DIR /\n",
    "            \"GSE157783_IPDCO_hg_midbrain_UMI.tar.gz\",\n",
    "\n",
    "        \"target\":\n",
    "            EXTRACT_DIR /\n",
    "            \"UMI\" /\n",
    "            \"IPDCO_hg_midbrain_UMI.tsv\",\n",
    "\n",
    "        \"hint\":\n",
    "            \"midbrain_umi\",\n",
    "    },\n",
    "}\n",
    "\n",
    "\n",
    "SERIES_MATRIX_URL = (\n",
    "    f\"{MATRIX_BASE}/\"\n",
    "    \"GSE157783_series_matrix.txt.gz\"\n",
    ")\n",
    "\n",
    "SERIES_MATRIX_PATH = (\n",
    "    DOWNLOAD_DIR /\n",
    "    \"GSE157783_series_matrix.txt.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. ROBUST DOWNLOAD\n",
    "# ============================================================\n",
    "\n",
    "def download_file(\n",
    "    url,\n",
    "    destination\n",
    "):\n",
    "\n",
    "    destination.parent.mkdir(\n",
    "        parents=True,\n",
    "        exist_ok=True\n",
    "    )\n",
    "\n",
    "    temp = destination.with_suffix(\n",
    "        destination.suffix + \".part\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"\\nDownloading:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        url\n",
    "    )\n",
    "\n",
    "\n",
    "    with requests.get(\n",
    "        url,\n",
    "        stream=True,\n",
    "        timeout=120\n",
    "    ) as r:\n",
    "\n",
    "        r.raise_for_status()\n",
    "\n",
    "        total = int(\n",
    "            r.headers.get(\n",
    "                \"content-length\",\n",
    "                0\n",
    "            )\n",
    "        )\n",
    "\n",
    "        downloaded = 0\n",
    "\n",
    "\n",
    "        with open(\n",
    "            temp,\n",
    "            \"wb\"\n",
    "        ) as f:\n",
    "\n",
    "            for chunk in r.iter_content(\n",
    "                chunk_size=8 * 1024 * 1024\n",
    "            ):\n",
    "\n",
    "                if not chunk:\n",
    "\n",
    "                    continue\n",
    "\n",
    "                f.write(\n",
    "                    chunk\n",
    "                )\n",
    "\n",
    "                downloaded += len(\n",
    "                    chunk\n",
    "                )\n",
    "\n",
    "\n",
    "                if total:\n",
    "\n",
    "                    pct = (\n",
    "                        100.0 *\n",
    "                        downloaded /\n",
    "                        total\n",
    "                    )\n",
    "\n",
    "                    print(\n",
    "                        f\"\\r{pct:6.2f}%\",\n",
    "                        end=\"\"\n",
    "                    )\n",
    "\n",
    "\n",
    "    print()\n",
    "\n",
    "\n",
    "    temp.replace(\n",
    "        destination\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        destination.exists()\n",
    "    )\n",
    "\n",
    "    assert (\n",
    "        destination.stat().st_size\n",
    "        >\n",
    "        0\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Saved:\",\n",
    "        destination\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Bytes:\",\n",
    "        f\"{destination.stat().st_size:,}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. CHECK WHETHER TAR ARCHIVE IS READABLE\n",
    "# ============================================================\n",
    "\n",
    "def readable_tar(\n",
    "    path\n",
    "):\n",
    "\n",
    "    if not path.exists():\n",
    "\n",
    "        return False\n",
    "\n",
    "\n",
    "    if path.stat().st_size == 0:\n",
    "\n",
    "        return False\n",
    "\n",
    "\n",
    "    try:\n",
    "\n",
    "        with tarfile.open(\n",
    "            path,\n",
    "            \"r:*\"\n",
    "        ) as tar:\n",
    "\n",
    "            members = [\n",
    "                x\n",
    "                for x\n",
    "                in tar.getmembers()\n",
    "                if x.isfile()\n",
    "            ]\n",
    "\n",
    "\n",
    "        return len(\n",
    "            members\n",
    "        ) > 0\n",
    "\n",
    "\n",
    "    except Exception:\n",
    "\n",
    "        return False\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. EXTRACT ONE DATA FILE SAFELY\n",
    "# ============================================================\n",
    "\n",
    "def extract_data_file(\n",
    "    archive,\n",
    "    target,\n",
    "    hint\n",
    "):\n",
    "\n",
    "    target.parent.mkdir(\n",
    "        parents=True,\n",
    "        exist_ok=True\n",
    "    )\n",
    "\n",
    "\n",
    "    if (\n",
    "        target.exists()\n",
    "        and\n",
    "        target.stat().st_size > 0\n",
    "    ):\n",
    "\n",
    "        print(\n",
    "            \"\\nAlready extracted:\",\n",
    "            target\n",
    "        )\n",
    "\n",
    "        print(\n",
    "            \"Bytes:\",\n",
    "            f\"{target.stat().st_size:,}\"\n",
    "        )\n",
    "\n",
    "        return\n",
    "\n",
    "\n",
    "    with tarfile.open(\n",
    "        archive,\n",
    "        \"r:*\"\n",
    "    ) as tar:\n",
    "\n",
    "        members = [\n",
    "            m\n",
    "            for m\n",
    "            in tar.getmembers()\n",
    "            if m.isfile()\n",
    "        ]\n",
    "\n",
    "\n",
    "        print(\n",
    "            \"\\nArchive:\",\n",
    "            archive.name\n",
    "        )\n",
    "\n",
    "        print(\n",
    "            \"Members:\"\n",
    "        )\n",
    "\n",
    "\n",
    "        for m in members:\n",
    "\n",
    "            print(\n",
    "                \"   \",\n",
    "                m.name,\n",
    "                f\"({m.size:,} bytes)\"\n",
    "            )\n",
    "\n",
    "\n",
    "        candidates = [\n",
    "            m\n",
    "            for m\n",
    "            in members\n",
    "            if hint.lower()\n",
    "            in Path(\n",
    "                m.name\n",
    "            ).name.lower()\n",
    "        ]\n",
    "\n",
    "\n",
    "        if len(\n",
    "            candidates\n",
    "        ) == 0:\n",
    "\n",
    "            # Each official GEO archive should contain the\n",
    "            # corresponding processed data object.\n",
    "            if len(\n",
    "                members\n",
    "            ) == 1:\n",
    "\n",
    "                candidates = [\n",
    "                    members[\n",
    "                        0\n",
    "                    ]\n",
    "                ]\n",
    "\n",
    "            else:\n",
    "\n",
    "                raise RuntimeError(\n",
    "                    \"Could not uniquely identify data file \"\n",
    "                    f\"in {archive}. \"\n",
    "                    f\"Members = {[m.name for m in members]}\"\n",
    "                )\n",
    "\n",
    "\n",
    "        if len(\n",
    "            candidates\n",
    "        ) != 1:\n",
    "\n",
    "            raise RuntimeError(\n",
    "                \"Ambiguous archive contents: \"\n",
    "                f\"{[m.name for m in candidates]}\"\n",
    "            )\n",
    "\n",
    "\n",
    "        member = candidates[\n",
    "            0\n",
    "        ]\n",
    "\n",
    "\n",
    "        source = tar.extractfile(\n",
    "            member\n",
    "        )\n",
    "\n",
    "\n",
    "        assert (\n",
    "            source is not None\n",
    "        )\n",
    "\n",
    "\n",
    "        # Handle either plain TSV member or gzipped TSV member.\n",
    "        if member.name.lower().endswith(\n",
    "            \".gz\"\n",
    "        ):\n",
    "\n",
    "            with gzip.GzipFile(\n",
    "                fileobj=source,\n",
    "                mode=\"rb\"\n",
    "            ) as gz_in:\n",
    "\n",
    "                with open(\n",
    "                    target,\n",
    "                    \"wb\"\n",
    "                ) as out:\n",
    "\n",
    "                    shutil.copyfileobj(\n",
    "                        gz_in,\n",
    "                        out,\n",
    "                        length=16 * 1024 * 1024\n",
    "                    )\n",
    "\n",
    "        else:\n",
    "\n",
    "            with open(\n",
    "                target,\n",
    "                \"wb\"\n",
    "            ) as out:\n",
    "\n",
    "                shutil.copyfileobj(\n",
    "                    source,\n",
    "                    out,\n",
    "                    length=16 * 1024 * 1024\n",
    "                )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        target.exists()\n",
    "    )\n",
    "\n",
    "    assert (\n",
    "        target.stat().st_size > 0\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Extracted:\",\n",
    "        target\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Bytes:\",\n",
    "        f\"{target.stat().st_size:,}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. DOWNLOAD + EXTRACT OFFICIAL PROCESSED FILES\n",
    "# ============================================================\n",    "\n",
    "for name, info in FILES.items():\n",
    "\n",
    "    archive = info[\n",
    "        \"archive\"\n",
    "    ]\n",
    "\n",
    "\n",
    "    # Redownload only if archive is absent/corrupt.\n",
    "    if not readable_tar(\n",
    "        archive\n",
    "    ):\n",
    "\n",
    "        if archive.exists():\n",
    "\n",
    "            print(\n",
    "                \"\\nRemoving incomplete/corrupt archive:\",\n",
    "                archive\n",
    "            )\n",
    "\n",
    "            archive.unlink()\n",
    "\n",
    "\n",
    "        download_file(\n",
    "            info[\n",
    "                \"url\"\n",
    "            ],\n",
    "            archive\n",
    "        )\n",
    "\n",
    "\n",
    "    assert readable_tar(\n",
    "        archive\n",
    "    ), (\n",
    "        f\"Archive failed integrity/readability test: {archive}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nArchive OK:\",\n",
    "        archive.name\n",
    "    )\n",
    "\n",
    "\n",
    "    extract_data_file(\n",
    "        archive=archive,\n",
    "        target=info[\n",
    "            \"target\"\n",
    "        ],\n",
    "        hint=info[\n",
    "            \"hint\"\n",
    "        ],\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. SERIES MATRIX\n",
    "# ============================================================\n",
    "\n",
    "if (\n",
    "    not SERIES_MATRIX_PATH.exists()\n",
    "    or\n",
    "    SERIES_MATRIX_PATH.stat().st_size == 0\n",
    "):\n",
    "\n",
    "    download_file(\n",
    "        SERIES_MATRIX_URL,\n",
    "        SERIES_MATRIX_PATH\n",
    "    )\n",
    "\n",
    "else:\n",
    "\n",
    "    print(\n",
    "        \"\\nSeries matrix already present:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        SERIES_MATRIX_PATH\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. FINAL REQUIRED-FILE CHECK\n",
    "# ============================================================\n",
    "\n",
    "required = [\n",
    "\n",
    "    FILES[\n",
    "        \"cell\"\n",
    "    ][\n",
    "        \"target\"\n",
    "    ],\n",
    "\n",
    "    FILES[\n",
    "        \"genes\"\n",
    "    ][\n",
    "        \"target\"\n",
    "    ],\n",
    "\n",
    "    FILES[\n",
    "        \"UMI\"\n",
    "    ][\n",
    "        \"target\"\n",
    "    ],\n",
    "\n",
    "    SERIES_MATRIX_PATH,\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 14A-RECOVERY FILE CHECK\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "for path in required:\n",
    "\n",
    "    exists = (\n",
    "        path.exists()\n",
    "        and\n",
    "        path.stat().st_size > 0\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        f\"{'PASS' if exists else 'FAIL'}  \"\n",
    "        f\"{path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    if exists:\n",
    "\n",
    "        print(\n",
    "            \"      bytes:\",\n",
    "            f\"{path.stat().st_size:,}\"\n",
    "        )\n",
    "\n",
    "\n",
    "    assert exists\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 14A-RECOVERY PASSED\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"\\nNow run STEP 14B.\"\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 26\n",
    "# ============================================================\n",
    "# STEP 14A2 — RECOVER GSE157783 FROZEN DONOR METADATA\n",
    "#\n",
    "# PURPOSE\n",
    "# -------\n",
    "# Reconstruct the exact donor metadata required by STEP 14B\n",
    "# directly from the official GEO series matrix.\n",
    "#\n",
    "# NO expression analysis.\n",
    "# NO disease DE.\n",
    "# NO guessed clinical values.\n",
    "# ============================================================\n",
    "\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import gzip\n",
    "import csv\n",
    "import re\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "REP_DIR = (\n",
    "    ROOT /\n",
    "    \"GSE157783_PD_replication\"\n",
    ")\n",
    "\n",
    "DOWNLOAD_DIR = (\n",
    "    REP_DIR /\n",
    "    \"downloads\"\n",
    ")\n",
    "\n",
    "MANIFESTS = (\n",
    "    ROOT /\n",
    "    \"manifests\"\n",
    ")\n",
    "\n",
    "MANIFESTS.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True\n",
    ")\n",
    "\n",
    "\n",
    "SERIES_MATRIX_PATH = (\n",
    "    DOWNLOAD_DIR /\n",
    "    \"GSE157783_series_matrix.txt.gz\"\n",
    ")\n",
    "\n",
    "DONOR_METADATA_PATH = (\n",
    "    MANIFESTS /\n",
    "    \"GSE157783_donor_metadata_FROZEN_v1.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "assert SERIES_MATRIX_PATH.exists(), (\n",
    "    f\"Missing GEO series matrix: {SERIES_MATRIX_PATH}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. READ SAMPLE-LEVEL GEO METADATA ROWS\n",
    "# ============================================================\n",
    "\n",
    "sample_rows = {}\n",
    "\n",
    "\n",
    "with gzip.open(\n",
    "    SERIES_MATRIX_PATH,\n",
    "    \"rt\",\n",
    "    encoding=\"utf-8\",\n",
    "    errors=\"replace\"\n",
    ") as f:\n",
    "\n",
    "    reader = csv.reader(\n",
    "        f,\n",
    "        delimiter=\"\\t\",\n",
    "        quotechar='\"'\n",
    "    )\n",
    "\n",
    "    for row in reader:\n",
    "\n",
    "        if not row:\n",
    "            continue\n",
    "\n",
    "        key = row[0].strip()\n",
    "\n",
    "        if key.startswith(\n",
    "            \"!Sample_\"\n",
    "        ):\n",
    "\n",
    "            sample_rows.setdefault(\n",
    "                key,\n",
    "                []\n",
    "            ).append(\n",
    "                row[1:]\n",
    "            )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. BASIC MATRIX METADATA CHECK\n",
    "# ============================================================\n",
    "\n",
    "required_sample_rows = [\n",
    "    \"!Sample_title\",\n",
    "    \"!Sample_geo_accession\",\n",
    "    \"!Sample_characteristics_ch1\",\n",
    "]\n",
    "\n",
    "\n",
    "for key in required_sample_rows:\n",
    "\n",
    "    assert key in sample_rows, (\n",
    "        f\"Required GEO metadata row missing: {key}\"\n",
    "    )\n",
    "\n",
    "\n",
    "titles = sample_rows[\n",
    "    \"!Sample_title\"\n",
    "][0]\n",
    "\n",
    "geo_accessions = sample_rows[\n",
    "    \"!Sample_geo_accession\"\n",
    "][0]\n",
    "\n",
    "\n",
    "assert len(\n",
    "    titles\n",
    ") == 11\n",
    "\n",
    "assert len(\n",
    "    geo_accessions\n",
    ") == 11\n",
    "\n",
    "\n",
    "print(\n",
    "    \"GEO sample titles:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    titles\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"\\nGEO accessions:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    geo_accessions\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. BUILD ONE RECORD PER GEO SAMPLE\n",
    "# ============================================================\n",
    "\n",
    "records = []\n",
    "\n",
    "\n",
    "for i in range(\n",
    "    len(\n",
    "        titles\n",
    "    )\n",
    "):\n",
    "\n",
    "    records.append({\n",
    "\n",
    "        \"sample_id\":\n",
    "            str(\n",
    "                titles[i]\n",
    "            ).strip(),\n",
    "\n",
    "        \"geo_accession\":\n",
    "            str(\n",
    "                geo_accessions[i]\n",
    "            ).strip(),\n",
    "\n",
    "    })\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. PARSE ALL !Sample_characteristics_ch1 ROWS\n",
    "# ============================================================\n",
    "\n",
    "characteristic_rows = sample_rows[\n",
    "    \"!Sample_characteristics_ch1\"\n",
    "]\n",
    "\n",
    "\n",
    "for characteristic_row in characteristic_rows:\n",
    "\n",
    "    assert len(\n",
    "        characteristic_row\n",
    "    ) == len(\n",
    "        records\n",
    "    ), (\n",
    "        \"Malformed GEO characteristics row.\"\n",
    "    )\n",
    "\n",
    "\n",
    "    for i, value in enumerate(\n",
    "        characteristic_row\n",
    "    ):\n",
    "\n",
    "        value = str(\n",
    "            value\n",
    "        ).strip()\n",
    "\n",
    "\n",
    "        if \":\" not in value:\n",
    "            continue\n",
    "\n",
    "\n",
    "        key, raw_value = value.split(\n",
    "            \":\",\n",
    "            1\n",
    "        )\n",
    "\n",
    "\n",
    "        key = (\n",
    "            key\n",
    "            .strip()\n",
    "            .lower()\n",
    "        )\n",
    "\n",
    "\n",
    "        raw_value = (\n",
    "            raw_value\n",
    "            .strip()\n",
    "        )\n",
    "\n",
    "\n",
    "        # Normalize characteristic name.\n",
    "        key_clean = re.sub(\n",
    "            r\"\\s+\",\n",
    "            \" \",\n",
    "            key\n",
    "        )\n",
    "\n",
    "\n",
    "        if (\n",
    "            key_clean\n",
    "            ==\n",
    "            \"disease state\"\n",
    "        ):\n",
    "\n",
    "            records[i][\n",
    "                \"disease_state_raw\"\n",
    "            ] = raw_value\n",
    "\n",
    "\n",
    "        elif (\n",
    "            key_clean\n",
    "            ==\n",
    "            \"age at death\"\n",
    "        ):\n",
    "\n",
    "            records[i][\n",
    "                \"age_raw\"\n",
    "            ] = raw_value\n",
    "\n",
    "\n",
    "        elif (\n",
    "            key_clean\n",
    "            ==\n",
    "            \"sex\"\n",
    "        ):\n",
    "\n",
    "            records[i][\n",
    "                \"sex_raw\"\n",
    "            ] = raw_value\n",
    "\n",
    "\n",
    "        elif (\n",
    "            key_clean\n",
    "            in {\n",
    "                \"pmi (h)\",\n",
    "                \"pmi\",\n",
    "                \"postmortem interval\",\n",
    "                \"post-mortem interval\",\n",
    "            }\n",
    "        ):\n",
    "\n",
    "            records[i][\n",
    "                \"PMI_raw\"\n",
    "            ] = raw_value\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. CONSTRUCT DATAFRAME\n",
    "# ============================================================\n",
    "\n",
    "donor_meta = pd.DataFrame(\n",
    "    records\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nParsed raw GEO donor metadata:\"\n",
    ")\n",
    "\n",
    "display(\n",
    "    donor_meta\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. REQUIRED RAW FIELDS\n",
    "# ============================================================\n",
    "\n",
    "required_columns = {\n",
    "\n",
    "    \"sample_id\",\n",
    "    \"geo_accession\",\n",
    "    \"disease_state_raw\",\n",
    "    \"age_raw\",\n",
    "    \"sex_raw\",\n",
    "    \"PMI_raw\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "missing_columns = (\n",
    "\n",
    "    required_columns\n",
    "    -\n",
    "    set(\n",
    "        donor_meta.columns\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert not missing_columns, (\n",
    "    \"Could not recover required GEO characteristics: \"\n",
    "    f\"{sorted(missing_columns)}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. CANONICAL SAMPLE IDS\n",
    "# ============================================================\n",
    "\n",
    "EXPECTED_SAMPLE_IDS = {\n",
    "\n",
    "    \"IPD1\",\n",
    "    \"IPD2\",\n",
    "    \"IPD3\",\n",
    "    \"IPD4\",\n",
    "    \"IPD5\",\n",
    "\n",
    "    \"C1\",\n",
    "    \"C2\",\n",
    "    \"C3\",\n",
    "    \"C4\",\n",
    "    \"C5\",\n",
    "    \"C6\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "assert (\n",
    "    set(\n",
    "        donor_meta[\n",
    "            \"sample_id\"\n",
    "        ]\n",
    "    )\n",
    "    ==\n",
    "    EXPECTED_SAMPLE_IDS\n",
    "), (\n",
    "    \"Unexpected GEO sample titles: \"\n",
    "    f\"{donor_meta['sample_id'].tolist()}\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    donor_meta[\n",
    "        \"sample_id\"\n",
    "    ]\n",
    "    .is_unique\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    donor_meta[\n",
    "        \"geo_accession\"\n",
    "    ]\n",
    "    .is_unique\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. VERIFY GEO ACCESSION ↔ DONOR MAPPING\n",
    "#\n",
    "# Official GSE157783 sample order:\n",
    "#\n",
    "# GSM4774931 = IPD1\n",
    "# GSM4774932 = IPD2\n",
    "# GSM4774933 = IPD3\n",
    "# GSM4774934 = IPD4\n",
    "# GSM4774935 = IPD5\n",
    "# GSM4774936 = C1\n",
    "# GSM4774937 = C2\n",
    "# GSM4774938 = C3\n",
    "# GSM4774939 = C4\n",
    "# GSM4774940 = C5\n",
    "# GSM4774941 = C6\n",
    "# ============================================================\n",
    "\n",
    "EXPECTED_GEO_MAPPING = {\n",
    "\n",
    "    \"IPD1\": \"GSM4774931\",\n",
    "    \"IPD2\": \"GSM4774932\",\n",
    "    \"IPD3\": \"GSM4774933\",\n",
    "    \"IPD4\": \"GSM4774934\",\n",
    "    \"IPD5\": \"GSM4774935\",\n",
    "\n",
    "    \"C1\": \"GSM4774936\",\n",
    "    \"C2\": \"GSM4774937\",\n",
    "    \"C3\": \"GSM4774938\",\n",
    "    \"C4\": \"GSM4774939\",\n",
    "    \"C5\": \"GSM4774940\",\n",
    "    \"C6\": \"GSM4774941\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "observed_geo_mapping = dict(\n",
    "    zip(\n",
    "        donor_meta[\n",
    "            \"sample_id\"\n",
    "        ],\n",
    "        donor_meta[\n",
    "            \"geo_accession\"\n",
    "        ],\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    observed_geo_mapping\n",
    "    ==\n",
    "    EXPECTED_GEO_MAPPING\n",
    "), (\n",
    "    \"GEO accession/sample mapping mismatch.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. DIAGNOSIS\n",
    "# ============================================================\n",
    "\n",
    "def normalize_diagnosis(\n",
    "    sample_id,\n",
    "    disease_text\n",
    "):\n",
    "\n",
    "    sample_id = str(\n",
    "        sample_id\n",
    "    ).strip()\n",
    "\n",
    "\n",
    "    disease_text = str(\n",
    "        disease_text\n",
    "    ).strip()\n",
    "\n",
    "\n",
    "    if sample_id.startswith(\n",
    "        \"IPD\"\n",
    "    ):\n",
    "\n",
    "        assert (\n",
    "            \"parkinson\"\n",
    "            in disease_text.lower()\n",
    "        ), (\n",
    "            f\"{sample_id}: unexpected disease state \"\n",
    "            f\"{disease_text}\"\n",
    "        )\n",
    "\n",
    "        return (\n",
    "            \"Idiopathic Parkinson's disease\",\n",
    "            \"PD\"\n",
    "        )\n",
    "\n",
    "\n",
    "    if sample_id.startswith(\n",
    "        \"C\"\n",
    "    ):\n",
    "\n",
    "        assert (\n",
    "            \"control\"\n",
    "            in disease_text.lower()\n",
    "            or\n",
    "            \"healthy\"\n",
    "            in disease_text.lower()\n",
    "        ), (\n",
    "            f\"{sample_id}: unexpected control state \"\n",
    "            f\"{disease_text}\"\n",
    "        )\n",
    "\n",
    "        return (\n",
    "            \"Control\",\n",
    "            \"Control\"\n",
    "        )\n",
    "\n",
    "\n",
    "    raise ValueError(\n",
    "        f\"Unexpected sample ID: {sample_id}\"\n",
    "    )\n",
    "\n",
    "\n",
    "diagnosis_values = donor_meta.apply(\n",
    "\n",
    "    lambda row:\n",
    "        normalize_diagnosis(\n",
    "            row[\n",
    "                \"sample_id\"\n",
    "            ],\n",
    "            row[\n",
    "                \"disease_state_raw\"\n",
    "            ],\n",
    "        ),\n",
    "\n",
    "    axis=1\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "donor_meta[\n",
    "    \"diagnosis\"\n",
    "] = [\n",
    "\n",
    "    x[\n",
    "        0\n",
    "    ]\n",
    "\n",
    "    for x\n",
    "    in diagnosis_values\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "donor_meta[\n",
    "    \"diagnosis_binary\"\n",
    "] = [\n",
    "\n",
    "    x[\n",
    "        1\n",
    "    ]\n",
    "\n",
    "    for x\n",
    "    in diagnosis_values\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. AGE\n",
    "# ============================================================\n",
    "\n",
    "donor_meta[\n",
    "    \"age\"\n",
    "] = pd.to_numeric(\n",
    "\n",
    "    donor_meta[\n",
    "        \"age_raw\"\n",
    "    ],\n",
    "\n",
    "    errors=\"raise\"\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. SEX\n",
    "# ============================================================\n",
    "\n",
    "donor_meta[\n",
    "    \"sex\"\n",
    "] = (\n",
    "\n",
    "    donor_meta[\n",
    "        \"sex_raw\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    "    .str.upper()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "sex_mapping = {\n",
    "\n",
    "    \"MALE\":\n",
    "        \"M\",\n",
    "\n",
    "    \"FEMALE\":\n",
    "        \"F\",\n",
    "\n",
    "    \"M\":\n",
    "        \"M\",\n",
    "\n",
    "    \"F\":\n",
    "        \"F\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "donor_meta[\n",
    "    \"sex\"\n",
    "] = (\n",
    "\n",
    "    donor_meta[\n",
    "        \"sex\"\n",
    "    ]\n",
    "    .map(\n",
    "        sex_mapping\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    donor_meta[\n",
    "        \"sex\"\n",
    "    ]\n",
    "    .notna()\n",
    "    .all()\n",
    "), (\n",
    "    \"Unexpected GEO sex encoding.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 12. PMI\n",
    "# ============================================================\n",
    "\n",
    "donor_meta[\n",
    "    \"PMI\"\n",
    "] = pd.to_numeric(\n",
    "\n",
    "    donor_meta[\n",
    "        \"PMI_raw\"\n",
    "    ],\n",
    "\n",
    "    errors=\"raise\"\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 13. HARD CLINICAL SANITY CHECKS\n",
    "# ============================================================\n",
    "\n",
    "assert len(\n",
    "    donor_meta\n",
    ") == 11\n",
    "\n",
    "\n",
    "assert (\n",
    "    donor_meta[\n",
    "        \"diagnosis_binary\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    "    ==\n",
    "    {\n",
    "        \"Control\": 6,\n",
    "        \"PD\": 5,\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    donor_meta[\n",
    "        \"age\"\n",
    "    ]\n",
    "    .between(\n",
    "        18,\n",
    "        110\n",
    "    )\n",
    "    .all()\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    donor_meta[\n",
    "        \"PMI\"\n",
    "    ]\n",
    "    .between(\n",
    "        0,\n",
    "        100\n",
    "    )\n",
    "    .all()\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    set(\n",
    "        donor_meta[\n",
    "            \"sex\"\n",
    "        ]\n",
    "    )\n",
    "    <=\n",
    "    {\n",
    "        \"M\",\n",
    "        \"F\",\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 14. ORDER DONORS DETERMINISTICALLY\n",
    "# ============================================================\n",
    "\n",
    "EXPECTED_ORDER = [\n",
    "\n",
    "    \"IPD1\",\n",
    "    \"IPD2\",\n",
    "    \"IPD3\",\n",
    "    \"IPD4\",\n",
    "    \"IPD5\",\n",
    "\n",
    "    \"C1\",\n",
    "    \"C2\",\n",
    "    \"C3\",\n",
    "    \"C4\",\n",
    "    \"C5\",\n",
    "    \"C6\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "donor_meta[\n",
    "    \"_order\"\n",
    "] = (\n",
    "\n",
    "    donor_meta[\n",
    "        \"sample_id\"\n",
    "    ]\n",
    "    .map({\n",
    "\n",
    "        sample_id:\n",
    "            i\n",
    "\n",
    "        for i, sample_id\n",
    "        in enumerate(\n",
    "            EXPECTED_ORDER\n",
    "        )\n",
    "\n",
    "    })\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "donor_meta = (\n",
    "\n",
    "    donor_meta\n",
    "    .sort_values(\n",
    "        \"_order\"\n",
    "    )\n",
    "    .drop(\n",
    "        columns=\"_order\"\n",
    "    )\n",
    "    .reset_index(\n",
    "        drop=True\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 15. FINAL COLUMN ORDER\n",
    "# ============================================================\n",
    "\n",
    "donor_meta = donor_meta[\n",
    "    [\n",
    "        \"sample_id\",\n",
    "        \"geo_accession\",\n",
    "        \"diagnosis\",\n",
    "        \"diagnosis_binary\",\n",
    "        \"age\",\n",
    "        \"sex\",\n",
    "        \"PMI\",\n",
    "        \"disease_state_raw\",\n",
    "        \"age_raw\",\n",
    "        \"sex_raw\",\n",
    "        \"PMI_raw\",\n",
    "    ]\n",
    "]\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"FINAL GSE157783 DONOR METADATA\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    donor_meta\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nDiagnosis:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    donor_meta[\n",
    "        \"diagnosis_binary\"\n",    "    ]\n",
    "    .value_counts()\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nAge summary:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    donor_meta[\n",
    "        \"age\"\n",
    "    ]\n",
    "    .describe()\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPMI summary:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    donor_meta[\n",
    "        \"PMI\"\n",
    "    ]\n",
    "    .describe()\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 16. FREEZE\n",
    "# ============================================================\n",
    "\n",
    "donor_meta.to_csv(\n",
    "    DONOR_METADATA_PATH,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "assert DONOR_METADATA_PATH.exists()\n",
    "\n",
    "assert (\n",
    "    DONOR_METADATA_PATH.stat().st_size\n",
    "    >\n",
    "    0\n",
    ")\n",
    "\n",
    "\n",
    "# Read it back to prove disk write.\n",
    "check = pd.read_csv(\n",
    "    DONOR_METADATA_PATH\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    check\n",
    ") == 11\n",
    "\n",
    "\n",
    "assert (\n",
    "    check[\n",
    "        \"diagnosis_binary\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    "    ==\n",
    "    {\n",
    "        \"Control\": 6,\n",
    "        \"PD\": 5,\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSaved:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    DONOR_METADATA_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 14A2 PASSED — DONOR METADATA RECOVERED\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"\\nNOW RUN STEP 14B.\"\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 28\n",
    "# ============================================================\n",
    "# STEP 14B — RECOVER + COMPLETE GSE157783 REPLICATION AUDIT\n",
    "#\n",
    "# DO NOT RERUN THE FAILED STEP 14.\n",
    "#\n",
    "# This cell uses the files already downloaded/extracted.\n",
    "#\n",
    "# FIX\n",
    "# ---\n",
    "# The GEO cell metadata contains a valid \"patient\" column,\n",
    "# but its PD labels are not encoded exactly as IPD1...IPD5.\n",
    "#\n",
    "# We therefore:\n",
    "#   1. inspect the exact author patient labels,\n",
    "#   2. map them deterministically by donor number,\n",
    "#   3. independently verify EVERY donor against the authors'\n",
    "#      published profiled-nuclei counts,\n",
    "#   4. continue the cell-type/matrix audit.\n",
    "#\n",
    "# NO DIFFERENTIAL EXPRESSION.\n",
    "# NO DISCOVERY/REPLICATION COMPARISON.\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "import hashlib\n",
    "import json\n",
    "import re\n",
    "import subprocess\n",
    "import csv\n",
    "import gzip\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "REP_DIR = (\n",
    "    ROOT /\n",
    "    \"GSE157783_PD_replication\"\n",
    ")\n",
    "\n",
    "DOWNLOAD_DIR = (\n",
    "    REP_DIR /\n",
    "    \"downloads\"\n",
    ")\n",
    "\n",
    "EXTRACT_DIR = (\n",
    "    REP_DIR /\n",
    "    \"extracted\"\n",
    ")\n",
    "\n",
    "MANIFESTS = (\n",
    "    ROOT /\n",
    "    \"manifests\"\n",
    ")\n",
    "\n",
    "LOCKS = (\n",
    "    ROOT /\n",
    "    \"locks\"\n",
    ")\n",
    "\n",
    "\n",
    "cell_path = (\n",
    "    EXTRACT_DIR /\n",
    "    \"cell\" /\n",
    "    \"IPDCO_hg_midbrain_cell.tsv\"\n",
    ")\n",
    "\n",
    "genes_path = (\n",
    "    EXTRACT_DIR /\n",
    "    \"genes\" /\n",
    "    \"IPDCO_hg_midbrain_genes.tsv\"\n",
    ")\n",
    "\n",
    "umi_path = (\n",
    "    EXTRACT_DIR /\n",
    "    \"UMI\" /\n",
    "    \"IPDCO_hg_midbrain_UMI.tsv\"\n",
    ")\n",
    "\n",
    "donor_metadata_path = (\n",
    "    MANIFESTS /\n",
    "    \"GSE157783_donor_metadata_FROZEN_v1.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "cell_metadata_output = (\n",
    "    MANIFESTS /\n",
    "    \"GSE157783_author_cell_metadata_AUDITED_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "mapping_output = (\n",
    "    MANIFESTS /\n",
    "    \"GSE157783_author_to_canonical_celltype_mapping_v1.csv\"\n",
    ")\n",
    "\n",
    "donor_cell_counts_output = (\n",
    "    MANIFESTS /\n",
    "    \"GSE157783_donor_cellclass_counts_v1.csv\"\n",
    ")\n",
    "\n",
    "coverage_output = (\n",
    "    MANIFESTS /\n",
    "    \"GSE157783_replication_cellclass_coverage_v1.csv\"\n",
    ")\n",
    "\n",
    "matrix_audit_output = (\n",
    "    MANIFESTS /\n",
    "    \"GSE157783_matrix_structure_audit_v1.csv\"\n",
    ")\n",
    "\n",
    "gene_audit_output = (\n",
    "    MANIFESTS /\n",
    "    \"GSE157783_gene_structure_audit_v1.csv\"\n",
    ")\n",
    "\n",
    "audit_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE157783_REPLICATION_DATA_AUDIT_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "    cell_path,\n",
    "    genes_path,\n",
    "    umi_path,\n",
    "    donor_metadata_path,\n",
    "]:\n",
    "\n",
    "    assert path.exists(), (\n",
    "        f\"Missing required file: {path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 14B — RECOVERY AUDIT\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. LOAD FROZEN GEO DONOR METADATA\n",
    "# ============================================================\n",
    "\n",
    "donor_meta = pd.read_csv(\n",
    "    donor_metadata_path\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    donor_meta\n",
    ") == 11\n",
    "\n",
    "\n",
    "assert (\n",
    "    donor_meta[\n",
    "        \"sample_id\"\n",
    "    ]\n",
    "    .is_unique\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    donor_meta[\n",
    "        \"diagnosis_binary\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    "    ==\n",
    "    {\n",
    "        \"Control\": 6,\n",
    "        \"PD\": 5,\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "EXPECTED_CANONICAL_DONORS = {\n",
    "\n",
    "    \"IPD1\",\n",
    "    \"IPD2\",\n",
    "    \"IPD3\",\n",
    "    \"IPD4\",\n",
    "    \"IPD5\",\n",
    "\n",
    "    \"C1\",\n",
    "    \"C2\",\n",
    "    \"C3\",\n",
    "    \"C4\",\n",
    "    \"C5\",\n",
    "    \"C6\",\n",
    "}\n",
    "\n",
    "\n",
    "assert (\n",
    "    set(\n",
    "        donor_meta[\n",
    "            \"sample_id\"\n",
    "        ].astype(str)\n",
    "    )\n",
    "    ==\n",
    "    EXPECTED_CANONICAL_DONORS\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Frozen GEO donor metadata: PASS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PD = 5 | Control = 6\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. LOAD AUTHOR CELL METADATA\n",
    "# ============================================================\n",
    "\n",
    "cells = pd.read_csv(\n",
    "    cell_path,\n",
    "    sep=\"\\t\",\n",
    "    low_memory=False\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nAuthor cell table shape:\",\n",
    "    cells.shape\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Columns:\",\n",
    "    cells.columns.tolist()\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    cells\n",
    ") == 41435\n",
    "\n",
    "\n",
    "required_cell_columns = {\n",
    "\n",
    "    \"barcode\",\n",
    "    \"cell_ontology\",\n",
    "    \"patient\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "assert (\n",
    "    required_cell_columns\n",
    "    <=\n",
    "    set(\n",
    "        cells.columns\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    cells[\n",
    "        \"barcode\"\n",
    "    ]\n",
    "    .is_unique\n",
    "), (\n",
    "    \"Cell barcode column contains duplicates.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. INSPECT EXACT AUTHOR PATIENT LABELS\n",
    "# ============================================================\n",
    "\n",
    "raw_patient_counts = (\n",
    "\n",
    "    cells[\n",
    "        \"patient\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .value_counts()\n",
    "    .rename_axis(\n",
    "        \"raw_patient_label\"\n",
    "    )\n",
    "    .reset_index(\n",
    "        name=\"n_nuclei\"\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"ACTUAL AUTHOR PATIENT LABELS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    raw_patient_counts\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    raw_patient_counts[\n",
    "        \"raw_patient_label\"\n",
    "    ]\n",
    "    .nunique()\n",
    "    ==\n",
    "    11\n",
    "), (\n",
    "    \"Expected exactly 11 unique author patient labels.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. ROBUST AUTHOR PATIENT → CANONICAL DONOR MAPPING\n",
    "#\n",
    "# Controls:\n",
    "#   C1 ... C6\n",
    "#\n",
    "# PD:\n",
    "#   We do NOT assume the author prefix.\n",
    "#   We extract the donor number from each non-control label\n",
    "#   and canonicalize it to IPD1 ... IPD5.\n",
    "#\n",
    "# Examples that would all map correctly:\n",
    "#   PD1\n",
    "#   P1\n",
    "#   IPD1\n",
    "#   IPD_1\n",
    "#   patient_PD_1\n",
    "# ============================================================\n",
    "\n",
    "def canonicalize_author_patient(\n",
    "    value\n",
    "):\n",
    "\n",
    "    raw = str(\n",
    "        value\n",
    "    ).strip()\n",
    "\n",
    "\n",
    "    clean = re.sub(\n",
    "        r\"[^A-Za-z0-9]+\",\n",
    "        \"\",\n",
    "        raw\n",
    "    ).upper()\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Controls first\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    control_match = re.fullmatch(\n",
    "        r\"C([1-6])\",\n",
    "        clean\n",
    "    )\n",
    "\n",
    "\n",
    "    if control_match:\n",
    "\n",
    "        return (\n",
    "            \"C\"\n",
    "            +\n",
    "            control_match.group(\n",
    "                1\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Explicit PD-like patterns\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    pd_match = re.search(\n",
    "        r\"(?:IPD|PD|P)([1-5])$\",\n",
    "        clean\n",
    "    )\n",
    "\n",
    "\n",
    "    if pd_match:\n",
    "\n",
    "        return (\n",
    "            \"IPD\"\n",
    "            +\n",
    "            pd_match.group(\n",
    "                1\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Conservative fallback:\n",
    "    #\n",
    "    # Non-control label ending in donor number 1–5.\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    trailing_number = re.search(\n",
    "        r\"([1-5])$\",\n",
    "        clean\n",
    "    )\n",
    "\n",
    "\n",
    "    if trailing_number:\n",
    "\n",
    "        return (\n",
    "            \"IPD\"\n",
    "            +\n",
    "            trailing_number.group(\n",
    "                1\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "    return None\n",
    "\n",
    "\n",
    "cells[\n",
    "    \"sample_id\"\n",
    "] = (\n",
    "\n",
    "    cells[\n",
    "        \"patient\"\n",
    "    ]\n",
    "    .map(\n",
    "        canonicalize_author_patient\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "mapping_check = (\n",
    "\n",
    "    cells[\n",
    "        [\n",
    "            \"patient\",\n",
    "            \"sample_id\",\n",
    "        ]\n",
    "    ]\n",
    "    .drop_duplicates()\n",
    "    .sort_values(\n",
    "        \"sample_id\"\n",
    "    )\n",
    "    .reset_index(\n",
    "        drop=True\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"AUTHOR PATIENT → CANONICAL DONOR MAPPING\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    mapping_check\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    cells[\n",
    "        \"sample_id\"\n",
    "    ]\n",
    "    .notna()\n",
    "    .all()\n",
    "), (\n",
    "    \"At least one author patient label \"\n",
    "    \"could not be canonicalized.\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    set(\n",
    "        cells[\n",
    "            \"sample_id\"\n",
    "        ]\n",
    "    )\n",
    "    ==\n",
    "    EXPECTED_CANONICAL_DONORS\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    mapping_check[\n",
    "        \"sample_id\"\n",
    "    ]\n",
    "    .is_unique\n",
    "), (\n",
    "    \"Two raw author labels mapped to the same donor.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. HARD VALIDATION AGAINST AUTHOR TABLE S1\n",
    "#\n",
    "# Published profiled-nuclei counts:\n",
    "#\n",
    "# PD total      = 19,002\n",
    "# Control total = 22,433\n",
    "# Overall       = 41,435\n",
    "#\n",
    "# This makes the patient-label mapping independently testable.\n",
    "# ============================================================\n",
    "\n",
    "EXPECTED_AUTHOR_NUCLEI = {\n",
    "\n",
    "    \"IPD1\":\n",
    "        1943,\n",
    "\n",
    "    \"IPD2\":\n",
    "        5925,\n",
    "\n",
    "    \"IPD3\":\n",
    "        3345,\n",
    "\n",
    "    \"IPD4\":\n",
    "        2083,\n",
    "\n",
    "    \"IPD5\":\n",
    "        5706,\n",
    "\n",
    "    \"C1\":\n",
    "        3753,\n",
    "\n",
    "    \"C2\":\n",
    "        4358,\n",
    "\n",
    "    \"C3\":\n",
    "        2047,\n",
    "\n",
    "    \"C4\":\n",
    "        4199,\n",
    "\n",
    "    \"C5\":\n",
    "        2318,\n",
    "\n",
    "    \"C6\":\n",
    "        5758,\n",
    "}\n",
    "\n",
    "\n",
    "assert (\n",
    "    sum(\n",
    "        EXPECTED_AUTHOR_NUCLEI.values()\n",
    "    )\n",
    "    ==\n",
    "    41435\n",
    ")\n",
    "\n",
    "\n",
    "observed_donor_counts = (\n",
    "\n",
    "    cells[\n",
    "        \"sample_id\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "donor_validation_rows = []\n",
    "\n",
    "\n",
    "for donor in sorted(\n",
    "    EXPECTED_CANONICAL_DONORS\n",
    "):\n",
    "\n",
    "    observed = int(\n",
    "        observed_donor_counts.get(\n",
    "            donor,\n",
    "            0\n",
    "        )\n",
    "    )\n",
    "\n",
    "    expected = int(\n",
    "        EXPECTED_AUTHOR_NUCLEI[\n",
    "            donor\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    donor_validation_rows.append({\n",
    "\n",
    "        \"sample_id\":\n",
    "            donor,\n",
    "\n",
    "        \"expected_author_nuclei\":\n",
    "            expected,\n",
    "\n",
    "        \"observed_cell_table_nuclei\":\n",
    "            observed,\n",
    "\n",
    "        \"exact_match\":\n",
    "            bool(\n",
    "                observed\n",
    "                ==\n",
    "                expected\n",
    "            ),\n",
    "\n",
    "    })\n",
    "\n",
    "\n",
    "donor_validation = pd.DataFrame(\n",
    "    donor_validation_rows\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PER-DONOR NUCLEUS COUNT VALIDATION\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    donor_validation\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    donor_validation[\n",
    "        \"exact_match\"\n",
    "    ]\n",
    "    .all()\n",
    "), (\n",
    "    \"Canonical donor mapping does not reproduce \"\n",
    "    \"the authors' per-donor nucleus counts.\"\n",
    ")\n",
    "\n",
    "\n",
    "# Disease totals\n",
    "pd_cell_total = int(\n",
    "\n",
    "    cells[\n",
    "        cells[\n",
    "            \"sample_id\"\n",
    "        ]\n",
    "        .str.startswith(\n",
    "            \"IPD\"\n",
    "        )\n",
    "    ].shape[\n",
    "        0\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "control_cell_total = int(\n",
    "\n",
    "    cells[\n",
    "        cells[\n",
    "            \"sample_id\"\n",
    "        ]\n",
    "        .str.startswith(\n",
    "            \"C\"\n",
    "        )\n",
    "    ].shape[\n",
    "        0\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert pd_cell_total == 19002\n",
    "\n",
    "assert control_cell_total == 22433\n",
    "\n",
    "assert (\n",
    "    pd_cell_total\n",
    "    +\n",
    "    control_cell_total\n",
    "    ==\n",
    "    41435\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPatient mapping validation: PASS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PD nuclei:\",\n",
    "    f\"{pd_cell_total:,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Control nuclei:\",\n",
    "    f\"{control_cell_total:,}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. JOIN GEO DONOR METADATA\n",
    "# ============================================================\n",
    "\n",
    "donor_lookup = (\n",
    "\n",
    "    donor_meta[\n",
    "        [\n",
    "            \"sample_id\",\n",
    "            \"diagnosis_binary\",\n",
    "            \"age\",\n",
    "            \"sex\",\n",
    "            \"PMI\",\n",
    "        ]\n",
    "    ]\n",
    "    .copy()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "cells = cells.merge(\n",
    "\n",
    "    donor_lookup,\n",
    "\n",
    "    on=\"sample_id\",\n",
    "\n",
    "    how=\"left\",\n",
    "\n",
    "    validate=\"many_to_one\"\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    cells[\n",
    "        \"diagnosis_binary\"\n",
    "    ]\n",
    "    .notna()\n",
    "    .all()\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    cells[\n",
    "        \"age\"\n",
    "    ]\n",
    "    .notna()\n",
    "    .all()\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    cells[\n",
    "        \"sex\"\n",
    "    ]\n",
    "    .notna()\n",
    "    .all()\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    cells[\n",
    "        \"PMI\"\n",
    "    ]\n",
    "    .notna()\n",
    "    .all()\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. AUTHOR CELL-TYPE LABELS\n",
    "# ============================================================\n",
    "\n",
    "cells[\n",
    "    \"author_cell_type\"\n",
    "] = (\n",
    "\n",
    "    cells[\n",
    "        \"cell_ontology\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "author_cell_counts = (\n",
    "\n",
    "    cells[\n",
    "        \"author_cell_type\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .rename_axis(\n",
    "        \"author_cell_type\"\n",
    "    )\n",
    "    .reset_index(\n",
    "        name=\"n_nuclei\"\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"AUTHOR CELL-TYPE LABELS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    author_cell_counts\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. AUTHOR LABEL → HOMOLOGOUS BROAD CLASS\n",
    "#\n",
    "# Disease blind.\n",
    "# Uses author-provided cell_ontology only.\n",
    "# ============================================================\n",
    "\n",
    "def canonical_cell_class(\n",
    "    label\n",
    "):\n",
    "\n",
    "    text = (\n",
    "        str(\n",
    "            label\n",
    "        )\n",
    "        .strip()\n",
    "        .lower()\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # OPC BEFORE general oligodendrocyte\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    if (\n",
    "        text in {\n",
    "            \"opc\",\n",
    "            \"opcs\",\n",
    "        }\n",
    "        or\n",
    "        \"oligodendrocyte precursor\"\n",
    "        in text\n",
    "        or\n",
    "        \"oligodendrocyte progenitor\"\n",
    "        in text\n",
    "    ):\n",
    "\n",    "        return \"OPC\"\n",
    "\n",
    "\n",
    "    if (\n",
    "        \"astro\"\n",
    "        in text\n",
    "    ):\n",
    "\n",
    "        return \"Astro\"\n",
    "\n",
    "\n",
    "    if (\n",
    "        \"microgl\"\n",
    "        in text\n",
    "    ):\n",
    "\n",
    "        return \"Micro\"\n",
    "\n",
    "\n",
    "    if (\n",
    "        \"oligodend\"\n",
    "        in text\n",
    "    ):\n",
    "\n",
    "        return \"Oligo\"\n",
    "\n",
    "\n",
    "    if (\n",
    "        \"endothel\"\n",
    "        in text\n",
    "    ):\n",
    "\n",
    "        return \"Endothelial\"\n",
    "\n",
    "\n",
    "    if (\n",
    "        \"pericy\"\n",
    "        in text\n",
    "    ):\n",
    "\n",
    "        return \"Pericyte\"\n",
    "\n",
    "\n",
    "    if (\n",
    "        \"epend\"\n",
    "        in text\n",
    "    ):\n",
    "\n",
    "        return \"Ependymal\"\n",
    "\n",
    "\n",
    "    if (\n",
    "        \"cadps2\"\n",
    "        in text\n",
    "    ):\n",
    "\n",
    "        return \"CADPS2_neuron\"\n",
    "\n",
    "\n",
    "    if (\n",
    "        \"dopamin\"\n",
    "        in text\n",
    "        or\n",
    "        text in {\n",
    "            \"dan\",\n",
    "            \"dans\",\n",
    "        }\n",
    "    ):\n",
    "\n",
    "        return \"Dopaminergic_neuron\"\n",
    "\n",
    "\n",
    "    if (\n",
    "        \"gaba\"\n",
    "        in text\n",
    "    ):\n",
    "\n",
    "        return \"GABA_neuron\"\n",
    "\n",
    "\n",
    "    if (\n",
    "        \"excit\"\n",
    "        in text\n",
    "    ):\n",
    "\n",
    "        return \"Excitatory_neuron\"\n",
    "\n",
    "\n",
    "    if (\n",
    "        \"inhibit\"\n",
    "        in text\n",
    "    ):\n",
    "\n",
    "        return \"Inhibitory_neuron\"\n",
    "\n",
    "\n",
    "    if (\n",
    "        \"neuron\"\n",
    "        in text\n",
    "    ):\n",
    "\n",
    "        return \"Other_neuron\"\n",
    "\n",
    "\n",
    "    return \"Other\"\n",
    "\n",
    "\n",
    "cells[\n",
    "    \"canonical_cell_class\"\n",
    "] = (\n",
    "\n",
    "    cells[\n",
    "        \"author_cell_type\"\n",
    "    ]\n",
    "    .map(\n",
    "        canonical_cell_class\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "author_mapping = (\n",
    "\n",
    "    cells[\n",
    "        [\n",
    "            \"author_cell_type\",\n",
    "            \"canonical_cell_class\",\n",
    "        ]\n",
    "    ]\n",
    "    .drop_duplicates()\n",
    "    .sort_values(\n",
    "        [\n",
    "            \"canonical_cell_class\",\n",
    "            \"author_cell_type\",\n",
    "        ]\n",
    "    )\n",
    "    .reset_index(\n",
    "        drop=True\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"AUTHOR → CANONICAL CELL-TYPE MAPPING\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    author_mapping\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Explicitly display anything left unmapped.\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "unmapped_labels = (\n",
    "\n",
    "    author_mapping[\n",
    "        author_mapping[\n",
    "            \"canonical_cell_class\"\n",
    "        ]\n",
    "        ==\n",
    "        \"Other\"\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "if len(\n",
    "    unmapped_labels\n",
    ") > 0:\n",
    "\n",
    "    print(\n",
    "        \"\\nWARNING — labels mapped to Other:\"\n",
    "    )\n",
    "\n",
    "    display(\n",
    "        unmapped_labels\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. BROAD CELL-CLASS COUNTS\n",
    "# ============================================================\n",
    "\n",
    "canonical_counts = (\n",
    "\n",
    "    cells[\n",
    "        \"canonical_cell_class\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .rename_axis(\n",
    "        \"canonical_cell_class\"\n",
    "    )\n",
    "    .reset_index(\n",
    "        name=\"n_nuclei\"\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"BROAD CELL-CLASS COUNTS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    canonical_counts\n",
    ")\n",
    "\n",
    "\n",
    "TARGET_CLASSES = [\n",
    "\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "assert (\n",
    "    set(\n",
    "        TARGET_CLASSES\n",
    "    )\n",
    "    <=\n",
    "    set(\n",
    "        cells[\n",
    "            \"canonical_cell_class\"\n",
    "        ]\n",
    "    )\n",
    "), (\n",
    "    \"One or more discovery target classes \"\n",
    "    \"are absent after author-label mapping.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. DONOR × CELL-CLASS COUNTS\n",
    "# ============================================================\n",
    "\n",
    "donor_cell_counts = (\n",
    "\n",
    "    cells\n",
    "    .groupby(\n",
    "        [\n",
    "            \"sample_id\",\n",
    "            \"diagnosis_binary\",\n",
    "            \"canonical_cell_class\",\n",
    "        ],\n",
    "        observed=True\n",
    "    )\n",
    "    .size()\n",
    "    .reset_index(\n",
    "        name=\"n_nuclei\"\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "donor_cell_matrix = (\n",
    "\n",
    "    donor_cell_counts\n",
    "    .pivot_table(\n",
    "\n",
    "        index=[\n",
    "            \"sample_id\",\n",
    "            \"diagnosis_binary\",\n",
    "        ],\n",
    "\n",
    "        columns=\n",
    "            \"canonical_cell_class\",\n",
    "\n",
    "        values=\n",
    "            \"n_nuclei\",\n",
    "\n",
    "        aggfunc=\"sum\",\n",
    "\n",
    "        fill_value=0,\n",
    "\n",
    "    )\n",
    "    .reset_index()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"DONOR × CELL-CLASS COUNTS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    donor_cell_matrix\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. TARGET-CLASS COVERAGE\n",
    "#\n",
    "# We inspect:\n",
    "#   >=1\n",
    "#   >=20\n",
    "#   >=50\n",
    "#\n",
    "# NO threshold is selected yet.\n",
    "# ============================================================\n",
    "\n",
    "coverage_rows = []\n",
    "\n",
    "\n",
    "donor_base = (\n",
    "\n",
    "    donor_meta[\n",
    "        [\n",
    "            \"sample_id\",\n",
    "            \"diagnosis_binary\",\n",
    "        ]\n",
    "    ]\n",
    "    .copy()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "for cell_class in TARGET_CLASSES:\n",
    "\n",
    "\n",
    "    class_counts = (\n",
    "\n",
    "        donor_cell_counts[\n",
    "            donor_cell_counts[\n",
    "                \"canonical_cell_class\"\n",
    "            ]\n",
    "            ==\n",
    "            cell_class\n",
    "        ]\n",
    "        [\n",
    "            [\n",
    "                \"sample_id\",\n",
    "                \"n_nuclei\",\n",
    "            ]\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    class_complete = donor_base.merge(\n",
    "\n",
    "        class_counts,\n",
    "\n",
    "        on=\"sample_id\",\n",
    "\n",
    "        how=\"left\",\n",
    "\n",
    "        validate=\"one_to_one\"\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    class_complete[\n",
    "        \"n_nuclei\"\n",
    "    ] = (\n",
    "\n",
    "        class_complete[\n",
    "            \"n_nuclei\"\n",
    "        ]\n",
    "        .fillna(\n",
    "            0\n",
    "        )\n",
    "        .astype(\n",
    "            int\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    for threshold in [\n",
    "\n",
    "        1,\n",
    "        20,\n",
    "        50,\n",
    "\n",
    "    ]:\n",
    "\n",
    "\n",
    "        eligible = (\n",
    "\n",
    "            class_complete[\n",
    "                class_complete[\n",
    "                    \"n_nuclei\"\n",
    "                ]\n",
    "                >=\n",
    "                threshold\n",
    "            ]\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        diagnosis_counts = (\n",
    "\n",
    "            eligible[\n",
    "                \"diagnosis_binary\"\n",
    "            ]\n",
    "            .value_counts()\n",
    "            .to_dict()\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        coverage_rows.append({\n",
    "\n",
    "            \"cell_class\":\n",
    "                cell_class,\n",
    "\n",
    "            \"min_nuclei\":\n",
    "                threshold,\n",
    "\n",
    "            \"PD\":\n",
    "                int(\n",
    "                    diagnosis_counts.get(\n",
    "                        \"PD\",\n",
    "                        0\n",
    "                    )\n",
    "                ),\n",
    "\n",
    "            \"Control\":\n",
    "                int(\n",
    "                    diagnosis_counts.get(\n",
    "                        \"Control\",\n",
    "                        0\n",
    "                    )\n",
    "                ),\n",
    "\n",
    "            \"Total\":\n",
    "                int(\n",
    "                    len(\n",
    "                        eligible\n",
    "                    )\n",
    "                ),\n",
    "\n",
    "            \"all_11_donors_min\":\n",
    "                int(\n",
    "                    class_complete[\n",
    "                        \"n_nuclei\"\n",
    "                    ]\n",
    "                    .min()\n",
    "                ),\n",
    "\n",
    "            \"all_11_donors_median\":\n",
    "                float(\n",
    "                    class_complete[\n",
    "                        \"n_nuclei\"\n",
    "                    ]\n",
    "                    .median()\n",
    "                ),\n",
    "\n",
    "            \"all_11_donors_max\":\n",
    "                int(\n",
    "                    class_complete[\n",
    "                        \"n_nuclei\"\n",
    "                    ]\n",
    "                    .max()\n",
    "                ),\n",
    "\n",
    "        })\n",
    "\n",
    "\n",
    "coverage = pd.DataFrame(\n",
    "    coverage_rows\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"TARGET-CELL COVERAGE\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    coverage\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 12. SAVE CELL-LEVEL AUDIT OUTPUTS\n",
    "# ============================================================\n",
    "\n",
    "cells.to_csv(\n",
    "\n",
    "    cell_metadata_output,\n",
    "\n",
    "    index=False,\n",
    "\n",
    "    compression={\n",
    "        \"method\":\n",
    "            \"gzip\",\n",
    "\n",
    "        \"compresslevel\":\n",
    "            6,\n",
    "    }\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "author_mapping.to_csv(\n",
    "    mapping_output,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "donor_cell_counts.to_csv(\n",
    "    donor_cell_counts_output,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "coverage.to_csv(\n",
    "    coverage_output,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 13. GENE FILE STRUCTURE AUDIT\n",
    "#\n",
    "# Do not assume a header.\n",
    "# ============================================================\n",
    "\n",
    "def wc_lines(\n",
    "    path\n",
    "):\n",
    "\n",
    "    output = subprocess.check_output(\n",
    "        [\n",
    "            \"wc\",\n",
    "            \"-l\",\n",
    "            str(\n",
    "                path\n",
    "            ),\n",
    "        ],\n",
    "        text=True\n",
    "    )\n",
    "\n",
    "\n",
    "    return int(\n",
    "        output.strip().split()[0]\n",
    "    )\n",
    "\n",
    "\n",
    "def first_line_fields(\n",
    "    path\n",
    "):\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rt\",\n",
    "        encoding=\"utf-8\",\n",
    "        errors=\"replace\"\n",
    "    ) as f:\n",
    "\n",
    "        line = f.readline().rstrip(\n",
    "            \"\\n\"\n",
    "        )\n",
    "\n",
    "\n",
    "    fields = line.split(\n",
    "        \"\\t\"\n",
    "    )\n",
    "\n",
    "\n",
    "    return fields\n",
    "\n",
    "\n",
    "gene_line_count = wc_lines(\n",
    "    genes_path\n",
    ")\n",
    "\n",
    "\n",
    "gene_first = first_line_fields(\n",
    "    genes_path\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"GENE FILE STRUCTURE\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Gene file lines:\",\n",
    "    f\"{gene_line_count:,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Fields in first row:\",\n",
    "    len(\n",
    "        gene_first\n",
    "    )\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"First row preview:\",\n",
    "    gene_first[\n",
    "        :10\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Inspect first five rows safely\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "gene_preview = pd.read_csv(\n",
    "    genes_path,\n",
    "    sep=\"\\t\",\n",
    "    header=None,\n",
    "    nrows=5,\n",
    "    dtype=str\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    gene_preview\n",
    ")\n",
    "\n",
    "\n",
    "gene_audit = pd.DataFrame(\n",
    "    [\n",
    "        {\n",
    "            \"file\":\n",
    "                genes_path.name,\n",
    "\n",
    "            \"bytes\":\n",
    "                int(\n",
    "                    genes_path.stat().st_size\n",
    "                ),\n",
    "\n",
    "            \"line_count\":\n",
    "                int(\n",
    "                    gene_line_count\n",
    "                ),\n",
    "\n",
    "            \"fields_first_row\":\n",
    "                int(\n",
    "                    len(\n",
    "                        gene_first\n",
    "                    )\n",
    "                ),\n",
    "\n",
    "            \"first_field\":\n",
    "                (\n",
    "                    gene_first[\n",
    "                        0\n",
    "                    ]\n",
    "                    if len(\n",
    "                        gene_first\n",
    "                    ) > 0\n",
    "                    else None\n",
    "                ),\n",
    "\n",
    "            \"second_field\":\n",
    "                (\n",
    "                    gene_first[\n",
    "                        1\n",
    "                    ]\n",
    "                    if len(\n",
    "                        gene_first\n",
    "                    ) > 1\n",
    "                    else None\n",
    "                ),\n",
    "        }\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "gene_audit.to_csv(\n",
    "    gene_audit_output,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 14. GIANT UMI TSV STRUCTURE AUDIT\n",
    "#\n",
    "# IMPORTANT:\n",
    "# We do NOT load the 2.2 GB matrix into pandas.\n",
    "#\n",
    "# wc -l and reading one line are memory-safe.\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"UMI MATRIX STRUCTURE\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "umi_line_count = wc_lines(\n",
    "    umi_path\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"UMI rows/lines:\",\n",
    "    f\"{umi_line_count:,}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Read first two lines only.\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "with open(\n",
    "    umi_path,\n",
    "    \"rt\",\n",
    "    encoding=\"utf-8\",\n",
    "    errors=\"replace\",\n",
    "    buffering=1024 * 1024\n",
    ") as f:\n",
    "\n",
    "    umi_line1 = f.readline().rstrip(\n",
    "        \"\\n\"\n",
    "    )\n",
    "\n",
    "    umi_line2 = f.readline().rstrip(\n",
    "        \"\\n\"\n",
    "    )\n",
    "\n",
    "\n",
    "umi_fields_1 = (\n",
    "    umi_line1.count(\n",
    "        \"\\t\"\n",
    "    )\n",
    "    +\n",
    "    1\n",
    ")\n",
    "\n",
    "\n",
    "umi_fields_2 = (\n",
    "    umi_line2.count(\n",
    "        \"\\t\"\n",
    "    )\n",
    "    +\n",
    "    1\n",
    ")\n",
    "\n",
    "\n",
    "line1_tokens = umi_line1.split(\n",
    "    \"\\t\"\n",
    ")\n",
    "\n",
    "\n",
    "line2_tokens = umi_line2.split(\n",
    "    \"\\t\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Fields in UMI line 1:\",\n",
    "    f\"{umi_fields_1:,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Fields in UMI line 2:\",\n",
    "    f\"{umi_fields_2:,}\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nUMI line 1 first 8 fields:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    line1_tokens[\n",
    "        :8\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nUMI line 2 first 8 fields:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    line2_tokens[\n",
    "        :8\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nUMI line 1 last 3 fields:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    line1_tokens[\n",
    "        -3:\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 15. INFER UMI MATRIX ORIENTATION\n",
    "#\n",
    "# We know:\n",
    "#\n",
    "#   author cells = 41,435\n",
    "#\n",
    "# Gene line count is determined above.\n",
    "#\n",
    "# We explicitly classify structure rather than guessing.\n",
    "# ============================================================\n",
    "\n",
    "N_CELLS = 41435\n",
    "\n",
    "\n",
    "orientation_candidates = []\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Possibility A:\n",
    "# rows = genes\n",
    "# columns = cells\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "if (\n",
    "    umi_line_count\n",
    "    in {\n",
    "        gene_line_count,\n",
    "        gene_line_count + 1,\n",
    "        gene_line_count - 1,\n",
    "    }\n",
    "):\n",
    "\n",
    "    orientation_candidates.append(\n",
    "        \"rows_approximately_genes\"\n",
    "    )\n",
    "\n",
    "\n",
    "if (\n",
    "    umi_fields_1\n",
    "    in {\n",
    "        N_CELLS,\n",
    "        N_CELLS + 1,\n",
    "    }\n",
    "    or\n",
    "    umi_fields_2\n",
    "    in {\n",
    "        N_CELLS,\n",
    "        N_CELLS + 1,\n",
    "    }\n",
    "):\n",
    "\n",
    "    orientation_candidates.append(\n",
    "        \"columns_approximately_cells\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Possibility B:\n",
    "# rows = cells\n",
    "# columns = genes\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "if (\n",
    "    umi_line_count\n",
    "    in {\n",
    "        N_CELLS,\n",
    "        N_CELLS + 1,\n",
    "    }\n",
    "):\n",
    "\n",
    "    orientation_candidates.append(\n",
    "        \"rows_approximately_cells\"\n",
    "    )\n",
    "\n",
    "\n",
    "if (\n",
    "    umi_fields_1\n",
    "    in {\n",
    "        gene_line_count,\n",
    "        gene_line_count + 1,\n",
    "        gene_line_count - 1,\n",
    "    }\n",
    "    or\n",
    "    umi_fields_2\n",
    "    in {\n",
    "        gene_line_count,\n",
    "        gene_line_count + 1,\n",
    "        gene_line_count - 1,\n",
    "    }\n",
    "):\n",
    "\n",
    "    orientation_candidates.append(\n",
    "        \"columns_approximately_genes\"\n",
    "    )\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nOrientation evidence:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    orientation_candidates\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Classify\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "if (\n",
    "    \"rows_approximately_genes\"\n",
    "    in orientation_candidates\n",
    "    and\n",
    "    \"columns_approximately_cells\"\n",
    "    in orientation_candidates\n",
    "):\n",
    "\n",
    "    inferred_orientation = (\n",
    "        \"genes_by_cells\"\n",
    "    )\n",
    "\n",
    "\n",
    "elif (\n",
    "    \"rows_approximately_cells\"\n",
    "    in orientation_candidates\n",
    "    and\n",
    "    \"columns_approximately_genes\"\n",
    "    in orientation_candidates\n",
    "):\n",
    "\n",
    "    inferred_orientation = (\n",
    "        \"cells_by_genes\"\n",
    "    )\n",
    "\n",
    "\n",
    "else:\n",
    "\n",
    "    inferred_orientation = (\n",
    "        \"requires_manual_header_interpretation\"\n",    "    )\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Inferred UMI orientation:\",\n",
    "    inferred_orientation\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 16. BARCODE ALIGNMENT AUDIT\n",
    "#\n",
    "# If one UMI row looks like a header containing 41,435\n",
    "# barcodes, compare it with the author cell table.\n",
    "# ============================================================\n",
    "\n",
    "author_barcodes = (\n",
    "\n",
    "    cells[\n",
    "        \"barcode\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .tolist()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "author_barcode_set = set(\n",
    "    author_barcodes\n",
    ")\n",
    "\n",
    "\n",
    "header_alignment = {\n",
    "    \"tested\": False,\n",
    "    \"candidate_line\": None,\n",
    "    \"n_candidate_tokens\": None,\n",
    "    \"exact_set_match\": False,\n",
    "    \"exact_order_match\": False,\n",
    "}\n",
    "\n",
    "\n",
    "# Possible header = line 1.\n",
    "for line_number, tokens in [\n",
    "\n",
    "    (\n",
    "        1,\n",
    "        line1_tokens\n",
    "    ),\n",
    "\n",
    "    (\n",
    "        2,\n",
    "        line2_tokens\n",
    "    ),\n",
    "\n",
    "]:\n",
    "\n",
    "    # Try full row and row excluding first index-like field.\n",
    "    candidate_versions = [\n",
    "\n",
    "        tokens,\n",
    "\n",
    "        tokens[\n",
    "            1:\n",
    "        ],\n",
    "\n",
    "    ]\n",
    "\n",
    "\n",
    "    for candidate in candidate_versions:\n",
    "\n",
    "        if len(\n",
    "            candidate\n",
    "        ) != N_CELLS:\n",
    "\n",
    "            continue\n",
    "\n",
    "\n",
    "        candidate_strings = list(\n",
    "            map(\n",
    "                str,\n",
    "                candidate\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "        overlap = len(\n",
    "            set(\n",
    "                candidate_strings\n",
    "            )\n",
    "            &\n",
    "            author_barcode_set\n",
    "        )\n",
    "\n",
    "\n",
    "        if overlap > 0:\n",
    "\n",
    "            header_alignment[\n",
    "                \"tested\"\n",
    "            ] = True\n",
    "\n",
    "            header_alignment[\n",
    "                \"candidate_line\"\n",
    "            ] = line_number\n",
    "\n",
    "            header_alignment[\n",
    "                \"n_candidate_tokens\"\n",
    "            ] = len(\n",
    "                candidate_strings\n",
    "            )\n",
    "\n",
    "            header_alignment[\n",
    "                \"barcode_overlap\"\n",
    "            ] = int(\n",
    "                overlap\n",
    "            )\n",
    "\n",
    "            header_alignment[\n",
    "                \"exact_set_match\"\n",
    "            ] = bool(\n",
    "                set(\n",
    "                    candidate_strings\n",
    "                )\n",
    "                ==\n",
    "                author_barcode_set\n",
    "            )\n",
    "\n",
    "            header_alignment[\n",
    "                \"exact_order_match\"\n",
    "            ] = bool(\n",
    "                candidate_strings\n",
    "                ==\n",
    "                author_barcodes\n",
    "            )\n",
    "\n",
    "            break\n",
    "\n",
    "\n",
    "    if header_alignment[\n",
    "        \"tested\"\n",
    "    ]:\n",
    "\n",
    "        break\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nBarcode-header alignment:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    header_alignment\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 17. MATRIX STRUCTURE AUDIT TABLE\n",
    "# ============================================================\n",
    "\n",
    "matrix_audit = pd.DataFrame(\n",
    "    [\n",
    "        {\n",
    "            \"UMI_file\":\n",
    "                umi_path.name,\n",
    "\n",
    "            \"UMI_bytes\":\n",
    "                int(\n",
    "                    umi_path.stat().st_size\n",
    "                ),\n",
    "\n",
    "            \"UMI_line_count\":\n",
    "                int(\n",
    "                    umi_line_count\n",
    "                ),\n",
    "\n",
    "            \"UMI_fields_line1\":\n",
    "                int(\n",
    "                    umi_fields_1\n",
    "                ),\n",
    "\n",
    "            \"UMI_fields_line2\":\n",
    "                int(\n",
    "                    umi_fields_2\n",
    "                ),\n",
    "\n",
    "            \"gene_file_lines\":\n",
    "                int(\n",
    "                    gene_line_count\n",
    "                ),\n",
    "\n",
    "            \"author_cells\":\n",
    "                int(\n",
    "                    N_CELLS\n",
    "                ),\n",
    "\n",
    "            \"inferred_orientation\":\n",
    "                inferred_orientation,\n",
    "\n",
    "            \"barcode_header_tested\":\n",
    "                bool(\n",
    "                    header_alignment[\n",
    "                        \"tested\"\n",
    "                    ]\n",
    "                ),\n",
    "\n",
    "            \"barcode_exact_set_match\":\n",
    "                bool(\n",
    "                    header_alignment.get(\n",
    "                        \"exact_set_match\",\n",
    "                        False\n",
    "                    )\n",
    "                ),\n",
    "\n",
    "            \"barcode_exact_order_match\":\n",
    "                bool(\n",
    "                    header_alignment.get(\n",
    "                        \"exact_order_match\",\n",
    "                        False\n",
    "                    )\n",
    "                ),\n",
    "        }\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "matrix_audit.to_csv(\n",
    "    matrix_audit_output,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    matrix_audit\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 18. DOWNLOAD ARCHIVE HASHES\n",
    "#\n",
    "# Reuse official downloaded archives if present.\n",
    "# ============================================================\n",
    "\n",
    "archive_paths = {\n",
    "\n",
    "    \"cell\":\n",
    "        (\n",
    "            DOWNLOAD_DIR /\n",
    "            \"GSE157783_IPDCO_hg_midbrain_cell.tar.gz\"\n",
    "        ),\n",
    "\n",
    "    \"genes\":\n",
    "        (\n",
    "            DOWNLOAD_DIR /\n",
    "            \"GSE157783_IPDCO_hg_midbrain_genes.tar.gz\"\n",
    "        ),\n",
    "\n",
    "    \"UMI\":\n",
    "        (\n",
    "            DOWNLOAD_DIR /\n",
    "            \"GSE157783_IPDCO_hg_midbrain_UMI.tar.gz\"\n",
    "        ),\n",
    "\n",
    "    \"series_matrix\":\n",
    "        (\n",
    "            DOWNLOAD_DIR /\n",
    "            \"GSE157783_series_matrix.txt.gz\"\n",
    "        ),\n",
    "}\n",
    "\n",
    "\n",
    "def sha256_file(\n",
    "    path,\n",
    "    block_size=1024 * 1024\n",
    "):\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\"\n",
    "    ) as f:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            block = f.read(\n",
    "                block_size\n",
    "            )\n",
    "\n",
    "\n",
    "            if not block:\n",
    "\n",
    "                break\n",
    "\n",
    "\n",
    "            h.update(\n",
    "                block\n",
    "            )\n",
    "\n",
    "\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "archive_records = {}\n",
    "\n",
    "\n",
    "for name, path in archive_paths.items():\n",
    "\n",
    "    assert path.exists(), (\n",
    "        f\"Missing downloaded archive: {path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    archive_records[\n",
    "        name\n",
    "    ] = {\n",
    "\n",
    "        \"path\":\n",
    "            str(\n",
    "                path\n",
    "            ),\n",
    "\n",
    "        \"bytes\":\n",
    "            int(\n",
    "                path.stat().st_size\n",
    "            ),\n",
    "\n",
    "        \"sha256\":\n",
    "            sha256_file(\n",
    "                path\n",
    "            ),\n",
    "    }\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 19. BUILD FINAL REPLICATION DATA-AUDIT LOCK\n",
    "# ============================================================\n",
    "\n",
    "AUDIT_LOCK = {\n",
    "\n",
    "    \"dataset\":\n",
    "        \"GSE157783\",\n",
    "\n",
    "    \"created_utc\":\n",
    "        datetime.now(\n",
    "            timezone.utc\n",
    "        ).isoformat(),\n",
    "\n",
    "    \"status\":\n",
    "        \"REPLICATION_DATA_AUDIT_COMPLETE\",\n",
    "\n",
    "    \"role\":\n",
    "        \"independent_PD_replication\",\n",
    "\n",
    "    \"official_design\": {\n",
    "\n",
    "        \"n_total_donors\":\n",
    "            11,\n",
    "\n",
    "        \"n_PD\":\n",
    "            5,\n",
    "\n",
    "        \"n_Control\":\n",
    "            6,\n",
    "\n",
    "        \"PD_samples\": [\n",
    "            \"IPD1\",\n",
    "            \"IPD2\",\n",
    "            \"IPD3\",\n",
    "            \"IPD4\",\n",
    "            \"IPD5\",\n",
    "        ],\n",
    "\n",
    "        \"Control_samples\": [\n",
    "            \"C1\",\n",
    "            \"C2\",\n",
    "            \"C3\",\n",
    "            \"C4\",\n",
    "            \"C5\",\n",
    "            \"C6\",\n",
    "        ],\n",
    "    },\n",
    "\n",
    "    \"author_processed_nuclei\": {\n",
    "\n",
    "        \"total\":\n",
    "            41435,\n",
    "\n",
    "        \"PD\":\n",
    "            19002,\n",
    "\n",
    "        \"Control\":\n",
    "            22433,\n",
    "\n",
    "        \"per_donor_exact_validation\":\n",
    "            True,\n",
    "    },\n",
    "\n",
    "    \"patient_label_mapping\": {\n",
    "\n",
    "        \"source_column\":\n",
    "            \"patient\",\n",
    "\n",
    "        \"canonical_target\":\n",
    "            \"GEO sample_id\",\n",
    "\n",
    "        \"validated_by_per_donor_nucleus_counts\":\n",
    "            True,\n",
    "    },\n",
    "\n",
    "    \"cell_type_annotation\": {\n",
    "\n",
    "        \"source_column\":\n",
    "            \"cell_ontology\",\n",
    "\n",
    "        \"mapping_file\":\n",
    "            str(\n",
    "                mapping_output\n",
    "            ),\n",
    "\n",
    "        \"target_replication_classes\":\n",
    "            TARGET_CLASSES,\n",
    "    },\n",
    "\n",
    "    \"official_downloaded_archives\":\n",
    "        archive_records,\n",
    "\n",
    "    \"frozen_donor_metadata\":\n",
    "        str(\n",
    "            donor_metadata_path\n",
    "        ),\n",
    "\n",
    "    \"audited_cell_metadata\":\n",
    "        str(\n",
    "            cell_metadata_output\n",
    "        ),\n",
    "\n",
    "    \"donor_cellclass_counts\":\n",
    "        str(\n",
    "            donor_cell_counts_output\n",
    "        ),\n",
    "\n",
    "    \"cellclass_coverage\":\n",
    "        str(\n",
    "            coverage_output\n",
    "        ),\n",
    "\n",
    "    \"gene_structure_audit\":\n",
    "        str(\n",
    "            gene_audit_output\n",
    "        ),\n",
    "\n",
    "    \"matrix_structure_audit\":\n",
    "        str(\n",
    "            matrix_audit_output\n",
    "        ),\n",
    "\n",
    "    \"UMI_matrix_orientation\":\n",
    "        inferred_orientation,\n",
    "\n",
    "    \"differential_expression_performed\":\n",
    "        False,\n",
    "\n",
    "    \"discovery_replication_effect_comparison_performed\":\n",
    "        False,\n",
    "\n",
    "    \"replication_gene_filter_frozen\":\n",
    "        False,\n",
    "\n",
    "    \"replication_DE_model_frozen\":\n",
    "        False,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    audit_lock_path,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        AUDIT_LOCK,\n",
    "        f,\n",
    "        indent=2\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 20. FINAL HARD ASSERTIONS\n",
    "# ============================================================\n",
    "\n",
    "assert len(\n",
    "    cells\n",
    ") == 41435\n",
    "\n",
    "\n",
    "assert pd_cell_total == 19002\n",
    "\n",
    "assert control_cell_total == 22433\n",
    "\n",
    "\n",
    "assert (\n",
    "    set(\n",
    "        TARGET_CLASSES\n",
    "    )\n",
    "    <=\n",
    "    set(\n",
    "        cells[\n",
    "            \"canonical_cell_class\"\n",
    "        ]\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    donor_validation[\n",
    "        \"exact_match\"\n",
    "    ]\n",
    "    .all()\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
