    "            \"all_gene_results\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    res = pd.read_csv(\n",
    "        result_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    mask = (\n",
    "        np.isfinite(\n",
    "            res[\n",
    "                \"padj\"\n",
    "            ]\n",
    "        )\n",
    "        &\n",
    "        (\n",
    "            res[\n",
    "                \"padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    sig_sets[\n",
    "        cell_type\n",
    "    ] = set(\n",
    "        res.loc[\n",
    "            mask,\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "    )\n",
    "\n",
    "\n",
    "shared_all_four = (\n",
    "    sig_sets[\n",
    "        \"Astro\"\n",
    "    ]\n",
    "    &\n",
    "    sig_sets[\n",
    "        \"Micro\"\n",
    "    ]\n",
    "    &\n",
    "    sig_sets[\n",
    "        \"OPC\"\n",
    "    ]\n",
    "    &\n",
    "    sig_sets[\n",
    "        \"Oligo\"\n",
    "    ]\n",
    ")\n",
