   "source": [
    "# Source analysis cell: 52\n",
    "# ============================================================\n",
    "# V2 STEP 29 — FINAL ROBUST COLAB REPLACEMENT\n",
    "# OPC >=20 SENSITIVITY + FINAL GSE157827 ROBUSTNESS\n",
    "# ============================================================\n",
    "\n",
    "import os\n",
    "import sys\n",
    "import json\n",
    "import subprocess\n",
    "import importlib.metadata\n",
    "\n",
    "from pathlib import Path\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. ENSURE GOOGLE DRIVE IS ACTUALLY MOUNTED\n",
    "# ============================================================\n",
    "\n",
    "MYDRIVE = Path(\n",
    "    \"/content/drive/MyDrive\"\n",
    ")\n",
    "\n",
    "\n",
    "if not MYDRIVE.exists():\n",
    "\n",
    "    try:\n",
    "\n",
    "        from google.colab import drive\n",
    "\n",
    "        drive.mount(\n",
    "            \"/content/drive\",\n",
    "            force_remount=False,\n",
    "        )\n",
    "\n",
    "    except Exception as e:\n",
    "\n",
    "        raise RuntimeError(\n",
    "            \"Google Drive is not mounted and could not be \"\n",
    "            \"mounted automatically.\"\n",
    "        ) from e\n",
    "\n",
    "\n",
    "assert MYDRIVE.exists(), (\n",
    "    f\"Google Drive is not visible at: {MYDRIVE}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. EXACT LOCK NAMES FROM YOUR STEP 27 / STEP 28\n",
    "# ============================================================\n",
    "\n",
    "PRE_NAME = (\n",
    "    \"GSE157827_AD_REPLICATION_PRE_DE_\"\n",
    "    \"PSEUDOBULK_AND_GENE_UNIVERSE_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "S28_NAME = (\n",
    "    \"GSE157827_AD_REPLICATION_STEP28_EFFECTS_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "FINAL_NAME = (\n",
    "    \"GSE157827_AD_REPLICATION_FINAL_ROBUSTNESS_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "EXPECTED_ROOT = (\n",
    "    MYDRIVE\n",
    "    /\n",
    "    \"RETINA_ND_V2\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. LOCATE THE REAL PROJECT ROOT\n",
    "#\n",
    "# Do not blindly assume the folder path.\n",
    "# Locate a root containing BOTH successful upstream locks.\n",
    "# ============================================================\n",
    "\n",
    "def locate_root():\n",
    "\n",
    "    expected_pre = (\n",
    "        EXPECTED_ROOT\n",
    "        /\n",
    "        \"locks\"\n",
    "        /\n",
    "        PRE_NAME\n",
    "    )\n",
    "\n",
    "\n",
    "    expected_s28 = (\n",
    "        EXPECTED_ROOT\n",
    "        /\n",
    "        \"locks\"\n",
    "        /\n",
    "        S28_NAME\n",
    "    )\n",
    "\n",
    "\n",
    "    if (\n",
    "        expected_pre.exists()\n",
    "        and\n",
    "        expected_s28.exists()\n",
    "    ):\n",
    "\n",
    "        return EXPECTED_ROOT\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nExpected project path does not currently expose \"\n",
    "        \"both locks.\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Searching Google Drive for the actual project...\"\n",
    "    )\n",
    "\n",
    "\n",
    "    pre_hits = list(\n",
    "        MYDRIVE.rglob(\n",
    "            PRE_NAME\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    paired_roots = []\n",
    "\n",
    "\n",
    "    for pre_path in pre_hits:\n",
    "\n",
    "        candidate_root = (\n",
    "            pre_path\n",
    "            .parent\n",
    "            .parent\n",
    "        )\n",
    "\n",
    "\n",
    "        candidate_s28 = (\n",
    "            candidate_root\n",
    "            /\n",
    "            \"locks\"\n",
    "            /\n",
    "            S28_NAME\n",
    "        )\n",
    "\n",
    "\n",
    "        if candidate_s28.exists():\n",
    "\n",
    "            paired_roots.append(\n",
    "                candidate_root\n",
    "            )\n",
    "\n",
    "\n",
    "    # Deduplicate paths.\n",
    "    unique_roots = []\n",
    "\n",
    "    seen = set()\n",
    "\n",
    "\n",
    "    for root in paired_roots:\n",
    "\n",
    "        key = str(\n",
    "            root.resolve()\n",
    "        )\n",
    "\n",
    "\n",
    "        if key not in seen:\n",
    "\n",
    "            seen.add(\n",
    "                key\n",
    "            )\n",
    "\n",
    "            unique_roots.append(\n",
    "                root\n",
    "            )\n",
    "\n",
    "\n",
    "    if len(\n",
    "        unique_roots\n",
    "    ) == 1:\n",
    "\n",
    "        return unique_roots[\n",
    "            0\n",
    "        ]\n",
    "\n",
    "\n",
    "    if len(\n",
    "        unique_roots\n",
    "    ) > 1:\n",
    "\n",
    "        raise RuntimeError(\n",
    "\n",
    "            \"More than one project contains BOTH the \"\n",
    "            \"STEP27 and STEP28 locks:\\n\\n\"\n",
    "\n",
    "            +\n",
    "\n",
    "            \"\\n\".join(\n",
    "                str(\n",
    "                    x\n",
    "                )\n",
    "                for x\n",
    "                in unique_roots\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "    # Diagnostic fallback.\n",
    "    s28_hits = list(\n",
    "        MYDRIVE.rglob(\n",
    "            S28_NAME\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    raise FileNotFoundError(\n",
    "\n",
    "        \"Could not locate a Google Drive project containing \"\n",
    "        \"BOTH the STEP27 and STEP28 locks.\\n\\n\"\n",
    "\n",
    "        f\"STEP27 hits:\\n\"\n",
    "        f\"{[str(x) for x in pre_hits]}\\n\\n\"\n",
    "\n",
    "        f\"STEP28 hits:\\n\"\n",
    "        f\"{[str(x) for x in s28_hits]}\"\n",
    "    )\n",
    "\n",
    "\n",
    "ROOT = locate_root()\n",
    "\n",
    "\n",
    "LOCKS = (\n",
    "    ROOT\n",
    "    /\n",
    "    \"locks\"\n",
    ")\n",
    "\n",
    "\n",
    "PRE_PATH = (\n",
    "    LOCKS\n",
    "    /\n",
    "    PRE_NAME\n",
    ")\n",
    "\n",
    "\n",
    "S28_PATH = (\n",
    "    LOCKS\n",
    "    /\n",
    "    S28_NAME\n",
    ")\n",
    "\n",
    "\n",
    "FINAL_LOCK = (\n",
    "    LOCKS\n",
    "    /\n",
    "    FINAL_NAME\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"STEP 29 — ROBUST COLAB REPLACEMENT\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Detected project root:\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    ROOT\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSTEP27 lock:\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    PRE_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSTEP28 lock:\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    S28_PATH\n",
    ")\n",
    "\n",
    "\n",
    "assert PRE_PATH.exists(), (\n",
    "    f\"STEP27 lock missing: {PRE_PATH}\"\n",
    ")\n",
    "\n",
    "\n",
    "assert S28_PATH.exists(), (\n",
    "    f\"STEP28 lock missing: {S28_PATH}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. VERIFY LOCK CONTENTS BEFORE DOING ANYTHING\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    PRE_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    pre_check = json.load(\n",
    "        f\n",
    "    )\n",
    "\n",
    "\n",
    "with open(\n",
    "    S28_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    s28_check = json.load(\n",
    "        f\n",
    "    )\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre_check[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"AD_REPLICATION_PRE_DE_PSEUDOBULK_AND_GENE_UNIVERSE_FROZEN\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    s28_check[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"AD_REPLICATION_PRIMARY_AND_PMD_EFFECTS_FROZEN\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSTEP27 lock content: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"STEP28 lock content: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. RELEASE RERUN POLICY\n",
    "# ============================================================\n",
    "\n",
    "print('Release mode: STEP 29 will be recomputed even if an older final lock exists.')\n",
    "\n",
    "# ============================================================\n",
    "# 5. ENSURE FRESH-PROCESS PACKAGE VERSIONS\n",
    "# ============================================================\n",
    "\n",
    "TARGET = {\n",
    "\n",
    "    \"pandas\":\n",
    "        \"2.3.3\",\n",
    "\n",
    "    \"pydeseq2\":\n",
    "        \"0.5.4\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "for package, version in TARGET.items():\n",
    "\n",
    "    try:\n",
    "\n",
    "        current = importlib.metadata.version(\n",
    "            package\n",
    "        )\n",
    "\n",
    "    except importlib.metadata.PackageNotFoundError:\n",
    "\n",
    "        current = None\n",
    "\n",
    "\n",
    "    if current != version:\n",
    "\n",
    "        print(\n",
    "            f\"\\nInstalling {package}=={version} \"\n",
    "            f\"(current={current})\"\n",
    "        )\n",
    "\n",
    "\n",
    "        subprocess.check_call(\n",
    "            [\n",
    "                sys.executable,\n",
    "                \"-m\",\n",
    "                \"pip\",\n",
    "                \"install\",\n",
    "                \"-q\",\n",
    "                \"--upgrade\",\n",
    "                f\"{package}=={version}\",\n",
    "            ]\n",
    "        )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. RUNNER + LOG PATHS\n",
    "# ============================================================\n",
    "\n",
    "SCRIPT_DIR = (\n",
    "    ROOT\n",
    "    /\n",
    "    \"scripts\"\n",
    ")\n",
    "\n",
    "\n",
    "LOG_DIR = (\n",
    "    ROOT\n",
    "    /\n",
    "    \"logs\"\n",
    ")\n",
    "\n",
    "\n",
    "SCRIPT_DIR.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "\n",
    "LOG_DIR.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",    "\n",
    "runner = (\n",
    "    SCRIPT_DIR\n",
    "    /\n",
    "    \"STEP29_GSE157827_FIXED.py\"\n",
    ")\n",
    "\n",
    "\n",
    "log = (\n",
    "    LOG_DIR\n",
    "    /\n",
    "    \"STEP29_GSE157827_FIXED.log\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. FRESH-PROCESS STEP29 ANALYSIS\n",
    "# ============================================================\n",
    "\n",
    "RUNNER = r\"\"\"\n",
    "import os\n",
    "import json\n",
    "import importlib.metadata\n",
    "\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from scipy.stats import (\n",
    "    spearmanr,\n",
    "    pearsonr,\n",
    ")\n",
    "\n",
    "from pydeseq2.dds import DeseqDataSet\n",
    "from pydeseq2.ds import DeseqStats\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# A. ROOT PASSED FROM THE PARENT NOTEBOOK\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(\n",
    "    os.environ[\n",
    "        \"RETINA_ND_ROOT\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "LOCKS = (\n",
    "    ROOT\n",
    "    /\n",
    "    \"locks\"\n",
    ")\n",
    "\n",
    "\n",
    "PRE_NAME = (\n",
    "    \"GSE157827_AD_REPLICATION_PRE_DE_\"\n",
    "    \"PSEUDOBULK_AND_GENE_UNIVERSE_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "S28_NAME = (\n",
    "    \"GSE157827_AD_REPLICATION_STEP28_EFFECTS_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "FINAL_NAME = (\n",
    "    \"GSE157827_AD_REPLICATION_FINAL_ROBUSTNESS_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "PRE_PATH = (\n",
    "    LOCKS\n",
    "    /\n",
    "    PRE_NAME\n",
    ")\n",
    "\n",
    "\n",
    "S28_PATH = (\n",
    "    LOCKS\n",
    "    /\n",
    "    S28_NAME\n",
    ")\n",
    "\n",
    "\n",
    "FINAL_LOCK = (\n",
    "    LOCKS\n",
    "    /\n",
    "    FINAL_NAME\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# B. ENVIRONMENT CHECK\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"STEP 29 CHILD PROCESS\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"ROOT:\",\n",
    "    ROOT\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"pandas:\",\n",
    "    pd.__version__\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"pydeseq2:\",\n",
    "    importlib.metadata.version(\n",
    "        \"pydeseq2\"\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"anndata:\",\n",
    "    importlib.metadata.version(\n",
    "        \"anndata\"\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"numpy:\",\n",
    "    np.__version__\n",
    ")\n",
    "\n",
    "\n",
    "# Directly test the API that caused the original failure.\n",
    "_test_dtype = pd.StringDtype(\n",
    "    na_value=np.nan\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"pd.StringDtype(na_value=...): PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# C. VERIFY STEP27 + STEP28 AGAIN INSIDE CHILD PROCESS\n",
    "# ============================================================\n",
    "\n",
    "assert PRE_PATH.exists(), (\n",
    "    f\"STEP27 lock disappeared: {PRE_PATH}\"\n",
    ")\n",
    "\n",
    "\n",
    "assert S28_PATH.exists(), (\n",
    "    f\"STEP28 lock disappeared: {S28_PATH}\"\n",
    ")\n",
    "\n",
    "\n",
    "with open(\n",
    "    PRE_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    pre = json.load(\n",
    "        f\n",
    "    )\n",
    "\n",
    "\n",
    "with open(\n",
    "    S28_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    s28 = json.load(\n",
    "        f\n",
    "    )\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"AD_REPLICATION_PRE_DE_PSEUDOBULK_AND_GENE_UNIVERSE_FROZEN\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre[\n",
    "        \"pseudobulk_built\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre[\n",
    "        \"gene_filter_frozen\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    s28[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"AD_REPLICATION_PRIMARY_AND_PMD_EFFECTS_FROZEN\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    s28[\n",
    "        \"primary_effects_frozen\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    s28[\n",
    "        \"PMD_effects_frozen\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nUpstream STEP27 + STEP28 locks: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# D. LOAD STEP28 EFFECT TABLES\n",
    "# ============================================================\n",
    "\n",
    "P = pd.read_csv(\n",
    "    s28[\n",
    "        \"primary_all_effects\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "S = pd.read_csv(\n",
    "    s28[\n",
    "        \"PMD_all_effects\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "required_effect_cols = {\n",
    "\n",
    "    \"cell_type\",\n",
    "    \"gene_id\",\n",
    "    \"gene_symbol\",\n",
    "    \"log2FoldChange\",\n",
    "    \"stat\",\n",
    "    \"pvalue\",\n",
    "    \"padj\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "assert required_effect_cols.issubset(\n",
    "    P.columns\n",
    ")\n",
    "\n",
    "\n",
    "assert required_effect_cols.issubset(\n",
    "    S.columns\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPrimary effects:\",\n",
    "    P.shape\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"PMD effects:\",\n",
    "    S.shape\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# E. OPC >=20 NUCLEI/DONOR SENSITIVITY\n",
    "# ============================================================\n",
    "\n",
    "rec = (\n",
    "    pre[\n",
    "        \"cell_type_gene_universes\"\n",
    "    ][\n",
    "        \"OPC\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "raw_path = Path(\n",
    "    rec[\n",
    "        \"filtered_pseudobulk_file\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "meta_path = Path(\n",
    "    rec[\n",
    "        \"eligible_donor_metadata_file\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "assert raw_path.exists(), (\n",
    "    raw_path\n",
    ")\n",
    "\n",
    "\n",
    "assert meta_path.exists(), (\n",
    "    meta_path\n",
    ")\n",
    "\n",
    "\n",
    "raw = pd.read_csv(\n",
    "    raw_path\n",
    ")\n",
    "\n",
    "\n",
    "meta = pd.read_csv(\n",
    "    meta_path\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    \"sensitivity20_eligible\"\n",
    "    in meta.columns\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# F. ROBUSTLY PARSE THE >=20 ELIGIBILITY FLAG\n",
    "# ============================================================\n",
    "\n",
    "flag = meta[\n",
    "    \"sensitivity20_eligible\"\n",
    "]\n",
    "\n",
    "\n",
    "if pd.api.types.is_bool_dtype(\n",
    "    flag\n",
    "):\n",
    "\n",
    "    eligible20 = (\n",
    "        flag\n",
    "        .fillna(\n",
    "            False\n",
    "        )\n",
    "        .astype(\n",
    "            bool\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "else:\n",
    "\n",
    "    cleaned = (\n",
    "        flag\n",
    "        .astype(str)\n",
    "        .str.strip()\n",
    "        .str.lower()\n",
    "    )\n",
    "\n",
    "\n",
    "    eligible20 = cleaned.map(\n",
    "        {\n",
    "\n",
    "            \"true\":\n",
    "                True,\n",
    "\n",
    "            \"false\":\n",
    "                False,\n",
    "\n",
    "            \"1\":\n",
    "                True,\n",
    "\n",
    "            \"0\":\n",
    "                False,\n",
    "\n",
    "            \"yes\":\n",
    "                True,\n",
    "\n",
    "            \"no\":\n",
    "                False,\n",
    "\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    if eligible20.isna().any():\n",
    "\n",
    "        bad = sorted(\n",
    "            cleaned[\n",
    "                eligible20.isna()\n",
    "            ]\n",
    "            .unique()\n",
    "            .tolist()\n",
    "        )\n",
    "\n",
    "\n",
    "        raise AssertionError(\n",
    "            \"Unexpected sensitivity20_eligible values: \"\n",
    "            f\"{bad}\"\n",
    "        )\n",
    "\n",
    "\n",
    "    eligible20 = eligible20.astype(\n",
    "        bool\n",
    "    )\n",
    "\n",
    "\n",
    "m20 = meta.loc[\n",
    "    eligible20\n",
    "].copy()\n",
    "\n",
    "\n",
    "observed = (\n",
    "\n",
    "    len(\n",
    "        m20\n",
    "    ),\n",
    "\n",
    "    int(\n",
    "        (\n",
    "            m20[\n",
    "                \"diagnosis_binary\"\n",
    "            ]\n",
    "            ==\n",
    "            \"AD\"\n",
    "        ).sum()\n",
    "    ),\n",
    "\n",
    "    int(\n",
    "        (\n",
    "            m20[\n",
    "                \"diagnosis_binary\"\n",
    "            ]\n",
    "            ==\n",
    "            \"Control\"\n",
    "        ).sum()\n",
    "    ),\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert observed == (\n",
    "    12,\n",
    "    7,\n",
    "    5,\n",
    "), observed\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nOPC >=20 cohort:\",\n",
    "    observed\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# G. CONSTRUCT COUNT MATRIX\n",
    "# ============================================================\n",
    "\n",
    "ids = (\n",
    "    raw[\n",
    "        \"gene_id\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .tolist()\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    len(\n",
    "        ids\n",
    "    )\n",
    "    ==\n",
    "    len(\n",
    "        set(\n",
    "            ids\n",
    "        )\n",
    "    )\n",
    "), (\n",
    "    \"gene_id is not unique in OPC pseudobulk.\"\n",
    ")\n",
    "\n",
    "\n",
    "groups = (\n",
    "    m20[\n",
    "        \"group_id\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .tolist()\n",
    ")\n",
    "\n",
    "\n",
    "missing_groups = sorted(\n",
    "    set(\n",
    "        groups\n",
    "    )\n",
    "    -\n",
    "    set(\n",
    "        raw.columns\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert not missing_groups, (\n",
    "    f\"Missing donor columns: {missing_groups}\"\n",
    ")\n",
    "\n",
    "\n",
    "counts = (\n",
    "    raw[\n",
    "        groups\n",
    "    ]\n",
    "    .T\n",
    ")\n",
    "\n",
    "\n",
    "counts = counts.apply(\n",
    "    pd.to_numeric,\n",
    "    errors=\"raise\",\n",
    ")\n",
    "\n",
    "\n",
    "arr = counts.to_numpy(\n",
    "    dtype=float\n",
    ")\n",
    "\n",
    "\n",
    "assert np.isfinite(\n",
    "    arr\n",
    ").all()\n",
    "\n",
    "\n",
    "assert (\n",
    "    arr\n",
    "    >=\n",
    "    0\n",
    ").all()\n",
    "\n",
    "\n",
    "assert np.allclose(\n",
    "    arr,\n",
    "    np.rint(\n",
    "        arr\n",
    "    ),\n",
    ")\n",
    "\n",
    "\n",
    "counts = pd.DataFrame(\n",
    "\n",
    "    np.rint(\n",
    "        arr\n",
    "    ).astype(\n",
    "        np.int64\n",
    "    ),\n",
    "\n",
    "    index=pd.Index(\n",
    "        groups,\n",
    "        dtype=object,\n",
    "    ),\n",
    "\n",
    "    columns=pd.Index(\n",
    "        ids,\n",
    "        dtype=object,\n",
    "    ),\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# H. DESIGN METADATA\n",
    "# ============================================================\n",
    "\n",
    "dm = m20[\n",
    "    [\n",
    "        \"group_id\",\n",
    "        \"age\",\n",
    "        \"sex\",\n",
    "        \"diagnosis_binary\",\n",
    "    ]\n",
    "].copy()\n",
    "\n",
    "\n",
    "dm[\n",
    "    \"group_id\"\n",
    "] = (\n",
    "    dm[\n",
    "        \"group_id\"\n",
    "    ]\n",
    "    .astype(str)\n",
    ")\n",
    "\n",
    "\n",
    "dm.index = pd.Index(\n",
    "    dm[\n",
    "        \"group_id\"\n",
    "    ]\n",
    "    .tolist(),\n",
    "    dtype=object,\n",
    ")\n",
    "\n",
    "\n",
    "dm = dm.drop(\n",
    "    columns=\"group_id\"\n",
    ")\n",
    "\n",
    "\n",
    "dm[\n",
    "    \"age\"\n",
    "] = pd.to_numeric(\n",
    "    dm[\n",
    "        \"age\"\n",
    "    ],\n",
    "    errors=\"raise\",\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# I. SEX NORMALIZATION\n",
    "# ============================================================\n",
    "\n",
    "sex_raw = (\n",
    "    dm[\n",
    "        \"sex\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "\n",
    "sex_map = {\n",
    "\n",
    "    \"F\":\n",
    "        \"Female\",\n",
    "\n",
    "    \"M\":\n",
    "        \"Male\",\n",
    "\n",
    "    \"Female\":\n",
    "        \"Female\",\n",
    "\n",
    "    \"Male\":\n",
    "        \"Male\",\n",
    "\n",
    "    \"female\":\n",
    "        \"Female\",\n",
    "\n",
    "    \"male\":\n",
    "        \"Male\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "dm[\n",
    "    \"sex\"\n",
    "] = sex_raw.map(\n",
    "    sex_map\n",
    ")\n",
    "\n",
    "\n",
    "if dm[\n",
    "    \"sex\"\n",
    "].isna().any():\n",
    "\n",
    "    bad = sorted(\n",
    "        sex_raw[\n",
    "            dm[\n",
    "                \"sex\"\n",
    "            ].isna()\n",
    "        ]\n",
    "        .unique()\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    raise AssertionError(\n",
    "        f\"Unexpected sex values: {bad}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# J. DIAGNOSIS NORMALIZATION\n",
    "# ============================================================\n",
    "\n",
    "diag_raw = (\n",
    "    dm[\n",
    "        \"diagnosis_binary\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "\n",
    "diag_map = {\n",
    "\n",
    "    \"Control\":\n",
    "        \"Control\",\n",
    "\n",
    "    \"control\":\n",
    "        \"Control\",\n",
    "\n",
    "    \"CTRL\":\n",
    "        \"Control\",\n",
    "\n",
    "    \"AD\":\n",
    "        \"AD\",\n",
    "\n",
    "    \"Alzheimer's disease\":\n",
    "        \"AD\",\n",
    "\n",
    "    \"Alzheimer disease\":\n",
    "        \"AD\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "dm[\n",
    "    \"diagnosis_binary\"\n",
    "] = diag_raw.map(\n",
    "    diag_map\n",
    ")\n",
    "\n",
    "\n",
    "if dm[\n",
    "    \"diagnosis_binary\"\n",
    "].isna().any():\n",
    "\n",
    "    bad = sorted(\n",
    "        diag_raw[\n",
    "            dm[\n",
    "                \"diagnosis_binary\"\n",
    "            ].isna()\n",
    "        ]\n",
    "        .unique()\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    raise AssertionError(\n",
    "        f\"Unexpected diagnosis values: {bad}\"\n",
    "    )\n",
    "\n",
    "\n",
    "dm[\n",
    "    \"sex\"\n",
    "] = pd.Categorical(\n",
    "    dm[\n",
    "        \"sex\"\n",
    "    ],\n",
    "    categories=[\n",
    "        \"Female\",\n",
    "        \"Male\",\n",
    "    ],\n",
    ")\n",
    "\n",
    "\n",
    "dm[\n",
    "    \"diagnosis_binary\"\n",
    "] = pd.Categorical(\n",
    "    dm[\n",
    "        \"diagnosis_binary\"\n",
    "    ],\n",
    "    categories=[\n",
    "        \"Control\",\n",
    "        \"AD\",\n",
    "    ],\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    counts.index.tolist()\n",
    "    ==\n",
    "    dm.index.tolist()\n",
    ")\n",
    "\n",
    "\n",
    "assert not (\n",
    "    dm[\n",
    "        \"sex\"\n",
    "    ]\n",
    "    .isna()\n",
    "    .any()\n",
    ")\n",
    "\n",
    "\n",
    "assert not (\n",
    "    dm[\n",
    "        \"diagnosis_binary\"\n",
    "    ]\n",
    "    .isna()\n",
    "    .any()\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nOPC sensitivity counts:\",\n",
    "    counts.shape\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"OPC sensitivity metadata:\",\n",
    "    dm.shape\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Sex:\",\n",
    "    dm[\n",
    "        \"sex\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Diagnosis:\",\n",
    "    dm[\n",
    "        \"diagnosis_binary\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# K. DESEQ2\n",
    "# ============================================================\n",
    "\n",
    "dds = DeseqDataSet(\n",
    "\n",
    "    counts=counts,\n",
    "\n",
    "    metadata=dm,\n",
    "\n",
    "    design=(\n",
    "        \"~ age + sex + diagnosis_binary\"\n",
    "    ),\n",
    "\n",
    "    refit_cooks=True,\n",
    "\n",
    "    n_cpus=2,\n",
    "\n",
    "    quiet=False,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nDeseqDataSet initialization: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "dds.deseq2()\n",
    "\n",
    "\n",
    "print(\n",
    "    \"DESeq2 fit: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "st = DeseqStats(\n",
    "\n",
    "    dds,\n",
    "\n",
    "    contrast=[\n",
    "        \"diagnosis_binary\",\n",
    "        \"AD\",\n",
    "        \"Control\",\n",
    "    ],\n",
    "\n",
    "    alpha=0.05,\n",
    "\n",
    "    cooks_filter=True,\n",
    "\n",
    "    independent_filter=True,\n",
    "\n",
    "    n_cpus=2,\n",
    "\n",
    "    quiet=False,\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "st.summary()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# L. EXTRACT DE RESULTS\n",
    "# ============================================================\n",
    "\n",
    "r = (\n",
    "    st\n",
    "    .results_df\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "\n",
    "r.index = (\n",
    "    r.index\n",
    "    .astype(str)\n",
    ")\n",
    "\n",
    "\n",
    "r.index.name = (\n",
    "    \"gene_id\"\n",
    ")\n",
    "\n",
    "\n",
    "r = r.reset_index()\n",
    "\n",
    "\n",
    "symbol_map = dict(\n",
    "    zip(\n",
    "        raw[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .astype(str),\n",
    "\n",
    "        raw[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str),\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "r.insert(\n",
    "\n",
    "    1,\n",
    "\n",
    "    \"gene_symbol\",\n",
    "\n",
    "    r[\n",
    "        \"gene_id\"\n",
    "    ].map(\n",
    "        symbol_map\n",
    "    ),\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    r[\n",
    "        \"gene_symbol\"\n",
    "    ]\n",
    "    .notna()\n",
    "    .all()\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# M. SAVE OPC >=20 RESULTS\n",
    "# ============================================================\n",
    "\n",
    "out = (\n",
    "\n",
    "    ROOT\n",
    "    /\n",
    "    \"GSE157827_AD_replication\"\n",
    "    /\n",
    "    \"DE\"\n",
    "    /\n",
    "    \"cellcount20_sensitivity\"\n",
    "    /\n",
    "    \"OPC\"\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "out.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",    ")\n",
    "\n",
    "\n",
    "rp = (\n",
    "    out\n",
    "    /\n",
    "    \"GSE157827_OPC_CELLCOUNT20_ALL_EFFECTS_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "r.to_csv(\n",
    "    rp,\n",
    "    index=False,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    rp.exists()\n",
    "    and\n",
    "    rp.stat().st_size > 0\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# N. PRIMARY OPC vs >=20 OPC\n",
    "# ============================================================\n",
    "\n",
    "op = (\n",
    "\n",
    "    P.loc[\n",
    "        P[\n",
    "            \"cell_type\"\n",
    "        ]\n",
    "        ==\n",
    "        \"OPC\",\n",
    "\n",
    "        [\n",
    "            \"gene_id\",\n",
    "            \"log2FoldChange\",\n",
    "            \"stat\",\n",
    "            \"padj\",\n",
    "        ],\n",
    "    ]\n",
    "\n",
    "    .rename(\n",
    "        columns={\n",
    "\n",
    "            \"log2FoldChange\":\n",
    "                \"primary_LFC\",\n",
    "\n",
    "            \"stat\":\n",
    "                \"primary_Wald\",\n",
    "\n",
    "            \"padj\":\n",
    "                \"primary_padj\",\n",
    "\n",
    "        }\n",
    "    )\n",
    "\n",
    "    .merge(\n",
    "\n",
    "        r[\n",
    "            [\n",
    "                \"gene_id\",\n",
    "                \"log2FoldChange\",\n",
    "                \"stat\",\n",
    "                \"padj\",\n",
    "            ]\n",
    "        ]\n",
    "\n",
    "        .rename(\n",
    "            columns={\n",
    "\n",
    "                \"log2FoldChange\":\n",
    "                    \"sens20_LFC\",\n",
    "\n",
    "                \"stat\":\n",
    "                    \"sens20_Wald\",\n",
    "\n",
    "                \"padj\":\n",
    "                    \"sens20_padj\",\n",
    "\n",
    "            }\n",
    "        ),\n",
    "\n",
    "        on=\"gene_id\",\n",
    "\n",
    "        how=\"inner\",\n",
    "\n",
    "        validate=\"one_to_one\",\n",
    "\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "lfc_mask = (\n",
    "\n",
    "    np.isfinite(\n",
    "        op[\n",
    "            \"primary_LFC\"\n",
    "        ]\n",
    "        .to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "    )\n",
    "\n",
    "    &\n",
    "\n",
    "    np.isfinite(\n",
    "        op[\n",
    "            \"sens20_LFC\"\n",
    "        ]\n",
    "        .to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "wald_mask = (\n",
    "\n",
    "    np.isfinite(\n",
    "        op[\n",
    "            \"primary_Wald\"\n",
    "        ]\n",
    "        .to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "    )\n",
    "\n",
    "    &\n",
    "\n",
    "    np.isfinite(\n",
    "        op[\n",
    "            \"sens20_Wald\"\n",
    "        ]\n",
    "        .to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert int(\n",
    "    lfc_mask.sum()\n",
    ") > 2\n",
    "\n",
    "\n",
    "assert int(\n",
    "    wald_mask.sum()\n",
    ") > 2\n",
    "\n",
    "\n",
    "summary = {\n",
    "\n",
    "    \"OPC_sensitivity_donors\":\n",
    "        12,\n",
    "\n",
    "    \"AD\":\n",
    "        7,\n",
    "\n",
    "    \"Control\":\n",
    "        5,\n",
    "\n",
    "    \"tested_genes\":\n",
    "        int(\n",
    "            len(\n",
    "                r\n",
    "            )\n",
    "        ),\n",
    "\n",
    "    \"FDR\":\n",
    "        int(\n",
    "            (\n",
    "                r[\n",
    "                    \"padj\"\n",
    "                ]\n",
    "                <\n",
    "                0.05\n",
    "            )\n",
    "            .fillna(\n",
    "                False\n",
    "            )\n",
    "            .sum()\n",
    "        ),\n",
    "\n",
    "    \"LFC_pearson\":\n",
    "        float(\n",
    "            pearsonr(\n",
    "\n",
    "                op.loc[\n",
    "                    lfc_mask,\n",
    "                    \"primary_LFC\",\n",
    "                ],\n",
    "\n",
    "                op.loc[\n",
    "                    lfc_mask,\n",
    "                    \"sens20_LFC\",\n",
    "                ],\n",
    "\n",
    "            ).statistic\n",
    "        ),\n",
    "\n",
    "    \"LFC_spearman\":\n",
    "        float(\n",
    "            spearmanr(\n",
    "\n",
    "                op.loc[\n",
    "                    lfc_mask,\n",
    "                    \"primary_LFC\",\n",
    "                ],\n",
    "\n",
    "                op.loc[\n",
    "                    lfc_mask,\n",
    "                    \"sens20_LFC\",\n",
    "                ],\n",
    "\n",
    "            ).statistic\n",
    "        ),\n",
    "\n",
    "    \"Wald_spearman\":\n",
    "        float(\n",
    "            spearmanr(\n",
    "\n",
    "                op.loc[\n",
    "                    wald_mask,\n",
    "                    \"primary_Wald\",\n",
    "                ],\n",
    "\n",
    "                op.loc[\n",
    "                    wald_mask,\n",
    "                    \"sens20_Wald\",\n",
    "                ],\n",
    "\n",
    "            ).statistic\n",
    "        ),\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "assert (\n",
    "    summary[\n",
    "        \"FDR\"\n",
    "    ]\n",
    "    ==\n",
    "    0\n",
    "), summary\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# O. AUDIT 4 PRIMARY OLIGO HITS AGAINST PMD MODEL\n",
    "# ============================================================\n",
    "\n",
    "ol = (\n",
    "\n",
    "    P.loc[\n",
    "        (\n",
    "            P[\n",
    "                \"cell_type\"\n",
    "            ]\n",
    "            ==\n",
    "            \"Oligo\"\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            P[\n",
    "                \"padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "    ]\n",
    "\n",
    "    .merge(\n",
    "\n",
    "        S.loc[\n",
    "            S[\n",
    "                \"cell_type\"\n",
    "            ]\n",
    "            ==\n",
    "            \"Oligo\",\n",
    "\n",
    "            [\n",
    "                \"gene_id\",\n",
    "                \"log2FoldChange\",\n",
    "                \"pvalue\",\n",
    "                \"padj\",\n",
    "            ],\n",
    "        ],\n",
    "\n",
    "        on=\"gene_id\",\n",
    "\n",
    "        suffixes=(\n",
    "            \"_primary\",\n",
    "            \"_PMD\",\n",
    "        ),\n",
    "\n",
    "        validate=\"one_to_one\",\n",
    "\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    len(\n",
    "        ol\n",
    "    )\n",
    "    ==\n",
    "    4\n",
    "), (\n",
    "    \"Expected 4 primary Oligo FDR hits; \"\n",
    "    f\"found {len(ol)}\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "\n",
    "    np.sign(\n",
    "        ol[\n",
    "            \"log2FoldChange_primary\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    ==\n",
    "\n",
    "    np.sign(\n",
    "        ol[\n",
    "            \"log2FoldChange_PMD\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    ").all()\n",
    "\n",
    "\n",
    "assert (\n",
    "    ol[\n",
    "        \"pvalue_PMD\"\n",
    "    ]\n",
    "    <\n",
    "    0.05\n",
    ").all()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# P. FDR COUNTS\n",
    "# ============================================================\n",
    "\n",
    "primary_fdr = {\n",
    "\n",
    "    str(\n",
    "        ct\n",
    "    ):\n",
    "        int(\n",
    "            (\n",
    "                group[\n",
    "                    \"padj\"\n",
    "                ]\n",
    "                <\n",
    "                0.05\n",
    "            )\n",
    "            .fillna(\n",
    "                False\n",
    "            )\n",
    "            .sum()\n",
    "        )\n",
    "\n",
    "    for ct, group\n",
    "    in P.groupby(\n",
    "        \"cell_type\",\n",
    "        observed=False,\n",
    "    )\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "pmd_fdr = {\n",
    "\n",
    "    str(\n",
    "        ct\n",
    "    ):\n",
    "        int(\n",
    "            (\n",
    "                group[\n",
    "                    \"padj\"\n",
    "                ]\n",
    "                <\n",
    "                0.05\n",
    "            )\n",
    "            .fillna(\n",
    "                False\n",
    "            )\n",
    "            .sum()\n",
    "        )\n",
    "\n",
    "    for ct, group\n",
    "    in S.groupby(\n",
    "        \"cell_type\",\n",
    "        observed=False,\n",
    "    )\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# Q. FINAL LOCK\n",
    "# ============================================================\n",
    "\n",
    "oligo_columns = [\n",
    "\n",
    "    \"gene_id\",\n",
    "\n",
    "    \"gene_symbol\",\n",
    "\n",
    "    \"log2FoldChange_primary\",\n",
    "\n",
    "    \"padj_primary\",\n",
    "\n",
    "    \"log2FoldChange_PMD\",\n",
    "\n",
    "    \"pvalue_PMD\",\n",
    "\n",
    "    \"padj_PMD\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "for column in oligo_columns:\n",
    "\n",
    "    assert column in ol.columns, (\n",
    "        column\n",
    "    )\n",
    "\n",
    "\n",
    "lock = {\n",
    "\n",
    "    \"dataset\":\n",
    "        \"GSE157827\",\n",
    "\n",
    "    \"status\":\n",
    "        \"AD_REPLICATION_FINAL_ROBUSTNESS_FROZEN\",\n",
    "\n",
    "    \"GSE157827_replication_robustness_complete\":\n",
    "        True,\n",
    "\n",
    "    \"OPC_cellcount20\":\n",
    "        summary,\n",
    "\n",
    "    \"OPC_cellcount20_all_effects\":\n",
    "        str(\n",
    "            rp\n",
    "        ),\n",
    "\n",
    "    \"primary_FDR_counts\":\n",
    "        primary_fdr,\n",
    "\n",
    "    \"PMD_FDR_counts\":\n",
    "        pmd_fdr,\n",
    "\n",
    "    \"Oligo_primary_FDR_hits\":\n",
    "        ol[\n",
    "            oligo_columns\n",
    "        ]\n",
    "        .to_dict(\n",
    "            \"records\"\n",
    "        ),\n",
    "\n",
    "    \"discovery_vs_replication_compared\":\n",
    "        False,\n",
    "\n",
    "    \"AD_PD_convergence_performed\":\n",
    "        False,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    FINAL_LOCK,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        lock,\n",
    "        f,\n",
    "        indent=2,\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# R. FINAL REPORT\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"STEP 29 PASS — GSE157827 FINAL ROBUSTNESS FROZEN\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    json.dumps(\n",
    "        summary,\n",
    "        indent=2,\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPrimary FDR counts:\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    json.dumps(\n",
    "        primary_fdr,\n",
    "        indent=2,\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPMD FDR counts:\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    json.dumps(\n",
    "        pmd_fdr,\n",
    "        indent=2,\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nOligo primary FDR hits with PMD support:\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    ol[\n",
    "        oligo_columns\n",
    "    ].to_string(\n",
    "        index=False\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFinal lock:\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    FINAL_LOCK\n",
    ")\n",
    "\"\"\"\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. WRITE RUNNER\n",
    "# ============================================================\n",
    "\n",
    "runner.write_text(\n",
    "    RUNNER,\n",
    "    encoding=\"utf-8\",\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    runner.exists()\n",
    "    and\n",
    "    runner.stat().st_size > 0\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. PASS THE DETECTED ROOT TO THE CHILD PROCESS\n",
    "# ============================================================\n",
    "\n",
    "env = os.environ.copy()\n",
    "\n",
    "\n",
    "env[\n",
    "    \"RETINA_ND_ROOT\"\n",
    "] = str(\n",
    "    ROOT\n",
    ")\n",
    "\n",
    "\n",
    "env[\n",
    "    \"PYTHONUNBUFFERED\"\n",
    "] = \"1\"\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nLaunching STEP 29 in a fresh Python process...\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Log:\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    log\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. STREAM ALL OUTPUT DIRECTLY INTO COLAB\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    log,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as lf:\n",
    "\n",
    "    proc = subprocess.Popen(\n",
    "\n",
    "        [\n",
    "            sys.executable,\n",
    "            \"-u\",\n",
    "            str(\n",
    "                runner\n",
    "            ),\n",
    "        ],\n",
    "\n",
    "        stdout=subprocess.PIPE,\n",
    "\n",
    "        stderr=subprocess.STDOUT,\n",
    "\n",
    "        text=True,\n",
    "\n",
    "        env=env,\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    for line in proc.stdout:\n",
    "\n",
    "        print(\n",
    "            line,\n",
    "            end=\"\",\n",
    "        )\n",
    "\n",
    "        lf.write(\n",
    "            line\n",
    "        )\n",
    "\n",
    "\n",
    "    rc = proc.wait()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. FAIL WITH THE REAL OUTPUT ALREADY VISIBLE\n",
    "# ============================================================\n",
    "\n",
    "if rc != 0:\n",
    "\n",
    "    raise RuntimeError(\n",
    "\n",
    "        f\"STEP 29 failed with exit code {rc}. \"\n",
    "        \"The full child-process traceback is printed above \"\n",
    "        f\"and saved here:\\n{log}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 12. FINAL VERIFICATION\n",
    "# ============================================================\n",
    "\n",
    "assert FINAL_LOCK.exists(), (\n",
    "    \"STEP29 completed but final lock is missing: \"\n",
    "    f\"{FINAL_LOCK}\"\n",
    ")\n",
    "\n",
    "\n",
    "with open(\n",
    "    FINAL_LOCK,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    result = json.load(\n",
    "        f\n",
    "    )\n",
    "\n",
    "\n",
    "assert (\n",
    "    result[\n",
    "        \"GSE157827_replication_robustness_complete\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"STEP 29 REPLACEMENT COMPLETED SUCCESSFULLY\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    json.dumps(\n",
    "        result[\n",
    "            \"OPC_cellcount20\"\n",
    "        ],\n",
    "        indent=2,\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nNEXT: STEP 30 — AD DISCOVERY ↔ PRIMARY REPLICATION\"\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 54\n",
    "# ============================================================\n",
    "# V2 STEP 30 — AD DISCOVERY ↔ PRIMARY REPLICATION\n",
    "# COMPLETE FIXED REPLACEMENT\n",
    "# ============================================================\n",
    "\n",
    "import json\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from scipy.stats import (\n",
    "    spearmanr,\n",
    "    binomtest,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PROJECT ROOT\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = (\n",
    "    ROOT /\n",
    "    \"locks\"\n",
    ")\n",
    "\n",
    "assert ROOT.exists(), (\n",
    "    f\"Project root missing: {ROOT}\"\n",
    ")\n",
    "\n",
    "assert LOCKS.exists(), (\n",
    "    f\"Locks directory missing: {LOCKS}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. VERIFY REQUIRED UPSTREAM ANALYSES\n",
    "# ============================================================\n",
    "\n",
    "DISCOVERY_LOCK = (\n",
    "    LOCKS /\n",
    "    \"GSE174367_AD_DISCOVERY_EFFECT_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "REPLICATION_LOCK = (\n",
    "    LOCKS /\n",
    "    \"GSE157827_AD_REPLICATION_FINAL_ROBUSTNESS_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "assert DISCOVERY_LOCK.exists(), (\n",
    "    \"Missing GSE174367 discovery effect lock:\\n\"\n",
    "    f\"{DISCOVERY_LOCK}\"\n",
    ")\n",
    "\n",
    "\n",
    "assert REPLICATION_LOCK.exists(), (\n",
    "    \"Missing GSE157827 final replication lock:\\n\"\n",
    "    f\"{REPLICATION_LOCK}\"\n",
    ")\n",
    "\n",
    "\n",
    "with open(\n",
    "    REPLICATION_LOCK,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    replication_lock = json.load(\n",
    "        f\n",
    "    )\n",
    "\n",
    "\n",
    "assert (\n",
    "    replication_lock.get(\n",
    "        \"GSE157827_replication_robustness_complete\"\n",
    "    )\n",
    "    is True\n",
    "), (\n",
    "    \"GSE157827 STEP 29 is not marked complete.\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 30 — AD DISCOVERY ↔ PRIMARY REPLICATION\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"GSE174367 discovery effects: VERIFIED\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"GSE157827 replication robustness: VERIFIED\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. LOCATE EXACT FROZEN EFFECT TABLES\n",
    "# ============================================================\n",
    "\n",
    "def one_exact(\n",
    "    filename\n",
    "):\n",
    "\n",
    "    hits = list(\n",
    "        ROOT.rglob(\n",
    "            filename\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        hits\n",
    "    ) == 1, (\n",
    "        f\"Expected exactly one file named {filename}; \"\n",
    "        f\"found {len(hits)}:\\n{hits}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    return hits[\n",
    "        0\n",
    "    ]\n",
    "\n",
    "\n",
    "AD_DISC_PATH = one_exact(\n",
    "    \"GSE174367_AD_DISCOVERY_ALL_EFFECTS_LONG_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "AD_REP_PATH = one_exact(\n",
    "    \"GSE157827_AD_REPLICATION_PRIMARY_ALL_EFFECTS_LONG_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nDiscovery effects:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    AD_DISC_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nPrimary replication effects:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    AD_REP_PATH\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. LOAD EFFECT TABLES\n",
    "# ============================================================\n",
    "\n",
    "D_raw = pd.read_csv(\n",
    "    AD_DISC_PATH,\n",
    "    compression=\"gzip\",\n",
    "    low_memory=False,\n",
    ")\n",
    "\n",
    "\n",
    "R_raw = pd.read_csv(\n",
    "    AD_REP_PATH,\n",
    "    compression=\"gzip\",\n",
    "    low_memory=False,\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nDiscovery table shape:\",\n",
    "    D_raw.shape\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Replication table shape:\",\n",
    "    R_raw.shape\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nDiscovery columns:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    D_raw.columns.tolist()\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nReplication columns:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    R_raw.columns.tolist()\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. FIX THE STEP-30 SCHEMA MISMATCH\n",
    "#\n",
    "# GSE174367 STEP 21 deliberately froze its effects as:\n",
    "#\n",
    "#   AD_vs_Control_log2FC\n",
    "#   AD_vs_Control_lfcSE\n",
    "#   AD_vs_Control_Wald\n",
    "#   AD_vs_Control_pvalue\n",
    "#   AD_vs_Control_padj\n",
    "#\n",
    "# GSE157827 STEP 28 kept ordinary PyDESeq2 names:\n",
    "#\n",
    "#   log2FoldChange\n",
    "#   lfcSE\n",
    "#   stat\n",
    "#   pvalue\n",
    "#   padj\n",
    "#\n",
    "# The old STEP 30 incorrectly assumed they already matched.\n",
    "# ============================================================\n",
    "\n",
    "DISCOVERY_RENAME = {\n",
    "\n",
    "    \"AD_vs_Control_log2FC\":\n",
    "        \"log2FoldChange\",\n",
    "\n",
    "    \"AD_vs_Control_lfcSE\":\n",
    "        \"lfcSE\",\n",
    "\n",
    "    \"AD_vs_Control_Wald\":\n",
    "        \"stat\",\n",
    "\n",
    "    \"AD_vs_Control_pvalue\":\n",
    "        \"pvalue\",\n",
    "\n",    "    \"AD_vs_Control_padj\":\n",
    "        \"padj\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "D = D_raw.rename(\n",
    "    columns=DISCOVERY_RENAME\n",
    ").copy()\n",
    "\n",
    "\n",
    "R = R_raw.copy()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. VERIFY HARMONIZED SCHEMAS\n",
    "# ============================================================\n",
    "\n",
    "REQUIRED_COLUMNS = {\n",
    "\n",
    "    \"cell_type\",\n",
    "    \"gene_id\",\n",
    "    \"gene_symbol\",\n",
    "    \"log2FoldChange\",\n",
    "    \"stat\",\n",
    "    \"pvalue\",\n",
    "    \"padj\",\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "missing_D = (\n",
    "    REQUIRED_COLUMNS\n",
    "    -\n",
    "    set(\n",
    "        D.columns\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "missing_R = (\n",
    "    REQUIRED_COLUMNS\n",
    "    -\n",
    "    set(\n",
    "        R.columns\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert not missing_D, (\n",
    "    \"GSE174367 discovery table still lacks columns \"\n",
    "    f\"after schema harmonization: {sorted(missing_D)}\"\n",
    ")\n",
    "\n",
    "\n",
    "assert not missing_R, (\n",
    "    \"GSE157827 replication table lacks columns: \"\n",
    "    f\"{sorted(missing_R)}\"\n",
    ")\n",
    "\n",
    "\n",
    "CLASSES = [\n",
    "\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "assert set(\n",
    "    CLASSES\n",
    ").issubset(\n",
    "    set(\n",
    "        D[\n",
    "            \"cell_type\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .unique()\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "assert set(\n",
    "    CLASSES\n",
    ").issubset(\n",
    "    set(\n",
    "        R[\n",
    "            \"cell_type\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .unique()\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nDiscovery/replication schema harmonization: PASS\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. UNIQUE GENE-SYMBOL HELPER\n",
    "#\n",
    "# A gene symbol duplicated within either dataset cannot be\n",
    "# mapped one-to-one across datasets.\n",
    "#\n",
    "# Those duplicated symbols are therefore excluded from this\n",
    "# cross-dataset symbol-level comparison.\n",
    "# ============================================================\n",
    "\n",
    "def unique_symbol_table(\n",
    "    table\n",
    "):\n",
    "\n",
    "    x = table.copy()\n",
    "\n",
    "\n",
    "    x[\n",
    "        \"gene_symbol\"\n",
    "    ] = (\n",
    "        x[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .str.upper()\n",
    "        .str.strip()\n",
    "    )\n",
    "\n",
    "\n",
    "    duplicated = (\n",
    "        x[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .duplicated(\n",
    "            keep=False\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    x = x.loc[\n",
    "        ~duplicated\n",
    "    ].copy()\n",
    "\n",
    "\n",
    "    assert (\n",
    "        x[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .is_unique\n",
    "    )\n",
    "\n",
    "\n",
    "    return x\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. PERMUTATION SPEARMAN TEST\n",
    "#\n",
    "# Same hypothesis as original STEP 30:\n",
    "#\n",
    "# H1 = positive discovery ↔ replication concordance\n",
    "#\n",
    "# Deterministic seed preserved.\n",
    "# ============================================================\n",
    "\n",
    "RNG = np.random.default_rng(\n",
    "    20260914\n",
    ")\n",
    "\n",
    "\n",
    "def permutation_spearman(\n",
    "    x,\n",
    "    y,\n",
    "    n_permutations=10000,\n",
    "):\n",
    "\n",
    "    x = np.asarray(\n",
    "        x,\n",
    "        dtype=float,\n",
    "    )\n",
    "\n",
    "\n",
    "    y = np.asarray(\n",
    "        y,\n",
    "        dtype=float,\n",
    "    )\n",
    "\n",
    "\n",
    "    finite = (\n",
    "        np.isfinite(\n",
    "            x\n",
    "        )\n",
    "        &\n",
    "        np.isfinite(\n",
    "            y\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    x = x[\n",
    "        finite\n",
    "    ]\n",
    "\n",
    "\n",
    "    y = y[\n",
    "        finite\n",
    "    ]\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        x\n",
    "    ) >= 3, (\n",
    "        \"Fewer than three finite matched values.\"\n",
    "    )\n",
    "\n",
    "\n",
    "    observed = float(\n",
    "        spearmanr(\n",
    "            x,\n",
    "            y,\n",
    "        ).statistic\n",
    "    )\n",
    "\n",
    "\n",
    "    assert np.isfinite(\n",
    "        observed\n",
    "    ), (\n",
    "        \"Observed Spearman correlation is non-finite.\"\n",
    "    )\n",
    "\n",
    "\n",
    "    greater_or_equal = 0\n",
    "\n",
    "\n",
    "    for _ in range(\n",
    "        n_permutations\n",
    "    ):\n",
    "\n",
    "        permuted = RNG.permutation(\n",
    "            y\n",
    "        )\n",
    "\n",
    "\n",
    "        perm_rho = float(\n",
    "            spearmanr(\n",
    "                x,\n",
    "                permuted,\n",
    "            ).statistic\n",
    "        )\n",
    "\n",
    "\n",
    "        if (\n",
    "            np.isfinite(\n",
    "                perm_rho\n",
    "            )\n",
    "            and\n",
    "            perm_rho >= observed\n",
    "        ):\n",
    "\n",
    "            greater_or_equal += 1\n",
    "\n",
    "\n",
    "    p_value = float(\n",
    "        (\n",
    "            greater_or_equal\n",
    "            +\n",
    "            1\n",
    "        )\n",
    "        /\n",
    "        (\n",
    "            n_permutations\n",
    "            +\n",
    "            1\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    return (\n",
    "        p_value,\n",
    "        observed,\n",
    "        int(\n",
    "            len(\n",
    "                x\n",
    "            )\n",
    "        ),\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. DISCOVERY ↔ PRIMARY REPLICATION\n",
    "# ============================================================\n",
    "\n",
    "summary_rows = []\n",
    "\n",
    "hit_tables = []\n",
    "\n",
    "\n",
    "for cell_type in CLASSES:\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\n\"\n",
    "        +\n",
    "        \"=\" * 90\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        cell_type\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"=\" * 90\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Discovery\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    discovery = unique_symbol_table(\n",
    "\n",
    "        D.loc[\n",
    "            D[\n",
    "                \"cell_type\"\n",
    "            ]\n",
    "            .astype(str)\n",
    "            ==\n",
    "            cell_type\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Replication\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    replication = unique_symbol_table(\n",
    "\n",
    "        R.loc[\n",
    "            R[\n",
    "                \"cell_type\"\n",
    "            ]\n",
    "            .astype(str)\n",
    "            ==\n",
    "            cell_type\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        discovery\n",
    "    ) > 0\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        replication\n",
    "    ) > 0\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # EXPLICIT COLUMN NAMING\n",
    "    #\n",
    "    # Do NOT rely on pandas merge suffixes to infer which\n",
    "    # columns should receive _disc or _rep.\n",
    "    # ========================================================\n",
    "\n",
    "    discovery_compare = (\n",
    "\n",
    "        discovery[\n",
    "            [\n",
    "                \"gene_id\",\n",
    "                \"gene_symbol\",\n",
    "                \"log2FoldChange\",\n",
    "                \"stat\",\n",
    "                \"pvalue\",\n",
    "                \"padj\",\n",
    "            ]\n",
    "        ]\n",
    "\n",
    "        .rename(\n",
    "            columns={\n",
    "\n",
    "                \"gene_id\":\n",
    "                    \"gene_id_disc\",\n",
    "\n",
    "                \"log2FoldChange\":\n",
    "                    \"log2FoldChange_disc\",\n",
    "\n",
    "                \"stat\":\n",
    "                    \"stat_disc\",\n",
    "\n",
    "                \"pvalue\":\n",
    "                    \"pvalue_disc\",\n",
    "\n",
    "                \"padj\":\n",
    "                    \"padj_disc\",\n",
    "\n",
    "            }\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    replication_compare = (\n",
    "\n",
    "        replication[\n",
    "            [\n",
    "                \"gene_id\",\n",
    "                \"gene_symbol\",\n",
    "                \"log2FoldChange\",\n",
    "                \"stat\",\n",
    "                \"pvalue\",\n",
    "                \"padj\",\n",
    "            ]\n",
    "        ]\n",
    "\n",
    "        .rename(\n",
    "            columns={\n",
    "\n",
    "                \"gene_id\":\n",
    "                    \"gene_id_rep\",\n",
    "\n",
    "                \"log2FoldChange\":\n",
    "                    \"log2FoldChange_rep\",\n",
    "\n",
    "                \"stat\":\n",
    "                    \"stat_rep\",\n",
    "\n",
    "                \"pvalue\":\n",
    "                    \"pvalue_rep\",\n",
    "\n",
    "                \"padj\":\n",
    "                    \"padj_rep\",\n",
    "\n",
    "            }\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # MATCH BY UNIQUE GENE SYMBOL\n",
    "    # ========================================================\n",
    "\n",
    "    matched = discovery_compare.merge(\n",
    "\n",
    "        replication_compare,\n",
    "\n",
    "        on=\"gene_symbol\",\n",
    "\n",
    "        how=\"inner\",\n",
    "\n",
    "        validate=\"one_to_one\",\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        matched\n",
    "    ) >= 3, (\n",
    "        f\"{cell_type}: only {len(matched)} matched genes.\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # LFC CONCORDANCE\n",
    "    # ========================================================\n",
    "\n",
    "    (\n",
    "        lfc_perm_p,\n",
    "        lfc_spearman,\n",
    "        finite_lfc_pairs,\n",
    "\n",
    "    ) = permutation_spearman(\n",
    "\n",
    "        matched[\n",
    "            \"log2FoldChange_disc\"\n",
    "        ]\n",
    "        .to_numpy(),\n",
    "\n",
    "        matched[\n",
    "            \"log2FoldChange_rep\"\n",
    "        ]\n",
    "        .to_numpy(),\n",
    "\n",
    "        n_permutations=10000,\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # WALD CONCORDANCE\n",
    "    # ========================================================\n",
    "\n",
    "    (\n",
    "        wald_perm_p,\n",
    "        wald_spearman,\n",
    "        finite_wald_pairs,\n",
    "\n",
    "    ) = permutation_spearman(\n",
    "\n",
    "        matched[\n",
    "            \"stat_disc\"\n",
    "        ]\n",
    "        .to_numpy(),\n",
    "\n",
    "        matched[\n",
    "            \"stat_rep\"\n",
    "        ]\n",
    "        .to_numpy(),\n",
    "\n",
    "        n_permutations=10000,\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # ALL-GENE DIRECTION CONCORDANCE\n",
    "    # ========================================================\n",
    "\n",
    "    finite_direction = (\n",
    "\n",
    "        np.isfinite(\n",
    "            matched[\n",
    "                \"log2FoldChange_disc\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        np.isfinite(\n",
    "            matched[\n",
    "                \"log2FoldChange_rep\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    direction_table = matched.loc[\n",
    "        finite_direction\n",
    "    ]\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        direction_table\n",
    "    ) > 0\n",
    "\n",
    "\n",
    "    same_direction_all = (\n",
    "\n",
    "        np.sign(\n",
    "            direction_table[\n",
    "                \"log2FoldChange_disc\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        ==\n",
    "\n",
    "        np.sign(\n",
    "            direction_table[\n",
    "                \"log2FoldChange_rep\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    all_gene_direction_concordance = float(\n",
    "        same_direction_all.mean()\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # DISCOVERY FDR HITS\n",
    "    # ========================================================\n",
    "\n",
    "    discovery_FDR_mask = (\n",
    "\n",
    "        np.isfinite(\n",
    "            matched[\n",
    "                \"padj_disc\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            matched[\n",
    "                \"padj_disc\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    discovery_hits = matched.loc[\n",
    "        discovery_FDR_mask\n",
    "    ].copy()\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # GENE-LEVEL REPLICATION\n",
    "    #\n",
    "    # Success =\n",
    "    #   same effect direction\n",
    "    #   AND replication nominal p < 0.05\n",
    "    # ========================================================\n",
    "\n",
    "    if len(\n",
    "        discovery_hits\n",
    "    ) > 0:\n",
    "\n",
    "\n",
    "        discovery_hits[\n",
    "            \"same_direction\"\n",
    "        ] = (\n",
    "\n",
    "            np.sign(\n",
    "                discovery_hits[\n",
    "                    \"log2FoldChange_disc\"\n",
    "                ]\n",
    "            )\n",
    "\n",
    "            ==\n",
    "\n",
    "            np.sign(\n",
    "                discovery_hits[\n",
    "                    \"log2FoldChange_rep\"\n",
    "                ]\n",
    "            )\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        discovery_hits[\n",
    "            \"nominal_replication\"\n",
    "        ] = (\n",
    "\n",
    "            np.isfinite(\n",
    "                discovery_hits[\n",
    "                    \"pvalue_rep\"\n",
    "                ]\n",
    "            )\n",
    "\n",
    "            &\n",
    "\n",
    "            (\n",
    "                discovery_hits[\n",
    "                    \"pvalue_rep\"\n",
    "                ]\n",
    "                <\n",
    "                0.05\n",
    "            )\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        discovery_hits[\n",
    "            \"gene_level_success\"\n",
    "        ] = (\n",
    "\n",
    "            discovery_hits[\n",
    "                \"same_direction\"\n",
    "            ]\n",
    "\n",
    "            &\n",
    "\n",
    "            discovery_hits[\n",
    "                \"nominal_replication\"\n",
    "            ]\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        same_direction_hits = int(\n",
    "\n",
    "            discovery_hits[\n",
    "                \"same_direction\"\n",
    "            ]\n",
    "            .sum()\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        gene_level_success = int(\n",
    "\n",
    "            discovery_hits[\n",
    "                \"gene_level_success\"\n",
    "            ]\n",
    "            .sum()\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        direction_binomial_p = float(\n",
    "\n",
    "            binomtest(\n",
    "\n",
    "                same_direction_hits,\n",
    "\n",
    "                len(\n",
    "                    discovery_hits\n",
    "                ),\n",
    "\n",
    "                p=0.5,\n",
    "\n",
    "                alternative=\"greater\",\n",
    "\n",
    "            ).pvalue\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "    else:\n",
    "\n",
    "\n",
    "        same_direction_hits = 0\n",
    "\n",
    "        gene_level_success = 0\n",
    "\n",
    "        direction_binomial_p = np.nan\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # RECORD SUMMARY\n",
    "    # ========================================================\n",
    "\n",
    "    summary_rows.append(\n",
    "        {\n",
    "\n",
    "            \"cell_type\":\n",
    "                cell_type,\n",
    "\n",
    "            \"matched_unique_genes\":\n",
    "                int(\n",
    "                    len(\n",
    "                        matched\n",
    "                    )\n",
    "                ),\n",
    "\n",
    "            \"finite_LFC_pairs\":\n",
    "                finite_lfc_pairs,\n",
    "\n",
    "            \"LFC_spearman\":\n",
    "                lfc_spearman,\n",
    "\n",
    "            \"LFC_perm_p\":\n",
    "                lfc_perm_p,\n",
    "\n",
    "            \"finite_Wald_pairs\":\n",
    "                finite_wald_pairs,\n",
    "\n",
    "            \"Wald_spearman\":\n",
    "                wald_spearman,\n",
    "\n",
    "            \"Wald_perm_p\":\n",
    "                wald_perm_p,\n",
    "\n",
    "            \"all_gene_direction_concordance\":\n",
    "                all_gene_direction_concordance,\n",
    "\n",
    "            \"discovery_FDR_measurable\":\n",
    "                int(\n",
    "                    len(\n",
    "                        discovery_hits\n",
    "                    )\n",
    "                ),\n",
    "\n",
    "            \"same_direction_hits\":\n",
    "                same_direction_hits,\n",
    "\n",
    "            \"gene_level_replication_success\":\n",
    "                gene_level_success,\n",
    "\n",
    "            \"direction_binomial_p\":\n",
    "                direction_binomial_p,\n",
    "\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # STORE DISCOVERY HIT TABLE\n",
    "    # ========================================================\n",
    "\n",
    "    if len(\n",
    "        discovery_hits\n",
    "    ) > 0:\n",
    "\n",
    "\n",
    "        discovery_hits.insert(\n",
    "            0,\n",
    "            \"cell_type\",\n",
    "            cell_type,\n",
    "        )\n",
    "\n",
    "\n",
    "        hit_tables.append(\n",
    "            discovery_hits\n",
    "        )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # PRINT CELL-TYPE RESULT\n",
    "    # ========================================================\n",
    "\n",
    "    print(\n",
    "        \"Discovery unique-symbol genes:\",\n",
    "        f\"{len(discovery):,}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Replication unique-symbol genes:\",\n",
    "        f\"{len(replication):,}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Matched unique genes:\",\n",
    "        f\"{len(matched):,}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"LFC Spearman:\",\n",
    "        lfc_spearman\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"LFC permutation P:\",\n",
    "        lfc_perm_p\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Wald Spearman:\",\n",
    "        wald_spearman\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Wald permutation P:\",\n",
    "        wald_perm_p\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"All-gene direction concordance:\",\n",
    "        all_gene_direction_concordance\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Discovery FDR hits measurable:\",\n",
    "        len(\n",
    "            discovery_hits\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Same-direction discovery hits:\",\n",
    "        same_direction_hits\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Same-direction + nominal replication:\",\n",
    "        gene_level_success\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. FINAL SUMMARY TABLE\n",
    "# ============================================================\n",
    "\n",
    "summary = pd.DataFrame(\n",
    "    summary_rows\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    summary[\n",
    "        \"cell_type\"\n",
    "    ]\n",
    "    .tolist()\n",
    "    ==\n",
    "    CLASSES\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. COMBINED DISCOVERY-HIT SUPPORT TABLE\n",
    "# ============================================================\n",
    "\n",
    "if hit_tables:\n",
    "\n",
    "    hits = pd.concat(\n",
    "        hit_tables,\n",
    "        axis=0,\n",
    "        ignore_index=True,\n",
    "    )\n",
    "\n",
    "else:\n",
    "\n",
    "    hits = pd.DataFrame(\n",
    "        columns=[\n",
    "            \"cell_type\",\n",
    "            \"gene_symbol\",\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. SAVE STEP-30 RESULTS\n",
    "# ============================================================\n",
    "\n",
    "OUT = (\n",
    "\n",
    "    ROOT /\n",
    "    \"results\" /\n",
    "    \"AD_primary_replication\"\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "OUT.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True,\n",
    ")\n",
    "\n",
    "\n",
    "SUMMARY_PATH = (\n",
    "\n",
    "    OUT /\n",
    "    \"GSE174367_vs_GSE157827_AD_REPLICATION_EVIDENCE_v1.csv\"\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "HIT_PATH = (\n",
    "\n",
    "    OUT /\n",
    "    \"GSE174367_DISCOVERY_FDR_GSE157827_SUPPORT_v1.csv.gz\"\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "summary.to_csv(\n",
    "    SUMMARY_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "hits.to_csv(\n",
    "    HIT_PATH,\n",
    "    index=False,\n",
    "    compression=\"gzip\",\n",
    ")\n",
    "\n",
    "\n",
    "assert SUMMARY_PATH.exists()\n",
    "\n",
    "\n",
    "assert HIT_PATH.exists()\n",
    "\n",
    "\n",
    "assert (\n",
    "    SUMMARY_PATH.stat().st_size\n",
    "    >\n",
    "    0\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    HIT_PATH.stat().st_size\n",
    "    >\n",
    "    0\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 12. STEP-30 LOCK\n",
    "# ============================================================\n",
    "\n",
    "STEP30_LOCK = (\n",
    "\n",
    "    LOCKS /\n",
    "    \"AD_PRIMARY_REPLICATION_EVIDENCE_FREEZE_v1.json\"\n",
    "\n",
    ")\n",    "\n",
    "\n",
    "step30_record = {\n",
    "\n",
    "    \"status\":\n",
    "        \"AD_PRIMARY_REPLICATION_EVIDENCE_FROZEN\",\n",
    "\n",
    "    \"discovery\":\n",
    "        \"GSE174367\",\n",
    "\n",
    "    \"replication\":\n",
    "        \"GSE157827\",\n",
    "\n",
    "    \"comparison_level\":\n",
    "        \"unique normalized gene symbol\",\n",
    "\n",
    "    \"discovery_effect_file\":\n",
    "        str(\n",
    "            AD_DISC_PATH\n",
    "        ),\n",
    "\n",
    "    \"replication_effect_file\":\n",
    "        str(\n",
    "            AD_REP_PATH\n",
    "        ),\n",
    "\n",
    "    \"schema_harmonization\": {\n",
    "\n",
    "        \"GSE174367_log2FC\":\n",
    "            \"AD_vs_Control_log2FC -> log2FoldChange\",\n",
    "\n",
    "        \"GSE174367_Wald\":\n",
    "            \"AD_vs_Control_Wald -> stat\",\n",
    "\n",
    "        \"GSE174367_pvalue\":\n",
    "            \"AD_vs_Control_pvalue -> pvalue\",\n",
    "\n",
    "        \"GSE174367_padj\":\n",
    "            \"AD_vs_Control_padj -> padj\",\n",
    "\n",
    "    },\n",
    "\n",
    "    \"permutation_seed\":\n",
    "        20260914,\n",
    "\n",
    "    \"permutations_per_test\":\n",
    "        10000,\n",
    "\n",
    "    \"permutation_hypothesis\":\n",
    "        \"one-sided positive Spearman concordance\",\n",
    "\n",
    "    \"gene_level_replication_rule\":\n",
    "        (\n",
    "            \"discovery FDR < 0.05 AND same direction \"\n",
    "            \"AND replication nominal p < 0.05\"\n",
    "        ),\n",
    "\n",
    "    \"summary_file\":\n",
    "        str(\n",
    "            SUMMARY_PATH\n",
    "        ),\n",
    "\n",
    "    \"hit_file\":\n",
    "        str(\n",
    "            HIT_PATH\n",
    "        ),\n",
    "\n",
    "    \"secondary_external_GSE138852_performed\":\n",
    "        False,\n",
    "\n",
    "    \"AD_PD_convergence_performed\":\n",
    "        False,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    STEP30_LOCK,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        step30_record,\n",
    "        f,\n",
    "        indent=2,\n",
    "    )\n",
    "\n",
    "\n",
    "assert STEP30_LOCK.exists()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 13. FINAL REPORT\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 30 PASS — AD PRIMARY REPLICATION EVIDENCE FROZEN\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    summary\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSaved summary:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    SUMMARY_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSaved discovery-hit replication table:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    HIT_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSTEP 30 lock:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    STEP30_LOCK\n",
    ")"
   ]
