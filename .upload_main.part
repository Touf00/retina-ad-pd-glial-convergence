   "source": [
    "# Source analysis cell: 39\n",
    "# ============================================================\n",
    "# STEP 21 — GSE174367 PRIMARY AD DISCOVERY DE\n",
    "#           + PRIMARY AD EFFECT FREEZE\n",
    "#\n",
    "# FIRST AD DISEASE-EXPRESSION ANALYSIS.\n",
    "#\n",
    "# PRIMARY MODEL:\n",
    "#     ~ age + sex + batch + diagnosis_binary\n",
    "#\n",
    "# CONTRAST:\n",
    "#     AD vs Control\n",
    "#\n",
    "# IMPORTANT\n",
    "# ---------\n",
    "# - Uses ONLY STEP-20 frozen gene universes.\n",
    "# - Uses all 18 frozen donors:\n",
    "#       11 AD\n",
    "#        7 Control\n",
    "#\n",
    "# - NO gene refiltering.\n",
    "# - NO donor changes.\n",
    "# - NO RIN sensitivity yet.\n",
    "# - NO PMI sensitivity yet.\n",
    "# - NO AD replication yet.\n",
    "# - NO AD↔PD convergence.\n",
    "#\n",
    "# At completion:\n",
    "#   1. primary AD discovery DE is complete;\n",
    "#   2. ALL tested effects are saved;\n",
    "#   3. primary AD discovery effects are frozen;\n",
    "#   4. nothing is compared with PD or AD replication.\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "import sys\n",
    "import subprocess\n",
    "from pathlib import Path\n",
    "import textwrap\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. FRESH COMPATIBLE ENVIRONMENT\n",
    "# ============================================================\n",
    "\n",
    "TARGET_PANDAS = \"2.3.3\"\n",
    "TARGET_PYDESEQ2 = \"0.5.4\"\n",
    "\n",
    "\n",
    "print(\"=\" * 80)\n",
    "print(\"STEP 21 ENVIRONMENT PREPARATION\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "\n",
    "subprocess.check_call(\n",
    "    [\n",
    "        sys.executable,\n",
    "        \"-m\",\n",
    "        \"pip\",\n",
    "        \"install\",\n",
    "        \"-q\",\n",
    "        \"--upgrade\",\n",
    "        f\"pandas=={TARGET_PANDAS}\",\n",
    "        f\"pydeseq2=={TARGET_PYDESEQ2}\",\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. WRITE FRESH STEP-21 RUNNER\n",
    "# ============================================================\n",
    "\n",
    "runner_path = Path(\n",
    "    \"/content/RETINA_ND_STEP21_GSE174367_PRIMARY_AD_DISCOVERY_DE.py\"\n",
    ")\n",
    "\n",
    "\n",
    "RUNNER = r'''\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "import platform\n",
    "import hashlib\n",
    "import json\n",
    "import gc\n",
    "import io\n",
    "import contextlib\n",
    "import importlib.metadata\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from packaging.version import Version\n",
    "\n",
    "from pydeseq2.dds import DeseqDataSet\n",
    "from pydeseq2.ds import DeseqStats\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# A. ENVIRONMENT\n",
    "# ============================================================\n",
    "\n",
    "REQUIRED_PYDESEQ2 = \"0.5.4\"\n",
    "MINIMUM_PANDAS = Version(\"2.3.0\")\n",
    "\n",
    "\n",
    "def package_version(name):\n",
    "\n",
    "    try:\n",
    "        return importlib.metadata.version(name)\n",
    "\n",
    "    except importlib.metadata.PackageNotFoundError:\n",
    "        return None\n",
    "\n",
    "\n",
    "PYDESEQ2_VERSION = package_version(\"pydeseq2\")\n",
    "PANDAS_VERSION = package_version(\"pandas\")\n",
    "ANNDATA_VERSION = package_version(\"anndata\")\n",
    "\n",
    "\n",
    "assert PYDESEQ2_VERSION == REQUIRED_PYDESEQ2\n",
    "\n",
    "assert Version(PANDAS_VERSION) >= MINIMUM_PANDAS\n",
    "\n",
    "\n",
    "# Guard against prior pandas / AnnData compatibility issue.\n",
    "_ = pd.StringDtype(\n",
    "    na_value=pd.NA\n",
    ")\n",
    "\n",
    "\n",
    "print(\"=\" * 80)\n",
    "print(\"STEP 21 FRESH SUBPROCESS ENVIRONMENT\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "print(\"Python:\", platform.python_version())\n",
    "print(\"PyDESeq2:\", PYDESEQ2_VERSION)\n",
    "print(\"AnnData:\", ANNDATA_VERSION)\n",
    "print(\"Pandas:\", PANDAS_VERSION)\n",
    "print(\"NumPy:\", np.__version__)\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# B. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = ROOT / \"locks\"\n",
    "\n",
    "DE_ROOT = (\n",
    "    ROOT /\n",
    "    \"AD_discovery_DE\"\n",
    ")\n",
    "\n",
    "FREEZE_ROOT = (\n",
    "    ROOT /\n",
    "    \"AD_discovery_frozen\"\n",
    ")\n",
    "\n",
    "\n",
