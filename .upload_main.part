    "    ) > 0\n",
    "\n",
    "    else 0\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "best_pdf_page_match = int(\n",
    "\n",
    "    pdf_candidates[\n",
    "        \"n_matching_sample_IDs\"\n",
    "    ].max()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nBest XLSX sheet sample-ID coverage:\",\n",
    "    best_xlsx_match,\n",
    "    \"/21\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Best PDF page sample-ID coverage:\",\n",
    "    best_pdf_page_match,\n",
    "    \"/21\"\n",
    ")\n",
    "\n",
    "\n",
    "# Do NOT hard-fail if PDF text extraction rearranges\n",
