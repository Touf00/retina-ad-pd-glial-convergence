   "source": [
    "# Source analysis cell: 40\n",
    "# ============================================================\n",
    "# STEP 21A — GSE174367 PRIMARY AD DISCOVERY DE AUDIT\n",
    "#\n",
    "# NO NEW DIFFERENTIAL EXPRESSION.\n",
    "# NO RIN SENSITIVITY.\n",
    "# NO PMI SENSITIVITY.\n",
    "# NO AD REPLICATION.\n",
    "# NO AD↔PD CONVERGENCE.\n",
    "#\n",
    "# PURPOSE\n",
    "# -------\n",
    "# 1. Verify STEP-21 DE + effect-freeze locks.\n",
    "# 2. Verify every all-gene result hash.\n",
    "# 3. Verify every frozen effect-vector hash.\n",
    "# 4. Verify exact STEP-20 gene universes.\n",
    "# 5. Recalculate:\n",
    "#       finite LFC\n",
    "#       finite Wald\n",
    "#       finite p\n",
    "#       finite padj\n",
    "#       FDR < 0.05\n",
    "#       up/down counts\n",
    "# 6. Confirm STEP-21 summary exactly.\n",
    "# 7. Confirm frozen effect vectors equal source DE.\n",
    "# 8. Reveal strongest PRIMARY AD results only AFTER freeze.\n",
    "# 9. Save an immutable primary-AD audit lock.\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import hashlib\n",
    "import json\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = ROOT / \"locks\"\n",
    "\n",
    "DE_ROOT = (\n",
    "    ROOT /\n",
    "    \"AD_discovery_DE\"\n",
    ")\n",
    "\n",
    "FREEZE_ROOT = (\n",
    "    ROOT /\n",
    "    \"AD_discovery_frozen\"\n",
    ")\n",
    "\n",
    "\n",
    "PRE_DE_LOCK_PATH = (\n",
    "    LOCKS /\n",
    "    \"GSE174367_AD_DISCOVERY_PRE_DE_LOCK_v1.json\"\n",
    ")\n",
    "\n",
    "DE_RUN_LOCK_PATH = (\n",
    "    LOCKS /\n",
    "    \"GSE174367_PRIMARY_AD_DISCOVERY_DE_RUN_v1.json\"\n",
    ")\n",
    "\n",
    "EFFECT_FREEZE_LOCK_PATH = (\n",
    "    LOCKS /\n",
    "    \"GSE174367_AD_DISCOVERY_EFFECT_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "SUMMARY_PATH = (\n",
    "    DE_ROOT /\n",
    "    \"GSE174367_PRIMARY_AD_DISCOVERY_DE_SUMMARY_v1.csv\"\n",
    ")\n",
    "\n",
    "AUDIT_OUTPUT_PATH = (\n",
    "    DE_ROOT /\n",
    "    \"GSE174367_PRIMARY_AD_DISCOVERY_DE_AUDIT_v1.csv\"\n",
    ")\n",
    "\n",
    "AUDIT_LOCK_PATH = (\n",
    "    LOCKS /\n",
    "    \"GSE174367_PRIMARY_AD_DISCOVERY_DE_AUDIT_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "\n",
    "    PRE_DE_LOCK_PATH,\n",
    "    DE_RUN_LOCK_PATH,\n",
    "    EFFECT_FREEZE_LOCK_PATH,\n",
    "    SUMMARY_PATH,\n",
    "\n",
    "]:\n",
    "\n",
    "    assert path.exists(), (\n",
    "        f\"Missing required file: {path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. LOAD LOCKS\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    PRE_DE_LOCK_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    pre_de_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    DE_RUN_LOCK_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    de_run_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    EFFECT_FREEZE_LOCK_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    effect_freeze = json.load(f)\n",
    "\n",
    "\n",
    "summary = pd.read_csv(\n",
    "    SUMMARY_PATH\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. LOCK INTEGRITY\n",
    "# ============================================================\n",
    "\n",
    "assert (\n",
    "    pre_de_lock[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"AD_DISCOVERY_PRE_DE_LOCK\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    de_run_lock[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"PRIMARY_AD_DISCOVERY_DE_COMPLETE\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    effect_freeze[\n",
    "        \"status\"\n",
    "    ]\n",
    "    ==\n",
    "    \"AD_DISCOVERY_EFFECTS_FROZEN\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    de_run_lock[\n",
    "        \"gene_universes_refiltered\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    de_run_lock[\n",
    "        \"donors_changed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    de_run_lock[\n",
    "        \"RIN_sensitivity_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    de_run_lock[\n",
    "        \"PMI_sensitivity_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    de_run_lock[\n",
    "        \"AD_replication_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    de_run_lock[\n",
    "        \"AD_PD_convergence_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    effect_freeze[\n",
    "        \"effects_frozen_before_RIN_sensitivity\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    effect_freeze[\n",
    "        \"effects_frozen_before_PMI_sensitivity\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    effect_freeze[\n",
    "        \"effects_frozen_before_AD_replication\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    effect_freeze[\n",
    "        \"effects_frozen_before_AD_PD_convergence\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 21 LOCK INTEGRITY: PASS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. EXPECTED CLASSES + STEP-21 COUNTS\n",
    "# ============================================================\n",
    "\n",
    "PRIMARY_CLASSES = [\n",
    "\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "EXPECTED_UNIVERSES = {\n",
    "\n",
    "    \"Astro\":\n",
    "        17289,\n",
    "\n",
    "    \"Micro\":\n",
    "        17222,\n",
    "\n",
    "    \"OPC\":\n",
    "        16641,\n",
    "\n",
    "    \"Oligo\":\n",
    "        15769,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "EXPECTED_FDR = {\n",
    "\n",
    "    \"Astro\":\n",
    "        1,\n",
    "\n",
    "    \"Micro\":\n",
    "        3,\n",
    "\n",
    "    \"OPC\":\n",
    "        0,\n",
    "\n",
    "    \"Oligo\":\n",
    "        30,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "EXPECTED_UP = {\n",
    "\n",
    "    \"Astro\":\n",
    "        0,\n",
    "\n",
    "    \"Micro\":\n",
    "        3,\n",
    "\n",
    "    \"OPC\":\n",
    "        0,\n",
    "\n",
    "    \"Oligo\":\n",
    "        24,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "EXPECTED_DOWN = {\n",
    "\n",
    "    \"Astro\":\n",
    "        1,\n",
    "\n",
    "    \"Micro\":\n",
    "        0,\n",
    "\n",
    "    \"OPC\":\n",
    "        0,\n",
    "\n",
    "    \"Oligo\":\n",
    "        6,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "assert (\n",
    "    summary[\n",
    "        \"cell_type\"\n",
    "    ].tolist()\n",
    "    ==\n",
    "    PRIMARY_CLASSES\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. HELPERS\n",
    "# ============================================================\n",
    "\n",
    "def sha256_file(\n",
    "    path,\n",
    "    block_size=1024 * 1024\n",
    "):\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\"\n",
    "    ) as f:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            block = f.read(\n",
    "                block_size\n",
    "            )\n",
    "\n",
    "\n",
    "            if not block:\n",
    "\n",
    "                break\n",
    "\n",
    "\n",
    "            h.update(\n",
    "                block\n",
    "            )\n",
    "\n",
    "\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "def ordered_gene_hash(\n",
    "    genes\n",
    "):\n",
    "\n",
    "    payload = (\n",
    "\n",
    "        \"\\n\".join(\n",
    "            map(\n",
    "                str,\n",
    "                genes\n",
    "            )\n",
    "        )\n",
    "\n",
    "        +\n",
    "\n",
    "        \"\\n\"\n",
    "\n",
    "    ).encode(\n",
    "        \"utf-8\"\n",
    "    )\n",
    "\n",
    "\n",
    "    return hashlib.sha256(\n",
    "        payload\n",
    "    ).hexdigest()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. STORAGE\n",
    "# ============================================================\n",
    "\n",
    "audit_rows = []\n",
    "\n",
    "top_tables = {}\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. AUDIT EACH CELL CLASS\n",
    "# ============================================================\n",
    "\n",
    "for cell_type in PRIMARY_CLASSES:\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\n\"\n",
    "        +\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        cell_type\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.1 LOCK RECORDS\n",
    "    # ========================================================\n",
    "\n",
    "    de_record = (\n",
    "\n",
    "        de_run_lock[\n",
    "            \"cell_class_results\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    freeze_record = (\n",
    "\n",
    "        effect_freeze[\n",
    "            \"cell_class_effect_vectors\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    universe_record = (\n",
    "\n",
    "        pre_de_lock[\n",
    "            \"cell_class_gene_universes\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.2 PATHS\n",
    "    # ========================================================\n",
    "\n",
    "    result_path = Path(\n",
    "        de_record[\n",
    "            \"all_gene_results\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    effect_path = Path(\n",
    "        freeze_record[\n",
    "            \"effect_vector_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    universe_path = Path(\n",
    "        universe_record[\n",
    "            \"gene_universe_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    for path in [\n",
    "\n",
    "        result_path,\n",
    "        effect_path,\n",
    "        universe_path,\n",
    "\n",
    "    ]:\n",
    "\n",
    "        assert path.exists(), (\n",
    "            f\"Missing file: {path}\"\n",
    "        )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.3 HASH VERIFICATION\n",
    "    # ========================================================\n",
    "\n",
    "    observed_result_hash = (\n",
    "        sha256_file(\n",
    "            result_path\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        observed_result_hash\n",
    "        ==\n",
    "        de_record[\n",
    "            \"all_gene_results_sha256\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    observed_effect_hash = (\n",
    "        sha256_file(\n",
    "            effect_path\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        observed_effect_hash\n",
    "        ==\n",
    "        freeze_record[\n",
    "            \"effect_vector_file_sha256\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Result file SHA256: PASS\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Frozen effect SHA256: PASS\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.4 LOAD TABLES\n",
    "    # ========================================================\n",
    "\n",
    "    result = pd.read_csv(\n",
    "        result_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    universe = pd.read_csv(\n",
    "        universe_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    frozen_effect = pd.read_csv(\n",
    "        effect_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    expected_n = (\n",
    "        EXPECTED_UNIVERSES[\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        result\n",
    "    ) == expected_n\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        universe\n",
    "    ) == expected_n\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        frozen_effect\n",
    "    ) == expected_n\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.5 EXACT GENE-UNIVERSE IDENTITY\n",
    "    # ========================================================\n",
    "\n",
    "    result_gene_ids = (\n",
    "\n",
    "        result[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    universe_gene_ids = (\n",
    "\n",
    "        universe[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    effect_gene_ids = (\n",
    "\n",
    "        frozen_effect[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        result_gene_ids\n",
    "        ==\n",
    "        universe_gene_ids\n",
    "        ==\n",
    "        effect_gene_ids\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        result_gene_ids\n",
    "    ) == len(\n",
    "        set(\n",
    "            result_gene_ids\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    observed_universe_hash = (\n",
    "        ordered_gene_hash(\n",
    "            result_gene_ids\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        observed_universe_hash\n",
    "        ==\n",
    "        universe_record[\n",
    "            \"ordered_gene_id_sha256\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Exact frozen gene universe: PASS\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.6 FROZEN EFFECT-VECTOR IDENTITY\n",
    "    # ========================================================\n",
    "\n",
    "    assert np.allclose(\n",
    "\n",
    "        result[\n",
    "            \"log2FoldChange\"\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        ),\n",
    "\n",
    "        frozen_effect[\n",
    "            \"AD_vs_Control_log2FC\"\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        ),\n",
    "\n",
    "        equal_nan=True\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert np.allclose(\n",
    "\n",
    "        result[\n",
    "            \"stat\"\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        ),\n",
    "\n",
    "        frozen_effect[\n",
    "            \"AD_vs_Control_Wald\"\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        ),\n",
    "\n",
    "        equal_nan=True\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert np.allclose(\n",
    "\n",
    "        result[\n",
    "            \"pvalue\"\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        ),\n",
    "\n",
    "        frozen_effect[\n",
    "            \"AD_vs_Control_pvalue\"\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        ),\n",
    "\n",
    "        equal_nan=True\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert np.allclose(\n",
    "\n",
    "        result[\n",
    "            \"padj\"\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        ),\n",
    "\n",
    "        frozen_effect[\n",
    "            \"AD_vs_Control_padj\"\n",
    "        ].to_numpy(\n",
    "            dtype=float\n",
    "        ),\n",
    "\n",
    "        equal_nan=True\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Frozen effect-vector identity: PASS\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.7 FINITE-VALUE AUDIT\n",
    "    # ========================================================\n",
    "\n",
    "    finite_lfc = np.isfinite(\n",
    "        result[\n",
    "            \"log2FoldChange\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    finite_stat = np.isfinite(\n",
    "        result[\n",
    "            \"stat\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    finite_p = np.isfinite(\n",
    "        result[\n",
    "            \"pvalue\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    finite_padj = np.isfinite(\n",
    "        result[\n",
    "            \"padj\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    n_finite_lfc = int(\n",
    "        finite_lfc.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_finite_stat = int(\n",
    "        finite_stat.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_finite_p = int(\n",
    "        finite_p.sum()\n",
    "    )\n",
    "\n",    "\n",
    "    n_finite_padj = int(\n",
    "        finite_padj.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert n_finite_lfc == expected_n\n",
    "    assert n_finite_stat == expected_n\n",
    "    assert n_finite_p == expected_n\n",
    "    assert n_finite_padj == expected_n\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.8 FDR RECALCULATION\n",
    "    # ========================================================\n",
    "\n",
    "    sig_mask = (\n",
    "\n",
    "        finite_padj\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            result[\n",
    "                \"padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    sig = (\n",
    "        result.loc[\n",
    "            sig_mask\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_sig = int(\n",
    "        sig_mask.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_up = int(\n",
    "\n",
    "        (\n",
    "            sig[\n",
    "                \"log2FoldChange\"\n",
    "            ]\n",
    "            >\n",
    "            0\n",
    "        ).sum()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_down = int(\n",
    "\n",
    "        (\n",
    "            sig[\n",
    "                \"log2FoldChange\"\n",
    "            ]\n",
    "            <\n",
    "            0\n",
    "        ).sum()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_zero = int(\n",
    "\n",
    "        (\n",
    "            sig[\n",
    "                \"log2FoldChange\"\n",
    "            ]\n",
    "            ==\n",
    "            0\n",
    "        ).sum()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.9 VERIFY STEP-21 LOCK COUNTS\n",
    "    # ========================================================\n",
    "\n",
    "    assert (\n",
    "        n_finite_lfc\n",
    "        ==\n",
    "        de_record[\n",
    "            \"n_finite_log2FoldChange\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_finite_stat\n",
    "        ==\n",
    "        de_record[\n",
    "            \"n_finite_Wald\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_finite_p\n",
    "        ==\n",
    "        de_record[\n",
    "            \"n_finite_pvalue\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_finite_padj\n",
    "        ==\n",
    "        de_record[\n",
    "            \"n_finite_padj\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_sig\n",
    "        ==\n",
    "        de_record[\n",
    "            \"n_FDR_lt_0_05\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_up\n",
    "        ==\n",
    "        de_record[\n",
    "            \"n_FDR_lt_0_05_up_in_AD\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_down\n",
    "        ==\n",
    "        de_record[\n",
    "            \"n_FDR_lt_0_05_down_in_AD\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.10 VERIFY NOTEBOOK SUMMARY\n",
    "    # ========================================================\n",
    "\n",
    "    summary_row = (\n",
    "\n",
    "        summary[\n",
    "            summary[\n",
    "                \"cell_type\"\n",
    "            ]\n",
    "            ==\n",
    "            cell_type\n",
    "        ]\n",
    "        .iloc[\n",
    "            0\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        summary_row[\n",
    "            \"tested_genes\"\n",
    "        ]\n",
    "    ) == expected_n\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        summary_row[\n",
    "            \"finite_pvalue\"\n",
    "        ]\n",
    "    ) == n_finite_p\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        summary_row[\n",
    "            \"finite_padj\"\n",
    "        ]\n",
    "    ) == n_finite_padj\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        summary_row[\n",
    "            \"FDR_lt_0.05\"\n",
    "        ]\n",
    "    ) == n_sig\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        summary_row[\n",
    "            \"up_in_AD\"\n",
    "        ]\n",
    "    ) == n_up\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        summary_row[\n",
    "            \"down_in_AD\"\n",
    "        ]\n",
    "    ) == n_down\n",
    "\n",
    "\n",
    "    # Hard verification of pasted STEP-21 result.\n",
    "    assert n_sig == EXPECTED_FDR[\n",
    "        cell_type\n",
    "    ]\n",
    "\n",
    "\n",
    "    assert n_up == EXPECTED_UP[\n",
    "        cell_type\n",
    "    ]\n",
    "\n",
    "\n",
    "    assert n_down == EXPECTED_DOWN[\n",
    "        cell_type\n",
    "    ]\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"STEP-21 aggregate counts: PASS\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.11 MINIMUM P / PADJ\n",
    "    # ========================================================\n",
    "\n",
    "    min_p = float(\n",
    "        result[\n",
    "            \"pvalue\"\n",
    "        ].min()\n",
    "    )\n",
    "\n",
    "\n",
    "    min_padj = float(\n",
    "        result[\n",
    "            \"padj\"\n",
    "        ].min()\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.12 PRIMARY AD RESULT REVEAL\n",
    "    #\n",
    "    # Effects were already frozen before this inspection.\n",
    "    #\n",
    "    # If FDR hits exist:\n",
    "    #     show up to 15 strongest FDR hits.\n",
    "    #\n",
    "    # If zero FDR hits:\n",
    "    #     show 15 smallest raw p-values,\n",
    "    #     clearly marked NON-FDR-SIGNIFICANT.\n",
    "    # ========================================================\n",
    "\n",
    "    if n_sig > 0:\n",
    "\n",
    "        reveal = (\n",
    "\n",
    "            result.loc[\n",
    "                sig_mask,\n",
    "                [\n",
    "                    \"gene_id\",\n",
    "                    \"gene_symbol\",\n",
    "                    \"gene_symbol_unique_in_GSE174367\",\n",
    "                    \"baseMean\",\n",
    "                    \"log2FoldChange\",\n",
    "                    \"stat\",\n",
    "                    \"pvalue\",\n",
    "                    \"padj\",\n",
    "                ]\n",
    "            ]\n",
    "            .sort_values(\n",
    "                [\n",
    "                    \"padj\",\n",
    "                    \"pvalue\",\n",
    "                ],\n",
    "                ascending=[\n",
    "                    True,\n",
    "                    True,\n",
    "                ]\n",
    "            )\n",
    "            .head(\n",
    "                15\n",
    "            )\n",
    "            .copy()\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        reveal[\n",
    "            \"status\"\n",
    "        ] = \"FDR<0.05\"\n",
    "\n",
    "\n",
    "    else:\n",
    "\n",
    "        reveal = (\n",
    "\n",
    "            result[\n",
    "                [\n",
    "                    \"gene_id\",\n",
    "                    \"gene_symbol\",\n",
    "                    \"gene_symbol_unique_in_GSE174367\",\n",
    "                    \"baseMean\",\n",
    "                    \"log2FoldChange\",\n",
    "                    \"stat\",\n",
    "                    \"pvalue\",\n",
    "                    \"padj\",\n",
    "                ]\n",
    "            ]\n",
    "            .sort_values(\n",
    "                \"pvalue\"\n",
    "            )\n",
    "            .head(\n",
    "                15\n",
    "            )\n",
    "            .copy()\n",
    "\n",
    "        )\n",
    "\n",
    "\n",
    "        reveal[\n",
    "            \"status\"\n",
    "        ] = \"NOT_FDR_SIGNIFICANT\"\n",
    "\n",
    "\n",
    "    top_tables[\n",
    "        cell_type\n",
    "    ] = reveal\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # 6.13 AUDIT ROW\n",
    "    # ========================================================\n",
    "\n",
    "    audit_rows.append({\n",
    "\n",
    "        \"cell_type\":\n",
    "            cell_type,\n",
    "\n",
    "        \"tested_genes\":\n",
    "            expected_n,\n",
    "\n",
    "        \"finite_LFC\":\n",
    "            n_finite_lfc,\n",
    "\n",
    "        \"finite_Wald\":\n",
    "            n_finite_stat,\n",
    "\n",
    "        \"finite_p\":\n",
    "            n_finite_p,\n",
    "\n",
    "        \"finite_padj\":\n",
    "            n_finite_padj,\n",
    "\n",
    "        \"FDR_lt_0.05\":\n",
    "            n_sig,\n",
    "\n",
    "        \"up_in_AD\":\n",
    "            n_up,\n",
    "\n",
    "        \"down_in_AD\":\n",
    "            n_down,\n",
    "\n",
    "        \"zero_LFC_FDR\":\n",
    "            n_zero,\n",
    "\n",
    "        \"min_pvalue\":\n",
    "            min_p,\n",
    "\n",
    "        \"min_padj\":\n",
    "            min_padj,\n",
    "\n",
    "        \"result_hash_verified\":\n",
    "            True,\n",
    "\n",
    "        \"effect_freeze_hash_verified\":\n",
    "            True,\n",
    "\n",
    "        \"gene_universe_verified\":\n",
    "            True,\n",
    "\n",
    "        \"effect_vector_identity_verified\":\n",
    "            True,\n",
    "\n",
    "    })\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nResult audit:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Tested genes:\",\n",
    "        f\"{expected_n:,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Finite p:\",\n",
    "        f\"{n_finite_p:,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Finite padj:\",\n",
    "        f\"{n_finite_padj:,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  FDR <0.05:\",\n",
    "        f\"{n_sig:,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Up in AD:\",\n",
    "        f\"{n_up:,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Down in AD:\",\n",
    "        f\"{n_down:,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Min p:\",\n",
    "        min_p\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Min padj:\",\n",
    "        min_padj\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. COMBINED AUDIT TABLE\n",
    "# ============================================================\n",
    "\n",
    "audit = pd.DataFrame(\n",
    "    audit_rows\n",
    ")\n",
    "\n",
    "\n",
    "audit[\n",
    "    \"cell_type\"\n",
    "] = pd.Categorical(\n",
    "\n",
    "    audit[\n",
    "        \"cell_type\"\n",
    "    ],\n",
    "\n",
    "    categories=\n",
    "        PRIMARY_CLASSES,\n",
    "\n",
    "    ordered=True\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "audit = (\n",
    "\n",
    "    audit\n",
    "    .sort_values(\n",
    "        \"cell_type\"\n",
    "    )\n",
    "    .reset_index(\n",
    "        drop=True\n",
    "    )\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "audit[\n",
    "    \"cell_type\"\n",
    "] = (\n",
    "    audit[\n",
    "        \"cell_type\"\n",
    "    ]\n",
    "    .astype(str)\n",
    ")\n",
    "\n",
    "\n",
    "audit.to_csv(\n",
    "    AUDIT_OUTPUT_PATH,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. DISPLAY AUDIT\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PRIMARY AD DISCOVERY DE AUDIT\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
    "    audit\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. PRIMARY AD TOP RESULTS\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"FROZEN PRIMARY AD DISCOVERY — TOP RESULTS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "for cell_type in PRIMARY_CLASSES:\n",
    "\n",
    "    print(\n",
    "        \"\\n\"\n",
    "        +\n",
    "        \"-\" * 80\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        cell_type\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"-\" * 80\n",
    "    )\n",
    "\n",
    "\n",
    "    display(\n",
    "        top_tables[\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. DESCRIPTIVE FDR OVERLAP BETWEEN AD CELL CLASSES\n",
    "#\n",
    "# This is descriptive only.\n",
    "# It does NOT alter the frozen inferential plan.\n",
    "# ============================================================\n",
    "\n",
    "sig_sets = {}\n",
    "\n",
    "\n",
    "for cell_type in PRIMARY_CLASSES:\n",
    "\n",
    "    result_path = Path(\n",
    "\n",
    "        de_run_lock[\n",
    "            \"cell_class_results\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ][\n",
    "            \"all_gene_results\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    result = pd.read_csv(\n",
    "        result_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    sig_mask = (\n",
    "\n",
    "        np.isfinite(\n",
    "            result[\n",
    "                \"padj\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            result[\n",
    "                \"padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        result[\n",
    "            \"gene_symbol_unique_in_GSE174367\"\n",
    "        ]\n",
    "        .astype(bool)\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    sig_sets[\n",
    "        cell_type\n",
    "    ] = set(\n",
    "\n",
    "        result.loc[\n",
    "            sig_mask,\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "shared_all_four = (\n",
    "\n",
    "    sig_sets[\n",
    "        \"Astro\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    sig_sets[\n",
    "        \"Micro\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    sig_sets[\n",
    "        \"OPC\"\n",
    "    ]\n",
    "\n",
    "    &\n",
    "\n",
    "    sig_sets[\n",
    "        \"Oligo\"\n",
    "    ]\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nUnique-symbol FDR genes shared across all four classes:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    len(\n",
    "        shared_all_four\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "if len(\n",
    "    shared_all_four\n",
    ") <= 50:\n",
    "\n",
    "    print(\n",
    "        sorted(\n",
    "            shared_all_four\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. SAVE AUDIT LOCK\n",
    "# ============================================================\n",
    "\n",
    "AUDIT_LOCK = {\n",
    "\n",
    "    \"dataset\":\n",
    "        \"GSE174367\",\n",
    "\n",
    "    \"created_utc\":\n",
    "        datetime.now(\n",
    "            timezone.utc\n",
    "        ).isoformat(),\n",
    "\n",
    "    \"status\":\n",
    "        \"PRIMARY_AD_DISCOVERY_DE_AUDIT_COMPLETE\",\n",
    "\n",
    "    \"cell_classes\":\n",
    "        PRIMARY_CLASSES,\n",
    "\n",
    "    \"all_result_hashes_verified\":\n",
    "        True,\n",
    "\n",
    "    \"all_effect_freeze_hashes_verified\":\n",
    "        True,\n",
    "\n",
    "    \"all_gene_universes_verified\":\n",
    "        True,\n",
    "\n",
    "    \"all_frozen_effect_vectors_match_source_DE\":\n",
    "        True,\n",
    "\n",
    "    \"all_tested_genes_have_finite_pvalue\":\n",
    "        True,\n",
    "\n",
    "    \"all_tested_genes_have_finite_padj\":\n",
    "        True,\n",
    "\n",
    "    \"total_primary_FDR05\":\n",
    "        int(\n",
    "            audit[\n",
    "                \"FDR_lt_0.05\"\n",
    "            ].sum()\n",
    "        ),\n",
    "\n",
    "    \"DE_rerun\":\n",
    "        False,\n",
    "\n",
    "    \"RIN_sensitivity_performed\":\n",
    "        False,\n",
    "\n",
    "    \"PMI_sensitivity_performed\":\n",
    "        False,\n",
    "\n",
    "    \"AD_replication_performed\":\n",
    "        False,\n",
    "\n",
    "    \"PD_dataset_loaded\":\n",
    "        False,\n",
    "\n",
    "    \"AD_PD_convergence_performed\":\n",
    "        False,\n",
    "\n",
    "    \"audit_table\":\n",
    "        str(\n",
    "            AUDIT_OUTPUT_PATH\n",
    "        ),\n",
    "}\n",
    "\n",
    "\n",
    "assert (\n",
    "    AUDIT_LOCK[\n",
    "        \"total_primary_FDR05\"\n",
    "    ]\n",
    "    ==\n",
    "    34\n",
    ")\n",
    "\n",
    "\n",
    "with open(\n",
    "    AUDIT_LOCK_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        AUDIT_LOCK,\n",
    "        f,\n",
    "        indent=2\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 12. FINAL\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 21A PASSED — PRIMARY AD DISCOVERY DE VERIFIED\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nTotal frozen primary AD FDR genes:\",\n",
    "    int(\n",
    "        audit[\n",
    "            \"FDR_lt_0.05\"\n",
    "        ].sum()\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nAudit table:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    AUDIT_OUTPUT_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nAudit lock:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    AUDIT_LOCK_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nNO NEW DE WAS RUN.\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"RIN SENSITIVITY: NO\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PMI SENSITIVITY: NO\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"AD REPLICATION: NO\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PD DATA LOADED: NO\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"AD↔PD CONVERGENCE: NO\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nNEXT:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 22 — run and freeze the predeclared \"\n",
    "    \"RIN and PMI technical sensitivities before \"\n",
    "    \"starting the independent AD replication cohort.\"\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 41\n",
    "# ============================================================\n",
    "# STEP 22 — GSE174367 AD DISCOVERY TECHNICAL SENSITIVITIES\n",
    "#           RIN + PMI\n",
    "#           + SENSITIVITY SUPPORT FREEZE\n",
    "#\n",
    "# PRIMARY EFFECTS ARE ALREADY FROZEN.\n",
    "#\n",
    "# PRIMARY:\n",
    "#   ~ age + sex + batch + diagnosis_binary\n",
    "#   18 donors = 11 AD + 7 Control\n",
    "#\n",
    "# RIN SENSITIVITY:\n",
    "#   ~ age + sex + batch + RIN + diagnosis_binary\n",
    "#   same 18 donors\n",
    "#\n",
    "# PMI SENSITIVITY:\n",
    "#   ~ age + sex + batch + PMI + diagnosis_binary\n",
    "#   17 complete-case donors = 11 AD + 6 Control\n",
    "#\n",
    "# IMPORTANT\n",
    "# ---------\n",
    "# - EXACT frozen STEP-20 gene universes reused.\n",
    "# - NO gene refiltering.\n",
    "# - NO disease-result-based donor dropping.\n",
    "# - The one PMI-missing donor is removed ONLY from the\n",
    "#   predeclared PMI complete-case sensitivity.\n",
    "# - NO age-overlap sensitivity.\n",
    "# - NO AD replication.\n",
    "# - NO PD data.\n",
    "# - NO AD↔PD convergence.\n",
    "#\n",
    "# PRIMARY-HIT ROBUSTNESS RULE\n",
    "# ---------------------------\n",
    "# A frozen primary FDR hit is \"technical-sensitivity supported\"\n",
    "# only when it has:\n",
    "#\n",
    "#   SAME LFC DIRECTION\n",
    "#   +\n",
    "#   nominal two-sided p < 0.05\n",
    "#\n",
    "# in BOTH:\n",
    "#   RIN sensitivity\n",
    "#   PMI sensitivity\n",
    "#\n",
    "# Sensitivity FDR persistence is reported separately and is\n",
    "# NOT required for robustness support.\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "import sys\n",
    "import subprocess\n",
    "from pathlib import Path\n",
    "import textwrap\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. ENVIRONMENT\n",
    "# ============================================================\n",
    "\n",
    "TARGET_PANDAS = \"2.3.3\"\n",
    "TARGET_PYDESEQ2 = \"0.5.4\"\n",
    "\n",
    "\n",
    "print(\"=\" * 80)\n",
    "print(\"STEP 22 ENVIRONMENT PREPARATION\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "\n",
    "subprocess.check_call(\n",
    "    [\n",
    "        sys.executable,\n",
    "        \"-m\",\n",
    "        \"pip\",\n",
    "        \"install\",\n",
    "        \"-q\",\n",
    "        \"--upgrade\",\n",
    "        f\"pandas=={TARGET_PANDAS}\",\n",
    "        f\"pydeseq2=={TARGET_PYDESEQ2}\",\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. WRITE FRESH RUNNER\n",
    "# ============================================================\n",
    "\n",
    "runner_path = Path(\n",
    "    \"/content/RETINA_ND_STEP22_GSE174367_AD_SENSITIVITIES.py\"\n",
    ")\n",
    "\n",
    "\n",
    "RUNNER = r'''\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "import platform\n",
    "import hashlib\n",
    "import json\n",
    "import gc\n",
    "import importlib.metadata\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from packaging.version import Version\n",
    "from scipy.stats import pearsonr, spearmanr\n",
    "\n",
    "from pydeseq2.dds import DeseqDataSet\n",
    "from pydeseq2.ds import DeseqStats\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# A. ENVIRONMENT\n",
    "# ============================================================\n",
    "\n",
    "REQUIRED_PYDESEQ2 = \"0.5.4\"\n",
    "MINIMUM_PANDAS = Version(\"2.3.0\")\n",
    "\n",
    "\n",
    "def package_version(name):\n",
    "\n",
    "    try:\n",
    "        return importlib.metadata.version(name)\n",
    "\n",
    "    except importlib.metadata.PackageNotFoundError:\n",
    "        return None\n",
    "\n",
    "\n",
    "PYDESEQ2_VERSION = package_version(\"pydeseq2\")\n",
    "PANDAS_VERSION = package_version(\"pandas\")\n",
    "ANNDATA_VERSION = package_version(\"anndata\")\n",    "\n",
    "\n",
    "assert PYDESEQ2_VERSION == REQUIRED_PYDESEQ2\n",
    "assert Version(PANDAS_VERSION) >= MINIMUM_PANDAS\n",
    "\n",
    "\n",
    "# Compatibility guard.\n",
    "_ = pd.StringDtype(\n",
    "    na_value=pd.NA\n",
    ")\n",
    "\n",
    "\n",
    "print(\"=\" * 80)\n",
    "print(\"STEP 22 FRESH SUBPROCESS ENVIRONMENT\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "print(\"Python:\", platform.python_version())\n",
    "print(\"PyDESeq2:\", PYDESEQ2_VERSION)\n",
    "print(\"AnnData:\", ANNDATA_VERSION)\n",
    "print(\"Pandas:\", PANDAS_VERSION)\n",
    "print(\"NumPy:\", np.__version__)\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# B. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "LOCKS = ROOT / \"locks\"\n",
    "\n",
    "SENS_ROOT = (\n",
    "    ROOT /\n",
    "    \"AD_discovery_sensitivity\"\n",
    ")\n",
    "\n",
    "SENS_ROOT.mkdir(\n",
    "    parents=True,\n",
    "    exist_ok=True\n",
    ")\n",
    "\n",
    "\n",
    "PRE_DE_LOCK_PATH = (\n",
    "    LOCKS /\n",
    "    \"GSE174367_AD_DISCOVERY_PRE_DE_LOCK_v1.json\"\n",
    ")\n",
    "\n",
    "PRIMARY_DE_LOCK_PATH = (\n",
    "    LOCKS /\n",
    "    \"GSE174367_PRIMARY_AD_DISCOVERY_DE_RUN_v1.json\"\n",
    ")\n",
    "\n",
    "PRIMARY_AUDIT_LOCK_PATH = (\n",
    "    LOCKS /\n",
    "    \"GSE174367_PRIMARY_AD_DISCOVERY_DE_AUDIT_v1.json\"\n",
    ")\n",
    "\n",
    "PRIMARY_FREEZE_PATH = (\n",
    "    LOCKS /\n",
    "    \"GSE174367_AD_DISCOVERY_EFFECT_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "SENSITIVITY_LOCK_PATH = (\n",
    "    LOCKS /\n",
    "    \"GSE174367_AD_DISCOVERY_TECHNICAL_SENSITIVITY_v1.json\"\n",
    ")\n",
    "\n",
    "SUPPORT_FREEZE_PATH = (\n",
    "    LOCKS /\n",
    "    \"GSE174367_AD_DISCOVERY_SENSITIVITY_SUPPORT_FREEZE_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "FDR_SUMMARY_PATH = (\n",
    "    SENS_ROOT /\n",
    "    \"GSE174367_AD_DISCOVERY_SENSITIVITY_FDR_SUMMARY_v1.csv\"\n",
    ")\n",
    "\n",
    "CONCORDANCE_PATH = (\n",
    "    SENS_ROOT /\n",
    "    \"GSE174367_AD_DISCOVERY_SENSITIVITY_CONCORDANCE_v1.csv\"\n",
    ")\n",
    "\n",
    "PRIMARY_HIT_SUPPORT_SUMMARY_PATH = (\n",
    "    SENS_ROOT /\n",
    "    \"GSE174367_PRIMARY_FDR_TECHNICAL_SUPPORT_SUMMARY_v1.csv\"\n",
    ")\n",
    "\n",
    "COMBINED_PRIMARY_HIT_SUPPORT_PATH = (\n",
    "    SENS_ROOT /\n",
    "    \"GSE174367_PRIMARY_FDR_TECHNICAL_SUPPORT_ALL_CLASSES_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "COMBINED_ALL_GENE_COMPARISON_PATH = (\n",
    "    SENS_ROOT /\n",
    "    \"GSE174367_PRIMARY_RIN_PMI_ALL_CLASSES_v1.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "for path in [\n",
    "\n",
    "    PRE_DE_LOCK_PATH,\n",
    "    PRIMARY_DE_LOCK_PATH,\n",
    "    PRIMARY_AUDIT_LOCK_PATH,\n",
    "    PRIMARY_FREEZE_PATH,\n",
    "\n",
    "]:\n",
    "\n",
    "    assert path.exists(), (\n",
    "        f\"Missing required lock: {path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# C. VERIFY FROZEN PRIMARY STATE\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    PRE_DE_LOCK_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    pre_de_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    PRIMARY_DE_LOCK_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    primary_lock = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    PRIMARY_AUDIT_LOCK_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    primary_audit = json.load(f)\n",
    "\n",
    "\n",
    "with open(\n",
    "    PRIMARY_FREEZE_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    primary_freeze = json.load(f)\n",
    "\n",
    "\n",
    "assert (\n",
    "    pre_de_lock[\"status\"]\n",
    "    ==\n",
    "    \"AD_DISCOVERY_PRE_DE_LOCK\"\n",
    ")\n",
    "\n",
    "assert (\n",
    "    primary_lock[\"status\"]\n",
    "    ==\n",
    "    \"PRIMARY_AD_DISCOVERY_DE_COMPLETE\"\n",
    ")\n",
    "\n",
    "assert (\n",
    "    primary_audit[\"status\"]\n",
    "    ==\n",
    "    \"PRIMARY_AD_DISCOVERY_DE_AUDIT_COMPLETE\"\n",
    ")\n",
    "\n",
    "assert (\n",
    "    primary_freeze[\"status\"]\n",
    "    ==\n",
    "    \"AD_DISCOVERY_EFFECTS_FROZEN\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    primary_audit[\n",
    "        \"total_primary_FDR05\"\n",
    "    ]\n",
    "    ==\n",
    "    34\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    primary_freeze[\n",
    "        \"effects_frozen_before_RIN_sensitivity\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "assert (\n",
    "    primary_freeze[\n",
    "        \"effects_frozen_before_PMI_sensitivity\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "assert (\n",
    "    primary_freeze[\n",
    "        \"effects_frozen_before_AD_replication\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "assert (\n",
    "    primary_freeze[\n",
    "        \"effects_frozen_before_AD_PD_convergence\"\n",
    "    ]\n",
    "    is True\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    primary_lock[\n",
    "        \"RIN_sensitivity_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "assert (\n",
    "    primary_lock[\n",
    "        \"PMI_sensitivity_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "assert (\n",
    "    primary_lock[\n",
    "        \"AD_replication_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "assert (\n",
    "    primary_lock[\n",
    "        \"AD_PD_convergence_performed\"\n",
    "    ]\n",
    "    is False\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFrozen primary AD discovery state verified.\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Primary effects frozen: YES\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"AD replication performed: NO\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PD data loaded: NO\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# D. CLASSES\n",
    "# ============================================================\n",
    "\n",
    "PRIMARY_CLASSES = [\n",
    "\n",
    "    \"Astro\",\n",
    "    \"Micro\",\n",
    "    \"OPC\",\n",
    "    \"Oligo\",\n",
    "\n",
    "]\n",
    "\n",
    "\n",
    "EXPECTED_PRIMARY_FDR = {\n",
    "\n",
    "    \"Astro\":\n",
    "        1,\n",
    "\n",
    "    \"Micro\":\n",
    "        3,\n",
    "\n",
    "    \"OPC\":\n",
    "        0,\n",
    "\n",
    "    \"Oligo\":\n",
    "        30,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# E. HELPERS\n",
    "# ============================================================\n",
    "\n",
    "def sha256_file(\n",
    "    path,\n",
    "    block_size=1024 * 1024\n",
    "):\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\"\n",
    "    ) as f:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            block = f.read(\n",
    "                block_size\n",
    "            )\n",
    "\n",
    "            if not block:\n",
    "                break\n",
    "\n",
    "            h.update(\n",
    "                block\n",
    "            )\n",
    "\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "def safe_pearson(\n",
    "    x,\n",
    "    y\n",
    "):\n",
    "\n",
    "    x = np.asarray(\n",
    "        x,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "    y = np.asarray(\n",
    "        y,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "    mask = (\n",
    "        np.isfinite(x)\n",
    "        &\n",
    "        np.isfinite(y)\n",
    "    )\n",
    "\n",
    "    if int(\n",
    "        mask.sum()\n",
    "    ) < 3:\n",
    "\n",
    "        return np.nan\n",
    "\n",
    "    return float(\n",
    "        pearsonr(\n",
    "            x[mask],\n",
    "            y[mask]\n",
    "        ).statistic\n",
    "    )\n",
    "\n",
    "\n",
    "def safe_spearman(\n",
    "    x,\n",
    "    y\n",
    "):\n",
    "\n",
    "    x = np.asarray(\n",
    "        x,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "    y = np.asarray(\n",
    "        y,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "    mask = (\n",
    "        np.isfinite(x)\n",
    "        &\n",
    "        np.isfinite(y)\n",
    "    )\n",
    "\n",
    "    if int(\n",
    "        mask.sum()\n",
    "    ) < 3:\n",
    "\n",
    "        return np.nan\n",
    "\n",
    "    return float(\n",
    "        spearmanr(\n",
    "            x[mask],\n",
    "            y[mask]\n",
    "        ).statistic\n",
    "    )\n",
    "\n",
    "\n",
    "def direction_fraction(\n",
    "    x,\n",
    "    y\n",
    "):\n",
    "\n",
    "    x = np.asarray(\n",
    "        x,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "    y = np.asarray(\n",
    "        y,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "    mask = (\n",
    "        np.isfinite(x)\n",
    "        &\n",
    "        np.isfinite(y)\n",
    "        &\n",
    "        (x != 0)\n",
    "        &\n",
    "        (y != 0)\n",
    "    )\n",
    "\n",
    "    if int(\n",
    "        mask.sum()\n",
    "    ) == 0:\n",
    "\n",
    "        return np.nan\n",
    "\n",
    "    return float(\n",
    "        (\n",
    "            np.sign(\n",
    "                x[mask]\n",
    "            )\n",
    "            ==\n",
    "            np.sign(\n",
    "                y[mask]\n",
    "            )\n",
    "        ).mean()\n",
    "    )\n",
    "\n",
    "\n",
    "def normalize_boolean(\n",
    "    series\n",
    "):\n",
    "\n",
    "    if pd.api.types.is_bool_dtype(\n",
    "        series\n",
    "    ):\n",
    "\n",
    "        return series.astype(\n",
    "            bool\n",
    "        )\n",
    "\n",
    "    return (\n",
    "        series\n",
    "        .astype(str)\n",
    "        .str.strip()\n",
    "        .str.lower()\n",
    "        .map(\n",
    "            {\n",
    "                \"true\":\n",
    "                    True,\n",
    "\n",
    "                \"false\":\n",
    "                    False,\n",
    "\n",
    "                \"1\":\n",
    "                    True,\n",
    "\n",
    "                \"0\":\n",
    "                    False,\n",
    "            }\n",
    "        )\n",
    "        .fillna(\n",
    "            False\n",
    "        )\n",
    "        .astype(\n",
    "            bool\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# F. FUNCTION — RUN ONE SENSITIVITY\n",
    "# ============================================================\n",
    "\n",
    "def run_sensitivity(\n",
    "    cell_type,\n",
    "    sensitivity_name,\n",
    "    counts_genes_by_samples,\n",
    "    metadata,\n",
    "    universe,\n",
    "    model_formula,\n",
    "):\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nRunning:\",\n",
    "        sensitivity_name\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Model:\",\n",
    "        model_formula\n",
    "    )\n",
    "\n",
    "\n",
    "    sample_order = (\n",
    "        metadata[\n",
    "            \"pseudobulk_group\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    counts_subset = (\n",
    "        counts_genes_by_samples[\n",
    "            sample_order\n",
    "        ]\n",
    "        .T\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    counts_subset.index = pd.Index(\n",
    "        counts_subset.index\n",
    "        .astype(str)\n",
    "        .tolist(),\n",
    "        dtype=\"object\"\n",
    "    )\n",
    "\n",
    "\n",
    "    counts_subset.columns = pd.Index(\n",
    "        counts_subset.columns\n",
    "        .astype(str)\n",
    "        .tolist(),\n",
    "        dtype=\"object\"\n",
    "    )\n",
    "\n",
    "\n",
    "    counts_subset = counts_subset.astype(\n",
    "        np.int64\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        counts_subset.columns.tolist()\n",
    "        ==\n",
    "        universe[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # Metadata for PyDESeq2\n",
    "    # ========================================================\n",
    "\n",
    "    metadata = metadata.copy()\n",
    "\n",
    "\n",
    "    metadata.index = pd.Index(\n",
    "        metadata[\n",
    "            \"pseudobulk_group\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist(),\n",
    "        dtype=\"object\"\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta = pd.DataFrame(\n",
    "        index=metadata.index\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta[\n",
    "        \"age\"\n",
    "    ] = pd.to_numeric(\n",
    "        metadata[\n",
    "            \"age\"\n",
    "        ].to_numpy(),\n",
    "        errors=\"raise\"\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta[\n",
    "        \"sex\"\n",
    "    ] = pd.Categorical(\n",
    "        metadata[\n",
    "            \"sex\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .to_numpy(),\n",
    "        categories=[\n",
    "            \"Female\",\n",
    "            \"Male\",\n",
    "        ],\n",
    "        ordered=False\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta[\n",
    "        \"batch\"\n",
    "    ] = pd.Categorical(\n",
    "        metadata[\n",
    "            \"batch\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .to_numpy(),\n",
    "        categories=[\n",
    "            \"1\",\n",
    "            \"2\",\n",
    "            \"3\",\n",
    "        ],\n",
    "        ordered=False\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta[\n",
    "        \"diagnosis_binary\"\n",
    "    ] = pd.Categorical(\n",
    "        metadata[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .to_numpy(),\n",
    "        categories=[\n",
    "            \"Control\",\n",
    "            \"AD\",\n",
    "        ],\n",
    "        ordered=False\n",
    "    )\n",
    "\n",
    "\n",
    "    if (\n",
    "        sensitivity_name\n",
    "        ==\n",
    "        \"RIN\"\n",
    "    ):\n",
    "\n",
    "        de_meta[\n",
    "            \"RIN\"\n",
    "        ] = pd.to_numeric(\n",
    "            metadata[\n",
    "                \"RIN\"\n",
    "            ].to_numpy(),\n",
    "            errors=\"raise\"\n",
    "        )\n",
    "\n",
    "\n",
    "    if (\n",
    "        sensitivity_name\n",
    "        ==\n",
    "        \"PMI\"\n",
    "    ):\n",
    "\n",
    "        de_meta[\n",
    "            \"PMI\"\n",
    "        ] = pd.to_numeric(\n",
    "            metadata[\n",
    "                \"PMI\"\n",
    "            ].to_numpy(),\n",
    "            errors=\"raise\"\n",
    "        )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        counts_subset.index.equals(\n",
    "            de_meta.index\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        de_meta.notna()\n",
    "        .all()\n",
    "        .all()\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # Construct DESeq dataset\n",
    "    # ========================================================\n",
    "\n",
    "    dds = DeseqDataSet(\n",
    "\n",
    "        counts=counts_subset,\n",
    "\n",
    "        metadata=de_meta,\n",
    "\n",
    "        design=model_formula,\n",
    "\n",
    "        refit_cooks=True,\n",
    "\n",
    "        n_cpus=2,\n",
    "\n",
    "        quiet=False,\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    design_matrix = (\n",
    "        dds.obsm[\n",
    "            \"design_matrix\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    design_rank = int(\n",
    "        np.linalg.matrix_rank(\n",
    "            design_matrix.to_numpy()\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    design_columns = int(\n",
    "        design_matrix.shape[\n",
    "            1\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Design columns:\",\n",
    "        design_matrix.columns.tolist()\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Design rank:\",\n",
    "        design_rank,\n",
    "        \"/\",\n",
    "        design_columns\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        design_rank\n",
    "        ==\n",
    "        design_columns\n",
    "        ==\n",
    "        7\n",
    "    )\n",
    "\n",
    "\n",
    "    diagnosis_columns = [\n",
    "\n",
    "        str(column)\n",
    "\n",
    "        for column\n",
    "        in design_matrix.columns\n",
    "\n",
    "        if (\n",
    "            \"diagnosis_binary\"\n",
    "            in\n",
    "            str(\n",
    "                column\n",
    "            )\n",
    "        )\n",
    "\n",
    "    ]\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        diagnosis_columns\n",
    "    ) == 1\n",
    "\n",
    "\n",
    "    assert (\n",
    "        \"AD\"\n",
    "        in\n",
    "        diagnosis_columns[\n",
    "            0\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # DESeq2\n",
    "    # ========================================================\n",
    "\n",
    "    dds.deseq2()\n",
    "\n",
    "\n",
    "    stats = DeseqStats(\n",
    "\n",
    "        dds,\n",
    "\n",
    "        contrast=[\n",
    "            \"diagnosis_binary\",\n",
    "            \"AD\",\n",
    "            \"Control\",\n",
    "        ],\n",
    "\n",
    "        alpha=0.05,\n",
    "\n",
    "        cooks_filter=True,\n",
    "\n",
    "        independent_filter=True,\n",
    "\n",
    "        n_cpus=2,\n",
    "\n",
    "        quiet=False,\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    stats.summary()\n",
    "\n",
    "\n",
    "    result = (\n",
    "        stats.results_df\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    result.index = pd.Index(\n",
    "        result.index\n",
    "        .astype(str)\n",
    "        .tolist(),\n",
    "        dtype=\"object\"\n",
    "    )\n",
    "\n",
    "\n",
    "    expected_gene_ids = (\n",
    "        universe[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        set(\n",
    "            result.index\n",
    "        )\n",
    "        ==\n",
    "        set(\n",
    "            expected_gene_ids\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    result = (\n",
    "        result.loc[\n",
    "            expected_gene_ids\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        result.index.tolist()\n",
    "        ==\n",
    "        expected_gene_ids\n",
    "    )\n",
    "\n",
    "\n",
    "    result.index.name = (\n",
    "        \"gene_id\"\n",
    "    )\n",
    "\n",
    "\n",
    "    result = (\n",
    "        result[\n",
    "            [\n",
    "                \"baseMean\",\n",
    "                \"log2FoldChange\",\n",
    "                \"lfcSE\",\n",
    "                \"stat\",\n",
    "                \"pvalue\",\n",
    "                \"padj\",\n",
    "            ]\n",
    "        ]\n",
    "        .reset_index()\n",
    "    )\n",
    "\n",
    "\n",
    "    annotation = (\n",
    "        universe[\n",
    "            [\n",
    "                \"gene_id\",\n",
    "                \"gene_symbol\",\n",
    "                \"gene_symbol_unique_in_GSE174367\",\n",
    "                \"feature_type\",\n",
    "            ]\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    result = result.merge(\n",
    "\n",
    "        annotation,\n",
    "\n",
    "        on=\"gene_id\",\n",
    "\n",
    "        how=\"left\",\n",
    "\n",
    "        validate=\"one_to_one\"\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    result[\n",
    "        \"cell_type\"\n",
    "    ] = cell_type\n",
    "\n",
    "\n",
    "    result[\n",
    "        \"sensitivity\"\n",
    "    ] = sensitivity_name\n",
    "\n",
    "\n",
    "    result[\n",
    "        \"contrast\"\n",
    "    ] = \"AD_vs_Control\"\n",
    "\n",
    "\n",
    "    return (\n",
    "        result,\n",
    "        design_matrix\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# G. STORAGE\n",
    "# ============================================================\n",
    "\n",
    "run_records = {}\n",
    "\n",
    "fdr_summary_rows = []\n",
    "concordance_rows = []\n",
    "hit_support_summary_rows = []\n",
    "\n",
    "all_comparison_tables = []\n",
    "all_primary_hit_tables = []\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# H. FOUR CELL CLASSES\n",
    "# ============================================================\n",
    "\n",
    "for class_number, cell_type in enumerate(\n",
    "    PRIMARY_CLASSES,\n",
    "    start=1\n",
    "):\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\n\"\n",
    "        +\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"[{class_number}/4] \"\n",
    "        f\"{cell_type}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"=\" * 80\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # H1. FROZEN INPUT RECORDS\n",
    "    # ========================================================\n",
    "\n",
    "    universe_record = (\n",
    "        pre_de_lock[\n",
    "            \"cell_class_gene_universes\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    universe_path = Path(\n",
    "        universe_record[\n",
    "            \"gene_universe_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    counts_path = Path(\n",
    "        universe_record[\n",
    "            \"raw_counts_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    metadata_path = Path(\n",
    "        universe_record[\n",
    "            \"donor_metadata_file\"\n",
    "        ]\n",
    "    )\n",    "\n",
    "\n",
    "    primary_result_path = Path(\n",
    "        primary_lock[\n",
    "            \"cell_class_results\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ][\n",
    "            \"all_gene_results\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    for path in [\n",
    "\n",
    "        universe_path,\n",
    "        counts_path,\n",
    "        metadata_path,\n",
    "        primary_result_path,\n",
    "\n",
    "    ]:\n",
    "\n",
    "        assert path.exists(), (\n",
    "            f\"Missing input: {path}\"\n",
    "        )\n",
    "\n",
    "\n",
    "    # Verify immutable primary result.\n",
    "    assert (\n",
    "        sha256_file(\n",
    "            primary_result_path\n",
    "        )\n",
    "        ==\n",
    "        primary_lock[\n",
    "            \"cell_class_results\"\n",
    "        ][\n",
    "            cell_type\n",
    "        ][\n",
    "            \"all_gene_results_sha256\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # H2. LOAD FROZEN UNIVERSE\n",
    "    # ========================================================\n",
    "\n",
    "    universe = pd.read_csv(\n",
    "        universe_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    expected_n = int(\n",
    "        universe_record[\n",
    "            \"frozen_AD_discovery_gene_universe\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        universe\n",
    "    ) == expected_n\n",
    "\n",
    "\n",
    "    assert (\n",
    "        universe[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .is_unique\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # H3. LOAD RAW COUNTS + DONOR METADATA\n",
    "    # ========================================================\n",
    "\n",
    "    raw = pd.read_csv(\n",
    "        counts_path,\n",
    "        compression=\"gzip\",\n",
    "        index_col=0\n",
    "    )\n",
    "\n",
    "\n",
    "    raw.index = pd.Index(\n",
    "        raw.index\n",
    "        .astype(str)\n",
    "        .tolist(),\n",
    "        dtype=\"object\"\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        raw.index.tolist()\n",
    "        ==\n",
    "        universe[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert raw.shape == (\n",
    "        expected_n,\n",
    "        18\n",
    "    )\n",
    "\n",
    "\n",
    "    metadata = pd.read_csv(\n",
    "        metadata_path\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        metadata\n",
    "    ) == 18\n",
    "\n",
    "\n",
    "    assert (\n",
    "        metadata[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        .value_counts()\n",
    "        .to_dict()\n",
    "        ==\n",
    "        {\n",
    "            \"AD\": 11,\n",
    "            \"Control\": 7,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        metadata[\n",
    "            \"RIN\"\n",
    "        ]\n",
    "        .notna()\n",
    "        .all()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert int(\n",
    "        metadata[\n",
    "            \"PMI\"\n",
    "        ]\n",
    "        .isna()\n",
    "        .sum()\n",
    "    ) == 1\n",
    "\n",
    "\n",
    "    # Exact raw column order.\n",
    "    assert (\n",
    "        raw.columns\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "        ==\n",
    "        metadata[\n",
    "            \"pseudobulk_group\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # H4. PRIMARY RESULT\n",
    "    # ========================================================\n",
    "\n",
    "    primary = pd.read_csv(\n",
    "        primary_result_path,\n",
    "        compression=\"gzip\"\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        primary\n",
    "    ) == expected_n\n",
    "\n",
    "\n",
    "    assert (\n",
    "        primary[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "        ==\n",
    "        universe[\n",
    "            \"gene_id\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    primary_sig = (\n",
    "\n",
    "        np.isfinite(\n",
    "            primary[\n",
    "                \"padj\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            primary[\n",
    "                \"padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_primary_FDR = int(\n",
    "        primary_sig.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        n_primary_FDR\n",
    "        ==\n",
    "        EXPECTED_PRIMARY_FDR[\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # H5. RIN SENSITIVITY — ALL 18 DONORS\n",
    "    # ========================================================\n",
    "\n",
    "    RIN_metadata = metadata.copy()\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        RIN_metadata\n",
    "    ) == 18\n",
    "\n",
    "\n",
    "    assert (\n",
    "        RIN_metadata[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        .value_counts()\n",
    "        .to_dict()\n",
    "        ==\n",
    "        {\n",
    "            \"AD\": 11,\n",
    "            \"Control\": 7,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    RIN_result, RIN_design = run_sensitivity(\n",
    "\n",
    "        cell_type=\n",
    "            cell_type,\n",
    "\n",
    "        sensitivity_name=\n",
    "            \"RIN\",\n",
    "\n",
    "        counts_genes_by_samples=\n",
    "            raw,\n",
    "\n",
    "        metadata=\n",
    "            RIN_metadata,\n",
    "\n",
    "        universe=\n",
    "            universe,\n",
    "\n",
    "        model_formula=\n",
    "            \"~ age + sex + batch + RIN + diagnosis_binary\",\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # H6. PMI SENSITIVITY — 17 COMPLETE-CASE DONORS\n",
    "    # ========================================================\n",
    "\n",
    "    PMI_metadata = (\n",
    "\n",
    "        metadata[\n",
    "            metadata[\n",
    "                \"PMI\"\n",
    "            ]\n",
    "            .notna()\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        PMI_metadata\n",
    "    ) == 17\n",
    "\n",
    "\n",
    "    assert (\n",
    "        PMI_metadata[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        .value_counts()\n",
    "        .to_dict()\n",
    "        ==\n",
    "        {\n",
    "            \"AD\": 11,\n",
    "            \"Control\": 6,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    missing_PMI_donors = (\n",
    "\n",
    "        metadata.loc[\n",
    "            metadata[\n",
    "                \"PMI\"\n",
    "            ]\n",
    "            .isna(),\n",
    "            [\n",
    "                \"donor_id\",\n",
    "                \"diagnosis_binary\",\n",
    "            ]\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        missing_PMI_donors\n",
    "    ) == 1\n",
    "\n",
    "\n",
    "    assert (\n",
    "        missing_PMI_donors[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        .iloc[\n",
    "            0\n",
    "        ]\n",
    "        ==\n",
    "        \"Control\"\n",
    "    )\n",
    "\n",
    "\n",
    "    PMI_result, PMI_design = run_sensitivity(\n",
    "\n",
    "        cell_type=\n",
    "            cell_type,\n",
    "\n",
    "        sensitivity_name=\n",
    "            \"PMI\",\n",
    "\n",
    "        counts_genes_by_samples=\n",
    "            raw,\n",
    "\n",
    "        metadata=\n",
    "            PMI_metadata,\n",
    "\n",
    "        universe=\n",
    "            universe,\n",
    "\n",
    "        model_formula=\n",
    "            \"~ age + sex + batch + PMI + diagnosis_binary\",\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # H7. SAVE SENSITIVITY RESULTS\n",
    "    # ========================================================\n",
    "\n",
    "    class_dir = (\n",
    "        SENS_ROOT /\n",
    "        cell_type\n",
    "    )\n",
    "\n",
    "\n",
    "    class_dir.mkdir(\n",
    "        parents=True,\n",
    "        exist_ok=True\n",
    "    )\n",
    "\n",
    "\n",
    "    RIN_path = (\n",
    "        class_dir /\n",
    "        (\n",
    "            f\"GSE174367_{cell_type}_\"\n",
    "            f\"AD_vs_Control_RIN_SENSITIVITY_ALL_GENES_v1.csv.gz\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    PMI_path = (\n",
    "        class_dir /\n",
    "        (\n",
    "            f\"GSE174367_{cell_type}_\"\n",
    "            f\"AD_vs_Control_PMI_SENSITIVITY_ALL_GENES_v1.csv.gz\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    RIN_result.to_csv(\n",
    "\n",
    "        RIN_path,\n",
    "\n",
    "        index=False,\n",
    "\n",
    "        compression={\n",
    "            \"method\":\n",
    "                \"gzip\",\n",
    "\n",
    "            \"compresslevel\":\n",
    "                6,\n",
    "        }\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    PMI_result.to_csv(\n",
    "\n",
    "        PMI_path,\n",
    "\n",
    "        index=False,\n",
    "\n",
    "        compression={\n",
    "            \"method\":\n",
    "                \"gzip\",\n",
    "\n",
    "            \"compresslevel\":\n",
    "                6,\n",
    "        }\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    RIN_design_path = (\n",
    "        class_dir /\n",
    "        (\n",
    "            f\"GSE174367_{cell_type}_\"\n",
    "            f\"RIN_SENSITIVITY_DESIGN_MATRIX_v1.csv\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    PMI_design_path = (\n",
    "        class_dir /\n",
    "        (\n",
    "            f\"GSE174367_{cell_type}_\"\n",
    "            f\"PMI_SENSITIVITY_DESIGN_MATRIX_v1.csv\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    RIN_design.to_csv(\n",
    "        RIN_design_path\n",
    "    )\n",
    "\n",
    "\n",
    "    PMI_design.to_csv(\n",
    "        PMI_design_path\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # H8. MERGE PRIMARY + RIN + PMI\n",
    "    # ========================================================\n",
    "\n",
    "    comparison = (\n",
    "\n",
    "        primary[\n",
    "            [\n",
    "                \"gene_id\",\n",
    "                \"gene_symbol\",\n",
    "                \"gene_symbol_unique_in_GSE174367\",\n",
    "\n",
    "                \"log2FoldChange\",\n",
    "                \"stat\",\n",
    "                \"pvalue\",\n",
    "                \"padj\",\n",
    "            ]\n",
    "        ]\n",
    "        .rename(\n",
    "            columns={\n",
    "\n",
    "                \"log2FoldChange\":\n",
    "                    \"primary_LFC\",\n",
    "\n",
    "                \"stat\":\n",
    "                    \"primary_Wald\",\n",
    "\n",
    "                \"pvalue\":\n",
    "                    \"primary_p\",\n",
    "\n",
    "                \"padj\":\n",
    "                    \"primary_padj\",\n",
    "\n",
    "            }\n",
    "        )\n",
    "\n",
    "        .merge(\n",
    "\n",
    "            RIN_result[\n",
    "                [\n",
    "                    \"gene_id\",\n",
    "                    \"log2FoldChange\",\n",
    "                    \"stat\",\n",
    "                    \"pvalue\",\n",
    "                    \"padj\",\n",
    "                ]\n",
    "            ]\n",
    "            .rename(\n",
    "                columns={\n",
    "\n",
    "                    \"log2FoldChange\":\n",
    "                        \"RIN_LFC\",\n",
    "\n",
    "                    \"stat\":\n",
    "                        \"RIN_Wald\",\n",
    "\n",
    "                    \"pvalue\":\n",
    "                        \"RIN_p\",\n",
    "\n",
    "                    \"padj\":\n",
    "                        \"RIN_padj\",\n",
    "\n",
    "                }\n",
    "            ),\n",
    "\n",
    "            on=\"gene_id\",\n",
    "\n",
    "            how=\"inner\",\n",
    "\n",
    "            validate=\"one_to_one\"\n",
    "\n",
    "        )\n",
    "\n",
    "        .merge(\n",
    "\n",
    "            PMI_result[\n",
    "                [\n",
    "                    \"gene_id\",\n",
    "                    \"log2FoldChange\",\n",
    "                    \"stat\",\n",
    "                    \"pvalue\",\n",
    "                    \"padj\",\n",
    "                ]\n",
    "            ]\n",
    "            .rename(\n",
    "                columns={\n",
    "\n",
    "                    \"log2FoldChange\":\n",
    "                        \"PMI_LFC\",\n",
    "\n",
    "                    \"stat\":\n",
    "                        \"PMI_Wald\",\n",
    "\n",
    "                    \"pvalue\":\n",
    "                        \"PMI_p\",\n",
    "\n",
    "                    \"padj\":\n",
    "                        \"PMI_padj\",\n",
    "\n",
    "                }\n",
    "            ),\n",
    "\n",
    "            on=\"gene_id\",\n",
    "\n",
    "            how=\"inner\",\n",
    "\n",
    "            validate=\"one_to_one\"\n",
    "\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        comparison\n",
    "    ) == expected_n\n",
    "\n",
    "\n",
    "    comparison.insert(\n",
    "        0,\n",
    "        \"cell_type\",\n",
    "        cell_type\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # H9. ALL-GENE CONCORDANCE\n",
    "    # ========================================================\n",
    "\n",
    "    primary_RIN_LFC_pearson = (\n",
    "        safe_pearson(\n",
    "            comparison[\n",
    "                \"primary_LFC\"\n",
    "            ],\n",
    "            comparison[\n",
    "                \"RIN_LFC\"\n",
    "            ]\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    primary_RIN_LFC_spearman = (\n",
    "        safe_spearman(\n",
    "            comparison[\n",
    "                \"primary_LFC\"\n",
    "            ],\n",
    "            comparison[\n",
    "                \"RIN_LFC\"\n",
    "            ]\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    primary_RIN_Wald_spearman = (\n",
    "        safe_spearman(\n",
    "            comparison[\n",
    "                \"primary_Wald\"\n",
    "            ],\n",
    "            comparison[\n",
    "                \"RIN_Wald\"\n",
    "            ]\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    primary_RIN_direction = (\n",
    "        direction_fraction(\n",
    "            comparison[\n",
    "                \"primary_LFC\"\n",
    "            ],\n",
    "            comparison[\n",
    "                \"RIN_LFC\"\n",
    "            ]\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    primary_PMI_LFC_pearson = (\n",
    "        safe_pearson(\n",
    "            comparison[\n",
    "                \"primary_LFC\"\n",
    "            ],\n",
    "            comparison[\n",
    "                \"PMI_LFC\"\n",
    "            ]\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    primary_PMI_LFC_spearman = (\n",
    "        safe_spearman(\n",
    "            comparison[\n",
    "                \"primary_LFC\"\n",
    "            ],\n",
    "            comparison[\n",
    "                \"PMI_LFC\"\n",
    "            ]\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    primary_PMI_Wald_spearman = (\n",
    "        safe_spearman(\n",
    "            comparison[\n",
    "                \"primary_Wald\"\n",
    "            ],\n",
    "            comparison[\n",
    "                \"PMI_Wald\"\n",
    "            ]\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    primary_PMI_direction = (\n",
    "        direction_fraction(\n",
    "            comparison[\n",
    "                \"primary_LFC\"\n",
    "            ],\n",
    "            comparison[\n",
    "                \"PMI_LFC\"\n",
    "            ]\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # H10. FDR COUNTS IN SENSITIVITIES\n",
    "    # ========================================================\n",
    "\n",
    "    RIN_FDR_mask = (\n",
    "\n",
    "        np.isfinite(\n",
    "            RIN_result[\n",
    "                \"padj\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            RIN_result[\n",
    "                \"padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    PMI_FDR_mask = (\n",
    "\n",
    "        np.isfinite(\n",
    "            PMI_result[\n",
    "                \"padj\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            PMI_result[\n",
    "                \"padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_RIN_FDR = int(\n",
    "        RIN_FDR_mask.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_PMI_FDR = int(\n",
    "        PMI_FDR_mask.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_RIN_up = int(\n",
    "\n",
    "        (\n",
    "            RIN_result.loc[\n",
    "                RIN_FDR_mask,\n",
    "                \"log2FoldChange\"\n",
    "            ]\n",
    "            >\n",
    "            0\n",
    "        ).sum()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_RIN_down = int(\n",
    "\n",
    "        (\n",
    "            RIN_result.loc[\n",
    "                RIN_FDR_mask,\n",
    "                \"log2FoldChange\"\n",
    "            ]\n",
    "            <\n",
    "            0\n",
    "        ).sum()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_PMI_up = int(\n",
    "\n",
    "        (\n",
    "            PMI_result.loc[\n",
    "                PMI_FDR_mask,\n",
    "                \"log2FoldChange\"\n",
    "            ]\n",
    "            >\n",
    "            0\n",
    "        ).sum()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    n_PMI_down = int(\n",
    "\n",
    "        (\n",
    "            PMI_result.loc[\n",
    "                PMI_FDR_mask,\n",
    "                \"log2FoldChange\"\n",
    "            ]\n",
    "            <\n",
    "            0\n",
    "        ).sum()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # H11. PRIMARY FDR HIT SUPPORT\n",
    "    # ========================================================\n",
    "\n",
    "    hits = (\n",
    "\n",
    "        comparison[\n",
    "            np.isfinite(\n",
    "                comparison[\n",
    "                    \"primary_padj\"\n",
    "                ]\n",
    "            )\n",
    "\n",
    "            &\n",
    "\n",
    "            (\n",
    "                comparison[\n",
    "                    \"primary_padj\"\n",
    "                ]\n",
    "                <\n",
    "                0.05\n",
    "            )\n",
    "        ]\n",
    "        .copy()\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        hits\n",
    "    ) == n_primary_FDR\n",
    "\n",
    "\n",
    "    hits[\n",
    "        \"RIN_same_direction\"\n",
    "    ] = (\n",
    "\n",
    "        np.sign(\n",
    "            hits[\n",
    "                \"primary_LFC\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        ==\n",
    "\n",
    "        np.sign(\n",
    "            hits[\n",
    "                \"RIN_LFC\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    hits[\n",
    "        \"RIN_nominal_p_lt_0.05\"\n",
    "    ] = (\n",
    "\n",
    "        np.isfinite(\n",
    "            hits[\n",
    "                \"RIN_p\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            hits[\n",
    "                \"RIN_p\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    hits[\n",
    "        \"RIN_FDR_lt_0.05\"\n",
    "    ] = (\n",
    "\n",
    "        np.isfinite(\n",
    "            hits[\n",
    "                \"RIN_padj\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            hits[\n",
    "                \"RIN_padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    hits[\n",
    "        \"RIN_supported\"\n",
    "    ] = (\n",
    "\n",
    "        hits[\n",
    "            \"RIN_same_direction\"\n",
    "        ]\n",
    "\n",
    "        &\n",
    "\n",
    "        hits[\n",
    "            \"RIN_nominal_p_lt_0.05\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    hits[\n",
    "        \"PMI_same_direction\"\n",
    "    ] = (\n",
    "\n",
    "        np.sign(\n",
    "            hits[\n",
    "                \"primary_LFC\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        ==\n",
    "\n",
    "        np.sign(\n",
    "            hits[\n",
    "                \"PMI_LFC\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    hits[\n",
    "        \"PMI_nominal_p_lt_0.05\"\n",
    "    ] = (\n",
    "\n",
    "        np.isfinite(\n",
    "            hits[\n",
    "                \"PMI_p\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            hits[\n",
    "                \"PMI_p\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    hits[\n",
    "        \"PMI_FDR_lt_0.05\"\n",
    "    ] = (\n",
    "\n",
    "        np.isfinite(\n",
    "            hits[\n",
    "                \"PMI_padj\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        &\n",
    "\n",
    "        (\n",
    "            hits[\n",
    "                \"PMI_padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    hits[\n",
    "        \"PMI_supported\"\n",
    "    ] = (\n",
    "\n",
    "        hits[\n",
    "            \"PMI_same_direction\"\n",
    "        ]\n",
    "\n",
    "        &\n",
    "\n",
    "        hits[\n",    "            \"PMI_nominal_p_lt_0.05\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    hits[\n",
    "        \"RIN_and_PMI_supported\"\n",
    "    ] = (\n",
    "\n",
    "        hits[\n",
    "            \"RIN_supported\"\n",
    "        ]\n",
    "\n",
    "        &\n",
    "\n",
    "        hits[\n",
    "            \"PMI_supported\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    hits[\n",
    "        \"RIN_and_PMI_FDR\"\n",
    "    ] = (\n",
    "\n",
    "        hits[\n",
    "            \"RIN_same_direction\"\n",
    "        ]\n",
    "\n",
    "        &\n",
    "\n",
    "        hits[\n",
    "            \"PMI_same_direction\"\n",
    "        ]\n",
    "\n",
    "        &\n",
    "\n",
    "        hits[\n",
    "            \"RIN_FDR_lt_0.05\"\n",
    "        ]\n",
    "\n",
    "        &\n",
    "\n",
    "        hits[\n",
    "            \"PMI_FDR_lt_0.05\"\n",
    "        ]\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # H12. SUPPORT COUNTS\n",
    "    # ========================================================\n",
    "\n",
    "    n_RIN_same = int(\n",
    "        hits[\n",
    "            \"RIN_same_direction\"\n",
    "        ].sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_RIN_nominal = int(\n",
    "        hits[\n",
    "            \"RIN_nominal_p_lt_0.05\"\n",
    "        ].sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_RIN_supported = int(\n",
    "        hits[\n",
    "            \"RIN_supported\"\n",
    "        ].sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_RIN_FDR_hits = int(\n",
    "        (\n",
    "            hits[\n",
    "                \"RIN_same_direction\"\n",
    "            ]\n",
    "            &\n",
    "            hits[\n",
    "                \"RIN_FDR_lt_0.05\"\n",
    "            ]\n",
    "        ).sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_PMI_same = int(\n",
    "        hits[\n",
    "            \"PMI_same_direction\"\n",
    "        ].sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_PMI_nominal = int(\n",
    "        hits[\n",
    "            \"PMI_nominal_p_lt_0.05\"\n",
    "        ].sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_PMI_supported = int(\n",
    "        hits[\n",
    "            \"PMI_supported\"\n",
    "        ].sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_PMI_FDR_hits = int(\n",
    "        (\n",
    "            hits[\n",
    "                \"PMI_same_direction\"\n",
    "            ]\n",
    "            &\n",
    "            hits[\n",
    "                \"PMI_FDR_lt_0.05\"\n",
    "            ]\n",
    "        ).sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_both_supported = int(\n",
    "        hits[\n",
    "            \"RIN_and_PMI_supported\"\n",
    "        ].sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    n_both_FDR = int(\n",
    "        hits[\n",
    "            \"RIN_and_PMI_FDR\"\n",
    "        ].sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # H13. SAVE COMPARISON + HIT TABLE\n",
    "    # ========================================================\n",
    "\n",
    "    comparison_path = (\n",
    "        class_dir /\n",
    "        (\n",
    "            f\"GSE174367_{cell_type}_\"\n",
    "            f\"PRIMARY_vs_RIN_vs_PMI_v1.csv.gz\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    hit_path = (\n",
    "        class_dir /\n",
    "        (\n",
    "            f\"GSE174367_{cell_type}_\"\n",
    "            f\"PRIMARY_FDR_TECHNICAL_SUPPORT_v1.csv.gz\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    comparison.to_csv(\n",
    "\n",
    "        comparison_path,\n",
    "\n",
    "        index=False,\n",
    "\n",
    "        compression={\n",
    "            \"method\":\n",
    "                \"gzip\",\n",
    "\n",
    "            \"compresslevel\":\n",
    "                6,\n",
    "        }\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    hits.to_csv(\n",
    "\n",
    "        hit_path,\n",
    "\n",
    "        index=False,\n",
    "\n",
    "        compression={\n",
    "            \"method\":\n",
    "                \"gzip\",\n",
    "\n",
    "            \"compresslevel\":\n",
    "                6,\n",
    "        }\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    all_comparison_tables.append(\n",
    "        comparison\n",
    "    )\n",
    "\n",
    "\n",
    "    all_primary_hit_tables.append(\n",
    "        hits\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # H14. SUMMARY RECORDS\n",
    "    # ========================================================\n",
    "\n",
    "    fdr_summary_rows.append({\n",
    "\n",
    "        \"cell_type\":\n",
    "            cell_type,\n",
    "\n",
    "        \"primary_FDR\":\n",
    "            n_primary_FDR,\n",
    "\n",
    "        \"RIN_FDR\":\n",
    "            n_RIN_FDR,\n",
    "\n",
    "        \"RIN_up\":\n",
    "            n_RIN_up,\n",
    "\n",
    "        \"RIN_down\":\n",
    "            n_RIN_down,\n",
    "\n",
    "        \"PMI_FDR\":\n",
    "            n_PMI_FDR,\n",
    "\n",
    "        \"PMI_up\":\n",
    "            n_PMI_up,\n",
    "\n",
    "        \"PMI_down\":\n",
    "            n_PMI_down,\n",
    "\n",
    "    })\n",
    "\n",
    "\n",
    "    concordance_rows.append({\n",
    "\n",
    "        \"cell_type\":\n",
    "            cell_type,\n",
    "\n",
    "        \"primary_RIN_LFC_pearson\":\n",
    "            primary_RIN_LFC_pearson,\n",
    "\n",
    "        \"primary_RIN_LFC_spearman\":\n",
    "            primary_RIN_LFC_spearman,\n",
    "\n",
    "        \"primary_RIN_Wald_spearman\":\n",
    "            primary_RIN_Wald_spearman,\n",
    "\n",
    "        \"primary_RIN_direction_concordance\":\n",
    "            primary_RIN_direction,\n",
    "\n",
    "        \"primary_PMI_LFC_pearson\":\n",
    "            primary_PMI_LFC_pearson,\n",
    "\n",
    "        \"primary_PMI_LFC_spearman\":\n",
    "            primary_PMI_LFC_spearman,\n",
    "\n",
    "        \"primary_PMI_Wald_spearman\":\n",
    "            primary_PMI_Wald_spearman,\n",
    "\n",
    "        \"primary_PMI_direction_concordance\":\n",
    "            primary_PMI_direction,\n",
    "\n",
    "    })\n",
    "\n",
    "\n",
    "    hit_support_summary_rows.append({\n",
    "\n",
    "        \"cell_type\":\n",
    "            cell_type,\n",
    "\n",
    "        \"primary_FDR\":\n",
    "            n_primary_FDR,\n",
    "\n",
    "        \"RIN_same_direction\":\n",
    "            n_RIN_same,\n",
    "\n",
    "        \"RIN_nominal_p_lt_0.05\":\n",
    "            n_RIN_nominal,\n",
    "\n",
    "        \"RIN_supported\":\n",
    "            n_RIN_supported,\n",
    "\n",
    "        \"RIN_same_direction_and_FDR\":\n",
    "            n_RIN_FDR_hits,\n",
    "\n",
    "        \"PMI_same_direction\":\n",
    "            n_PMI_same,\n",
    "\n",
    "        \"PMI_nominal_p_lt_0.05\":\n",
    "            n_PMI_nominal,\n",
    "\n",
    "        \"PMI_supported\":\n",
    "            n_PMI_supported,\n",
    "\n",
    "        \"PMI_same_direction_and_FDR\":\n",
    "            n_PMI_FDR_hits,\n",
    "\n",
    "        \"RIN_and_PMI_supported\":\n",
    "            n_both_supported,\n",
    "\n",
    "        \"RIN_and_PMI_same_direction_and_FDR\":\n",
    "            n_both_FDR,\n",
    "\n",
    "    })\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # H15. LOCK RECORD\n",
    "    # ========================================================\n",
    "\n",
    "    run_records[\n",
    "        cell_type\n",
    "    ] = {\n",
    "\n",
    "        \"frozen_gene_universe\":\n",
    "            int(\n",
    "                expected_n\n",
    "            ),\n",
    "\n",
    "        \"gene_universe_file\":\n",
    "            str(\n",
    "                universe_path\n",
    "            ),\n",
    "\n",
    "        \"raw_counts_file\":\n",
    "            str(\n",
    "                counts_path\n",
    "            ),\n",
    "\n",
    "        \"primary_result\":\n",
    "            str(\n",
    "                primary_result_path\n",
    "            ),\n",
    "\n",
    "        \"RIN\": {\n",
    "\n",
    "            \"model\":\n",
    "                \"~ age + sex + batch + RIN + diagnosis_binary\",\n",
    "\n",
    "            \"n_donors\":\n",
    "                18,\n",
    "\n",
    "            \"n_AD\":\n",
    "                11,\n",
    "\n",
    "            \"n_Control\":\n",
    "                7,\n",
    "\n",
    "            \"design_rank\":\n",
    "                int(\n",
    "                    np.linalg.matrix_rank(\n",
    "                        RIN_design.to_numpy()\n",
    "                    )\n",
    "                ),\n",
    "\n",
    "            \"design_columns\":\n",
    "                int(\n",
    "                    RIN_design.shape[\n",
    "                        1\n",
    "                    ]\n",
    "                ),\n",
    "\n",
    "            \"all_gene_result\":\n",
    "                str(\n",
    "                    RIN_path\n",
    "                ),\n",
    "\n",
    "            \"all_gene_result_sha256\":\n",
    "                sha256_file(\n",
    "                    RIN_path\n",
    "                ),\n",
    "\n",
    "        },\n",
    "\n",
    "        \"PMI\": {\n",
    "\n",
    "            \"model\":\n",
    "                \"~ age + sex + batch + PMI + diagnosis_binary\",\n",
    "\n",
    "            \"complete_case\":\n",
    "                True,\n",
    "\n",
    "            \"n_donors\":\n",
    "                17,\n",
    "\n",
    "            \"n_AD\":\n",
    "                11,\n",
    "\n",
    "            \"n_Control\":\n",
    "                6,\n",
    "\n",
    "            \"excluded_missing_PMI_donor\":\n",
    "                str(\n",
    "                    missing_PMI_donors[\n",
    "                        \"donor_id\"\n",
    "                    ]\n",
    "                    .iloc[\n",
    "                        0\n",
    "                    ]\n",
    "                ),\n",
    "\n",
    "            \"excluded_donor_diagnosis\":\n",
    "                \"Control\",\n",
    "\n",
    "            \"design_rank\":\n",
    "                int(\n",
    "                    np.linalg.matrix_rank(\n",
    "                        PMI_design.to_numpy()\n",
    "                    )\n",
    "                ),\n",
    "\n",
    "            \"design_columns\":\n",
    "                int(\n",
    "                    PMI_design.shape[\n",
    "                        1\n",
    "                    ]\n",
    "                ),\n",
    "\n",
    "            \"all_gene_result\":\n",
    "                str(\n",
    "                    PMI_path\n",
    "                ),\n",
    "\n",
    "            \"all_gene_result_sha256\":\n",
    "                sha256_file(\n",
    "                    PMI_path\n",
    "                ),\n",
    "\n",
    "        },\n",
    "\n",
    "        \"primary_vs_sensitivity_comparison\":\n",
    "            str(\n",
    "                comparison_path\n",
    "            ),\n",
    "\n",
    "        \"primary_FDR_support\":\n",
    "            str(\n",
    "                hit_path\n",
    "            ),\n",
    "\n",
    "        \"primary_FDR_RIN_and_PMI_supported\":\n",
    "            int(\n",
    "                n_both_supported\n",
    "            ),\n",
    "\n",
    "    }\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # H16. PRINT CLASS RESULT\n",
    "    # ========================================================\n",
    "\n",
    "    print(\n",
    "        \"\\nSensitivity FDR:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Primary:\",\n",
    "        n_primary_FDR\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  RIN:\",\n",
    "        n_RIN_FDR\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  PMI:\",\n",
    "        n_PMI_FDR\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nAll-gene concordance:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Primary vs RIN LFC Spearman:\",\n",
    "        primary_RIN_LFC_spearman\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Primary vs RIN Wald Spearman:\",\n",
    "        primary_RIN_Wald_spearman\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Primary vs PMI LFC Spearman:\",\n",
    "        primary_PMI_LFC_spearman\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Primary vs PMI Wald Spearman:\",\n",
    "        primary_PMI_Wald_spearman\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nPrimary FDR robustness:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  RIN supported:\",\n",
    "        f\"{n_RIN_supported}/{n_primary_FDR}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  PMI supported:\",\n",
    "        f\"{n_PMI_supported}/{n_primary_FDR}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  BOTH supported:\",\n",
    "        f\"{n_both_supported}/{n_primary_FDR}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  BOTH still FDR:\",\n",
    "        f\"{n_both_FDR}/{n_primary_FDR}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # H17. CLEANUP\n",
    "    # ========================================================\n",
    "\n",
    "    del universe\n",
    "    del raw\n",
    "    del metadata\n",
    "    del primary\n",
    "\n",
    "    del RIN_metadata\n",
    "    del PMI_metadata\n",
    "\n",
    "    del RIN_result\n",
    "    del PMI_result\n",
    "\n",
    "    del RIN_design\n",
    "    del PMI_design\n",
    "\n",
    "    del comparison\n",
    "    del hits\n",
    "\n",
    "    gc.collect()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# I. COMBINED TABLES\n",
    "# ============================================================\n",
    "\n",
    "fdr_summary = pd.DataFrame(\n",
    "    fdr_summary_rows\n",
    ")\n",
    "\n",
    "\n",
    "concordance = pd.DataFrame(\n",
    "    concordance_rows\n",
    ")\n",
    "\n",
    "\n",
    "hit_support_summary = pd.DataFrame(\n",
    "    hit_support_summary_rows\n",
    ")\n",
    "\n",
    "\n",
    "for table in [\n",
    "\n",
    "    fdr_summary,\n",
    "    concordance,\n",
    "    hit_support_summary,\n",
    "\n",
    "]:\n",
    "\n",
    "    table[\n",
    "        \"cell_type\"\n",
    "    ] = pd.Categorical(\n",
    "\n",
    "        table[\n",
    "            \"cell_type\"\n",
    "        ],\n",
    "\n",
    "        categories=\n",
    "            PRIMARY_CLASSES,\n",
    "\n",
    "        ordered=True\n",
    "\n",
    "    )\n",
    "\n",
    "\n",
    "    table.sort_values(\n",
    "        \"cell_type\",\n",
    "        inplace=True\n",
    "    )\n",
    "\n",
    "\n",
    "    table.reset_index(\n",
    "        drop=True,\n",
    "        inplace=True\n",
    "    )\n",
    "\n",
    "\n",
    "    table[\n",
    "        \"cell_type\"\n",
    "    ] = (\n",
    "        table[\n",
    "            \"cell_type\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "    )\n",
    "\n",
    "\n",
    "fdr_summary.to_csv(\n",
    "    FDR_SUMMARY_PATH,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "concordance.to_csv(\n",
    "    CONCORDANCE_PATH,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "hit_support_summary.to_csv(\n",
    "    PRIMARY_HIT_SUPPORT_SUMMARY_PATH,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "\n",
    "combined_comparison = pd.concat(\n",
    "    all_comparison_tables,\n",
    "    axis=0,\n",
    "    ignore_index=True\n",
    ")\n",
    "\n",
    "\n",
    "combined_primary_hits = pd.concat(\n",
    "    all_primary_hit_tables,\n",
    "    axis=0,\n",
    "    ignore_index=True\n",
    ")\n",
    "\n",
    "\n",
    "assert len(\n",
    "    combined_primary_hits\n",
    ") == 34\n",
    "\n",
    "\n",
    "combined_comparison.to_csv(\n",
    "\n",
    "    COMBINED_ALL_GENE_COMPARISON_PATH,\n",
    "\n",
    "    index=False,\n",
    "\n",
    "    compression={\n",
    "        \"method\":\n",
    "            \"gzip\",\n",
    "\n",
    "        \"compresslevel\":\n",
    "            6,\n",
    "    }\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "combined_primary_hits.to_csv(\n",
    "\n",
    "    COMBINED_PRIMARY_HIT_SUPPORT_PATH,\n",
    "\n",
    "    index=False,\n",
    "\n",
    "    compression={\n",
    "        \"method\":\n",
    "            \"gzip\",\n",
    "\n",
    "        \"compresslevel\":\n",
    "            6,\n",
    "    }\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# J. FINAL SUPPORT COUNTS\n",
    "# ============================================================\n",
    "\n",
    "total_both_supported = int(\n",
    "\n",
    "    hit_support_summary[\n",
    "        \"RIN_and_PMI_supported\"\n",
    "    ].sum()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "total_both_FDR = int(\n",
    "\n",
    "    hit_support_summary[\n",
    "        \"RIN_and_PMI_same_direction_and_FDR\"\n",
    "    ].sum()\n",
    "\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    hit_support_summary[\n",
    "        \"primary_FDR\"\n",
    "    ].sum()\n",
    "    ==\n",
    "    34\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# K. SENSITIVITY RUN LOCK\n",
    "# ============================================================\n",
    "\n",
    "SENSITIVITY_LOCK = {\n",
    "\n",
    "    \"dataset\":\n",
    "        \"GSE174367\",\n",
    "\n",
    "    \"created_utc\":\n",
    "        datetime.now(\n",
    "            timezone.utc\n",
    "        ).isoformat(),\n",
    "\n",
    "    \"status\":\n",
    "        \"AD_DISCOVERY_TECHNICAL_SENSITIVITY_COMPLETE\",\n",
    "\n",
    "    \"primary_model\":\n",
    "        \"~ age + sex + batch + diagnosis_binary\",\n",
    "\n",
    "    \"RIN_sensitivity\": {\n",
    "\n",
    "        \"model\":\n",
    "            \"~ age + sex + batch + RIN + diagnosis_binary\",\n",
    "\n",
    "        \"n_donors\":\n",
    "            18,\n",
    "\n",
    "        \"n_AD\":\n",
    "            11,\n",
    "\n",
    "        \"n_Control\":\n",
    "            7,\n",
    "\n",
    "    },\n",
    "\n",
    "    \"PMI_sensitivity\": {\n",
    "\n",
    "        \"model\":\n",
    "            \"~ age + sex + batch + PMI + diagnosis_binary\",\n",
    "\n",
    "        \"complete_case\":\n",
    "            True,\n",
    "\n",
    "        \"n_donors\":\n",
    "            17,\n",
    "\n",
    "        \"n_AD\":\n",
    "            11,\n",
    "\n",
    "        \"n_Control\":\n",
    "            6,\n",
    "\n",
    "        \"one_missing_PMI_control_excluded\":\n",
    "            True,\n",
    "\n",
    "    },\n",
    "\n",
    "    \"age_overlap_sensitivity_performed\":\n",
    "        False,\n",
    "\n",
    "    \"gene_universes_refiltered\":\n",
    "        False,\n",
    "\n",
    "    \"primary_results_changed\":\n",
    "        False,\n",
    "\n",
    "    \"cell_class_results\":\n",
    "        run_records,\n",
    "\n",
    "    \"FDR_summary\":\n",
    "        str(\n",
    "            FDR_SUMMARY_PATH\n",
    "        ),\n",
    "\n",
    "    \"concordance_summary\":\n",
    "        str(\n",
    "            CONCORDANCE_PATH\n",
    "        ),\n",
    "\n",
    "    \"primary_FDR_support_summary\":\n",
    "        str(\n",
    "            PRIMARY_HIT_SUPPORT_SUMMARY_PATH\n",
    "        ),\n",
    "\n",
    "    \"combined_all_gene_comparison\":\n",
    "        str(\n",
    "            COMBINED_ALL_GENE_COMPARISON_PATH\n",
    "        ),\n",
    "\n",
    "    \"combined_primary_FDR_support\":\n",
    "        str(\n",
    "            COMBINED_PRIMARY_HIT_SUPPORT_PATH\n",
    "        ),\n",
    "\n",
    "    \"DE_engine\":\n",
    "        \"PyDESeq2\",\n",
    "\n",
    "    \"DE_engine_version\":\n",
    "        PYDESEQ2_VERSION,\n",
    "\n",
    "    \"AD_replication_performed\":\n",
    "        False,\n",
    "\n",
    "    \"PD_data_loaded\":\n",
    "        False,\n",
    "\n",
    "    \"AD_PD_convergence_performed\":\n",
    "        False,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    SENSITIVITY_LOCK_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        SENSITIVITY_LOCK,\n",
    "        f,\n",
    "        indent=2\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# L. SENSITIVITY SUPPORT FREEZE\n",
    "# ============================================================\n",
    "\n",
    "SUPPORT_FREEZE = {\n",
    "\n",
    "    \"dataset\":\n",
    "        \"GSE174367\",\n",
    "\n",
    "    \"created_utc\":\n",
    "        datetime.now(\n",
    "            timezone.utc\n",
    "        ).isoformat(),\n",
    "\n",
    "    \"status\":\n",
    "        \"AD_DISCOVERY_SENSITIVITY_SUPPORT_FROZEN\",\n",
    "\n",
    "    \"primary_effect_freeze\":\n",
    "        str(\n",
    "            PRIMARY_FREEZE_PATH\n",
    "        ),\n",
    "\n",
    "    \"technical_sensitivity_lock\":\n",
    "        str(\n",
    "            SENSITIVITY_LOCK_PATH\n",
    "        ),\n",
    "\n",
    "    \"primary_FDR_total\":\n",
    "        34,\n",
    "\n",
    "    \"primary_hit_support_rule\":\n",
    "        (\n",
    "            \"same AD-vs-Control log2FC direction \"\n",
    "            \"AND nominal two-sided p<0.05 \"\n",
    "            \"in BOTH RIN and PMI sensitivity models\"\n",
    "        ),\n",
    "\n",
    "    \"sensitivity_FDR_required\":\n",
    "        False,\n",
    "\n",
    "    \"total_primary_FDR_RIN_and_PMI_supported\":\n",
    "        total_both_supported,\n",
    "\n",
    "    \"total_primary_FDR_RIN_and_PMI_FDR\":\n",
    "        total_both_FDR,\n",
    "\n",
    "    \"gene_universes_refiltered\":\n",
    "        False,\n",
    "\n",
    "    \"age_overlap_sensitivity_performed\":\n",
    "        False,\n",
    "\n",
    "    \"support_frozen_before_AD_replication\":\n",
    "        True,\n",
    "\n",
    "    \"support_frozen_before_AD_PD_convergence\":\n",
    "        True,\n",
    "\n",
    "    \"AD_replication_performed\":\n",
    "        False,\n",
    "\n",
    "    \"PD_data_loaded\":\n",
    "        False,\n",
    "\n",
    "    \"AD_PD_convergence_performed\":\n",
    "        False,\n",
    "\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    SUPPORT_FREEZE_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
    "\n",
    "    json.dump(\n",
    "        SUPPORT_FREEZE,\n",
    "        f,\n",
    "        indent=2\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# M. FINAL REPORT\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 22 PASSED — AD TECHNICAL SENSITIVITIES COMPLETE\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSENSITIVITY FDR COUNTS\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    fdr_summary.to_string(\n",
    "        index=False\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PRIMARY vs TECHNICAL-SENSITIVITY CONCORDANCE\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    concordance.to_string(\n",
    "        index=False\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PRIMARY FDR TECHNICAL SUPPORT\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    hit_support_summary.to_string(\n",
    "        index=False\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",    "print(\n",
    "    \"\\nTotal primary FDR hits:\",\n",
    "    34\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Supported by BOTH RIN + PMI:\",\n",
    "    total_both_supported\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Still FDR in BOTH RIN + PMI:\",\n",
    "    total_both_FDR\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSensitivity lock:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    SENSITIVITY_LOCK_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nSensitivity-support freeze:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    SUPPORT_FREEZE_PATH\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nAD REPLICATION PERFORMED: NO\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PD DATA LOADED: NO\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"AD↔PD CONVERGENCE PERFORMED: NO\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nNEXT:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 23 — audit/freeze the technical sensitivity outputs, \"\n",
    "    \"then begin the independently frozen GSE157827 \"\n",
    "    \"AD replication data audit.\"\n",
    ")\n",
    "'''\n",
    "\n",
    "\n",
    "runner_path.write_text(\n",
    "    textwrap.dedent(\n",
    "        RUNNER\n",
    "    ),\n",
    "    encoding=\"utf-8\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"STEP 22 runner written:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    runner_path\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. ENVIRONMENT CHECK\n",
    "# ============================================================\n",
    "\n",
    "environment_check = r'''\n",
    "import pandas\n",
    "import anndata\n",
    "import importlib.metadata\n",
    "\n",
    "print(\"Fresh subprocess:\")\n",
    "print(\"pandas:\", pandas.__version__)\n",
    "print(\"anndata:\", anndata.__version__)\n",
    "print(\n",
    "    \"pydeseq2:\",\n",
    "    importlib.metadata.version(\"pydeseq2\")\n",
    ")\n",
    "\n",
