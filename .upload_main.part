    "        set(\n",
    "            universe.columns\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    expected_genes = (\n",
    "        universe[\n",
    "            \"gene_symbol\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        len(\n",
    "            expected_genes\n",
    "        )\n",
    "        ==\n",
    "        EXPECTED_UNIVERSES[\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        len(\n",
    "            expected_genes\n",
    "        )\n",
    "        ==\n",
    "        len(\n",
    "            set(\n",
    "                expected_genes\n",
    "            )\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    observed_gene_hash = (\n",
    "        ordered_gene_hash(\n",
    "            expected_genes\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    expected_gene_hash = (\n",
    "        frozen_record[\n",
    "            \"gene_universe_sha256\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        observed_gene_hash\n",
    "        ==\n",
    "        expected_gene_hash\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Frozen genes:\",\n",
    "        f\"{len(expected_genes):,}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G3. Frozen counts\n",
    "    #\n",
    "    # Stored:\n",
    "    # genes × donor\n",
    "    #\n",
    "    # Required:\n",
    "    # donor × genes\n",
    "    # ========================================================\n",
    "\n",
    "    raw = pd.read_csv(\n",
    "        counts_path,\n",
    "        compression=\"gzip\",\n",
    "        index_col=0\n",
    "    )\n",
    "\n",
    "\n",
    "    raw.index = (\n",
    "        raw.index\n",
    "        .astype(str)\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        raw.index.tolist()\n",
    "        ==\n",
    "        expected_genes\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G4. Frozen donor metadata\n",
    "    # ========================================================\n",
    "\n",
    "    metadata = pd.read_csv(\n",
    "        metadata_path\n",
    "    )\n",
    "\n",
    "\n",
    "    required_metadata_columns = {\n",
    "\n",
    "        \"pseudobulk_group\",\n",
    "        \"donor_id\",\n",
    "        \"diagnosis_binary\",\n",
    "        \"age\",\n",
    "        \"sex\",\n",
    "        \"PMI\",\n",
    "        \"RIN\",\n",
    "        \"n_nuclei\",\n",
    "        \"library_size\",\n",
    "    }\n",
    "\n",
    "\n",
    "    assert (\n",
    "        required_metadata_columns\n",
    "        <=\n",
    "        set(\n",
    "            metadata.columns\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        metadata\n",
    "    ) == 29\n",
    "\n",
    "\n",
    "    assert (\n",
    "        metadata[\n",
    "            \"donor_id\"\n",
    "        ]\n",
    "        .nunique()\n",
    "        ==\n",
    "        29\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        metadata[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        .value_counts()\n",
    "        .to_dict()\n",
    "        ==\n",
    "        {\n",
    "            \"PD\": 15,\n",
    "            \"Control\": 14,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        metadata[\n",
    "            \"n_nuclei\"\n",
    "        ]\n",
    "        >=\n",
    "        50\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    sample_order = (\n",
    "        metadata[\n",
    "            \"pseudobulk_group\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        raw.columns\n",
    "        .astype(str)\n",
    "        .tolist()\n",
    "        ==\n",
    "        sample_order\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G5. donor × genes count matrix\n",
    "    # ========================================================\n",
    "\n",
    "    counts = (\n",
    "        raw.T\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Explicit OBJECT indexes.\n",
    "    #\n",
    "    # This makes index semantics unambiguous even though\n",
    "    # the fresh Pandas/AnnData pair is now compatible.\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    counts.index = pd.Index(\n",
    "        [\n",
    "            str(x)\n",
    "            for x in counts.index\n",
    "        ],\n",
    "        dtype=\"object\"\n",
    "    )\n",
    "\n",
    "\n",
    "    counts.columns = pd.Index(\n",
    "        [\n",
    "            str(x)\n",
    "            for x in counts.columns\n",
    "        ],\n",
    "        dtype=\"object\"\n",
    "    )\n",
    "\n",
    "\n",
    "    assert counts.shape == (\n",
    "        29,\n",
    "        len(\n",
    "            expected_genes\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        counts.index.tolist()\n",
    "        ==\n",
    "        sample_order\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        counts.columns.tolist()\n",
    "        ==\n",
    "        expected_genes\n",
    "    )\n",
    "\n",
    "\n",
    "    count_array = (\n",
    "        counts\n",
    "        .to_numpy()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert np.isfinite(\n",
    "        count_array\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    assert (\n",
    "        count_array >= 0\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    assert np.allclose(\n",
    "        count_array,\n",
    "        np.round(\n",
    "            count_array\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    counts = counts.astype(\n",
    "        np.int64\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Counts:\",\n",
    "        counts.shape\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G6. DE metadata\n",
    "    # ========================================================\n",
    "\n",
    "    de_meta = (\n",
    "        metadata[\n",
    "            [\n",
    "                \"pseudobulk_group\",\n",
    "                \"donor_id\",\n",
    "                \"age\",\n",
    "                \"sex\",\n",
    "                \"diagnosis_binary\",\n",
    "            ]\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta.index = pd.Index(\n",
    "        [\n",
    "            str(x)\n",
    "            for x\n",
    "            in de_meta[\n",
    "                \"pseudobulk_group\"\n",
    "            ]\n",
    "        ],\n",
    "        dtype=\"object\"\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta = de_meta.drop(\n",
    "        columns=[\n",
    "            \"pseudobulk_group\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta[\n",
    "        \"donor_id\"\n",
    "    ] = (\n",
    "        de_meta[\n",
    "            \"donor_id\"\n",
    "        ]\n",
    "        .astype(\n",
    "            \"object\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta[\n",
    "        \"age\"\n",
    "    ] = pd.to_numeric(\n",
    "        de_meta[\n",
    "            \"age\"\n",
    "        ],\n",
    "        errors=\"raise\"\n",
    "    )\n",
    "\n",
    "\n",
    "    de_meta[\n",
    "        \"sex\"\n",
    "    ] = pd.Categorical(\n",
    "        de_meta[\n",
    "            \"sex\"\n",
    "        ].astype(str),\n",
    "        categories=[\n",
    "            \"Female\",\n",
    "            \"Male\",\n",
    "        ],\n",
    "        ordered=False\n",
    "    )\n",
    "\n",    "\n",
    "    de_meta[\n",
    "        \"diagnosis_binary\"\n",
    "    ] = pd.Categorical(\n",
    "        de_meta[\n",
    "            \"diagnosis_binary\"\n",
    "        ].astype(str),\n",
    "        categories=[\n",
    "            \"Control\",\n",
    "            \"PD\",\n",
    "        ],\n",
    "        ordered=False\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        counts.index.equals(\n",
    "            de_meta.index\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        de_meta[\n",
    "            \"age\"\n",
    "        ]\n",
    "        .notna()\n",
    "        .all()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        de_meta[\n",
    "            \"sex\"\n",
    "        ]\n",
    "        .notna()\n",
    "        .all()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        de_meta[\n",
    "            \"diagnosis_binary\"\n",
    "        ]\n",
    "        .notna()\n",
    "        .all()\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"Metadata:\",\n",
    "        de_meta.shape\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Donor ordering verified: YES\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G7. Construct PyDESeq2 object\n",
    "    # ========================================================\n",
    "\n",
    "    dds = DeseqDataSet(\n",
    "        counts=counts,\n",
    "        metadata=de_meta,\n",
    "        design=(\n",
    "            \"~ age + sex + \"\n",
    "            \"diagnosis_binary\"\n",
    "        ),\n",
    "        refit_cooks=True,\n",
    "        n_cpus=2,\n",
    "        quiet=False,\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"DeseqDataSet construction: PASS\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G8. Verify ACTUAL PyDESeq2 design\n",
    "    # ========================================================\n",
    "\n",
    "    design_matrix = (\n",
    "        dds.obsm[\n",
    "            \"design_matrix\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    design_rank = int(\n",
    "        np.linalg.matrix_rank(\n",
    "            design_matrix.to_numpy()\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    design_n_columns = int(\n",
    "        design_matrix.shape[\n",
    "            1\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nPyDESeq2 design columns:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        design_matrix.columns.tolist()\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"PyDESeq2 design rank:\",\n",
    "        design_rank,\n",
    "        \"/\",\n",
    "        design_n_columns\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        design_rank\n",
    "        ==\n",
    "        design_n_columns\n",
    "        ==\n",
    "        4\n",
    "    )\n",
    "\n",
    "\n",
    "    diagnosis_columns = [\n",
    "\n",
    "        str(col)\n",
    "\n",
    "        for col\n",
    "        in design_matrix.columns\n",
    "\n",
    "        if (\n",
    "            \"diagnosis_binary\"\n",
    "            in str(col)\n",
    "        )\n",
    "    ]\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        diagnosis_columns\n",
    "    ) == 1\n",
    "\n",
    "\n",
    "    assert (\n",
    "        \"PD\"\n",
    "        in diagnosis_columns[\n",
    "            0\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G9. Cell-class output directory\n",
    "    # ========================================================\n",
    "\n",
    "    class_dir = (\n",
    "        DE_ROOT /\n",
    "        cell_type\n",
    "    )\n",
    "\n",
    "\n",
    "    class_dir.mkdir(\n",
    "        exist_ok=True\n",
    "    )\n",
    "\n",
    "\n",
    "    design_matrix_path = (\n",
    "        class_dir /\n",
    "        (\n",
    "            f\"GSE243639_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"PRIMARY_DESIGN_MATRIX_v1.csv\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    design_matrix.to_csv(\n",
    "        design_matrix_path\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G10. FIT DESEQ2\n",
    "    # ========================================================\n",
    "\n",
    "    print(\n",
    "        \"\\nRunning DESeq2 fit...\"\n",
    "    )\n",
    "\n",
    "\n",
    "    dds.deseq2()\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"DESeq2 fit complete.\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G11. Size factors\n",
    "    # ========================================================\n",
    "\n",
    "    assert (\n",
    "        \"size_factors\"\n",
    "        in\n",
    "        dds.obs.columns\n",
    "    )\n",
    "\n",
    "\n",
    "    size_factors = (\n",
    "        dds.obs[\n",
    "            \"size_factors\"\n",
    "        ]\n",
    "        .to_numpy(\n",
    "            dtype=float\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    assert len(\n",
    "        size_factors\n",
    "    ) == 29\n",
    "\n",
    "\n",
    "    assert np.isfinite(\n",
    "        size_factors\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    assert (\n",
    "        size_factors > 0\n",
    "    ).all()\n",
    "\n",
    "\n",
    "    size_factor_table = pd.DataFrame({\n",
    "\n",
    "        \"pseudobulk_group\":\n",
    "            counts.index.tolist(),\n",
    "\n",
    "        \"donor_id\":\n",
    "            metadata[\n",
    "                \"donor_id\"\n",
    "            ]\n",
    "            .astype(str)\n",
    "            .tolist(),\n",
    "\n",
    "        \"diagnosis_binary\":\n",
    "            metadata[\n",
    "                \"diagnosis_binary\"\n",
    "            ]\n",
    "            .astype(str)\n",
    "            .tolist(),\n",
    "\n",
    "        \"size_factor\":\n",
    "            size_factors,\n",
    "    })\n",
    "\n",
    "\n",
    "    size_factor_path = (\n",
    "        class_dir /\n",
    "        (\n",
    "            f\"GSE243639_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"DESEQ2_SIZE_FACTORS_v1.csv\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    size_factor_table.to_csv(\n",
    "        size_factor_path,\n",
    "        index=False\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G12. PD vs CONTROL STATISTICS\n",
    "    #\n",
    "    # Positive LFC:\n",
    "    #   higher in PD\n",
    "    #\n",
    "    # Negative LFC:\n",
    "    #   lower in PD\n",
    "    # ========================================================\n",
    "\n",
    "    stats = DeseqStats(\n",
    "        dds,\n",
    "        contrast=[\n",
    "            \"diagnosis_binary\",\n",
    "            \"PD\",\n",
    "            \"Control\",\n",
    "        ],\n",
    "        alpha=0.05,\n",
    "        cooks_filter=True,\n",
    "        independent_filter=True,\n",
    "        n_cpus=2,\n",
    "        quiet=False,\n",
    "    )\n",
    "\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Complete DE result generation, but suppress large\n",
    "    # dataframe display until all genes are saved.\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    captured_summary = io.StringIO()\n",
    "\n",
    "\n",
    "    with contextlib.redirect_stdout(\n",
    "        captured_summary\n",
    "    ):\n",
    "\n",
    "        stats.summary()\n",
    "\n",
    "\n",
    "    results = (\n",
    "        stats.results_df\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G13. COMPLETE RESULT INTEGRITY\n",
    "    # ========================================================\n",
    "\n",
    "    results.index = pd.Index(\n",
    "        [\n",
    "            str(x)\n",
    "            for x\n",
    "            in results.index\n",
    "        ],\n",
    "        dtype=\"object\"\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        results.index.is_unique\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        set(\n",
    "            results.index\n",
    "        )\n",
    "        ==\n",
    "        set(\n",
    "            expected_genes\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    # Restore exact frozen universe order.\n",
    "    results = (\n",
    "        results\n",
    "        .loc[\n",
    "            expected_genes\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        results.index.tolist()\n",
    "        ==\n",
    "        expected_genes\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        len(\n",
    "            results\n",
    "        )\n",
    "        ==\n",
    "        EXPECTED_UNIVERSES[\n",
    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    required_result_columns = [\n",
    "\n",
    "        \"baseMean\",\n",
    "        \"log2FoldChange\",\n",
    "        \"lfcSE\",\n",
    "        \"stat\",\n",
    "        \"pvalue\",\n",
    "        \"padj\",\n",
    "    ]\n",
    "\n",
    "\n",
    "    missing_result_columns = [\n",
    "\n",
    "        col\n",
    "\n",
    "        for col\n",
    "        in required_result_columns\n",
    "\n",
    "        if col not in results.columns\n",
    "    ]\n",
    "\n",
    "\n",
    "    assert not missing_result_columns, (\n",
    "        f\"{cell_type}: missing \"\n",
    "        f\"{missing_result_columns}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    results.index.name = (\n",
    "        \"gene_symbol\"\n",
    "    )\n",
    "\n",
    "\n",
    "    results = (\n",
    "        results[\n",
    "            required_result_columns\n",
    "        ]\n",
    "        .reset_index()\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G14. PREDECLARED RANK VECTOR\n",
    "    # ========================================================\n",
    "\n",
    "    results[\n",
    "        \"rank_stat\"\n",
    "    ] = (\n",
    "        results[\n",
    "            \"stat\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    results[\n",
    "        \"cell_type\"\n",
    "    ] = (\n",
    "        cell_type\n",
    "    )\n",
    "\n",
    "\n",
    "    results[\n",
    "        \"contrast\"\n",
    "    ] = (\n",
    "        \"PD_vs_Control\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G15. SAVE ALL GENES BEFORE SELECTING SIGNIFICANT GENES\n",
    "    # ========================================================\n",
    "\n",
    "    full_results_path = (\n",
    "        class_dir /\n",
    "        (\n",
    "            f\"GSE243639_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"PD_vs_Control_\"\n",
    "            f\"PRIMARY_DE_ALL_GENES_v1.csv.gz\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    results.to_csv(\n",
    "        full_results_path,\n",
    "        index=False,\n",
    "        compression={\n",
    "            \"method\":\n",
    "                \"gzip\",\n",
    "\n",
    "            \"compresslevel\":\n",
    "                6,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    assert (\n",
    "        full_results_path.exists()\n",
    "    )\n",
    "\n",
    "\n",
    "    full_results_hash = (\n",
    "        sha256_file(\n",
    "            full_results_path\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "        \"\\nFull all-gene result saved.\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G16. RESULT QC\n",
    "    # ========================================================\n",
    "\n",
    "    finite_lfc = np.isfinite(\n",
    "        results[\n",
    "            \"log2FoldChange\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    finite_stat = np.isfinite(\n",
    "        results[\n",
    "            \"stat\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    finite_p = np.isfinite(\n",
    "        results[\n",
    "            \"pvalue\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    finite_padj = np.isfinite(\n",
    "        results[\n",
    "            \"padj\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    genome_sig = (\n",
    "        finite_padj\n",
    "        &\n",
    "        (\n",
    "            results[\n",
    "                \"padj\"\n",
    "            ]\n",
    "            <\n",
    "            0.05\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    significant = (\n",
    "        results\n",
    "        .loc[\n",
    "            genome_sig\n",
    "        ]\n",
    "        .copy()\n",
    "        .sort_values(\n",
    "            [\n",
    "                \"padj\",\n",
    "                \"pvalue\",\n",
    "            ],\n",
    "            ascending=[\n",
    "                True,\n",
    "                True,\n",
    "            ]\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    significant_up = int(\n",
    "        (\n",
    "            significant[\n",
    "                \"log2FoldChange\"\n",
    "            ]\n",
    "            >\n",
    "            0\n",
    "        ).sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    significant_down = int(\n",
    "        (\n",
    "            significant[\n",
    "                \"log2FoldChange\"\n",
    "            ]\n",
    "            <\n",
    "            0\n",
    "        ).sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    significant_zero = int(\n",
    "        (\n",
    "            significant[\n",
    "                \"log2FoldChange\"\n",
    "            ]\n",
    "            ==\n",
    "            0\n",
    "        ).sum()\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G17. SAVE FDR<0.05 CONVENIENCE TABLE\n",
    "    # ========================================================\n",
    "\n",
    "    significant_path = (\n",
    "        class_dir /\n",
    "        (\n",
    "            f\"GSE243639_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"PD_vs_Control_\"\n",
    "            f\"PRIMARY_DE_FDR05_v1.csv.gz\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    significant.to_csv(\n",
    "        significant_path,\n",
    "        index=False,\n",
    "        compression={\n",
    "            \"method\":\n",
    "                \"gzip\",\n",
    "\n",
    "            \"compresslevel\":\n",
    "                6,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G18. SAVE FULL WALD RANK VECTOR\n",
    "    # ========================================================\n",
    "\n",
    "    rank_table = (\n",
    "        results[\n",
    "            [\n",
    "                \"gene_symbol\",\n",
    "                \"rank_stat\",\n",
    "                \"log2FoldChange\",\n",
    "                \"pvalue\",\n",
    "                \"padj\",\n",
    "            ]\n",
    "        ]\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "\n",
    "    rank_path = (\n",
    "        class_dir /\n",
    "        (\n",
    "            f\"GSE243639_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"PD_vs_Control_\"\n",
    "            f\"WALD_RANK_VECTOR_v1.csv.gz\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    rank_table.to_csv(\n",
    "        rank_path,\n",
    "        index=False,\n",
    "        compression={\n",
    "            \"method\":\n",
    "                \"gzip\",\n",
    "\n",
    "            \"compresslevel\":\n",
    "                6,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G19. SAVE DESEQ2 SUMMARY TEXT\n",
    "    # ========================================================\n",
    "\n",
    "    summary_text_path = (\n",
    "        class_dir /\n",
    "        (\n",
    "            f\"GSE243639_\"\n",
    "            f\"{cell_type}_\"\n",
    "            f\"DESEQ2_SUMMARY_OUTPUT_v1.txt\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    with open(\n",
    "        summary_text_path,\n",
    "        \"w\",\n",
    "        encoding=\"utf-8\"\n",
    "    ) as f:\n",
    "\n",
    "        f.write(\n",
    "            captured_summary.getvalue()\n",
    "        )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G20. CELL-CLASS RUN RECORD\n",
    "    # ========================================================\n",
    "\n",
    "    cell_record = {\n",
    "\n",
    "        \"cell_type\":\n",
    "            cell_type,\n",
    "\n",
    "        \"role\":\n",
    "            \"primary\",\n",
    "\n",
    "        \"model\":\n",
    "            \"~ age + sex + diagnosis_binary\",\n",
    "\n",
    "        \"contrast\":\n",
    "            \"PD_vs_Control\",\n",
    "\n",
    "        \"reference_diagnosis\":\n",
    "            \"Control\",\n",
    "\n",
    "        \"reference_sex\":\n",
    "            \"Female\",\n",
    "\n",
    "        \"n_PD\":\n",
    "            15,\n",
    "\n",
    "        \"n_Control\":\n",
    "            14,\n",
    "\n",
    "        \"n_donors\":\n",
    "            29,\n",
    "\n",
    "        \"n_frozen_genes\":\n",
    "            int(\n",
    "                len(\n",
    "                    expected_genes\n",
    "                )\n",
    "            ),\n",
    "\n",
    "        \"gene_universe_sha256\":\n",
    "            expected_gene_hash,\n",
    "\n",
    "        \"design_rank\":\n",
    "            int(\n",
    "                design_rank\n",
    "            ),\n",
    "\n",
    "        \"design_columns\":\n",
    "            int(\n",
    "                design_n_columns\n",
    "            ),\n",
    "\n",
    "        \"n_finite_log2FoldChange\":\n",
    "            int(\n",
    "                finite_lfc.sum()\n",
    "            ),\n",
    "\n",
    "        \"n_finite_Wald_statistics\":\n",
    "            int(\n",
    "                finite_stat.sum()\n",
    "            ),\n",
    "\n",
    "        \"n_finite_pvalues\":\n",
    "            int(\n",
    "                finite_p.sum()\n",
    "            ),\n",
    "\n",
    "        \"n_finite_padj\":\n",
    "            int(\n",
    "                finite_padj.sum()\n",
    "            ),\n",
    "\n",
    "        \"n_FDR_lt_0_05\":\n",
    "            int(\n",
    "                genome_sig.sum()\n",
    "            ),\n",
    "\n",
    "        \"n_FDR_lt_0_05_up_in_PD\":\n",
    "            significant_up,\n",
    "\n",
    "        \"n_FDR_lt_0_05_down_in_PD\":\n",
    "            significant_down,\n",
    "\n",
    "        \"n_FDR_lt_0_05_zero_LFC\":\n",
    "            significant_zero,\n",
    "\n",
    "        \"all_gene_results\":\n",
    "            str(\n",
    "                full_results_path\n",
    "            ),\n",
    "\n",
    "        \"all_gene_results_sha256\":\n",
    "            full_results_hash,\n",
    "\n",
    "        \"FDR05_results\":\n",
    "            str(\n",
    "                significant_path\n",
    "            ),\n",
    "\n",
    "        \"rank_vector\":\n",
    "            str(\n",
    "                rank_path\n",
    "            ),\n",
    "\n",
    "        \"size_factors\":\n",
    "            str(\n",
    "                size_factor_path\n",
    "            ),\n",
    "\n",
    "        \"design_matrix\":\n",
    "            str(\n",
    "                design_matrix_path\n",
    "            ),\n",
    "\n",
    "        \"DESeq2_summary_text\":\n",
    "            str(\n",
    "                summary_text_path\n",
    "            ),\n",
    "    }\n",
    "\n",
    "\n",
    "    run_records[\n",
    "        cell_type\n",
    "    ] = (\n",
    "        cell_record\n",
    "    )\n",
    "\n",
    "\n",
    "    summary_rows.append({\n",
    "\n",
    "        \"cell_type\":\n",
    "            cell_type,\n",
    "\n",
    "        \"PD\":\n",
    "            15,\n",
    "\n",
    "        \"Control\":\n",
    "            14,\n",
    "\n",
    "        \"tested_genes\":\n",
    "            int(\n",
    "                len(\n",
    "                    expected_genes\n",
    "                )\n",
    "            ),\n",
    "\n",
    "        \"finite_pvalue\":\n",
    "            int(\n",
    "                finite_p.sum()\n",
    "            ),\n",
    "\n",
    "        \"finite_padj\":\n",
    "            int(\n",
    "                finite_padj.sum()\n",
    "            ),\n",
    "\n",
    "        \"FDR_lt_0.05\":\n",
    "            int(\n",
    "                genome_sig.sum()\n",
    "            ),\n",
    "\n",
    "        \"up_in_PD\":\n",
    "            significant_up,\n",
    "\n",
    "        \"down_in_PD\":\n",
    "            significant_down,\n",
    "    })\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G21. AGGREGATE-ONLY DISPLAY\n",
    "    # ========================================================\n",
    "\n",
    "    print(\n",
    "        \"\\nResult integrity:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Tested genes:\",\n",
    "        f\"{len(expected_genes):,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Finite p-values:\",\n",
    "        f\"{int(finite_p.sum()):,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Finite adjusted p-values:\",\n",
    "        f\"{int(finite_padj.sum()):,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  FDR < 0.05:\",\n",
    "        f\"{int(genome_sig.sum()):,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Up in PD:\",\n",
    "        f\"{significant_up:,}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"  Down in PD:\",\n",
    "        f\"{significant_down:,}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # G22. MEMORY CLEANUP\n",
    "    # ========================================================\n",
    "\n",
    "    del universe\n",
    "    del raw\n",
    "    del metadata\n",
    "    del counts\n",
    "    del count_array\n",
    "    del de_meta\n",
