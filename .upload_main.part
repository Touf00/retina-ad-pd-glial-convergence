    ")\n",
    "'''\n",
    "\n",
    "\n",
    "runner_path.write_text(\n",
    "    textwrap.dedent(\n",
    "        RUNNER\n",
    "    ),\n",
    "    encoding=\"utf-8\"\n",
    ")\n",
