    "assert (\n",
    "    PYDESEQ2_VERSION\n",
    "    ==\n",
    "    REQUIRED_PYDESEQ2\n",
    "), (\n",
    "    f\"Expected PyDESeq2 \"\n",
    "    f\"{REQUIRED_PYDESEQ2}; \"\n",
    "    f\"found {PYDESEQ2_VERSION}\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
