   "source": [
    "# Source analysis cell: 20\n",
    "# ============================================================\n",
    "# STEP 11 — PRIMARY PD vs CONTROL DIFFERENTIAL EXPRESSION\n",
    "# ENVIRONMENT-SAFE COMPLETE VERSION\n",
    "#\n",
    "# WHY THIS VERSION EXISTS\n",
    "# -----------------------\n",
    "# Current notebook kernel loaded:\n",
    "#   PyDESeq2 0.5.4\n",
    "#   Pandas 2.2.3\n",
    "#   newer AnnData\n",
    "#\n",
    "# Newer AnnData uses:\n",
    "#   pd.StringDtype(na_value=...)\n",
    "#\n",
    "# That API is available in Pandas >= 2.3.\n",
    "#\n",
    "# Rather than corrupt/reload the active Colab Python process,\n",
    "# this cell:\n",
    "#\n",
    "#   1. installs Pandas 2.3.3 on disk,\n",
    "#   2. writes a fresh standalone STEP 11 runner,\n",
    "#   3. launches that runner in a NEW Python process,\n",
    "#   4. performs all four frozen primary DE analyses,\n",
    "#   5. saves all results and run locks,\n",
    "#   6. prints the final four-row summary.\n",
    "#\n",
    "# FROZEN BIOLOGICAL ANALYSIS IS UNCHANGED.\n",
    "#\n",
    "# PRIMARY CLASSES:\n",
    "#   Astro\n",
    "#   Micro\n",
    "#   OPC\n",
    "#   Oligo\n",
    "#\n",
    "# MODEL:\n",
    "#   ~ age + sex + diagnosis_binary\n",
    "#\n",
    "# CONTRAST:\n",
    "#   PD vs Control\n",
    "#\n",
    "# NO refiltering.\n",
    "# NO secondary VC/Neuron DE.\n",
    "# NO sensitivity analysis yet.\n",
    "# ============================================================\n",
    "\n",
    "\n",
    "import sys\n",
    "import subprocess\n",
    "from pathlib import Path\n",
    "import textwrap\n",
    "import importlib.metadata\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. FIX DISK ENVIRONMENT FOR FRESH SUBPROCESS\n",
    "# ============================================================\n",
    "\n",
    "TARGET_PANDAS = \"2.3.3\"\n",
    "TARGET_PYDESEQ2 = \"0.5.4\"\n",
    "\n",
    "\n",
    "print(\"=\" * 80)\n",
    "print(\"STEP 11 ENVIRONMENT PREPARATION\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Install compatible pandas.\n",
    "#\n",
    "# The CURRENT notebook process may continue reporting the old\n",
    "# pandas because it is already imported in memory.\n",
    "#\n",
    "# The fresh subprocess launched below will import 2.3.3.\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "subprocess.check_call(\n",
    "    [\n",
    "        sys.executable,\n",
    "        \"-m\",\n",
    "        \"pip\",\n",
    "        \"install\",\n",
    "        \"-q\",\n",
    "        \"--upgrade\",\n",
    "        f\"pandas=={TARGET_PANDAS}\",\n",
    "        f\"pydeseq2=={TARGET_PYDESEQ2}\",\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Compatible packages installed on disk.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. CREATE STANDALONE RUNNER\n",
    "# ============================================================\n",
    "\n",
    "runner_path = Path(\n",
    "    \"/content/RETINA_ND_STEP11_PRIMARY_DE_RUNNER.py\"\n",
    ")\n",
    "\n",
    "\n",
    "RUNNER = r'''\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "import sys\n",
    "import platform\n",
    "import hashlib\n",
    "import json\n",
    "import gc\n",
    "import io\n",
    "import contextlib\n",
    "import importlib.metadata\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from packaging.version import Version\n",
    "\n",
    "from pydeseq2.dds import DeseqDataSet\n",
    "from pydeseq2.ds import DeseqStats\n",
    "\n",
    "import anndata\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# A. ENVIRONMENT LOCK\n",
    "# ============================================================\n",
    "\n",
    "REQUIRED_PYDESEQ2 = \"0.5.4\"\n",
    "MINIMUM_PANDAS = Version(\"2.3.0\")\n",
    "\n",
    "\n",
    "def package_version(name):\n",
    "\n",
    "    try:\n",
    "        return importlib.metadata.version(\n",
    "            name\n",
    "        )\n",
    "\n",
    "    except importlib.metadata.PackageNotFoundError:\n",
    "        return None\n",
    "\n",
    "\n",
    "PYDESEQ2_VERSION = package_version(\n",
    "    \"pydeseq2\"\n",
    ")\n",
    "\n",
    "PANDAS_VERSION = package_version(\n",
    "    \"pandas\"\n",
    ")\n",
    "\n",
    "ANNDATA_VERSION = package_version(\n",
    "    \"anndata\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"FRESH STEP 11 SUBPROCESS ENVIRONMENT\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "print(\n",
    "    \"Python:\",\n",
    "    platform.python_version()\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"PyDESeq2:\",\n",
    "    PYDESEQ2_VERSION\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"AnnData:\",\n",
    "    ANNDATA_VERSION\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Pandas:\",\n",
    "    PANDAS_VERSION\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"NumPy:\",\n",
    "    np.__version__\n",
    ")\n",
    "\n",
