    "            cell_type\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    counts_path = Path(\n",
    "        frozen_record[\n",
    "            \"raw_counts_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    metadata_path = Path(\n",
    "        frozen_record[\n",
    "            \"eligible_donor_metadata\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    universe_path = Path(\n",
    "        frozen_record[\n",
    "            \"gene_universe_file\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "    for path in [\n",
    "        counts_path,\n",
    "        metadata_path,\n",
