   "source": [
    "# Source analysis cell: 3\n",
    "# ============================================================\n",
    "# STEP 1 — FREEZE MASTER ANALYSIS PROTOCOL\n",
    "# Must be run before any disease-expression result is examined.\n",
    "# ============================================================\n",
    "\n",
    "from datetime import datetime, timezone\n",
    "import json, hashlib\n",
    "\n",
    "protocol = {\n",
    "    \"project\": \"RETINA-ND\",\n",
    "    \"version\": \"2.0-recovery\",\n",
    "    \"created_utc\": datetime.now(timezone.utc).isoformat(),\n",
    "    \"biological_replicate\": \"human donor\",\n",
    "    \"primary_cross_disease_cell_classes\": [\n",
    "        \"astrocyte\",\n",
    "        \"microglia\",\n",
    "        \"endothelial\",\n",
    "        \"pericyte_or_mural\",\n",
    "        \"oligodendrocyte\",\n",
    "        \"OPC\",\n",
    "    ],\n",
    "    \"neuronal_cross_region_analysis\": \"secondary_pathway_level_only\",\n",
    "    \"discovery_logic\": {\n",
    "        \"AD_and_PD_analyzed_separately_first\": True,\n",
    "        \"no_cell_level_pseudoreplication\": True,\n",
    "        \"raw_counts_for_pseudobulk_DE\": True,\n",
    "        \"gene_universe_frozen_before_DE\": True,\n",
    "        \"effect_sizes_retained_regardless_of_significance\": True,\n",
    "        \"rank_based_pathway_analysis_primary_for_convergence\": True,\n",
    "    },\n",
    "    \"retina_logic\": {\n",
    "        \"retinal_reference_is_independent_of_brain_discovery\": True,\n",
    "        \"retinal_cell_type_localization_before_ocular_disease_testing\": True,\n",
    "        \"normal_retinal_aging_is_a_specificity_penalty\": True,\n",
    "        \"ocular_fluid_not_assumed_to_equal_retinal_tissue\": True,\n",
    "    },\n",
    "    \"claims_prohibited_without_longitudinal_evidence\": [\n",
    "        \"retina_detects_disease_before_brain\",\n",
    "        \"retinal_marker_is_preclinical\",\n",
    "        \"candidate_is_diagnostic\",\n",
    "        \"candidate_is causal solely from expression association\",\n",
    "    ],\n",
    "    \"candidate_ranking_dimensions\": [\n",
    "        \"AD_PD_brain_convergence\",\n",
    "        \"retinal_cell_type_expression\",\n",
    "        \"AD_retina_disease_support\",\n",
    "        \"PD_ocular_disease_support\",\n",
    "        \"retinal_aging_specificity\",\n",
    "        \"systemic_proteomic_support\",\n",
    "        \"genetic_or_QTL_support\",\n",
    "    ],\n",
    "}\n",
    "\n",
    "payload = json.dumps(protocol, sort_keys=True, indent=2).encode(\"utf-8\")\n",
    "protocol[\"sha256\"] = hashlib.sha256(payload).hexdigest()\n",
    "\n",
    "lock_path = LOCKS / \"RETINA_ND_MASTER_PROTOCOL_LOCK_v1.json\"\n",
    "with open(lock_path, \"w\", encoding=\"utf-8\") as f:\n",
    "    json.dump(protocol, f, indent=2)\n",
    "\n",
    "print(json.dumps(protocol, indent=2))\n",
    "print(\"\\nLOCKED:\", lock_path)"
   ]
  },
