    "        index=False\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 14. ANNOTATION CONFIDENCE\n",
    "# ============================================================\n",
    "\n",
    "n_low_margin_clusters = int(\n",
    "    cluster_table[\n",
    "        \"low_margin_lt_0.5\"\n",
    "    ].sum()\n",
    ")\n",
    "\n",
    "\n",
    "n_low_margin_cells = int(\n",
    "    cluster_table.loc[\n",
    "        cluster_table[\n",
    "            \"low_margin_lt_0.5\"\n",
    "        ],\n",
    "\n",
    "        \"n_nuclei\",\n",
    "    ].sum()\n",
    ")\n",
    "\n",
    "\n",
    "low_margin_fraction = float(\n",
    "    n_low_margin_cells\n",
    "    /\n",
    "    169506\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 90\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"ANNOTATION CONFIDENCE\"\n",
    ")\n",
    "\n",
    "print(\n",
