    "# Source analysis cell: 5\n",
    "# ============================================================\n",
    "# V2 DATASET ROLE LOCK + REGISTRY\n",
    "# ============================================================\n",
    "import pandas as pd, json\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "AD_DATASET_ROLES = {\n",
    "    'created_utc': datetime.now(timezone.utc).isoformat(),\n",
    "    'status': 'AD_DATASET_ROLES_FROZEN_BEFORE_DISEASE_EXPRESSION',\n",
    "    'primary_discovery': {'dataset':'GSE174367','tissue':'human_prefrontal_cortex','assay':'snRNA-seq','role':'AD_brain_discovery'},\n",
    "    'primary_replication': {'dataset':'GSE157827','tissue':'human_prefrontal_cortex','assay':'snRNA-seq','role':'AD_brain_primary_replication'},\n",
    "    'secondary_external_replication': {'dataset':'GSE138852','tissue':'human_entorhinal_cortex','assay':'snRNA-seq','role':'AD_brain_secondary_region_replication'},\n",
    "    'tertiary_external_replication': {'dataset':'GSE222494','tissue':'human_frontal_cortex','assay':'snRNA-seq','role':'AD_brain_tertiary_external_replication','primary_contrast':'sporadic_AD_vs_control'},\n",
    "    'primary_homologous_cell_classes':['Astro','Micro','OPC','Oligo'],\n",
    "    'AD_disease_expression_inspected': False,\n",
    "}\n",
    "with open(LOCKS/'AD_BRAIN_DATASET_ROLES_v1.json','w') as f: json.dump(AD_DATASET_ROLES,f,indent=2)\n",
    "\n",
    "registry = pd.DataFrame([\n",
    "['GSE243639','PD','SNpc','snRNA-seq','primary_PD_discovery','CORE','auto'],\n",
    "['GSE157783','PD','midbrain','snRNA-seq','primary_PD_replication','CORE','auto'],\n",
    "['GSE329625','PD','ventral_SNpc','snRNA-seq','secondary_PD_external_replication','SUPPORT','optional'],\n",
    "['GSE174367','AD','PFC','snRNA-seq','primary_AD_discovery','CORE','auto'],\n",
    "['GSE157827','AD','PFC','snRNA-seq','primary_AD_replication','CORE','auto'],\n",
    "['GSE138852','AD','entorhinal_cortex','snRNA-seq','secondary_AD_external_replication','CORE','auto_after_primary'],\n",
    "['GSE222494','AD','frontal_cortex','snRNA-seq','tertiary_AD_external_replication','SUPPORT','optional'],\n",
    "['GSE265774','reference','retina','snRNA+snATAC','retinal_localization_and_aging','CORE_RETINA','processed_reference_preferred'],\n",
    "['GSE148077','reference','retina','scRNA-seq','independent_retina_reference','SUPPORT','auto_optional'],\n",
    "['PXD073336','AD','retina+hippocampus','proteomics','AD_retina_validation_primary','CORE_RETINA','auto_processed'],\n",
    "['PXD040225','AD','retina','proteomics','AD_retina_validation_secondary','SUPPORT','optional_processed'],\n",
    "['Wolf_Cell_2023','PD','aqueous_humor','SomaScan','PD_ocular_validation','CORE_RETINA','auto_supplement'],\n",
    "['GSE137847','AMD','retina','scRNA-seq','retinal_disease_specificity','SUPPORT','optional'],\n",
    "['GSE135092','AMD','retina+RPE','bulk_RNA-seq','retinal_disease_specificity','SUPPORT','optional'],\n",
    "['GNPC_2025','AD_PD','plasma','proteomics','systemic_corroboration','SUPPORT','data_request_nonblocking'],\n",
    "], columns=['dataset','disease','tissue','modality','role','tier','acquisition'])\n",
    "registry.to_csv(MANIFESTS/'RETINA_ND_V2_dataset_registry.csv',index=False)\n",
    "display(registry)\n",
    "print('Dataset role lock:', LOCKS/'AD_BRAIN_DATASET_ROLES_v1.json')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Part I — PD discovery and replication\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 8\n",
    "# ============================================================\n",
    "# STEP 3 — DOWNLOAD / REGISTER GSE243639 PUBLIC FILES\n",
    "# Internet access is required when run in Colab.\n",
    "# ============================================================\n",
    "\n",
    "import requests\n",
    "from pathlib import Path\n",
    "\n",
    "PD_DIR = ROOT / \"GSE243639_PD_discovery\"\n",
    "PD_DIR.mkdir(exist_ok=True)\n",
    "\n",
    "urls = {\n",
    "    \"clinical\": (\n",
    "        \"https://ftp.ncbi.nlm.nih.gov/geo/series/GSE243nnn/\"\n",
    "        \"GSE243639/suppl/GSE243639_Clinical_data.csv.gz\"\n",
    "    ),\n",
    "    \"filtered_counts\": (\n",
    "        \"https://ftp.ncbi.nlm.nih.gov/geo/series/GSE243nnn/\"\n",
    "        \"GSE243639/suppl/GSE243639_Filtered_count_table.csv.gz\"\n",
    "    ),\n",
    "}\n",
    "\n",
    "for label, url in urls.items():\n",
    "    target = PD_DIR / url.split(\"/\")[-1]\n",
    "    if target.exists() and target.stat().st_size > 0:\n",
    "        print(label, \"already present:\", target, target.stat().st_size)\n",
    "        continue\n",
    "\n",
    "    print(\"Downloading\", label, \"...\")\n",
    "    with requests.get(url, stream=True, timeout=120) as r:\n",
    "        r.raise_for_status()\n",
    "        with open(target, \"wb\") as f:\n",
    "            for chunk in r.iter_content(chunk_size=1024 * 1024):\n",
    "                if chunk:\n",
    "                    f.write(chunk)\n",
    "\n",
    "    print(\"saved:\", target, target.stat().st_size)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 9\n",
    "# ============================================================\n",
    "# STEP 4 — FILE IDENTITY LOCK\n",
    "# Freeze bytes before parsing.\n",
    "# ============================================================\n",
    "\n",
    "import hashlib\n",
    "\n",
    "def sha256_file(path, block=1024*1024):\n",
    "    h = hashlib.sha256()\n",
    "    with open(path, \"rb\") as f:\n",
    "        while True:\n",
    "            b = f.read(block)\n",
    "            if not b:\n",
    "                break\n",
    "            h.update(b)\n",
    "    return h.hexdigest()\n",
    "\n",
    "identity = {}\n",
    "for path in sorted(PD_DIR.glob(\"*\")):\n",
    "    if path.is_file():\n",
    "        identity[path.name] = {\n",
    "            \"bytes\": path.stat().st_size,\n",
    "            \"sha256\": sha256_file(path),\n",
    "        }\n",
    "\n",
    "identity_path = LOCKS / \"GSE243639_FILE_IDENTITY_LOCK_v1.json\"\n",
    "with open(identity_path, \"w\", encoding=\"utf-8\") as f:\n",
    "    json.dump(identity, f, indent=2)\n",
    "\n",
    "print(json.dumps(identity, indent=2))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 10\n",
    "# ============================================================\n",
    "# RETINA-ND V2 — STEP 5 — CORRECTED\n",
    "# GSE243639 GEO CLINICAL FILE AUDIT\n",
    "#\n",
    "# PURPOSE\n",
    "# -------\n",
    "# The GEO file GSE243639_Clinical_data.csv.gz is publicly\n",
    "# supplied but structurally malformed as a conventional CSV.\n",
    "#\n",
    "# This step:\n",
    "#   - verifies the file exists\n",
    "#   - verifies gzip/text readability\n",
    "#   - audits delimiter/field-count inconsistency\n",
    "#   - records the problem reproducibly\n",
    "#   - DOES NOT coerce it into donor metadata\n",
    "#\n",
    "# Authoritative donor metadata will be reconstructed in STEP 6\n",
    "# from Martirosyan et al. Supplementary Table 1.\n",
    "#\n",
    "# NO expression analysis.\n",
    "# NO donor metadata derived here.\n",
    "# ============================================================\n",
    "\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "import gzip\n",
    "import hashlib\n",
    "import json\n",
    "import csv\n",
    "import pandas as pd\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. PATHS\n",
    "# ============================================================\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "\n",
    "PD_DIR = (\n",
    "    ROOT\n",
    "    /\n",
    "    \"GSE243639_PD_discovery\"\n",
    ")\n",
    "\n",
    "LOCKS = (\n",
    "    ROOT\n",
    "    /\n",
    "    \"locks\"\n",
    ")\n",
    "\n",
    "MANIFESTS = (\n",
    "    ROOT\n",
    "    /\n",
    "    \"manifests\"\n",
    ")\n",
    "\n",
    "\n",
    "for directory in [\n",
    "    ROOT,\n",
    "    PD_DIR,\n",
    "    LOCKS,\n",
    "    MANIFESTS,\n",
    "]:\n",
    "\n",
    "    assert directory.exists(), (\n",
    "        f\"Required directory missing: {directory}\"\n",
    "    )\n",
    "\n",
    "\n",
    "clinical_path = (\n",
    "    PD_DIR\n",
    "    /\n",
    "    \"GSE243639_Clinical_data.csv.gz\"\n",
    ")\n",
    "\n",
    "\n",
    "assert clinical_path.exists(), clinical_path\n",
    "\n",
    "assert clinical_path.stat().st_size > 0\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. HASH\n",
    "# ============================================================\n",
    "\n",
    "def sha256_file(\n",
    "    path,\n",
    "    block_size=1024 * 1024,\n",
    "):\n",
    "\n",
    "    h = hashlib.sha256()\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\",\n",
    "    ) as handle:\n",
    "\n",
    "        while True:\n",
    "\n",
    "            block = handle.read(\n",
    "                block_size\n",
    "            )\n",
    "\n",
    "            if not block:\n",
    "                break\n",
    "\n",
    "            h.update(\n",
    "                block\n",
    "            )\n",
    "\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "clinical_sha256 = sha256_file(\n",
    "    clinical_path\n",
    ")\n",
    "\n",
    "\n",
    "print(\"=\" * 100)\n",
    "print(\"RETINA-ND V2 — STEP 5 — GSE243639 GEO CLINICAL FILE AUDIT\")\n",
    "print(\"=\" * 100)\n",
    "\n",
    "print(\n",
    "    \"\\nFile:\",\n",
    "    clinical_path,\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Bytes:\",\n",
    "    clinical_path.stat().st_size,\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"SHA256:\",\n",
    "    clinical_sha256,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. VERIFY GZIP + TEXT READABILITY\n",
    "# ============================================================\n",
    "\n",
    "with gzip.open(\n",
    "    clinical_path,\n",
    "    \"rt\",\n",
    "    encoding=\"utf-8\",\n",
    "    errors=\"replace\",\n",
    ") as handle:\n",
    "\n",
    "    raw_lines = handle.readlines()\n",
    "\n",
    "\n",
    "assert len(\n",
    "    raw_lines\n",
    ") > 0\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nText lines:\",\n",
    "    len(\n",
    "        raw_lines\n",
    "    ),\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. AUDIT FIELD COUNTS\n",
    "#\n",
    "# We intentionally do NOT assume this is a valid rectangular\n",
    "# CSV. We inspect its raw structure first.\n",
    "# ============================================================\n",
    "\n",
    "audit_rows = []\n",
    "\n",
    "\n",
    "for line_number, raw_line in enumerate(\n",
    "    raw_lines,\n",
    "    start=1,\n",
    "):\n",
    "\n",
    "    text = raw_line.rstrip(\n",
    "        \"\\r\\n\"\n",
    "    )\n",
    "\n",
    "    # CSV-aware comma parsing of each individual line.\n",
    "    try:\n",
    "\n",
    "        comma_fields = next(\n",
    "            csv.reader(\n",
    "                [\n",
    "                    text\n",
    "                ],\n",
    "                delimiter=\",\",\n",
    "            )\n",
    "        )\n",
    "\n",
    "        n_comma_fields = len(\n",
    "            comma_fields\n",
    "        )\n",
    "\n",
    "    except Exception:\n",
    "\n",
    "        n_comma_fields = None\n",
    "\n",
    "\n",
    "    n_tabs = text.count(\n",
    "        \"\\t\"\n",
    "    )\n",
    "\n",
    "    n_semicolons = text.count(\n",
    "        \";\"\n",
    "    )\n",
    "\n",
    "\n",
    "    audit_rows.append(\n",
    "        {\n",
    "            \"line_number\":\n",
    "                line_number,\n",
    "\n",
    "            \"characters\":\n",
    "                len(\n",
    "                    text\n",
    "                ),\n",
    "\n",
    "            \"comma_csv_fields\":\n",
    "                n_comma_fields,\n",
    "\n",
    "            \"tab_delimiters\":\n",
    "                n_tabs,\n",
    "\n",
    "            \"semicolon_delimiters\":\n",
    "                n_semicolons,\n",
    "\n",
    "            \"preview\":\n",
    "                text[\n",
    "                    :300\n",
    "                ],\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "audit_df = pd.DataFrame(\n",
    "    audit_rows\n",
    ")\n",
    "\n",
    "\n",
    "field_counts = (\n",
    "    audit_df[\n",
    "        \"comma_csv_fields\"\n",
    "    ]\n",
    "    .value_counts(\n",
    "        dropna=False\n",
    "    )\n",
    "    .sort_index()\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nCSV field-count distribution:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    field_counts.to_string()\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nFirst 15 raw lines:\"\n",
    ")\n",
    "\n",
    "\n",
    "for row in audit_rows[\n",
    "    :15\n",
    "]:\n",
    "\n",
    "    print(\n",
    "        f\"\\nLINE {row['line_number']}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        row[\n",
    "            \"preview\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. CONFIRM STANDARD PANDAS PARSING FAILURE\n",
    "#\n",
    "# This is an AUDIT only.\n",
    "# Failure here is expected and captured, not raised.\n",
    "# ============================================================\n",
    "\n",
    "standard_parse_success = False\n",
    "\n",
    "standard_parse_error = None\n",
    "\n",
    "\n",
    "try:\n",
    "\n",
    "    _test = pd.read_csv(\n",
    "        clinical_path\n",
    "    )\n",
    "\n",
    "    standard_parse_success = True\n",
    "\n",
    "except Exception as exc:\n",
    "\n",
    "    standard_parse_error = (\n",
    "        f\"{type(exc).__name__}: {exc}\"\n",
    "    )\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nStandard pd.read_csv success:\",\n",
    "    standard_parse_success,\n",
    ")\n",
    "\n",
    "\n",
    "if standard_parse_error is not None:\n",
    "\n",
    "    print(\n",
    "        \"Captured parser error:\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        standard_parse_error\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. CLASSIFY FILE\n",
    "# ============================================================\n",
    "\n",
    "unique_field_counts = sorted(\n",
    "    [\n",
    "        int(\n",
    "            x\n",
    "        )\n",
    "\n",
    "        for x in\n",
    "        audit_df[\n",
    "            \"comma_csv_fields\"\n",
    "        ]\n",
    "        .dropna()\n",
    "        .unique()\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "rectangular_csv = (\n",
    "    len(\n",
    "        unique_field_counts\n",
    "    )\n",
    "    ==\n",
    "    1\n",
    ")\n",
    "\n",
    "\n",
    "# For this dataset we EXPECT this GEO clinical file not to be\n",
    "# suitable as the authoritative donor metadata table.\n",
    "assert (\n",
    "    standard_parse_success\n",
    "    is False\n",
    "), (\n",
    "    \"Unexpectedly, the GEO clinical file now parses cleanly. \"\n",
    "    \"Stop and inspect it before changing the frozen metadata source.\"\n",
    ")\n",
    "\n",
    "\n",
    "assert (\n",
    "    rectangular_csv\n",
    "    is False\n",
    "), (\n",
    "    \"Unexpectedly rectangular CSV structure detected. \"\n",
    "    \"Stop and inspect rather than silently changing metadata provenance.\"\n",
    ")\n",
    "\n",
    "\n",
    "classification = (\n",
    "    \"PUBLIC_GEO_FILE_STRUCTURALLY_NONRECTANGULAR_\"\n",
    "    \"NOT_USED_AS_AUTHORITATIVE_DONOR_METADATA\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nClassification:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    classification\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. SAVE AUDIT TABLE\n",
    "# ============================================================\n",
    "\n",
    "audit_path = (\n",
    "    MANIFESTS\n",
    "    /\n",
    "    \"GSE243639_GEO_CLINICAL_RAW_STRUCTURE_AUDIT_v1.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "audit_df.to_csv(\n",
    "    audit_path,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. FREEZE PROVENANCE DECISION\n",
    "# ============================================================\n",
    "\n",
    "lock_path = (\n",
    "    LOCKS\n",
    "    /\n",
    "    \"GSE243639_GEO_CLINICAL_FILE_AUDIT_v1.json\"\n",
    ")\n",
    "\n",
    "\n",
    "lock = {\n",
    "    \"dataset\":\n",
    "        \"GSE243639\",\n",
    "\n",
    "    \"created_utc\":\n",
    "        datetime.now(\n",
    "            timezone.utc\n",
    "        ).isoformat(),\n",
    "\n",
    "    \"status\":\n",
    "        \"GEO_CLINICAL_FILE_AUDITED_NONAUTHORITATIVE\",\n",
    "\n",
    "    \"file\":\n",
    "        str(\n",
    "            clinical_path\n",
    "        ),\n",
    "\n",
    "    \"bytes\":\n",
    "        int(\n",
    "            clinical_path.stat().st_size\n",
    "        ),\n",
    "\n",
    "    \"sha256\":\n",
    "        clinical_sha256,\n",
    "\n",
    "    \"gzip_readable\":\n",
    "        True,\n",
    "\n",
    "    \"n_text_lines\":\n",
    "        int(\n",
    "            len(\n",
    "                raw_lines\n",
    "            )\n",
    "        ),\n",
    "\n",
    "    \"comma_field_counts_observed\":\n",
    "        unique_field_counts,\n",
    "\n",
    "    \"rectangular_csv\":\n",
    "        bool(\n",
    "            rectangular_csv\n",
    "        ),\n",
    "\n",
    "    \"standard_pandas_parse_success\":\n",
    "        bool(\n",
    "            standard_parse_success\n",
    "        ),\n",
    "\n",
    "    \"standard_pandas_parse_error\":\n",
    "        standard_parse_error,\n",
    "\n",
    "    \"classification\":\n",
    "        classification,\n",
    "\n",
    "    \"used_for_donor_metadata\":\n",
    "        False,\n",
    "\n",
    "    \"authoritative_donor_metadata_source\":\n",
    "        (\n",
    "            \"Martirosyan et al. Supplementary Table 1; \"\n",
    "            \"loaded independently in STEP 6\"\n",
    "        ),\n",
    "\n",
    "    \"expression_analysis_performed\":\n",
    "        False,\n",
    "\n",
    "    \"disease_expression_inspected\":\n",
    "        False,\n",
    "}\n",
    "\n",
    "\n",
    "with open(\n",
    "    lock_path,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as handle:\n",
    "\n",
    "    json.dump(\n",
    "        lock,\n",
    "        handle,\n",
    "        indent=2,\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. FINAL REPORT\n",
    "# ============================================================\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 100\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"STEP 5 PASS — GEO CLINICAL FILE AUDITED\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 100\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nThe GEO clinical file is structurally non-rectangular \"\n",
    "    \"and is NOT being used as donor metadata.\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"\\nRaw-structure audit:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    audit_path\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"\\nAudit lock:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    lock_path\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"\\nDONOR METADATA CREATED: NO\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"EXPRESSION ANALYZED: NO\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"\\nNEXT:\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Run STEP 6 exactly as written: obtain authoritative \"\n",
    "    \"GSE243639 donor metadata from Martirosyan et al. \"\n",
    "    \"Supplementary Table 1.\"\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 11\n",
    "# ============================================================\n",
    "# STEP 6 — LOAD AUTHORITATIVE DONOR METADATA\n",
    "# Source: Martirosyan et al. Supplementary Table 1\n",
    "# We intentionally DO NOT use the malformed GEO clinical CSV.\n",
    "# ============================================================\n",
    "\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "import requests\n",
    "import re\n",
    "import numpy as np\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Paths\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "PD_DIR = ROOT / \"GSE243639_PD_discovery\"\n",
    "\n",
    "ROOT.mkdir(parents=True, exist_ok=True)\n",
    "PD_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "supp1_path = PD_DIR / \"Martirosyan_2024_Supplementary_Table_1.xlsx\"\n",
    "\n",
    "# Official Springer supplementary file\n",
    "supp1_url = (\n",
    "    \"https://media.springernature.com/original/\"\n",
    "    \"springer-static/esm/art%3A10.1186%2Fs13024-023-00699-0/\"\n",
    "    \"MediaObjects/13024_2023_699_MOESM1_ESM.xlsx\"\n",
    ")\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Download if necessary\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "if not supp1_path.exists() or supp1_path.stat().st_size < 5000:\n",
    "\n",
    "    print(\"Downloading Supplementary Table 1...\")\n",
    "\n",
    "    headers = {\n",
    "        \"User-Agent\": \"Mozilla/5.0\"\n",
    "    }\n",
    "\n",
    "    r = requests.get(\n",
    "        supp1_url,\n",    "        headers=headers,\n",
    "        timeout=120\n",
    "    )\n",
    "\n",
    "    r.raise_for_status()\n",
    "\n",
    "    supp1_path.write_bytes(r.content)\n",
    "\n",
    "    print(\n",
    "        \"Downloaded:\",\n",
    "        supp1_path,\n",
    "        f\"{supp1_path.stat().st_size / 1024:.1f} KB\"\n",
    "    )\n",
    "\n",
    "else:\n",
    "\n",
    "    print(\n",
    "        \"Supplementary Table 1 already present:\",\n",
    "        supp1_path\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Check Excel workbook\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "xls = pd.ExcelFile(supp1_path)\n",
    "\n",
    "print(\"\\nWorkbook sheets:\")\n",
    "print(xls.sheet_names)\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Read first sheet WITHOUT assuming header position\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "raw = pd.read_excel(\n",
    "    supp1_path,\n",
    "    sheet_name=xls.sheet_names[0],\n",
    "    header=None\n",
    ")\n",
    "\n",
    "print(\"\\nRaw table shape:\", raw.shape)\n",
    "\n",
    "print(\"\\nFirst 12 rows before header detection:\")\n",
    "display(raw.head(12))\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Automatically locate header row\n",
    "#\n",
    "# We expect donor metadata labels such as:\n",
    "# sample / diagnosis / age / sex / PMI / RIN\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "def norm(x):\n",
    "    return re.sub(\n",
    "        r\"[^a-z0-9]+\",\n",
    "        \"\",\n",
    "        str(x).lower()\n",
    "    )\n",
    "\n",
    "\n",
    "header_keywords = [\n",
    "    \"sample\",\n",
    "    \"donor\",\n",
    "    \"diagnosis\",\n",
    "    \"condition\",\n",
    "    \"age\",\n",
    "    \"sex\",\n",
    "    \"gender\",\n",
    "    \"pmi\",\n",
    "    \"rin\",\n",
    "]\n",
    "\n",
    "\n",
    "best_row = None\n",
    "best_score = -1\n",
    "\n",
    "for i in range(min(20, len(raw))):\n",
    "\n",
    "    values = [\n",
    "        norm(x)\n",
    "        for x in raw.iloc[i].tolist()\n",
    "        if pd.notna(x)\n",
    "    ]\n",
    "\n",
    "    score = 0\n",
    "\n",
    "    for keyword in header_keywords:\n",
    "\n",
    "        k = norm(keyword)\n",
    "\n",
    "        if any(\n",
    "            k == v or k in v\n",
    "            for v in values\n",
    "        ):\n",
    "            score += 1\n",
    "\n",
    "    if score > best_score:\n",
    "        best_score = score\n",
    "        best_row = i\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nDetected header row:\",\n",
    "    best_row,\n",
    "    \"| score:\",\n",
    "    best_score\n",
    ")\n",
    "\n",
    "assert best_score >= 3, (\n",
    "    \"Could not confidently identify the metadata header row. \"\n",
    "    \"Inspect the displayed first 12 rows.\"\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Reload using detected header\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "clinical = pd.read_excel(\n",
    "    supp1_path,\n",
    "    sheet_name=xls.sheet_names[0],\n",
    "    header=best_row\n",
    ")\n",
    "\n",
    "# remove completely empty columns\n",
    "clinical = clinical.dropna(\n",
    "    axis=1,\n",
    "    how=\"all\"\n",
    ")\n",
    "\n",
    "# remove completely empty rows\n",
    "clinical = clinical.dropna(\n",
    "    axis=0,\n",
    "    how=\"all\"\n",
    ").reset_index(drop=True)\n",
    "\n",
    "\n",
    "print(\"\\nParsed clinical table shape:\", clinical.shape)\n",
    "\n",
    "print(\"\\nColumns:\")\n",
    "for i, c in enumerate(clinical.columns):\n",
    "    print(f\"{i:2d}: {repr(c)}\")\n",
    "\n",
    "display(clinical.head())\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Automatic metadata column identification\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "def find_column(df, aliases):\n",
    "\n",
    "    cols = list(df.columns)\n",
    "\n",
    "    # exact normalized matches first\n",
    "    for alias in aliases:\n",
    "\n",
    "        a = norm(alias)\n",
    "\n",
    "        for col in cols:\n",
    "\n",
    "            if norm(col) == a:\n",
    "                return col\n",
    "\n",
    "    # then partial match\n",
    "    for alias in aliases:\n",
    "\n",
    "        a = norm(alias)\n",
    "\n",
    "        for col in cols:\n",
    "\n",
    "            c = norm(col)\n",
    "\n",
    "            if a and (\n",
    "                a in c or\n",
    "                c in a\n",
    "            ):\n",
    "                return col\n",
    "\n",
    "    return None\n",
    "\n",
    "\n",
    "ALIASES = {\n",
    "\n",
    "    \"donor_id\": [\n",
    "        \"sample\",\n",
    "        \"sample id\",\n",
    "        \"sample_id\",\n",
    "        \"donor\",\n",
    "        \"donor id\",\n",
    "        \"ID\",\n",
    "    ],\n",
    "\n",
    "    \"diagnosis\": [\n",
    "        \"diagnosis\",\n",
    "        \"clinical diagnosis\",\n",
    "        \"condition\",\n",
    "        \"disease\",\n",
    "        \"group\",\n",
    "    ],\n",
    "\n",
    "    \"age\": [\n",
    "        \"age\",\n",
    "        \"age at death\",\n",
    "    ],\n",
    "\n",
    "    \"sex\": [\n",
    "        \"sex\",\n",
    "        \"gender\",\n",
    "    ],\n",
    "\n",
    "    \"PMI\": [\n",
    "        \"PMI\",\n",
    "        \"post mortem interval\",\n",
    "        \"post-mortem interval\",\n",
    "    ],\n",
    "\n",
    "    \"RIN\": [\n",
    "        \"RIN\",\n",
    "        \"RNA integrity number\",\n",
    "    ],\n",
    "}\n",
    "\n",
    "\n",
    "COLUMN_MAP = {\n",
    "\n",
    "    field: find_column(\n",
    "        clinical,\n",
    "        aliases\n",
    "    )\n",
    "\n",
    "    for field, aliases\n",
    "    in ALIASES.items()\n",
    "}\n",
    "\n",
    "\n",
    "print(\"\\n========================================\")\n",
    "print(\"DETECTED METADATA\")\n",
    "print(\"========================================\")\n",
    "\n",
    "for k, v in COLUMN_MAP.items():\n",
    "\n",
    "    print(\n",
    "        f\"{k:12s} -> {v}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Only donor + diagnosis are mandatory\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "for required in [\n",
    "    \"donor_id\",\n",
    "    \"diagnosis\"\n",
    "]:\n",
    "\n",
    "    assert COLUMN_MAP[required] is not None, (\n",
    "        f\"Could not identify {required}. \"\n",
    "        \"Inspect printed columns.\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Build standardized donor table\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "donor_metadata = pd.DataFrame()\n",
    "\n",
    "for standard, original in COLUMN_MAP.items():\n",
    "\n",
    "    if original is not None:\n",
    "\n",
    "        donor_metadata[standard] = clinical[original]\n",
    "\n",
    "\n",
    "# clean text fields\n",
    "donor_metadata[\"donor_id\"] = (\n",
    "    donor_metadata[\"donor_id\"]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "donor_metadata[\"diagnosis\"] = (\n",
    "    donor_metadata[\"diagnosis\"]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\n========================================\")\n",
    "print(\"STANDARDIZED DONOR METADATA\")\n",
    "print(\"========================================\")\n",
    "\n",
    "display(donor_metadata)\n",
    "\n",
    "\n",
    "print(\"\\nDiagnosis counts:\")\n",
    "\n",
    "print(\n",
    "    donor_metadata[\"diagnosis\"]\n",
    "    .value_counts(dropna=False)\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nUnique donor IDs:\",\n",
    "    donor_metadata[\"donor_id\"].nunique()\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\nSTEP 6 COMPLETED.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Source analysis cell: 12\n",
    "# ============================================================\n",
    "# STEP 6C — FREEZE EXACT DONOR METADATA MAPPING\n",
    "# No automatic guessing anymore.\n",
    "# ============================================================\n",
    "\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "import json\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "# Exact column mapping verified directly from Supplementary Table 1\n",
    "COLUMN_MAP = {\n",
    "    \"donor_id\": \"Sample ID\",\n",
    "    \"brain_bank_id\": \"Brain Bank ID\",\n",
    "    \"diagnosis\": \"Clinical diagnosis\",\n",
    "    \"age\": \"Age\",\n",
    "    \"sex\": \"Sex\",\n",
    "    \"PMI\": \"PMI hours\",\n",
    "    \"RIN\": \"RIN measure\",\n",
    "    \"lewy_midbrain\": \"Lewy bodies present in midbrain\",\n",
    "    \"lewy_limbic\": \"Lewy bodies present in limbic regions (amygdala)\",\n",
    "    \"lewy_neocortex\": \"Lewy bodies present in neocortical regions (frontal cortex)\",\n",
    "    \"CERAD\": \"CERAD score for neuritic plaques\",\n",
    "    \"Braak_AD\": \"Braak stage for neurofibrillary tangles \",\n",
    "    \"tissue_usage\": \"Tissue usage\",\n",
    "}\n",
    "\n",
    "# Check every required original column exists\n",
    "missing = [\n",
    "    source\n",
    "    for source in COLUMN_MAP.values()\n",
    "    if source not in clinical.columns\n",
    "]\n",
    "\n",
    "assert not missing, f\"Missing expected columns: {missing}\"\n",
    "\n",
    "# Create clean standardized table\n",
    "donor_metadata = pd.DataFrame({\n",
    "    new_name: clinical[source_name]\n",
    "    for new_name, source_name in COLUMN_MAP.items()\n",
    "})\n",
    "\n",
    "# Clean donor ID and diagnosis\n",
    "donor_metadata[\"donor_id\"] = (\n",
    "    donor_metadata[\"donor_id\"]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "donor_metadata[\"diagnosis\"] = (\n",
    "    donor_metadata[\"diagnosis\"]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "# Normalize diagnosis only after verifying original labels\n",
    "DIAGNOSIS_MAP = {\n",
    "    \"Parkinson's\": \"PD\",\n",
    "    \"Control\": \"Control\",\n",
    "}\n",
    "\n",
    "unexpected_diagnoses = (\n",
    "    set(donor_metadata[\"diagnosis\"].unique())\n",
    "    - set(DIAGNOSIS_MAP.keys())\n",
    ")\n",
    "\n",
    "assert not unexpected_diagnoses, (\n",
    "    f\"Unexpected diagnosis labels: {unexpected_diagnoses}\"\n",
    ")\n",
    "\n",
    "donor_metadata[\"diagnosis_binary\"] = (\n",
    "    donor_metadata[\"diagnosis\"]\n",
    "    .map(DIAGNOSIS_MAP)\n",
    ")\n",
    "\n",
    "# Numeric conversion\n",
    "for col in [\n",
    "    \"age\",\n",
    "    \"PMI\",\n",
    "    \"RIN\",\n",
    "    \"lewy_midbrain\",\n",
    "    \"lewy_limbic\",\n",
    "    \"lewy_neocortex\",\n",
    "    \"CERAD\",\n",
    "    \"Braak_AD\",\n",
    "]:\n",
    "    donor_metadata[col] = pd.to_numeric(\n",
    "        donor_metadata[col],\n",
    "        errors=\"coerce\"\n",
    "    )\n",
    "\n",
    "# ============================================================\n",
    "# Integrity checks\n",
    "# ============================================================\n",
    "\n",
    "assert len(donor_metadata) == 29\n",
    "assert donor_metadata[\"donor_id\"].nunique() == 29\n",
    "\n",
    "assert (\n",
    "    donor_metadata[\"diagnosis_binary\"]\n",
    "    .value_counts()\n",
    "    .to_dict()\n",
    "    ==\n",
    "    {\"PD\": 15, \"Control\": 14}\n",
    ")\n",
    "\n",
    "# RIN sanity check\n",
    "assert donor_metadata[\"RIN\"].between(0, 15).all(), (\n",
    "    \"RIN values outside plausible range.\"\n",
    ")\n",
    "\n",
    "# Age sanity check\n",
    "assert donor_metadata[\"age\"].between(18, 110).all()\n",
    "\n",
    "# PMI sanity check\n",
    "assert (donor_metadata[\"PMI\"] >= 0).all()\n",
    "\n",
    "\n",
    "print(\"========================================\")\n",
    "print(\"FROZEN DONOR METADATA\")\n",
    "print(\"========================================\")\n",
    "\n",
    "display(donor_metadata)\n",
    "\n",
    "print(\"\\nDiagnosis:\")\n",
    "print(donor_metadata[\"diagnosis_binary\"].value_counts())\n",
    "\n",
    "print(\"\\nAge summary:\")\n",
    "display(\n",
    "    donor_metadata\n",
    "    .groupby(\"diagnosis_binary\")[\"age\"]\n",
    "    .describe()\n",
    ")\n",
    "\n",
    "print(\"\\nSex:\")\n",
    "print(\n",
    "    pd.crosstab(\n",
    "        donor_metadata[\"diagnosis_binary\"],\n",
    "        donor_metadata[\"sex\"]\n",
    "    )\n",
    ")\n",
    "\n",
    "print(\"\\nPMI summary:\")\n",
    "display(\n",
    "    donor_metadata\n",
    "    .groupby(\"diagnosis_binary\")[\"PMI\"]\n",
    "    .describe()\n",
    ")\n",
    "\n",
    "print(\"\\nRIN summary:\")\n",
    "display(\n",
    "    donor_metadata\n",
    "    .groupby(\"diagnosis_binary\")[\"RIN\"]\n",
    "    .describe()\n",
    ")\n",
    "\n",
    "# ============================================================\n",
    "# Save frozen donor metadata\n",
    "# ============================================================\n",
    "\n",
    "MANIFESTS = ROOT / \"manifests\"\n",
    "MANIFESTS.mkdir(exist_ok=True)\n",
    "\n",
    "metadata_path = (\n",
    "    MANIFESTS /\n",
    "    \"GSE243639_donor_metadata_FROZEN_v1.csv\"\n",
    ")\n",
    "\n",
    "donor_metadata.to_csv(\n",
    "    metadata_path,\n",
    "    index=False\n",
    ")\n",
    "\n",
    "print(\"\\nSaved:\")\n",
    "print(metadata_path)\n",
    "\n",
    "print(\"\\nSTEP 6C PASSED.\")"
   ]
  },
