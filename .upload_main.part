    "\n",
    "            \"Wald_spearman\",\n",
    "            \"Wald_permutation_p\",\n",
    "            \"Wald_permutation_q_BH\",\n",
    "\n",
    "            \"all_gene_direction_concordance\",\n",
    "        ]\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\n\"\n",
    "    +\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"FROZEN DISCOVERY-FDR GENE REPLICATION\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"=\" * 80\n",
    ")\n",
    "\n",
    "\n",
    "display(\n",
