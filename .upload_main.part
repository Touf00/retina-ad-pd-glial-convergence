    "# Source analysis cell: 13\n",
    "# ============================================================\n",
    "# STEP 7 — LOAD AUTHOR CELL-LEVEL ANNOTATIONS\n",
    "# ============================================================\n",
    "\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "import requests\n",
    "\n",
    "ROOT = Path(__import__(\"os\").environ[\"RETINA_ND_ROOT\"])\n",
    "PD_DIR = ROOT / \"GSE243639_PD_discovery\"\n",
