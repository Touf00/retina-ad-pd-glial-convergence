    "DE_ROOT = (\n",
    "    ROOT /\n",
    "    \"PD_primary_DE\"\n",
    ")\n",
    "\n",
    "DE_ROOT.mkdir(\n",
    "    exist_ok=True\n",
    ")\n",
    "\n",
    "\n",
    "pre_de_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_PRE_DE_ANALYSIS_LOCK_v1.json\"\n",
    ")\n",
    "\n",
    "design_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_DESIGN_AUDIT_v1.json\"\n",
    ")\n",
    "\n",
    "de_run_lock_path = (\n",
    "    LOCKS /\n",
    "    \"GSE243639_PRIMARY_PD_DE_RUN_v1.json\"\n",
    ")\n",
    "\n",
    "summary_path = (\n",
    "    DE_ROOT /\n",
    "    \"GSE243639_PRIMARY_PD_DE_SUMMARY_v1.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "assert pre_de_lock_path.exists()\n",
    "assert design_lock_path.exists()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# C. LOAD FROZEN PRE-DE LOCKS\n",
    "# ============================================================\n",
    "\n",
    "with open(\n",
    "    pre_de_lock_path,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\"\n",
    ") as f:\n",
