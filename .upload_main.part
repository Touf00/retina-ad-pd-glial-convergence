    "                                row[\n",
    "                                    \"primary_Control\"\n",
    "                                ]\n",
    "                            ),\n",
    "                    }\n",
    "\n",
    "                for _, row\n",
    "                in eligibility_summary.iterrows()\n",
    "            },\n",
